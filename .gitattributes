* text=auto eol=lf

# Coffee sources: GitHub's Linguist has no Coffee yet, so keep them out of the language bar instead of
# letting them count as ColdFusion or another language. The grammar for editors is editors/vscode/syntaxes/.
*.cf  linguist-language=Text linguist-detectable=false
*.cfc linguist-language=Text linguist-detectable=false

# generated or binary: the seed compiler, IR objects, test images
coffee/driver/seed/* binary linguist-generated
*.cir binary
*.o binary
*.gz binary
coffee/ir/ir_image_test binary
coffee/ld/prog binary

# the first-generation Rust-era notes and the generated parts of the compiler are not counted
docs/legacy-rust/** linguist-documentation
coffee/ir/src/minrt.cf linguist-generated
