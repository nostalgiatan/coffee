use printf in libc of c

class Lexer:
    src: str
    pos: int
    toks: buf<int>
    count: int

fn is_digit(c: int) => bool:
    return c >= 48 && c <= 57

fn is_alpha(c: int) => bool:
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95

fn is_space(c: int) => bool:
    return c == 32 || c == 9

fn push_tok(toks: buf<int>, count: int, kind: int, start: int, end: int) => buf<int>:
    let need = (count + 1) * 3
    let t = toks
    if need > len(t):
        t = buf_resize(t, need * 2)
    t[count * 3] = kind
    t[count * 3 + 1] = start
    t[count * 3 + 2] = end
    return t

fn lex(src: str) => int:
    let n = len(src)
    let toks: buf<int> = new_buf(int, 6)
    let count = 0
    let i = 0
    while i < n:
        let c = int(src[i])
        if is_space(c):
            i = i + 1
        elif is_digit(c):
            let s = i
            while i < n && is_digit(int(src[i])):
                i = i + 1
            toks = push_tok(toks, count, 1, s, i)
            count = count + 1
        elif is_alpha(c):
            let s = i
            while i < n && (is_alpha(int(src[i])) || is_digit(int(src[i]))):
                i = i + 1
            toks = push_tok(toks, count, 2, s, i)
            count = count + 1
        else:
            toks = push_tok(toks, count, 3, i, i + 1)
            count = count + 1
            i = i + 1
    let sum = 0
    for k in 0..count:
        sum = sum + toks[k * 3]
    return sum

fn main() => int:
    return lex("let x1 = 42 + y")
