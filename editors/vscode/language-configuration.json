{
  "comments": {
    "lineComment": "/#/",
    "blockComment": ["/#*", "*#/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "/#*", "close": "*#/" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*.*:\\s*(/#/.*)?$",
    "decreaseIndentPattern": "^\\s*(elif|else)\\b"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*.*:\\s*(/#/.*)?$",
      "action": { "indent": "indent" }
    }
  ]
}
