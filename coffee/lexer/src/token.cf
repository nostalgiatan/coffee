/#/ Token kinds of the Coffee lexer.
/#/
/#/ Kinds are stored as plain ints (`int(Tk.Ident)`) so a token stream is a
/#/ handful of `buf<int>` columns. The keyword block is contiguous and ordered
/#/ like `KEYWORDS`; the binary-operator block (Plus..Ge) is contiguous too.
enum Tk:
    Eof
    Error
    Newline
    Indent
    Dedent
    Ident
    Int
    Float
    Str
    FStr
    Char
    Listener
    KwFn
    KwC
    KwClass
    KwType
    KwPacked
    KwEnum
    KwOf
    KwIf
    KwElif
    KwElse
    KwWhile
    KwFor
    KwIn
    KwMatch
    KwLet
    KwMv
    KwClone
    KwCopy
    KwRm
    KwClean
    KwRaise
    KwReturn
    KwBreak
    KwContinue
    KwUse
    KwAs
    KwTrue
    KwFalse
    KwInt
    KwFloat
    KwBool
    KwString
    KwStr
    KwVoid
    Plus
    Minus
    Star
    Slash
    Percent
    SlashSlash
    Amp
    Pipe
    Caret
    Shl
    Shr
    AmpAmp
    PipePipe
    EqEq
    NotEq
    Lt
    Le
    Gt
    Ge
    Bang
    Tilde
    Assign
    Arrow
    ColonColon
    DotDot
    Dot
    Comma
    Colon
    LParen
    RParen
    LBracket
    RBracket
    LBrace
    RBrace
    Semi
