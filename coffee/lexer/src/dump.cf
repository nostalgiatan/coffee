/#/ Prints token tables for debugging.
use * in say
use * in check

/#/ One token per line: `line:col kind start-end`.
fn dump(t: &Tokens) => void:
    for i in 0..t.count:
        say(f"{t.line[i]}:{t.col[i]} kind={t.kind[i]} {t.start[i]}-{t.end[i]}\n")

/#/ The shape letters of `check.cf`, on one line.
fn dump_shape(t: &Tokens) => void:
    for i in 0..t.count:
        say_byte(shape_char(t.kind[i]))
    say_byte(10)
