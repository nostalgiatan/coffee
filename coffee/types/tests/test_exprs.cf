use * in types_probe

/#/ the body of `main` wrapped for one expression test: `lines` are indented statements
fn prog(body: str) => str:
    return "fn main() => int:\n" + body + "    return 0\n"

fn main() => int:
    let m = 0
    let mis = int(Te.Mismatch)
    let op = int(Te.InvalidOperation)
    /#/ literals take the type they are wanted as when the value fits
    m = m + miss_ok(prog("    let a: int(1)+ = 100\n    let b: int(2)- = 65535\n    let c: float(4) = 1.5\n"))
    m = m + miss_t(prog("    let a: int(1)+ = 200\n"), mis, 1)
    m = m + miss_t(prog("    let a: int(1)- = -1\n"), mis, 1)
    m = m + miss_ok(prog("    let a: int(1)+ = -128\n"))
    m = m + miss_t(prog("    let a: int(1)+ = -129\n"), mis, 1)
    m = m + miss_ok(prog("    let a: int(8)- = 18446744073709551615\n"))
    m = m + miss_ok(prog("    let a: int(4)+ = 'a'\n"))
    /#/ a number above the largest int has no int type of its own
    m = m + miss_t(prog("    let a = 18446744073709551615\n"), mis, 1)
    m = m + miss_t(prog("    let a: int = 9223372036854775808\n"), mis, 1)
    m = m + miss_ok(prog("    let a = 9223372036854775807\n"))
    /#/ an int never becomes a float, nor the other way
    m = m + miss_t(prog("    let a: float = 1\n"), mis, 1)
    m = m + miss_t(prog("    let a: int = 1.5\n"), mis, 1)
    /#/ widening is allowed, narrowing a variable is not
    m = m + miss_ok(prog("    let a: int(1)+ = 1\n    let b: int(4)+ = a\n    let c: int = b\n"))
    m = m + miss_t(prog("    let a: int = 1\n    let b: int(4)+ = a\n"), mis, 1)
    m = m + miss_ok(prog("    let a: int(1)- = 1\n    let b: int = a\n"))
    m = m + miss_t(prog("    let a: int(8)- = 1\n    let b: int = a\n"), mis, 1)
    m = m + miss_ok(prog("    let a: float(4) = 1.5\n    let b: float = a\n"))
    /#/ strings and bools
    m = m + miss_ok(prog("    let s = \"a\" + \"b\"\n    let t: str = s + \"c\"\n    let b = s == t\n"))
    m = m + miss_t(prog("    let s: str = 1\n"), mis, 1)
    m = m + miss_t(prog("    let b: bool = 1\n"), mis, 1)
    m = m + miss_t(prog("    let n: int = true\n"), mis, 1)
    /#/ arithmetic
    m = m + miss_ok(prog("    let a = 1 + 2 * 3 - 4 // 2 % 3\n    let f = 1.5 * 2.0 / 3.0\n"))
    m = m + miss_t(prog("    let a = 1 + 1.5\n"), op, 1)
    m = m + miss_t(prog("    let a = 1 / 2\n"), op, 1)
    m = m + miss_t(prog("    let a = 1.5 // 2.0\n"), op, 1)
    m = m + miss_t(prog("    let a = \"x\" - \"y\"\n"), op, 1)
    m = m + miss_t(prog("    let a = true + 1\n"), op, 1)
    m = m + miss_ok(prog("    let a: int(4)+ = 1\n    let b = a + 5\n    let c: int(4)+ = b\n"))
    m = m + miss_ok(prog("    let a = 7 & 3 | 4 ^ 1 << 2 >> 1\n    let b = ~a\n"))
    m = m + miss_t(prog("    let a = 1.5 & 2.5\n"), op, 1)
    /#/ comparisons and logic
    m = m + miss_ok(prog("    let a = 1 < 2 && 2 <= 3 || !(3 == 4)\n"))
    m = m + miss_t(prog("    let a = 1 < \"x\"\n"), op, 1)
    m = m + miss_t(prog("    let a = 1 && 2\n"), op, 1)
    m = m + miss_t(prog("    let a = !1\n"), op, 1)
    m = m + miss_t(prog("    let a = -true\n"), op, 1)
    m = m + miss_ok(prog("    let a = \"x\" < \"y\"\n"))
    m = m + miss_t(prog("    if 1:\n        let a = 1\n"), mis, 1)
    m = m + miss_t(prog("    while \"x\":\n        let a = 1\n"), mis, 1)
    /#/ assignments and returns
    m = m + miss_ok(prog("    let a = 1\n    a = 2\n"))
    m = m + miss_t(prog("    let a = 1\n    a = \"x\"\n"), mis, 1)
    m = m + miss_t("fn f() => int:\n    return \"x\"\n", mis, 1)
    m = m + miss_t("fn f() => int:\n    return\n", mis, 1)
    m = m + miss_t("fn f() => void:\n    return 1\n", mis, 1)
    m = m + miss_ok("fn f() => void:\n    return\n")
    /#/ void is no value
    m = m + miss_t("fn nothing() => void:\n    return\n\nfn main() => int:\n    let x = nothing()\n    return 0\n", mis, 1)
    m = m + miss_ok("fn nothing() => void:\n    return\n\nfn main() => int:\n    nothing()\n    return 0\n")
    /#/ tuples and arrays
    m = m + miss_ok(prog("    let t: (int, str) = (1, \"a\")\n    let u: (int(1)+, float(4)) = (1, 2.5)\n"))
    m = m + miss_t(prog("    let t: (int, str) = (1, 2)\n"), mis, 1)
    m = m + miss_ok(prog("    let a: [int; 3] = [1, 2, 3]\n    let b = a[1] + 1\n"))
    m = m + miss_t(prog("    let a: [int; 3] = [1, \"x\", 3]\n"), mis, 1)
    m = m + miss_t(prog("    let a = [1, 2]\n    let b = a[\"x\"]\n"), mis, 1)
    m = m + miss_ok(prog("    let s = \"abc\"\n    let b: int(1)- = s[0]\n"))
    /#/ casts
    m = m + miss_ok(prog("    let a = int(1.5) + int(2)\n    let f = float(3)\n    let b = bool(2)\n"))
    m = m + miss_ok(prog("    let a = 300 as int(2)+\n    let n = a as float\n"))
    m = m + miss_t(prog("    let a = \"x\" as int\n"), op, 1)
    /#/ pointer arithmetic on an object
    m = m + miss_ok("fn f(p: object, i: int) => object:\n    return p + i * 8\n")
    m = m + miss_ok("fn f(p: object) => bool:\n    return p == 0\n")
    return m
