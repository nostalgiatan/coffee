use * in say
use * in storage
use Reader in reader

/#/ 1 when the storage of `let x: <ty>` after `decls` is not described as `want`.
fn miss(decls: str, ty: str, want: &str) => int:
    let a = parse(decls + "let x: " + ty + " = 0\n")
    let g = new_globals()
    let m = declare_module(&g, &a, "t")
    let t = new_tys()
    declare_types(&t, &g, &a, m)
    let rd = Reader { sc: scope_of(&a, &g, m) }
    let it = a.child[a.root]
    let last = it
    while it >= 0:
        last = it
        it = a.next[it]
    let id = rd.from_ref(&t, &a, a.pb[last])
    let o = new_out()
    describe(&o, &t, &g, id)
    if o.is(want):
        return 0
    for i in 0..o.n:
        say_byte(o.b[i])
    say_byte(10)
    fflush(0)
    return 1

fn main() => int:
    let m = 0
    /#/ scalars
    m = m + miss("", "bool", "i8 1/1 copy nothing bit")
    m = m + miss("", "int", "i64 8/8 copy nothing bit")
    m = m + miss("", "int(1)-", "i8 1/1 copy nothing bit")
    m = m + miss("", "int(4)+", "i32 4/4 copy nothing bit")
    m = m + miss("", "float(4)", "f32 4/4 copy nothing bit")
    m = m + miss("", "float", "f64 8/8 copy nothing bit")
    /#/ handles
    m = m + miss("", "str", "ptr 8/8 move free deep")
    m = m + miss("", "object", "ptr 8/8 move nothing shallow")
    m = m + miss("", "buf", "ptr 8/8 move free never")
    /#/ pairs
    m = m + miss("", "buf<int>", "{ptr, i64} 16/8 move free never")
    m = m + miss("", "[u8]", "{ptr, i64} 16/8 move elems shallow")
    /#/ references and functions
    m = m + miss("", "&str", "ptr 8/8 borrow nothing shallow")
    m = m + miss("", "&mut int", "ptr 8/8 borrow nothing shallow")
    m = m + miss("", "fn(int) => int", "ptr 8/8 copy nothing bit")
    /#/ arrays and tuples
    m = m + miss("", "[int; 4]", "ptr 8/8 copy nothing bit block 32")
    m = m + miss("", "[str; 2]", "ptr 8/8 move elems deep block 16")
    m = m + miss("", "(int(1)+, int)", "{i8, i64} 16/8 copy nothing bit")
    m = m + miss("", "(int, int(1)+)", "{i64, i8} 16/8 copy nothing bit")
    m = m + miss("", "(int(1)+, int(2)+, int(1)+)", "{i8, i16, i8} 6/2 copy nothing bit")
    m = m + miss("", "(int, str)", "{i64, ptr} 16/8 move fields deep")
    /#/ classes: parent fields first, natural alignment, padded to the largest
    m = m + miss("class A:\n    a: int(1)+\n    b: int\n\n", "A", "ptr 8/8 move fields deep block 16")
    m = m + miss("class A:\n    a: int(1)+\n\nclass B of A:\n    b: int(2)+\n    c: int(1)+\n\n", "B", "ptr 8/8 move fields deep block 6")
    m = m + miss("class A:\n    n: int\n    s: str\n    p: (int(1)+, int(1)+)\n\n", "A", "ptr 8/8 move fields deep block 24")
    m = m + miss("class Box<T>:\n    v: T\n    k: int(1)+\n\n", "Box<int>", "ptr 8/8 move fields deep block 16")
    m = m + miss("class Box<T>:\n    v: T\n    k: int(1)+\n\n", "Box<int(2)+>", "ptr 8/8 move fields deep block 4")
    /#/ enums: a bare tag is a value, payloads make a block
    m = m + miss("enum E:\n    A\n    B\n\n", "E", "i64 8/8 copy nothing bit")
    m = m + miss("enum E:\n    A\n    B(int, str)\n    C(int(1)+)\n\n", "E", "ptr 8/8 move variant deep block 24")
    return m
