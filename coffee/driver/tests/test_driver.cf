use * in drive
use * in cstr
use * in files
use * in flat
use * in nested
use * in alias
use printf, fflush in libc of c

fn expect(what: int, got: int, want: int) => int:
    if got != want:
        printf("MISS #%d: got %d, want %d\n", what, got, want)
        fflush(0)
        return 1
    return 0

/#/ The length of the module name the line imports.
fn module_len(line: &str) => int:
    let t = txt_of(line)
    let m = use_module(&t, 0, t.n)
    return m.n

/#/ The length of the C library name the line imports from.
fn lib_len(line: &str) => int:
    let t = txt_of(line)
    let m = c_lib_name(&t, 0, t.n)
    return m.n

fn b2i(b: bool) => int:
    if b:
        return 1
    return 0

fn main() => int:
    let m = 0
    /#/ strings built from bytes
    let t = txt_of("a \"b\"\n\tc")
    let s = txt_str(&t)
    m = m + expect(1, len(s), 8)
    m = m + expect(2, int(s[2]), 34)
    m = m + expect(3, int(s[5]), 10)
    let big = new_txt()
    for i in 0..5000:
        big.put_byte(97 + i % 26)
    let bs = txt_str(&big)
    m = m + expect(4, len(bs), 5000)
    m = m + expect(5, int(bs[4999]), 97 + 4999 % 26)
    /#/ which `use` lines name a Coffee module
    m = m + expect(6, module_len("use * in lower"), 5)
    m = m + expect(7, module_len("use a, b in util"), 4)
    m = m + expect(8, module_len("use util"), 4)
    m = m + expect(9, module_len("use printf in libc of c"), 0)
    m = m + expect(10, module_len("let used = 1"), 0)
    /#/ files: write, read back, missing
    let p = txt_of("/tmp/coffee_driver_test.txt")
    let w = txt_of("hello\nworld")
    write_file(&p, &w)
    let r = read_file(&p)
    m = m + expect(11, r.n, 11)
    remove_file(&p)
    let gone = read_file(&p)
    m = m + expect(12, gone.n, 0 - 1)
    /#/ the lines of a set
    let seen = txt_of("a\nbc\n")
    let want = txt_of("bc")
    let nope = txt_of("b")
    m = m + expect(13, b2i(has_line(&seen, &want)), 1)
    m = m + expect(14, b2i(has_line(&seen, &nope)), 0)
    m = m + expect(15, lib_len("use add_two, scale in mylib of c"), 5)
    m = m + expect(16, lib_len("use * in lower"), 0)
    m = m + expect(17, lib_len("use printf in libc of c"), 4)
    /#/ classes declared in two bodies under one name
    let dup = txt_of("fn a() => int:\n    class P:\n        x: int\n    let p: P = P { x: 1 }\n    return p.x\n\nfn b() => int:\n    class P:\n        x: int\n    let p: P = P { x: 2 }\n    return p.x\n\nfn main() => int:\n    return a() + b() - 3\n")
    let fixed = renamed_classes(&dup)
    m = m + expect(18, b2i(fixed.n > dup.n), 1)
    m = m + expect(19, first_error(txt_str(&fixed)), 0 - 1)
    m = m + expect(20, run_src(txt_str(&fixed), false), 0)
    let one = txt_of("fn a() => int:\n    class P:\n        x: int\n    return 1\n\nfn main() => int:\n    return a() - 1\n")
    m = m + expect(21, renamed_classes(&one).n, 0)
    /#/ `use f as g in m`: g becomes f in that file only where it is a name
    let al = txt_of("use add as plus in util\nfn main() => int:\n    let s = \"plus\"\n    return plus(1, 2) + c.plus\n")
    let fixed_al = renamed_aliases(&al)
    let want_al = txt_of("use add as plus in util\nfn main() => int:\n    let s = \"plus\"\n    return add(1, 2) + c.plus\n")
    m = m + expect(22, b2i(fixed_al.same(&want_al)), 1)
    m = m + expect(23, renamed_aliases(&txt_of("use add in util\nfn f() => int:\n    return add(1, 2)\n")).n, 0)
    /#/ two aliases in one line, and a module alias that is not a function's
    let two = renamed_aliases(&txt_of("use a as x, b as y in util\nfn f() => int:\n    return x() + y()\n"))
    m = m + expect(24, b2i(two.same(&txt_of("use a as x, b as y in util\nfn f() => int:\n    return a() + b()\n"))), 1)
    m = m + expect(25, renamed_aliases(&txt_of("use util as u\nfn f() => int:\n    return u()\n")).n, 0)
    /#/ `use m as a`: the prefix `a.` goes, a field after a dot and a function alias are left alone
    let mod = renamed_aliases(&txt_of("use util as u\nfn f() => int:\n    let p = u.Pt { x: 1 }\n    return u.twice(p.u.x)\n"))
    m = m + expect(26, b2i(mod.same(&txt_of("use util as u\nfn f() => int:\n    let p = Pt { x: 1 }\n    return twice(p.u.x)\n"))), 1)
    m = m + expect(27, renamed_aliases(&txt_of("use twice in util as u\nfn f() => int:\n    return u.x\n")).n, 0)
    return m
