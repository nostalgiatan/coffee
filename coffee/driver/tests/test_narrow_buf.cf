/#/ A buffer of a sized element type, spelled as the type is (`new_buf(int(1)-, n)`, `new_buf(float(4), n)`) or by its short name
/#/ (`u8`, `f32`): both reach the same program.
use * in say
use * in files
use * in cstr
use * in txt
use system, fflush in libc of c

/#/ Where `w` is in `t` at or after `from`, -1 if it is not.
fn find_at(t: &Txt, w: &str, from: int) => int:
    for i in from..t.n:
        let k = 0
        while k < len(w) && i + k < t.n && t.b[i + k] == int(w[k]):
            k = k + 1
        if k == len(w):
            return i
    return -1

/#/ Does the function `name` of the listing hold `w`?
fn fn_has(t: &Txt, name: str, w: &str) => bool:
    let head = f"fn {name}("
    let s = find_at(t, &head, 0)
    if s < 0:
        return false
    let e = find_at(t, "\nfn ", s + 1)
    if e < 0:
        e = t.n
    let at = find_at(t, w, s)
    return at >= 0 && at < e

fn main() => int:
    let m = 0
    system("rm -rf narrow && mkdir narrow")
    let src = "fn main() => int:\n    let a: buf<int(1)-> = new_buf(int(1)-, 100)\n    let b: buf<float(4)> = new_buf(float(4), 100)\n    let c = new_buf(int(4)+, 100)\n    for i in 0..100:\n        a[i] = u8(i * 3)\n        b[i] = f32(i) * f32(0.5)\n        c[i] = i32(i - 50)\n    let s = 0\n    for i in 0..100:\n        s = s + int(a[i]) + int(c[i])\n    if b[10] > f32(4.0):\n        s = s + 1\n    return s % 251\n"
    let sp = txt_of("narrow/n.cf")
    let st = txt_of(&src)
    write_file(&sp, &st)
    if system("cd narrow && coffee2 n.cf --emit-ir > n.ir 2>&1 && coffee2 n.cf -o n > build.log 2>&1") != 0:
        say("MISS: build failed\n")
        return 1
    let ip = txt_of("narrow/n.ir")
    let ir = read_file(&ip)
    let r = system("cd narrow && ./n")
    if r != 173 * 256:
        say(f"MISS: the program exits with {r}, not 173\n")
        m = m + 1
    fflush(0)
    return m
