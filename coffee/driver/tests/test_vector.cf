/#/ Loops done a vector at a time: the elements a loop would compute one by one (floats, small and large
/#/ integers, with an invariant, for lengths around the vector size) come out the same, and a loop over more
/#/ elements than a buffer holds still fails its check.
use * in say
use * in files
use * in cstr
use * in txt
use system, fflush in libc of c

/#/ Where `w` is in `t` at or after `from`, -1 if it is not.
fn find_at(t: &Txt, w: &str, from: int) => int:
    for i in from..t.n:
        let k = 0
        while k < len(w) && i + k < t.n && t.b[i + k] == int(w[k]):
            k = k + 1
        if k == len(w):
            return i
    return -1

fn run(dir: str, src: &str, want: int, vec: bool) => int:
    system(f"rm -rf {dir} && mkdir {dir}")
    let spath = f"{dir}/v.cf"
    let sp = txt_of(&spath)
    let st = txt_of(src)
    write_file(&sp, &st)
    if system(f"cd {dir} && coffee2 v.cf --emit-ir > v.ir 2>&1 && coffee2 v.cf -o v > build.log 2>&1") != 0:
        say("MISS: build failed\n")
        return 1
    let m = 0
    let ipath = f"{dir}/v.ir"
    let ip = txt_of(&ipath)
    let ir = read_file(&ip)
    if vec && find_at(&ir, "vloop", 0) < 0:
        say("MISS: no vector loop\n")
        m = m + 1
    let r = system(f"cd {dir} && ./v")
    if r != want * 256:
        say(f"MISS: exit {r}, want {want * 256}\n")
        m = m + 1
    return m

fn main() => int:
    let m = 0
    let s1 = "fn fw(a: &buf<f32>, b: &buf<f32>, n: int) => void:\n    for i in 0..n:\n        a[i] = a[i] * f32(0.5) + b[i] + f32(1.0)\n\nfn dw(a: &buf<float>, b: &buf<float>, n: int) => void:\n    for i in 0..n:\n        a[i] = a[i] - b[i] * 2.0\n\nfn uw(a: &buf<u8>, b: &buf<u8>, n: int) => void:\n    for i in 0..n:\n        a[i] = u8(int(a[i]) + int(b[i]) + 1)\n\nfn iw(a: &buf<int>, b: &buf<int>, n: int, k: int) => void:\n    for i in 0..n:\n        a[i] = (a[i] ^ b[i]) + k\n\nfn hw(a: &buf<i16>, b: &buf<i16>, n: int) => void:\n    for i in 0..n:\n        a[i] = i16(int(a[i]) * int(b[i]) - 3)\n\nfn sum(n: int) => int:\n    let fa: buf<f32> = new_buf(f32, 100)\n    let fb: buf<f32> = new_buf(f32, 100)\n    let da: buf<float> = new_buf(float, 100)\n    let db: buf<float> = new_buf(float, 100)\n    let ua: buf<u8> = new_buf(u8, 100)\n    let ub: buf<u8> = new_buf(u8, 100)\n    let ia: buf<int> = new_buf(int, 100)\n    let ib: buf<int> = new_buf(int, 100)\n    let ha: buf<i16> = new_buf(i16, 100)\n    let hb: buf<i16> = new_buf(i16, 100)\n    for j in 0..100:\n        fa[j] = f32(j % 9) + f32(0.5)\n        fb[j] = f32(j % 4)\n        da[j] = float(j % 11)\n        db[j] = float(j % 3) + 0.25\n        ua[j] = u8(j * 7)\n        ub[j] = u8(j * 13 + 5)\n        ia[j] = j * 31\n        ib[j] = j * 17 + 1\n        ha[j] = i16(j * 300)\n        hb[j] = i16(j + 2)\n    fw(&fa, &fb, n)\n    dw(&da, &db, n)\n    uw(&ua, &ub, n)\n    iw(&ia, &ib, n, 5)\n    hw(&ha, &hb, n)\n    let s = 0\n    for j in 0..100:\n        s = s + int(fa[j] * f32(8.0)) + int(da[j]) + int(ua[j]) + ia[j] + int(ha[j])\n    return s\n\nfn main() => int:\n    let t = 0\n    t = t + sum(0) + sum(1) + sum(3) + sum(15) + sum(16) + sum(17) + sum(33) + sum(100)\n    return t % 251\n"
    m = m + run("vect1", &s1, 117, true)
    let s2 = "fn uw(a: &buf<u8>, b: &buf<u8>, n: int) => void:\n    for i in 0..n:\n        a[i] = u8(int(a[i]) + int(b[i]) + 1)\n\nfn main() => int:\n    let a: buf<u8> = new_buf(u8, 40)\n    let b: buf<u8> = new_buf(u8, 40)\n    uw(&a, &b, 41)\n    return 0\n"
    m = m + run("vect2", &s2, 1, false)
    /#/ several stores in one loop, buffers seen twice, a value read before it is stored over and used after
    let s3 = "fn two(a: &buf<f32>, b: &buf<f32>, c: &buf<f32>, d: &buf<f32>, n: int) => void:\n    for i in 0..n:\n        c[i] = a[i] + b[i]\n        d[i] = a[i] - b[i]\n\nfn same(a: &buf<int>, b: &buf<int>, n: int) => void:\n    for i in 0..n:\n        let t = a[i]\n        a[i] = t + 1\n        b[i] = t * 3\n\nfn seqd(a: &buf<int>, b: &buf<int>, n: int) => void:\n    for i in 0..n:\n        a[i] = a[i] + b[i]\n        b[i] = a[i] - b[i]\n\nfn alias2(a: &buf<int>, b: &buf<int>, n: int) => void:\n    for i in 0..n:\n        b[i] = a[i] + 1\n        a[i] = b[i] + a[i]\n\nfn main() => int:\n    let fa: buf<f32> = new_buf(f32, 50)\n    let fb: buf<f32> = new_buf(f32, 50)\n    let fc: buf<f32> = new_buf(f32, 50)\n    let fd: buf<f32> = new_buf(f32, 50)\n    let ia: buf<int> = new_buf(int, 50)\n    let ib: buf<int> = new_buf(int, 50)\n    let ja: buf<int> = new_buf(int, 50)\n    let jb: buf<int> = new_buf(int, 50)\n    let ka: buf<int> = new_buf(int, 50)\n    let kb: buf<int> = new_buf(int, 50)\n    for j in 0..50:\n        fa[j] = f32(j % 7)\n        fb[j] = f32(j % 5) + f32(0.5)\n        ia[j] = j * 3\n        ib[j] = j + 1\n        ja[j] = j * 5\n        jb[j] = j * 2\n        ka[j] = j\n        kb[j] = j + 9\n    two(&fa, &fb, &fc, &fd, 47)\n    same(&ia, &ib, 47)\n    seqd(&ja, &jb, 47)\n    alias2(&ka, &kb, 47)\n    alias2(&ka, &ka, 47)\n    let s = 0\n    for j in 0..50:\n        s = s + int(fc[j] * f32(4.0)) + int(fd[j] * f32(4.0)) * 3 + ia[j] + ib[j] * 7 + ja[j] * 11 + jb[j] * 13 + ka[j] * 17 + kb[j] * 19\n    return s % 200\n"
    m = m + run("vect3", &s3, 113, true)
    /#/ reductions: sums and bit operations over a buffer, the accumulator in the middle of a chain
    let s4 = "fn sum(a: &buf<int>, n: int) => int:\n    let s = 0\n    for i in 0..n:\n        s = s + a[i]\n    return s\n\nfn sum2(a: &buf<int>, b: &buf<int>, n: int, k: int) => int:\n    let s = 7\n    for i in 0..n:\n        s = s + (a[i] ^ b[i]) + k\n    return s\n\nfn dif(a: &buf<int>, n: int) => int:\n    let s = 100\n    for i in 0..n:\n        s = s - a[i]\n    return s\n\nfn xr(a: &buf<int>, n: int) => int:\n    let s = 5\n    for i in 0..n:\n        s = s ^ a[i]\n    return s\n\nfn orr(a: &buf<int>, n: int) => int:\n    let s = 0\n    for i in 0..n:\n        s = s | a[i]\n    return s\n\nfn andd(a: &buf<int>, n: int) => int:\n    let s = -1\n    for i in 0..n:\n        s = s & a[i]\n    return s\n\nfn main() => int:\n    let a: buf<int> = new_buf(int, 50)\n    let b: buf<int> = new_buf(int, 50)\n    for j in 0..50:\n        a[j] = j * 37 + 1000003 * (j % 3) + 255\n        b[j] = j * 11 + 7\n    let r = 0\n    for n in 0..50:\n        r = r * 31 + sum(&a, n) + sum2(&a, &b, n, n) * 3 + dif(&a, n) * 5 + xr(&a, n) * 7 + orr(&a, n) * 9 + andd(&a, n) * 13\n    return (r % 251 + 251) % 251\n"
    m = m + run("vect4", &s4, 183, true)
    system("rm -rf vect1 vect2 vect3 vect4")
    fflush(0)
    return m
