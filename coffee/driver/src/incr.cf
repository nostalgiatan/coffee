/#/ Incremental builds: one object per source file, kept in a cache directory and reused while
/#/ nothing it depends on changed.
/#/
/#/ The front end sees the whole program, but only the bodies of the files being rebuilt are checked
/#/ (the others are declarations); the lowering, optimizing and machine code of a file are skipped
/#/ when its object is current. A file's object is rebuilt when
/#/   - its own tokens changed (comments and blank lines do not count), or
/#/   - the interface of an item it can see changed: function headers, class fields and method
/#/     headers, enums, aliases, module-level `let`s, and the whole of generic functions and classes.
/#/     A file sees the items its tokens name and, transitively, the items their interfaces name
/#/     (a value's type reaches it through the function that returned it); the file with `main` also
/#/     sees every module-level `let`, which it initializes), or
/#/   - the compiler, the `.cfc` text or the optimization level is another one.
/#/ Names the compiler makes (glue, generic instances) carry a per-file suffix, so objects built at
/#/ different times never define the same symbol. The optimizer works inside one file, but the small
/#/ functions and methods (`small_fn`) of the files a file can see are lowered into it as well, for
/#/ inlining only: their bodies are part of their interface, and their code stays in their own file.
use system, fflush, fork, waitpid, _exit in libc of c

/#/ Two 64-bit FNV lanes.
class Hash:
    a: int
    b: int

    fn add(self, c: int) => void:
        self.a = wrapping_mul(self.a ^ c, 1099511628211)
        self.b = wrapping_mul(self.b ^ (c + 977), 6364136223846793005)

    fn add_txt(self, t: &Txt) => void:
        for i in 0..t.n:
            self.add(t.b[i])
        self.add(256)

    /#/ The 32 hex digits.
    fn hex(self) => Txt:
        let r = new_txt()
        for lane in 0..2:
            let v = self.a
            if lane == 1:
                v = self.b
            let i = 15
            while i >= 0:
                let d = (v >> (4 * i)) & 15
                if d < 10:
                    r.put_byte(48 + d)
                else:
                    r.put_byte(87 + d)
                i -= 1
        return r

fn new_hash() => Hash:
    return Hash { a: 1469598103934665603, b: 7046029254386353131 }

/#/ Adds the tokens `lo` up to `hi` of `a`: kind and spelling, so spaces and comments do not count.
fn hash_tokens(h: &Hash, a: &Ast, lo: int, hi: int) => void:
    for q in lo..hi:
        h.add(a.toks.kind[q])
        for k in a.toks.start[q]..a.toks.end[q]:
            h.add(a.byte_at(k))
        h.add(257)

/#/ A hash that also remembers the identifier tokens it went over.
class Walk:
    a: int
    b: int
    ids: buf<int>
    n: int

fn new_walk() => Walk:
    let h = new_hash()
    return Walk { a: h.a, b: h.b, ids: new_buf(int, 16), n: 0 }

/#/ Adds the tokens `lo` up to `hi` of `a` (kind and spelling), and notes the identifiers.
fn walk_tokens(w: &Walk, a: &Ast, lo: int, hi: int) => void:
    let h = Hash { a: w.a, b: w.b }
    for q in lo..hi:
        h.add(a.toks.kind[q])
        for k in a.toks.start[q]..a.toks.end[q]:
            h.add(a.byte_at(k))
        h.add(257)
        if a.toks.kind[q] == int(Tk.Ident):
            if w.n >= len(w.ids):
                w.ids = buf_resize(w.ids, w.n * 2)
            w.ids[w.n] = q
            w.n = w.n + 1
    w.a = h.a
    w.b = h.b

/#/ A function (or method) small enough that other files get its body to inline: not generic, not
/#/ `main`, at most 60 tokens, and with no function inside it.
fn small_fn(a: &Ast, f: int) => bool:
    if a.kind[f] != int(Nk.Fn) || a.pc[f] < 0 || type_param_count(a, f) != 0:
        return false
    if a.pa[f] >= 0 && tok_is(a, a.pa[f], "main"):
        return false
    if a.end[f] - a.tok[f] > 60:
        return false
    for q in a.tok[f] + 1..a.end[f]:
        if a.toks.kind[q] == int(Tk.KwFn):
            return false
    return true

/#/ Adds what other files may depend on in the top-level item `n`: a function's header, a class's
/#/ fields and method headers, the bodies of the small functions and methods, and the whole of a
/#/ generic function or class and of everything else.
fn walk_interface(w: &Walk, a: &Ast, n: int) => void:
    let k = a.kind[n]
    let lo = a.tok[n]
    let hi = a.end[n]
    if k == int(Nk.Fn):
        if type_param_count(a, n) == 0 && a.pc[n] >= 0 && !small_fn(a, n):
            hi = a.tok[a.pc[n]]
        walk_tokens(w, a, lo, hi)
    elif k == int(Nk.Class) && type_param_count(a, n) == 0:
        let q = lo
        let m = a.child[n]
        while q < hi:
            while m >= 0 && !(a.kind[m] == int(Nk.Fn) && a.pc[m] >= 0 && a.tok[a.pc[m]] >= q && !small_fn(a, m)):
                m = a.next[m]
            let stop = hi
            if m >= 0:
                stop = a.tok[a.pc[m]]
            walk_tokens(w, a, q, stop)
            if m < 0:
                q = hi
            else:
                q = a.end[m]
                m = a.next[m]
    else:
        walk_tokens(w, a, lo, hi)

/#/ The number of the file a top-level node is from, going by the line of its first token.
fn node_unit(fl: &Flat, a: &Ast, n: int, runtime: int) => int:
    let line = a.toks.line[a.tok[n]]
    if line - 1 >= fl.lines:
        return runtime
    return fl.unit_of_line(line)

/#/ The hash of the file the compiler runs from, so a new compiler rebuilds everything.
fn compiler_hash() => Txt:
    let p = txt_of("/proc/self/exe")
    let t = read_file(&p)
    let h = new_hash()
    h.add_txt(&t)
    return h.hex()

/#/ The cache name of file `u`: its base name and a hash of its whole path.
fn object_name(fl: &Flat, u: int) => Txt:
    let path = fl.unit_name(u)
    let lo = 0
    for i in 0..path.n:
        if path.b[i] == 47:
            lo = i + 1
    let hi = path.n
    if hi - lo > 3 && path.b[hi - 3] == 46 && path.b[hi - 2] == 99 && path.b[hi - 1] == 102:
        hi = hi - 3
    let r = new_txt()
    for i in lo..hi:
        let c = path.b[i]
        if (c >= 48 && c <= 57) || (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95:
            r.put_byte(c)
        else:
            r.put_byte(95)
    r.put_byte(95)
    let h = new_hash()
    h.add_txt(&path)
    let x = h.hex()
    for i in 0..8:
        r.put_byte(x.b[i])
    return r

fn cache_path(dir: &Txt, name: &Txt, ext: &str) => Txt:
    let p = copy_txt(dir)
    p.put_byte(47)
    p.put_all(name)
    p.put(ext)
    return p

/#/ The key stored for a file whose object is current: the same text as `want`?
fn key_current(dir: &Txt, name: &Txt, want: &Txt) => bool:
    let kp = cache_path(dir, name, ".key")
    let have = read_file(&kp)
    if have.n < 0 || !have.same(want):
        return false
    let op = cache_path(dir, name, ".o")
    let o = read_file(&op)
    return o.n > 0

/#/ The hash of the tokens of each file, one line of 32 hex digits each.
fn unit_bodies(fl: &Flat, a: &Ast, n: int) => Txt:
    let ha: buf<int> = new_buf(int, n + 1)
    let hb: buf<int> = new_buf(int, n + 1)
    for u in 0..n:
        let h = new_hash()
        ha[u] = h.a
        hb[u] = h.b
    for q in 0..a.toks.count:
        let line = a.toks.line[q]
        if line - 1 < fl.lines:
            let u = fl.unit_of_line(line)
            let h = Hash { a: ha[u], b: hb[u] }
            hash_tokens(&h, a, q, q + 1)
            ha[u] = h.a
            hb[u] = h.b
    let out = new_txt()
    for u in 0..n:
        let h = Hash { a: ha[u], b: hb[u] }
        out.put_all(&h.hex())
        out.put_byte(10)
    return out

/#/ The named top-level items, each with the hash of its interface and the items its interface
/#/ names. A file's key holds the interfaces of the items its tokens name, and of the items those
/#/ name in turn, so a change reaches only the files that can see it.
class Items:
    count: int
    node: buf<int>
    unit: buf<int>
    ia: buf<int>
    ib: buf<int>
    /#/ the items named by item i are m_list[m_at[i] .. m_at[i + 1])
    m_at: buf<int>
    m_list: buf<int>
    /#/ name table: open addressing, item + 1
    ht: buf<int>
    /#/ the hash of the C imports, which every file sees
    cimp_a: int
    cimp_b: int

/#/ The name of top-level node `n` as a token, -1 for an item with no name.
fn item_name(a: &Ast, n: int) => int:
    let k = a.kind[n]
    if k == int(Nk.Fn) || k == int(Nk.Class) || k == int(Nk.Enum) || k == int(Nk.Let) || k == int(Nk.TypeAlias):
        return a.pa[n]
    return 0 - 1

fn ident_hash(a: &Ast, tok: int) => int:
    let h = 5381
    for k in a.toks.start[tok]..a.toks.end[tok]:
        h = (h * 33 + a.byte_at(k)) & 1073741823
    return h

/#/ Calls nothing: fills `out` (cleared first) with the items named like token `tok`.
fn items_named(it: &Items, a: &Ast, tok: int, out: &buf<int>) => int:
    let mask = len(it.ht) - 1
    let i = ident_hash(a, tok) & mask
    let n = 0
    while it.ht[i] != 0:
        let x = it.ht[i] - 1
        if same_tok(a, item_name(a, it.node[x]), tok):
            if n < len(out):
                out[n] = x
                n = n + 1
        i = (i + 1) & mask
    return n

fn build_items(fl: &Flat, a: &Ast, n: int) => Items:
    let cap = 16
    let top = a.child[a.root]
    let named = 0
    while top >= 0:
        if item_name(a, top) >= 0:
            named = named + 1
        top = a.next[top]
    while cap < named * 2 + 2:
        cap = cap * 2
    let it = Items { count: 0, node: new_buf(int, named + 1), unit: new_buf(int, named + 1), ia: new_buf(int, named + 1), ib: new_buf(int, named + 1), m_at: new_buf(int, named + 2), m_list: new_buf(int, 16), ht: new_buf(int, cap), cimp_a: 0, cimp_b: 0 }
    top = a.child[a.root]
    let cimp = new_walk()
    while top >= 0:
        let u = node_unit(fl, a, top, n)
        if item_name(a, top) >= 0 && u < n:
            it.node[it.count] = top
            it.unit[it.count] = u
            let mask = cap - 1
            let i = ident_hash(a, item_name(a, top)) & mask
            while it.ht[i] != 0:
                i = (i + 1) & mask
            it.ht[i] = it.count + 1
            it.count = it.count + 1
        elif a.kind[top] == int(Nk.Use) && a.pc[top] == 1:
            walk_tokens(&cimp, a, a.tok[top], a.end[top])
        top = a.next[top]
    it.cimp_a = cimp.a
    it.cimp_b = cimp.b
    /#/ interfaces and the names in them
    let found: buf<int> = new_buf(int, 64)
    let nm = 0
    for x in 0..it.count:
        let w = new_walk()
        walk_interface(&w, a, it.node[x])
        it.ia[x] = w.a
        it.ib[x] = w.b
        it.m_at[x] = nm
        for j in 0..w.n:
            let c = items_named(&it, a, w.ids[j], &found)
            for f in 0..c:
                if nm >= len(it.m_list):
                    it.m_list = buf_resize(it.m_list, nm * 2)
                it.m_list[nm] = found[f]
                nm = nm + 1
    it.m_at[it.count] = nm
    return it

/#/ The keys of the files, and for each file the nodes whose small functions it gets to inline.
class Keys:
    text: Txt
    /#/ the nodes of file u are ext_nodes[ext_at[u] .. ext_at[u + 1])
    ext_at: buf<int>
    ext_nodes: buf<int>

/#/ The key of each file, one line of 32 hex digits each: the compiler, the level, the `.cfc` text,
/#/ the C imports, the file's own tokens (`bodies`), and the interfaces of the items it can see.
/#/ The file with `main` also runs every module-level `let`, so it sees them all.
fn unit_keys(fl: &Flat, a: &Ast, n: int, ch: &Txt, opt: int, cfc: &str, bodies: &Txt) => Keys:
    let it = build_items(fl, a, n)
    /#/ the identifier tokens of each file
    let tu: buf<int> = new_buf(int, a.toks.count + 1)
    let cnt: buf<int> = new_buf(int, n + 2)
    for q in 0..a.toks.count:
        tu[q] = n
        let line = a.toks.line[q]
        if line - 1 < fl.lines:
            tu[q] = fl.unit_of_line(line)
        if a.toks.kind[q] == int(Tk.Ident) && tu[q] < n:
            cnt[tu[q] + 1] = cnt[tu[q] + 1] + 1
    for u in 0..n + 1:
        cnt[u + 1] = cnt[u + 1] + cnt[u]
    let at: buf<int> = new_buf(int, n + 1)
    let toks: buf<int> = new_buf(int, cnt[n] + 1)
    for q in 0..a.toks.count:
        if a.toks.kind[q] == int(Tk.Ident) && tu[q] < n:
            toks[cnt[tu[q]] + at[tu[q]]] = q
            at[tu[q]] = at[tu[q]] + 1
    let has_main: buf<int> = new_buf(int, n + 1)
    for x in 0..it.count:
        if a.kind[it.node[x]] == int(Nk.Fn) && tok_is(a, item_name(a, it.node[x]), "main"):
            has_main[it.unit[x]] = 1
    let mark: buf<int> = new_buf(int, it.count + 1)
    let stack: buf<int> = new_buf(int, it.count + 1)
    let found: buf<int> = new_buf(int, 64)
    let keys = new_txt()
    let ext_at: buf<int> = new_buf(int, n + 2)
    let ext_nodes: buf<int> = new_buf(int, 16)
    let ne = 0
    let cfc_t = txt_of(cfc)
    for u in 0..n:
        let sp = 0
        ext_at[u] = ne
        if has_main[u] == 1:
            for x in 0..it.count:
                if it.unit[x] != u && a.kind[it.node[x]] == int(Nk.Let):
                    mark[x] = u + 1
                    stack[sp] = x
                    sp = sp + 1
        for j in cnt[u]..cnt[u + 1]:
            let c = items_named(&it, a, toks[j], &found)
            for f in 0..c:
                let x = found[f]
                if it.unit[x] != u && mark[x] != u + 1:
                    mark[x] = u + 1
                    stack[sp] = x
                    sp = sp + 1
        while sp > 0:
            sp = sp - 1
            let x = stack[sp]
            for j in it.m_at[x]..it.m_at[x + 1]:
                let y = it.m_list[j]
                if it.unit[y] != u && mark[y] != u + 1:
                    mark[y] = u + 1
                    stack[sp] = y
                    sp = sp + 1
        let k = new_hash()
        k.add_txt(ch)
        k.add(opt)
        k.add_txt(&cfc_t)
        k.add_txt(&slice(bodies, u * 33, u * 33 + 32))
        k.add(it.cimp_a)
        k.add(it.cimp_b)
        for x in 0..it.count:
            if mark[x] == u + 1:
                k.add(it.ia[x])
                k.add(it.ib[x])
                let kd = a.kind[it.node[x]]
                if kd == int(Nk.Class) || (kd == int(Nk.Fn) && small_fn(a, it.node[x])):
                    if ne >= len(ext_nodes):
                        ext_nodes = buf_resize(ext_nodes, ne * 2)
                    ext_nodes[ne] = it.node[x]
                    ne = ne + 1
        keys.put_all(&k.hex())
        keys.put_byte(10)
    ext_at[n] = ne
    return Keys { text: keys, ext_at: ext_at, ext_nodes: ext_nodes }

/#/ Does the program define the number-printing runtime itself (the runtime's own tests do)?
fn defines_runtime(a: &Ast) => bool:
    let it = a.child[a.root]
    while it >= 0:
        if a.kind[it] == int(Nk.Fn) && a.pa[it] >= 0 && tok_is(a, a.pa[it], "__cf_fmt_int"):
            return true
        it = a.next[it]
    return false

/#/ Builds the object of unit `u` into `dir`, with the key `kt`. False when the unit has findings.
fn compile_unit(prep: &Prep, t: &Tys, g: &Syms, opt: int, u: int, unit: &buf<int>, name: &Txt, kt: &Txt, dir: &Txt, kk: &Keys) => bool:
    /#/ the names the compiler makes end in the object's own name, so objects built at different
    /#/ times (and numbers of files) never define the same symbol
    let tag = txt_of("_u_")
    tag.put_all(name)
    let ts = txt_str(&tag)
    /#/ the small functions of the files this one can see, for inlining
    let ext: buf<int> = new_buf(int, prep.a.count + 1)
    for j in kk.ext_at[u]..kk.ext_at[u + 1]:
        let x = kk.ext_nodes[j]
        if prep.a.kind[x] == int(Nk.Fn):
            ext[x] = 1
        else:
            let c = prep.a.child[x]
            while c >= 0:
                if small_fn(&prep.a, c):
                    ext[c] = 1
                c = prep.a.next[c]
    let t0 = now_ms()
    let lw = lower_prepared(prep, t, g, opt, u, unit, &ts, &ext)
    if lw.bad > 0:
        return false
    let t1 = now_ms()
    lw.generate()
    lw.emit_glue(t, g)
    let t2 = now_ms()
    if lw.ver_err > 0 || lw.mc_err > 0:
        say(f"incremental: {lw.ver_err + lw.mc_err} functions with findings in {txt_str(name)}\n")
        return false
    let obj = lw.object()
    write_file(&cache_path(dir, name, ".o"), &obj)
    write_file(&cache_path(dir, name, ".key"), kt)
    if lw.uses_rt:
        write_file(&cache_path(dir, name, ".rt"), &txt_of("1"))
    else:
        write_file(&cache_path(dir, name, ".rt"), &txt_of("0"))
    unit_times(t1 - t0, t2 - t1, now_ms() - t2)
    return true

/#/ The number of processors that are on, from /sys; 1 when unknown.
fn online_cpus() => int:
    let t = read_file(&txt_of("/sys/devices/system/cpu/online"))
    if t.n <= 0:
        return 1
    let total = 0
    let lo = 0 - 1
    let cur = 0
    for i in 0..t.n + 1:
        let c = 44
        if i < t.n:
            c = t.b[i]
        if c >= 48 && c <= 57:
            cur = cur * 10 + c - 48
        elif c == 45:
            lo = cur
            cur = 0
        elif c == 44 || c == 10:
            if lo >= 0:
                total = total + cur - lo + 1
            elif i > 0 && t.b[i - 1] != 44:
                total = total + 1
            lo = 0 - 1
            cur = 0
    if total < 1:
        return 1
    return total

/#/ Builds the program in `fl` into `dir`, linking `out`. Returns 0 when it worked.
fn build_incremental(fl: &Flat, a0: Ast, dir: &Txt, out: &Txt, opt: int, jobs: int, static_link: bool, auto_static: bool) => int:
    system(txt_str(&mkdir_cmd(dir)))
    if a0.err_count > 0:
        say(f"front end: {a0.err_count} parse errors\n")
        return 1
    phase("parse")
    let defines = defines_runtime(&a0)
    let ch = compiler_hash()
    let cfc = fl.cfc_str()
    let n = fl.nunit
    let bodies = unit_bodies(fl, &a0, n)
    phase("hashes")
    let kk = unit_keys(fl, &a0, n, &ch, opt, &cfc, &bodies)
    let keys = copy_txt(&kk.text)
    let all = new_hash()
    all.add_txt(&keys)
    phase("keys")
    let want_state = all.hex()
    let state_path = cache_path(dir, &txt_of("state"), "")
    let state = read_file(&state_path)
    let have_state = state.n >= 32
    if have_state:
        for i in 0..32:
            if state.b[i] != want_state.b[i]:
                have_state = false
    /#/ the stale files: those whose object is missing or built from other tokens or interfaces
    let stale: buf<int> = new_buf(int, n + 1)
    let todo: buf<int> = new_buf(int, n + 1)
    let ntodo = 0
    let names: buf<Txt> = new_buf(Txt, n + 1)
    for u in 0..n:
        let name = object_name(fl, u)
        if !key_current(dir, &name, &slice(&keys, u * 33, u * 33 + 32)):
            stale[u] = 1
            todo[ntodo] = u
            ntodo = ntodo + 1
        names[u] = name
    let compiled = ntodo
    let reused = n - ntodo
    let objs = new_txt()
    let plain = new_txt()
    if ntodo > 0 || !have_state:
        let t = new_tys()
        let g = new_globals()
        /#/ the file of each top-level item; the bodies of the files that are not stale are not
        /#/ checked again (they were when their objects were built, and their interfaces and
        /#/ tokens are the same), so they become declarations
        let unit: buf<int> = new_buf(int, a0.count + 1)
        let top = a0.child[a0.root]
        while top >= 0:
            let u = node_unit(fl, &a0, top, n)
            unit[top] = u
            if u < n && stale[u] == 0:
                if a0.kind[top] == int(Nk.Fn) && type_param_count(&a0, top) == 0:
                    if !small_fn(&a0, top):
                        a0.pc[top] = 0 - 1
                elif a0.kind[top] == int(Nk.Class) && type_param_count(&a0, top) == 0:
                    let c = a0.child[top]
                    while c >= 0:
                        if a0.kind[c] == int(Nk.Fn) && !small_fn(&a0, c):
                            a0.pc[c] = 0 - 1
                        c = a0.next[c]
            top = a0.next[top]
        /#/ the work of each unit, by the tokens of its items
        let cost: buf<int> = new_buf(int, n + 1)
        let t2 = a0.child[a0.root]
        while t2 >= 0:
            let tu = unit[t2]
            if tu < n:
                cost[tu] = cost[tu] + a0.end[t2] - a0.tok[t2] + 1
            t2 = a0.next[t2]
        let prep = prepare_ast(a0, cfc, &t, &g)
        if !prep.ok:
            return 1
        phase("front end")
        let workers = jobs
        if workers > ntodo:
            workers = ntodo
        if workers <= 1:
            for i in 0..ntodo:
                let u = todo[i]
                if !compile_unit(&prep, &t, &g, opt, u, &unit, &names[u], &slice(&keys, u * 33, u * 33 + 32), dir, &kk):
                    return 1
            unit_phases()
        else:
            /#/ each worker is a copy of this process (the front end's result is shared, not redone)
            /#/ that builds every `workers`-th stale unit
            fflush(0)
            /#/ the biggest units go first, each to the worker with the least work so far
            for i in 1..ntodo:
                let v = todo[i]
                let j = i
                while j > 0 && cost[todo[j - 1]] < cost[v]:
                    todo[j] = todo[j - 1]
                    j = j - 1
                todo[j] = v
            let owner: buf<int> = new_buf(int, ntodo + 1)
            let load: buf<int> = new_buf(int, workers)
            for i in 0..ntodo:
                let best = 0
                for w in 1..workers:
                    if load[w] < load[best]:
                        best = w
                owner[i] = best
                load[best] = load[best] + cost[todo[i]] + 1
            let pids: buf<int> = new_buf(int, workers)
            for w in 0..workers:
                let pid = fork()
                if pid == 0:
                    let ok = true
                    let i = 0
                    while i < ntodo && ok:
                        if owner[i] == w:
                            let u = todo[i]
                            ok = compile_unit(&prep, &t, &g, opt, u, &unit, &names[u], &slice(&keys, u * 33, u * 33 + 32), dir, &kk)
                        i = i + 1
                    fflush(0)
                    if ok:
                        _exit(0)
                    _exit(1)
                pids[w] = pid
            let failed = false
            for w in 0..workers:
                let sb: buf<int> = new_buf(int, 2)
                sb[0] = 0
                if pids[w] < 0 || waitpid(pids[w], buf_ptr(sb), 0) < 0 || sb[0] != 0:
                    failed = true
            if failed:
                return 1
            phase("units")
        write_file(&state_path, &want_state)
    /#/ the objects, and the number-printing runtime when some file calls it and none defines it
    let uses = false
    for u in 0..n:
        let name = clone names[u]
        objs.put(" '")
        objs.put_all(&cache_path(dir, &name, ".o"))
        objs.put("'")
        plain.put_all(&cache_path(dir, &name, ".o"))
        plain.put_byte(10)
        let fg = read_file(&cache_path(dir, &name, ".rt"))
        if fg.n > 0 && fg.b[0] == 49:
            uses = true
    if uses && !defines:
        let rk = new_hash()
        rk.add_txt(&ch)
        rk.add(opt)
        let rts = fmt_rt_text()
        rk.add_txt(&txt_of(&rts))
        let kt = rk.hex()
        let rn = txt_of("runtime")
        if !key_current(dir, &rn, &kt):
            let rb = bytes_of_str(&rts)
            let obj = build_text(rb, len(rts), opt, "")
            if obj.n == 0:
                return 1
            write_file(&cache_path(dir, &rn, ".o"), &obj)
            write_file(&cache_path(dir, &rn, ".key"), &kt)
            compiled = compiled + 1
        else:
            reused = reused + 1
        objs.put(" '")
        objs.put_all(&cache_path(dir, &rn, ".o"))
        objs.put("'")
        plain.put_all(&cache_path(dir, &rn, ".o"))
        plain.put_byte(10)
    if static_link:
        /#/ the C library of rt/src/min.cf, as an object of its own
        let ms = min_rt_text()
        let mk = new_hash()
        mk.add_txt(&ch)
        mk.add(opt)
        mk.add_txt(&txt_of(&ms))
        let mkt = mk.hex()
        let mn = txt_of("minrt")
        if !key_current(dir, &mn, &mkt):
            let mb = bytes_of_str(&ms)
            let mobj = build_text(mb, len(ms), opt, "")
            if mobj.n == 0:
                return 1
            write_file(&cache_path(dir, &mn, ".o"), &mobj)
            write_file(&cache_path(dir, &mn, ".key"), &mkt)
        plain.put_all(&cache_path(dir, &mn, ".o"))
        plain.put_byte(10)
    say(f"incremental: {compiled} compiled, {reused} reused\n")
    fflush(0)
    let flags = new_txt()
    fl.link_flags(&flags)
    let rc = link_objects(&plain, &objs, &flags, out, static_link, auto_static)
    phase("link")
    return rc

fn mkdir_cmd(dir: &Txt) => Txt:
    let c = txt_of("mkdir -p '")
    c.put_all(dir)
    c.put("'")
    return c
