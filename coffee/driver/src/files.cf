/#/ Reading and writing whole files by a path held in a `Txt`.
use fopen, fclose, fgetc, fputc, remove, access in libc of c

/#/ The bytes of the file; `n` is -1 when it cannot be opened.
fn read_file(path: &Txt) => Txt:
    let t = new_txt()
    let p = txt_str(path)
    if access(p, 4) != 0:
        t.n = 0 - 1
        return t
    let fp = fopen(p, "r")
    let c = fgetc(fp)
    while c >= 0:
        t.put_byte(c)
        c = fgetc(fp)
    fclose(fp)
    return t

/#/ Writes `t` to the file.
fn write_file(path: &Txt, t: &Txt) => void:
    let fp = fopen(txt_str(path), "w")
    for k in 0..t.n:
        fputc(t.b[k], fp)
    fclose(fp)

fn remove_file(path: &Txt) => void:
    remove(txt_str(path))

/#/ A `Txt` holding `s`.
fn txt_of(s: &str) => Txt:
    let t = new_txt()
    t.put(s)
    return t

/#/ A new `Txt` with the bytes of `t` (`clone` would share the buffer).
fn copy_txt(t: &Txt) => Txt:
    let r = new_txt()
    r.put_all(t)
    return r
