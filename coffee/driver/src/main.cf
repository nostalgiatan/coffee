/#/ The self-hosted compiler: `coffee2 input.cf [-o out] [-I dir] [-O0..-O3] [--emit-obj]`.
/#/ The code generator is our own x86-64 backend; the system `cc` links the object.
/#/ The standard C library gives a program no arguments, so they are read from /proc/self/cmdline.
/#/ The modules are listed here, each once: an import reached by two paths is a conflict.
use * in drive
use * in minrt
use * in cstr
use * in files
use * in flat
use * in nested
use * in alias
use * in incr
use * in timing
use * in static_link
use printf, fflush, system, exit in libc of c

class Cli:
    input: Txt
    output: Txt
    emit_only: bool
    flat_only: bool
    level: int
    bad: int
    /#/ the directory of the object cache when the build is incremental
    cache: Txt
    /#/ the processes that build units at once; 0 means one per processor
    jobs: int
    static_link: bool

    fn set_input(self, w: &Txt) => void:
        self.input.put_all(w)

    fn set_output(self, w: &Txt) => void:
        self.output.put_all(w)

    fn set_level(self, l: int) => void:
        self.level = l

    fn set_emit_only(self) => void:
        self.emit_only = true

    fn set_flat_only(self) => void:
        self.flat_only = true

    fn set_bad(self) => void:
        self.bad = 1

    fn input_str(self) => str:
        return txt_str(&self.input)

    fn read_input(self) => Txt:
        return read_file(&self.input)

    fn input_dir(self) => Txt:
        return dir_of(&self.input)

    /#/ The output path: the one given, else `<input>.o` or `a.out`.
    fn out_path(self) => Txt:
        let out = copy_txt(&self.output)
        if out.n == 0:
            if self.flat_only:
                out.put_all(&self.input)
                out.put(".flat")
            elif self.emit_only:
                out.put_all(&self.input)
                out.put(".o")
            else:
                out.put("a.out")
        return out

/#/ The arguments, split at the NUL bytes.
fn cmdline() => Txt:
    let p = txt_of("/proc/self/cmdline")
    return read_file(&p)

fn parse_cli(fl: &Flat) => Cli:
    let cli = Cli { input: new_txt(), output: new_txt(), emit_only: false, flat_only: false, level: 1, bad: 0, cache: new_txt(), jobs: 0, static_link: false }
    let raw = cmdline()
    let words = new_txt()
    /#/ one word per line
    for i in 0..raw.n:
        if raw.b[i] == 0:
            words.put_byte(10)
        else:
            words.put_byte(raw.b[i])
    let n = 0
    let s = 0
    let want_out = false
    let want_inc = false
    let want_cache = false
    let want_jobs = false
    for i in 0..words.n:
        if words.b[i] == 10:
            let w = slice(&words, s, i)
            s = i + 1
            n = n + 1
            if n == 1:
                continue
            if want_out:
                cli.set_output(&w)
                want_out = false
            elif want_inc:
                fl.add_dir(&w)
                want_inc = false
            elif want_jobs:
                want_jobs = false
                let v = 0
                for k in 0..w.n:
                    if w.b[k] < 48 || w.b[k] > 57:
                        say("error: -j wants a number\n")
                        cli.set_bad()
                        v = 0 - 1
                        break
                    v = v * 10 + w.b[k] - 48
                if v >= 0:
                    cli.jobs = v
            elif want_cache:
                cli.cache.put_all(&w)
                want_cache = false
            elif w.is("-o"):
                want_out = true
            elif w.is("-I"):
                want_inc = true
            elif w.is("--incremental"):
                want_cache = true
            elif w.is("-j"):
                want_jobs = true
            elif w.is("--static"):
                cli.static_link = true
            elif w.is("--time"):
                time_start()
            elif w.is("--emit-obj"):
                cli.set_emit_only()
            elif w.is("--emit-flat"):
                cli.set_flat_only()
            elif w.is("-O0"):
                cli.set_level(0)
            elif w.is("-O1"):
                cli.set_level(1)
            elif w.is("-O2"):
                cli.set_level(2)
            elif w.is("-O3"):
                cli.set_level(3)
            elif w.n > 0 && w.b[0] == int('-'):
                say(f"error: unknown option '{txt_str(&w)}'\n")
                cli.set_bad()
            elif cli.input.n == 0:
                cli.set_input(&w)
            else:
                say("error: more than one input file\n")
                cli.set_bad()
    return cli

/#/ The directory part of a path ("." when there is none).
fn dir_of(path: &Txt) => Txt:
    let cut = 0 - 1
    for i in 0..path.n:
        if path.b[i] == 47:
            cut = i
    if cut < 0:
        return txt_of(".")
    if cut == 0:
        return txt_of("/")
    return slice(path, 0, cut)

fn usage() => int:
    say("usage: coffee2 input.cf [-o output] [-I dir] [-O0|-O1|-O2|-O3] [--emit-obj] [--emit-flat] [--incremental dir] [--static] [--time] [-j n]\n")
    fflush(0)
    return 2

fn main() => int:
    let fl = new_flat()
    let cli = parse_cli(&fl)
    if cli.bad > 0 || cli.input.n == 0:
        return usage()
    let src = cli.read_input()
    if src.n < 0:
        say(f"error: cannot read '{cli.input_str()}'\n")
        return 1
    let dir = cli.input_dir()
    fl.flatten(&src, &dir, &cli.input)
    if fl.errs > 0:
        return 1
    phase("flatten")
    let tree = parse_bytes_flat(copy_bytes(&fl.out.b, fl.out.n), fl.out.n)
    let fixed = renamed_classes_in(&tree, &fl.out)
    if fixed.n > 0:
        fl.out = fixed
        tree = parse_bytes_flat(copy_bytes(&fl.out.b, fl.out.n), fl.out.n)
    phase("rename")
    if cli.flat_only:
        let flat_path = cli.out_path()
        fl.write_to(&flat_path)
        return 0
    let opt = 0
    if cli.level > 0:
        opt = 1
    if cli.cache.n > 0 && !cli.emit_only:
        let target = cli.out_path()
        let jobs = cli.jobs
        if jobs == 0:
            jobs = online_cpus()
        if jobs > 16:
            jobs = 16
        hoist_classes(&tree)
        return build_incremental(&fl, tree, &cli.cache, &target, opt, jobs, cli.static_link)
    let obj = build_txt(&fl.out, opt, fl.cfc_str())
    if obj.n == 0:
        return 1
    let out = cli.out_path()
    let obj_path = copy_txt(&out)
    if !cli.emit_only:
        obj_path.put(".o")
    write_file(&obj_path, &obj)
    if cli.emit_only:
        return 0
    if cli.static_link:
        /#/ the C library is a program of its own, so its names cannot clash with the program's imports
        let mrt = min_rt_text()
        let rt_obj = build_text(bytes_of_str(&mrt), len(mrt), opt, "")
        if rt_obj.n == 0:
            return 1
        let rt_path = copy_txt(&obj_path)
        rt_path.put(".rt.o")
        write_file(&rt_path, &rt_obj)
        let list = copy_txt(&obj_path)
        list.put_byte(10)
        list.put_all(&rt_path)
        list.put_byte(10)
        let rc = link_static(&list, &out)
        remove_file(&obj_path)
        remove_file(&rt_path)
        return rc
    let cmd = txt_of("cc -w -Wl,--gc-sections -o '")
    cmd.put_all(&out)
    cmd.put("' '")
    cmd.put_all(&obj_path)
    cmd.put("'")
    fl.link_flags(&cmd)
    cmd.put(" -lm")
    let rc = system(txt_str(&cmd))
    remove_file(&obj_path)
    if rc != 0:
        return 1
    return 0
