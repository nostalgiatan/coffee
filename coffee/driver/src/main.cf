/#/ The self-hosted compiler: `coffee2 input.cf [-o out] [-I dir] [-O0..-O3] [--emit-obj]`.
/#/ The code generator is our own x86-64 backend; the system `cc` links the object.
/#/ The standard C library gives a program no arguments, so they are read from /proc/self/cmdline.
/#/ The modules are listed here, each once: an import reached by two paths is a conflict.
use * in drive
use * in cirgen
use * in minrt
use * in cstr
use * in files
use * in flat
use * in linemap
use * in addwarf
use * in nested
use * in alias
use * in incr
use * in timing
use * in static_link
use * in cheader
use fflush, system, exit in libc of c

class Cli:
    input: Txt
    output: Txt
    emit_only: bool
    flat_only: bool
    level: int
    bad: int
    /#/ the directory of the object cache when the build is incremental
    cache: Txt
    /#/ the processes that build units at once; 0 means one per processor
    jobs: int
    static_link: bool
    dynamic: bool
    auto_static: bool
    emit_cir: bool
    /#/ where `--lines` puts the line table
    lines_path: Txt
    /#/ `--stats`: a table of what was generated for each function; `--lint-perf`: findings about slow or pointless code
    stats: bool
    lint: bool
    debug: bool
    /#/ `-c`: the input is a C header and the output a `.cfc`; `--have-c`: also write a `.h` for the `c fn` the program defines
    gen_cfc: bool
    have_c: bool

    fn set_input(self, w: &Txt) => void:
        self.input.put_all(w)

    fn set_output(self, w: &Txt) => void:
        self.output.put_all(w)

    fn set_level(self, l: int) => void:
        self.level = l

    fn set_emit_only(self) => void:
        self.emit_only = true

    fn set_flat_only(self) => void:
        self.flat_only = true

    fn set_bad(self) => void:
        self.bad = 1

    fn input_str(self) => str:
        return txt_str(&self.input)

    fn read_input(self) => Txt:
        return read_file(&self.input)

    fn input_dir(self) => Txt:
        return dir_of(&self.input)

    /#/ The output path: the one given, else `<input>.o` or `a.out`.
    fn out_path(self) => Txt:
        let out = copy_txt(&self.output)
        if out.n == 0:
            if self.flat_only:
                out.put_all(&self.input)
                out.put(".flat")
            elif self.emit_cir:
                out.put_all(&self.input)
                out.put(".cir")
            elif self.emit_only:
                out.put_all(&self.input)
                out.put(".o")
            else:
                out.put("a.out")
        return out

/#/ The arguments, split at the NUL bytes.
fn cmdline() => Txt:
    let p = txt_of("/proc/self/cmdline")
    return read_file(&p)

fn parse_cli(fl: &Flat) => Cli:
    let cli = Cli { input: new_txt(), output: new_txt(), emit_only: false, flat_only: false, level: 1, bad: 0, cache: new_txt(), jobs: 0, static_link: false, dynamic: false, auto_static: false, emit_cir: false, lines_path: new_txt(), stats: false, lint: false, debug: false, gen_cfc: false, have_c: false }
    /#/ the default target is the machine the compiler runs on (a compiler cross compiled for aarch64 or
    /#/ riscv64 writes code for it); `--target=` below overrides
    let hm = host_machine()
    if hm == 183:
        set_target(&txt_of("aarch64-linux"))
        set_ld_arch(target_arch)
    elif hm == 243:
        set_target(&txt_of("riscv64-linux"))
        set_ld_arch(target_arch)
    let raw = cmdline()
    let words = new_txt()
    /#/ one word per line
    for i in 0..raw.n:
        if raw.b[i] == 0:
            words.put_byte(10)
        else:
            words.put_byte(raw.b[i])
    let n = 0
    let s = 0
    let want_out = false
    set_verify(false)
    let want_inc = false
    let want_cache = false
    let want_lines = false
    let want_jobs = false
    for i in 0..words.n:
        if words.b[i] == 10:
            let w = slice(&words, s, i)
            s = i + 1
            n = n + 1
            if n == 1:
                continue
            if want_out:
                cli.set_output(&w)
                want_out = false
            elif want_inc:
                fl.add_dir(&w)
                want_inc = false
            elif want_jobs:
                want_jobs = false
                let v = 0
                for k in 0..w.n:
                    if w.b[k] < 48 || w.b[k] > 57:
                        say("error: -j wants a number\n")
                        cli.set_bad()
                        v = 0 - 1
                        break
                    v = v * 10 + w.b[k] - 48
                if v >= 0:
                    cli.jobs = v
            elif want_cache:
                cli.cache.put_all(&w)
                want_cache = false
            elif want_lines:
                cli.lines_path.put_all(&w)
                want_lines = false
                set_lines()
            elif w.is("-o"):
                want_out = true
            elif w.is("--stats"):
                cli.stats = true
            elif w.is("--lint-perf"):
                cli.lint = true
            elif w.is("--lines"):
                want_lines = true
            elif w.is("-I"):
                want_inc = true
            elif w.is("--incremental"):
                want_cache = true
            elif w.is("-j"):
                want_jobs = true
            elif w.is("-c") || w.is("--gen-cfc"):
                cli.gen_cfc = true
            elif w.is("--have-c"):
                cli.have_c = true
            elif w.is("--static"):
                cli.static_link = true
            elif w.is("--dynamic"):
                cli.dynamic = true
            elif w.is("--no-cc"):
                cli.dynamic = true
                set_builtin_dynamic()
            elif w.is("--sandbox"):
                set_sandbox(true)
            elif w.is("--verify"):
                set_verify(true)
            elif w.is("--emit-ir"):
                set_ir_dump()
            elif w.is("--align"):
                set_fn_align()
            elif w.is("-g"):
                set_keep_syms()
                cli.debug = true
            elif w.is("--time"):
                time_start()
            elif w.is("--pic"):
                set_elf_hide()
            elif w.is("--emit-obj"):
                cli.set_emit_only()
            elif w.is("--emit-cir"):
                cli.emit_cir = true
            elif w.is("--emit-flat"):
                cli.set_flat_only()
            elif has_prefix(&w, "--target="):
                let tn = slice(&w, 9, w.n)
                let st = set_target(&tn)
                if st == 1:
                    say(f"error: unknown target '{txt_str(&tn)}' (known: {target_names()})\n")
                    cli.set_bad()
                elif st == 2:
                    say(f"error: the target '{txt_str(&tn)}' has no code generator yet (known: {target_names()})\n")
                    cli.set_bad()
                else:
                    set_ld_arch(target_arch)
                    set_ld_win64(tg_win64())
            elif has_prefix(&w, "--strength=") && w.n == 12:
                /#/ which loop rewrites run (a bit set, see `set_strength`), whatever the target says; for measuring them
                set_strength(w.b[11] - int('0'))
            elif w.is("-O0"):
                cli.set_level(0)
            elif w.is("-O1"):
                cli.set_level(1)
            elif w.is("-O2"):
                cli.set_level(1)
            elif w.is("-O3"):
                cli.set_level(1)
            elif w.n > 0 && w.b[0] == int('-'):
                say(f"error: unknown option '{txt_str(&w)}'\n")
                cli.set_bad()
            elif cli.input.n == 0:
                cli.set_input(&w)
            else:
                say("error: more than one input file\n")
                cli.set_bad()
    return cli

/#/ The working directory, from `PWD` in the environment; empty when it is not there.
fn count_lines(t: &Txt) => int:
    let n = 0
    for i in 0..t.n:
        if t.b[i] == 10:
            n = n + 1
    return n

/#/ The directory part of a path ("." when there is none).
fn dir_of(path: &Txt) => Txt:
    let cut = 0 - 1
    for i in 0..path.n:
        if path.b[i] == 47:
            cut = i
    if cut < 0:
        return txt_of(".")
    if cut == 0:
        return txt_of("/")
    return slice(path, 0, cut)

fn usage() => int:
    say("usage: coffee2 input.cf [-o output] [--have-c] [-I dir] [-O0|-O1|-O2|-O3] [--emit-obj] [--emit-cir] [--emit-flat] [--lines file] [--incremental dir] [--static|--dynamic|--no-cc] [-g] [--align] [--emit-ir] [--time] [-j n] [--pic] [--target=x86_64-linux]\n       coffee2 -c header.h [-o output.cfc]\n")
    fflush(0)
    return 2

fn main() => int:
    let fl = new_flat()
    let cli = parse_cli(&fl)
    if cli.bad > 0 || cli.input.n == 0:
        return usage()
    let src = cli.read_input()
    if src.n < 0:
        say(f"error: cannot read '{cli.input_str()}'\n")
        return 1
    if cli.gen_cfc:
        return gen_cfc_main(&cli.input, &cli.output)
    if cli.have_c:
        have_c_main(&cli.input, &src)
    let dir = cli.input_dir()
    fl.flatten(&src, &dir, &cli.input)
    if fl.errs > 0:
        return 1
    phase("flatten")
    let tree = parse_bytes_flat(copy_bytes(&fl.out.b, fl.out.n), fl.out.n)
    let fixed = renamed_classes_in(&tree, &fl.out)
    if fixed.n > 0:
        fl.out = fixed
        tree = parse_bytes_flat(copy_bytes(&fl.out.b, fl.out.n), fl.out.n)
    phase("rename")
    if cli.flat_only:
        let flat_path = cli.out_path()
        fl.write_to(&flat_path)
        return 0
    if cli.emit_cir:
        /#/ -O0 makes the module of the first tier: the IR as lowered, not optimized
        let cir_opt = 0
        if cli.level > 0:
            cir_opt = 1
        let vmap = new_txt()
        if cli.debug:
            set_debug_vars()
        let cir = build_cir_map(copy_bytes(&fl.out.b, fl.out.n), fl.out.n, cir_opt, fl.cfc_str(), &vmap)
        no_lines()
        if cir.n == 0:
            return 1
        let cir_path = cli.out_path()
        write_file(&cir_path, &cir)
        if cli.debug:
            /#/ the map of the lines, beside the module, for `cfjit --gdb`
            let pwd = pwd_of()
            let map = new_txt()
            put_line_map(&fl.seg_line, &fl.seg_src, &fl.seg_unit, fl.nseg, &fl.units, fl.lines, &pwd, &map)
            map.put_all(&vmap)
            let map_path = copy_txt(&cir_path)
            map_path.put(".map")
            write_file(&map_path, &map)
        return 0
    if target_os == os_windows() && cli.static_link:
        say("error: --static has no meaning for Windows: the program is linked with the C runtime of MinGW-w64\n")
        return 1
    if !cli.emit_only && !cli.dynamic && target_os != os_windows() && can_link_static(&fl.out, fl.static_objs_complete()):
        /#/ nothing the built-in C library lacks is imported: no `cc` needed
        cli.static_link = true
        cli.auto_static = true
    let opt = 0
    if cli.level > 0:
        opt = 1
    if cli.stats:
        set_stats()
    if cli.lint:
        set_lint_perf()
    if cli.debug || cli.lines_path.n > 0 || cli.lint:
        let pwd = pwd_of()
        set_line_map(&fl.seg_line, &fl.seg_src, &fl.seg_unit, fl.nseg, &fl.units, fl.lines, &pwd)
        if cli.debug:
            set_debug()
            /#/ the types of separately built files would not agree, so no variables then
            if cli.cache.n == 0:
                set_debug_vars()
    if cli.cache.n > 0 && !cli.emit_only:
        let target = cli.out_path()
        let jobs = cli.jobs
        if jobs == 0:
            jobs = online_cpus()
        if jobs > 16:
            jobs = 16
        hoist_classes(&tree)
        return build_incremental(&fl, tree, &cli.cache, &target, opt, jobs, cli.static_link, cli.auto_static, cli.debug)
    let obj = build_txt(&fl.out, opt, fl.cfc_str())
    no_perf()
    if obj.n == 0:
        return 1
    if cli.stats:
        let rep = new_txt()
        stats_report(&rep, 30)
        say(txt_str(&rep))
    if cli.lint:
        say(txt_str(&lint_txt))
        say(f"lint-perf: {count_lines(&lint_txt)} findings\n")
    if cli.lines_path.n > 0:
        write_file(&cli.lines_path, &lines_txt)
    no_lines()
    let out = cli.out_path()
    let obj_path = copy_txt(&out)
    if !cli.emit_only:
        obj_path.put(".o")
    write_file(&obj_path, &obj)
    if cli.emit_only:
        return 0
    let list = copy_txt(&obj_path)
    list.put_byte(10)
    let quoted = txt_of(" '")
    quoted.put_all(&obj_path)
    quoted.put("'")
    let rt_path = copy_txt(&obj_path)
    rt_path.put(".rt.o")
    if cli.static_link:
        /#/ the C library is a program of its own, so its names cannot clash with the program's imports
        let mrt = min_rt_text()
        let rt_obj = build_text(bytes_of_str(&mrt), len(mrt), opt, "")
        if rt_obj.n == 0:
            return 1
        write_file(&rt_path, &rt_obj)
        list.put_all(&rt_path)
        list.put_byte(10)
    /#/ the objects and archives of the C libraries the program imports
    let extra = fl.static_objs()
    list.put_all(&extra)
    let flags = new_txt()
    fl.link_flags(&flags)
    let rc = link_objects(&list, &quoted, &flags, &out, cli.static_link, cli.auto_static)
    if rc == 0 && cli.debug:
        /#/ a program `cc` linked has no DWARF yet: build it from the symbols the link kept
        let exe = read_file(&out)
        let more = add_dwarf(&exe, &lines_txt)
        if more.n > 0:
            write_file(&out, &more)
    remove_file(&obj_path)
    if cli.static_link:
        remove_file(&rt_path)
    return rc
