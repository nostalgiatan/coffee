/#/ Imports of Coffee modules, resolved the way the Rust compiler does it: the module's text
/#/ goes in front of the file that imports it, once, and the `use` line is dropped. Lines that
/#/ import from C stay.
use printf in libc of c

class Flat:
    out: Txt
    /#/ the module names already included, one per line
    seen: Txt
    /#/ the directories to search, one per line
    dirs: Txt
    errs: int
    /#/ the C libraries other than libc and libm, one per line; their `.cfc` text; where they were found
    libs: Txt
    cfc: Txt
    lib_dirs: Txt
    /#/ the source files that went into `out`, one name per line, and the stretches of `out` lines
    /#/ each supplied: from line `seg_line[k]` (0-based) on, until the next stretch, it is file `seg_unit[k]`
    units: Txt
    nunit: int
    seg_line: buf<int>
    seg_unit: buf<int>
    nseg: int
    lines: int
    cur_unit: int

    /#/ Starts a new source file called `name`; its number.
    fn begin_unit(self, name: &Txt) => int:
        self.units.put_all(name)
        self.units.put_byte(10)
        self.nunit = self.nunit + 1
        return self.nunit - 1

    /#/ From the next line of `out` on, the text is from file `u`.
    fn enter(self, u: int) => void:
        if self.nseg >= len(self.seg_line):
            self.seg_line = buf_resize(self.seg_line, (self.nseg + 1) * 2)
            self.seg_unit = buf_resize(self.seg_unit, (self.nseg + 1) * 2)
        self.seg_line[self.nseg] = self.lines
        self.seg_unit[self.nseg] = u
        self.nseg = self.nseg + 1
        self.cur_unit = u

    fn nl(self) => void:
        self.out.put_byte(10)
        self.lines = self.lines + 1

    /#/ The file the 1-based line `line` of `out` came from.
    fn unit_of_line(self, line: int) => int:
        /#/ the segments start at ascending lines: the last one that starts at or before `line`
        let lo = 0
        let hi = self.nseg
        while lo < hi:
            let mid = (lo + hi) // 2
            if self.seg_line[mid] <= line - 1:
                lo = mid + 1
            else:
                hi = mid
        if lo == 0:
            return 0
        return self.seg_unit[lo - 1]

    /#/ The name of file `u`.
    fn unit_name(self, u: int) => Txt:
        let k = 0
        let s = 0
        for i in 0..self.units.n:
            if self.units.b[i] == 10:
                if k == u:
                    return slice(&self.units, s, i)
                k = k + 1
                s = i + 1
        return new_txt()

    fn add_dir(self, w: &Txt) => void:
        self.dirs.put_all(w)
        self.dirs.put_byte(10)

    fn cfc_str(self) => str:
        return txt_str(&self.cfc)

    /#/ `-L<dir> -Wl,-rpath,<dir>` for each place a `.cfc` was found and `-l<lib>` for each library.
    fn link_flags(self, cmd: &Txt) => void:
        let st = 0
        for i in 0..self.lib_dirs.n:
            if self.lib_dirs.b[i] == 10:
                cmd.put(" -L'")
                for k in st..i:
                    cmd.put_byte(self.lib_dirs.b[k])
                cmd.put("' -Wl,-rpath,'")
                for k in st..i:
                    cmd.put_byte(self.lib_dirs.b[k])
                cmd.put("'")
                st = i + 1
        st = 0
        for i in 0..self.libs.n:
            if self.libs.b[i] == 10:
                cmd.put(" -l")
                for k in st..i:
                    cmd.put_byte(self.libs.b[k])
                st = i + 1

    fn out_str(self) => str:
        return txt_str(&self.out)

    fn write_to(self, path: &Txt) => void:
        write_file(path, &self.out)

    /#/ A line that imports from a C library other than libc and libm brings that library's `.cfc`.
    fn note_c_lib(self, src: &Txt, lo: int, hi: int, dir: &Txt) => void:
        let lib = c_lib_name(src, lo, hi)
        if lib.n == 0 || lib.is("libc") || lib.is("libm") || has_line(&self.libs, &lib):
            return
        self.libs.put_all(&lib)
        self.libs.put_byte(10)
        let found = new_txt()
        let text = self.find_file(dir, &lib, ".cfc", &found)
        if text.n < 0:
            self.count_error()
            say(f"error: no {txt_str(&lib)}.cfc next to the program, in lib/ or in an -I directory\n")
            return
        self.cfc.put_all(&text)
        self.cfc.put_byte(10)
        if !has_line(&self.lib_dirs, &found):
            self.lib_dirs.put_all(&found)
            self.lib_dirs.put_byte(10)

    fn count_error(self) => void:
        self.errs = self.errs + 1

    /#/ The text of `module`: first next to the file that imports it (`dir`), then in each search
    /#/ directory. `found` gets the directory it was found in.
    fn find_module(self, dir: &Txt, module: &Txt, found: &Txt) => Txt:
        return self.find_file(dir, module, ".cf", found)

    /#/ File `name` + `ext` in the same places; for `.cfc` also in a `lib` directory of each.
    fn find_file(self, dir: &Txt, module: &Txt, extension: &str, found: &Txt) => Txt:
        let ext = txt_of(extension)
        let src = new_txt()
        src.n = 0 - 1
        let all = new_txt()
        all.put_all(dir)
        all.put_byte(10)
        all.put_all(&self.dirs)
        if len(extension) == 4:
            let n0 = all.n
            let st = 0
            for q in 0..n0 + 1:
                if q == n0 || all.b[q] == 10:
                    if q > st:
                        all.put_byte(10)
                        for z in st..q:
                            all.put_byte(all.b[z])
                        all.put("/lib")
                    st = q + 1
        let s = 0
        for i in 0..all.n + 1:
            if i == all.n || all.b[i] == 10:
                if i > s && src.n < 0:
                    let d = slice(&all, s, i)
                    let p = copy_txt(&d)
                    p.put_byte(47)
                    p.put_all(module)
                    p.put_all(&ext)
                    let got = read_file(&p)
                    if got.n >= 0:
                        src = got
                        found.clear()
                        found.put_all(&d)
                s = i + 1
        return src

    /#/ Adds `src`, whose file is in `dir`, to the output with its imports in front; the aliases
    /#/ of its `use f as g in m` lines are applied first.
    fn flatten(self, src: &Txt, dir: &Txt, name: &Txt) => void:
        let parent = self.cur_unit
        let u = self.begin_unit(name)
        self.enter(u)
        let renamed = renamed_aliases(src)
        if renamed.n > 0:
            self.flatten_text(&renamed, dir)
        else:
            self.flatten_text(src, dir)
        if parent >= 0:
            self.enter(parent)

    fn flatten_text(self, src: &Txt, dir: &Txt) => void:
        let start = 0
        for i in 0..src.n + 1:
            if i == src.n || src.b[i] == 10:
                let module = use_module(src, start, i)
                if module.n == 0:
                    self.note_c_lib(src, start, i, dir)
                    for k in start..i:
                        self.out.put_byte(src.b[k])
                    self.nl()
                elif !has_line(&self.seen, &module):
                    self.seen.put_all(&module)
                    self.seen.put_byte(10)
                    let found = new_txt()
                    let text = self.find_module(dir, &module, &found)
                    if text.n < 0:
                        self.count_error()
                        say(f"error: module '{txt_str(&module)}' not found\n")
                    else:
                        let path = copy_txt(&found)
                        path.put_byte(47)
                        path.put_all(&module)
                        path.put(".cf")
                        self.flatten(&text, &found, &path)
                else:
                    self.nl()
                start = i + 1

fn new_flat() => Flat:
    return Flat { out: new_txt(), seen: new_txt(), dirs: new_txt(), errs: 0, libs: new_txt(), cfc: new_txt(), lib_dirs: new_txt(), units: new_txt(), nunit: 0, seg_line: new_buf(int, 16), seg_unit: new_buf(int, 16), nseg: 0, lines: 0, cur_unit: -1 }

/#/ Is `w` in the lines of `t` (a line equal to it)?
fn has_line(t: &Txt, w: &Txt) => bool:
    let start = 0
    for i in 0..t.n + 1:
        if i == t.n || t.b[i] == 10:
            if i - start == w.n:
                let same = true
                for k in 0..w.n:
                    if t.b[start + k] != w.b[k]:
                        same = false
                if same:
                    return true
            start = i + 1
    return false

/#/ The bytes of `t` from `lo` up to `hi`.
fn slice(t: &Txt, lo: int, hi: int) => Txt:
    let r = new_txt()
    for i in lo..hi:
        r.put_byte(t.b[i])
    return r

/#/ Does the line of `t` that starts at `lo` and ends at `hi` have `w` in it, at `at` or after?
fn find_in(t: &Txt, lo: int, hi: int, w: &str) => int:
    for i in lo..hi:
        let k = 0
        while k < len(w) && i + k < hi && t.b[i + k] == int(w[k]):
            k = k + 1
        if k == len(w):
            return i
    return -1

/#/ The C library a `use ... in NAME of c` line names; empty for any other line.
fn c_lib_name(t: &Txt, lo: int, hi: int) => Txt:
    let m = new_txt()
    if hi - lo < 5 || t.b[lo] != int('u') || t.b[lo + 1] != int('s') || t.b[lo + 2] != int('e') || t.b[lo + 3] != 32:
        return m
    let tail = find_in(t, lo, hi, " of c")
    let inn = find_in(t, lo, hi, " in ")
    if tail < 0 || inn < 0 || inn + 4 >= tail:
        return m
    for k in inn + 4..tail:
        m.put_byte(t.b[k])
    return m

/#/ The module a `use` line (from `lo` to `hi`) names; empty when the line is not a `use`
/#/ of a Coffee module.
fn use_module(t: &Txt, lo: int, hi: int) => Txt:
    let m = new_txt()
    if hi - lo < 5 || t.b[lo] != int('u') || t.b[lo + 1] != int('s') || t.b[lo + 2] != int('e') || t.b[lo + 3] != 32:
        return m
    if find_in(t, lo, hi, " of c") >= 0:
        return m
    let at = lo + 4
    let inn = find_in(t, lo, hi, " in ")
    if inn >= 0:
        at = inn + 4
    while at < hi && t.b[at] == 32:
        at = at + 1
    while at < hi && t.b[at] != 32 && t.b[at] != 13 && t.b[at] != 44:
        m.put_byte(t.b[at])
        at = at + 1
    return m

