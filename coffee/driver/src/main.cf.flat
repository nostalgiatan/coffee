    if c == 10:
        return "\n"
    if c == 9:
        return "\t"
    return "?"

fn span_str(t: &Txt, lo: int, hi: int) => str:
    if hi <= lo:
        return ""
    if hi - lo == 1:
        return ch_str(t.b[lo])
    let mid = (lo + hi) // 2
    let left = span_str(t, lo, mid)
    let right = span_str(t, mid, hi)
    return left + right

/#/ The bytes of `t` as a `str`.
fn txt_str(t: &Txt) => str:
    return span_str(t, 0, t.n)

/#/ Reading and writing whole files by a path held in a `Txt`.
use open, read, write, close, remove, access in libc of c

/#/ The bytes of the file; `n` is -1 when it cannot be opened.
fn read_file(path: &Txt) => Txt:
    let t = new_txt()
    let p = txt_str(path)
    if access(p, 4) != 0:
        t.n = 0 - 1
        return t
    let fd = open(p, 0, 0 as object)
    if fd < 0:
        t.n = 0 - 1
        return t
    let chunk: buf<i8> = new_buf(i8, 65536)
    let got = read(fd, buf_ptr(chunk), 65536)
    while got > 0:
        if t.n + got > len(t.b):
            t.b = buf_resize(t.b, (t.n + got) * 2)
        for k in 0..got:
            t.b[t.n + k] = int(chunk[k]) & 255
        t.n = t.n + got
        got = read(fd, buf_ptr(chunk), 65536)
    close(fd)
    return t

/#/ Writes `t` to the file.
fn write_file(path: &Txt, t: &Txt) => void:
    let fd = open(txt_str(path), 577, 420 as object)
    if fd < 0:
        return
    let chunk: buf<i8> = new_buf(i8, t.n + 1)
    for k in 0..t.n:
        chunk[k] = i8(t.b[k])
    let done = 0
    while done < t.n:
        let w = write(fd, (int(buf_ptr(chunk)) + done) as object, t.n - done)
        if w <= 0:
            break
        done = done + w
    close(fd)

fn remove_file(path: &Txt) => void:
    remove(txt_str(path))

/#/ A `Txt` holding `s`.
fn txt_of(s: &str) => Txt:
    let t = new_txt()
    t.put(s)
    return t

/#/ A new `Txt` with the bytes of `t` (`clone` would share the buffer).
fn copy_txt(t: &Txt) => Txt:
    let r = new_txt()
    r.put_all(t)
    return r

/#/ Imports of Coffee modules, resolved the way the Rust compiler does it: the module's text
/#/ goes in front of the file that imports it, once, and the `use` line is dropped. Lines that
/#/ import from C stay.

class Flat:
    out: Txt
    /#/ the module names already included, one per line
    seen: Txt
    /#/ the directories to search, one per line
    dirs: Txt
    errs: int
    /#/ the C libraries other than libc and libm, one per line; their `.cfc` text; where they were found
    libs: Txt
    cfc: Txt
    lib_dirs: Txt
    /#/ the source files that went into `out`, one name per line, and the stretches of `out` lines
    /#/ each supplied: from line `seg_line[k]` (0-based) on, until the next stretch, it is file `seg_unit[k]`
    units: Txt
    nunit: int
    seg_line: buf<int>
    seg_unit: buf<int>
    /#/ the line of its file (1-based) that each stretch starts at
    seg_src: buf<int>
    /#/ the line of the file being read that the next `enter` stands at
    src_line: int
    nseg: int
    lines: int
    cur_unit: int

    /#/ Starts a new source file called `name`; its number.
    fn begin_unit(self, name: &Txt) => int:
        self.units.put_all(name)
        self.units.put_byte(10)
        self.nunit = self.nunit + 1
        return self.nunit - 1

    /#/ From the next line of `out` on, the text is from file `u`.
    fn enter(self, u: int) => void:
        if self.nseg >= len(self.seg_line):
            self.seg_line = buf_resize(self.seg_line, (self.nseg + 1) * 2)
            self.seg_unit = buf_resize(self.seg_unit, (self.nseg + 1) * 2)
            self.seg_src = buf_resize(self.seg_src, (self.nseg + 1) * 2)
        self.seg_line[self.nseg] = self.lines
        self.seg_unit[self.nseg] = u
        self.seg_src[self.nseg] = self.src_line
        self.nseg = self.nseg + 1
        self.cur_unit = u

    fn nl(self) => void:
        self.out.put_byte(10)
        self.lines = self.lines + 1

    /#/ The line of its file that the 1-based line `line` of `out` came from (0 when past the text).
    fn src_of_line(self, line: int) => int:
        if line < 1 || line > self.lines || self.nseg == 0:
            return 0
        let lo = 0
        let hi = self.nseg
        while lo < hi:
            let mid = (lo + hi) // 2
            if self.seg_line[mid] <= line - 1:
                lo = mid + 1
            else:
                hi = mid
        if lo == 0:
            return line
        return self.seg_src[lo - 1] + (line - 1 - self.seg_line[lo - 1])

    /#/ The file the 1-based line `line` of `out` came from.
    fn unit_of_line(self, line: int) => int:
        /#/ the segments start at ascending lines: the last one that starts at or before `line`
        let lo = 0
        let hi = self.nseg
        while lo < hi:
            let mid = (lo + hi) // 2
            if self.seg_line[mid] <= line - 1:
                lo = mid + 1
            else:
                hi = mid
        if lo == 0:
            return 0
        return self.seg_unit[lo - 1]

    /#/ The name of file `u`.
    fn unit_name(self, u: int) => Txt:
        let k = 0
        let s = 0
        for i in 0..self.units.n:
            if self.units.b[i] == 10:
                if k == u:
                    return slice(&self.units, s, i)
                k = k + 1
                s = i + 1
        return new_txt()

    fn add_dir(self, w: &Txt) => void:
        self.dirs.put_all(w)
        self.dirs.put_byte(10)

    fn cfc_str(self) => str:
        return txt_str(&self.cfc)

    /#/ `-L<dir> -Wl,-rpath,<dir>` for each place a `.cfc` was found and `-l<lib>` for each library.
    fn link_flags(self, cmd: &Txt) => void:
        let st = 0
        for i in 0..self.lib_dirs.n:
            if self.lib_dirs.b[i] == 10:
                cmd.put(" -L'")
                for k in st..i:
                    cmd.put_byte(self.lib_dirs.b[k])
                cmd.put("' -Wl,-rpath,'")
                for k in st..i:
                    cmd.put_byte(self.lib_dirs.b[k])
                cmd.put("'")
                st = i + 1
        st = 0
        for i in 0..self.libs.n:
            if self.libs.b[i] == 10:
                cmd.put(" -l")
                for k in st..i:
                    cmd.put_byte(self.libs.b[k])
                st = i + 1

    fn write_to(self, path: &Txt) => void:
        write_file(path, &self.out)

    /#/ A line that imports from a C library other than libc and libm brings that library's `.cfc`.
    fn note_c_lib(self, src: &Txt, lo: int, hi: int, dir: &Txt) => void:
        let lib = c_lib_name(src, lo, hi)
        if lib.n == 0 || lib.is("libc") || lib.is("libm") || has_line(&self.libs, &lib):
            return
        self.libs.put_all(&lib)
        self.libs.put_byte(10)
        let found = new_txt()
        let text = self.find_file(dir, &lib, ".cfc", &found)
        if text.n < 0:
            self.count_error()
            say(f"error: no {txt_str(&lib)}.cfc next to the program, in lib/ or in an -I directory\n")
            return
        self.cfc.put_all(&text)
        self.cfc.put_byte(10)
        if !has_line(&self.lib_dirs, &found):
            self.lib_dirs.put_all(&found)
            self.lib_dirs.put_byte(10)

    fn count_error(self) => void:
        self.errs = self.errs + 1

    /#/ The text of `module`: first next to the file that imports it (`dir`), then in each search
    /#/ directory. `found` gets the directory it was found in.
    fn find_module(self, dir: &Txt, module: &Txt, found: &Txt) => Txt:
        return self.find_file(dir, module, ".cf", found)

    /#/ File `name` + `ext` in the same places; for `.cfc` also in a `lib` directory of each.
    fn find_file(self, dir: &Txt, module: &Txt, extension: &str, found: &Txt) => Txt:
        let ext = txt_of(extension)
        let src = new_txt()
        src.n = 0 - 1
        let all = new_txt()
        all.put_all(dir)
        all.put_byte(10)
        all.put_all(&self.dirs)
        if len(extension) == 4:
            let n0 = all.n
            let st = 0
            for q in 0..n0 + 1:
                if q == n0 || all.b[q] == 10:
                    if q > st:
                        all.put_byte(10)
                        for z in st..q:
                            all.put_byte(all.b[z])
                        all.put("/lib")
                    st = q + 1
        let s = 0
        for i in 0..all.n + 1:
            if i == all.n || all.b[i] == 10:
                if i > s && src.n < 0:
                    let d = slice(&all, s, i)
                    let p = copy_txt(&d)
                    p.put_byte(47)
                    p.put_all(module)
                    p.put_all(&ext)
                    let got = read_file(&p)
                    if got.n >= 0:
                        src = got
                        found.clear()
                        found.put_all(&d)
                s = i + 1
        return src

    /#/ Adds `src`, whose file is in `dir`, to the output with its imports in front; the aliases
    /#/ of its `use f as g in m` lines are applied first.
    fn flatten(self, src: &Txt, dir: &Txt, name: &Txt) => void:
        let parent = self.cur_unit
        let back = self.src_line
        let u = self.begin_unit(name)
        self.src_line = 1
        self.enter(u)
        let renamed = renamed_aliases(src)
        if renamed.n > 0:
            self.flatten_text(&renamed, dir)
        else:
            self.flatten_text(src, dir)
        if parent >= 0:
            self.src_line = back + 1
            self.enter(parent)

    fn flatten_text(self, src: &Txt, dir: &Txt) => void:
        let start = 0
        let ln = 1
        for i in 0..src.n + 1:
            if i == src.n || src.b[i] == 10:
                self.src_line = ln
                ln = ln + 1
                let module = use_module(src, start, i)
                if module.n == 0:
                    self.note_c_lib(src, start, i, dir)
                    for k in start..i:
                        self.out.put_byte(src.b[k])
                    self.nl()
                elif !has_line(&self.seen, &module):
                    self.seen.put_all(&module)
                    self.seen.put_byte(10)
                    let found = new_txt()
                    let text = self.find_module(dir, &module, &found)
                    if text.n < 0:
                        self.count_error()
                        say(f"error: module '{txt_str(&module)}' not found\n")
                    else:
                        let path = copy_txt(&found)
                        path.put_byte(47)
                        path.put_all(&module)
                        path.put(".cf")
                        self.flatten(&text, &found, &path)
                else:
                    self.nl()
                start = i + 1

fn new_flat() => Flat:
    return Flat { out: new_txt(), seen: new_txt(), dirs: new_txt(), errs: 0, libs: new_txt(), cfc: new_txt(), lib_dirs: new_txt(), units: new_txt(), nunit: 0, seg_line: new_buf(int, 16), seg_unit: new_buf(int, 16), seg_src: new_buf(int, 16), src_line: 1, nseg: 0, lines: 0, cur_unit: -1 }

/#/ Is `w` in the lines of `t` (a line equal to it)?
fn has_line(t: &Txt, w: &Txt) => bool:
    let start = 0
    for i in 0..t.n + 1:
        if i == t.n || t.b[i] == 10:
            if i - start == w.n:
                let same = true
                for k in 0..w.n:
                    if t.b[start + k] != w.b[k]:
                        same = false
                if same:
                    return true
            start = i + 1
    return false

/#/ The bytes of `t` from `lo` up to `hi`.
fn slice(t: &Txt, lo: int, hi: int) => Txt:
    let r = new_txt()
    for i in lo..hi:
        r.put_byte(t.b[i])
    return r

/#/ Does the line of `t` that starts at `lo` and ends at `hi` have `w` in it, at `at` or after?
fn find_in(t: &Txt, lo: int, hi: int, w: &str) => int:
    for i in lo..hi:
        let k = 0
        while k < len(w) && i + k < hi && t.b[i + k] == int(w[k]):
            k = k + 1
        if k == len(w):
            return i
    return -1

/#/ The C library a `use ... in NAME of c` line names; empty for any other line.
fn c_lib_name(t: &Txt, lo: int, hi: int) => Txt:
    let m = new_txt()
    if hi - lo < 5 || t.b[lo] != int('u') || t.b[lo + 1] != int('s') || t.b[lo + 2] != int('e') || t.b[lo + 3] != 32:
        return m
    let tail = find_in(t, lo, hi, " of c")
    let inn = find_in(t, lo, hi, " in ")
    if tail < 0 || inn < 0 || inn + 4 >= tail:
        return m
    for k in inn + 4..tail:
        m.put_byte(t.b[k])
    return m

/#/ The module a `use` line (from `lo` to `hi`) names; empty when the line is not a `use`
/#/ of a Coffee module.
fn use_module(t: &Txt, lo: int, hi: int) => Txt:
    let m = new_txt()
    if hi - lo < 5 || t.b[lo] != int('u') || t.b[lo + 1] != int('s') || t.b[lo + 2] != int('e') || t.b[lo + 3] != 32:
        return m
    if find_in(t, lo, hi, " of c") >= 0:
        return m
    let at = lo + 4
    let inn = find_in(t, lo, hi, " in ")
    if inn >= 0:
        at = inn + 4
    while at < hi && t.b[at] == 32:
        at = at + 1
    while at < hi && t.b[at] != 32 && t.b[at] != 13 && t.b[at] != 44:
        m.put_byte(t.b[at])
        at = at + 1
    return m


/#/ The map from the lines of the flattened text to `file:line`, as a text beside a `.cir` (made with
/#/ `--emit-cir -g`, read by `cfjit` to give the code it generates source lines):
/#/
/#/     M lines segments
/#/     D directory
/#/     U source file             (one for each unit, in order)
/#/     S flat_line source_line unit



fn put_line_map(seg_line: &buf<int>, seg_src: &buf<int>, seg_unit: &buf<int>, nseg: int, units: &Txt, lines: int, dir: &Txt, out: &Txt) => void:
    out.put("M ")
    out.put_int(lines)
    out.put_byte(32)
    out.put_int(nseg)
    out.put_byte(10)
    out.put("D ")
    out.put_all(dir)
    out.put_byte(10)
    let s = 0
    for i in 0..units.n:
        if units.b[i] == 10:
            out.put("U ")
            for k in s..i:
                out.put_byte(units.b[k])
            out.put_byte(10)
            s = i + 1
    for k in 0..nseg:
        out.put("S ")
        out.put_int(seg_line[k])
        out.put_byte(32)
        out.put_int(seg_src[k])
        out.put_byte(32)
        out.put_int(seg_unit[k])
        out.put_byte(10)

/#/ Reads a map made by `put_line_map` and hands it to the line marks of the code generator.
fn read_line_map(t: &Txt) => void:
    let seg_line = new_buf(int, 16)
    let seg_src = new_buf(int, 16)
    let seg_unit = new_buf(int, 16)
    let units = new_txt()
    let dir = new_txt()
    let lines = 0
    let nseg = 0
    let start = 0
    for i in 0..t.n + 1:
        if i < t.n && t.b[i] != 10:
            continue
        if i > start + 1 && t.b[start + 1] == 32:
            let c = t.b[start]
            let body = start + 2
            if c == int('M'):
                let sp = body
                while sp < i && t.b[sp] != 32:
                    sp = sp + 1
                lines = dw_read(t, body, sp)
            elif c == int('D'):
                for k in body..i:
                    dir.put_byte(t.b[k])
            elif c == int('U'):
                for k in body..i:
                    units.put_byte(t.b[k])
                units.put_byte(10)
            elif c == int('S'):
                if nseg >= len(seg_line):
                    seg_line = buf_resize(seg_line, nseg * 2)
                    seg_src = buf_resize(seg_src, nseg * 2)
                    seg_unit = buf_resize(seg_unit, nseg * 2)
                let a = body
                let f = 0
                while a < i:
                    let e = a
                    while e < i && t.b[e] != 32:
                        e = e + 1
                    let v = dw_read(t, a, e)
                    if f == 0:
                        seg_line[nseg] = v
                    elif f == 1:
                        seg_src[nseg] = v
                    else:
                        seg_unit[nseg] = v
                    f = f + 1
                    a = e + 1
                nseg = nseg + 1
        start = i + 1
    set_line_map(&seg_line, &seg_src, &seg_unit, nseg, &units, lines, &dir)

fn dw_read(t: &Txt, s: int, e: int) => int:
    let v = 0
    for k in s..e:
        v = v * 10 + t.b[k] - 48
    return v

/#/ DWARF for an executable another linker made (`--dynamic`, where `cc` links): the sections are built
/#/ from the line table the compiler kept in memory and the addresses and sizes in the executable's own
/#/ symbol table, and appended to the file with the section header table moved to the end.
/#/ DWARF sections (`.debug_abbrev`, `.debug_info`, `.debug_line`, `.debug_frame`) made from the line and type
/#/ tables the compiler leaves (`D dir`, `T` types, `F function`, `L offset file:line`, `V` variables) and the
/#/ addresses of the functions, which a link or a loaded JIT image gives. Version 4, so `gdb`, `valgrind` and
/#/ `perf` read it.


fn dw_uleb(t: &Txt, v: int) => void:
    let x = v
    let more = true
    while more:
        let b = x & 127
        x = x >> 7
        if x != 0:
            t.put_byte(b | 128)
        else:
            t.put_byte(b)
            more = false

fn dw_sleb(t: &Txt, v: int) => void:
    let x = v
    let more = true
    while more:
        let b = x & 127
        x = x >> 7
        let sign = (b & 64) != 0
        if (x == 0 && !sign) || (x == 0 - 1 && sign):
            t.put_byte(b)
            more = false
        else:
            t.put_byte(b | 128)

fn dw_w16(t: &Txt, v: int) => void:
    for k in 0..2:
        t.put_byte((v >> (8 * k)) & 255)

fn dw_w32(t: &Txt, v: int) => void:
    for k in 0..4:
        t.put_byte((v >> (8 * k)) & 255)

fn dw_w64(t: &Txt, v: int) => void:
    for k in 0..8:
        t.put_byte((v >> (8 * k)) & 255)


class DwList:
    b: buf<int>
    n: int

fn new_dw_list() => DwList:
    return DwList { b: new_buf(int, 64), n: 0 }

fn dw_push(l: &DwList, v: int) => void:
    if l.n >= len(l.b):
        l.b = buf_resize(l.b, (l.n + 1) * 2)
    l.b[l.n] = v
    l.n = l.n + 1

/#/ The end of the word of `t` that starts at `s` (words are separated by spaces, `e` ends the line).
fn dw_wend(t: &Txt, s: int, e: int) => int:
    let k = s
    while k < e && t.b[k] != 32:
        k = k + 1
    return k

fn dw_num(t: &Txt, s: int, e: int) => int:
    let neg = false
    let k = s
    if k < e && t.b[k] == 45:
        neg = true
        k = k + 1
    let v = 0
    while k < e:
        v = v * 10 + t.b[k] - 48
        k = k + 1
    if neg:
        return 0 - v
    return v

fn dw_str(out: &Txt, t: &Txt, s: int, e: int) => void:
    for k in s..e:
        out.put_byte(t.b[k])
    out.put_byte(0)

/#/ A reference to the type `id`, patched when the offsets of all types are known.
fn dw_ref(out: &Txt, fx_p: &DwList, fx_i: &DwList, id: int) => void:
    dw_push(fx_p, out.n)
    dw_push(fx_i, id)
    dw_w32(out, 0)

fn dw_ab(abbrev: &Txt, code: int, tag: int, kids: int) => void:
    abbrev.put_byte(code)
    abbrev.put_byte(tag)
    abbrev.put_byte(kids)

fn dw_abp(abbrev: &Txt, at: int, form: int) => void:
    abbrev.put_byte(at)
    abbrev.put_byte(form)
    
/#/ The DIE of the type line `T id kind ...` in `t[s..e]`.
fn dw_type(out: &Txt, ids: &DwList, offs: &DwList, fx_p: &DwList, fx_i: &DwList, t: &Txt, s: int, e: int) => void:
    let a = dw_wend(t, s + 2, e)
    let id = dw_num(t, s + 2, a)
    let kind = t.b[a + 1]
    let w = a + 3
    dw_push(ids, id)
    dw_push(offs, out.n)
    if kind == int('i') || kind == int('f') || kind == int('o'):
        let w2 = dw_wend(t, w, e)
        let size = dw_num(t, w, w2)
        out.put_byte(4)
        let enc = 8
        if kind == int('i'):
            let w3 = dw_wend(t, w2 + 1, e)
            let signed = dw_num(t, w2 + 1, w3)
            enc = 7
            dw_int_name(out, signed, size)
            if signed == 1:
                enc = 5
        elif kind == int('f'):
            enc = 4
            out.put("float")
            if size != 8:
                out.put("32")
        else:
            out.put("bytes")
        out.put_byte(0)
        out.put_byte(enc)
        dw_uleb(out, size)
    elif kind == int('b'):
        out.put_byte(4)
        out.put("bool")
        out.put_byte(0)
        out.put_byte(2)
        dw_uleb(out, 1)
    elif kind == int('s'):
        out.put_byte(5)
        dw_uleb(out, 8)
        dw_ref(out, fx_p, fx_i, 0 - 2)
    elif kind == int('p'):
        let target = dw_num(t, w, e)
        if target < 0:
            out.put_byte(6)
            dw_uleb(out, 8)
        else:
            out.put_byte(5)
            dw_uleb(out, 8)
            dw_ref(out, fx_p, fx_i, target)
    elif kind == int('S'):
        let w2 = dw_wend(t, w, e)
        out.put_byte(7)
        dw_str(out, t, w, w2)
        let w3 = dw_wend(t, w2 + 1, e)
        dw_uleb(out, dw_num(t, w2 + 1, w3))
        let w4 = dw_wend(t, w3 + 1, e)
        let q = w4 + 1
        while q < e:
            let q2 = dw_wend(t, q, e)
            let c1 = q
            while c1 < q2 && t.b[c1] != 58:
                c1 = c1 + 1
            let c2 = c1 + 1
            while c2 < q2 && t.b[c2] != 58:
                c2 = c2 + 1
            out.put_byte(8)
            dw_str(out, t, q, c1)
            dw_ref(out, fx_p, fx_i, dw_num(t, c1 + 1, c2))
            dw_uleb(out, dw_num(t, c2 + 1, q2))
            q = q2 + 1
        out.put_byte(0)

fn dw_int_name(out: &Txt, signed: int, size: int) => void:
    if signed == 1 && size == 8:
        out.put("int")
        return
    if signed == 1:
        out.put("int")
    else:
        out.put("uint")
    out.put_int(size * 8)

/#/ The DIE of the variable line `V name type offset P|L` in `t[s..e]`.
fn dw_var(out: &Txt, fx_p: &DwList, fx_i: &DwList, t: &Txt, s: int, e: int) => void:
    let a = dw_wend(t, s + 2, e)
    let b = dw_wend(t, a + 1, e)
    let c = dw_wend(t, b + 1, e)
    if t.b[c + 1] == int('P'):
        out.put_byte(9)
    else:
        out.put_byte(10)
    dw_str(out, t, s + 2, a)
    dw_ref(out, fx_p, fx_i, dw_num(t, a + 1, b))
    let ex = new_txt()
    /#/ DW_OP_fbreg: the offset from rbp, which is the CFA - 16
    ex.put_byte(145)
    dw_sleb(&ex, dw_num(t, b + 1, c) - 16)
    dw_uleb(out, ex.n)
    out.put_all(&ex)

/#/ Writes the offset of each reference the type table gave out.
fn dw_patch(out: &Txt, fx_p: &DwList, fx_i: &DwList, ids: &DwList, offs: &DwList, base: int, shift: int) => void:
    for k in 0..fx_p.n:
        let want = fx_i.b[k]
        let v = 0
        for j in 0..ids.n:
            if ids.b[j] == want:
                v = base + offs.b[j]
        for m in 0..4:
            out.b[shift + fx_p.b[k] + m] = (v >> (8 * m)) & 255

/#/ The number (from 1) of `name` among the lines of `files`, which gets it when it is new.
fn dw_file(files: &Txt, name: &Txt) => int:
    let n = 0
    let s = 0
    for i in 0..files.n:
        if files.b[i] == 10:
            n = n + 1
            if i - s == name.n:
                let same = true
                for k in 0..name.n:
                    if files.b[s + k] != name.b[k]:
                        same = false
                if same:
                    return n
            s = i + 1
    files.put_all(name)
    files.put_byte(10)
    return n + 1

/#/ Appends the DIE of the function read last (`fhead`, its variables in `fvars`) to `kids`.
fn dw_flush(kids: &Txt, fhead: &Txt, fvars: &Txt, ffx_p: &DwList, ffx_i: &DwList, kfx_p: &DwList, kfx_i: &DwList, nvar: int) => void:
    if fhead.n == 0:
        return
    if nvar > 0:
        kids.put_byte(3)
    else:
        kids.put_byte(2)
    kids.put_all(fhead)
    if nvar > 0:
        for k in 0..ffx_p.n:
            dw_push(kfx_p, kids.n + ffx_p.b[k])
            dw_push(kfx_i, ffx_i.b[k])
        kids.put_all(fvars)
        kids.put_byte(0)
    fhead.clear()
    fvars.clear()
    ffx_p.n = 0
    ffx_i.n = 0

/#/ Makes the three sections; false when no function has lines.
/#/ `ta` and `ts` have, for the n-th `F` line of the table `t`, the address and size of that function
/#/ (address -1: it is not in the program).
fn build_dwarf_core(t: &Txt, ta: &DwList, ts: &DwList, abbrev: &Txt, info: &Txt, line: &Txt, frame: &Txt) => bool:
    let fk = 0 - 1
    if t.n == 0:
        return false
    let dir = new_txt()
    let files = new_txt()
    let prog = new_txt()
    let kids = new_txt()
    /#/ the type DIEs, their ids and offsets, and the references to patch (in them, in the kids, in the
    /#/ function being read)
    let tdies = new_txt()
    let tids = new_dw_list()
    let toffs = new_dw_list()
    let tfx_p = new_dw_list()
    let tfx_i = new_dw_list()
    let kfx_p = new_dw_list()
    let kfx_i = new_dw_list()
    let ffx_p = new_dw_list()
    let ffx_i = new_dw_list()
    let fhead = new_txt()
    let fvars = new_txt()
    let nvar = 0
    /#/ .debug_frame: the one CIE (the CFA is rsp+8 at a function's entry, the return address below it)
    dw_w32(frame, 20)
    dw_w32(frame, 4294967295)
    frame.put_byte(1)
    frame.put_byte(0)
    frame.put_byte(1)
    frame.put_byte(120)
    frame.put_byte(16)
    frame.put_byte(12)
    frame.put_byte(7)
    frame.put_byte(8)
    frame.put_byte(144)
    frame.put_byte(1)
    for k in 0..6:
        frame.put_byte(0)
    /#/ the char type that string pointers point to
    dw_push(&tids, 0 - 2)
    dw_push(&toffs, 0)
    tdies.put_byte(4)
    tdies.put("char")
    tdies.put_byte(0)
    tdies.put_byte(6)
    dw_uleb(&tdies, 1)
    let lo = 0
    let hi = 0
    let nfn = 0
    /#/ the function being read
    let live = false
    let fresh = false
    let faddr = 0
    let fsize = 0
    let cur_addr = 0
    let cur_line = 1
    let cur_file = 1
    let start = 0
    for i in 0..t.n + 1:
        if i < t.n && t.b[i] != 10:
            continue
        if i > start + 2 && t.b[start + 1] == 32:
            let c = t.b[start]
            if c == int('D'):
                if dir.n == 0:
                    for k in start + 2..i:
                        dir.put_byte(t.b[k])
            elif c == int('T'):
                dw_type(&tdies, &tids, &toffs, &tfx_p, &tfx_i, t, start, i)
            elif c == int('V'):
                if live:
                    dw_var(&fvars, &ffx_p, &ffx_i, t, start, i)
                    nvar = nvar + 1
            elif c == int('F'):
                fk = fk + 1
                dw_flush(&kids, &fhead, &fvars, &ffx_p, &ffx_i, &kfx_p, &kfx_i, nvar)
                nvar = 0
                if live:
                    if faddr + fsize > cur_addr:
                        prog.put_byte(2)
                        dw_uleb(&prog, faddr + fsize - cur_addr)
                    prog.put_byte(0)
                    prog.put_byte(1)
                    prog.put_byte(1)
                live = false
                let w = new_txt()
                for k in start + 2..i:
                    w.put_byte(t.b[k])
                let ad = 0 - 1
                if fk < ta.n:
                    ad = ta.b[fk]
                if ad >= 0:
                    live = true
                    fresh = true
                    faddr = ad
                    fsize = ts.b[fk]
                    if nfn == 0 || faddr < lo:
                        lo = faddr
                    if faddr + fsize > hi:
                        hi = faddr + fsize
                    nfn = nfn + 1
                    prog.put_byte(0)
                    prog.put_byte(9)
                    prog.put_byte(2)
                    dw_w64(&prog, faddr)
                    cur_addr = faddr
                    cur_line = 1
                    cur_file = 1
                    fhead.put_all(&w)
                    fhead.put_byte(0)
                    dw_w64(&fhead, faddr)
                    dw_w64(&fhead, fsize)
                    /#/ the frame base is the CFA, which is rbp+16 once `push rbp; mov rbp, rsp` ran
                    fhead.put_byte(1)
                    fhead.put_byte(156)
                    dw_w32(frame, 28)
                    dw_w32(frame, 0)
                    dw_w64(frame, faddr)
                    dw_w64(frame, fsize)
                    frame.put_byte(65)
                    frame.put_byte(14)
                    frame.put_byte(16)
                    frame.put_byte(134)
                    frame.put_byte(2)
                    frame.put_byte(67)
                    frame.put_byte(13)
                    frame.put_byte(6)
            elif c == int('L') && live:
                let q = start + 2
                let off = 0
                while q < i && t.b[q] != 32:
                    off = off * 10 + t.b[q] - 48
                    q = q + 1
                q = q + 1
                let colon = i
                for k in q..i:
                    if t.b[k] == 58:
                        colon = k
                let name = new_txt()
                for k in q..colon:
                    name.put_byte(t.b[k])
                let ln = 0
                for k in colon + 1..i:
                    ln = ln * 10 + t.b[k] - 48
                let fi = dw_file(&files, &name)
                if fresh && off > 0:
                    /#/ the start of the function is a row too (the line of its first statement), so that a
                    /#/ debugger sees the prologue as part of the function
                    if fi != cur_file:
                        prog.put_byte(4)
                        dw_uleb(&prog, fi)
                        cur_file = fi
                    prog.put_byte(3)
                    dw_sleb(&prog, ln - cur_line)
                    cur_line = ln
                    prog.put_byte(1)
                fresh = false
                if fi != cur_file:
                    prog.put_byte(4)
                    dw_uleb(&prog, fi)
                    cur_file = fi
                if ln != cur_line:
                    prog.put_byte(3)
                    dw_sleb(&prog, ln - cur_line)
                    cur_line = ln
                if faddr + off > cur_addr:
                    prog.put_byte(2)
                    dw_uleb(&prog, faddr + off - cur_addr)
                    cur_addr = faddr + off
                prog.put_byte(1)
        start = i + 1
    dw_flush(&kids, &fhead, &fvars, &ffx_p, &ffx_i, &kfx_p, &kfx_i, nvar)
    if live:
        if faddr + fsize > cur_addr:
            prog.put_byte(2)
            dw_uleb(&prog, faddr + fsize - cur_addr)
        prog.put_byte(0)
        prog.put_byte(1)
        prog.put_byte(1)
    if nfn == 0:
        return false
    /#/ .debug_abbrev
    abbrev.put_byte(1)
    abbrev.put_byte(17)
    abbrev.put_byte(1)
    for p in 0..7:
        let at = 0
        let form = 0
        if p == 0:
            at = 37
            form = 8
        elif p == 1:
            at = 19
            form = 11
        elif p == 2:
            at = 3
            form = 8
        elif p == 3:
            at = 27
            form = 8
        elif p == 4:
            at = 17
            form = 1
        elif p == 5:
            at = 18
            form = 7
        else:
            at = 16
            form = 23
        abbrev.put_byte(at)
        abbrev.put_byte(form)
    abbrev.put_byte(0)
    abbrev.put_byte(0)
    for code in 2..4:
        dw_ab(abbrev, code, 46, code - 2)
        dw_abp(abbrev, 3, 8)
        dw_abp(abbrev, 17, 1)
        dw_abp(abbrev, 18, 7)
        dw_abp(abbrev, 64, 24)
        dw_abp(abbrev, 63, 25)
        abbrev.put_byte(0)
        abbrev.put_byte(0)
    dw_ab(abbrev, 4, 36, 0)
    dw_abp(abbrev, 3, 8)
    dw_abp(abbrev, 62, 11)
    dw_abp(abbrev, 11, 15)
    abbrev.put_byte(0)
    abbrev.put_byte(0)
    dw_ab(abbrev, 5, 15, 0)
    dw_abp(abbrev, 11, 15)
    dw_abp(abbrev, 73, 19)
    abbrev.put_byte(0)
    abbrev.put_byte(0)
    dw_ab(abbrev, 6, 15, 0)
    dw_abp(abbrev, 11, 15)
    abbrev.put_byte(0)
    abbrev.put_byte(0)
    dw_ab(abbrev, 7, 19, 1)
    dw_abp(abbrev, 3, 8)
    dw_abp(abbrev, 11, 15)
    abbrev.put_byte(0)
    abbrev.put_byte(0)
    dw_ab(abbrev, 8, 13, 0)
    dw_abp(abbrev, 3, 8)
    dw_abp(abbrev, 73, 19)
    dw_abp(abbrev, 56, 15)
    abbrev.put_byte(0)
    abbrev.put_byte(0)
    for code in 9..11:
        dw_ab(abbrev, code, 5 + (code - 9) * 47, 0)
        dw_abp(abbrev, 3, 8)
        dw_abp(abbrev, 73, 19)
        dw_abp(abbrev, 2, 24)
        abbrev.put_byte(0)
        abbrev.put_byte(0)
    abbrev.put_byte(0)
    /#/ .debug_info
    let cu = new_txt()
    cu.put_byte(1)
    cu.put("coffee2")
    cu.put_byte(0)
    cu.put_byte(12)
    let first = 0
    while first < files.n && files.b[first] != 10:
        cu.put_byte(files.b[first])
        first = first + 1
    cu.put_byte(0)
    if dir.n == 0:
        cu.put_byte(46)
    cu.put_all(&dir)
    cu.put_byte(0)
    dw_w64(&cu, lo)
    dw_w64(&cu, hi - lo)
    dw_w32(&cu, 0)
    /#/ offsets in the unit: its 11 byte header, then the DIE above, the types, the functions
    let cbase = 11 + cu.n
    dw_patch(&tdies, &tfx_p, &tfx_i, &tids, &toffs, cbase, 0)
    dw_patch(&kids, &kfx_p, &kfx_i, &tids, &toffs, cbase, 0)
    cu.put_all(&tdies)
    cu.put_all(&kids)
    cu.put_byte(0)
    dw_w32(info, cu.n + 7)
    dw_w16(info, 4)
    dw_w32(info, 0)
    info.put_byte(8)
    info.put_all(&cu)
    /#/ .debug_line
    let hdr = new_txt()
    hdr.put_byte(1)
    hdr.put_byte(1)
    hdr.put_byte(1)
    hdr.put_byte(251)
    hdr.put_byte(14)
    hdr.put_byte(13)
    for k in 0..12:
        let n = 0
        if k == 1 || k == 2 || k == 3 || k == 4 || k == 8 || k == 11:
            n = 1
        hdr.put_byte(n)
    hdr.put_byte(0)
    let s = 0
    for i in 0..files.n:
        if files.b[i] == 10:
            for k in s..i:
                hdr.put_byte(files.b[k])
            hdr.put_byte(0)
            hdr.put_byte(0)
            hdr.put_byte(0)
            hdr.put_byte(0)
            s = i + 1
    hdr.put_byte(0)
    dw_w32(line, 2 + 4 + hdr.n + prog.n)
    dw_w16(line, 4)
    dw_w32(line, hdr.n)
    line.put_all(&hdr)
    line.put_all(&prog)
    return true



fn ef_rd(t: &Txt, at: int, n: int) => int:
    let v = 0
    for k in 0..n:
        v = v | (t.b[at + k] << (8 * k))
    return v

fn ef_wr(t: &Txt, at: int, n: int, v: int) => void:
    for k in 0..n:
        t.b[at + k] = (v >> (8 * k)) & 255

fn ef_w(t: &Txt, n: int, v: int) => void:
    for k in 0..n:
        t.put_byte((v >> (8 * k)) & 255)

/#/ Is the NUL-ended text at `at` in `t` the same as the line `w`?
fn ef_name_is(t: &Txt, at: int, w: &Txt) => bool:
    for k in 0..w.n:
        if at + k >= t.n || t.b[at + k] != w.b[k]:
            return false
    return at + w.n < t.n && t.b[at + w.n] == 0

/#/ The section number named `name` (-1 when there is none).
fn ef_section(t: &Txt, name: &str) => int:
    let shoff = ef_rd(t, 40, 8)
    let shnum = ef_rd(t, 60, 2)
    let shstr = ef_rd(t, 62, 2)
    let strtab = ef_rd(t, shoff + shstr * 64 + 24, 8)
    for s in 0..shnum:
        let nm = strtab + ef_rd(t, shoff + s * 64, 4)
        let k = 0
        while k < len(name) && t.b[nm + k] == int(name[k]):
            k = k + 1
        if k == len(name) && t.b[nm + k] == 0:
            return s
    return 0 - 1

/#/ The bytes of the section `name` of the ELF file `t` (empty when it has none).
fn elf_section_bytes(t: &Txt, name: &str) => Txt:
    let out = new_txt()
    if t.n < 64 || t.b[0] != 127:
        return out
    let s = ef_section(t, name)
    if s < 0:
        return out
    let shoff = ef_rd(t, 40, 8)
    let off = ef_rd(t, shoff + s * 64 + 24, 8)
    let size = ef_rd(t, shoff + s * 64 + 32, 8)
    for k in 0..size:
        out.put_byte(t.b[off + k])
    return out

/#/ `exe` with the debug sections for the line table `dbg`; empty when it cannot be done (not a 64-bit
/#/ ELF, no symbol table, or it has debug sections already).
fn add_dwarf(exe: &Txt, dbg: &Txt) => Txt:
    let none = new_txt()
    if exe.n < 64 || exe.b[0] != 127 || exe.b[4] != 2 || dbg.n == 0:
        return none
    if ef_section(exe, ".debug_info") >= 0:
        return none
    let sym = ef_section(exe, ".symtab")
    if sym < 0:
        return none
    let shoff = ef_rd(exe, 40, 8)
    let shnum = ef_rd(exe, 60, 2)
    let shstr = ef_rd(exe, 62, 2)
    let sy_off = ef_rd(exe, shoff + sym * 64 + 24, 8)
    let sy_size = ef_rd(exe, shoff + sym * 64 + 32, 8)
    let sy_str = ef_rd(exe, shoff + ef_rd(exe, shoff + sym * 64 + 40, 4) * 64 + 24, 8)
    let nsym = sy_size // 24
    /#/ the functions of the table, by the symbols
    let ta = new_dw_list()
    let ts = new_dw_list()
    let start = 0
    for i in 0..dbg.n + 1:
        if i < dbg.n && dbg.b[i] != 10:
            continue
        if i > start + 2 && dbg.b[start] == int('F') && dbg.b[start + 1] == 32:
            let w = new_txt()
            for k in start + 2..i:
                w.put_byte(dbg.b[k])
            let addr = 0 - 1
            let size = 0
            for q in 0..nsym:
                let e = sy_off + q * 24
                if (ef_rd(exe, e + 4, 1) & 15) == 2 && ef_name_is(exe, sy_str + ef_rd(exe, e, 4), &w):
                    addr = ef_rd(exe, e + 8, 8)
                    size = ef_rd(exe, e + 16, 8)
            dw_push(&ta, addr)
            dw_push(&ts, size)
        start = i + 1
    let dab = new_txt()
    let din = new_txt()
    let dli = new_txt()
    let dfr = new_txt()
    if !build_dwarf_core(dbg, &ta, &ts, &dab, &din, &dli, &dfr):
        return none
    let out = new_txt()
    out.put_all(exe)
    while out.n % 8 != 0:
        out.put_byte(0)
    let o_dab = out.n
    out.put_all(&dab)
    let o_din = out.n
    out.put_all(&din)
    let o_dli = out.n
    out.put_all(&dli)
    let o_dfr = out.n
    out.put_all(&dfr)
    /#/ the section names: the old ones, then ours
    let old_str = ef_rd(exe, shoff + shstr * 64 + 24, 8)
    let old_len = ef_rd(exe, shoff + shstr * 64 + 32, 8)
    while out.n % 8 != 0:
        out.put_byte(0)
    let o_str = out.n
    for k in 0..old_len:
        out.put_byte(exe.b[old_str + k])
    let n_dab = old_len
    out.put(".debug_abbrev")
    out.put_byte(0)
    let n_din = old_len + 14
    out.put(".debug_info")
    out.put_byte(0)
    let n_dli = n_din + 12
    out.put(".debug_line")
    out.put_byte(0)
    let n_dfr = n_dli + 12
    out.put(".debug_frame")
    out.put_byte(0)
    let str_len = n_dfr + 13
    while out.n % 8 != 0:
        out.put_byte(0)
    let new_sh = out.n
    for k in 0..shnum * 64:
        out.put_byte(exe.b[shoff + k])
    /#/ the string table section now lives at the end
    ef_wr(&out, new_sh + shstr * 64 + 24, 8, o_str)
    ef_wr(&out, new_sh + shstr * 64 + 32, 8, str_len)
    for q in 0..4:
        let nm = n_dab
        let off = o_dab
        let sz = dab.n
        if q == 1:
            nm = n_din
            off = o_din
            sz = din.n
        elif q == 2:
            nm = n_dli
            off = o_dli
            sz = dli.n
        elif q == 3:
            nm = n_dfr
            off = o_dfr
            sz = dfr.n
        ef_w(&out, 4, nm)
        ef_w(&out, 4, 1)
        ef_w(&out, 8, 0)
        ef_w(&out, 8, 0)
        ef_w(&out, 8, off)
        ef_w(&out, 8, sz)
        ef_w(&out, 4, 0)
        ef_w(&out, 4, 0)
        ef_w(&out, 8, 1)
        ef_w(&out, 8, 0)
    ef_wr(&out, 40, 8, new_sh)
    ef_wr(&out, 60, 2, shnum + 4)
    return out

/#/ Classes declared in a function body are hoisted to module level by the parser, so two functions
/#/ that each declare `class P` would collide. The flattened text is rewritten before the front end
/#/ sees it: inside the owning function every `P` becomes `P__n<function node>`.

/#/ Is the nested class `c` declared by `f` named like a nested class of another function?
fn nested_collides(a: &Ast, f: int, c: int) => bool:
    for g in 0..a.count:
        if g == f || a.kind[g] != int(Nk.Fn) || a.pc[g] < 0:
            continue
        let o = a.child[a.pc[g]]
        while o >= 0:
            if a.kind[o] == int(Nk.Class) && a.pa[o] >= 0 && same_tok(a, a.pa[o], a.pa[c]):
                return true
            o = a.next[o]
    return false

/#/ `src` with the colliding nested class names made unique; empty when nothing collides.
fn renamed_classes(src: &Txt) => Txt:
    let a = parse_bytes_flat(copy_bytes(&src.b, src.n), src.n)
    return renamed_classes_in(&a, src)

/#/ Like `renamed_classes`, for the tree `a` that `parse_bytes_flat` made of `src`.
fn renamed_classes_in(a: &Ast, src: &Txt) => Txt:
    if a.err_count > 0:
        return new_txt()
    let rn = new_buf(int, a.toks.count + 1)
    let any = false
    for f in 0..a.count:
        if a.kind[f] != int(Nk.Fn) || a.pc[f] < 0:
            continue
        let c = a.child[a.pc[f]]
        while c >= 0:
            if a.kind[c] == int(Nk.Class) && a.pa[c] >= 0 && nested_collides(a, f, c):
                any = true
                for q in a.tok[f]..a.end[f]:
                    if a.toks.kind[q] == int(Tk.Ident) && same_tok(a, q, a.pa[c]) && !(q > 0 && a.toks.kind[q - 1] == int(Tk.Dot)):
                        rn[q] = f + 1
            c = a.next[c]
    if !any:
        return new_txt()
    let out = new_txt()
    let pos = 0
    for q in 0..a.toks.count:
        if rn[q] > 0:
            while pos < a.toks.end[q]:
                out.put_byte(src.b[pos])
                pos = pos + 1
            out.put("__n")
            out.put_int(rn[q] - 1)
    while pos < src.n:
        out.put_byte(src.b[pos])
        pos = pos + 1
    return out

/#/ `use f as g in m` names function `f` of module `m` as `g` in the file that says so. Modules are
/#/ flattened into one text, so the alias is applied there: in that file's own text every `g` (not a
/#/ field or method name after a `.`, not inside a string or comment) becomes `f`. The names `f`
/#/ and `g` share the one flat namespace, so an alias to a name the file also declares is not told apart.
/#/
/#/ `use m as a` names module `m` as `a`: `a.f(x)` and `a.Point {...}` in that file become `f(x)` and
/#/ `Point {...}`. The prefix is dropped wherever the name `a` is followed by a `.` and is not itself
/#/ after one, so a local variable called `a` would be read as the module.

/#/ Do the identifier tokens `x` and `y` of `t` spell the same name?
fn same_ident(t: &Txt, tk: &Tokens, x: int, y: int) => bool:
    let n = tk.end[x] - tk.start[x]
    if n != tk.end[y] - tk.start[y]:
        return false
    for k in 0..n:
        if t.b[tk.start[x] + k] != t.b[tk.start[y] + k]:
            return false
    return true

/#/ Does a line of `src` start with `use ` and have ` as ` in it? Without one there is nothing to lex.
fn has_alias_line(src: &Txt) => bool:
    let start = 0
    for i in 0..src.n + 1:
        if i == src.n || src.b[i] == 10:
            if i - start > 8 && src.b[start] == int('u') && src.b[start + 1] == int('s') && src.b[start + 2] == int('e') && src.b[start + 3] == 32 && find_in(src, start, i, " as ") >= 0:
                return true
            start = i + 1
    return false

/#/ `src` with the aliases of its `use` lines applied; empty when it has none.
fn renamed_aliases(src: &Txt) => Txt:
    if !has_alias_line(src):
        return new_txt()
    let tk = lex_bytes(&src.b, src.n)
    /#/ to[q] = the token whose text replaces identifier token q, -1 for none
    let to = new_buf(int, tk.count + 1)
    for q in 0..tk.count + 1:
        to[q] = -1
    let from_tok = new_buf(int, 8)
    let to_tok = new_buf(int, 8)
    let pairs = 0
    let mods = new_buf(int, 8)
    let nmods = 0
    let in_use = false
    let w = 0
    while w < tk.count:
        let k = tk.kind[w]
        if k == int(Tk.KwUse):
            in_use = true
        elif k == int(Tk.Newline):
            in_use = false
        elif in_use && k == int(Tk.KwAs) && w > 0 && w + 1 < tk.count && tk.kind[w - 1] == int(Tk.Ident) && tk.kind[w + 1] == int(Tk.Ident):
            /#/ `f as g` before `in`; `m as g` with no `in` after it names a module, not a function
            let before_in = false
            let z = w
            while z < tk.count && tk.kind[z] != int(Tk.Newline):
                if tk.kind[z] == int(Tk.KwIn):
                    before_in = true
                z = z + 1
            /#/ `use m as a`: no `in` or `of` anywhere on the line
            let plain = !before_in
            let ls = w
            while ls > 0 && tk.kind[ls - 1] != int(Tk.Newline):
                ls = ls - 1
            for y in ls..w:
                if tk.kind[y] == int(Tk.KwIn):
                    plain = false
            if plain:
                if nmods >= len(mods):
                    mods = buf_resize(mods, nmods * 2)
                mods[nmods] = w + 1
                nmods = nmods + 1
            if before_in:
                if pairs >= len(from_tok):
                    from_tok = buf_resize(from_tok, pairs * 2)
                    to_tok = buf_resize(to_tok, pairs * 2)
                from_tok[pairs] = w + 1
                to_tok[pairs] = w - 1
                pairs = pairs + 1
        w = w + 1
    if pairs == 0 && nmods == 0:
        return new_txt()
    in_use = false
    for q in 0..tk.count:
        let k = tk.kind[q]
        if k == int(Tk.KwUse):
            in_use = true
        elif k == int(Tk.Newline):
            in_use = false
        elif k == int(Tk.Ident) && !in_use && !(q > 0 && tk.kind[q - 1] == int(Tk.Dot)):
            for p in 0..pairs:
                if same_ident(src, &tk, q, from_tok[p]):
                    to[q] = to_tok[p]
            if q + 1 < tk.count && tk.kind[q + 1] == int(Tk.Dot):
                for p in 0..nmods:
                    if same_ident(src, &tk, q, mods[p]):
                        to[q] = -2
    let changed = false
    for q in 0..tk.count:
        if to[q] != -1:
            changed = true
    if !changed:
        return new_txt()
    let out = new_txt()
    let pos = 0
    for q in 0..tk.count:
        if to[q] == -2:
            while pos < tk.start[q]:
                out.put_byte(src.b[pos])
                pos = pos + 1
            pos = tk.end[q + 1]
        elif to[q] >= 0:
            while pos < tk.start[q]:
                out.put_byte(src.b[pos])
                pos = pos + 1
            for z in tk.start[to[q]]..tk.end[to[q]]:
                out.put_byte(src.b[z])
            pos = tk.end[q]
    while pos < src.n:
        out.put_byte(src.b[pos])
        pos = pos + 1
    return out

/#/ Incremental builds: one object per source file, kept in a cache directory and reused while
/#/ nothing it depends on changed.
/#/
/#/ The front end sees the whole program, but only the bodies of the files being rebuilt are checked
/#/ (the others are declarations); the lowering, optimizing and machine code of a file are skipped
/#/ when its object is current. A file's object is rebuilt when
/#/   - its own tokens changed (comments and blank lines do not count), or
/#/   - the interface of an item it can see changed: function headers, class fields and method
/#/     headers, enums, aliases, module-level `let`s, and the whole of generic functions and classes.
/#/     A file sees the items its tokens name and, transitively, the items their interfaces name
/#/     (a value's type reaches it through the function that returned it); the file with `main` also
/#/     sees every module-level `let`, which it initializes), or
/#/   - the compiler, the `.cfc` text or the optimization level is another one.
/#/ Names the compiler makes (glue, generic instances) carry a per-file suffix, so objects built at
/#/ different times never define the same symbol. The optimizer works inside one file, but the small
/#/ functions and methods (`small_fn`) of the files a file can see are lowered into it as well, for
/#/ inlining only: their bodies are part of their interface, and their code stays in their own file.
use system, fflush, fork, waitpid, _exit in libc of c

/#/ Two 64-bit FNV lanes.
class Hash:
    a: int
    b: int

    fn add(self, c: int) => void:
        self.a = wrapping_mul(self.a ^ c, 1099511628211)
        self.b = wrapping_mul(self.b ^ (c + 977), 6364136223846793005)

    fn add_txt(self, t: &Txt) => void:
        for i in 0..t.n:
            self.add(t.b[i])
        self.add(256)

    /#/ The 32 hex digits.
    fn hex(self) => Txt:
        let r = new_txt()
        for lane in 0..2:
            let v = self.a
            if lane == 1:
                v = self.b
            let i = 15
            while i >= 0:
                let d = (v >> (4 * i)) & 15
                if d < 10:
                    r.put_byte(48 + d)
                else:
                    r.put_byte(87 + d)
                i -= 1
        return r

fn new_hash() => Hash:
    return Hash { a: 1469598103934665603, b: 7046029254386353131 }

/#/ Adds the tokens `lo` up to `hi` of `a`: kind and spelling, so spaces and comments do not count.
fn hash_tokens(h: &Hash, a: &Ast, lo: int, hi: int) => void:
    for q in lo..hi:
        h.add(a.toks.kind[q])
        for k in a.toks.start[q]..a.toks.end[q]:
            h.add(a.byte_at(k))
        h.add(257)

/#/ A hash that also remembers the identifier tokens it went over.
class Walk:
    a: int
    b: int
    ids: buf<int>
    n: int

fn new_walk() => Walk:
    let h = new_hash()
    return Walk { a: h.a, b: h.b, ids: new_buf(int, 16), n: 0 }

/#/ Adds the tokens `lo` up to `hi` of `a` (kind and spelling), and notes the identifiers.
fn walk_tokens(w: &Walk, a: &Ast, lo: int, hi: int) => void:
    let h = Hash { a: w.a, b: w.b }
    for q in lo..hi:
        h.add(a.toks.kind[q])
        for k in a.toks.start[q]..a.toks.end[q]:
            h.add(a.byte_at(k))
        h.add(257)
        if a.toks.kind[q] == int(Tk.Ident):
            if w.n >= len(w.ids):
                w.ids = buf_resize(w.ids, w.n * 2)
            w.ids[w.n] = q
            w.n = w.n + 1
    w.a = h.a
    w.b = h.b

/#/ A function (or method) small enough that other files get its body to inline: not generic, not
/#/ `main`, at most 60 tokens, and with no function inside it.
fn small_fn(a: &Ast, f: int) => bool:
    if a.kind[f] != int(Nk.Fn) || a.pc[f] < 0 || type_param_count(a, f) != 0:
        return false
    if a.pa[f] >= 0 && tok_is(a, a.pa[f], "main"):
        return false
    if a.end[f] - a.tok[f] > 60:
        return false
    for q in a.tok[f] + 1..a.end[f]:
        if a.toks.kind[q] == int(Tk.KwFn):
            return false
    return true

/#/ Adds what other files may depend on in the top-level item `n`: a function's header, a class's
/#/ fields and method headers, the bodies of the small functions and methods, and the whole of a
/#/ generic function or class and of everything else.
fn walk_interface(w: &Walk, a: &Ast, n: int) => void:
    let k = a.kind[n]
    let lo = a.tok[n]
    let hi = a.end[n]
    if k == int(Nk.Fn):
        if type_param_count(a, n) == 0 && a.pc[n] >= 0 && !small_fn(a, n):
            hi = a.tok[a.pc[n]]
        walk_tokens(w, a, lo, hi)
    elif k == int(Nk.Class) && type_param_count(a, n) == 0:
        let q = lo
        let m = a.child[n]
        while q < hi:
            while m >= 0 && !(a.kind[m] == int(Nk.Fn) && a.pc[m] >= 0 && a.tok[a.pc[m]] >= q && !small_fn(a, m)):
                m = a.next[m]
            let stop = hi
            if m >= 0:
                stop = a.tok[a.pc[m]]
            walk_tokens(w, a, q, stop)
            if m < 0:
                q = hi
            else:
                q = a.end[m]
                m = a.next[m]
    else:
        walk_tokens(w, a, lo, hi)

/#/ The number of the file a top-level node is from, going by the line of its first token.
fn node_unit(fl: &Flat, a: &Ast, n: int, runtime: int) => int:
    let line = a.toks.line[a.tok[n]]
    if line - 1 >= fl.lines:
        return runtime
    return fl.unit_of_line(line)

/#/ The hash of the file the compiler runs from, so a new compiler rebuilds everything.
fn compiler_hash() => Txt:
    let p = txt_of("/proc/self/exe")
    let t = read_file(&p)
    let h = new_hash()
    h.add_txt(&t)
    return h.hex()

/#/ The cache name of file `u`: its base name and a hash of its whole path.
fn object_name(fl: &Flat, u: int) => Txt:
    let path = fl.unit_name(u)
    let lo = 0
    for i in 0..path.n:
        if path.b[i] == 47:
            lo = i + 1
    let hi = path.n
    if hi - lo > 3 && path.b[hi - 3] == 46 && path.b[hi - 2] == 99 && path.b[hi - 1] == 102:
        hi = hi - 3
    let r = new_txt()
    for i in lo..hi:
        let c = path.b[i]
        if (c >= 48 && c <= 57) || (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95:
            r.put_byte(c)
        else:
            r.put_byte(95)
    r.put_byte(95)
    let h = new_hash()
    h.add_txt(&path)
    let x = h.hex()
    for i in 0..8:
        r.put_byte(x.b[i])
    return r

fn cache_path(dir: &Txt, name: &Txt, ext: &str) => Txt:
    let p = copy_txt(dir)
    p.put_byte(47)
    p.put_all(name)
    p.put(ext)
    return p

/#/ The key stored for a file whose object is current: the same text as `want`?
fn key_current(dir: &Txt, name: &Txt, want: &Txt) => bool:
    let kp = cache_path(dir, name, ".key")
    let have = read_file(&kp)
    if have.n < 0 || !have.same(want):
        return false
    let op = cache_path(dir, name, ".o")
    let o = read_file(&op)
    return o.n > 0

/#/ The hash of the tokens of each file, one line of 32 hex digits each.
fn unit_bodies(fl: &Flat, a: &Ast, n: int) => Txt:
    let ha: buf<int> = new_buf(int, n + 1)
    let hb: buf<int> = new_buf(int, n + 1)
    for u in 0..n:
        let h = new_hash()
        ha[u] = h.a
        hb[u] = h.b
    for q in 0..a.toks.count:
        let line = a.toks.line[q]
        if line - 1 < fl.lines:
            let u = fl.unit_of_line(line)
            let h = Hash { a: ha[u], b: hb[u] }
            hash_tokens(&h, a, q, q + 1)
            ha[u] = h.a
            hb[u] = h.b
    let out = new_txt()
    for u in 0..n:
        let h = Hash { a: ha[u], b: hb[u] }
        out.put_all(&h.hex())
        out.put_byte(10)
    return out

/#/ The named top-level items, each with the hash of its interface and the items its interface
/#/ names. A file's key holds the interfaces of the items its tokens name, and of the items those
/#/ name in turn, so a change reaches only the files that can see it.
class Items:
    count: int
    node: buf<int>
    unit: buf<int>
    ia: buf<int>
    ib: buf<int>
    /#/ the items named by item i are m_list[m_at[i] .. m_at[i + 1])
    m_at: buf<int>
    m_list: buf<int>
    /#/ name table: open addressing, item + 1
    ht: buf<int>
    /#/ the hash of the C imports, which every file sees
    cimp_a: int
    cimp_b: int

/#/ The name of top-level node `n` as a token, -1 for an item with no name.
fn item_name(a: &Ast, n: int) => int:
    let k = a.kind[n]
    if k == int(Nk.Fn) || k == int(Nk.Class) || k == int(Nk.Enum) || k == int(Nk.Let) || k == int(Nk.TypeAlias):
        return a.pa[n]
    return 0 - 1

fn ident_hash(a: &Ast, tok: int) => int:
    let h = 5381
    for k in a.toks.start[tok]..a.toks.end[tok]:
        h = (h * 33 + a.byte_at(k)) & 1073741823
    return h

/#/ Calls nothing: fills `out` (cleared first) with the items named like token `tok`.
fn items_named(it: &Items, a: &Ast, tok: int, out: &buf<int>) => int:
    let mask = len(it.ht) - 1
    let i = ident_hash(a, tok) & mask
    let n = 0
    while it.ht[i] != 0:
        let x = it.ht[i] - 1
        if same_tok(a, item_name(a, it.node[x]), tok):
            if n < len(out):
                out[n] = x
                n = n + 1
        i = (i + 1) & mask
    return n

fn build_items(fl: &Flat, a: &Ast, n: int) => Items:
    let cap = 16
    let top = a.child[a.root]
    let named = 0
    while top >= 0:
        if item_name(a, top) >= 0:
            named = named + 1
        top = a.next[top]
    while cap < named * 2 + 2:
        cap = cap * 2
    let it = Items { count: 0, node: new_buf(int, named + 1), unit: new_buf(int, named + 1), ia: new_buf(int, named + 1), ib: new_buf(int, named + 1), m_at: new_buf(int, named + 2), m_list: new_buf(int, 16), ht: new_buf(int, cap), cimp_a: 0, cimp_b: 0 }
    top = a.child[a.root]
    let cimp = new_walk()
    while top >= 0:
        let u = node_unit(fl, a, top, n)
        if item_name(a, top) >= 0 && u < n:
            it.node[it.count] = top
            it.unit[it.count] = u
            let mask = cap - 1
            let i = ident_hash(a, item_name(a, top)) & mask
            while it.ht[i] != 0:
                i = (i + 1) & mask
            it.ht[i] = it.count + 1
            it.count = it.count + 1
        elif a.kind[top] == int(Nk.Use) && a.pc[top] == 1:
            walk_tokens(&cimp, a, a.tok[top], a.end[top])
        top = a.next[top]
    it.cimp_a = cimp.a
    it.cimp_b = cimp.b
    /#/ interfaces and the names in them
    let found: buf<int> = new_buf(int, 64)
    let nm = 0
    for x in 0..it.count:
        let w = new_walk()
        walk_interface(&w, a, it.node[x])
        it.ia[x] = w.a
        it.ib[x] = w.b
        it.m_at[x] = nm
        for j in 0..w.n:
            let c = items_named(&it, a, w.ids[j], &found)
            for f in 0..c:
                if nm >= len(it.m_list):
                    it.m_list = buf_resize(it.m_list, nm * 2)
                it.m_list[nm] = found[f]
                nm = nm + 1
    it.m_at[it.count] = nm
    return it

/#/ The keys of the files, and for each file the nodes whose small functions it gets to inline.
class Keys:
    text: Txt
    /#/ the nodes of file u are ext_nodes[ext_at[u] .. ext_at[u + 1])
    ext_at: buf<int>
    ext_nodes: buf<int>

/#/ The key of each file, one line of 32 hex digits each: the compiler, the level, the `.cfc` text,
/#/ the C imports, the file's own tokens (`bodies`), and the interfaces of the items it can see.
/#/ The file with `main` also runs every module-level `let`, so it sees them all.
fn unit_keys(fl: &Flat, a: &Ast, n: int, ch: &Txt, opt: int, cfc: &str, bodies: &Txt) => Keys:
    let it = build_items(fl, a, n)
    /#/ the identifier tokens of each file
    let tu: buf<int> = new_buf(int, a.toks.count + 1)
    let cnt: buf<int> = new_buf(int, n + 2)
    for q in 0..a.toks.count:
        tu[q] = n
        let line = a.toks.line[q]
        if line - 1 < fl.lines:
            tu[q] = fl.unit_of_line(line)
        if a.toks.kind[q] == int(Tk.Ident) && tu[q] < n:
            cnt[tu[q] + 1] = cnt[tu[q] + 1] + 1
    for u in 0..n + 1:
        cnt[u + 1] = cnt[u + 1] + cnt[u]
    let at: buf<int> = new_buf(int, n + 1)
    let toks: buf<int> = new_buf(int, cnt[n] + 1)
    for q in 0..a.toks.count:
        if a.toks.kind[q] == int(Tk.Ident) && tu[q] < n:
            toks[cnt[tu[q]] + at[tu[q]]] = q
            at[tu[q]] = at[tu[q]] + 1
    let has_main: buf<int> = new_buf(int, n + 1)
    for x in 0..it.count:
        if a.kind[it.node[x]] == int(Nk.Fn) && tok_is(a, item_name(a, it.node[x]), "main"):
            has_main[it.unit[x]] = 1
    let mark: buf<int> = new_buf(int, it.count + 1)
    let stack: buf<int> = new_buf(int, it.count + 1)
    let found: buf<int> = new_buf(int, 64)
    let keys = new_txt()
    let ext_at: buf<int> = new_buf(int, n + 2)
    let ext_nodes: buf<int> = new_buf(int, 16)
    let ne = 0
    let cfc_t = txt_of(cfc)
    for u in 0..n:
        let sp = 0
        ext_at[u] = ne
        if has_main[u] == 1:
            for x in 0..it.count:
                if it.unit[x] != u && a.kind[it.node[x]] == int(Nk.Let):
                    mark[x] = u + 1
                    stack[sp] = x
                    sp = sp + 1
        for j in cnt[u]..cnt[u + 1]:
            let c = items_named(&it, a, toks[j], &found)
            for f in 0..c:
                let x = found[f]
                if it.unit[x] != u && mark[x] != u + 1:
                    mark[x] = u + 1
                    stack[sp] = x
                    sp = sp + 1
        while sp > 0:
            sp = sp - 1
            let x = stack[sp]
            for j in it.m_at[x]..it.m_at[x + 1]:
                let y = it.m_list[j]
                if it.unit[y] != u && mark[y] != u + 1:
                    mark[y] = u + 1
                    stack[sp] = y
                    sp = sp + 1
        let k = new_hash()
        k.add_txt(ch)
        k.add(opt)
        k.add_txt(&cfc_t)
        k.add_txt(&slice(bodies, u * 33, u * 33 + 32))
        k.add(it.cimp_a)
        k.add(it.cimp_b)
        for x in 0..it.count:
            if mark[x] == u + 1:
                k.add(it.ia[x])
                k.add(it.ib[x])
                let kd = a.kind[it.node[x]]
                if kd == int(Nk.Class) || (kd == int(Nk.Fn) && small_fn(a, it.node[x])):
                    if ne >= len(ext_nodes):
                        ext_nodes = buf_resize(ext_nodes, ne * 2)
                    ext_nodes[ne] = it.node[x]
                    ne = ne + 1
        keys.put_all(&k.hex())
        keys.put_byte(10)
    ext_at[n] = ne
    return Keys { text: keys, ext_at: ext_at, ext_nodes: ext_nodes }

/#/ Does the program define the number-printing runtime itself (the runtime's own tests do)?
fn defines_runtime(a: &Ast) => bool:
    let it = a.child[a.root]
    while it >= 0:
        if a.kind[it] == int(Nk.Fn) && a.pa[it] >= 0 && tok_is(a, a.pa[it], "__cf_fmt_int"):
            return true
        it = a.next[it]
    return false

/#/ Builds the object of unit `u` into `dir`, with the key `kt`. False when the unit has findings.
fn compile_unit(prep: &Prep, t: &Tys, g: &Syms, opt: int, u: int, unit: &buf<int>, name: &Txt, kt: &Txt, dir: &Txt, kk: &Keys) => bool:
    /#/ the names the compiler makes end in the object's own name, so objects built at different
    /#/ times (and numbers of files) never define the same symbol
    let tag = txt_of("_u_")
    tag.put_all(name)
    let ts = txt_str(&tag)
    /#/ the small functions of the files this one can see, for inlining
    let ext: buf<int> = new_buf(int, prep.a.count + 1)
    for j in kk.ext_at[u]..kk.ext_at[u + 1]:
        let x = kk.ext_nodes[j]
        if prep.a.kind[x] == int(Nk.Fn):
            ext[x] = 1
        else:
            let c = prep.a.child[x]
            while c >= 0:
                if small_fn(&prep.a, c):
                    ext[c] = 1
                c = prep.a.next[c]
    let t0 = now_ms()
    let lw = lower_prepared(prep, t, g, opt, u, unit, &ts, &ext)
    if lw.bad > 0:
        return false
    let t1 = now_ms()
    lw.generate()
    lw.emit_glue(t, g)
    let t2 = now_ms()
    if lw.ver_err > 0 || lw.mc_err > 0:
        say(f"incremental: {lw.ver_err + lw.mc_err} functions with findings in {txt_str(name)}\n")
        return false
    let obj = lw.object()
    write_file(&cache_path(dir, name, ".o"), &obj)
    write_file(&cache_path(dir, name, ".key"), kt)
    if lw.uses_rt:
        write_file(&cache_path(dir, name, ".rt"), &txt_of("1"))
    else:
        write_file(&cache_path(dir, name, ".rt"), &txt_of("0"))
    unit_times(t1 - t0, t2 - t1, now_ms() - t2)
    return true

/#/ The number of processors that are on, from /sys; 1 when unknown.
fn online_cpus() => int:
    let t = read_file(&txt_of("/sys/devices/system/cpu/online"))
    if t.n <= 0:
        return 1
    let total = 0
    let lo = 0 - 1
    let cur = 0
    for i in 0..t.n + 1:
        let c = 44
        if i < t.n:
            c = t.b[i]
        if c >= 48 && c <= 57:
            cur = cur * 10 + c - 48
        elif c == 45:
            lo = cur
            cur = 0
        elif c == 44 || c == 10:
            if lo >= 0:
                total = total + cur - lo + 1
            elif i > 0 && t.b[i - 1] != 44:
                total = total + 1
            lo = 0 - 1
            cur = 0
    if total < 1:
        return 1
    return total

/#/ Builds the program in `fl` into `dir`, linking `out`. Returns 0 when it worked.
fn build_incremental(fl: &Flat, a0: Ast, dir: &Txt, out: &Txt, opt: int, jobs: int, static_link: bool, auto_static: bool, debug: bool) => int:
    system(txt_str(&mkdir_cmd(dir)))
    if a0.err_count > 0:
        say(f"front end: {a0.err_count} parse errors\n")
        return 1
    phase("parse")
    let defines = defines_runtime(&a0)
    let ch = compiler_hash()
    if debug:
        /#/ objects with line tables are not the objects without
        ch.put("-g")
    let cfc = fl.cfc_str()
    let n = fl.nunit
    let bodies = unit_bodies(fl, &a0, n)
    phase("hashes")
    let kk = unit_keys(fl, &a0, n, &ch, opt, &cfc, &bodies)
    let keys = copy_txt(&kk.text)
    let all = new_hash()
    all.add_txt(&keys)
    phase("keys")
    let want_state = all.hex()
    let state_path = cache_path(dir, &txt_of("state"), "")
    let state = read_file(&state_path)
    let have_state = state.n >= 32
    if have_state:
        for i in 0..32:
            if state.b[i] != want_state.b[i]:
                have_state = false
    /#/ the stale files: those whose object is missing or built from other tokens or interfaces
    let stale: buf<int> = new_buf(int, n + 1)
    let todo: buf<int> = new_buf(int, n + 1)
    let ntodo = 0
    let names: buf<Txt> = new_buf(Txt, n + 1)
    for u in 0..n:
        let name = object_name(fl, u)
        if !key_current(dir, &name, &slice(&keys, u * 33, u * 33 + 32)):
            stale[u] = 1
            todo[ntodo] = u
            ntodo = ntodo + 1
        names[u] = name
    let compiled = ntodo
    let reused = n - ntodo
    let objs = new_txt()
    let plain = new_txt()
    if ntodo > 0 || !have_state:
        let t = new_tys()
        let g = new_globals()
        /#/ the file of each top-level item; the bodies of the files that are not stale are not
        /#/ checked again (they were when their objects were built, and their interfaces and
        /#/ tokens are the same), so they become declarations
        let unit: buf<int> = new_buf(int, a0.count + 1)
        let top = a0.child[a0.root]
        while top >= 0:
            let u = node_unit(fl, &a0, top, n)
            unit[top] = u
            if u < n && stale[u] == 0:
                if a0.kind[top] == int(Nk.Fn) && type_param_count(&a0, top) == 0:
                    if !small_fn(&a0, top):
                        a0.pc[top] = 0 - 1
                elif a0.kind[top] == int(Nk.Class) && type_param_count(&a0, top) == 0:
                    let c = a0.child[top]
                    while c >= 0:
                        if a0.kind[c] == int(Nk.Fn) && !small_fn(&a0, c):
                            a0.pc[c] = 0 - 1
                        c = a0.next[c]
            top = a0.next[top]
        /#/ the work of each unit, by the tokens of its items
        let cost: buf<int> = new_buf(int, n + 1)
        let t2 = a0.child[a0.root]
        while t2 >= 0:
            let tu = unit[t2]
            if tu < n:
                cost[tu] = cost[tu] + a0.end[t2] - a0.tok[t2] + 1
            t2 = a0.next[t2]
        let prep = prepare_ast(a0, cfc, &t, &g)
        if !prep.ok:
            return 1
        phase("front end")
        let workers = jobs
        if workers > ntodo:
            workers = ntodo
        if workers <= 1:
            for i in 0..ntodo:
                let u = todo[i]
                if !compile_unit(&prep, &t, &g, opt, u, &unit, &names[u], &slice(&keys, u * 33, u * 33 + 32), dir, &kk):
                    return 1
            unit_phases()
        else:
            /#/ each worker is a copy of this process (the front end's result is shared, not redone)
            /#/ that builds every `workers`-th stale unit
            fflush(0)
            /#/ the biggest units go first, each to the worker with the least work so far
            for i in 1..ntodo:
                let v = todo[i]
                let j = i
                while j > 0 && cost[todo[j - 1]] < cost[v]:
                    todo[j] = todo[j - 1]
                    j = j - 1
                todo[j] = v
            let owner: buf<int> = new_buf(int, ntodo + 1)
            let load: buf<int> = new_buf(int, workers)
            for i in 0..ntodo:
                let best = 0
                for w in 1..workers:
                    if load[w] < load[best]:
                        best = w
                owner[i] = best
                load[best] = load[best] + cost[todo[i]] + 1
            let pids: buf<int> = new_buf(int, workers)
            for w in 0..workers:
                let pid = fork()
                if pid == 0:
                    let ok = true
                    let i = 0
                    while i < ntodo && ok:
                        if owner[i] == w:
                            let u = todo[i]
                            ok = compile_unit(&prep, &t, &g, opt, u, &unit, &names[u], &slice(&keys, u * 33, u * 33 + 32), dir, &kk)
                        i = i + 1
                    fflush(0)
                    if ok:
                        _exit(0)
                    _exit(1)
                pids[w] = pid
            let failed = false
            for w in 0..workers:
                let sb: buf<int> = new_buf(int, 2)
                sb[0] = 0
                if pids[w] < 0 || waitpid(pids[w], buf_ptr(sb), 0) < 0 || sb[0] != 0:
                    failed = true
            if failed:
                return 1
            phase("units")
        write_file(&state_path, &want_state)
    /#/ the runtime objects below carry no line table
    no_lines()
    /#/ the objects, and the number-printing runtime when some file calls it and none defines it
    let uses = false
    for u in 0..n:
        let name = clone names[u]
        objs.put(" '")
        objs.put_all(&cache_path(dir, &name, ".o"))
        objs.put("'")
        plain.put_all(&cache_path(dir, &name, ".o"))
        plain.put_byte(10)
        let fg = read_file(&cache_path(dir, &name, ".rt"))
        if fg.n > 0 && fg.b[0] == 49:
            uses = true
    if uses && !defines:
        let rk = new_hash()
        rk.add_txt(&ch)
        rk.add(opt)
        let rts = fmt_rt_text()
        rk.add_txt(&txt_of(&rts))
        let kt = rk.hex()
        let rn = txt_of("runtime")
        if !key_current(dir, &rn, &kt):
            let rb = bytes_of_str(&rts)
            let obj = build_text(rb, len(rts), opt, "")
            if obj.n == 0:
                return 1
            write_file(&cache_path(dir, &rn, ".o"), &obj)
            write_file(&cache_path(dir, &rn, ".key"), &kt)
            compiled = compiled + 1
        else:
            reused = reused + 1
        objs.put(" '")
        objs.put_all(&cache_path(dir, &rn, ".o"))
        objs.put("'")
        plain.put_all(&cache_path(dir, &rn, ".o"))
        plain.put_byte(10)
    if static_link:
        /#/ the C library of rt/src/min.cf, as an object of its own
        let ms = min_rt_text()
        let mk = new_hash()
        mk.add_txt(&ch)
        mk.add(opt)
        mk.add_txt(&txt_of(&ms))
        let mkt = mk.hex()
        let mn = txt_of("minrt")
        if !key_current(dir, &mn, &mkt):
            let mb = bytes_of_str(&ms)
            let mobj = build_text(mb, len(ms), opt, "")
            if mobj.n == 0:
                return 1
            write_file(&cache_path(dir, &mn, ".o"), &mobj)
            write_file(&cache_path(dir, &mn, ".key"), &mkt)
        plain.put_all(&cache_path(dir, &mn, ".o"))
        plain.put_byte(10)
    say(f"incremental: {compiled} compiled, {reused} reused\n")
    fflush(0)
    let flags = new_txt()
    fl.link_flags(&flags)
    let rc = link_objects(&plain, &objs, &flags, out, static_link, auto_static)
    if rc == 0 && debug:
        /#/ `cc` made this one: DWARF from the line tables of the objects and the symbols it kept
        let dbg = new_txt()
        for u in 0..n:
            let ob = read_file(&cache_path(dir, &clone names[u], ".o"))
            let sec = elf_section_bytes(&ob, ".cf_lines")
            dbg.put_all(&sec)
        let exe = read_file(out)
        let more = add_dwarf(&exe, &dbg)
        if more.n > 0:
            write_file(out, &more)
    phase("link")
    return rc

fn mkdir_cmd(dir: &Txt) => Txt:
    let c = txt_of("mkdir -p '")
    c.put_all(dir)
    c.put("'")
    return c

/#/ `--time`: how long each phase of a build took, in milliseconds on the wall clock.
use clock_gettime, fflush in libc of c

let t_on = false
let t_last = 0
let t_lower = 0
let t_gen = 0
let t_obj = 0

fn now_ms() => int:
    let b: buf<int> = new_buf(int, 2)
    clock_gettime(1, buf_ptr(b))
    return b[0] * 1000 + b[1] // 1000000

fn time_start() => void:
    t_on = true
    t_last = now_ms()

/#/ Prints the time since the last phase ended, and starts the next one.
fn phase(what: &str) => void:
    if !t_on:
        return
    let n = now_ms()
    say(f"  {what:<12} {n - t_last:6} ms\n")
    fflush(0)
    t_last = n

/#/ Adds the per-unit times of lowering, code generation and object writing.
fn unit_times(lower: int, gen: int, obj: int) => void:
    t_lower = t_lower + lower
    t_gen = t_gen + gen
    t_obj = t_obj + obj

/#/ Prints the per-unit sums and leaves their time out of the next phase.
fn unit_phases() => void:
    if !t_on:
        return
    say(f"  {"lower":<12} {t_lower:6} ms\n")
    say(f"  {"codegen":<12} {t_gen:6} ms\n")
    say(f"  {"object":<12} {t_obj:6} ms\n")
    fflush(0)
    t_last = now_ms()

/#/ `--static`: the objects are linked by `cfld`'s linker, in this process, into an executable that
/#/ needs no C library. The program gets the runtime of `rt/src/min.cf` (`min_rt_text`).
/#/ The executable: the linked image cut into the pieces of an ELF64 file, plus the headers.
/#/
/#/ `link_exe` is the whole link once the inputs are added; the result is the bytes of the file,
/#/ or an empty text after an error was reported.
/#/ The static linker, in two halves.
/#/
/#/ The first reads relocatable objects (`add_object`) and archives (`add_archive`), joins the
/#/ sections into one memory image (`layout`, `build_image`) and resolves symbols. The second,
/#/ `apply_relocs`, patches that image for a load address. It does not know about files, so a JIT
/#/ can use it to relocate the image in memory; `write_exe` (exe.cf) puts the same image in an
/#/ ELF executable.
/#/
/#/ Everything is flat columns: sections and symbols of all inputs are numbered one after the
/#/ other (an input's first number is in `in_sec0` / `in_sym0`), so a symbol or section number
/#/ alone says which input it came from.
/#/
/#/ Image addresses are `rva`s, relative to the load address (`base`); an executable is loaded
/#/ at `0x400000`.
/#/ Small helpers for the linker: a growable column of integers, and little-endian reads and
/#/ writes on the bytes of a `Txt`.


class Col:
    b: buf<int>
    n: int

    fn push(self, v: int) => void:
        if self.n >= len(self.b):
            self.b = buf_resize(self.b, (self.n + 1) * 2)
        self.b[self.n] = v
        self.n = self.n + 1

fn new_col() => Col:
    return Col { b: new_buf(int, 16), n: 0 }

fn align_to(v: int, a: int) => int:
    if a <= 1:
        return v
    return (v + a - 1) // a * a

fn rd16(t: &Txt, at: int) => int:
    return t.b[at] | (t.b[at + 1] << 8)

fn rd32(t: &Txt, at: int) => int:
    return t.b[at] | (t.b[at + 1] << 8) | (t.b[at + 2] << 16) | (t.b[at + 3] << 24)

/#/ Eight bytes as a two's complement integer.
fn rd64(t: &Txt, at: int) => int:
    return rd32(t, at) | (rd32(t, at + 4) << 32)

/#/ Four bytes, big endian (the numbers inside an `ar` archive).
fn rd32be(t: &Txt, at: int) => int:
    return (t.b[at] << 24) | (t.b[at + 1] << 16) | (t.b[at + 2] << 8) | t.b[at + 3]

fn wr32(t: &Txt, at: int, v: int) => void:
    for k in 0..4:
        t.b[at + k] = (v >> (8 * k)) & 255

fn wr64(t: &Txt, at: int, v: int) => void:
    for k in 0..8:
        t.b[at + k] = (v >> (8 * k)) & 255

/#/ `n` zero bytes at the end of `t`.
fn put_zeros(t: &Txt, n: int) => void:
    for k in 0..n:
        t.put_byte(0)

/#/ The NUL-ended string at `at`.
fn cstr_at(t: &Txt, at: int) => Txt:
    let r = new_txt()
    let k = at
    while k < t.n && t.b[k] != 0:
        r.put_byte(t.b[k])
        k = k + 1
    return r



use fflush in libc of c

/#/ the four groups sections are joined into, in image order
fn g_text() => int:
    return 0

fn g_ro() => int:
    return 1

fn g_data() => int:
    return 2

fn g_bss() => int:
    return 3

/#/ the number of a section in an input that has none (undefined symbols)
fn no_sec() => int:
    return 0 - 1

fn abs_sec() => int:
    return 0 - 2

fn common_sec() => int:
    return 0 - 3

class Linker:
    /#/ all input files, one after the other
    blob: Txt
    errs: int
    /#/ ---- inputs
    nin: int
    in_sec0: Col
    in_sym0: Col
    /#/ ---- sections: the bytes are `blob[sc_off ..][..sc_size]`
    sc_type: Col
    sc_flags: Col
    sc_off: Col
    sc_size: Col
    sc_align: Col
    /#/ group of the output (-1: not in the image), offset in the group, and image address
    sc_grp: Col
    sc_goff: Col
    sc_rva: Col
    /#/ ---- symbols; `y_bind` 0 local, 1 global, 2 weak; `y_nm` is the name id (-1: none)
    y_sec: Col
    y_val: Col
    y_size: Col
    y_bind: Col
    y_type: Col
    y_nm: Col
    /#/ the address of a common symbol, and the slot in the GOT of a symbol (-1: none)
    y_rva: Col
    y_got: Col
    /#/ ---- relocations
    r_sec: Col
    r_off: Col
    r_type: Col
    r_sym: Col
    r_add: Col
    /#/ ---- names, interned: `nm_off[id]` into `pool` (NUL-ended), `ht` the hash table (id + 1)
    pool: Txt
    nm_off: Col
    ht: buf<int>
    /#/ per name id: the defining symbol (-1), how it is defined (0 not, 1 common, 2 weak, 3
    /#/ strong), and 1 when some input needs it (an undefined, non-weak reference)
    g_def: Col
    g_how: Col
    g_need: Col
    /#/ archive members already added: the blob offsets of their headers
    pulled: Col
    /#/ ---- the layout
    gsize: buf<int>
    galign: buf<int>
    /#/ where each group starts in the image
    gbase: buf<int>
    ngot: int
    got_rva: int
    /#/ the pieces of the file: offset, address, bytes in the file, bytes in memory, flags
    sg_off: Col
    sg_rva: Col
    sg_fsz: Col
    sg_msz: Col
    sg_flags: Col
    /#/ size of the whole image
    image_size: int
    /#/ after `gc`: the text sections some root reaches (1) or not (0)
    gc_on: bool
    quiet: bool
    /#/ keep the names of functions and data in the file (a symbol table for debuggers)
    syms: bool
    /#/ the line tables of the objects (`.cf_lines`), for the debug sections of an executable made with `syms`
    dbg: Txt
    /#/ how many section headers `add_symbols` wrote
    nshdr: int
    live: buf<int>

    fn err(self, what: &str, who: &Txt) => void:
        self.errs = self.errs + 1
        if self.quiet:
            return
        say(f"ld: {what} {txt_str(who)}\n")
        fflush(0)

    fn msg(self, what: &str) => void:
        self.errs = self.errs + 1
        if self.quiet:
            return
        say(f"ld: {what}\n")
        fflush(0)

    /#/ ---- names ----------------------------------------------------------------------------

    fn hash(self, w: &Txt) => int:
        let h = 5381
        for k in 0..w.n:
            h = (h * 33 + w.b[k]) & 1073741823
        return h

    fn name_eq(self, id: int, w: &Txt) => bool:
        let at = self.nm_off.b[id]
        for k in 0..w.n:
            if self.pool.b[at + k] != w.b[k]:
                return false
        return self.pool.b[at + w.n] == 0

    /#/ The id of name `w`, or -1 if no input mentioned it.
    fn find(self, w: &Txt) => int:
        let mask = len(self.ht) - 1
        let i = self.hash(w) & mask
        while self.ht[i] != 0:
            if self.name_eq(self.ht[i] - 1, w):
                return self.ht[i] - 1
            i = (i + 1) & mask
        return 0 - 1

    fn grow_ht(self) => void:
        let cap = len(self.ht) * 2
        self.ht = new_buf(int, cap)
        let mask = cap - 1
        for id in 0..self.nm_off.n:
            let w = cstr_at(&self.pool, self.nm_off.b[id])
            let i = self.hash(&w) & mask
            while self.ht[i] != 0:
                i = (i + 1) & mask
            self.ht[i] = id + 1

    fn intern(self, w: &Txt) => int:
        let found = self.find(w)
        if found >= 0:
            return found
        if (self.nm_off.n + 1) * 2 > len(self.ht):
            self.grow_ht()
        let id = self.nm_off.n
        self.nm_off.push(self.pool.n)
        self.pool.put_all(w)
        self.pool.put_byte(0)
        self.g_def.push(0 - 1)
        self.g_how.push(0)
        self.g_need.push(0)
        let mask = len(self.ht) - 1
        let i = self.hash(w) & mask
        while self.ht[i] != 0:
            i = (i + 1) & mask
        self.ht[i] = id + 1
        return id

    fn name_of(self, id: int) => Txt:
        return cstr_at(&self.pool, self.nm_off.b[id])

    /#/ ---- reading objects --------------------------------------------------------------------

    /#/ A symbol just added is a definition or a reference of a global name.
    fn declare(self, sid: int) => void:
        let id = self.y_nm.b[sid]
        let bind = self.y_bind.b[sid]
        if id < 0 || bind == 0:
            return
        let sec = self.y_sec.b[sid]
        if sec == no_sec():
            if bind == 1:
                self.g_need.b[id] = 1
            return
        let how = 3
        if sec == common_sec():
            how = 1
        elif bind == 2:
            how = 2
        let old = self.g_how.b[id]
        if old == 0 || how > old:
            self.g_def.b[id] = sid
            self.g_how.b[id] = how
        elif how == 3 && old == 3:
            let w = self.name_of(id)
            self.err("duplicate symbol", &w)
        elif how == 1 && old == 1:
            /#/ two commons: the larger one wins
            let was = self.g_def.b[id]
            if self.y_size.b[sid] > self.y_size.b[was]:
                self.g_def.b[id] = sid

    /#/ Adds the object that starts at `off` in the blob (`who` names it in messages).
    fn add_object(self, off: int, who: &Txt) => void:
        let b = &self.blob
        if b.n < off + 64 || b.b[off] != 127 || b.b[off + 1] != 69 || b.b[off + 2] != 76 || b.b[off + 3] != 70:
            self.err("not an ELF file:", who)
            return
        if b.b[off + 4] != 2 || b.b[off + 5] != 1 || rd16(b, off + 16) != 1 || rd16(b, off + 18) != 62:
            self.err("not an x86-64 relocatable object:", who)
            return
        let shoff = off + rd64(b, off + 40)
        let shnum = rd16(b, off + 60)
        let sec0 = self.sc_type.n
        let sym0 = self.y_sec.n
        self.in_sec0.push(sec0)
        self.in_sym0.push(sym0)
        self.nin = self.nin + 1
        let symtab = 0 - 1
        for i in 0..shnum:
            let h = shoff + 64 * i
            let ty = rd32(b, h + 4)
            self.sc_type.push(ty)
            self.sc_flags.push(rd64(b, h + 8))
            self.sc_off.push(off + rd64(b, h + 24))
            self.sc_size.push(rd64(b, h + 32))
            self.sc_align.push(rd64(b, h + 48))
            self.sc_grp.push(0 - 1)
            self.sc_goff.push(0)
            self.sc_rva.push(0)
            if ty == 2:
                symtab = i
        /#/ the line table, a section called `.cf_lines`
        let shs = rd16(b, off + 62)
        if self.syms && shs > 0 && shs < shnum:
            let names = self.sc_off.b[sec0 + shs]
            for i in 0..shnum:
                let w = cstr_at(b, names + rd32(b, shoff + 64 * i))
                if w.n == 9 && w.is(".cf_lines"):
                    let from = self.sc_off.b[sec0 + i]
                    for q in 0..self.sc_size.b[sec0 + i]:
                        self.dbg.put_byte(b.b[from + q])
        if symtab < 0:
            return
        /#/ the symbols
        let sh = shoff + 64 * symtab
        let nsym = rd64(b, sh + 32) // 24
        let at = off + rd64(b, sh + 24)
        let strs = self.sc_off.b[sec0 + rd32(b, sh + 40)]
        for k in 0..nsym:
            let e = at + 24 * k
            let info = b.b[e + 4]
            let shndx = rd16(b, e + 6)
            let sec = no_sec()
            if shndx == 65521:
                sec = abs_sec()
            elif shndx == 65522:
                sec = common_sec()
            elif shndx != 0:
                sec = sec0 + shndx
            let bind = info >> 4
            if bind > 2:
                bind = 1
            let ty = info & 15
            let nm = 0 - 1
            if k > 0 && ty != 3 && ty != 4:
                let w = cstr_at(b, strs + rd32(b, e))
                if w.n > 0:
                    nm = self.intern(&w)
            if bind != 0 && nm < 0:
                bind = 0
            self.y_sec.push(sec)
            self.y_val.push(rd64(b, e + 8))
            self.y_size.push(rd64(b, e + 16))
            self.y_bind.push(bind)
            self.y_type.push(ty)
            self.y_nm.push(nm)
            self.y_rva.push(0)
            self.y_got.push(0 - 1)
            self.declare(sym0 + k)
        /#/ the relocations
        for i in 0..shnum:
            let s = sec0 + i
            if self.sc_type.b[s] == 4 && rd32(b, shoff + 64 * i + 40) == symtab:
                let target = sec0 + rd32(b, shoff + 64 * i + 44)
                let n = self.sc_size.b[s] // 24
                for k in 0..n:
                    let e = self.sc_off.b[s] + 24 * k
                    let info = rd64(b, e + 8)
                    self.r_sec.push(target)
                    self.r_off.push(rd64(b, e))
                    self.r_type.push(info & 4294967295)
                    self.r_sym.push(sym0 + (info >> 32))
                    self.r_add.push(rd64(b, e + 16))

    /#/ Adds the file `data` as one input; an object, or an archive whose members are pulled in as
    /#/ the symbols they define are needed.
    fn add_file(self, data: &Txt, who: &Txt) => void:
        let off = self.blob.n
        self.blob.put_all(data)
        if data.n >= 8 && data.b[0] == 33 && data.b[1] == 60:
            self.add_archive(off, data.n, who)
        else:
            self.add_object(off, who)

    /#/ ---- archives ---------------------------------------------------------------------------

    /#/ Pulls in the members of the archive at `off` (`size` bytes) that define a name some input
    /#/ needs, until nothing more is needed. Only archives with a symbol index are understood.
    fn add_archive(self, off: int, size: int, who: &Txt) => void:
        let b = &self.blob
        /#/ the first member is the symbol index: `/`, a count, the member offsets, the names
        let h = off + 8
        if h + 60 > off + size || b.b[h] != 47 || b.b[h + 1] != 32:
            self.err("archive without a symbol index:", who)
            return
        let isz = 0
        for k in 0..10:
            let c = b.b[h + 48 + k]
            if c >= 48 && c <= 57:
                isz = isz * 10 + c - 48
        let cnt = rd32be(b, h + 60)
        let names = h + 60 + 4 + 4 * cnt
        let nm_at = new_col()
        let p = names
        for k in 0..cnt:
            nm_at.push(p)
            while b.b[p] != 0:
                p = p + 1
            p = p + 1
        let again = true
        while again:
            again = false
            for k in 0..cnt:
                let w = cstr_at(b, nm_at.b[k])
                let id = self.find(&w)
                if id >= 0 && self.g_need.b[id] == 1 && self.g_how.b[id] == 0:
                    let mh = off + rd32be(b, h + 64 + 4 * k)
                    if !self.was_pulled(mh):
                        self.pulled.push(mh)
                        self.add_object(mh + 60, who)
                        again = true

    fn was_pulled(self, mh: int) => bool:
        for k in 0..self.pulled.n:
            if self.pulled.b[k] == mh:
                return true
        return false

    /#/ ---- the start-up code --------------------------------------------------------------------

    /#/ When no input defines `_start`, adds a small one that calls `main(argc, argv)` and exits
    /#/ with its result (system call `exit`), so a program needs no C runtime.
    fn add_start(self) => void:
        let sid = self.find_def("_start")
        if sid >= 0:
            return
        if self.find_def("main") < 0:
            return
        /#/ xor ebp,ebp; mov rdi,[rsp]; lea rsi,[rsp+8]; call main; mov edi,eax; mov eax,60; syscall
        let code = [49, 237, 72, 139, 60, 36, 72, 141, 116, 36, 8, 232, 0, 0, 0, 0, 137, 199, 184, 60, 0, 0, 0, 15, 5]
        let off = self.blob.n
        for k in 0..25:
            self.blob.put_byte(code[k])
        let sec0 = self.sc_type.n
        let sym0 = self.y_sec.n
        self.in_sec0.push(sec0)
        self.in_sym0.push(sym0)
        self.nin = self.nin + 1
        self.sc_type.push(1)
        self.sc_flags.push(6)
        self.sc_off.push(off)
        self.sc_size.push(25)
        self.sc_align.push(16)
        self.sc_grp.push(0 - 1)
        self.sc_goff.push(0)
        self.sc_rva.push(0)
        let w = txt_of("_start")
        let m = txt_of("main")
        for k in 0..2:
            self.y_val.push(0)
            self.y_size.push(0)
            self.y_bind.push(1)
            self.y_type.push(0)
            self.y_rva.push(0)
            self.y_got.push(0 - 1)
        self.y_sec.push(sec0)
        self.y_nm.push(self.intern(&w))
        self.y_sec.push(no_sec())
        self.y_nm.push(self.intern(&m))
        self.declare(sym0)
        self.declare(sym0 + 1)
        self.r_sec.push(sec0)
        self.r_off.push(12)
        self.r_type.push(4)
        self.r_sym.push(sym0 + 1)
        self.r_add.push(0 - 4)

    /#/ When some input needs `cf_syscall(n, a, b, c, d, e, f)` and none defines it, adds the
    /#/ function: the C calling convention moved into the registers of the `syscall` instruction.
    fn add_syscall(self) => void:
        let w = txt_of("cf_syscall")
        let id = self.find(&w)
        if id < 0 || self.g_need.b[id] != 1 || self.g_def.b[id] >= 0:
            return
        /#/ mov rax,rdi; mov rdi,rsi; mov rsi,rdx; mov rdx,rcx; mov r10,r8; mov r8,r9; mov r9,[rsp+8]; syscall; ret
        let code = [72, 137, 248, 72, 137, 247, 72, 137, 214, 72, 137, 202, 77, 137, 194, 77, 137, 200, 76, 139, 76, 36, 8, 15, 5, 195]
        let off = self.blob.n
        for k in 0..26:
            self.blob.put_byte(code[k])
        let sec0 = self.sc_type.n
        let sym0 = self.y_sec.n
        self.in_sec0.push(sec0)
        self.in_sym0.push(sym0)
        self.nin = self.nin + 1
        self.sc_type.push(1)
        self.sc_flags.push(6)
        self.sc_off.push(off)
        self.sc_size.push(26)
        self.sc_align.push(16)
        self.sc_grp.push(0 - 1)
        self.sc_goff.push(0)
        self.sc_rva.push(0)
        self.y_val.push(0)
        self.y_size.push(0)
        self.y_bind.push(1)
        self.y_type.push(0)
        self.y_rva.push(0)
        self.y_got.push(0 - 1)
        self.y_sec.push(sec0)
        self.y_nm.push(self.intern(&w))
        self.declare(sym0)

    /#/ The defining symbol of the global called `name`, or -1.
    fn find_def(self, name: &str) => int:
        let w = txt_of(name)
        let id = self.find(&w)
        if id < 0:
            return 0 - 1
        return self.g_def.b[id]

    /#/ Reports the names some input needs and none defines.
    fn check_undefined(self) => void:
        for id in 0..self.nm_off.n:
            if self.g_need.b[id] == 1 && self.g_def.b[id] < 0:
                let w = self.name_of(id)
                self.err("undefined symbol:", &w)

    /#/ ---- layout -------------------------------------------------------------------------------

    /#/ The symbol that stands for `sid` after resolution: the definition of its name, or itself.
    fn final_sym(self, sid: int) => int:
        let id = self.y_nm.b[sid]
        if id >= 0 && self.y_bind.b[sid] != 0 && self.g_def.b[id] >= 0:
            return self.g_def.b[id]
        return sid

    fn group_of(self, s: int) => int:
        let fl = self.sc_flags.b[s]
        if fl & 2 == 0:
            return 0 - 1
        if fl & 1024 != 0:
            return 0 - 2
        if fl & 4 != 0:
            return g_text()
        if self.sc_type.b[s] == 8:
            return g_bss()
        if fl & 1 != 0:
            return g_data()
        return g_ro()

    /#/ Drops the text sections that `entry` (a symbol) does not reach through relocations. Data
    /#/ sections are all kept, so what they point at stays too. Call it before `layout`.
    fn gc(self, entry: int) => void:
        let ns = self.sc_type.n
        let live: buf<int> = new_buf(int, ns + 1)
        /#/ the relocations of each section, found by counting
        let first: buf<int> = new_buf(int, ns + 2)
        for r in 0..self.r_type.n:
            first[self.r_sec.b[r] + 1] = first[self.r_sec.b[r] + 1] + 1
        for s in 0..ns + 1:
            first[s + 1] = first[s + 1] + first[s]
        let fill: buf<int> = new_buf(int, ns + 1)
        let order: buf<int> = new_buf(int, self.r_type.n + 1)
        for r in 0..self.r_type.n:
            let s = self.r_sec.b[r]
            order[first[s] + fill[s]] = r
            fill[s] = fill[s] + 1
        let stack: buf<int> = new_buf(int, ns + 1)
        let sp = 0
        for s in 0..ns:
            let g = self.group_of(s)
            if g >= 0 && g != g_text():
                live[s] = 1
                stack[sp] = s
                sp = sp + 1
        let es = self.y_sec.b[entry]
        if es >= 0 && live[es] == 0:
            live[es] = 1
            stack[sp] = es
            sp = sp + 1
        while sp > 0:
            sp = sp - 1
            let s = stack[sp]
            for k in first[s]..first[s + 1]:
                let f = self.final_sym(self.r_sym.b[order[k]])
                let t = self.y_sec.b[f]
                if t >= 0 && live[t] == 0:
                    live[t] = 1
                    stack[sp] = t
                    sp = sp + 1
        self.live = live
        self.gc_on = true

    /#/ Decides where everything goes: the group and image address of each section, the slots of
    /#/ the GOT, the common symbols, and the pieces of the file.
    fn layout(self) => void:
        self.gsize = new_buf(int, 4)
        self.galign = new_buf(int, 4)
        self.gbase = new_buf(int, 4)
        for g in 0..4:
            self.galign[g] = 1
        for s in 0..self.sc_type.n:
            let g = self.group_of(s)
            if g == g_text() && self.gc_on && self.live[s] == 0:
                g = 0 - 1
            self.sc_grp.b[s] = g
            if g == 0 - 2:
                self.msg("thread-local storage is not supported")
                self.sc_grp.b[s] = 0 - 1
            elif g >= 0:
                let a = self.sc_align.b[s]
                if a < 1:
                    a = 1
                self.gsize[g] = align_to(self.gsize[g], a)
                self.sc_goff.b[s] = self.gsize[g]
                self.gsize[g] = self.gsize[g] + self.sc_size.b[s]
                if a > self.galign[g]:
                    self.galign[g] = a
        /#/ GOT slots, after the read-only sections
        self.ngot = 0
        for r in 0..self.r_type.n:
            let ty = self.r_type.b[r]
            if (ty == 9 || ty == 41 || ty == 42) && self.sc_grp.b[self.r_sec.b[r]] >= 0:
                let f = self.final_sym(self.r_sym.b[r])
                if self.y_got.b[f] < 0:
                    self.y_got.b[f] = self.ngot
                    self.ngot = self.ngot + 1
        self.gsize[1] = align_to(self.gsize[1], 8)
        let got_off = self.gsize[1]
        self.gsize[1] = self.gsize[1] + 8 * self.ngot
        if self.galign[1] < 8:
            self.galign[1] = 8
        /#/ common symbols go to the end of .bss
        for id in 0..self.nm_off.n:
            if self.g_how.b[id] == 1:
                let sid = self.g_def.b[id]
                let a = self.y_val.b[sid]
                if a < 1:
                    a = 1
                self.gsize[3] = align_to(self.gsize[3], a)
                self.y_rva.b[sid] = self.gsize[3]
                self.gsize[3] = self.gsize[3] + self.y_size.b[sid]
                if a > self.galign[3]:
                    self.galign[3] = a
        for g in 0..4:
            if self.galign[g] > 4096:
                self.msg("section alignment over a page")
                self.galign[g] = 4096
        /#/ the file: headers and text, rodata, data + bss; each piece starts at the same place
        /#/ modulo the page size in the file and in memory
        let has_ro = self.gsize[1] > 0
        let has_data = self.gsize[2] > 0 || self.gsize[3] > 0
        let nph = 2
        if has_ro:
            nph = nph + 1
        if has_data:
            nph = nph + 1
        let off_t = align_to(64 + 56 * nph, self.galign[0])
        self.gbase[0] = off_t
        let end_f = off_t + self.gsize[0]
        let end_r = end_f
        self.sg_off.push(0)
        self.sg_rva.push(0)
        self.sg_fsz.push(end_f)
        self.sg_msz.push(end_f)
        self.sg_flags.push(5)
        if has_ro:
            let off = align_to(end_f, self.galign[1])
            let rva = align_to(end_r, 4096) + off % 4096
            self.gbase[1] = rva
            self.got_rva = rva + got_off
            end_f = off + self.gsize[1]
            end_r = rva + self.gsize[1]
            self.sg_off.push(off)
            self.sg_rva.push(rva)
            self.sg_fsz.push(self.gsize[1])
            self.sg_msz.push(self.gsize[1])
            self.sg_flags.push(4)
        if has_data:
            let off = align_to(end_f, self.galign[2])
            let rva = align_to(end_r, 4096) + off % 4096
            self.gbase[2] = rva
            end_r = rva + self.gsize[2]
            let bss = align_to(end_r, self.galign[3])
            self.gbase[3] = bss
            self.sg_off.push(off)
            self.sg_rva.push(rva)
            self.sg_fsz.push(self.gsize[2])
            self.sg_msz.push(bss + self.gsize[3] - rva)
            self.sg_flags.push(6)
            end_r = bss + self.gsize[3]
        self.image_size = end_r
        for s in 0..self.sc_type.n:
            if self.sc_grp.b[s] >= 0:
                self.sc_rva.b[s] = self.gbase[self.sc_grp.b[s]] + self.sc_goff.b[s]
        for id in 0..self.nm_off.n:
            if self.g_how.b[id] == 1:
                let sid = self.g_def.b[id]
                self.y_rva.b[sid] = self.y_rva.b[sid] + self.gbase[3]

    /#/ The image: zeros, with the bytes of every section that has some in its place.
    fn build_image(self) => Txt:
        let mem = new_txt()
        put_zeros(&mem, self.image_size)
        for s in 0..self.sc_type.n:
            let g = self.sc_grp.b[s]
            if g >= 0 && g != g_bss():
                for k in 0..self.sc_size.b[s]:
                    mem.b[self.sc_rva.b[s] + k] = self.blob.b[self.sc_off.b[s] + k]
        return mem

    /#/ ---- relocation ---------------------------------------------------------------------------

    /#/ The address of symbol `sid` for an image loaded at `base`; 0 for an undefined weak one.
    fn sym_addr(self, sid: int, base: int) => int:
        let f = self.final_sym(sid)
        let sec = self.y_sec.b[f]
        if sec == no_sec():
            return 0
        if sec == abs_sec():
            return self.y_val.b[f]
        if sec == common_sec():
            return base + self.y_rva.b[f]
        if self.sc_grp.b[sec] < 0:
            return 0
        return base + self.sc_rva.b[sec] + self.y_val.b[f]

    fn got_addr(self, sid: int, base: int) => int:
        return base + self.got_rva + 8 * self.y_got.b[self.final_sym(sid)]

    /#/ Patches `mem`, the image from `build_image`, for a load address of `base`: fills the GOT
    /#/ and applies every relocation. Returns the number of errors.
    fn apply_relocs(self, mem: &Txt, base: int) => int:
        let bad = 0
        for y in 0..self.y_got.n:
            if self.y_got.b[y] >= 0:
                wr64(mem, self.got_rva + 8 * self.y_got.b[y], self.sym_addr(y, base))
        for r in 0..self.r_type.n:
            let s = self.r_sec.b[r]
            if self.sc_grp.b[s] >= 0:
                let ty = self.r_type.b[r]
                let at = self.sc_rva.b[s] + self.r_off.b[r]
                let p = base + at
                let a = self.r_add.b[r]
                let sym = self.r_sym.b[r]
                if ty == 0:
                    continue
                if ty == 1:
                    wr64(mem, at, self.sym_addr(sym, base) + a)
                elif ty == 24:
                    wr64(mem, at, self.sym_addr(sym, base) + a - p)
                elif ty == 2 || ty == 4:
                    bad = bad + self.put_signed(mem, at, self.sym_addr(sym, base) + a - p, r)
                elif ty == 9 || ty == 41 || ty == 42:
                    bad = bad + self.put_signed(mem, at, self.got_addr(sym, base) + a - p, r)
                elif ty == 10:
                    let v = self.sym_addr(sym, base) + a
                    if v < 0 || v > 4294967295:
                        bad = bad + self.reloc_err("relocation out of range", r)
                    else:
                        wr32(mem, at, v)
                elif ty == 11:
                    bad = bad + self.put_signed(mem, at, self.sym_addr(sym, base) + a, r)
                else:
                    bad = bad + self.reloc_err("unsupported relocation type", r)
        return bad

    fn put_signed(self, mem: &Txt, at: int, v: int, r: int) => int:
        if v < 0 - 2147483648 || v > 2147483647:
            return self.reloc_err("relocation out of range", r)
        wr32(mem, at, v)
        return 0

    fn reloc_err(self, what: &str, r: int) => int:
        self.errs = self.errs + 1
        say(f"ld: {what} (type {self.r_type.b[r]})\n")
        fflush(0)
        return 1

fn new_linker() => Linker:
    return Linker { blob: new_txt(), errs: 0, nin: 0, in_sec0: new_col(), in_sym0: new_col(), sc_type: new_col(), sc_flags: new_col(), sc_off: new_col(), sc_size: new_col(), sc_align: new_col(), sc_grp: new_col(), sc_goff: new_col(), sc_rva: new_col(), y_sec: new_col(), y_val: new_col(), y_size: new_col(), y_bind: new_col(), y_type: new_col(), y_nm: new_col(), y_rva: new_col(), y_got: new_col(), r_sec: new_col(), r_off: new_col(), r_type: new_col(), r_sym: new_col(), r_add: new_col(), pool: new_txt(), nm_off: new_col(), ht: new_buf(int, 64), g_def: new_col(), g_how: new_col(), g_need: new_col(), pulled: new_col(), gsize: new_buf(int, 4), galign: new_buf(int, 4), gbase: new_buf(int, 4), ngot: 0, got_rva: 0, sg_off: new_col(), sg_rva: new_col(), sg_fsz: new_col(), sg_msz: new_col(), sg_flags: new_col(), image_size: 0, gc_on: false, quiet: false, syms: false, dbg: new_txt(), nshdr: 0, live: new_buf(int, 1) }

/#/ DWARF for a linked executable: the function addresses the link gave, for `dwcore.cf`.



/#/ Makes the four sections; false when no function has lines.
fn build_dwarf(l: &Linker, base: int, abbrev: &Txt, info: &Txt, line: &Txt, frame: &Txt) => bool:
    let t = &l.dbg
    let ta = new_dw_list()
    let ts = new_dw_list()
    let start = 0
    for i in 0..t.n + 1:
        if i < t.n && t.b[i] != 10:
            continue
        if i > start + 2 && t.b[start] == int('F') && t.b[start + 1] == 32:
            let w = new_txt()
            for k in start + 2..i:
                w.put_byte(t.b[k])
            let addr = 0 - 1
            let size = 0
            let id = l.find(&w)
            if id >= 0 && l.g_def.b[id] >= 0:
                let sid = l.g_def.b[id]
                let f = l.final_sym(sid)
                let sec = l.y_sec.b[f]
                if sec >= 0 && sec < l.sc_grp.n && l.sc_grp.b[sec] >= 0:
                    addr = l.sym_addr(sid, base)
                    size = l.y_size.b[f]
            dw_push(&ta, addr)
            dw_push(&ts, size)
        start = i + 1
    return build_dwarf_core(t, &ta, &ts, abbrev, info, line, frame)


/#/ where an executable is loaded
fn exe_base() => int:
    return 4194304

fn put16(t: &Txt, v: int) => void:
    for k in 0..2:
        t.put_byte((v >> (8 * k)) & 255)

fn put32(t: &Txt, v: int) => void:
    for k in 0..4:
        t.put_byte((v >> (8 * k)) & 255)

fn put64(t: &Txt, v: int) => void:
    for k in 0..8:
        t.put_byte((v >> (8 * k)) & 255)

fn phdr(t: &Txt, ty: int, flags: int, off: int, addr: int, fsz: int, msz: int, align: int) => void:
    put32(t, ty)
    put32(t, flags)
    put64(t, off)
    put64(t, addr)
    put64(t, addr)
    put64(t, fsz)
    put64(t, msz)
    put64(t, align)

/#/ The symbol table, its names and the section headers, appended to `out`; returns where the
/#/ section headers start. One section per segment, the symbols point into them.
fn add_symbols(l: &Linker, out: &Txt, base: int) => int:
    let nseg = l.sg_off.n
    let strs = new_txt()
    strs.put_byte(0)
    let tab = new_txt()
    put_zeros(&tab, 24)
    let nlocal = 1
    for pass in 0..2:
        for sid in 0..l.y_sec.n:
            let nm = l.y_nm.b[sid]
            let sec = l.y_sec.b[sid]
            let local = l.y_bind.b[sid] == 0
            if nm >= 0 && sec >= 0 && sec < l.sc_grp.n && l.sc_grp.b[sec] >= 0 && l.final_sym(sid) == sid && local == (pass == 0):
                let ty = l.y_type.b[sid]
                if ty == 0 || ty == 1 || ty == 2:
                    let addr = l.sym_addr(sid, base)
                    let seg = 0
                    for k in 0..nseg:
                        if addr >= base + l.sg_rva.b[k] && addr < base + l.sg_rva.b[k] + l.sg_msz.b[k]:
                            seg = k + 1
                    if seg > 0:
                        let w = l.name_of(nm)
                        put32(&tab, strs.n)
                        strs.put_all(&w)
                        strs.put_byte(0)
                        let bind = 1
                        if local:
                            bind = 0
                        tab.put_byte((bind << 4) | ty)
                        tab.put_byte(0)
                        put16(&tab, seg)
                        put64(&tab, addr)
                        put64(&tab, l.y_size.b[sid])
        if pass == 0:
            nlocal = tab.n // 24
    /#/ names of the sections: .symtab .strtab .shstrtab .seg
    let sh = new_txt()
    sh.put_byte(0)
    let n_sym = sh.n
    sh.put(".symtab")
    sh.put_byte(0)
    let n_str = sh.n
    sh.put(".strtab")
    sh.put_byte(0)
    let n_shs = sh.n
    sh.put(".shstrtab")
    sh.put_byte(0)
    /#/ the pieces are named as the usual sections are, for tools that look for `.text`
    let n_seg = sh.n
    sh.put(".text")
    sh.put_byte(0)
    let n_segro = sh.n
    sh.put(".rodata")
    sh.put_byte(0)
    let n_segrw = sh.n
    sh.put(".data")
    sh.put_byte(0)
    let dab = new_txt()
    let din = new_txt()
    let dli = new_txt()
    let dfr = new_txt()
    let has_dw = build_dwarf(l, base, &dab, &din, &dli, &dfr)
    let n_dab = sh.n
    let n_din = 0
    let n_dli = 0
    let n_dfr = 0
    if has_dw:
        sh.put(".debug_abbrev")
        sh.put_byte(0)
        n_din = sh.n
        sh.put(".debug_info")
        sh.put_byte(0)
        n_dli = sh.n
        sh.put(".debug_line")
        sh.put_byte(0)
        n_dfr = sh.n
        sh.put(".debug_frame")
        sh.put_byte(0)
    put_zeros(out, align_to(out.n, 8) - out.n)
    let off_sym = out.n
    out.put_all(&tab)
    let off_str = out.n
    out.put_all(&strs)
    let off_shs = out.n
    out.put_all(&sh)
    let off_dab = out.n
    out.put_all(&dab)
    let off_din = out.n
    out.put_all(&din)
    let off_dli = out.n
    out.put_all(&dli)
    let off_dfr = out.n
    out.put_all(&dfr)
    put_zeros(out, align_to(out.n, 8) - out.n)
    let shoff = out.n
    put_zeros(out, 64)
    for k in 0..nseg:
        let fl = 2
        if l.sg_flags.b[k] & 1 != 0:
            fl = fl | 4
        if l.sg_flags.b[k] & 2 != 0:
            fl = fl | 1
        let nmo = n_segro
        if l.sg_flags.b[k] & 1 != 0:
            nmo = n_seg
        elif l.sg_flags.b[k] & 2 != 0:
            nmo = n_segrw
        put32(out, nmo)
        put32(out, 1)
        put64(out, fl)
        put64(out, base + l.sg_rva.b[k])
        put64(out, l.sg_off.b[k])
        put64(out, l.sg_fsz.b[k])
        put32(out, 0)
        put32(out, 0)
        put64(out, 16)
        put64(out, 0)
    put32(out, n_sym)
    put32(out, 2)
    put64(out, 0)
    put64(out, 0)
    put64(out, off_sym)
    put64(out, tab.n)
    put32(out, nseg + 2)
    put32(out, nlocal)
    put64(out, 8)
    put64(out, 24)
    put32(out, n_str)
    put32(out, 3)
    put64(out, 0)
    put64(out, 0)
    put64(out, off_str)
    put64(out, strs.n)
    put32(out, 0)
    put32(out, 0)
    put64(out, 1)
    put64(out, 0)
    put32(out, n_shs)
    put32(out, 3)
    put64(out, 0)
    put64(out, 0)
    put64(out, off_shs)
    put64(out, sh.n)
    put32(out, 0)
    put32(out, 0)
    put64(out, 1)
    put64(out, 0)
    l.nshdr = nseg + 4
    if has_dw:
        for q in 0..4:
            let nmo = n_dab
            let off = off_dab
            let sz = dab.n
            if q == 1:
                nmo = n_din
                off = off_din
                sz = din.n
            elif q == 2:
                nmo = n_dli
                off = off_dli
                sz = dli.n
            elif q == 3:
                nmo = n_dfr
                off = off_dfr
                sz = dfr.n
            put32(out, nmo)
            put32(out, 1)
            put64(out, 0)
            put64(out, 0)
            put64(out, off)
            put64(out, sz)
            put32(out, 0)
            put32(out, 0)
            put64(out, 1)
            put64(out, 0)
        l.nshdr = nseg + 8
    return shoff

fn link_exe(l: &Linker) => Txt:
    let none = new_txt()
    l.add_start()
    l.add_syscall()
    l.check_undefined()
    if l.errs > 0:
        return none
    let entry = l.find_def("_start")
    if entry < 0:
        l.msg("no entry point: define _start or main")
        return none
    l.gc(entry)
    l.layout()
    if l.errs > 0:
        return none
    let base = exe_base()
    let mem = l.build_image()
    if l.apply_relocs(&mem, base) > 0:
        return none
    let nseg = l.sg_off.n
    let out = new_txt()
    for k in 0..nseg:
        let at = l.sg_off.b[k]
        put_zeros(&out, at + l.sg_fsz.b[k] - out.n)
        for q in 0..l.sg_fsz.b[k]:
            out.b[at + q] = mem.b[l.sg_rva.b[k] + q]
    let shoff = 0
    let shnum = 0
    let shstr = 0
    if l.syms:
        shoff = add_symbols(l, &out, base)
        shnum = l.nshdr
        shstr = nseg + 3
    /#/ the headers, over the start of the first piece
    let h = new_txt()
    h.put_byte(127)
    h.put("ELF")
    h.put_byte(2)
    h.put_byte(1)
    h.put_byte(1)
    put_zeros(&h, 9)
    put16(&h, 2)
    put16(&h, 62)
    put32(&h, 1)
    put64(&h, l.sym_addr(entry, base))
    put64(&h, 64)
    put64(&h, shoff)
    put32(&h, 0)
    put16(&h, 64)
    put16(&h, 56)
    put16(&h, nseg + 1)
    put16(&h, 64)
    put16(&h, shnum)
    put16(&h, shstr)
    for k in 0..nseg:
        phdr(&h, 1, l.sg_flags.b[k], l.sg_off.b[k], base + l.sg_rva.b[k], l.sg_fsz.b[k], l.sg_msz.b[k], 4096)
    /#/ PT_GNU_STACK: the stack is not executable
    phdr(&h, 1685382481, 6, 0, 0, 0, 0, 16)
    for k in 0..h.n:
        out.b[k] = h.b[k]
    return out

use chmod in libc of c

/#/ `-g`: the executable keeps the names of its functions and data (a symbol table); without it the
/#/ file has none, which is what a release build wants.
let keep_syms = false

fn set_keep_syms() => void:
    keep_syms = true

/#/ The `cc` command start for linking: sections nobody reaches are dropped, and the symbols too
/#/ unless `-g` was given.
fn cc_link_start() => Txt:
    if keep_syms:
        return txt_of("cc -w -Wl,--gc-sections -o '")
    return txt_of("cc -w -s -Wl,--gc-sections -o '")

/#/ Links the objects into `out`: `paths` has one object per line, `quoted` the same as `'a' 'b'` for
/#/ `cc`, `flags` is what the program's `.cfc` files add to the `cc` line. With `static_link` the
/#/ built-in linker goes first; when `quiet` (the choice was automatic) and it cannot, `cc` is tried.
/#/ 0 on success.
fn link_objects(paths: &Txt, quoted: &Txt, flags: &Txt, out: &Txt, static_link: bool, quiet: bool) => int:
    if static_link:
        let rc = link_static(paths, out, quiet)
        if rc == 0 || !quiet:
            return rc
    let cmd = cc_link_start()
    cmd.put_all(out)
    cmd.put("'")
    cmd.put_all(quoted)
    cmd.put_all(flags)
    cmd.put(" -lm")
    if system(txt_str(&cmd)) != 0:
        return 1
    return 0

/#/ Links the object files named in `paths` (one per line) into the executable `out`.
fn link_static(paths: &Txt, out: &Txt, quiet: bool) => int:
    let l = new_linker()
    l.quiet = quiet
    l.syms = keep_syms
    let lo = 0
    for i in 0..paths.n:
        if paths.b[i] == 10:
            let p = slice(paths, lo, i)
            let data = read_file(&p)
            if data.n < 0:
                say(f"error: cannot read '{txt_str(&p)}'\n")
                return 1
            l.add_file(&data, &p)
            lo = i + 1
    let exe = link_exe(&l)
    if exe.n == 0:
        return 1
    write_file(out, &exe)
    chmod(txt_str(out), 493)
    return 0

/#/ The C functions `rt/src/min.cf` defines, space-separated.
fn min_provides() => str:
    return " malloc free calloc memcpy strlen strdup strcmp open read write close remove access chmod clock_gettime fork waitpid system exit _exit execve fflush "

/#/ Does the program (flattened text) import only what the built-in C library has? Then it can be
/#/ linked without `cc`.
fn can_link_static(t: &Txt) => bool:
    let lo = 0
    let have = min_provides()
    for i in 0..t.n + 1:
        if i == t.n || t.b[i] == 10:
            if i - lo > 8 && find_in(t, lo, i, " of c") >= 0 && t.b[lo] == int('u') && t.b[lo + 1] == int('s') && t.b[lo + 2] == int('e'):
                let lib = c_lib_name(t, lo, i)
                if !lib.is("libc"):
                    return false
                /#/ the names between `use ` and ` in `
                let stop = find_in(t, lo, i, " in ")
                let name = new_txt()
                for k in lo + 4..stop + 1:
                    if k == stop || t.b[k] == 44 || t.b[k] == 32:
                        if name.n > 0:
                            let probe = txt_of(" ")
                            probe.put_all(&name)
                            probe.put(" ")
                            let ps = txt_str(&probe)
                            let ht = txt_of(&have)
                            if find_in(&ht, 0, ht.n, &ps) < 0:
                                return false
                            name = new_txt()
                    else:
                        name.put_byte(t.b[k])
            lo = i + 1
    return true

/#/ `coffee2 -c header.h`: a `.cfc` of `c fn` declarations read from a C header.
/#/ `coffee2 --have-c file.cf`: a `.h` for the `c fn` the file defines.
/#/ This is not a C compiler: no preprocessing (`#` lines are dropped, `#include` is not followed, macros are not
/#/ expanded), and only declarations are read. What the `.cfc` cannot say is left out with a comment line saying so:
/#/ structs by value, `long double`, unions and enums as such (an enum is an `int(4)+`, a struct is opaque).

fn hg_alpha(c: int) => bool:
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'

fn hg_digit(c: int) => bool:
    return c >= '0' && c <= '9'

/#/ Is `w` one of the words of `list` (separated by spaces)?
fn hg_word_in(list: &str, w: &Txt) => bool:
    let i = 0
    let n = len(list)
    while i < n:
        let j = i
        while j < n && ch(list, j) != 32:
            j = j + 1
        if j - i == w.n && w.n > 0:
            let same = true
            for k in 0..w.n:
                if ch(list, i + k) != w.b[k]:
                    same = false
            if same:
                return true
        i = j + 1
    return false

/#/ A parameter named like a Coffee keyword gets a `_` after it.
fn hg_safe(name: &Txt) => Txt:
    let r = copy_txt(name)
    if hg_word_in(" fn let if else elif for while in return use class copy clone mv rm type as c true false nil and or not match enum pub self ", name):
        r.put("_")
    return r

class CHdr:
    src: Txt
    ts: buf<int>
    te: buf<int>
    nt: int
    p: int
    /#/ the `type X: object` lines and the `c fn` lines
    types: Txt
    fns: Txt
    nfn: int
    nskip: int
    /#/ the type names known: `name=text=kind` per line (kind 0 a plain type, 1 a char type, 2 a handle, 3 void, 9 unknown)
    aliases: Txt
    /#/ the struct and union tags: `tag=name` per line
    tags: Txt
    /#/ the declaration specifiers last read
    sp_text: Txt
    sp_kind: int
    sp_static: bool
    sp_typedef: bool
    sp_anon: bool
    /#/ the declarator last read
    d_name: Txt
    d_depth: int
    d_fn: bool
    d_fnptr: bool
    d_params: Txt
    d_bad: bool
    p_bad: bool
    /#/ the result of the last `find_alias` / `find_tag`
    f_text: Txt
    f_kind: int

    fn add_tok(self, s: int, e: int) => void:
        if self.nt >= len(self.ts):
            self.ts = buf_resize(self.ts, self.nt * 2 + 16)
            self.te = buf_resize(self.te, self.nt * 2 + 16)
        self.ts[self.nt] = s
        self.te[self.nt] = e
        self.nt = self.nt + 1

    /#/ Splits the text into tokens: words, numbers, strings and single characters (`...` is one token).
    fn lex(self) => void:
        let n = self.src.n
        let i = 0
        let bol = true
        while i < n:
            let c = self.src.b[i]
            if c == 10:
                bol = true
                i = i + 1
            elif c == 32 || c == 9 || c == 13 || c == 12 || c == 11:
                i = i + 1
            elif c == '#' && bol:
                while i < n && self.src.b[i] != 10:
                    if self.src.b[i] == 92 && i + 1 < n && self.src.b[i + 1] == 10:
                        i = i + 1
                    i = i + 1
            elif c == '/' && i + 1 < n && self.src.b[i + 1] == '/':
                while i < n && self.src.b[i] != 10:
                    i = i + 1
            elif c == '/' && i + 1 < n && self.src.b[i + 1] == '*':
                i = i + 2
                while i + 1 < n && !(self.src.b[i] == '*' && self.src.b[i + 1] == '/'):
                    i = i + 1
                i = i + 2
            elif hg_alpha(c):
                let s = i
                while i < n && (hg_alpha(self.src.b[i]) || hg_digit(self.src.b[i])):
                    i = i + 1
                self.add_tok(s, i)
                bol = false
            elif hg_digit(c):
                let s = i
                while i < n && (hg_alpha(self.src.b[i]) || hg_digit(self.src.b[i]) || self.src.b[i] == '.'):
                    i = i + 1
                self.add_tok(s, i)
                bol = false
            elif c == '"' || c == 39:
                let s = i
                i = i + 1
                while i < n && self.src.b[i] != c:
                    if self.src.b[i] == 92:
                        i = i + 1
                    i = i + 1
                i = i + 1
                self.add_tok(s, i)
                bol = false
            elif c == '.' && i + 2 < n && self.src.b[i + 1] == '.' && self.src.b[i + 2] == '.':
                self.add_tok(i, i + 3)
                i = i + 3
                bol = false
            else:
                self.add_tok(i, i + 1)
                i = i + 1
                bol = false

    /#/ Is token `i` the word `w`?
    fn eq(self, i: int, w: &str) => bool:
        if i >= self.nt:
            return false
        let s = self.ts[i]
        if self.te[i] - s != len(w):
            return false
        for k in 0..len(w):
            if self.src.b[s + k] != ch(w, k):
                return false
        return true

    fn ident_at(self, i: int) => bool:
        if i >= self.nt:
            return false
        return hg_alpha(self.src.b[self.ts[i]])

    fn str_at(self, i: int) => bool:
        if i >= self.nt:
            return false
        return self.src.b[self.ts[i]] == '"'

    fn text(self, i: int) => Txt:
        return slice(&self.src, self.ts[i], self.te[i])

    fn is_qual(self, i: int) => bool:
        return self.eq(i, "const") || self.eq(i, "volatile") || self.eq(i, "restrict") || self.eq(i, "__restrict") || self.eq(i, "__restrict__") || self.eq(i, "register") || self.eq(i, "inline") || self.eq(i, "__inline") || self.eq(i, "__inline__") || self.eq(i, "_Noreturn") || self.eq(i, "__extension__") || self.eq(i, "extern") || self.eq(i, "auto") || self.eq(i, "_Thread_local") || self.eq(i, "_Atomic")

    fn is_attr(self, i: int) => bool:
        return self.eq(i, "__attribute__") || self.eq(i, "__declspec") || self.eq(i, "__asm__") || self.eq(i, "__asm") || self.eq(i, "asm")

    /#/ `p` is at an opening bracket: the index after its match.
    fn skip_pair(self, p: int) => int:
        let d = 0
        let i = p
        while i < self.nt:
            if self.eq(i, "(") || self.eq(i, "{") || self.eq(i, "["):
                d = d + 1
            elif self.eq(i, ")") || self.eq(i, "}") || self.eq(i, "]"):
                d = d - 1
                if d == 0:
                    return i + 1
            i = i + 1
        return self.nt

    /#/ After `p`, the index past the next `;` outside brackets (or `,` when `comma`).
    fn skip_decl(self, p: int, comma: bool) => int:
        let i = p
        while i < self.nt:
            if self.eq(i, "(") || self.eq(i, "{") || self.eq(i, "["):
                i = self.skip_pair(i)
            elif self.eq(i, ";") || (comma && self.eq(i, ",")):
                return i
            else:
                i = i + 1
        return i

    fn add_alias(self, name: &Txt, text: &Txt, kind: int) => void:
        self.aliases.put_all(name)
        self.aliases.put_byte('=')
        self.aliases.put_all(text)
        self.aliases.put_byte('=')
        self.aliases.put_byte('0' + kind)
        self.aliases.put_byte(10)

    /#/ Looks `name` up in the list of lines `name=text=kind`; the last match wins.
    fn find_in(self, list: &Txt, name: &Txt, kinded: bool) => bool:
        let found = false
        let i = 0
        while i < list.n:
            let j = i
            while j < list.n && list.b[j] != 10:
                j = j + 1
            let k = i
            while k < j && list.b[k] != '=':
                k = k + 1
            if k - i == name.n:
                let same = true
                for m in 0..name.n:
                    if list.b[i + m] != name.b[m]:
                        same = false
                if same:
                    found = true
                    if kinded:
                        self.f_text = slice(list, k + 1, j - 2)
                        self.f_kind = list.b[j - 1] - '0'
                    else:
                        self.f_text = slice(list, k + 1, j)
            i = j + 1
        return found

    fn find_alias(self, name: &Txt) => bool:
        return self.find_in(&self.aliases, name, true)

    fn find_tag(self, name: &Txt) => bool:
        return self.find_in(&self.tags, name, false)

    /#/ A new opaque type `name`.
    fn add_handle(self, name: &Txt) => void:
        self.types.put("type ")
        self.types.put_all(name)
        self.types.put(": object\n")
        self.add_alias(name, name, 2)

    fn seed(self) => void:
        self.aliases.put("size_t=int=0\nssize_t=int=0\nptrdiff_t=int=0\nintptr_t=int=0\nuintptr_t=int=0\ntime_t=int=0\noff_t=int=0\n")
        self.aliases.put("int8_t=int(1)+=1\nuint8_t=int(1)-=1\nint16_t=int(2)+=0\nuint16_t=int(2)-=0\nint32_t=int(4)+=0\nuint32_t=int(4)-=0\nint64_t=int=0\nuint64_t=int(8)-=0\n")
        self.aliases.put("pid_t=int(4)+=0\nwchar_t=int(4)+=0\nbool=bool=0\nFILE=FILE=2\n")

    /#/ Reads declaration specifiers at `p` into `sp_*`.
    fn specs(self) => void:
        self.sp_static = false
        self.sp_typedef = false
        self.sp_anon = false
        let uns = 0
        let sig = 0
        let sh = 0
        let lg = 0
        let has_c = false
        let has_i = false
        let has_f = false
        let has_d = false
        let has_v = false
        let has_b = false
        let any = false
        let named = false
        let tname = new_txt()
        let tkind = 0
        let p = self.p
        while p < self.nt:
            if self.is_qual(p):
                p = p + 1
            elif self.eq(p, "static"):
                self.sp_static = true
                p = p + 1
            elif self.eq(p, "typedef"):
                self.sp_typedef = true
                p = p + 1
            elif self.is_attr(p):
                p = p + 1
                if self.eq(p, "("):
                    p = self.skip_pair(p)
            elif self.eq(p, "unsigned"):
                uns = uns + 1
                any = true
                p = p + 1
            elif self.eq(p, "signed"):
                sig = sig + 1
                any = true
                p = p + 1
            elif self.eq(p, "short"):
                sh = sh + 1
                any = true
                p = p + 1
            elif self.eq(p, "long"):
                lg = lg + 1
                any = true
                p = p + 1
            elif self.eq(p, "int"):
                has_i = true
                any = true
                p = p + 1
            elif self.eq(p, "char"):
                has_c = true
                any = true
                p = p + 1
            elif self.eq(p, "float"):
                has_f = true
                any = true
                p = p + 1
            elif self.eq(p, "double"):
                has_d = true
                any = true
                p = p + 1
            elif self.eq(p, "void"):
                has_v = true
                any = true
                p = p + 1
            elif self.eq(p, "_Bool"):
                has_b = true
                any = true
                p = p + 1
            elif self.eq(p, "struct") || self.eq(p, "union"):
                p = p + 1
                while self.is_attr(p) || self.is_qual(p):
                    p = p + 1
                    if self.eq(p, "("):
                        p = self.skip_pair(p)
                if self.ident_at(p):
                    let tag = self.text(p)
                    p = p + 1
                    if self.find_tag(&tag):
                        tname.clear()
                        tname.put_all(&self.f_text)
                    else:
                        self.tags.put_all(&tag)
                        self.tags.put_byte('=')
                        self.tags.put_all(&tag)
                        self.tags.put_byte(10)
                        self.add_handle(&tag)
                        tname.clear()
                        tname.put_all(&tag)
                else:
                    self.sp_anon = true
                if self.eq(p, "{"):
                    p = self.skip_pair(p)
                named = true
                tkind = 2
            elif self.eq(p, "enum"):
                p = p + 1
                if self.ident_at(p):
                    p = p + 1
                if self.eq(p, "{"):
                    p = self.skip_pair(p)
                named = true
                tname.clear()
                tname.put("int(4)+")
                tkind = 0
            elif self.ident_at(p) && !named && !any:
                let nm = self.text(p)
                if self.find_alias(&nm):
                    tname.clear()
                    tname.put_all(&self.f_text)
                    tkind = self.f_kind
                else:
                    tname.clear()
                    tkind = 9
                named = true
                p = p + 1
            else:
                break
        self.p = p
        self.sp_text.clear()
        if named && (tkind != 9 || !any):
            self.sp_text.put_all(&tname)
            self.sp_kind = tkind
        elif has_v:
            self.sp_text.put("void")
            self.sp_kind = 3
        elif has_b:
            self.sp_text.put("bool")
            self.sp_kind = 0
        elif has_f:
            self.sp_text.put("float(4)")
            self.sp_kind = 0
        elif has_d:
            if lg > 0:
                self.sp_kind = 9
            else:
                self.sp_text.put("float")
                self.sp_kind = 0
        elif has_c:
            if uns > 0:
                self.sp_text.put("int(1)-")
            else:
                self.sp_text.put("int(1)+")
            self.sp_kind = 1
        elif sh > 0:
            if uns > 0:
                self.sp_text.put("int(2)-")
            else:
                self.sp_text.put("int(2)+")
            self.sp_kind = 0
        elif lg > 0:
            if uns > 0:
                self.sp_text.put("int(8)-")
            else:
                self.sp_text.put("int")
            self.sp_kind = 0
        elif has_i || uns > 0 || sig > 0:
            if uns > 0:
                self.sp_text.put("int(4)-")
            else:
                self.sp_text.put("int(4)+")
            self.sp_kind = 0
        else:
            self.sp_kind = 9

    /#/ The Coffee type for a base type behind `depth` stars; false when it has none.
    fn render(self, base: &Txt, kind: int, depth: int, fnptr: bool, result: bool, out: &Txt) => bool:
        if fnptr:
            out.put("object")
            return true
        if depth == 0:
            if kind == 0 || kind == 1:
                out.put_all(base)
                return true
            if kind == 3:
                out.put("void")
                return true
            return false
        if depth == 1:
            if kind == 1 && base.is("int(1)+") && !result:
                out.put("string")
                return true
            if kind == 2:
                out.put_all(base)
                return true
        out.put("object")
        return true

    /#/ The parameters after `(` at `p0`, as `name: type, ...` in `out`; the index after the `)`.
    fn params_into(self, p0: int, out: &Txt) => int:
        let p = p0
        if self.eq(p, "void") && self.eq(p + 1, ")"):
            return p + 2
        if self.eq(p, ")"):
            return p + 1
        let idx = 0
        while p < self.nt:
            if idx > 0:
                out.put(", ")
            if self.eq(p, "..."):
                out.put("args: object")
                p = p + 1
            else:
                self.p = p
                self.specs()
                let btext = copy_txt(&self.sp_text)
                let bk = self.sp_kind
                self.declarator()
                p = self.p
                let ty = new_txt()
                let ok = self.render(&btext, bk, self.d_depth, self.d_fnptr || self.d_fn, false, &ty)
                if self.d_name.n == 0:
                    let an = f"a{idx}"
                    out.put(&an)
                else:
                    let nm = hg_safe(&self.d_name)
                    out.put_all(&nm)
                out.put(": ")
                out.put_all(&ty)
                if !ok:
                    self.p_bad = true
            idx = idx + 1
            if self.eq(p, ","):
                p = p + 1
            elif self.eq(p, ")"):
                return p + 1
            else:
                self.p_bad = true
                while p < self.nt && !self.eq(p, ")"):
                    if self.eq(p, "(") || self.eq(p, "["):
                        p = self.skip_pair(p)
                    else:
                        p = p + 1
                return p + 1
        return p

    /#/ Reads one declarator at `p` into `d_*`: stars, a name, a parameter list or array brackets.
    fn declarator(self) => void:
        let p = self.p
        let depth = 0
        let name = new_txt()
        let params = new_txt()
        let is_fn = false
        let fnptr = false
        let bad = false
        while self.eq(p, "*") || self.is_qual(p):
            if self.eq(p, "*"):
                depth = depth + 1
            p = p + 1
        if self.eq(p, "(") && self.eq(p + 1, "*"):
            p = p + 2
            while self.eq(p, "*") || self.is_qual(p):
                p = p + 1
            if self.ident_at(p):
                name = self.text(p)
                p = p + 1
            while self.eq(p, "["):
                p = self.skip_pair(p)
            if self.eq(p, ")"):
                p = p + 1
            if self.eq(p, "("):
                p = self.skip_pair(p)
            fnptr = true
        else:
            if self.ident_at(p) && !self.is_attr(p):
                name = self.text(p)
                p = p + 1
            if self.eq(p, "("):
                self.p_bad = false
                p = self.params_into(p + 1, &params)
                bad = self.p_bad
                is_fn = true
            while self.eq(p, "["):
                p = self.skip_pair(p)
                depth = depth + 1
        while self.is_attr(p):
            p = p + 1
            if self.eq(p, "("):
                p = self.skip_pair(p)
        self.p = p
        self.d_name = name
        self.d_params = params
        self.d_depth = depth
        self.d_fn = is_fn
        self.d_fnptr = fnptr
        self.d_bad = bad

    /#/ One top-level declaration.
    fn top(self) => void:
        let p = self.p
        if self.eq(p, ";") || self.eq(p, "}"):
            self.p = p + 1
            return
        if self.eq(p, "extern") && self.str_at(p + 1):
            /#/ `extern "C" {` opens a block of declarations; its `}` is dropped above
            p = p + 2
            if self.eq(p, "{"):
                p = p + 1
            self.p = p
            return
        self.p = p
        self.specs()
        let btext = copy_txt(&self.sp_text)
        let bk = self.sp_kind
        let is_static = self.sp_static
        let is_typedef = self.sp_typedef
        let anon = self.sp_anon
        if self.eq(self.p, ";"):
            self.p = self.p + 1
            return
        let first = true
        while self.p < self.nt:
            self.declarator()
            let p2 = self.p
            if self.d_name.n == 0 && !self.d_fnptr:
                self.p = self.skip_decl(p2, false)
                if self.eq(self.p, ";"):
                    self.p = self.p + 1
                return
            if is_typedef:
                self.typedef_one(&btext, bk, anon && first)
            elif self.d_fn && !self.d_fnptr && !is_static:
                self.emit_fn(&btext, bk)
            first = false
            p2 = self.p
            if self.eq(p2, "{"):
                self.p = self.skip_pair(p2)
                return
            if self.eq(p2, "="):
                self.p = self.skip_decl(p2, true)
                p2 = self.p
            if self.eq(p2, ","):
                self.p = p2 + 1
            elif self.eq(p2, ";"):
                self.p = p2 + 1
                return
            else:
                self.p = self.skip_decl(p2, false)
                if self.eq(self.p, ";"):
                    self.p = self.p + 1
                return

    fn typedef_one(self, btext: &Txt, bk: int, anon: bool) => void:
        if self.d_fn:
            return
        if anon && self.d_depth == 0 && !self.d_fnptr:
            /#/ `typedef struct { ... } Name;`
            let nm = copy_txt(&self.d_name)
            self.add_handle(&nm)
            return
        if self.d_depth == 0 && !self.d_fnptr:
            self.add_alias(&self.d_name, btext, bk)
            return
        let ty = new_txt()
        if self.render(btext, bk, self.d_depth, self.d_fnptr, false, &ty):
            self.add_alias(&self.d_name, &ty, 0)

    fn emit_fn(self, btext: &Txt, bk: int) => void:
        let ret = new_txt()
        let ok = self.render(btext, bk, self.d_depth, false, true, &ret)
        if !ok || self.d_bad:
            self.nskip = self.nskip + 1
            self.fns.put("/#/ skipped ")
            self.fns.put_all(&self.d_name)
            self.fns.put(": a type with no Coffee spelling\n")
            return
        self.nfn = self.nfn + 1
        self.fns.put("c fn ")
        self.fns.put_all(&self.d_name)
        self.fns.put_byte('(')
        self.fns.put_all(&self.d_params)
        self.fns.put(") => ")
        self.fns.put_all(&ret)
        self.fns.put(":\n")

fn new_chdr(src: Txt) => CHdr:
    let g = CHdr { src: src, ts: new_buf(int, 256), te: new_buf(int, 256), nt: 0, p: 0, types: new_txt(), fns: new_txt(), nfn: 0, nskip: 0, aliases: new_txt(), tags: new_txt(), sp_text: new_txt(), sp_kind: 9, sp_static: false, sp_typedef: false, sp_anon: false, d_name: new_txt(), d_depth: 0, d_fn: false, d_fnptr: false, d_params: new_txt(), d_bad: false, p_bad: false, f_text: new_txt(), f_kind: 0 }
    g.seed()
    return g

/#/ The `.cfc` text for the C header `src`; `name` is the file named in the first comment line.
fn header_to_cfc(src: &Txt, name: &str) => Txt:
    let g = new_chdr(copy_txt(src))
    g.lex()
    while g.p < g.nt:
        let before = g.p
        g.top()
        if g.p == before:
            g.p = before + 1
    let out = new_txt()
    let note = f"/#/ Generated by `coffee2 -c {name}`: the C declarations of the header as `c fn`.\n"
    out.put(&note)
    out.put_all(&g.types)
    out.put_all(&g.fns)
    if g.nfn == 0:
        say(f"warning: no function declarations found in '{name}'\n")
    return out

/#/ The path with its last extension (after the last `.` of the last name) replaced by `ext`.
fn with_ext(path: &Txt, ext: &str) => Txt:
    let cut = path.n
    let i = path.n - 1
    while i >= 0 && path.b[i] != 47:
        if path.b[i] == '.':
            cut = i
            i = 0 - 1
        else:
            i = i - 1
    let r = slice(path, 0, cut)
    r.put(ext)
    return r

/#/ `-c`: reads the header named as input and writes the `.cfc` (to `-o`, else beside it).
fn gen_cfc_main(input: &Txt, output: &Txt) => int:
    let src = read_file(input)
    if src.n < 0:
        say(f"error: cannot read '{txt_str(input)}' (-c wants a C header, .h or .c)\n")
        return 1
    let shown = txt_str(input)
    let cfc = header_to_cfc(&src, &shown)
    let path = copy_txt(output)
    if path.n == 0:
        path = with_ext(input, ".cfc")
    write_file(&path, &cfc)
    return 0

/#/ ---- --have-c ----

/#/ Does the line starting at `i` of `t` start with `w`?
fn hg_starts(t: &Txt, i: int, w: &str) => bool:
    if i + len(w) > t.n:
        return false
    for k in 0..len(w):
        if t.b[i + k] != ch(w, k):
            return false
    return true

fn hg_trim(t: &Txt) => Txt:
    let s = 0
    let e = t.n
    while s < e && (t.b[s] == 32 || t.b[s] == 9):
        s = s + 1
    while e > s && (t.b[e - 1] == 32 || t.b[e - 1] == 9 || t.b[e - 1] == 13):
        e = e - 1
    return slice(t, s, e)

/#/ Is the line `name` in the list of lines `list`?
fn hg_has_line(list: &Txt, name: &Txt) => bool:
    let i = 0
    while i < list.n:
        let j = i
        while j < list.n && list.b[j] != 10:
            j = j + 1
        if j - i == name.n:
            let same = true
            for k in 0..name.n:
                if list.b[i + k] != name.b[k]:
                    same = false
            if same:
                return true
        i = j + 1
    return false

/#/ The C spelling of the Coffee type `t`; false when there is none.
fn hg_ctype(t: &Txt, handles: &Txt, out: &Txt) => bool:
    if t.is("int"):
        out.put("long long")
    elif t.is("float"):
        out.put("double")
    elif t.is("bool"):
        out.put("bool")
    elif t.is("void"):
        out.put("void")
    elif t.is("str") || t.is("string"):
        out.put("const char*")
    elif t.is("object") || t.is("buf"):
        out.put("void*")
    elif hg_starts(t, 0, "int("):
        let size = 0
        let i = 4
        while i < t.n && hg_digit(t.b[i]):
            size = size * 10 + t.b[i] - '0'
            i = i + 1
        if i < t.n && t.b[i] == ')':
            i = i + 1
        if i < t.n && t.b[i] == '-':
            out.put("unsigned ")
        if size == 1:
            if i < t.n && t.b[i] == '-':
                out.put("char")
            else:
                out.put("signed char")
        elif size == 2:
            out.put("short")
        elif size == 4:
            out.put("int")
        elif size == 8:
            out.put("long long")
        else:
            return false
    elif hg_starts(t, 0, "float("):
        if t.n > 6 && t.b[6] == '4':
            out.put("float")
        elif t.n > 6 && t.b[6] == '8':
            out.put("double")
        else:
            return false
    elif hg_has_line(handles, t):
        out.put_all(t)
        out.put("*")
    else:
        return false
    return true

/#/ The C header for the `c fn` that have a body in the Coffee text `src`; empty when there are none.
fn have_c_header(src: &Txt, guard: &Txt) => Txt:
    let handles = new_txt()
    let i = 0
    while i < src.n:
        let j = i
        while j < src.n && src.b[j] != 10:
            j = j + 1
        if hg_starts(src, i, "type "):
            /#/ `type Name: object`
            let ln = slice(src, i + 5, j)
            let colon = 0 - 1
            for k in 0..ln.n:
                if ln.b[k] == ':' && colon < 0:
                    colon = k
            if colon > 0:
                let nm = slice(&ln, 0, colon)
                let nm2 = hg_trim(&nm)
                let rest = slice(&ln, colon + 1, ln.n)
                let rest2 = hg_trim(&rest)
                if rest2.is("object"):
                    handles.put_all(&nm2)
                    handles.put_byte(10)
        i = j + 1
    let decls = new_txt()
    let count = 0
    i = 0
    while i < src.n:
        let j = i
        while j < src.n && src.b[j] != 10:
            j = j + 1
        if hg_starts(src, i, "c fn "):
            /#/ a definition when the next line that is not blank is indented
            let q = j + 1
            let indented = false
            let looking = true
            while looking && q < src.n:
                let r = q
                while r < src.n && (src.b[r] == 32 || src.b[r] == 9 || src.b[r] == 13):
                    r = r + 1
                if r < src.n && src.b[r] == 10:
                    q = r + 1
                else:
                    looking = false
                    if r < src.n && r > q:
                        indented = true
            if indented:
                if c_export(src, i + 5, j, &handles, &decls):
                    count = count + 1
        i = j + 1
    let out = new_txt()
    if count == 0:
        return out
    out.put("/* Generated by `coffee2 --have-c`: the `c fn` this program defines. */\n")
    let top = f"#ifndef {txt_str(guard)}\n#define {txt_str(guard)}\n\n#include <stdbool.h>\n\n"
    out.put(&top)
    let k = 0
    while k < handles.n:
        let e = k
        while e < handles.n && handles.b[e] != 10:
            e = e + 1
        let nm = slice(&handles, k, e)
        out.put("typedef struct ")
        out.put_all(&nm)
        out.put_byte(' ')
        out.put_all(&nm)
        out.put(";\n")
        k = e + 1
    out.put("\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n")
    out.put_all(&decls)
    out.put("\n#ifdef __cplusplus\n}\n#endif\n\n#endif\n")
    return out

/#/ Adds the C prototype of the `c fn` line `[lo, hi)` of `src` (after `c fn `) to `decls`; false when a type has no C spelling.
fn c_export(src: &Txt, lo: int, hi: int, handles: &Txt, decls: &Txt) => bool:
    let paren = lo
    while paren < hi && src.b[paren] != '(':
        paren = paren + 1
    if paren >= hi:
        return false
    let name = slice(src, lo, paren)
    let close = paren
    let d = 0
    while close < hi:
        if src.b[close] == '(':
            d = d + 1
        elif src.b[close] == ')':
            d = d - 1
            if d == 0:
                break
        close = close + 1
    if close >= hi:
        return false
    let ret = new_txt()
    ret.put("void")
    let arrow = close + 1
    while arrow + 1 < hi && !(src.b[arrow] == '=' && src.b[arrow + 1] == '>'):
        arrow = arrow + 1
    if arrow + 1 < hi:
        let rt = slice(src, arrow + 2, hi)
        let rt2 = hg_trim(&rt)
        if rt2.n > 0 && rt2.b[rt2.n - 1] == ':':
            rt2.n = rt2.n - 1
        let rt3 = hg_trim(&rt2)
        ret.clear()
        if !hg_ctype(&rt3, handles, &ret):
            say(f"warning: --have-c: '{txt_str(&name)}' skipped, its result type has no C spelling\n")
            return false
    let line = new_txt()
    line.put_all(&ret)
    line.put_byte(' ')
    line.put_all(&name)
    line.put_byte('(')
    /#/ the parameters, split at the commas outside parentheses
    let s = paren + 1
    let n_par = 0
    let depth = 0
    let k = paren + 1
    while k <= close:
        let at_end = k == close
        if !at_end && src.b[k] == '(':
            depth = depth + 1
        elif !at_end && src.b[k] == ')':
            depth = depth - 1
        if at_end || (src.b[k] == ',' && depth == 0):
            let par = slice(src, s, k)
            let par2 = hg_trim(&par)
            if par2.n > 0:
                let colon = 0 - 1
                for m in 0..par2.n:
                    if par2.b[m] == ':' && colon < 0:
                        colon = m
                if colon < 0:
                    return false
                let pn = slice(&par2, 0, colon)
                let pn2 = hg_trim(&pn)
                let pt = slice(&par2, colon + 1, par2.n)
                let pt2 = hg_trim(&pt)
                let cty = new_txt()
                if !hg_ctype(&pt2, handles, &cty):
                    say(f"warning: --have-c: '{txt_str(&name)}' skipped, the type of '{txt_str(&pn2)}' has no C spelling\n")
                    return false
                if n_par > 0:
                    line.put(", ")
                line.put_all(&cty)
                line.put_byte(' ')
                line.put_all(&pn2)
                if hg_word_in(" int long char short double float void default register auto static struct union enum switch case goto signed unsigned volatile const sizeof typedef extern do break continue ", &pn2):
                    line.put_byte('_')
                n_par = n_par + 1
            s = k + 1
        k = k + 1
    if n_par == 0:
        line.put("void")
    line.put(");\n")
    decls.put_all(&line)
    return true

/#/ The header guard for the file `path`: `NAME_H`, in upper case.
fn guard_of(path: &Txt) => Txt:
    let s = 0
    for i in 0..path.n:
        if path.b[i] == 47:
            s = i + 1
    let g = new_txt()
    for i in s..path.n:
        let c = path.b[i]
        if c >= 'a' && c <= 'z':
            g.put_byte(c - 32)
        elif hg_alpha(c) || hg_digit(c):
            g.put_byte(c)
        else:
            g.put_byte('_')
    return g

/#/ `--have-c`: writes `<input without .cf>.h`, unless the file defines no `c fn`.
fn have_c_main(input: &Txt, src: &Txt) => void:
    let path = with_ext(input, ".h")
    let guard = guard_of(&path)
    let h = have_c_header(src, &guard)
    if h.n == 0:
        say(f"warning: --have-c: no `c fn` with a body in '{txt_str(input)}', no header written\n")
        return
    write_file(&path, &h)

use fflush, system, exit in libc of c

class Cli:
    input: Txt
    output: Txt
    emit_only: bool
    flat_only: bool
    level: int
    bad: int
    /#/ the directory of the object cache when the build is incremental
    cache: Txt
    /#/ the processes that build units at once; 0 means one per processor
    jobs: int
    static_link: bool
    dynamic: bool
    auto_static: bool
    emit_cir: bool
    /#/ where `--lines` puts the line table
    lines_path: Txt
    /#/ `--stats`: a table of what was generated for each function; `--lint-perf`: findings about slow or pointless code
    stats: bool
    lint: bool
    debug: bool
    /#/ `-c`: the input is a C header and the output a `.cfc`; `--have-c`: also write a `.h` for the `c fn` the program defines
    gen_cfc: bool
    have_c: bool

    fn set_input(self, w: &Txt) => void:
        self.input.put_all(w)

    fn set_output(self, w: &Txt) => void:
        self.output.put_all(w)

    fn set_level(self, l: int) => void:
        self.level = l

    fn set_emit_only(self) => void:
        self.emit_only = true

    fn set_flat_only(self) => void:
        self.flat_only = true

    fn set_bad(self) => void:
        self.bad = 1

    fn input_str(self) => str:
        return txt_str(&self.input)

    fn read_input(self) => Txt:
        return read_file(&self.input)

    fn input_dir(self) => Txt:
        return dir_of(&self.input)

    /#/ The output path: the one given, else `<input>.o` or `a.out`.
    fn out_path(self) => Txt:
        let out = copy_txt(&self.output)
        if out.n == 0:
            if self.flat_only:
                out.put_all(&self.input)
                out.put(".flat")
            elif self.emit_cir:
                out.put_all(&self.input)
                out.put(".cir")
            elif self.emit_only:
                out.put_all(&self.input)
                out.put(".o")
            else:
                out.put("a.out")
        return out

/#/ The arguments, split at the NUL bytes.
fn cmdline() => Txt:
    let p = txt_of("/proc/self/cmdline")
    return read_file(&p)

fn parse_cli(fl: &Flat) => Cli:
    let cli = Cli { input: new_txt(), output: new_txt(), emit_only: false, flat_only: false, level: 1, bad: 0, cache: new_txt(), jobs: 0, static_link: false, dynamic: false, auto_static: false, emit_cir: false, lines_path: new_txt(), stats: false, lint: false, debug: false, gen_cfc: false, have_c: false }
    let raw = cmdline()
    let words = new_txt()
    /#/ one word per line
    for i in 0..raw.n:
        if raw.b[i] == 0:
            words.put_byte(10)
        else:
            words.put_byte(raw.b[i])
    let n = 0
    let s = 0
    let want_out = false
    set_verify(false)
    let want_inc = false
    let want_cache = false
    let want_lines = false
    let want_jobs = false
    for i in 0..words.n:
        if words.b[i] == 10:
            let w = slice(&words, s, i)
            s = i + 1
            n = n + 1
            if n == 1:
                continue
            if want_out:
                cli.set_output(&w)
                want_out = false
            elif want_inc:
                fl.add_dir(&w)
                want_inc = false
            elif want_jobs:
                want_jobs = false
                let v = 0
                for k in 0..w.n:
                    if w.b[k] < 48 || w.b[k] > 57:
                        say("error: -j wants a number\n")
                        cli.set_bad()
                        v = 0 - 1
                        break
                    v = v * 10 + w.b[k] - 48
                if v >= 0:
                    cli.jobs = v
            elif want_cache:
                cli.cache.put_all(&w)
                want_cache = false
            elif want_lines:
                cli.lines_path.put_all(&w)
                want_lines = false
                set_lines()
            elif w.is("-o"):
                want_out = true
            elif w.is("--stats"):
                cli.stats = true
            elif w.is("--lint-perf"):
                cli.lint = true
            elif w.is("--lines"):
                want_lines = true
            elif w.is("-I"):
                want_inc = true
            elif w.is("--incremental"):
                want_cache = true
            elif w.is("-j"):
                want_jobs = true
            elif w.is("-c") || w.is("--gen-cfc"):
                cli.gen_cfc = true
            elif w.is("--have-c"):
                cli.have_c = true
            elif w.is("--static"):
                cli.static_link = true
            elif w.is("--dynamic"):
                cli.dynamic = true
            elif w.is("--verify"):
                set_verify(true)
            elif w.is("--emit-ir"):
                set_ir_dump()
            elif w.is("--align"):
                set_fn_align()
            elif w.is("-g"):
                set_keep_syms()
                cli.debug = true
            elif w.is("--time"):
                time_start()
            elif w.is("--emit-obj"):
                cli.set_emit_only()
            elif w.is("--emit-cir"):
                cli.emit_cir = true
            elif w.is("--emit-flat"):
                cli.set_flat_only()
            elif w.is("-O0"):
                cli.set_level(0)
            elif w.is("-O1"):
                cli.set_level(1)
            elif w.is("-O2"):
                cli.set_level(1)
            elif w.is("-O3"):
                cli.set_level(1)
            elif w.n > 0 && w.b[0] == int('-'):
                say(f"error: unknown option '{txt_str(&w)}'\n")
                cli.set_bad()
            elif cli.input.n == 0:
                cli.set_input(&w)
            else:
                say("error: more than one input file\n")
                cli.set_bad()
    return cli

/#/ The working directory, from `PWD` in the environment; empty when it is not there.
fn count_lines(t: &Txt) => int:
    let n = 0
    for i in 0..t.n:
        if t.b[i] == 10:
            n = n + 1
    return n

fn pwd_of() => Txt:
    let env = read_file(&txt_of("/proc/self/environ"))
    let w = new_txt()
    let out = new_txt()
    for i in 0..env.n + 1:
        if i == env.n || env.b[i] == 0:
            if w.n > 4 && w.b[0] == int('P') && w.b[1] == int('W') && w.b[2] == int('D') && w.b[3] == int('='):
                out = slice(&w, 4, w.n)
            w.clear()
        else:
            w.put_byte(env.b[i])
    return out

/#/ The directory part of a path ("." when there is none).
fn dir_of(path: &Txt) => Txt:
    let cut = 0 - 1
    for i in 0..path.n:
        if path.b[i] == 47:
            cut = i
    if cut < 0:
        return txt_of(".")
    if cut == 0:
        return txt_of("/")
    return slice(path, 0, cut)

fn usage() => int:
    say("usage: coffee2 input.cf [-o output] [--have-c] [-I dir] [-O0|-O1|-O2|-O3] [--emit-obj] [--emit-cir] [--emit-flat] [--lines file] [--incremental dir] [--static|--dynamic] [-g] [--align] [--emit-ir] [--time] [-j n]\n       coffee2 -c header.h [-o output.cfc]\n")
    fflush(0)
    return 2

fn main() => int:
    let fl = new_flat()
    let cli = parse_cli(&fl)
    if cli.bad > 0 || cli.input.n == 0:
        return usage()
    let src = cli.read_input()
    if src.n < 0:
        say(f"error: cannot read '{cli.input_str()}'\n")
        return 1
    if cli.gen_cfc:
        return gen_cfc_main(&cli.input, &cli.output)
    if cli.have_c:
        have_c_main(&cli.input, &src)
    let dir = cli.input_dir()
    fl.flatten(&src, &dir, &cli.input)
    if fl.errs > 0:
        return 1
    phase("flatten")
    let tree = parse_bytes_flat(copy_bytes(&fl.out.b, fl.out.n), fl.out.n)
    let fixed = renamed_classes_in(&tree, &fl.out)
    if fixed.n > 0:
        fl.out = fixed
        tree = parse_bytes_flat(copy_bytes(&fl.out.b, fl.out.n), fl.out.n)
    phase("rename")
    if cli.flat_only:
        let flat_path = cli.out_path()
        fl.write_to(&flat_path)
        return 0
    if cli.emit_cir:
        /#/ -O0 makes the module of the first tier: the IR as lowered, not optimized
        let cir_opt = 0
        if cli.level > 0:
            cir_opt = 1
        let vmap = new_txt()
        if cli.debug:
            set_debug_vars()
        let cir = build_cir_map(copy_bytes(&fl.out.b, fl.out.n), fl.out.n, cir_opt, fl.cfc_str(), &vmap)
        no_lines()
        if cir.n == 0:
            return 1
        let cir_path = cli.out_path()
        write_file(&cir_path, &cir)
        if cli.debug:
            /#/ the map of the lines, beside the module, for `cfjit --gdb`
            let pwd = pwd_of()
            let map = new_txt()
            put_line_map(&fl.seg_line, &fl.seg_src, &fl.seg_unit, fl.nseg, &fl.units, fl.lines, &pwd, &map)
            map.put_all(&vmap)
            let map_path = copy_txt(&cir_path)
            map_path.put(".map")
            write_file(&map_path, &map)
        return 0
    if !cli.emit_only && !cli.dynamic && can_link_static(&fl.out):
        /#/ nothing the built-in C library lacks is imported: no `cc` needed
        cli.static_link = true
        cli.auto_static = true
    let opt = 0
    if cli.level > 0:
        opt = 1
    if cli.stats:
        set_stats()
    if cli.lint:
        set_lint_perf()
    if cli.debug || cli.lines_path.n > 0 || cli.lint:
        let pwd = pwd_of()
        set_line_map(&fl.seg_line, &fl.seg_src, &fl.seg_unit, fl.nseg, &fl.units, fl.lines, &pwd)
        if cli.debug:
            set_debug()
            /#/ the types of separately built files would not agree, so no variables then
            if cli.cache.n == 0:
                set_debug_vars()
    if cli.cache.n > 0 && !cli.emit_only:
        let target = cli.out_path()
        let jobs = cli.jobs
        if jobs == 0:
            jobs = online_cpus()
        if jobs > 16:
            jobs = 16
        hoist_classes(&tree)
        return build_incremental(&fl, tree, &cli.cache, &target, opt, jobs, cli.static_link, cli.auto_static, cli.debug)
    let obj = build_txt(&fl.out, opt, fl.cfc_str())
    no_perf()
    if obj.n == 0:
        return 1
    if cli.stats:
        let rep = new_txt()
        stats_report(&rep, 30)
        say(txt_str(&rep))
    if cli.lint:
        say(txt_str(&lint_txt))
        say(f"lint-perf: {count_lines(&lint_txt)} findings\n")
    if cli.lines_path.n > 0:
        write_file(&cli.lines_path, &lines_txt)
    no_lines()
    let out = cli.out_path()
    let obj_path = copy_txt(&out)
    if !cli.emit_only:
        obj_path.put(".o")
    write_file(&obj_path, &obj)
    if cli.emit_only:
        return 0
    let list = copy_txt(&obj_path)
    list.put_byte(10)
    let quoted = txt_of(" '")
    quoted.put_all(&obj_path)
    quoted.put("'")
    let rt_path = copy_txt(&obj_path)
    rt_path.put(".rt.o")
    if cli.static_link:
        /#/ the C library is a program of its own, so its names cannot clash with the program's imports
        let mrt = min_rt_text()
        let rt_obj = build_text(bytes_of_str(&mrt), len(mrt), opt, "")
        if rt_obj.n == 0:
            return 1
        write_file(&rt_path, &rt_obj)
        list.put_all(&rt_path)
        list.put_byte(10)
    let flags = new_txt()
    fl.link_flags(&flags)
    let rc = link_objects(&list, &quoted, &flags, &out, cli.static_link, cli.auto_static)
    if rc == 0 && cli.debug:
        /#/ a program `cc` linked has no DWARF yet: build it from the symbols the link kept
        let exe = read_file(&out)
        let more = add_dwarf(&exe, &lines_txt)
        if more.n > 0:
            write_file(&out, &more)
    remove_file(&obj_path)
    if cli.static_link:
        remove_file(&rt_path)
    return rc

