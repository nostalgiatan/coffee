    out = out + "            return false\n"
    out = out + "    return true\n"
    out = out + "fn __cf_fmt_fixed(x: float, prec: int) => str:\n"
    out = out + "    if !(x == x):\n"
    out = out + "        return \"nan\"\n"
    out = out + "    let sign = \"\"\n"
    out = out + "    let m = x\n"
    out = out + "    if x < 0.0:\n"
    out = out + "        sign = \"-\"\n"
    out = out + "        m = 0.0 - x\n"
    out = out + "    if !((m - m) == (m - m)):\n"
    out = out + "        return sign + \"inf\"\n"
    out = out + "    let n: buf<int> = new_buf(int, 48)\n"
    out = out + "    if m != 0.0:\n"
    out = out + "        let e = 0\n"
    out = out + "        while m >= 9007199254740992.0:\n"
    out = out + "            m = m / 2.0\n"
    out = out + "            e += 1\n"
    out = out + "        while m < 1048576.0:\n"
    out = out + "            m = m * 4294967296.0\n"
    out = out + "            e -= 32\n"
    out = out + "        while m < 4503599627370496.0:\n"
    out = out + "            m = m * 2.0\n"
    out = out + "            e -= 1\n"
    out = out + "        let f = int(m)\n"
    out = out + "        while e < 0 - 1074:\n"
    out = out + "            f = f // 2\n"
    out = out + "            e += 1\n"
    out = out + "        __cf_bn_set(&n, f, 48)\n"
    out = out + "        for i in 0..prec:\n"
    out = out + "            __cf_bn_mul(&n, 10, 48)\n"
    out = out + "        if e >= 0:\n"
    out = out + "            __cf_bn_shl(&n, e, 48)\n"
    out = out + "        else:\n"
    out = out + "            let left = 0 - e\n"
    out = out + "            let sticky = false\n"
    out = out + "            let last = 0\n"
    out = out + "            let half = 0\n"
    out = out + "            while left > 0:\n"
    out = out + "                let step = left\n"
    out = out + "                if step > 28:\n"
    out = out + "                    step = 28\n"
    out = out + "                let p = 1\n"
    out = out + "                for z in 0..step:\n"
    out = out + "                    p = p * 2\n"
    out = out + "                if last > 0:\n"
    out = out + "                    sticky = true\n"
    out = out + "                last = __cf_bn_divsmall(&n, p)\n"
    out = out + "                half = p // 2\n"
    out = out + "                left -= step\n"
    out = out + "            let up = false\n"
    out = out + "            if last > half:\n"
    out = out + "                up = true\n"
    out = out + "            elif last == half:\n"
    out = out + "                up = sticky || n[0] % 2 == 1\n"
    out = out + "            if up:\n"
    out = out + "                let one: buf<int> = new_buf(int, 48)\n"
    out = out + "                __cf_bn_set(&one, 1, 48)\n"
    out = out + "                __cf_bn_add(&n, &one, 48)\n"
    out = out + "    let digits: buf<int> = new_buf(int, 400)\n"
    out = out + "    let cnt = 0\n"
    out = out + "    while !__cf_bn_is_zero(&n):\n"
    out = out + "        digits[cnt] = __cf_bn_divsmall(&n, 10)\n"
    out = out + "        cnt += 1\n"
    out = out + "    while cnt < prec + 1:\n"
    out = out + "        digits[cnt] = 0\n"
    out = out + "        cnt += 1\n"
    out = out + "    let out = sign\n"
    out = out + "    let i = cnt - 1\n"
    out = out + "    while i >= 0:\n"
    out = out + "        out = out + __cf_ch(48 + digits[i])\n"
    out = out + "        if i == prec && prec > 0:\n"
    out = out + "            out = out + \".\"\n"
    out = out + "        i -= 1\n"
    out = out + "    return out\n"
    return out

use system, fflush, access in libc of c

/#/ Says which node the lowering could not handle: its kind, line, and the text of its token.
fn report_unsupported(a: &Ast, n: int) => void:
    let tk = a.tok[n]
    say(f"unsupported: node kind {a.kind[n]} at line {a.toks.line[tk]}, near '")
    let k = 0
    for i in a.toks.start[tk]..a.toks.end[tk]:
        if k < 40:
            say_byte(a.byte_at(i))
        k = k + 1
    say("'\n")
    fflush(0)

/#/ The machine-code object of `src` through our front end and IR, the optimizer on or off;
/#/ empty when it did not lower.
fn build_src(src: str, opt: int) => Txt:
    return build_obj(src, opt, "")

/#/ Like `build_src`, with the text of the program's own `.cfc` files (empty for none).
fn build_obj(src: str, opt: int, cfc: str) => Txt:
    return build_bytes(bytes_of_str(&src), len(src), opt, cfc)

/#/ Like `build_obj`, for the program text in `text`.
fn build_txt(text: &Txt, opt: int, cfc: str) => Txt:
    return build_bytes(copy_bytes(&text.b, text.n), text.n, opt, cfc)

/#/ The first `size` bytes of `b`, in a buffer of their own.
fn copy_bytes(b: &buf<int>, size: int) => buf<int>:
    let r: buf<int> = new_buf(int, size + 1)
    for q in 0..size:
        r[q] = b[q]
    return r

/#/ Like `build_obj`, for the `size` bytes in `bytes`.
fn build_bytes(bytes: buf<int>, size: int, opt: int, cfc: str) => Txt:
    if prints_numbers(&bytes, size):
        let text = fmt_rt_text()
        let rt = bytes_of_str(&text)
        let rn = len(text)
        let both: buf<int> = new_buf(int, size + rn + 2)
        for q in 0..size:
            both[q] = bytes[q]
        both[size] = 10
        for q in 0..rn:
            both[size + 1 + q] = rt[q]
        return build_text(both, size + rn + 1, opt, cfc)
    return build_text(bytes, size, opt, cfc)

fn build_text(bytes: buf<int>, size: int, opt: int, cfc: str) => Txt:
    let t = new_tys()
    let g = new_globals()
    let lw = module_of(bytes, size, opt, cfc, &t, &g)
    if lw.bad > 0:
        return new_txt()
    lw.generate()
    lw.emit_glue(&t, &g)
    if lw.ver_err > 0:
        say(f"verifier: {lw.ver_err} functions with findings\n")
        fflush(0)
        return new_txt()
    if lw.mc_err > 0:
        say(f"machine code: {lw.mc_err} functions could not be translated\n")
        fflush(0)
        return new_txt()
    return lw.object()

/#/ Does `src` have an f-string, and not the number-formatting runtime (`fmt_rt_text`) itself? Then
/#/ the runtime is appended; the linker drops what the program does not reach. Only the lexer runs.
fn prints_numbers(bytes: &buf<int>, size: int) => bool:
    let tk = lex_bytes(bytes, size)
    let any = false
    let want = "__cf_fmt_int"
    for n in 0..tk.count:
        if tk.kind[n] == int(Tk.FStr):
            any = true
        if tk.kind[n] == int(Tk.Ident) && tk.end[n] - tk.start[n] == len(want):
            let same = true
            for q in 0..len(want):
                if bytes[tk.start[n] + q] != want[q]:
                    same = false
            if same:
                return false
    return any

/#/ The number of the first parse error: 1 for a character or `//` comment, 3 for a missing
/#/ colon or indent, 110 for `copy`, else 2.
fn parse_number(a: &Ast) => int:
    let t = a.err_tok[0]
    if a.toks.kind[t] == int(Tk.Error) || a.toks.kind[t] == int(Tk.SlashSlash):
        return 1
    for back in 0..3:
        if t - back >= 0 && a.toks.kind[t - back] == int(Tk.KwCopy):
            return 110
    let c = a.err_code[0]
    if c == int(Ec.ExpectedColon) || c == int(Ec.ExpectedIndent):
        return 3
    return 2

/#/ What the front end says about `src`: -1 for nothing, 0 for a parse error, else the number of the
/#/ first scope, type or ownership finding.
fn first_error(src: str) => int:
    let t = new_tys()
    let g = new_globals()
    let a = parse(src)
    if a.err_count > 0:
        return parse_number(&a)
    let m = declare_module(&g, &a, "t")
    let sc = check(&a, &g, m)
    for k in 0..sc.diags.n:
        if !sc_is_warning(sc.diags.code[k]):
            return sc_number(sc.diags.code[k])
    declare_types(&t, &g, &a, m)
    let ty = check_types(&t, &g, &a, m)
    if ty.diags.n > 0:
        return te_number(ty.diags.code[0])
    let fl = check_own(&t, &g, &a, &ty)
    if fl.diags.n > 0:
        return oe_number(fl.diags.code[0])
    return 0 - 1

/#/ A program through the front end: its tree and types, ready to be lowered; `ok` is false when
/#/ the front end refused it (it has said why).
class Prep:
    a: Ast
    ty: Typer
    ok: bool

/#/ Runs the front end over the `size` bytes in `bytes`.
fn prepare(bytes: buf<int>, size: int, cfc: str, t: &Tys, g: &Syms) => Prep:
    return prepare_ast(parse_bytes(bytes, size), cfc, t, g)

/#/ `prepare` for a tree that is already parsed (the caller may have blanked function bodies it
/#/ does not need checked: a function with no body is a declaration).
fn prepare_ast(a: Ast, cfc: str, t: &Tys, g: &Syms) => Prep:
    if len(cfc) > 0:
        declare_user_cfc(t, g, cfc, "user.cfc")
    let m = declare_module(g, &a, "t")
    let sc = check(&a, g, m)
    declare_types(t, g, &a, m)
    let ty = check_types(t, g, &a, m)
    let fl = check_own(t, g, &a, &ty)
    let ok = true
    if sc.diags.errors() > 0 || ty.diags.n > 0 || a.err_count > 0 || fl.diags.n > 0:
        say(f"front end: {sc.diags.errors()} scope errors, {ty.diags.n} type findings, {fl.diags.n} ownership findings, {a.err_count} parse errors\n")
        for k in 0..a.err_count:
            if k < 20:
                say(f"  parse error {a.err_code[k]} at line {a.toks.line[a.err_tok[k]]}\n")
        for k in 0..sc.diags.n:
            if k < 20 && !sc_is_warning(sc.diags.code[k]):
                say(f"  scope error E{sc_number(sc.diags.code[k])} at line {a.toks.line[sc.diags.tok[k]]}\n")
        for k in 0..ty.diags.n:
            if k < 20:
                say(f"  type finding E{te_number(ty.diags.code[k])} at line {a.toks.line[ty.diags.tok[k]]}\n")
        for k in 0..fl.diags.n:
            if k < 20:
                say(f"  ownership finding E{oe_number(fl.diags.code[k])} at line {a.toks.line[fl.diags.tok[k]]}\n")
        fflush(0)
        ok = false
    return Prep { a: a, ty: ty, ok: ok }

/#/ The functions of a prepared program lowered and optimized, not yet generated. With `only` >= 0
/#/ just the top-level items whose `unit[node]` is `only` are lowered (the rest are called by name from
/#/ other objects), and the names the compiler makes end in `tag`.
fn lower_prepared(p: &Prep, t: &Tys, g: &Syms, opt: int, only: int, unit: &buf<int>, tag: &str, ext: &buf<int>) => Lower:
    let lw = new_lower()
    lw.opt = opt
    lw.lib.reserve(p.a.toks.count * 4)
    lw.tag.put(tag)
    let body = new_txt()
    let it = p.a.child[p.a.root]
    while it >= 0:
        /#/ small functions of other files are lowered too (`ext[node]` is 1), for the optimizer to
        /#/ inline; they are not generated here, their own file has them
        let other = only >= 0 && unit[it] != only
        if p.a.kind[it] == int(Nk.Fn) && type_param_count(&p.a, it) == 0:
            if !other || ext[it] == 1:
                lw.ext_mode = other
                lw.function(t, g, &p.ty, &p.a, it, -1)
                if lw.bad > 0:
                    report_unsupported(&p.a, lw.bad_node)
                    return lw
                lw.keep_current()
                lw.ext_mode = false
        elif p.a.kind[it] == int(Nk.Class) && type_param_count(&p.a, it) == 0:
            let row = g.find_in_module(&p.a, p.a.pa[it], p.ty.cur)
            let c = p.a.child[it]
            while c >= 0:
                if p.a.kind[c] == int(Nk.Fn) && (!other || ext[c] == 1):
                    lw.ext_mode = other
                    lw.function(t, g, &p.ty, &p.a, c, row)
                    if lw.bad > 0:
                        report_unsupported(&p.a, lw.bad_node)
                        return lw
                    lw.keep_current()
                    lw.ext_mode = false
                c = p.a.next[c]
        it = p.a.next[it]
    lw.run_instances(t, g, &p.ty, &p.a, &body)
    if lw.bad > 0:
        report_unsupported(&p.a, lw.bad_node)
        return lw
    lw.emit_glue(t, g)
    lw.optimize_module()
    return lw

/#/ The module of `src` lowered and optimized, not yet generated; `bad` is set when the front
/#/ end or the lowering refused it.
fn module_of(bytes: buf<int>, size: int, opt: int, cfc: str, t: &Tys, g: &Syms) => Lower:
    let p = prepare(bytes, size, cfc, t, g)
    if !p.ok:
        let lw = new_lower()
        lw.bad = 1
        return lw
    let none: buf<int> = new_buf(int, 1)
    let lw = lower_prepared(&p, t, g, opt, -1, &none, "", &none)
    let has_main = false
    let it = p.a.child[p.a.root]
    while it >= 0:
        if p.a.kind[it] == int(Nk.Fn) && p.a.pa[it] >= 0 && tok_is(&p.a, p.a.pa[it], "main"):
            has_main = true
        it = p.a.next[it]
    if lw.bad == 0 && !has_main:
        lw.declare_globals(t, g, &p.ty, &p.a)
    return lw

/#/ Compiles `src` through our front end and IR, with clang as the linker, and runs it: the exit
/#/ code, or -2 when something did not compile.
fn run_src(src: str, leaks: bool) => int:
    let o = build_src(src, 1)
    if o.n == 0:
        return -2
    return run_object(&o, leaks)

/#/ The number of instructions in the function `name` of the module of `src`.
fn lowered_lines(src: str, opt: int, name: str) => int:
    let t = new_tys()
    let g = new_globals()
    let lw = module_of(bytes_of_str(&src), len(src), opt, "", &t, &g)
    let w = new_txt()
    w.put(&name)
    let k = lw.lib.find(lw.names.find(&w))
    if k < 0:
        return -1
    let f = new_fun("", 0)
    lw.lib.restore(k, &f)
    let n = 0
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            n = n + 1
            i = f.nx[i]
    return n

/#/ The calls to the function `name` in the module of `src`, in all its functions.
fn calls_of(src: str, opt: int, name: str) => int:
    let t = new_tys()
    let g = new_globals()
    let lw = module_of(bytes_of_str(&src), len(src), opt, "", &t, &g)
    let w = new_txt()
    w.put(&name)
    let id = lw.names.find(&w)
    let f = new_fun("", 0)
    let n = 0
    for k in 0..lw.lib.nf:
        lw.lib.restore(k, &f)
        for b in 0..f.nb:
            let i = f.bfirst[b]
            while i >= 0:
                if f.op[i] == int(Op.Call) && f.aux[i] == id:
                    n = n + 1
                i = f.nx[i]
    return n

/#/ The effect summary of the function `name` in the module of `src`, -1 when it is not there.
fn effects_of(src: str, opt: int, name: str) => int:
    let t = new_tys()
    let g = new_globals()
    let lw = module_of(bytes_of_str(&src), len(src), opt, "", &t, &g)
    let w = new_txt()
    w.put(&name)
    let k = lw.lib.find(lw.names.find(&w))
    if k < 0:
        return -1
    return lw.lib.f_fx[k]

/#/ An object file, linked by clang with the address sanitizer, run.
fn run_object(o: &Txt, leaks: bool) => int:
    save_bytes("ir_lower_test.o", o)
    if system("clang -w -fsanitize=address -o ./ir_lower_test ir_lower_test.o -lm") != 0:
        return -1
    let cmd = "ASAN_OPTIONS=exitcode=99:detect_leaks=1 ./ir_lower_test 2>ir_lower_err"
    if !leaks:
        cmd = "ASAN_OPTIONS=exitcode=99:detect_leaks=0 ./ir_lower_test 2>ir_lower_err"
    let st = system(cmd)
    return (st >> 8) & 255

fn expect_exit(src: str, want: int) => int:
    return expect_with(src, want, true)

/#/ Like `expect_exit` for programs that stop early (a failed bounds check) and so leave
/#/ their memory behind.
fn expect_exit_early(src: str, want: int) => int:
    return expect_with(src, want, false)

fn expect_with(src: str, want: int, leaks: bool) => int:
    let dup = clone src
    let r = run_src(src, leaks)
    if r != want:
        say(f"FAIL: got {r}, want {want}\n{dup}\n")
        fflush(0)
        return 1
    return 0

/#/ Like `expect_exit`.
fn expect_mc(src: str, want: int) => int:
    return expect_mc_with(src, want, true)

/#/ Like `expect_exit_early`.
fn expect_mc_early(src: str, want: int) => int:
    return expect_mc_with(src, want, false)

fn expect_mc_with(src: str, want: int, leaks: bool) => int:
    let dup = clone src
    let o = build_src(src, 1)
    if o.n == 0:
        say(f"FAIL: no object for\n{dup}\n")
        fflush(0)
        return 1
    let r = run_object(&o, leaks)
    if r != want:
        say(f"FAIL (machine code): got {r}, want {want}\n{dup}\n")
        fflush(0)
        return 1
    return 0

/#/ The `.cir` of a program: the program, the number-formatting runtime when it prints numbers, and
/#/ the runtime of `rt/src/min.cf` lowered together as one module, so the image needs nothing from
/#/ outside but system calls.
/#/ The IR object (`.cir`): a lowered module written as bytes and read back, so a backend that
/#/ has no front end can generate code from it. The format is in docs/reference/ir-object.md.
/#/
/#/ `write_cir` takes the functions of a `Lower` as they are in its `Lib` (those of other files,
/#/ kept only for inlining, are left out); `read_cir` fills a fresh `Lower` with them, after which
/#/ `generate` and `object` work as if the front end had run.


/#/ error codes of `read_cir`
fn cir_bad_magic() => int:
    return 1

fn cir_bad_sum() => int:
    return 2

fn cir_bad_section() => int:
    return 3

fn cir_bad_range() => int:
    return 4

/#/ ---- writing -------------------------------------------------------------

/#/ `v` as a zigzag number in 7-bit groups, low group first, the top bit set while more follow.
fn put_var(t: &Txt, v: int) => void:
    let u = (v << 1) ^ (v >> 63)
    while true:
        let low = u & 127
        u = (u >> 7) & 144115188075855871
        if u == 0:
            t.put_byte(low)
            return
        t.put_byte(low | 128)

fn put_u32(t: &Txt, v: int) => void:
    for k in 0..4:
        t.put_byte((v >> (8 * k)) & 255)

fn put_tag(t: &Txt, s: &str) => void:
    for k in 0..4:
        t.put_byte(ch(s, k))

/#/ `n` values of `c` from `from`: mode 0 as they are, 1 minus their own index, 2 minus the one before.
fn put_col(t: &Txt, c: &buf<int>, from: int, n: int, mode: int) => void:
    let prev = 0
    for k in 0..n:
        let v = c[from + k]
        if mode == 1:
            put_var(t, v - k)
        elif mode == 2:
            put_var(t, v - prev)
            prev = v
        else:
            put_var(t, v)

fn fnv(t: &Txt, from: int) => int:
    let h = 2166136261
    for k in from..t.n:
        h = ((h ^ t.b[k]) * 16777619) & 4294967295
    return h

fn put_names(t: &Txt, nm: &Names) => void:
    put_var(t, nm.cnt)
    for id in 0..nm.cnt:
        put_var(t, nm.off[id + 1] - nm.off[id])
        for k in nm.off[id]..nm.off[id + 1]:
            t.put_byte(nm.b[k])

fn put_reps(t: &Txt, rs: &Reps) => void:
    put_var(t, rs.n)
    for r in 0..rs.n:
        put_var(t, rs.count[r])
        for k in 0..rs.count[r]:
            put_var(t, rs.pool[rs.start[r] + k])

fn put_funs(t: &Txt, lw: &Lower) => void:
    let lib = &lw.lib
    let count = 0
    for n in 0..lib.nf:
        if lw.ext_slot[n] == 0:
            count = count + 1
    put_var(t, count)
    for n in 0..lib.nf:
        if lw.ext_slot[n] != 0:
            continue
        put_var(t, lib.f_id[n] + 1)
        put_var(t, lib.f_ret[n])
        put_var(t, lib.f_ni[n])
        put_var(t, lib.f_nb[n])
        put_var(t, lib.f_ne[n])
        put_var(t, lib.f_np[n])
        put_var(t, lib.f_nn[n])
        put_col(t, &lib.nm, lib.f_n0[n], lib.f_nn[n], 0)
        let i0 = lib.f_i0[n]
        let ni = lib.f_ni[n]
        put_col(t, &lib.op, i0, ni, 0)
        put_col(t, &lib.rep, i0, ni, 0)
        put_col(t, &lib.ty, i0, ni, 0)
        put_col(t, &lib.a, i0, ni, 0)
        put_col(t, &lib.b, i0, ni, 0)
        put_col(t, &lib.c, i0, ni, 0)
        put_col(t, &lib.aux, i0, ni, 0)
        put_col(t, &lib.nx, i0, ni, 1)
        put_col(t, &lib.pv, i0, ni, 1)
        put_col(t, &lib.uses, i0, ni, 0)
        put_col(t, &lib.ln, i0, ni, 2)
        put_col(t, &lib.fwd, i0, ni, 0)
        put_col(t, &lib.blk, i0, ni, 2)
        let b0 = lib.f_b0[n]
        let nb = lib.f_nb[n]
        put_col(t, &lib.bfirst, b0, nb, 0)
        put_col(t, &lib.blast, b0, nb, 0)
        put_col(t, &lib.pfirst, b0, nb, 0)
        put_col(t, &lib.plast, b0, nb, 0)
        put_col(t, &lib.npar, b0, nb, 0)
        let e0 = lib.f_e0[n]
        let ne = lib.f_ne[n]
        put_col(t, &lib.efrom, e0, ne, 0)
        put_col(t, &lib.eto, e0, ne, 0)
        put_col(t, &lib.eargs, e0, ne, 0)
        put_col(t, &lib.eargn, e0, ne, 0)
        put_col(t, &lib.pool, lib.f_p0[n], lib.f_np[n], 0)

/#/ The module of `lw` as a `.cir` file; `flags` bit 0 says the IR was optimized.
fn write_cir(lw: &Lower, flags: int) => Txt:
    let s_nm = new_txt()
    put_names(&s_nm, &lw.names)
    let s_rp = new_txt()
    put_reps(&s_rp, &lw.rs)
    let s_st = new_txt()
    put_var(&s_st, lw.sbytes.n)
    s_st.put_all(&lw.sbytes)
    let s_gl = new_txt()
    put_var(&s_gl, lw.gl_n)
    for k in 0..lw.gl_n:
        put_var(&s_gl, lw.gl_name[k])
        put_var(&s_gl, lw.gl_size[k])
    let s_fu = new_txt()
    put_funs(&s_fu, lw)
    let body = new_txt()
    body.put_all(&s_nm)
    body.put_all(&s_rp)
    body.put_all(&s_st)
    body.put_all(&s_gl)
    body.put_all(&s_fu)
    let out = new_txt()
    put_tag(&out, "CIR1")
    put_var(&out, flags)
    put_var(&out, 5)
    put_tag(&out, "NAME")
    put_var(&out, s_nm.n)
    put_tag(&out, "REPS")
    put_var(&out, s_rp.n)
    put_tag(&out, "STRS")
    put_var(&out, s_st.n)
    put_tag(&out, "GLOB")
    put_var(&out, s_gl.n)
    put_tag(&out, "FUNS")
    put_var(&out, s_fu.n)
    put_u32(&out, fnv(&body, 0))
    out.put_all(&body)
    return out

/#/ ---- reading -------------------------------------------------------------

/#/ A position in the bytes, inside `[at, end)`; `bad` is set when a read went outside.
class Rd:
    at: int
    end: int
    bad: int

    fn byte(self, t: &Txt) => int:
        if self.at >= self.end:
            self.bad = 1
            return 0
        let v = t.b[self.at]
        self.at = self.at + 1
        return v

    fn var(self, t: &Txt) => int:
        /#/ most values are one byte
        if self.at < self.end:
            let b0 = t.b[self.at]
            if b0 < 128:
                self.at = self.at + 1
                return (b0 >> 1) ^ (0 - (b0 & 1))
        let u = 0
        let sh = 0
        while true:
            let b = self.byte(t)
            if self.bad != 0:
                return 0
            if sh < 64:
                u = u | ((b & 127) << sh)
            if b < 128:
                break
            sh = sh + 7
            if sh > 70:
                self.bad = 1
                return 0
        return ((u >> 1) & 9223372036854775807) ^ (0 - (u & 1))

    fn left(self) => int:
        return self.end - self.at

    /#/ A count that `each` bytes per item at least must fit in what is left.
    fn count(self, t: &Txt, each: int) => int:
        let n = self.var(t)
        if n < 0 || n * each > self.left():
            self.bad = 1
            return 0
        return n

fn get_u32(t: &Txt, at: int) => int:
    let v = 0
    for k in 0..4:
        v = v | (t.b[at + k] << (8 * k))
    return v

fn tag_of(t: &Txt, at: int) => int:
    return get_u32(t, at)

fn tag_val(s: &str) => int:
    let v = 0
    for k in 0..4:
        v = v | (ch(s, k) << (8 * k))
    return v

/#/ Reads `n` values into `c` from `to`; the inverse of `put_col`.
fn get_col(r: &Rd, t: &Txt, c: &buf<int>, to: int, n: int, mode: int) => void:
    let prev = 0
    for k in 0..n:
        let v = 0
        if r.at < r.end && t.b[r.at] < 128:
            /#/ one byte, the usual case, without the call
            let b0 = t.b[r.at]
            r.at = r.at + 1
            v = (b0 >> 1) ^ (0 - (b0 & 1))
        else:
            v = r.var(t)
        if mode == 1:
            v = v + k
        elif mode == 2:
            v = v + prev
            prev = v
        c[to + k] = v

/#/ Are the `n` values of `c` from `from` each in `lo..hi`?
fn in_range(c: &buf<int>, from: int, n: int, lo: int, hi: int) => bool:
    for k in 0..n:
        let v = c[from + k]
        if v < lo || v >= hi:
            return false
    return true

/#/ Do the instructions on the block chains (the rest are dead and may hold anything) belong to a
/#/ block of the function, and do the chains end?
fn chains_ok(lib: &Lib, i0: int, ni: int, b0: int, nb: int) => bool:
    for b in 0..nb:
        let i = lib.bfirst[b0 + b]
        let steps = 0
        while i >= 0:
            steps = steps + 1
            if steps > ni || lib.blk[i0 + i] < 0 || lib.blk[i0 + i] >= nb:
                return false
            i = lib.nx[i0 + i]
    return true

fn get_funs(r: &Rd, t: &Txt, lw: &Lower, nnames: int, nreps: int) => int:
    let count = r.count(t, 7)
    if r.bad != 0:
        return cir_bad_section()
    for q in 0..count:
        let id = r.var(t) - 1
        let ret = r.var(t)
        let ni = r.count(t, 12)
        let nb = r.count(t, 5)
        let ne = r.count(t, 4)
        let np = r.count(t, 1)
        let nn = r.count(t, 1)
        if r.bad != 0:
            return cir_bad_section()
        if id < -1 || id >= nnames || ret < 0 || ret >= 8 + nreps:
            return cir_bad_range()
        let lib = &lw.lib
        lib.grow_cols(ni, nb, ne, np, nn)
        lib.grow_table()
        let n = lib.nf
        lib.nf = lib.nf + 1
        lib.f_fx[n] = 0
        lib.f_done[n] = 0
        lib.f_nc[n] = 0
        lib.f_i0[n] = lib.ni
        lib.f_ni[n] = ni
        lib.f_b0[n] = lib.nb
        lib.f_nb[n] = nb
        lib.f_e0[n] = lib.ne
        lib.f_ne[n] = ne
        lib.f_p0[n] = lib.np
        lib.f_np[n] = np
        lib.f_n0[n] = lib.nmn
        lib.f_nn[n] = nn
        lib.f_ret[n] = ret
        lib.f_id[n] = id
        get_col(r, t, &lib.nm, lib.nmn, nn, 0)
        let i0 = lib.ni
        get_col(r, t, &lib.op, i0, ni, 0)
        get_col(r, t, &lib.rep, i0, ni, 0)
        get_col(r, t, &lib.ty, i0, ni, 0)
        get_col(r, t, &lib.a, i0, ni, 0)
        get_col(r, t, &lib.b, i0, ni, 0)
        get_col(r, t, &lib.c, i0, ni, 0)
        get_col(r, t, &lib.aux, i0, ni, 0)
        get_col(r, t, &lib.nx, i0, ni, 1)
        get_col(r, t, &lib.pv, i0, ni, 1)
        get_col(r, t, &lib.uses, i0, ni, 0)
        get_col(r, t, &lib.ln, i0, ni, 2)
        get_col(r, t, &lib.fwd, i0, ni, 0)
        get_col(r, t, &lib.blk, i0, ni, 2)
        let b0 = lib.nb
        get_col(r, t, &lib.bfirst, b0, nb, 0)
        get_col(r, t, &lib.blast, b0, nb, 0)
        get_col(r, t, &lib.pfirst, b0, nb, 0)
        get_col(r, t, &lib.plast, b0, nb, 0)
        get_col(r, t, &lib.npar, b0, nb, 0)
        let e0 = lib.ne
        get_col(r, t, &lib.efrom, e0, ne, 0)
        get_col(r, t, &lib.eto, e0, ne, 0)
        get_col(r, t, &lib.eargs, e0, ne, 0)
        get_col(r, t, &lib.eargn, e0, ne, 0)
        get_col(r, t, &lib.pool, lib.np, np, 0)
        if r.bad != 0:
            return cir_bad_section()
        /#/ links and blocks stay inside the function; the rest is the verifier's to check
        let ok = in_range(&lib.nx, i0, ni, -1, ni) && in_range(&lib.pv, i0, ni, -1, ni) && chains_ok(lib, i0, ni, b0, nb) && in_range(&lib.bfirst, b0, nb, -1, ni) && in_range(&lib.blast, b0, nb, -1, ni) && in_range(&lib.efrom, e0, ne, -1, nb) && in_range(&lib.eto, e0, ne, -1, nb)
        if !ok:
            return cir_bad_range()
        lib.ni = lib.ni + ni
        lib.nb = lib.nb + nb
        lib.ne = lib.ne + ne
        lib.np = lib.np + np
        lib.nmn = lib.nmn + nn
        if n >= len(lw.ext_slot):
            lw.ext_slot = buf_resize(lw.ext_slot, (n + 1) * 2)
        lw.ext_slot[n] = 0
    return 0

/#/ Puts the module in `t` into `lw`, a fresh `Lower`. 0 when it read, else an error code.
fn read_cir(t: &Txt, lw: &Lower) => int:
    if t.n < 8 || tag_of(t, 0) != tag_val("CIR1"):
        return cir_bad_magic()
    let h = Rd { at: 4, end: t.n, bad: 0 }
    let flags = h.var(t)
    let nsec = h.count(t, 5)
    if h.bad != 0 || nsec != 5:
        return cir_bad_section()
    let tags: buf<int> = new_buf(int, 5)
    let lens: buf<int> = new_buf(int, 5)
    let total = 0
    for k in 0..5:
        if h.left() < 5:
            return cir_bad_section()
        tags[k] = tag_of(t, h.at)
        h.at = h.at + 4
        lens[k] = h.var(t)
        if h.bad != 0 || lens[k] < 0:
            return cir_bad_section()
        total = total + lens[k]
    if h.left() != total + 4:
        return cir_bad_section()
    if get_u32(t, h.at) != fnv(t, h.at + 4):
        return cir_bad_sum()
    let at = h.at + 4
    let want = new_buf(int, 5)
    want[0] = tag_val("NAME")
    want[1] = tag_val("REPS")
    want[2] = tag_val("STRS")
    want[3] = tag_val("GLOB")
    want[4] = tag_val("FUNS")
    let from: buf<int> = new_buf(int, 5)
    for k in 0..5:
        if tags[k] != want[k]:
            return cir_bad_section()
        from[k] = at
        at = at + lens[k]
    /#/ names
    let r = Rd { at: from[0], end: from[0] + lens[0], bad: 0 }
    let nnames = r.count(t, 1)
    lw.names = new_names()
    for q in 0..nnames:
        let nl = r.count(t, 1)
        let w = new_txt()
        for k in 0..nl:
            w.put_byte(r.byte(t))
        if r.bad != 0:
            return cir_bad_section()
        lw.names.add_bytes(&w)
    if r.at != r.end:
        return cir_bad_section()
    /#/ aggregate representations
    r = Rd { at: from[1], end: from[1] + lens[1], bad: 0 }
    let nreps = r.count(t, 1)
    lw.rs = new_reps()
    for q in 0..nreps:
        let ik = r.count(t, 1)
        let items: buf<int> = new_buf(int, ik + 1)
        for ie in 0..ik:
            items[ie] = r.var(t)
            if items[ie] < 0 || items[ie] >= 8 + q:
                return cir_bad_range()
        if r.bad != 0:
            return cir_bad_section()
        if lw.rs.agg(&items, ik) != 8 + q:
            return cir_bad_range()
    if r.at != r.end:
        return cir_bad_section()
    /#/ strings: each is an 8-byte length, the text and a NUL
    r = Rd { at: from[2], end: from[2] + lens[2], bad: 0 }
    let slen = r.count(t, 1)
    if r.bad != 0:
        return cir_bad_section()
    lw.sbytes = new_txt()
    for q in 0..slen:
        lw.sbytes.put_byte(r.byte(t))
    let off = 0
    while off < slen:
        if off + 9 > slen:
            return cir_bad_range()
        let sl = 0
        for sb in 0..8:
            sl = sl | (lw.sbytes.b[off + sb] << (8 * sb))
        if sl < 0 || off + 9 + sl > slen:
            return cir_bad_range()
        lw.mc.add_str(off + 8)
        off = off + 9 + sl
    /#/ globals
    r = Rd { at: from[3], end: from[3] + lens[3], bad: 0 }
    let ng = r.count(t, 2)
    lw.gl_name = new_buf(int, ng + 1)
    lw.gl_size = new_buf(int, ng + 1)
    for k in 0..ng:
        lw.gl_name[k] = r.var(t)
        lw.gl_size[k] = r.var(t)
        if r.bad != 0 || lw.gl_name[k] < 0 || lw.gl_name[k] >= nnames || lw.gl_size[k] < 0:
            return cir_bad_range()
    lw.gl_n = ng
    if r.at != r.end:
        return cir_bad_section()
    /#/ functions
    r = Rd { at: from[4], end: from[4] + lens[4], bad: 0 }
    let fe = get_funs(&r, t, lw, nnames, nreps)
    if fe != 0:
        return fe
    if r.at != r.end:
        return cir_bad_section()
    lw.opt = flags & 1
    return 0

/#/ ---- what is reached -----------------------------------------------------

/#/ Marks the function with name number `id` and everything it can reach as wanted in `seen`.
fn reach_from(lw: &Lower, id: int, seen: &buf<int>) => void:
    let lib = &lw.lib
    let work: buf<int> = new_buf(int, lib.nf + 1)
    let nw = 0
    /#/ the function of each name number (`Lib.find` looks through all of them)
    let top = id
    for n in 0..lib.nf:
        if lib.f_id[n] > top:
            top = lib.f_id[n]
    let where_: buf<int> = new_buf(int, top + 2)
    for k in 0..top + 2:
        where_[k] = 0 - 1
    for n in 0..lib.nf:
        if lib.f_id[n] >= 0 && where_[lib.f_id[n]] < 0:
            where_[lib.f_id[n]] = n
    let first = where_[id]
    if first < 0:
        return
    seen[first] = 1
    work[0] = first
    nw = 1
    let mal = lw.names.find(&txt_word("malloc"))
    let fre = lw.names.find(&txt_word("free"))
    let fmo = lw.names.find(&txt_word("fmod"))
    let fmf = lw.names.find(&txt_word("fmodf"))
    while nw > 0:
        nw = nw - 1
        let n = work[nw]
        let i0 = lib.f_i0[n]
        for q in 0..lib.f_ni[n]:
            let op = lib.op[i0 + q]
            let target = -2
            if op == int(Op.Call) || op == int(Op.CCall) || op == int(Op.Drop) || op == int(Op.Clone) || op == int(Op.FnAddr):
                target = lib.aux[i0 + q]
            elif op == int(Op.Alloc):
                target = mal
            elif op == int(Op.Free):
                target = fre
            elif op == int(Op.FRem):
                /#/ one of the two, by the width
                if lib.rep[i0 + q] == int(Rp.F32):
                    target = fmf
                else:
                    target = fmo
            if target >= 0:
                let k = -1
                if target <= top:
                    k = where_[target]
                if k >= 0 && seen[k] == 0:
                    seen[k] = 1
                    work[nw] = k
                    nw = nw + 1

fn txt_word(s: str) => Txt:
    let t = new_txt()
    t.put(&s)
    return t

/#/ Leaves out of the code generated the functions that `main` cannot reach: the runtime comes
/#/ with every module, and a program uses a little of it. Returns how many were left out.
fn prune_unreached(lw: &Lower) => int:
    let seen: buf<int> = new_buf(int, lw.lib.nf + 1)
    let id = lw.names.find(&txt_word("main"))
    if id < 0:
        return 0
    reach_from(lw, id, &seen)
    let dropped = 0
    for n in 0..lw.lib.nf:
        if seen[n] == 0 && lw.ext_slot[n] == 0:
            lw.ext_slot[n] = 1
            dropped = dropped + 1
    return dropped

/#/ The variables and types of a module (`-O0 -g`), as lines in the `.map` beside a `.cir`, so that
/#/ `cfjit --gdb` can give the code it generates the same debug table the ahead-of-time compiler makes:
/#/
/#/     T ...                       a type line, as in `dbgtype.cf`
/#/     G function                  the variables that follow belong to this function
/#/     V name type slot P|L        a parameter or local variable in the slot (an instruction of the function)


/#/ Appends the type lines and the variables of `lw` (which was lowered with `set_debug_vars`) to `out`.
fn put_var_map(lw: &Lower, out: &Txt) => void:
    out.put_all(&lw.mc.dt.out)
    let last = 0 - 1
    for k in 0..lw.dv_n:
        if lw.dv_fn[k] != last:
            last = lw.dv_fn[k]
            out.put("G ")
            lw.names.put(out, last)
            out.put_byte(10)
        out.put("V ")
        let q = lw.dv_nm[k]
        while lw.dv_names.b[q] != 0:
            out.put_byte(lw.dv_names.b[q])
            q = q + 1
        out.put_byte(32)
        out.put_int(lw.dv_tid[k])
        out.put_byte(32)
        out.put_int(lw.dv_slot[k])
        if lw.dv_par[k] == 1:
            out.put(" P\n")
        else:
            out.put(" L\n")

/#/ Reads the lines of `put_var_map` out of `t` (other lines are skipped) into `lw`, which then dumps
/#/ them with the line table; the caller has set `set_debug_vars`.
fn read_var_map(t: &Txt, lw: &Lower) => void:
    let cur = 0 - 1
    let start = 0
    for i in 0..t.n + 1:
        if i < t.n && t.b[i] != 10:
            continue
        if i > start + 2 && t.b[start + 1] == 32:
            let c = t.b[start]
            let body = start + 2
            if c == int('T'):
                for k in start..i + 1:
                    lw.mc.dt.out.put_byte(t.b[k])
            elif c == int('G'):
                let w = new_txt()
                for k in body..i:
                    w.put_byte(t.b[k])
                cur = lw.names.find(&w)
            elif c == int('V') && cur >= 0:
                let a = body
                while a < i && t.b[a] != 32:
                    a = a + 1
                let b = a + 1
                while b < i && t.b[b] != 32:
                    b = b + 1
                let e = b + 1
                while e < i && t.b[e] != 32:
                    e = e + 1
                if lw.dv_n >= len(lw.dv_fn):
                    let cap = (lw.dv_n + 1) * 2
                    lw.dv_fn = buf_resize(lw.dv_fn, cap)
                    lw.dv_tid = buf_resize(lw.dv_tid, cap)
                    lw.dv_slot = buf_resize(lw.dv_slot, cap)
                    lw.dv_par = buf_resize(lw.dv_par, cap)
                    lw.dv_nm = buf_resize(lw.dv_nm, cap)
                lw.dv_fn[lw.dv_n] = cur
                lw.dv_nm[lw.dv_n] = lw.dv_names.n
                for k in body..a:
                    lw.dv_names.put_byte(t.b[k])
                lw.dv_names.put_byte(0)
                lw.dv_tid[lw.dv_n] = var_num(t, a + 1, b)
                lw.dv_slot[lw.dv_n] = var_num(t, b + 1, e)
                lw.dv_par[lw.dv_n] = 0
                if e + 1 < i && t.b[e + 1] == int('P'):
                    lw.dv_par[lw.dv_n] = 1
                lw.dv_n = lw.dv_n + 1
        start = i + 1

fn var_num(t: &Txt, s: int, e: int) => int:
    let neg = false
    let k = s
    if k < e && t.b[k] == 45:
        neg = true
        k = k + 1
    let v = 0
    while k < e:
        v = v * 10 + t.b[k] - 48
        k = k + 1
    if neg:
        return 0 - v
    return v


/#/ GENERATED by rt/gen.sh from rt/src/min.cf: do not edit.
/#/ The C library a `--static` program gets: allocation, copying and system calls, in Coffee.
fn min_rt_text() => str:
    let out = ""
    out = out + "let cf_state: int = 0\n"
    out = out + "let cf_fresh: int = 0\n"
    out = out + "fn cf_mmap(n: int) => int:\n"
    out = out + "    return syscall(9, 0, n, 3, 34, 0 - 1, 0)\n"
    out = out + "fn cf_heap() => int:\n"
    out = out + "    if cf_state == 0:\n"
    out = out + "        cf_state = cf_mmap(4096)\n"
    out = out + "    return cf_state\n"
    out = out + "c fn malloc(n: int) => object:\n"
    out = out + "    let st = cf_heap()\n"
    out = out + "    let sz = 32\n"
    out = out + "    let k = 0\n"
    out = out + "    while sz < n + 16:\n"
    out = out + "        sz = sz * 2\n"
    out = out + "        k = k + 1\n"
    out = out + "    let head = st + 16 + k * 8\n"
    out = out + "    let p = peek64(head as object)\n"
    out = out + "    if p != 0:\n"
    out = out + "        poke64(head as object, peek64((p + 8) as object))\n"
    out = out + "        cf_fresh = 0\n"
    out = out + "        return (p + 16) as object\n"
    out = out + "    cf_fresh = 1\n"
    out = out + "    if sz > 65536:\n"
    out = out + "        p = cf_mmap(sz)\n"
    out = out + "    else:\n"
    out = out + "        let bump = peek64(st as object)\n"
    out = out + "        if bump == 0 || bump + sz > peek64((st + 8) as object):\n"
    out = out + "            bump = cf_mmap(1048576)\n"
    out = out + "            poke64((st + 8) as object, bump + 1048576)\n"
    out = out + "        p = bump\n"
    out = out + "        poke64(st as object, bump + sz)\n"
    out = out + "    poke64(p as object, k)\n"
    out = out + "    return (p + 16) as object\n"
    out = out + "c fn free(ptr: object) => void:\n"
    out = out + "    let q = int(ptr)\n"
    out = out + "    if q == 0:\n"
    out = out + "        return\n"
    out = out + "    let st = cf_heap()\n"
    out = out + "    let p = q - 16\n"
    out = out + "    let head = st + 16 + peek64(p as object) * 8\n"
    out = out + "    poke64((p + 8) as object, peek64(head as object))\n"
    out = out + "    poke64(head as object, p)\n"
    out = out + "c fn memcpy(dst: object, src: object, n: int) => object:\n"
    out = out + "    let d = int(dst)\n"
    out = out + "    let s = int(src)\n"
    out = out + "    let i = 0\n"
    out = out + "    while i + 32 <= n:\n"
    out = out + "        let a = peek64((s + i) as object)\n"
    out = out + "        let b = peek64((s + i + 8) as object)\n"
    out = out + "        let c = peek64((s + i + 16) as object)\n"
    out = out + "        let e = peek64((s + i + 24) as object)\n"
    out = out + "        poke64((d + i) as object, a)\n"
    out = out + "        poke64((d + i + 8) as object, b)\n"
    out = out + "        poke64((d + i + 16) as object, c)\n"
    out = out + "        poke64((d + i + 24) as object, e)\n"
    out = out + "        i = i + 32\n"
    out = out + "    while i + 8 <= n:\n"
    out = out + "        poke64((d + i) as object, peek64((s + i) as object))\n"
    out = out + "        i = i + 8\n"
    out = out + "    if i < n && n >= 8:\n"
    out = out + "        poke64((d + n - 8) as object, peek64((s + n - 8) as object))\n"
    out = out + "        i = n\n"
    out = out + "    while i < n:\n"
    out = out + "        poke8((d + i) as object, peek8((s + i) as object))\n"
    out = out + "        i = i + 1\n"
    out = out + "    return dst\n"
    out = out + "c fn calloc(n: int, m: int) => object:\n"
    out = out + "    let total = n * m\n"
    out = out + "    let p = malloc(total)\n"
    out = out + "    if cf_fresh == 1:\n"
    out = out + "        return p\n"
    out = out + "    let d = int(p)\n"
    out = out + "    let i = 0\n"
    out = out + "    while i + 32 <= total:\n"
    out = out + "        poke64((d + i) as object, 0)\n"
    out = out + "        poke64((d + i + 8) as object, 0)\n"
    out = out + "        poke64((d + i + 16) as object, 0)\n"
    out = out + "        poke64((d + i + 24) as object, 0)\n"
    out = out + "        i = i + 32\n"
    out = out + "    while i + 8 <= total:\n"
    out = out + "        poke64((d + i) as object, 0)\n"
    out = out + "        i = i + 8\n"
    out = out + "    while i < total:\n"
    out = out + "        poke8((d + i) as object, 0)\n"
    out = out + "        i = i + 1\n"
    out = out + "    return p\n"
    out = out + "c fn strlen(s: object) => int:\n"
    out = out + "    let a = int(s)\n"
    out = out + "    let n = 0\n"
    out = out + "    while (a + n) & 7 != 0:\n"
    out = out + "        if peek8((a + n) as object) == 0:\n"
    out = out + "            return n\n"
    out = out + "        n = n + 1\n"
    out = out + "    while true:\n"
    out = out + "        let v = peek64((a + n) as object)\n"
    out = out + "        if (v - 72340172838076673) & (0 - 1 - v) & (0 - 9187201950435737472) != 0:\n"
    out = out + "            break\n"
    out = out + "        n = n + 8\n"
    out = out + "    while peek8((a + n) as object) != 0:\n"
    out = out + "        n = n + 1\n"
    out = out + "    return n\n"
    out = out + "c fn strdup(s: object) => object:\n"
    out = out + "    let n = strlen(s)\n"
    out = out + "    let p = malloc(n + 1)\n"
    out = out + "    memcpy(p, s, n + 1)\n"
    out = out + "    return p\n"
    out = out + "c fn strcmp(x: object, y: object) => int(4)+:\n"
    out = out + "    let a = int(x)\n"
    out = out + "    let b = int(y)\n"
    out = out + "    let i = 0\n"
    out = out + "    while peek8((a + i) as object) != 0 && peek8((a + i) as object) == peek8((b + i) as object):\n"
    out = out + "        i = i + 1\n"
    out = out + "    return i32(peek8((a + i) as object) - peek8((b + i) as object))\n"
    out = out + "c fn write(fd: int(4)+, p: object, n: int) => int:\n"
    out = out + "    return syscall(1, int(fd), int(p), n)\n"
    out = out + "c fn exit(code: int(4)+) => void:\n"
    out = out + "    syscall(231, int(code))\n"
    out = out + "c fn open(path: object, flags: int, mode: int) => int(4)+:\n"
    out = out + "    return i32(syscall(2, int(path), flags, mode))\n"
    out = out + "c fn read(fd: int, p: object, n: int) => int(4)+:\n"
    out = out + "    return i32(syscall(0, fd, int(p), n))\n"
    out = out + "c fn close(fd: int) => int(4)+:\n"
    out = out + "    return i32(syscall(3, fd))\n"
    out = out + "c fn remove(path: object) => int(4)+:\n"
    out = out + "    return i32(syscall(87, int(path)))\n"
    out = out + "c fn access(path: object, mode: int) => int(4)+:\n"
    out = out + "    return i32(syscall(21, int(path), mode))\n"
    out = out + "c fn chmod(path: object, mode: int) => int(4)+:\n"
    out = out + "    return i32(syscall(90, int(path), mode))\n"
    out = out + "c fn clock_gettime(clk: int, ts: object) => int(4)+:\n"
    out = out + "    return i32(syscall(228, clk, int(ts)))\n"
    out = out + "c fn fork() => int(4)+:\n"
    out = out + "    return i32(syscall(57))\n"
    out = out + "c fn waitpid(pid: int, status: object, opts: int) => int(4)+:\n"
    out = out + "    return i32(syscall(61, pid, int(status), opts, 0))\n"
    out = out + "c fn _exit(code: int) => void:\n"
    out = out + "    syscall(231, code)\n"
    out = out + "c fn execve(path: object, argv: int, envp: int) => int(4)+:\n"
    out = out + "    return i32(syscall(59, int(path), argv, envp))\n"
    out = out + "c fn fflush(f: object) => int(4)+:\n"
    out = out + "    return 0\n"
    out = out + "fn cf_environ() => int:\n"
    out = out + "    let buf = cf_mmap(262144)\n"
    out = out + "    let fd = int(open(\"/proc/self/environ\" as object, 0, 0))\n"
    out = out + "    let n = 0\n"
    out = out + "    if fd >= 0:\n"
    out = out + "        n = int(read(fd, buf as object, 262000))\n"
    out = out + "        close(fd)\n"
    out = out + "    if n < 0:\n"
    out = out + "        n = 0\n"
    out = out + "    let count = 0\n"
    out = out + "    for i in 0..n:\n"
    out = out + "        if peek8((buf + i) as object) == 0:\n"
    out = out + "            count = count + 1\n"
    out = out + "    let envp = int(malloc((count + 1) * 8))\n"
    out = out + "    let k = 0\n"
    out = out + "    let start = 0\n"
    out = out + "    for i in 0..n:\n"
    out = out + "        if peek8((buf + i) as object) == 0:\n"
    out = out + "            poke64((envp + k * 8) as object, buf + start)\n"
    out = out + "            k = k + 1\n"
    out = out + "            start = i + 1\n"
    out = out + "    poke64((envp + k * 8) as object, 0)\n"
    out = out + "    return envp\n"
    out = out + "c fn system(command: object) => int(4)+:\n"
    out = out + "    let pid = syscall(57)\n"
    out = out + "    if pid < 0:\n"
    out = out + "        return i32(0 - 1)\n"
    out = out + "    if pid == 0:\n"
    out = out + "        let argv = int(malloc(32))\n"
    out = out + "        poke64(argv as object, int(\"sh\" as object))\n"
    out = out + "        poke64((argv + 8) as object, int(\"-c\" as object))\n"
    out = out + "        poke64((argv + 16) as object, int(command))\n"
    out = out + "        poke64((argv + 24) as object, 0)\n"
    out = out + "        execve(\"/bin/sh\" as object, argv, cf_environ())\n"
    out = out + "        syscall(231, 127)\n"
    out = out + "    let st = int(malloc(16))\n"
    out = out + "    poke64(st as object, 0)\n"
    out = out + "    syscall(61, pid, st, 0, 0)\n"
    out = out + "    return i32(peek64(st as object) & 4294967295)\n"
    return out



/#/ The `.cir` file of the `size` bytes in `bytes`; empty when the front end refused them.
fn build_cir(bytes: buf<int>, size: int, opt: int, cfc: str) => Txt:
    let none = new_txt()
    return build_cir_map(bytes, size, opt, cfc, &none)

/#/ Like `build_cir`; the variables and types of a module lowered with `set_debug_vars` are added to `map`.
fn build_cir_map(bytes: buf<int>, size: int, opt: int, cfc: str, map: &Txt) => Txt:
    let all = new_txt()
    for q in 0..size:
        all.put_byte(bytes[q])
    all.put_byte(10)
    if prints_numbers(&bytes, size):
        let ft = fmt_rt_text()
        all.put(&ft)
        all.put_byte(10)
    let mt = min_rt_text()
    all.put(&mt)
    let t = new_tys()
    let g = new_globals()
    let lw = module_of(copy_bytes(&all.b, all.n), all.n, opt, cfc, &t, &g)
    if lw.bad > 0:
        return new_txt()
    put_var_map(&lw, map)
    return write_cir(&lw, opt)


/#/ Strings built at run time from bytes. There is no way to make a `str` from a buffer, so a byte
/#/ becomes a one-character literal and the pieces are joined pairwise (O(n log n), not O(n^2)).

/#/ The one-character string of byte `c` (anything outside printable ASCII, tab and newline is `?`).
fn ch_str(c: int) => str:
    if c == 32:
        return " "
    if c == 33:
        return "!"
    if c == 34:
        return "\""
    if c == 35:
        return "#"
    if c == 36:
        return "$"
    if c == 37:
        return "%"
    if c == 38:
        return "&"
    if c == 39:
        return "'"
    if c == 40:
        return "("
    if c == 41:
        return ")"
    if c == 42:
        return "*"
    if c == 43:
        return "+"
    if c == 44:
        return ","
    if c == 45:
        return "-"
    if c == 46:
        return "."
    if c == 47:
        return "/"
    if c == 48:
        return "0"
    if c == 49:
        return "1"
    if c == 50:
        return "2"
    if c == 51:
        return "3"
    if c == 52:
        return "4"
    if c == 53:
        return "5"
    if c == 54:
        return "6"
    if c == 55:
        return "7"
    if c == 56:
        return "8"
    if c == 57:
        return "9"
    if c == 58:
        return ":"
    if c == 59:
        return ";"
    if c == 60:
        return "<"
    if c == 61:
        return "="
    if c == 62:
        return ">"
    if c == 63:
        return "?"
    if c == 64:
        return "@"
    if c == 65:
        return "A"
    if c == 66:
        return "B"
    if c == 67:
        return "C"
    if c == 68:
        return "D"
    if c == 69:
        return "E"
    if c == 70:
        return "F"
    if c == 71:
        return "G"
    if c == 72:
        return "H"
    if c == 73:
        return "I"
    if c == 74:
        return "J"
    if c == 75:
        return "K"
    if c == 76:
        return "L"
    if c == 77:
        return "M"
    if c == 78:
        return "N"
    if c == 79:
        return "O"
    if c == 80:
        return "P"
    if c == 81:
        return "Q"
    if c == 82:
        return "R"
    if c == 83:
        return "S"
    if c == 84:
        return "T"
    if c == 85:
        return "U"
    if c == 86:
        return "V"
    if c == 87:
        return "W"
    if c == 88:
        return "X"
    if c == 89:
        return "Y"
    if c == 90:
        return "Z"
    if c == 91:
        return "["
    if c == 92:
        return "\\"
    if c == 93:
        return "]"
    if c == 94:
        return "^"
    if c == 95:
        return "_"
    if c == 96:
        return "`"
    if c == 97:
        return "a"
    if c == 98:
        return "b"
    if c == 99:
        return "c"
    if c == 100:
        return "d"
    if c == 101:
        return "e"
    if c == 102:
        return "f"
    if c == 103:
        return "g"
    if c == 104:
        return "h"
    if c == 105:
        return "i"
    if c == 106:
        return "j"
    if c == 107:
        return "k"
    if c == 108:
        return "l"
    if c == 109:
        return "m"
    if c == 110:
