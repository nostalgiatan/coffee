/#/ Names every module sees: the primitive types, the casts and the intrinsics.
fn builtin_names() => str:
    return "int float bool str string void nil buf object len new_buf buf_resize buf_ptr subslice sizeof range wrapping_add wrapping_sub wrapping_mul peek8 peek64 poke8 poke64 str_alloc str_put syscall call_addr i8 i16 i32 i64 u8 u16 u32 u64 f32 f64"

/#/ Adds each space-separated word of `words` as a module-less row of `kind`.
fn add_words(g: &Syms, words: &str, kind: int) => void:
    let start = 0
    for i in 0..len(words) + 1:
        if i == len(words) || byte(words, i) == ' ':
            if i > start:
                let b = g.pool_n
                let h = 0
                for k in start..i:
                    g.put_byte(byte(words, k))
                    h = hash_step(h, byte(words, k))
                g.push_row(b, h, kind, -1, -1, -1)
            start = i + 1

/#/ Globals with what every module sees already in: the casts and intrinsics, the bundled C
/#/ functions and types, and the builtin class `Error`.
fn new_globals() => Syms:
    let g = new_syms()
    let builtins = builtin_names()
    add_words(&g, &builtins, int(Sk.Builtin))
    let c_funcs = c_function_names()
    add_words(&g, &c_funcs, int(Sk.Extern))
    let c_types = c_type_names()
    add_words(&g, &c_types, int(Sk.Builtin))
    let e = g.add_text("Error", int(Sk.Class), 0, -1)
    g.info[e] = e
    g.add_text("code", int(Sk.Field), e, -1)
    g.add_text("note", int(Sk.Field), e, -1)
    g.add_text("e", int(Sk.Field), e, -1)
    return g

/#/ The number of ordinary parameters of fn node `f`.
fn param_count(a: &Ast, f: int) => int:
    let c = 0
    let p = a.child[f]
    while p >= 0:
        if a.kind[p] == int(Nk.Param):
            c = c + 1
        p = a.next[p]
    return c

/#/ Adds the top-level names of `a` to `g` as module `name`; returns the module id.
fn declare_module(g: &Syms, a: &Ast, name: &str) => int:
    let m = g.add_text(name, int(Sk.Module), 0, -1)
    g.mod[m] = m
    let it = a.child[a.root]
    while it >= 0:
        let k = a.kind[it]
        if k == int(Nk.Fn) && a.pa[it] >= 0:
            g.add_tok(a, a.pa[it], int(Sk.Fn), param_count(a, it), m)
        elif k == int(Nk.Class) && a.pa[it] >= 0:
            let ci = g.add_tok(a, a.pa[it], int(Sk.Class), 0, m)
            g.info[ci] = ci
            if a.pb[it] >= 0:
                g.add_tok(a, a.pb[it], int(Sk.Parent), ci, m)
            let f = a.child[it]
            while f >= 0:
                if a.kind[f] == int(Nk.Field):
                    g.add_tok(a, a.tok[f], int(Sk.Field), ci, m)
                elif a.kind[f] == int(Nk.Fn) && a.pa[f] >= 0:
                    g.add_tok(a, a.pa[f], int(Sk.Method), ci, m)
                f = a.next[f]
        elif k == int(Nk.Enum) && a.pa[it] >= 0:
            let ei = g.add_tok(a, a.pa[it], int(Sk.Enum), 0, m)
            g.info[ei] = ei
            let v = a.child[it]
            while v >= 0:
                if a.kind[v] == int(Nk.Variant):
                    g.add_tok(a, a.tok[v], int(Sk.Variant), ei, m)
                v = a.next[v]
        elif k == int(Nk.Let) && a.pa[it] >= 0:
            g.add_tok(a, a.pa[it], int(Sk.Global), 0, m)
        elif k == int(Nk.TypeAlias) && a.pa[it] >= 0:
            g.add_tok(a, a.pa[it], int(Sk.Alias), 0, m)
        elif k == int(Nk.Use) && a.pa[it] >= 0 && a.pc[it] != 1:
            /#/ `use * in x` is transitive: whoever imports this module sees x's names too
            let s = a.child[it]
            while s >= 0:
                if a.kind[s] == int(Nk.Star):
                    g.add_tok(a, a.pa[it], int(Sk.Import), 1, m)
                s = a.next[s]
        it = a.next[it]
    return m

/#/ A name another module can import.
fn exported(kind: int) => bool:
    return kind == int(Sk.Fn) || kind == int(Sk.Class) || kind == int(Sk.Enum) || kind == int(Sk.Global) || kind == int(Sk.Alias)

fn tok_is(a: &Ast, tok: int, word: &str) => bool:
    let s = a.toks.start[tok]
    let e = a.toks.end[tok]
    if e - s != len(word):
        return false
    for k in 0..len(word):
        if a.byte_at(s + k) != byte(word, k):
            return false
    return true

fn same_tok(a: &Ast, t1: int, t2: int) => bool:
    let s1 = a.toks.start[t1]
    let l1 = a.toks.end[t1] - s1
    let s2 = a.toks.start[t2]
    if a.toks.end[t2] - s2 != l1:
        return false
    for k in 0..l1:
        if a.byte_at(s1 + k) != a.byte_at(s2 + k):
            return false
    return true

/#/ Does a `break` that belongs to the loop around `st` appear in it?
fn has_break(a: &Ast, st: int) => bool:
    if st < 0:
        return false
    let k = a.kind[st]
    if k == int(Nk.Break):
        return true
    if k == int(Nk.If):
        return has_break(a, a.pb[st]) || has_break(a, a.pc[st])
    if k == int(Nk.Block):
        let c = a.child[st]
        while c >= 0:
            if has_break(a, c):
                return true
            c = a.next[c]
        return false
    if k == int(Nk.Match):
        let arm = a.child[st]
        while arm >= 0:
            if has_break(a, a.pb[arm]):
                return true
            arm = a.next[arm]
    return false

/#/ Can control not run off the end of statement `st`?
fn ends(a: &Ast, st: int) => bool:
    if st < 0:
        return false
    let k = a.kind[st]
    if k == int(Nk.Return) || k == int(Nk.Raise):
        return true
    if k == int(Nk.Block):
        let c = a.child[st]
        while c >= 0:
            if ends(a, c):
                return true
            c = a.next[c]
        return false
    if k == int(Nk.If):
        return a.pc[st] >= 0 && ends(a, a.pb[st]) && ends(a, a.pc[st])
    if k == int(Nk.While):
        return a.pa[st] >= 0 && a.kind[a.pa[st]] == int(Nk.Bool) && tok_is(a, a.tok[a.pa[st]], "true") && !has_break(a, a.pb[st])
    if k == int(Nk.Match):
        let arm = a.child[st]
        if arm < 0:
            return false
        while arm >= 0:
            if !ends_arm(a, a.pb[arm]):
                return false
            arm = a.next[arm]
        return true
    return false

/#/ An arm ends when its body does, or when its last statement is a bare value.
fn ends_arm(a: &Ast, body: int) => bool:
    if body < 0:
        return false
    if ends(a, body):
        return true
    let c = a.child[body]
    let last = -1
    while c >= 0:
        last = c
        c = a.next[c]
    return last >= 0 && a.kind[last] == int(Nk.ExprStmt)

/#/ Is the last statement of `body` a bare expression?
fn last_is_value(a: &Ast, body: int) => bool:
    if body < 0:
        return false
    let c = a.child[body]
    let last = -1
    while c >= 0:
        last = c
        c = a.next[c]
    return last >= 0 && a.kind[last] == int(Nk.ExprStmt)

class Checker:
    loc: Syms
    diags: Diags
    fn_base: int
    loops: int
    in_fn: int
    ret_void: bool
    cur: int
    seen: buf<int>
    seen_n: int
    capture_lo: int
    capture_named: bool
    cur_class: int

    fn diag(self, tok: int, code: int) => void:
        self.diags.add(tok, code)

    /#/ ---- scope ---------------------------------------------------------

    fn pop(self, mark: int) => void:
        let i = mark
        while i < self.loc.n:
            if self.loc.kind[i] == int(Sk.Local) && self.loc.used[i] == 0 && self.loc.first_byte(i) != '_':
                self.diag(self.loc.tok[i], int(Sk.Local) * 0 + int(Sc.UnusedVariable))
            i = i + 1
        self.loc.truncate(mark)

    /#/ Declares a local or parameter; redeclaring a live one of this function is an error.
    fn declare(self, a: &Ast, tok: int, kind: int) => void:
        let prior = self.loc.find_tok(a, tok, self.fn_base)
        if prior >= 0 && (self.loc.kind[prior] == int(Sk.Local) || self.loc.kind[prior] == int(Sk.Param)):
            self.diag(tok, int(Sc.DuplicateName))
        self.loc.add_tok(a, tok, kind, -1, self.cur)

    /#/ A read of the name at `tok`.
    fn use_name(self, a: &Ast, tok: int) => void:
        let i = self.loc.find_tok(a, tok, 0)
        if i < 0:
            self.diag(tok, int(Sc.UndefinedName))
        else:
            self.loc.used[i] = 1
            self.check_capture(i, tok)

    /#/ A nested function or anonymous function cannot read the locals around it.
    fn check_capture(self, i: int, tok: int) => void:
        if self.capture_lo >= 0 && i >= self.capture_lo && i < self.fn_base:
            if self.loc.kind[i] == int(Sk.Local) || self.loc.kind[i] == int(Sk.Param):
                if self.capture_named:
                    self.diag(tok, int(Sc.UndefinedName))
                else:
                    self.diag(tok, int(Sc.CaptureViolation))

    /#/ ---- types ---------------------------------------------------------

    fn type_ref(self, a: &Ast, t: int) => void:
        if t < 0:
            return
        let i = a.tok[t]
        while i < a.end[t]:
            if a.toks.kind[i] == int(Tk.Ident):
                let after_amp = i > a.tok[t] && a.toks.kind[i - 1] == int(Tk.Amp)
                if !(after_amp && tok_is(a, i, "mut")):
                    let r = self.loc.find_tok(a, i, 0)
                    if r < 0:
                        self.diag(i, int(Sc.UndefinedType))
                    else:
                        self.loc.used[r] = 1
            i = i + 1

    /#/ ---- expressions ---------------------------------------------------

    fn expr(self, a: &Ast, g: &Syms, n: int) => void:
        if n < 0:
            return
        let k = a.kind[n]
        if k == int(Nk.Name):
            self.use_name(a, a.tok[n])
        elif k == int(Nk.Binary) || k == int(Nk.Index) || k == int(Nk.Range):
            self.expr(a, g, a.pa[n])
            self.expr(a, g, a.pb[n])
        elif k == int(Nk.Unary):
            self.expr(a, g, a.pa[n])
        elif k == int(Nk.Member):
            self.expr(a, g, a.pa[n])
            self.member(a, g, n)
        elif k == int(Nk.Cast):
            self.expr(a, g, a.pa[n])
            self.type_ref(a, a.pb[n])
        elif k == int(Nk.Call):
            self.call(a, g, n)
        elif k == int(Nk.StructLit):
            self.struct_lit(a, g, n)
        elif k == int(Nk.Array) || k == int(Nk.Tuple):
            let c = a.child[n]
            while c >= 0:
                self.expr(a, g, c)
                c = a.next[c]
        elif k == int(Nk.FStr):
            self.fstr(a, g, n)
        elif k == int(Nk.Fn):
            self.function(a, g, n, false)

    /#/ `v.name` on a variable whose class is known: the class must have that field or method.
    fn member(self, a: &Ast, g: &Syms, n: int) => void:
        let o = a.pa[n]
        if a.pd[n] == 1 || o < 0 || a.kind[o] != int(Nk.Name) || a.tok[n] < 0:
            return
        let r = self.loc.find_tok(a, a.tok[o], 0)
        if r < 0 || (self.loc.kind[r] != int(Sk.Local) && self.loc.kind[r] != int(Sk.Param)):
            return
        let ci = self.loc.info[r]
        if tok_is(a, a.tok[n], "assign"):
            return
        if ci >= 0 && self.member_row(a, g, ci, a.tok[n], true) == -1:
            self.diag(a.tok[n], int(Sc.UnknownField))

    fn call(self, a: &Ast, g: &Syms, n: int) => void:
        let callee = a.pa[n]
        let before = self.diags.n
        self.expr(a, g, callee)
        /#/ an unknown member that is called is a missing method, not a missing field
        for k in before..self.diags.n:
            if self.diags.code[k] == int(Sc.UnknownField) && callee >= 0 && a.kind[callee] == int(Nk.Member) && self.diags.tok[k] == a.tok[callee]:
                self.diags.code[k] = int(Sc.UnknownMethod)
        let argc = 0
        let c = a.child[n]
        while c >= 0:
            self.expr(a, g, c)
            argc = argc + 1
            c = a.next[c]
        if callee >= 0 && a.kind[callee] == int(Nk.Name):
            let i = self.loc.find_tok(a, a.tok[callee], 0)
            if i >= 0 && self.loc.kind[i] == int(Sk.Fn) && self.loc.info[i] != argc:
                self.diag(a.tok[callee], int(Sc.ArityMismatch))

    /#/ `Class { f: v, ... }`: the class exists and the fields are exactly its own.
    fn struct_lit(self, a: &Ast, g: &Syms, n: int) => void:
        let t = a.pa[n]
        let ci = -1
        if t >= 0 && a.kind[t] == int(Nk.Name):
            let i = self.loc.find_tok(a, a.tok[t], 0)
            if i < 0:
                self.diag(a.tok[t], int(Sc.UndefinedName))
            else:
                self.loc.used[i] = 1
                if self.loc.kind[i] == int(Sk.Class):
                    ci = self.loc.info[i]
                elif self.loc.kind[i] != int(Sk.TypeParam):
                    self.diag(a.tok[t], int(Sc.NotAClass))
        else:
            self.expr(a, g, t)
        let given = 0
        let f = a.child[n]
        while f >= 0:
            self.expr(a, g, a.pa[f])
            if ci >= 0 && self.field_of(a, g, ci, a.tok[f]) < 0:
                self.diag(a.tok[f], int(Sc.UnknownField))
            given = given + 1
            f = a.next[f]
        if ci >= 0:
            self.missing_fields(a, g, ci, n)

    /#/ The Field row of class `ci`, or of one of its ancestors, named like `tok`; -1 if none.
    fn field_of(self, a: &Ast, g: &Syms, ci: int, tok: int) => int:
        return self.member_row(a, g, ci, tok, false)

    /#/ Like `field_of`, with methods counted too when `methods`. -2 when an ancestor cannot
    /#/ be found, so nothing can be said.
    fn member_row(self, a: &Ast, g: &Syms, ci: int, tok: int, methods: bool) => int:
        let s = a.toks.start[tok]
        let e = a.toks.end[tok]
        let h = g.span_hash(a, s, e)
        let cur = ci
        let depth = 0
        while cur >= 0 && depth < 32:
            let next = -1
            let has_parent = false
            let best = -1
            let last_parent = -1
            let q = g.member_head(cur) - 1
            while q >= 0:
                if (g.kind[q] == int(Sk.Field) || (methods && g.kind[q] == int(Sk.Method))) && (best < 0 || q < best) && g.same_span(q, a, s, e, h):
                    best = q
                if g.kind[q] == int(Sk.Parent) && q > last_parent:
                    last_parent = q
                q = g.member_next(q) - 1
            if best >= 0:
                return best
            if last_parent >= 0:
                has_parent = true
                next = g.find_class_row(last_parent)
            if has_parent && next < 0:
                return -2
            cur = next
            depth = depth + 1
        return -1

    /#/ Every field of class `ci` must be given in struct literal `n`.
    fn missing_fields(self, a: &Ast, g: &Syms, ci: int, n: int) => void:
        let cur = ci
        let depth = 0
        while cur >= 0 && depth < 32:
            let next = -1
            for i in 0..g.n:
                if g.info[i] != cur:
                    continue
                if g.kind[i] == int(Sk.Parent):
                    next = g.find_class_row(i)
                if g.kind[i] == int(Sk.Field):
                    let found = false
                    let f = a.child[n]
                    while f >= 0:
                        if g.same_span(i, a, a.toks.start[a.tok[f]], a.toks.end[a.tok[f]], g.span_hash(a, a.toks.start[a.tok[f]], a.toks.end[a.tok[f]])):
                            found = true
                        f = a.next[f]
                    if !found:
                        self.diag(a.tok[n], int(Sc.MissingField))
            cur = next
            depth = depth + 1

    /#/ `{name}` inside an f-string reads `name`. Only marks it used: the text is not parsed.
    fn fstr(self, a: &Ast, g: &Syms, n: int) => void:
        let p = a.child[n]
        while p >= 0:
            self.expr(a, g, a.pa[p])
            p = a.next[p]

    /#/ ---- statements ----------------------------------------------------

    fn stmts(self, a: &Ast, g: &Syms, block: int) => void:
        if block < 0:
            return
        let c = a.child[block]
        while c >= 0:
            self.stmt(a, g, c)
            c = a.next[c]

    fn block(self, a: &Ast, g: &Syms, b: int) => void:
        if b < 0:
            return
        let mark = self.loc.n
        self.stmts(a, g, b)
        self.pop(mark)

    fn stmt(self, a: &Ast, g: &Syms, n: int) => void:
        let k = a.kind[n]
        if k == int(Nk.Let):
            self.expr(a, g, a.pc[n])
            /#/ a class or enum name alone is a type, not a value
            let init = a.pc[n]
            if init >= 0 && a.kind[init] == int(Nk.Name):
                let ir = self.loc.find_tok(a, a.tok[init], 0)
                if ir >= 0 && (self.loc.kind[ir] == int(Sk.Class) || self.loc.kind[ir] == int(Sk.Enum)):
                    self.diag(a.tok[init], int(Sc.UndefinedName))
            self.type_ref(a, a.pb[n])
            if a.pa[n] >= 0:
                if self.in_fn == 0:
                    self.loc.used[self.loc.find_tok(a, a.pa[n], 0)] = 1
                else:
                    self.declare(a, a.pa[n], int(Sk.Local))
                    let ci = self.class_of_type(a, a.pb[n])
                    if ci < 0:
                        ci = self.class_of_literal(a, a.pc[n])
                    self.loc.info[self.loc.n - 1] = ci
        elif k == int(Nk.Assign):
            let t = a.pa[n]
            if t >= 0 && a.kind[t] == int(Nk.Name):
                let i = self.loc.find_tok(a, a.tok[t], 0)
                if i < 0:
                    self.diag(a.tok[t], int(Sc.UndefinedName))
            else:
                self.expr(a, g, t)
            self.expr(a, g, a.pb[n])
        elif k == int(Nk.Return):
            self.ret(a, g, n)
        elif k == int(Nk.Clean):
            /#/ `clean out` is a type error, not an undefined name
            return
        elif k == int(Nk.Raise) || k == int(Nk.Rm) || k == int(Nk.ExprStmt):
            self.expr(a, g, a.pa[n])
            let extra = a.child[n]
            while extra >= 0:
                self.expr(a, g, extra)
                extra = a.next[extra]
        elif k == int(Nk.Mv):
            self.expr(a, g, a.pa[n])
            if a.pb[n] >= 0:
                self.declare(a, a.pb[n], int(Sk.Local))
        elif k == int(Nk.TypeAlias):
            self.type_ref(a, a.pb[n])
            if self.in_fn == 1 && a.pa[n] >= 0:
                self.loc.add_tok(a, a.pa[n], int(Sk.Alias), -1, self.cur)
        elif k == int(Nk.If):
            self.expr(a, g, a.pa[n])
            self.block(a, g, a.pb[n])
            let e = a.pc[n]
            if e >= 0:
                if a.kind[e] == int(Nk.If):
                    self.stmt(a, g, e)
                else:
                    self.block(a, g, e)
        elif k == int(Nk.While):
            self.expr(a, g, a.pa[n])
            self.loops = self.loops + 1
            self.block(a, g, a.pb[n])
            self.loops = self.loops - 1
        elif k == int(Nk.For):
            self.expr(a, g, a.pb[n])
            self.loops = self.loops + 1
            let mark = self.loc.n
            if a.pa[n] >= 0:
                self.declare(a, a.pa[n], int(Sk.Local))
                self.loc.used[self.loc.n - 1] = 1
            self.stmts(a, g, a.pc[n])
            self.pop(mark)
            self.loops = self.loops - 1
        elif k == int(Nk.Match):
            self.expr(a, g, a.pa[n])
            let arm = a.child[n]
            while arm >= 0:
                let mark = self.loc.n
                self.pattern(a, g, a.pa[arm])
                self.expr(a, g, a.pc[arm])
                self.stmts(a, g, a.pb[arm])
                self.pop(mark)
                arm = a.next[arm]
        elif k == int(Nk.Break):
            if self.loops == 0:
                self.diag(a.tok[n], int(Sc.BreakOutsideLoop))
        elif k == int(Nk.Continue):
            if self.loops == 0:
                self.diag(a.tok[n], int(Sc.ContinueOutsideLoop))
        elif k == int(Nk.Fn):
            if a.pa[n] >= 0:
                self.loc.add_tok(a, a.pa[n], int(Sk.Fn), param_count(a, n), self.cur)
            self.function(a, g, n, false)
        elif k == int(Nk.Class):
            if a.pa[n] >= 0:
                self.loc.add_tok(a, a.pa[n], int(Sk.Class), -1, self.cur)
            self.class_decl(a, g, n)
        elif k == int(Nk.Enum):
            if a.pa[n] >= 0:
                self.loc.add_tok(a, a.pa[n], int(Sk.Enum), -1, self.cur)
            self.enum_decl(a, g, n)

    fn ret(self, a: &Ast, g: &Syms, n: int) => void:
        self.expr(a, g, a.pa[n])
        if self.in_fn == 0:
            self.diag(a.tok[n], int(Sc.ReturnOutsideFn))
        elif a.pa[n] >= 0 && self.ret_void:
            self.diag(a.tok[n], int(Sc.ReturnValueInVoid))
        elif a.pa[n] < 0 && !self.ret_void:
            self.diag(a.tok[n], int(Sc.MissingReturnValue))

    /#/ A pattern binds the names inside a variant pattern (`E.S(s)`), ignores `_` and
    /#/ otherwise reads constants.
    fn pattern(self, a: &Ast, g: &Syms, p: int) => void:
        if p < 0:
            return
        let k = a.kind[p]
        if k == int(Nk.Name):
            if tok_is(a, a.tok[p], "_"):
                return
            let i = self.loc.find_tok(a, a.tok[p], 0)
            if i >= 0 && self.loc.kind[i] != int(Sk.Local) && self.loc.kind[i] != int(Sk.Param):
                self.loc.used[i] = 1
            else:
                self.declare(a, a.tok[p], int(Sk.Local))
                self.loc.used[self.loc.n - 1] = 1
        elif k == int(Nk.Call):
            self.expr(a, g, a.pa[p])
            let c = a.child[p]
            while c >= 0:
                self.pattern(a, g, c)
                c = a.next[c]
        elif k == int(Nk.Tuple):
            let c = a.child[p]
            while c >= 0:
                self.pattern(a, g, c)
                c = a.next[c]
        elif k == int(Nk.StructLit):
            /#/ `Point { x: 0, y: b }`: each field holds a pattern
            let t = a.pa[p]
            if t >= 0 && a.kind[t] == int(Nk.Name):
                self.use_name(a, a.tok[t])
            let f = a.child[p]
            while f >= 0:
                self.pattern(a, g, a.pa[f])
                f = a.next[f]
        elif k == int(Nk.Binary) && a.pc[p] == int(Tk.Pipe):
            /#/ `A(n) | B(n)`: every alternative binds the same names
            let mark = self.loc.n
            self.pattern(a, g, a.pa[p])
            let mid = self.loc.n
            let seen: buf<int> = new_buf(int, mid - mark + 1)
            self.pattern_alt(a, g, a.pb[p], mark, mid, &seen)
            for i in 0..mid - mark:
                if seen[i] == 0 && self.loc.kind[mark + i] == int(Sk.Local):
                    self.diag(a.tok[p], int(Sc.UndefinedName))
        else:
            self.expr(a, g, p)

    /#/ A later alternative of an or-pattern: its names are the ones rows `mark..mid` already bound.
    fn pattern_alt(self, a: &Ast, g: &Syms, p: int, mark: int, mid: int, seen: &buf<int>) => void:
        if p < 0:
            return
        let k = a.kind[p]
        if k == int(Nk.Name):
            if tok_is(a, a.tok[p], "_"):
                return
            let i = self.loc.find_tok(a, a.tok[p], mark)
            if i >= 0 && i < mid:
                seen[i - mark] = 1
                return
            let o = self.loc.find_tok(a, a.tok[p], 0)
            if o >= 0 && self.loc.kind[o] != int(Sk.Local) && self.loc.kind[o] != int(Sk.Param):
                self.loc.used[o] = 1
            else:
                self.diag(a.tok[p], int(Sc.UndefinedName))
        elif k == int(Nk.Call):
            self.expr(a, g, a.pa[p])
            let c = a.child[p]
            while c >= 0:
                self.pattern_alt(a, g, c, mark, mid, seen)
                c = a.next[c]
        elif k == int(Nk.Tuple):
            let c = a.child[p]
            while c >= 0:
                self.pattern_alt(a, g, c, mark, mid, seen)
                c = a.next[c]
        elif k == int(Nk.StructLit):
            let t = a.pa[p]
            if t >= 0 && a.kind[t] == int(Nk.Name):
                self.use_name(a, a.tok[t])
            let f = a.child[p]
            while f >= 0:
                self.pattern_alt(a, g, a.pa[f], mark, mid, seen)
                f = a.next[f]
        elif k == int(Nk.Binary) && a.pc[p] == int(Tk.Pipe):
            self.pattern_alt(a, g, a.pa[p], mark, mid, seen)
            self.pattern_alt(a, g, a.pb[p], mark, mid, seen)
        else:
            self.expr(a, g, p)

    /#/ The class of `Class { ... }`, -1 for any other expression.
    fn class_of_literal(self, a: &Ast, e: int) => int:
        if e < 0 || a.kind[e] != int(Nk.StructLit):
            return -1
        let t = a.pa[e]
        if t < 0 || a.kind[t] != int(Nk.Name):
            return -1
        let r = self.loc.find_tok(a, a.tok[t], 0)
        if r >= 0 && self.loc.kind[r] == int(Sk.Class):
            return self.loc.info[r]
        return -1

    /#/ ---- declarations --------------------------------------------------

    /#/ `#name` names a function that must exist.
    fn listener(self, a: &Ast, l: int) => void:
        let t = a.tok[l]
        let s = a.toks.start[t] + 1
        let i = self.loc.find_span(a, s, a.toks.end[t], 0)
        if i < 0 || self.loc.kind[i] != int(Sk.Fn):
            self.diag(t, int(Sc.UndefinedName))
        else:
            self.loc.used[i] = 1

    /#/ The global row of the class a single-name type (`Box`, `&Box`, `&mut Box`) names; -1
    /#/ when it is anything else.
    fn class_of_type(self, a: &Ast, t: int) => int:
        if t < 0:
            return -1
        let i = a.tok[t]
        while i < a.end[t] && (a.toks.kind[i] == int(Tk.Amp) || tok_is(a, i, "mut")):
            i = i + 1
        if i != a.end[t] - 1 || a.toks.kind[i] != int(Tk.Ident):
            return -1
        let r = self.loc.find_tok(a, i, 0)
        if r >= 0 && self.loc.kind[r] == int(Sk.Class):
            return self.loc.info[r]
        return -1


    /#/ `method`: a method whose last statement is a bare expression returns its value.
    fn function(self, a: &Ast, g: &Syms, f: int, method: bool) => void:
        let saved_base = self.fn_base
        let saved_loops = self.loops
        let saved_in = self.in_fn
        let saved_void = self.ret_void
        let saved_capture = self.capture_lo
        let saved_named = self.capture_named
        let mark = self.loc.n
        if self.in_fn == 1:
            self.capture_lo = saved_base
            self.capture_named = a.pa[f] >= 0
        self.fn_base = mark
        self.loops = 0
        self.in_fn = 1
        let p = a.child[f]
        while p >= 0:
            if a.kind[p] == int(Nk.TypeParam):
                self.declare(a, a.tok[p], int(Sk.TypeParam))
            p = a.next[p]
        p = a.child[f]
        while p >= 0:
            if a.kind[p] == int(Nk.Param):
                self.type_ref(a, a.pa[p])
                self.declare(a, a.tok[p], int(Sk.Param))
                self.loc.info[self.loc.n - 1] = self.class_of_type(a, a.pa[p])
            elif a.kind[p] == int(Nk.SelfParam):
                self.declare(a, a.tok[p], int(Sk.Param))
                self.loc.info[self.loc.n - 1] = self.cur_class
            elif a.kind[p] == int(Nk.Listener):
                self.listener(a, p)
            p = a.next[p]
        let rt = a.pb[f]
        self.type_ref(a, rt)
        self.ret_void = rt < 0 || (a.end[rt] - a.tok[rt] == 1 && tok_is(a, a.tok[rt], "void")) || (a.end[rt] - a.tok[rt] == 2 && a.toks.kind[a.tok[rt]] == int(Tk.LParen))
        let body = a.pc[f]
        if body >= 0:
            self.stmts(a, g, body)
            if !self.ret_void && !ends(a, body) && !(method && last_is_value(a, body)):
                let at = a.tok[f]
                if a.pa[f] >= 0:
                    at = a.pa[f]
                self.diag(at, int(Sc.MissingReturn))
        self.pop(mark)
        self.fn_base = saved_base
        self.capture_lo = saved_capture
        self.capture_named = saved_named
        self.loops = saved_loops
        self.in_fn = saved_in
        self.ret_void = saved_void

    fn class_decl(self, a: &Ast, g: &Syms, c: int) => void:
        let mark = self.loc.n
        let saved_base = self.fn_base
        let saved_class = self.cur_class
        self.cur_class = -1
        if a.pa[c] >= 0:
            let own = self.loc.find_tok(a, a.pa[c], 0)
            if own >= 0 && self.loc.kind[own] == int(Sk.Class):
                self.cur_class = self.loc.info[own]
        self.fn_base = mark
        let m = a.child[c]
        while m >= 0:
            if a.kind[m] == int(Nk.TypeParam):
                self.declare(a, a.tok[m], int(Sk.TypeParam))
            m = a.next[m]
        if a.pb[c] >= 0:
            let pi = self.loc.find_tok(a, a.pb[c], 0)
            if pi < 0 || self.loc.kind[pi] != int(Sk.Class):
                self.diag(a.pb[c], int(Sc.UnknownParent))
            else:
                self.loc.used[pi] = 1
        m = a.child[c]
        while m >= 0:
            let k = a.kind[m]
            if k == int(Nk.Field):
                self.type_ref(a, a.pa[m])
                self.dup_member(a, c, m, a.tok[m])
            elif k == int(Nk.Fn):
                self.dup_member(a, c, m, a.pa[m])
                self.function(a, g, m, true)
            m = a.next[m]
        self.fn_base = saved_base
        self.cur_class = saved_class
        self.loc.truncate(mark)

    /#/ Is the member named by `tok` already declared by an earlier member of `c`?
    fn dup_member(self, a: &Ast, c: int, m: int, tok: int) => void:
        if tok < 0:
            return
        let o = a.child[c]
        while o >= 0 && o != m:
            let other = -1
            if a.kind[o] == int(Nk.Field):
                other = a.tok[o]
            elif a.kind[o] == int(Nk.Fn):
                other = a.pa[o]
            if other >= 0 && same_tok(a, other, tok):
                self.diag(tok, int(Sc.DuplicateName))
                return
            o = a.next[o]

    fn enum_decl(self, a: &Ast, g: &Syms, e: int) => void:
        let v = a.child[e]
        while v >= 0:
            let o = a.child[e]
            while o != v:
                if same_tok(a, a.tok[o], a.tok[v]):
                    self.diag(a.tok[v], int(Sc.DuplicateName))
                    break
                o = a.next[o]
            let f = a.child[v]
            while f >= 0:
                self.type_ref(a, a.pa[f])
                f = a.next[f]
            v = a.next[v]

    /#/ ---- modules -------------------------------------------------------

    /#/ Brings the builtins, the module's own names and its imports into scope.
    fn prelude(self, a: &Ast, g: &Syms, m: int) => void:
        for i in 0..g.n:
            if g.mod[i] == -1 && (g.kind[i] == int(Sk.Builtin) || g.kind[i] == int(Sk.Extern) || g.kind[i] == int(Sk.Class) || g.kind[i] == int(Sk.Alias)):
                self.loc.copy_row(g, i)
        for i in 0..g.n:
            if g.mod[i] == m && exported(g.kind[i]):
                self.loc.copy_row(g, i)
        let it = a.child[a.root]
        while it >= 0:
            if a.kind[it] == int(Nk.Use):
                self.import(a, g, it)
            it = a.next[it]

    /#/ A function imported from a C library takes the signature a `.cfc` (bundled, or the program's own) gave it.
    fn bundled_sig(self, a: &Ast, g: &Syms, r: int, tok: int) => void:
        let st = a.toks.start[tok]
        let en = a.toks.end[tok]
        let h = g.span_hash(a, st, en)
        for i in 0..g.n:
            if g.kind[i] == int(Sk.Extern) && g.mod[i] == -1 && g.same_span(i, a, st, en, h):
                self.loc.ty[r] = g.ty[i]
                self.loc.info[r] = g.info[i]

    fn import(self, a: &Ast, g: &Syms, u: int) => void:
        if a.pa[u] < 0:
            return
        if a.pc[u] == 1:
            let s = a.child[u]
            while s >= 0:
                if a.kind[s] == int(Nk.Name):
                    let r = self.loc.add_tok(a, a.tok[s], int(Sk.Extern), -1, -1)
                    self.bundled_sig(a, g, r, a.tok[s])
                    if self.loc.ty[r] < 0 && !tok_is(a, a.pa[u], "libc") && !tok_is(a, a.pa[u], "libm"):
                        /#/ no `.cfc` gave this function a signature
                        self.diag(a.tok[s], int(Sc.UnknownCSymbol))
                s = a.next[s]
            return
        let mid = g.find_module(a, a.pa[u])
        if mid < 0:
            self.diag(a.pa[u], int(Sc.UnknownModule))
            return
        if a.child[u] < 0:
            /#/ `use m` imports the whole module
            self.import_all(g, mid)
            return
        let s = a.child[u]
        while s >= 0:
            if a.kind[s] == int(Nk.Star):
                self.import_all(g, mid)
            else:
                let i = g.find_in_module(a, a.tok[s], mid)
                if i < 0 || !exported(g.kind[i]):
                    self.diag(a.tok[s], int(Sc.UnknownImport))
                else:
                    self.import_row(g, i)
            s = a.next[s]

    /#/ Everything module `mid` exports and, transitively, what it star-imports.
    fn import_all(self, g: &Syms, mid: int) => void:
        for k in 0..self.seen_n:
            if self.seen[k] == mid:
                return
        if self.seen_n >= len(self.seen):
            self.seen = buf_resize(self.seen, (self.seen_n + 1) * 2)
        self.seen[self.seen_n] = mid
        self.seen_n = self.seen_n + 1
        for i in 0..g.n:
            if g.mod[i] == mid && exported(g.kind[i]):
                self.import_row(g, i)
        for i in 0..g.n:
            if g.mod[i] == mid && g.kind[i] == int(Sk.Import):
                let t = g.find_module_row(i)
                if t >= 0:
                    self.import_all(g, t)

    /#/ Copies global row `i` into scope unless the same name is already imported.
    fn import_row(self, g: &Syms, i: int) => void:
        for k in 0..self.loc.n:
            if self.loc.hash[k] == g.hash[i] && self.loc.size[k] == g.size[i] && self.loc.mod[k] == g.mod[i] && self.loc.kind[k] == g.kind[i]:
                return
        self.loc.copy_row(g, i)

    /#/ Module-level duplicates: two top-level items with one name.
    fn top_duplicates(self, a: &Ast) => void:
        let it = a.child[a.root]
        while it >= 0:
            let name = self.item_name(a, it)
            if name >= 0 && a.kind[it] == int(Nk.Class) && tok_is(a, name, "Error"):
                self.diag(name, int(Sc.DuplicateName))
            if name >= 0:
                let o = a.child[a.root]
                while o != it:
                    let other = self.item_name(a, o)
                    if other >= 0 && same_tok(a, other, name):
                        if a.kind[it] == int(Nk.Fn) && tok_is(a, name, "main"):
                            self.diag(name, int(Sc.DuplicateMain))
                        else:
                            self.diag(name, int(Sc.DuplicateName))
                        break
                    o = a.next[o]
            it = a.next[it]

    fn item_name(self, a: &Ast, it: int) => int:
        let k = a.kind[it]
        if k == int(Nk.Fn) || k == int(Nk.Class) || k == int(Nk.Enum) || k == int(Nk.Let):
            return a.pa[it]
        return -1

    fn module(self, a: &Ast, g: &Syms, m: int) => void:
        self.cur = m
        self.prelude(a, g, m)
        self.top_duplicates(a)
        let it = a.child[a.root]
        while it >= 0:
            let k = a.kind[it]
            if k == int(Nk.Fn):
                self.function(a, g, it, false)
            elif k == int(Nk.Class):
                self.class_decl(a, g, it)
            elif k == int(Nk.Enum):
                self.enum_decl(a, g, it)
            elif k != int(Nk.Use):
                self.stmt(a, g, it)
            it = a.next[it]

/#/ A checker holding only the names module `m` sees (the module's own, imported ones and
/#/ the builtins): the scope the type checker reads signatures in.
fn scope_of(a: &Ast, g: &Syms, m: int) => Checker:
    let c = Checker { loc: new_syms(), diags: new_diags(), fn_base: 0, loops: 0, in_fn: 0, ret_void: true, cur: m, seen: new_buf(int, 8), seen_n: 0, capture_lo: -1, capture_named: true, cur_class: -1 }
    c.cur = m
    c.prelude(a, g, m)
    return c

/#/ Checks module `m` of `g` (see `declare_module`) whose tree is `a`; the findings are in
/#/ the result's `diags`.
fn check(a: &Ast, g: &Syms, m: int) => Checker:
    let c = Checker { loc: new_syms(), diags: new_diags(), fn_base: 0, loops: 0, in_fn: 0, ret_void: true, cur: m, seen: new_buf(int, 8), seen_n: 0, capture_lo: -1, capture_named: true, cur_class: -1 }
    c.module(a, g, m)
    return c



enum Ty:
    Error
    Void
    Bool
    Str
    Object
    Int
    Float
    Buf
    Slice
    Array
    Ref
    Tuple
    Fn
    Named
    Param

class Tys:
    kind: buf<int>
    a: buf<int>
    b: buf<int>
    c: buf<int>
    hash: buf<int>
    /#/ chains of types by hash: heads (type + 1) and next
    bh: buf<int>
    bn: buf<int>
    n: int
    args: buf<int>
    args_n: int
    /#/ the cursor of `from_ref`
    pos: int
    params: int
    /#/ 1 while the first `>` of a `>>` token has been taken
    half: int

    fn grow(self) => void:
        if self.n < len(self.kind):
            return
        let cap = (self.n + 1) * 2
        self.kind = buf_resize(self.kind, cap)
        self.a = buf_resize(self.a, cap)
        self.b = buf_resize(self.b, cap)
        self.c = buf_resize(self.c, cap)
        self.hash = buf_resize(self.hash, cap)
        self.bn = buf_resize(self.bn, cap)

    fn set_pos(self, p: int) => void:
        self.pos = p

    fn set_half(self, h: int) => void:
        self.half = h

    fn set_args_n(self, n: int) => void:
        self.args_n = n

    fn push_arg(self, t: int) => void:
        if self.args_n >= len(self.args):
            self.args = buf_resize(self.args, (self.args_n + 1) * 2)
        self.args[self.args_n] = t
        self.args_n = self.args_n + 1

    fn list_hash(self, start: int, count: int) => int:
        let h = 7
        for i in 0..count:
            h = (h * 31 + self.args[start + i] + 1) % 1000003
        return h

    /#/ The id of the type with these operands, adding it when new. For the list kinds the
    /#/ arguments were just pushed from `start`; an equal earlier list replaces them.
    fn intern(self, kind: int, a: int, b: int, c: int, start: int) => int:
        let list = kind == int(Ty.Tuple) || kind == int(Ty.Fn) || kind == int(Ty.Named)
        let count = 0
        if list:
            if kind == int(Ty.Named):
                count = c
            else:
                count = b
            a = a
        let h = (kind * 31 + a + 1) % 1000003
        h = (h * 31 + b + 1) % 1000003
        h = (h * 31 + c + 1) % 1000003
        if list:
            h = (h * 31 + self.list_hash(start, count)) % 1000003
        let j = self.bh[(h & 1073741823) % len(self.bh)] - 1
        while j >= 0:
            if self.hash[j] == h && self.kind[j] == kind:
                let same = false
                if list:
                    same = self.same_list(j, kind, a, b, c, start, count)
                else:
                    same = self.a[j] == a && self.b[j] == b && self.c[j] == c
                if same:
                    if list:
                        self.args_n = start
                    return j
            j = self.bn[j] - 1
        self.grow()
        let i = self.n
        self.kind[i] = kind
        if kind == int(Ty.Named):
            self.a[i] = a
            self.b[i] = start
            self.c[i] = count
        elif kind == int(Ty.Tuple) || kind == int(Ty.Fn):
            self.a[i] = start
            self.b[i] = count
            self.c[i] = c
        else:
            self.a[i] = a
            self.b[i] = b
            self.c[i] = c
        self.hash[i] = h
        self.bn[i] = self.bh[(h & 1073741823) % len(self.bh)]
        self.bh[(h & 1073741823) % len(self.bh)] = i + 1
        self.n = i + 1
        return i

    fn same_list(self, i: int, kind: int, a: int, b: int, c: int, start: int, count: int) => bool:
        if kind == int(Ty.Named):
            if self.a[i] != a || self.c[i] != count:
                return false
        else:
            if self.b[i] != count || self.c[i] != c:
                return false
        let at = self.b[i]
        if kind != int(Ty.Named):
            at = self.a[i]
        for k in 0..count:
            if self.args[at + k] != self.args[start + k]:
                return false
        return true

    fn simple(self, kind: int) => int:
        return self.intern(kind, 0, 0, 0, 0)

    fn int_ty(self, bytes: int, signed: bool) => int:
        let s = 0
        if signed:
            s = 1
        return self.intern(int(Ty.Int), bytes, s, 0, 0)

    fn float_ty(self, bytes: int) => int:
        return self.intern(int(Ty.Float), bytes, 0, 0, 0)

    fn buf_of(self, elem: int) => int:
        return self.intern(int(Ty.Buf), elem, 0, 0, 0)

    fn slice_of(self, elem: int) => int:
        return self.intern(int(Ty.Slice), elem, 0, 0, 0)

    fn array_of(self, elem: int, count: int) => int:
        return self.intern(int(Ty.Array), elem, count, 0, 0)

    fn ref_to(self, target: int, mutable: bool) => int:
        let m = 0
        if mutable:
            m = 1
        return self.intern(int(Ty.Ref), target, m, 0, 0)

    fn named(self, row: int) => int:
        return self.intern(int(Ty.Named), row, 0, 0, self.args_n)

    fn param_ty(self, number: int) => int:
        return self.intern(int(Ty.Param), number, 0, 0, 0)

    /#/ The nth argument of a list type.
    fn arg(self, t: int, i: int) => int:
        return self.args[self.args_n_of(t) + i]

    fn args_n_of(self, t: int) => int:
        if self.kind[t] == int(Ty.Named):
            return self.b[t]
        return self.a[t]

    fn count_of(self, t: int) => int:
        if self.kind[t] == int(Ty.Named):
            return self.c[t]
        return self.b[t]

    fn is_int(self, t: int) => bool:
        return self.kind[t] == int(Ty.Int)

    fn is_numeric(self, t: int) => bool:
        return self.kind[t] == int(Ty.Int) || self.kind[t] == int(Ty.Float)

    fn is_error(self, t: int) => bool:
        return self.kind[t] == int(Ty.Error)

    /#/ Resources move and are dropped; values are copied. A `&T` is a value.
    fn is_resource(self, t: int) => bool:
        let k = self.kind[t]
        if k == int(Ty.Str) || k == int(Ty.Buf) || k == int(Ty.Slice) || k == int(Ty.Object) || k == int(Ty.Named):
            return true
        if k == int(Ty.Array):
            return self.is_resource(self.a[t])
        if k == int(Ty.Tuple):
            for i in 0..self.b[t]:
                if self.is_resource(self.arg(t, i)):
                    return true
        return false

fn new_tys() => Tys:
    let t = Tys { kind: new_buf(int, 32), a: new_buf(int, 32), b: new_buf(int, 32), c: new_buf(int, 32), hash: new_buf(int, 32), bh: new_buf(int, 16384), bn: new_buf(int, 32), n: 0, args: new_buf(int, 32), args_n: 0, pos: 0, params: 0, half: 0 }
    /#/ id 0 is the Error type, so that a zeroed slot reads as "already reported"
    t.simple(int(Ty.Error))
    return t


/#/ The number spelled by integer token `tok`.
fn tok_number(a: &Ast, tok: int) => int:
    let n = 0
    for k in a.toks.start[tok]..a.toks.end[tok]:
        let b = a.byte_at(k)
        if b >= '0' && b <= '9':
            n = n * 10 + (b - '0')
    return n

/#/ Text built a byte at a time.
class Out:
    b: buf<int>
    n: int

    fn put_byte(self, c: int) => void:
        if self.n >= len(self.b):
            self.b = buf_resize(self.b, (self.n + 1) * 2)
        self.b[self.n] = c
        self.n = self.n + 1

    fn put(self, s: &str) => void:
        for i in 0..len(s):
            self.put_byte(byte(s, i))

    fn put_int(self, v: int) => void:
        if v < 0:
            self.put_byte('-')
            self.put_int(0 - v)
        elif v < 10:
            self.put_byte('0' + v)
        else:
            self.put_int(v // 10)
            self.put_byte('0' + v % 10)

    fn put_row(self, g: &Syms, i: int) => void:
        for k in 0..g.size[i]:
            self.put_byte(g.pool[g.off[i] + k])

    /#/ Does the text equal `want`?
    fn is(self, want: &str) => bool:
        if self.n != len(want):
            return false
        for i in 0..self.n:
            if self.b[i] != byte(want, i):
                return false
        return true

fn new_out() => Out:
    return Out { b: new_buf(int, 64), n: 0 }

/#/ Writes a readable spelling of type `x`, for messages and tests.
fn show(o: &Out, t: &Tys, g: &Syms, x: int) => void:
    if x < 0:
        o.put("_")
        return
    let k = t.kind[x]
    if k == int(Ty.Error):
        o.put("?")
    elif k == int(Ty.Void):
        o.put("void")
    elif k == int(Ty.Bool):
        o.put("bool")
    elif k == int(Ty.Str):
        o.put("str")
    elif k == int(Ty.Object):
        o.put("object")
    elif k == int(Ty.Int):
        o.put("int(")
        o.put_int(t.a[x])
        if t.b[x] == 1:
            o.put(")+")
        else:
            o.put(")-")
    elif k == int(Ty.Float):
        o.put("float(")
        o.put_int(t.a[x])
        o.put(")")
    elif k == int(Ty.Buf):
        if t.a[x] < 0:
            o.put("buf")
        else:
            o.put("buf<")
            show(o, t, g, t.a[x])
            o.put(">")
    elif k == int(Ty.Slice):
        o.put("[")
        show(o, t, g, t.a[x])
        o.put("]")
    elif k == int(Ty.Array):
        o.put("[")
        show(o, t, g, t.a[x])
        o.put("; ")
        o.put_int(t.b[x])
        o.put("]")
    elif k == int(Ty.Ref):
        if t.b[x] == 1:
            o.put("&mut ")
        else:
            o.put("&")
        show(o, t, g, t.a[x])
    elif k == int(Ty.Tuple):
        o.put("(")
        show_list(o, t, g, x)
        o.put(")")
    elif k == int(Ty.Fn):
        o.put("fn(")
        show_list(o, t, g, x)
        o.put(") => ")
        show(o, t, g, t.c[x])
    elif k == int(Ty.Named):
        o.put_row(g, t.a[x])
        if t.c[x] > 0:
            o.put("<")
            show_list(o, t, g, x)
            o.put(">")
    elif k == int(Ty.Param):
        o.put("T")
        o.put_int(t.a[x])
    else:
        o.put("?")

fn show_list(o: &Out, t: &Tys, g: &Syms, x: int) => void:
    for i in 0..t.count_of(x):
        if i > 0:
            o.put(", ")
        show(o, t, g, t.arg(x, i))


class Reader:
    sc: Checker

    /#/ The type spelled by the name `tok` in a scope: a builtin, class, enum or alias. Error when
    /#/ it names none of them (the analyzer reports that).
    fn named_ty(self, t: &Tys, a: &Ast, tok: int) => int:
        if tok_is(a, tok, "int") || tok_is(a, tok, "i64"):
            return t.int_ty(8, true)
        if tok_is(a, tok, "i8"):
            return t.int_ty(1, true)
        if tok_is(a, tok, "i16"):
            return t.int_ty(2, true)
        if tok_is(a, tok, "i32"):
            return t.int_ty(4, true)
        if tok_is(a, tok, "u8"):
            return t.int_ty(1, false)
        if tok_is(a, tok, "u16"):
            return t.int_ty(2, false)
        if tok_is(a, tok, "u32"):
            return t.int_ty(4, false)
        if tok_is(a, tok, "u64"):
            return t.int_ty(8, false)
        if tok_is(a, tok, "float") || tok_is(a, tok, "f64"):
            return t.float_ty(8)
        if tok_is(a, tok, "f32"):
            return t.float_ty(4)
        if tok_is(a, tok, "bool"):
            return t.simple(int(Ty.Bool))
        if tok_is(a, tok, "str") || tok_is(a, tok, "string"):
            return t.simple(int(Ty.Str))
        if tok_is(a, tok, "void"):
            return t.simple(int(Ty.Void))
        if tok_is(a, tok, "object"):
            return t.simple(int(Ty.Object))
        if tok_is(a, tok, "buf"):
            return t.buf_of(-1)
        let r = self.sc.loc.find_tok(a, tok, 0)
        if r < 0:
            return 0
        if self.sc.loc.kind[r] == int(Sk.Class) || self.sc.loc.kind[r] == int(Sk.Enum):
            return t.named(self.sc.loc.info[r])
        if self.sc.loc.kind[r] == int(Sk.Alias) && self.sc.loc.ty[r] >= 0:
            return self.sc.loc.ty[r]
        if self.sc.loc.kind[r] == int(Sk.TypeParam) && self.sc.loc.ty[r] >= 0:
            return self.sc.loc.ty[r]
        return 0

    /#/ Reads one type at `t.pos`.
    fn read_ty(self, t: &Tys, a: &Ast, end: int) => int:
        if t.pos >= end:
            return 0
        let k = a.toks.kind[t.pos]
        if k == int(Tk.Amp):
            t.set_pos(t.pos + 1)
            let mutable = false
            if t.pos < end && tok_is(a, t.pos, "mut"):
                mutable = true
                t.set_pos(t.pos + 1)
            let target = self.read_ty(t, a, end)
            return t.ref_to(target, mutable)
        if k == int(Tk.LBracket):
            t.set_pos(t.pos + 1)
            let elem = self.read_ty(t, a, end)
            let result = t.slice_of(elem)
            if t.pos < end && a.toks.kind[t.pos] == int(Tk.Semi):
                t.set_pos(t.pos + 1)
                let count = -1
                if t.pos < end && a.toks.kind[t.pos] == int(Tk.Int):
                    count = tok_number(a, t.pos)
                t.set_pos(t.pos + 1)
                result = t.array_of(elem, count)
            if t.pos < end && a.toks.kind[t.pos] == int(Tk.RBracket):
                t.set_pos(t.pos + 1)
            return result
        if k == int(Tk.LParen):
            t.set_pos(t.pos + 1)
            let items = self.read_list(t, a, end, int(Tk.RParen))
            /#/ `()` is the type of nothing
            if items == 0:
                return t.simple(int(Ty.Void))
            return t.intern(int(Ty.Tuple), 0, items, 0, t.args_n - items)
        if k == int(Tk.KwFn):
            t.set_pos(t.pos + 1)
            let items = 0
            if t.pos < end && a.toks.kind[t.pos] == int(Tk.LParen):
                t.set_pos(t.pos + 1)
                items = self.read_list(t, a, end, int(Tk.RParen))
            let start = t.args_n - items
            let ret = t.simple(int(Ty.Void))
            if t.pos < end && a.toks.kind[t.pos] == int(Tk.Arrow):
                t.set_pos(t.pos + 1)
                ret = self.read_ty(t, a, end)
            return t.intern(int(Ty.Fn), 0, items, ret, start)
        if k == int(Tk.KwInt) || k == int(Tk.KwFloat):
            let is_flt = k == int(Tk.KwFloat)
            t.set_pos(t.pos + 1)
            let bytes = 8
            let signed = true
            if t.pos + 2 < end && a.toks.kind[t.pos] == int(Tk.LParen) && a.toks.kind[t.pos + 1] == int(Tk.Int):
                bytes = tok_number(a, t.pos + 1)
                t.set_pos(t.pos + 3)
                if !is_flt && t.pos < end:
                    if a.toks.kind[t.pos] == int(Tk.Minus):
                        signed = false
                        t.set_pos(t.pos + 1)
                    elif a.toks.kind[t.pos] == int(Tk.Plus):
                        t.set_pos(t.pos + 1)
            if is_flt:
                return t.float_ty(bytes)
            return t.int_ty(bytes, signed)
        let name = t.pos
        t.set_pos(t.pos + 1)
        if t.pos < end && a.toks.kind[t.pos] == int(Tk.Lt):
            t.set_pos(t.pos + 1)
            let before = t.args_n
            let items = self.read_list(t, a, end, int(Tk.Gt))
            let start = t.args_n - items
            if tok_is(a, name, "buf") && items == 1:
                let elem = t.args[start]
                t.set_args_n(start)
                return t.buf_of(elem)
            let base = self.named_ty(t, a, name)
            if t.kind[base] == int(Ty.Named):
                return t.intern(int(Ty.Named), t.a[base], 0, items, start)
            t.set_args_n(before)
            return 0
        return self.named_ty(t, a, name)

    /#/ Reads comma-separated types up to the token `close`, pushes them as arguments and returns
    /#/ how many there were.
    fn read_list(self, t: &Tys, a: &Ast, end: int, close: int) => int:
        /#/ nested lists push their own arguments while this one is being read, so each
        /#/ element is collected first and pushed after
        let found = new_buf(int, 8)
        let count = 0
        while t.pos < end && a.toks.kind[t.pos] != close && !(close == int(Tk.Gt) && a.toks.kind[t.pos] == int(Tk.Shr)):
            let before = t.pos
            let item = self.read_ty(t, a, end)
            if count >= len(found):
                found = buf_resize(found, count * 2 + 2)
            found[count] = item
            count = count + 1
            if t.pos < end && a.toks.kind[t.pos] == int(Tk.Comma):
                t.set_pos(t.pos + 1)
            if t.pos == before:
                break
        if t.pos < end && close == int(Tk.Gt) && a.toks.kind[t.pos] == int(Tk.Shr):
            /#/ `>>` closes two lists: the first takes half of it, the second the rest
            if t.half == 1:
                t.set_half(0)
                t.set_pos(t.pos + 1)
            else:
                t.set_half(1)
        elif t.pos < end && a.toks.kind[t.pos] == close:
            t.set_pos(t.pos + 1)
        for i in 0..count:
            t.push_arg(found[i])
        return count

    /#/ The type a TypeRef node spells.
    fn from_ref(self, t: &Tys, a: &Ast, node: int) => int:
        if node < 0:
            return 0
        t.set_pos(a.tok[node])
        return self.read_ty(t, a, a.end[node])

    /#/ Gives the type parameters among `f`'s children the numbers 0, 1, … in `scope` and returns
    /#/ the scope mark to pop back to.
    fn bind_params(self, t: &Tys, a: &Ast, f: int) => int:
        let mark = self.sc.loc.n
        let k = 0
        let p = a.child[f]
        while p >= 0:
            if a.kind[p] == int(Nk.TypeParam):
                let r = self.sc.loc.add_tok(a, a.tok[p], int(Sk.TypeParam), -1, -1)
                self.sc.loc.ty[r] = t.param_ty(k)
                k = k + 1
            p = a.next[p]
        return mark

    /#/ The function type of `f` seen from `scope`; a method gets `&mut Class` first.
    fn fn_sig(self, t: &Tys, a: &Ast, f: int, class_ty: int) => int:
        let mark = self.bind_params(t, a, f)
        let items = new_buf(int, 8)
        let count = 0
        let p = a.child[f]
        while p >= 0:
            if a.kind[p] == int(Nk.Param):
                if count >= len(items):
                    items = buf_resize(items, count * 2)
                items[count] = self.from_ref(t, a, a.pa[p])
                count = count + 1
            elif a.kind[p] == int(Nk.SelfParam):
                /#/ `self` is the class itself (a method borrows it)
                if count >= len(items):
                    items = buf_resize(items, count * 2)
                if class_ty >= 0:
                    items[count] = class_ty
                else:
                    items[count] = 0
                count = count + 1
            p = a.next[p]
        let ret = t.simple(int(Ty.Void))
        if a.pb[f] >= 0:
            ret = self.from_ref(t, a, a.pb[f])
        let start = t.args_n
        for i in 0..count:
            t.push_arg(items[i])
        self.sc.loc.truncate(mark)
        return t.intern(int(Ty.Fn), 0, count, ret, start)

/#/ What the type checker reports. The numbers are the Rust compiler's.
enum Te:
    Mismatch
    UnknownType
    ArityMismatch
    InvalidOperation
    NotCallable
    FieldNotFound
    MethodNotFound
    VariantNotFound
    InvalidType
    ControlFlow
    NonExhaustive

fn te_number(code: int) => int:
    if code == int(Te.Mismatch):
        return 100
    if code == int(Te.UnknownType):
        return 101
    if code == int(Te.ArityMismatch):
        return 103
    if code == int(Te.InvalidOperation):
        return 104
    if code == int(Te.NotCallable):
        return 105
    if code == int(Te.FieldNotFound):
        return 106
    if code == int(Te.MethodNotFound):
        return 107
    if code == int(Te.VariantNotFound):
        return 108
    if code == int(Te.InvalidType):
        return 110
    if code == int(Te.ControlFlow):
        return 111
    return 112

/#/ A finding: the token it is about, its code and, for a mismatch, the two types.
class TDiags:
    tok: buf<int>
    code: buf<int>
    want: buf<int>
    found: buf<int>
    n: int

    fn add(self, tok: int, code: int, want: int, found: int) => void:
        if self.n >= len(self.tok):
            let cap = (self.n + 1) * 2
            self.tok = buf_resize(self.tok, cap)
            self.code = buf_resize(self.code, cap)
            self.want = buf_resize(self.want, cap)
            self.found = buf_resize(self.found, cap)
        self.tok[self.n] = tok
        self.code[self.n] = code
        self.want[self.n] = want
        self.found[self.n] = found
        self.n = self.n + 1

    fn count(self, code: int) => int:
        let c = 0
        for i in 0..self.n:
            if self.code[i] == code:
                c = c + 1
        return c

fn new_tdiags() => TDiags:
    return TDiags { tok: new_buf(int, 8), code: new_buf(int, 8), want: new_buf(int, 8), found: new_buf(int, 8), n: 0 }


/#/ The row of `g` that declares the member of class or enum `owner` named by `tok`, of kind
/#/ `kind`; -1 when there is none.
fn member_of(g: &Syms, a: &Ast, owner: int, tok: int, kind: int) => int:
    let s = a.toks.start[tok]
    let e = a.toks.end[tok]
    let h = g.span_hash(a, s, e)
    let best = -1
    let q = g.member_head(owner) - 1
    while q >= 0:
        if g.kind[q] == kind && (best < 0 || q < best) && g.same_span(q, a, s, e, h):
            best = q
        q = g.member_next(q) - 1
    return best

/#/ Declares the types of module `m`, whose tree is `a`. The modules it imports from must be
/#/ declared first.
/#/ Signatures of the bundled C functions go to their `Extern` rows (`info` is 1 for a variadic
/#/ one), once per table; they come from the `.cfc` text the way a module's own do.
fn declare_c(t: &Tys, g: &Syms) => void:
    for i in 0..g.n:
        if g.kind[i] == int(Sk.Extern) && g.mod[i] == -1 && g.ty[i] >= 0:
            return
    declare_c_lib(t, g, c_libc_source(), "libc.cfc", true)
    declare_c_lib(t, g, c_libm_source(), "libm.cfc", true)
    declare_error(t, g)

/#/ The fields of the builtin class `Error`: `code: int`, `note: str`, `e: object`.
fn declare_error(t: &Tys, g: &Syms) => void:
    for i in 0..g.n:
        if g.kind[i] == int(Sk.Class) && g.mod[i] == -1 && g.size[i] == 5 && g.pool[g.off[i]] == 'E' && g.pool[g.off[i] + 4] == 'r':
            for f in 0..g.n:
                if g.info[f] == i && g.kind[f] == int(Sk.Field) && g.mod[f] == -1:
                    let c = g.pool[g.off[f]]
                    if c == 'c':
                        g.ty[f] = t.int_ty(8, true)
                    elif c == 'n':
                        g.ty[f] = t.simple(int(Ty.Str))
                    else:
                        g.ty[f] = t.simple(int(Ty.Object))

/#/ The C functions a program's own `.cfc` text declares (the texts of all its C libraries
/#/ together): they become `Extern` rows like the bundled ones. A name the bundled tables have
/#/ keeps its signature.
fn declare_user_cfc(t: &Tys, g: &Syms, src: str, name: &str) => void:
    declare_c(t, g)
    declare_c_lib(t, g, src, name, false)

fn declare_c_lib(t: &Tys, g: &Syms, src: str, name: &str, bundled: bool) => void:
    let a = parse(src)
    let m = declare_module(g, &a, name)
    declare_module_types(t, g, &a, m)
    let it = a.child[a.root]
    /#/ a type the `.cfc` declares (`type FILE: object`) is visible to every program
    while it >= 0:
        if a.kind[it] == int(Nk.TypeAlias) && a.pa[it] >= 0:
            let r = g.find_in_module(&a, a.pa[it], m)
            if r >= 0 && g.ty[r] >= 0:
                let w = g.add_tok(&a, a.pa[it], int(Sk.Alias), -1, -1)
                g.ty[w] = g.ty[r]
        it = a.next[it]
    it = a.child[a.root]
    while it >= 0:
        if a.kind[it] == int(Nk.Fn) && a.pa[it] >= 0:
            let r = g.find_in_module(&a, a.pa[it], m)
            if r >= 0 && g.ty[r] >= 0:
                let sig = g.ty[r]
                let count = t.count_of(sig)
                let variadic = false
                if count > 0 && t.kind[t.arg(sig, count - 1)] == int(Ty.Object):
                    let last = a.child[it]
                    let name_tok = -1
                    while last >= 0:
                        if a.kind[last] == int(Nk.Param):
                            name_tok = a.tok[last]
                        last = a.next[last]
                    if name_tok >= 0 && tok_is(&a, name_tok, "args"):
                        variadic = true
                if variadic:
                    let start = t.args_n
                    for k in 0..count - 1:
                        t.push_arg(t.arg(sig, k))
                    sig = t.intern(int(Ty.Fn), 0, count - 1, t.c[sig], start)
                let tk = a.pa[it]
                let h = g.span_hash(&a, a.toks.start[tk], a.toks.end[tk])
                let known = false
                for e in 0..g.n:
                    if g.kind[e] == int(Sk.Extern) && g.mod[e] == -1 && g.same_span(e, &a, a.toks.start[tk], a.toks.end[tk], h):
                        known = true
                if !known:
                    g.add_tok(&a, tk, int(Sk.Extern), -1, -1)
                for e in 0..g.n:
                    if g.kind[e] == int(Sk.Extern) && g.mod[e] == -1 && g.same_span(e, &a, a.toks.start[tk], a.toks.end[tk], h):
                        if bundled || g.ty[e] < 0:
                            g.ty[e] = sig
                            if variadic:
                                g.info[e] = 1
        it = a.next[it]

fn declare_types(t: &Tys, g: &Syms, a: &Ast, m: int) => void:
    declare_c(t, g)
    declare_module_types(t, g, a, m)

fn declare_module_types(t: &Tys, g: &Syms, a: &Ast, m: int) => void:
    let rd = Reader { sc: scope_of(a, g, m) }
    let it = a.child[a.root]
    /#/ aliases first: signatures may spell them
    while it >= 0:
        if a.kind[it] == int(Nk.TypeAlias) && a.pa[it] >= 0:
            let r = g.find_in_module(a, a.pa[it], m)
            let aty = rd.from_ref(t, a, a.pb[it])
            if r >= 0:
                g.ty[r] = aty
            let s = rd.sc.loc.find_tok(a, a.pa[it], 0)
            if s >= 0:
                rd.sc.loc.ty[s] = aty
        it = a.next[it]
    it = a.child[a.root]
    while it >= 0:
        let k = a.kind[it]
        if k == int(Nk.Fn) && a.pa[it] >= 0:
            let r = g.find_in_module(a, a.pa[it], m)
            if r >= 0:
                g.ty[r] = rd.fn_sig(t, a, it, -1)
        elif k == int(Nk.Class) && a.pa[it] >= 0:
            declare_class(t, g, &rd, a, it, m)
        elif k == int(Nk.Enum) && a.pa[it] >= 0:
            declare_enum(t, g, &rd, a, it, m)
        elif k == int(Nk.Let) && a.pa[it] >= 0 && a.pb[it] >= 0:
            let r = g.find_in_module(a, a.pa[it], m)
            if r >= 0:
                g.ty[r] = rd.from_ref(t, a, a.pb[it])
        it = a.next[it]

fn count_params(a: &Ast, f: int) => int:
    let k = 0
    let p = a.child[f]
    while p >= 0:
        if a.kind[p] == int(Nk.TypeParam):
            k = k + 1
        p = a.next[p]
    return k

/#/ The type of `self` in a method of class row `ci`: the class, applied to its own type
/#/ parameters when it has some.
fn self_type(t: &Tys, g: &Syms, ci: int) => int:
    let n = g.ty[ci]
    if n <= 0:
        return t.named(g.info[ci])
    let start = t.args_n
    for i in 0..n:
        t.push_arg(t.param_ty(i))
    return t.intern(int(Ty.Named), g.info[ci], 0, n, start)

fn declare_class(t: &Tys, g: &Syms, rd: &Reader, a: &Ast, cl: int, m: int) => void:
    let ci = g.find_in_module(a, a.pa[cl], m)
    if ci < 0:
        return
    /#/ the class row's `ty` is its number of type parameters
    g.ty[ci] = count_params(a, cl)
    let self_ty = self_type(t, g, ci)
    let mark = rd.bind_params(t, a, cl)
    let f = a.child[cl]
    while f >= 0:
        if a.kind[f] == int(Nk.Field):
            let r = member_of(g, a, ci, a.tok[f], int(Sk.Field))
            if r >= 0:
                g.ty[r] = rd.from_ref(t, a, a.pa[f])
        elif a.kind[f] == int(Nk.Fn) && a.pa[f] >= 0:
            let r = member_of(g, a, ci, a.pa[f], int(Sk.Method))
            if r >= 0:
                g.ty[r] = rd.fn_sig(t, a, f, self_ty)
        f = a.next[f]
    rd.sc.loc.truncate(mark)

/#/ A variant is a value of the enum, or a function from its payload to the enum.
fn declare_enum(t: &Tys, g: &Syms, rd: &Reader, a: &Ast, en: int, m: int) => void:
    let ei = g.find_in_module(a, a.pa[en], m)
    if ei < 0:
        return
    let enum_ty = t.named(g.info[ei])
    let v = a.child[en]
    while v >= 0:
        if a.kind[v] == int(Nk.Variant):
            let r = member_of(g, a, ei, a.tok[v], int(Sk.Variant))
            let items = new_buf(int, 4)
            let count = 0
            let f = a.child[v]
            while f >= 0:
                if a.kind[f] == int(Nk.VField):
                    if count >= len(items):
                        items = buf_resize(items, count * 2)
                    items[count] = rd.from_ref(t, a, a.pa[f])
                    count = count + 1
                f = a.next[f]
            if r >= 0:
                if count == 0:
                    g.ty[r] = enum_ty
                else:
                    let start = t.args_n
                    for i in 0..count:
                        t.push_arg(items[i])
                    g.ty[r] = t.intern(int(Ty.Fn), 0, count, enum_ty, start)
        v = a.next[v]


enum Own:
    Copy
    Move
    Borrow
    Unknown

enum Drop:
    Nothing
    Free
    Elems
    Fields
    Variant
    Unknown

enum Clone:
    Bit
    Deep
    Shallow
    Never
    Unknown

/#/ `ty` with the type parameters replaced by the type arguments of `env`, a `Name<A, B>`.
fn subst_env(t: &Tys, ty: int, env: int) => int:
    if env < 0 || ty < 0 || t.kind[env] != int(Ty.Named):
        return ty
    let k = t.kind[ty]
    if k == int(Ty.Param):
        if t.a[ty] < t.count_of(env):
            return t.arg(env, t.a[ty])
        return 0
    if k == int(Ty.Ref):
        return t.ref_to(subst_env(t, t.a[ty], env), t.b[ty] == 1)
    if k == int(Ty.Slice):
        return t.slice_of(subst_env(t, t.a[ty], env))
    if k == int(Ty.Buf):
        if t.a[ty] < 0:
            return ty
        return t.buf_of(subst_env(t, t.a[ty], env))
    if k == int(Ty.Array):
        return t.array_of(subst_env(t, t.a[ty], env), t.b[ty])
    if k == int(Ty.Tuple) || k == int(Ty.Fn) || k == int(Ty.Named):
        let count = t.count_of(ty)
        let items = new_buf(int, count + 1)
        for i in 0..count:
            items[i] = subst_env(t, t.arg(ty, i), env)
        let start = t.args_n
        for i in 0..count:
            t.push_arg(items[i])
        if k == int(Ty.Tuple):
            return t.intern(int(Ty.Tuple), 0, count, 0, start)
        if k == int(Ty.Fn):
            return t.intern(int(Ty.Fn), 0, count, subst_env(t, t.c[ty], env), start)
        return t.intern(int(Ty.Named), t.a[ty], 0, count, start)
    return ty

/#/ Does enum `e` (a row of `g`) have a variant that carries values?
fn has_payload(t: &Tys, g: &Syms, e: int) => bool:
    let q = g.member_head(e) - 1
    while q >= 0:
        if g.kind[q] == int(Sk.Variant) && g.ty[q] >= 0 && t.kind[g.ty[q]] == int(Ty.Fn):
            return true
        q = g.member_next(q) - 1
    return false

/#/ Is the value of `x` a single pointer to a block it stands for?
fn is_handle(t: &Tys, g: &Syms, x: int) => bool:
    let k = t.kind[x]
    if k == int(Ty.Str) || k == int(Ty.Object) || k == int(Ty.Array):
        return true
    if k == int(Ty.Buf):
        return t.a[x] < 0
    if k == int(Ty.Named):
        if g.kind[t.a[x]] == int(Sk.Enum):
            return has_payload(t, g, t.a[x])
        return true
    return false

fn align_up(n: int, a: int) => int:
    if a <= 1:
        return n
    return (n + a - 1) // a * a

/#/ The alignment of a value of `x`; 1 when it has none.
fn st_align(t: &Tys, g: &Syms, x: int) => int:
    let k = t.kind[x]
    if k == int(Ty.Void) || k == int(Ty.Bool) || k == int(Ty.Error):
        return 1
    if k == int(Ty.Int) || k == int(Ty.Float):
        return t.a[x]
    if k == int(Ty.Tuple):
        let a = 1
        for i in 0..t.count_of(x):
            let fa = st_align(t, g, t.arg(x, i))
            if fa > a:
                a = fa
        return a
    return 8

/#/ The size of a value of `x`: what it takes in a register, a variable or a field.
fn st_size(t: &Tys, g: &Syms, x: int) => int:
    let k = t.kind[x]
    if k == int(Ty.Void) || k == int(Ty.Error):
        return 0
    if k == int(Ty.Bool):
        return 1
    if k == int(Ty.Int) || k == int(Ty.Float):
        return t.a[x]
    if k == int(Ty.Slice):
        return 16
    if k == int(Ty.Buf):
        if t.a[x] < 0:
            return 8
        return 16
    if k == int(Ty.Tuple):
        let n = 0
        for i in 0..t.count_of(x):
            let f = t.arg(x, i)
            n = align_up(n, st_align(t, g, f)) + st_size(t, g, f)
        return align_up(n, st_align(t, g, x))
    if k == int(Ty.Named) && g.kind[t.a[x]] == int(Sk.Enum) && !has_payload(t, g, t.a[x]):
        return 8
    return 8

/#/ The size of the block a handle points at; -1 when it is not known statically.
fn st_block(t: &Tys, g: &Syms, x: int) => int:
    let k = t.kind[x]
    if k == int(Ty.Array):
        if t.b[x] < 0:
            return -1
        return t.b[x] * st_size(t, g, t.a[x])
    if k == int(Ty.Named):
        if g.kind[t.a[x]] == int(Sk.Enum):
            return enum_block(t, g, x)
        return class_block(t, g, x, 0)
    return -1

/#/ A class's block: the fields of its ancestors, then its own. `mode` 0 gives the size, 1 the
/#/ alignment.
fn class_block(t: &Tys, g: &Syms, x: int, mode: int) => int:
    let chain = new_buf(int, 8)
    let n = 0
    let cur = t.a[x]
    while cur >= 0 && n < 8:
        chain[n] = cur
        n = n + 1
        let next = -1
        for i in 0..g.n:
            if g.info[i] == cur && g.kind[i] == int(Sk.Parent):
                next = g.find_class_row(i)
        cur = next
    let size = 0
    let align = 1
    let c = n - 1
    while c >= 0:
        for i in 0..g.n:
            if g.info[i] == chain[c] && g.kind[i] == int(Sk.Field) && g.ty[i] >= 0:
                let f = subst_env(t, g.ty[i], x)
                let fa = st_align(t, g, f)
                size = align_up(size, fa) + st_size(t, g, f)
                if fa > align:
                    align = fa
        c = c - 1
    if mode == 1:
        return align
    return align_up(size, align)

/#/ An enum with payloads is `{i64 tag, payload}`, as big as its biggest variant.
fn enum_block(t: &Tys, g: &Syms, x: int) => int:
    let best = 8
    for i in 0..g.n:
        if g.info[i] == t.a[x] && g.kind[i] == int(Sk.Variant) && g.ty[i] >= 0 && t.kind[g.ty[i]] == int(Ty.Fn):
            let v = g.ty[i]
            let n = 8
            for k in 0..t.count_of(v):
                let f = subst_env(t, t.arg(v, k), x)
                n = align_up(n, st_align(t, g, f)) + st_size(t, g, f)
            n = align_up(n, 8)
            if n > best:
                best = n
    return best

/#/ Copy, move or borrow.
fn st_own(t: &Tys, g: &Syms, x: int) => int:
    let k = t.kind[x]
    if k == int(Ty.Void) || k == int(Ty.Bool) || k == int(Ty.Int) || k == int(Ty.Float) || k == int(Ty.Fn):
        return int(Own.Copy)
    if k == int(Ty.Ref):
        return int(Own.Borrow)
    if k == int(Ty.Str) || k == int(Ty.Object) || k == int(Ty.Buf) || k == int(Ty.Slice):
        return int(Own.Move)
    if k == int(Ty.Array):
        return st_own(t, g, t.a[x])
    if k == int(Ty.Tuple):
        for i in 0..t.count_of(x):
            if st_own(t, g, t.arg(x, i)) != int(Own.Copy):
                return int(Own.Move)
        return int(Own.Copy)
    if k == int(Ty.Named):
        if g.kind[t.a[x]] == int(Sk.Enum) && !has_payload(t, g, t.a[x]):
            return int(Own.Copy)
        return int(Own.Move)
    return int(Own.Unknown)

/#/ What dropping a value of `x` does.
fn st_drop(t: &Tys, g: &Syms, x: int) => int:
    let k = t.kind[x]
    if k == int(Ty.Void) || k == int(Ty.Bool) || k == int(Ty.Int) || k == int(Ty.Float) || k == int(Ty.Fn) || k == int(Ty.Ref) || k == int(Ty.Object):
        return int(Drop.Nothing)
    if k == int(Ty.Str) || k == int(Ty.Buf):
        return int(Drop.Free)
    if k == int(Ty.Slice):
        return int(Drop.Elems)
    if k == int(Ty.Array):
        if st_own(t, g, x) == int(Own.Copy):
            return int(Drop.Nothing)
        return int(Drop.Elems)
    if k == int(Ty.Tuple):
        if st_own(t, g, x) == int(Own.Copy):
            return int(Drop.Nothing)
        return int(Drop.Fields)
    if k == int(Ty.Named):
        if g.kind[t.a[x]] == int(Sk.Enum):
            if has_payload(t, g, t.a[x]):
                return int(Drop.Variant)
            return int(Drop.Nothing)
        return int(Drop.Fields)
    return int(Drop.Unknown)

/#/ What `clone` of a value of `x` does.
fn st_clone(t: &Tys, g: &Syms, x: int) => int:
    let k = t.kind[x]
    if st_own(t, g, x) == int(Own.Copy):
        return int(Clone.Bit)
    if k == int(Ty.Buf):
        return int(Clone.Never)
    if k == int(Ty.Object) || k == int(Ty.Ref) || k == int(Ty.Slice):
        return int(Clone.Shallow)
    if k == int(Ty.Str) || k == int(Ty.Array) || k == int(Ty.Tuple) || k == int(Ty.Named):
        return int(Clone.Deep)
    return int(Clone.Unknown)

/#/ The LLVM type of a value of `x`, spelled out.
fn st_repr(o: &Out, t: &Tys, g: &Syms, x: int) => void:
    let k = t.kind[x]
    if k == int(Ty.Void):
        o.put("none")
    elif k == int(Ty.Bool):
        o.put("i8")
    elif k == int(Ty.Int):
        o.put("i")
        o.put_int(t.a[x] * 8)
    elif k == int(Ty.Float):
        o.put("f")
        o.put_int(t.a[x] * 8)
    elif k == int(Ty.Slice) || (k == int(Ty.Buf) && t.a[x] >= 0):
        o.put("{ptr, i64}")
    elif k == int(Ty.Tuple):
        o.put("{")
        for i in 0..t.count_of(x):
            if i > 0:
                o.put(", ")
            st_repr(o, t, g, t.arg(x, i))
        o.put("}")
    elif k == int(Ty.Named) && g.kind[t.a[x]] == int(Sk.Enum) && !has_payload(t, g, t.a[x]):
        o.put("i64")
    elif k == int(Ty.Error) || k == int(Ty.Param):
        o.put("?")
    else:
        o.put("ptr")

fn put_own(o: &Out, own: int) => void:
    if own == int(Own.Copy):
        o.put("copy")
        return
    if own == int(Own.Move):
        o.put("move")
        return
    if own == int(Own.Borrow):
        o.put("borrow")
        return
    o.put("?")

fn put_drop(o: &Out, d: int) => void:
    if d == int(Drop.Nothing):
        o.put("nothing")
        return
    if d == int(Drop.Free):
        o.put("free")
        return
    if d == int(Drop.Elems):
        o.put("elems")
        return
    if d == int(Drop.Fields):
        o.put("fields")
        return
    if d == int(Drop.Variant):
        o.put("variant")
        return
    o.put("?")

fn put_clone(o: &Out, c: int) => void:
    if c == int(Clone.Bit):
        o.put("bit")
        return
    if c == int(Clone.Deep):
        o.put("deep")
        return
    if c == int(Clone.Shallow):
        o.put("shallow")
        return
    if c == int(Clone.Never):
        o.put("never")
        return
    o.put("?")

/#/ `repr size/align own drop clone`, and `block N` for a handle with a known block.
fn describe(o: &Out, t: &Tys, g: &Syms, x: int) => void:
    st_repr(o, t, g, x)
    o.put(" ")
    o.put_int(st_size(t, g, x))
    o.put("/")
    o.put_int(st_align(t, g, x))
    o.put(" ")
    put_own(o, st_own(t, g, x))
    o.put(" ")
    put_drop(o, st_drop(t, g, x))
    o.put(" ")
    put_clone(o, st_clone(t, g, x))
    if is_handle(t, g, x) && st_block(t, g, x) >= 0:
        o.put(" block ")
        o.put_int(st_block(t, g, x))



class DbgTypes:
    done: buf<int>
    n: int
    out: Txt

fn new_dbg_types() => DbgTypes:
    return DbgTypes { done: new_buf(int, 64), n: 0, out: new_txt() }

/#/ Is the id new? Then it is entered.
fn dbg_new(d: &DbgTypes, id: int) => bool:
    for i in 0..d.n:
        if d.done[i] == id:
            return false
    if d.n >= len(d.done):
        d.done = buf_resize(d.done, (d.n + 1) * 2)
    d.done[d.n] = id
    d.n = d.n + 1
    return true

fn dbg_int(d: &DbgTypes) => int:
    if dbg_new(d, 3000000):
        d.out.put("T 3000000 i 8 1\n")
    return 3000000

fn dbg_ptr(d: &DbgTypes, id: int, target: int) => void:
    d.out.put("T ")
    d.out.put_int(id)
    d.out.put(" p ")
    d.out.put_int(target)
    d.out.put_byte(10)

fn dbg_put_name(d: &DbgTypes, g: &Syms, row: int) => void:
    for k in 0..g.size[row]:
        d.out.put_byte(g.pool[g.off[row] + k])

/#/ A pair of pointer and length as a struct.
fn dbg_pair(d: &DbgTypes, id: int, name: &str, elem: int) => void:
    let li = dbg_int(d)
    let pid = 2000000 + elem
    if dbg_new(d, pid):
        dbg_ptr(d, pid, elem)
    d.out.put("T ")
    d.out.put_int(id)
    d.out.put(" S ")
    d.out.put(name)
    d.out.put(" 16 2 ptr:")
    d.out.put_int(pid)
    d.out.put(":0 len:")
    d.out.put_int(li)
    d.out.put(":8\n")

/#/ The struct line of class `x` (the fields of its ancestors first), and the types of its fields.
fn dbg_class(d: &DbgTypes, t: &Tys, g: &Syms, x: int) => void:
    let chain = new_buf(int, 8)
    let n = 0
    let cur = t.a[x]
    while cur >= 0 && n < 8:
        chain[n] = cur
        n = n + 1
        let next = -1
        for i in 0..g.n:
            if g.info[i] == cur && g.kind[i] == int(Sk.Parent):
                next = g.find_class_row(i)
        cur = next
    let fields = new_txt()
    let nf = 0
    let size = 0
    let c = n - 1
    while c >= 0:
        for i in 0..g.n:
            if g.info[i] == chain[c] && g.kind[i] == int(Sk.Field) && g.ty[i] >= 0:
                let f = subst_env(t, g.ty[i], x)
                let fid = dbg_type(d, t, g, f)
                size = align_up(size, st_align(t, g, f))
                fields.put_byte(32)
                for k in 0..g.size[i]:
                    fields.put_byte(g.pool[g.off[i] + k])
                fields.put_byte(58)
                fields.put_int(fid)
                fields.put_byte(58)
                fields.put_int(size)
                size = size + st_size(t, g, f)
                nf = nf + 1
        c = c - 1
    d.out.put("T ")
    d.out.put_int(x)
    d.out.put(" S ")
    dbg_put_name(d, g, t.a[x])
    d.out.put_byte(32)
    d.out.put_int(align_up(size, st_align(t, g, x)))
    d.out.put_byte(32)
    d.out.put_int(nf)
    d.out.put_all(&fields)
    d.out.put_byte(10)

/#/ The block of enum `x` that has payloads: the tag, and each variant's payload over the same bytes
/#/ (only the variant the tag names holds values).
fn dbg_enum(d: &DbgTypes, t: &Tys, g: &Syms, x: int) => void:
    let row = t.a[x]
    let li = dbg_int(d)
    let members = new_txt()
    let nm = 0
    for v in 0..g.n:
        if g.info[v] == row && g.kind[v] == int(Sk.Variant):
            let sig = g.ty[v]
            if sig >= 0 && t.kind[sig] == int(Ty.Fn) && t.count_of(sig) > 0:
                let fields = new_txt()
                let off = 8
                for i in 0..t.count_of(sig):
                    let ft = subst_env(t, t.arg(sig, i), x)
                    let fid = dbg_type(d, t, g, ft)
                    off = align_up(off, st_align(t, g, ft))
                    fields.put(" _")
                    fields.put_int(i)
                    fields.put_byte(58)
                    fields.put_int(fid)
                    fields.put_byte(58)
                    fields.put_int(off)
                    off = off + st_size(t, g, ft)
                let sid = 5000000 + x * 64 + nm
                d.out.put("T ")
                d.out.put_int(sid)
                d.out.put(" S ")
                dbg_put_name(d, g, v)
                d.out.put_byte(32)
                d.out.put_int(off)
                d.out.put_byte(32)
                d.out.put_int(t.count_of(sig))
                d.out.put_all(&fields)
                d.out.put_byte(10)
                members.put_byte(32)
                for k in 0..g.size[v]:
                    members.put_byte(g.pool[g.off[v] + k])
                members.put_byte(58)
                members.put_int(sid)
                members.put(":0")
                nm = nm + 1
    d.out.put("T ")
    d.out.put_int(4000000 + x)
    d.out.put(" S ")
    dbg_put_name(d, g, row)
    d.out.put_byte(32)
    d.out.put_int(st_block(t, g, x))
    d.out.put_byte(32)
    d.out.put_int(nm + 1)
    d.out.put(" tag:")
    d.out.put_int(li)
    d.out.put(":0")
    d.out.put_all(&members)
    d.out.put_byte(10)

/#/ Describes type `x` and what it names, once; the id a variable of this type has.
fn dbg_type(d: &DbgTypes, t: &Tys, g: &Syms, x: int) => int:
    let k = t.kind[x]
    if k == int(Ty.Void) || k == int(Ty.Error):
        return 0 - 1
    let id = x
    if k == int(Ty.Named) && g.kind[t.a[x]] != int(Sk.Enum):
        id = 1000000 + x
    if !dbg_new(d, id):
        return id
    if k == int(Ty.Int):
        d.out.put("T ")
        d.out.put_int(id)
        d.out.put(" i ")
        d.out.put_int(t.a[x])
        d.out.put_byte(32)
        d.out.put_int(t.b[x])
        d.out.put_byte(10)
    elif k == int(Ty.Float):
        d.out.put("T ")
        d.out.put_int(id)
        d.out.put(" f ")
        d.out.put_int(t.a[x])
        d.out.put_byte(10)
    elif k == int(Ty.Bool):
        d.out.put("T ")
        d.out.put_int(id)
        d.out.put(" b\n")
    elif k == int(Ty.Str):
        d.out.put("T ")
        d.out.put_int(id)
        d.out.put(" s\n")
    elif k == int(Ty.Ref):
        let inner = t.a[x]
        let target = dbg_type(d, t, g, inner)
        if t.kind[inner] == int(Ty.Named) && g.kind[t.a[inner]] != int(Sk.Enum):
            /#/ a reference to a class is the class's own pointer
            target = inner
        elif t.kind[inner] == int(Ty.Named) && has_payload(t, g, t.a[inner]):
            target = 4000000 + inner
        dbg_ptr(d, id, target)
    elif k == int(Ty.Array):
        let target = dbg_type(d, t, g, t.a[x])
        dbg_ptr(d, id, target)
    elif k == int(Ty.Buf) && t.a[x] >= 0:
        let elem = dbg_type(d, t, g, t.a[x])
        dbg_pair(d, id, "buf", elem)
    elif k == int(Ty.Slice):
        let elem = dbg_type(d, t, g, t.a[x])
        dbg_pair(d, id, "slice", elem)
    elif k == int(Ty.Tuple):
        let fields = new_txt()
        let off = 0
        for i in 0..t.count_of(x):
            let f = t.arg(x, i)
            let fid = dbg_type(d, t, g, f)
            off = align_up(off, st_align(t, g, f))
            fields.put(" _")
            fields.put_int(i)
            fields.put_byte(58)
            fields.put_int(fid)
            fields.put_byte(58)
            fields.put_int(off)
            off = off + st_size(t, g, f)
        d.out.put("T ")
        d.out.put_int(id)
        d.out.put(" S tuple ")
        d.out.put_int(st_size(t, g, x))
        d.out.put_byte(32)
        d.out.put_int(t.count_of(x))
        d.out.put_all(&fields)
        d.out.put_byte(10)
    elif k == int(Ty.Named) && g.kind[t.a[x]] == int(Sk.Enum):
        if has_payload(t, g, t.a[x]):
            dbg_ptr(d, id, 4000000 + x)
            if dbg_new(d, 4000000 + x):
                dbg_enum(d, t, g, x)
        else:
            d.out.put("T ")
            d.out.put_int(id)
            d.out.put(" i 8 0\n")
    elif k == int(Ty.Named):
        /#/ the variable holds a pointer to the struct
        dbg_ptr(d, id, x)
        if dbg_new(d, x):
            dbg_class(d, t, g, x)
    elif k == int(Ty.Object) || k == int(Ty.Buf):
        dbg_ptr(d, id, 0 - 1)
    else:
        d.out.put("T ")
        d.out.put_int(id)
        d.out.put(" o ")
        d.out.put_int(st_size(t, g, x))
        d.out.put_byte(10)
    return id


fn int_reg(k: int) => int:
    if k == 0:
        return 7
    if k == 1:
        return 6
    if k == 2:
        return 2
    if k == 3:
        return 1
    if k == 4:
        return 8
    return 9

fn round8(n: int) => int:
    return (n + 7) // 8 * 8

class Gen:
    a: Asm
    o: Obj
    /#/ the place of each value, as the distance below rbp; for a `slot` its area
    voff: buf<int>
    /#/ sandbox code: 1 for a value whose bytes are in the shadow frame (r14 + offset), not the host frame
    sh: buf<int>
    sframe: int
    tmp: int
    frame: int
    err: int
    av: buf<int>
    nav: int
    /#/ where the string literals are in .rodata, by number
    sbase: int
    soff: buf<int>
    nstr: int
    /#/ the register a value lives in, -1 for the frame; the registers used (saved in the prologue)
    home: buf<int>
    xhome: buf<int>
    /#/ the order the blocks of the function are emitted in
    ord: buf<int>
    emit: buf<int>
    xsg: buf<int>
    did: buf<int>
    nsaved: int
    /#/ 8 when [rbp-8] holds the pointer a function returning an aggregate was given, else 0
    rbase: int
    saved: buf<int>
    /#/ the edges leaving a block
    ed: buf<int>
    ned: int
    ra_lo: buf<int>
    ra_hi: buf<int>
    ra_wt: buf<int>
    /#/ the uses that are not of a value defined in the same block: value and block, `nuq` of them
    uq_d: buf<int>
    uq_b: buf<int>
    nuq: int
    /#/ per dense value: the block it is defined in, and whether its definition was passed in the scan of the uses
    ra_dblk: buf<int>
    ra_dset: buf<int>
    /#/ the positions of the instructions that call something, in order
    ra_cp: buf<int>
    ra_ncp: int
    /#/ per call position: the caller-saved registers (bit 0 r10, 1 r8, 2 r9, 3 r11, 4 rdi) the callee may write
    ra_cm: buf<int>
    /#/ the name id of the function being generated (-1: none), and per name id of a function of this
    /#/ object already generated, 8 + the registers it and everything it calls may write
    cur: int
    msk: buf<int>
    fmask: int
    /#/ how many times each value is used, counted again for the function being generated
    nuse: buf<int>
    /#/ the address a load or store was folded into: base, index (-1 if none), scale, displacement
    am_base: int
    am_idx: int
    am_scale: int
    am_disp: int
    /#/ the shared exit of a function that saves registers: its label, and whether a return jumps there
    epi: int
    epi_jump: bool
    /#/ float constants kept in an xmm register from the entry on (they are used in loops)
    hc: buf<int>
    nhc: int
    /#/ the source lines of the code: the offset in the text of the object where the code of a line
    /#/ starts, and the line (of the flattened text); `mk_*` are those of the function being made
    lm_at: buf<int>
    lm_ln: buf<int>
    lm_n: int
    mk_l: buf<int>
    mk_ln: buf<int>
    mk_n: int
    /#/ the functions with line marks: symbol, start in the text, first mark
    lf_sym: buf<int>
    lf_start: buf<int>
    lf_m0: buf<int>
    lf_n: int
    /#/ `-O0 -g`: the types, and the variables of each function with a line table (`V` lines; `vr_s`/`vr_e`
    /#/ say which part of `vtxt` is the one of function number `lf` k)
    dt: DbgTypes
    vtxt: Txt
    vr_s: buf<int>
    vr_e: buf<int>

    fn add_str(self, off: int) => void:
        if self.nstr >= len(self.soff):
            self.soff = buf_resize(self.soff, (self.nstr + 1) * 2)
        self.soff[self.nstr] = off
        self.nstr = self.nstr + 1

    fn add_rodata(self, t: &Txt) => void:
        self.o.ro.put_all(t)

    /#/ Makes `name` an object of `size` zero bytes in `.data`.
    fn add_global(self, name: &Txt, size: int) => void:
        self.o.define_data(self.o.sym(name), size)

    fn elf(self) => Txt:
        return write_elf(&self.o, &self.a)

    fn bad(self) => void:
        self.err = self.err + 1

    fn push_arg(self, v: int) => void:
        if self.nav >= len(self.av):
            self.av = buf_resize(self.av, (self.nav + 1) * 2)
        self.av[self.nav] = v
        self.nav = self.nav + 1

    /#/ ---- values ------------------------------------------------------------

    /#/ The value an operand stands for, through forwarding and `own.move`.
    fn res(self, f: &Fun, v: int) => int:
        let x = f.follow(v)
        while f.op[x] == int(Op.OwnMove):
            x = f.follow(f.a[x])
        return x

    /#/ reg = the value (a scalar, 8 bytes; narrower ones have meaningful low bytes only)
    fn ld(self, reg: int, f: &Fun, v: int) => void:
        let x = self.res(f, v)
        let k = f.op[x]
        if k == int(Op.Const):
            let r = f.rep[x]
            if r == int(Rp.F32):
                self.a.mov_ri(reg, f.aux[x] & 4294967295)
            else:
                self.a.mov_ri(reg, f.aux[x])
        elif k == int(Op.Undef):
            self.a.mov_ri(reg, 0)
        elif k == int(Op.StrLit):
            self.a.lea_rip(reg, 1, self.sbase + self.so(f.aux[x]))
        elif k == int(Op.Slot):
            self.a.lea(reg, self.vb(x), 0 - self.voff[x])
        elif self.home[x] >= 0:
            if self.home[x] != reg:
                self.a.mov_rr(reg, self.home[x])
        elif self.xhome[x] >= 0:
            self.a.movq_r(reg, self.xhome[x], self.xsg[x] == 1)
        else:
            self.a.load(reg, 5, 0 - self.voff[x], 8)

    fn so(self, id: int) => int:
        return self.soff[id]

    /#/ The base register of the bytes of value `x`: rbp, or r14 for the shadow frame of sandbox code.
    fn vb(self, x: int) => int:
        if self.a.sbx && self.sh[x] == 1:
            return 14
        return 5

    /#/ The register that holds `v`: its own when it has one, else `scratch`, loaded with it.
    fn src(self, f: &Fun, v: int, scratch: int) => int:
        let h = self.home[self.res(f, v)]
        if h >= 0:
            return h
        self.ld(scratch, f, v)
        return scratch

    /#/ The register of `v` when it has one, else -1.
    fn home_of(self, f: &Fun, v: int) => int:
        return self.home[self.res(f, v)]

    /#/ reg = the value extended from its width
    fn ld_ext(self, reg: int, f: &Fun, v: int, signed: bool) => void:
        self.ld(reg, f, v)
        let x = self.res(f, v)
        let r = f.rep[x]
        if f.op[x] == int(Op.Cmp):
            /#/ the result of a compare is 0 or 1 in a whole register already
            return
        if r == int(Rp.I8) || r == int(Rp.I16) || r == int(Rp.I32):
            self.a.extend(reg, reg, rsize_scalar(r), signed)

    /#/ mov [rbp - place of i], reg
    fn st(self, i: int, reg: int) => void:
        if self.home[i] >= 0:
            if self.home[i] != reg:
                self.a.mov_rr(self.home[i], reg)
        elif self.xhome[i] >= 0:
            self.a.movq_x(self.xhome[i], reg, self.xsg[i] == 1)
        else:
            self.a.store(5, 0 - self.voff[i], reg, 8)

    /#/ The xmm register of float `v`: its own when it has one, else `scratch`, loaded with it.
    fn xsrc(self, f: &Fun, v: int, scratch: int) => int:
        let x = self.res(f, v)
        if self.xhome[x] >= 0:
            return self.xhome[x]
        self.ld(0, f, x)
        self.a.movq_x(scratch, 0, f.rep[x] == int(Rp.F32))
        return scratch

    /#/ Where instruction `i` (a float) makes its result: its xmm register, else xmm0.
    fn xdst(self, i: int) => int:
        if self.xhome[i] >= 0:
            return self.xhome[i]
        return 0

    /#/ The result of instruction `i` is in xmm `x`: kept there, or stored.
    fn xfin(self, f: &Fun, i: int, x: int) => void:
        if self.xhome[i] >= 0:
            if self.xhome[i] != x:
                self.a.movaps(self.xhome[i], x)
        else:
            self.a.movq_r(0, x, f.rep[i] == int(Rp.F32))
            self.st(i, 0)

    /#/ For an aggregate value: the base register and displacement of its bytes.
    fn ab_reg(self, f: &Fun, v: int) => int:
        let x = self.res(f, v)
        if f.op[x] == int(Op.Undef):
            self.a.lea_rip(6, 1, 0)
            return 6
        return self.vb(x)

    fn ab_disp(self, f: &Fun, v: int) => int:
        let x = self.res(f, v)
        if f.op[x] == int(Op.Undef):
            return 0
        return 0 - self.voff[x]

    /#/ n bytes from [sb + sd] to [db + dd], through rax.
    fn copy_mem(self, db: int, dd: int, sb: int, sd: int, n: int) => void:
        let k = 0
        while k + 8 <= n:
            self.a.load(0, sb, sd + k, 8)
            self.a.store(db, dd + k, 0, 8)
            k = k + 8
        if k + 4 <= n:
            self.a.load(0, sb, sd + k, 4)
            self.a.store(db, dd + k, 0, 4)
            k = k + 4
        if k + 2 <= n:
            self.a.load(0, sb, sd + k, 2)
            self.a.store(db, dd + k, 0, 2)
            k = k + 2
        if k < n:
            self.a.load(0, sb, sd + k, 1)
            self.a.store(db, dd + k, 0, 1)

    /#/ Value `v` to [db + dd], in full: a scalar as 8 bytes, an aggregate as its layout.
    fn val_to(self, f: &Fun, rs: &Reps, db: int, dd: int, v: int) => void:
        let x = self.res(f, v)
        let r = f.rep[x]
        if r >= rp_first_agg():
            let sb = self.ab_reg(f, x)
            self.copy_mem(db, dd, sb, self.ab_disp(f, x), rsize(rs, r))
        elif self.home[x] >= 0:
            self.a.store(db, dd, self.home[x], 8)
        else:
            self.ld(0, f, x)
            self.a.store(db, dd, 0, 8)

    /#/ ---- registers -----------------------------------------------------------

    /#/ The saved registers come back by pop, from below the frame's locals.
    fn epilogue(self) => void:
        if self.sframe > 0:
            self.a.add_ri(14, self.sframe)
        if self.nsaved > 0:
            if self.frame > self.rbase + 8 * self.nsaved:
                self.a.lea(4, 5, 0 - self.rbase - 8 * self.nsaved)
            let k = self.nsaved - 1
            while k >= 0:
                self.a.pop(self.saved[k])
                k = k - 1
        self.a.leave()
        self.a.ret()

    /#/ Can value `v` live in a register? Scalars made by instructions or block parameters.
    fn wants_reg(self, f: &Fun, v: int) => bool:
        if f.fwd[v] >= 0:
            return false
        let r = f.rep[v]
        if r == int(Rp.Void) || r >= rp_first_agg():
            return false
        let op = f.op[v]
        return !(op == int(Op.Slot) || op == int(Op.Const) || op == int(Op.StrLit) || op == int(Op.Undef) || op == int(Op.OwnMove))

    /#/ Does instruction `i` make a call (so that the registers a callee may write are lost)?
    fn is_clobber(self, f: &Fun, i: int) => bool:
        let op = f.op[i]
        if self.uses_rdi(f, i):
            return true
        return op == int(Op.Call) || op == int(Op.CCall) || op == int(Op.CallI) || op == int(Op.Drop) || op == int(Op.Clone) || op == int(Op.Alloc) || op == int(Op.Free) || op == int(Op.FRem)

    /#/ Does instruction `i` use rdi as a scratch register (the aggregate store and return)?
    fn uses_rdi(self, f: &Fun, i: int) => bool:
        let op = f.op[i]
        if op == int(Op.Store) && f.rep[self.res(f, f.b[i])] >= rp_first_agg():
            return true
        return op == int(Op.Ret) && f.a[i] >= 0 && f.rep[self.res(f, f.a[i])] >= rp_first_agg()

    /#/ The caller-saved registers that the call `i` may write: all of them unless it is a call of a
    /#/ function of this object that was generated before (then what that one writes), and r8 and r9
    /#/ when its arguments go through them.
    fn site_mask(self, f: &Fun, i: int) => int:
        if self.uses_rdi(f, i):
            return 16
        if f.op[i] != int(Op.Call):
            return 31
        let id = f.aux[i]
        let m = 31
        if id >= 0 && id < len(self.msk) && self.msk[id] > 0:
            m = self.msk[id] - 8
        if f.b[i] >= 5:
            m = m | 2
        if f.b[i] >= 6:
            m = m | 4
        if f.rep[i] >= rp_first_agg():
            m = m | 2
        if f.b[i] >= 1 || f.rep[i] >= rp_first_agg():
            m = m | 16
        return m

    /#/ The registers written by the calls strictly between positions `lo` and `hi`.
    fn cm_in(self, lo: int, hi: int) => int:
        let a = 0
        let b = self.ra_ncp
        while a < b:
            let mid = (a + b) // 2
            if self.ra_cp[mid] > lo:
                b = mid
            else:
                a = mid + 1
        let m = 0
        while a < self.ra_ncp && self.ra_cp[a] < hi:
            m = m | self.ra_cm[a]
            a = a + 1
        return m

    /#/ May a value that lives across calls writing `cm` and (`restr`) is a parameter or an argument
    /#/ take register number `r` of the pool?
    fn reg_ok(self, r: int, cm: int, restr: bool) => bool:
        if self.a.sbx && r == 8:
            return false
        if r >= 5:
            return true
        if ((cm >> r) & 1) == 1:
            return false
        return r == 0 || !restr

    /#/ Is there a call strictly between positions `lo` and `hi`?
    fn crosses(self, lo: int, hi: int) => bool:
        let a = 0
        let b = self.ra_ncp
        while a < b:
            let mid = (a + b) // 2
            if self.ra_cp[mid] > lo:
                b = mid
            else:
                a = mid + 1
        return a < self.ra_ncp && self.ra_cp[a] < hi

    /#/ Counts the uses of every value of `f`, through forwarding and `own.move`.
    fn count_uses(self, f: &Fun) => void:
        if len(self.nuse) < f.ni + 1:
            self.nuse = new_buf(int, f.ni + 1)
        for v in 0..f.ni + 1:
            self.nuse[v] = 0
        for b in 0..f.nb:
            let i = f.bfirst[b]
            while i >= 0:
                for k in 0..f.nval(i):
                    let v = f.val_at(i, k)
                    if v >= 0:
                        let x = self.res(f, v)
                        self.nuse[x] = self.nuse[x] + 1
                i = f.nx[i]
        for e in 0..f.ne:
            if f.eto[e] >= 0:
                for k in 0..f.eargn[e]:
                    let x = self.res(f, f.pool[f.eargs[e] + k])
                    self.nuse[x] = self.nuse[x] + 1

    /#/ Is `x`, an `index` or a `field`, only the address of the scalar `load` or `store` right
    /#/ after it? Then the access uses the address mode and `x` makes no code of its own.
    fn folds(self, f: &Fun, x: int) => bool:
        let op = f.op[x]
        if op != int(Op.Index) && op != int(Op.Field):
            return false
        if self.nuse[x] != 1 || f.fwd[x] >= 0:
            return false
        if op == int(Op.Index):
            let sz = f.aux[x]
            if sz != 1 && sz != 2 && sz != 4 && sz != 8:
                return false
        let u = f.nx[x]
        if u < 0:
            return false
        if f.op[u] == int(Op.Load):
            return self.res(f, f.a[u]) == x && f.rep[u] < rp_first_agg()
        if f.op[u] == int(Op.Store):
            let v = self.res(f, f.b[u])
            return self.res(f, f.a[u]) == x && v != x && f.rep[v] < rp_first_agg()
        return false

    /#/ The address of the folded `x` as base, index, scale and displacement in `am_*`; what is not
    /#/ in a register of its own is loaded into `s1` (the base) and `s2` (the index).
    fn addr_of(self, f: &Fun, x: int, s1: int, s2: int) => void:
        self.am_base = self.src(f, f.a[x], s1)
        if f.op[x] == int(Op.Index) && self.near_const(f, f.b[x]):
            self.am_idx = -1
            self.am_scale = 1
            self.am_disp = f.aux[self.res(f, f.b[x])] * f.aux[x]
        elif f.op[x] == int(Op.Index):
            self.am_idx = self.src(f, f.b[x], s2)
            self.am_scale = f.aux[x]
            self.am_disp = 0
        else:
            self.am_idx = -1
            self.am_scale = 1
            self.am_disp = f.aux[x]

    /#/ Does a call stand at position `p`?
    fn at_call(self, p: int) => bool:
        let a = 0
        let b = self.ra_ncp
        while a < b:
            let mid = (a + b) // 2
            if self.ra_cp[mid] >= p:
                b = mid
            else:
                a = mid + 1
        return a < self.ra_ncp && self.ra_cp[a] == p

    /#/ The edges leaving block `b`, in `ed`.
    fn term_edges(self, f: &Fun, b: int) => void:
        self.ned = 0
        let t = f.blast[b]
        if t < 0:
            return
        let op = f.op[t]
        if op == int(Op.Br):
            self.add_edge(f.aux[t])
        elif op == int(Op.CondBr):
            self.add_edge(f.b[t])
            self.add_edge(f.c[t])
        elif op == int(Op.Switch):
            for k in 0..f.b[t]:
                self.add_edge(f.pool[f.aux[t] + k * 2 + 1])
            self.add_edge(f.c[t])

    fn add_edge(self, e: int) => void:
        if self.ned >= len(self.ed):
            self.ed = buf_resize(self.ed, (self.ned + 1) * 2)
        self.ed[self.ned] = e
        self.ned = self.ned + 1

    /#/ Chooses a register for the values that deserve one: `home` of every value (-1 for the frame).
    /#/ Live ranges are single intervals of the block order, made from the liveness of every block.
    fn alloc_regs(self, f: &Fun, rs: &Reps) => void:
        let n = f.ni
        if len(self.home) < n + 1:
            self.home = new_buf(int, n + 1)
            self.xhome = new_buf(int, n + 1)
            self.xsg = new_buf(int, n + 1)
            self.did = new_buf(int, n + 1)
        for v in 0..n:
            self.home[v] = -1
            self.xhome[v] = -1
            self.xsg[v] = 0
            self.did[v] = -1
        self.nsaved = 0
        self.ra_ncp = 0
        self.fmask = 31
        let bs: buf<int> = new_buf(int, f.nb + 1)
        let be: buf<int> = new_buf(int, f.nb + 1)
        let depth: buf<int> = new_buf(int, f.nb + 1)
        /#/ loop depth: a back edge (to a block not after its source in the order of the code) wraps the
        /#/ blocks between
        let at: buf<int> = new_buf(int, f.nb + 1)
        for oi in 0..f.nb:
            at[self.ord[oi]] = oi
        for b in 0..f.nb:
            self.term_edges(f, b)
            for k in 0..self.ned:
                let t = f.eto[self.ed[k]]
                if t >= 0 && at[t] <= at[b]:
                    for q in at[t]..at[b] + 1:
                        depth[self.ord[q]] = depth[self.ord[q]] + 1
        /#/ dense numbers, positions: uses at even numbers, definitions after them
        let nd = 0
        for b in 0..f.nb:
            let p = f.pfirst[b]
            while p >= 0:
                if self.wants_reg(f, p):
                    self.did[p] = nd
                    nd = nd + 1
                p = f.nx[p]
            let i = f.bfirst[b]
            while i >= 0:
                if self.wants_reg(f, i):
                    self.did[i] = nd
                    nd = nd + 1
                i = f.nx[i]
        self.nhc = 0
        /#/ a float constant used inside a loop is loaded once, at the entry (when the entry is no loop)
        let entry_ok = self.ord[0] == 0
        for b in 0..f.nb:
            self.term_edges(f, b)
            for k in 0..self.ned:
                if f.eto[self.ed[k]] == 0:
                    entry_ok = false
        if entry_ok:
            for b in 0..f.nb:
                if depth[b] == 0:
                    continue
                let i = f.bfirst[b]
                while i >= 0:
                    for k in 0..f.nval(i):
                        nd = self.hoist_const(f, f.val_at(i, k), nd)
                    i = f.nx[i]
                self.term_edges(f, b)
                for k in 0..self.ned:
                    let e = self.ed[k]
                    for j in 0..f.eargn[e]:
                        nd = self.hoist_const(f, f.pool[f.eargs[e] + j], nd)
        if nd == 0:
            return
        let dv: buf<int> = new_buf(int, nd + 1)
        self.ra_lo = new_buf(int, nd + 1)
        self.ra_hi = new_buf(int, nd + 1)
        self.ra_wt = new_buf(int, nd + 1)
        self.ra_dblk = new_buf(int, nd + 1)
        self.ra_dset = new_buf(int, nd + 1)
        self.nuq = 0
        for d in 0..nd:
            self.ra_lo[d] = 1000000000
            self.ra_hi[d] = -1
        self.fmask = 0
        let pos = 0
        for oi in 0..f.nb:
            let b = self.ord[oi]
            bs[b] = pos + 1
            let p = f.pfirst[b]
            let w = 1
            for q in 0..depth[b]:
                if w < 4096:
                    w = w * 8
            while p >= 0:
                let d = self.did[p]
                if d >= 0:
                    dv[d] = p
                    self.ra_dblk[d] = b
                    self.ra_lo[d] = pos + 1
                    self.ra_hi[d] = pos + 1
                    self.ra_wt[d] = self.ra_wt[d] + w
                p = f.nx[p]
            pos = pos + 2
            let i = f.bfirst[b]
            be[b] = bs[b]
            while i >= 0:
                be[b] = pos
                if self.is_clobber(f, i):
                    if self.ra_ncp >= len(self.ra_cp):
                        self.ra_cp = buf_resize(self.ra_cp, (self.ra_ncp + 1) * 2)
                    if self.ra_ncp >= len(self.ra_cm):
                        self.ra_cm = buf_resize(self.ra_cm, (self.ra_ncp + 1) * 2)
                    self.ra_cp[self.ra_ncp] = pos
                    self.ra_cm[self.ra_ncp] = self.site_mask(f, i)
                    self.fmask = self.fmask | self.ra_cm[self.ra_ncp]
                    self.ra_ncp = self.ra_ncp + 1
                let d = self.did[i]
                if d >= 0:
                    dv[d] = i
                    self.ra_dblk[d] = b
                    self.ra_lo[d] = pos + 1
                    self.ra_hi[d] = pos + 1
                    self.ra_wt[d] = self.ra_wt[d] + w
                i = f.nx[i]
                pos = pos + 2
        for k in 0..self.nhc:
            let c = self.hc[k]
            let d = self.did[c]
            dv[d] = c
            self.ra_dblk[d] = 0
            self.ra_lo[d] = bs[0]
            self.ra_hi[d] = bs[0]
            self.ra_dset[d] = 1
        /#/ the uses: those of a value not defined (yet) in the block they are in make it live into the block
        for b in 0..f.nb:
            let w = 1
            for q in 0..depth[b]:
                if w < 4096:
                    w = w * 8
            let p = f.pfirst[b]
            while p >= 0:
                if self.did[p] >= 0:
                    self.ra_dset[self.did[p]] = 1
                p = f.nx[p]
            let i = f.bfirst[b]
            let ip = bs[b] + 1
            while i >= 0:
                for k in 0..f.nval(i):
                    self.note_use(f, f.val_at(i, k), b, ip, w)
                let d = self.did[i]
                if d >= 0:
                    self.ra_dset[d] = 1
                i = f.nx[i]
                ip = ip + 2
            self.term_edges(f, b)
            for k in 0..self.ned:
                let e = self.ed[k]
                for j in 0..f.eargn[e]:
                    self.note_use(f, f.pool[f.eargs[e] + j], b, be[b], w)
        /#/ liveness: from each such use walk back over the predecessors up to the block of the definition;
        /#/ the blocks walked are the ones the value is live into, their predecessors the ones it is live
        /#/ out of. The ranges cover those. `lvs`/`lve` bound each value's blocks in `lvb`.
        let pc: buf<int> = new_buf(int, f.nb + 2)
        for b in 0..f.nb:
            self.term_edges(f, b)
            for k in 0..self.ned:
                let t = f.eto[self.ed[k]]
                if t >= 0:
                    pc[t + 1] = pc[t + 1] + 1
        for b in 0..f.nb:
            pc[b + 1] = pc[b + 1] + pc[b]
        let pred: buf<int> = new_buf(int, pc[f.nb] + 1)
        let pfill: buf<int> = new_buf(int, f.nb + 1)
        for b in 0..f.nb:
            self.term_edges(f, b)
            for k in 0..self.ned:
                let t = f.eto[self.ed[k]]
                if t >= 0:
                    pred[pc[t] + pfill[t]] = b
                    pfill[t] = pfill[t] + 1
        /#/ the uses by value
        let uc: buf<int> = new_buf(int, nd + 2)
        for q in 0..self.nuq:
            uc[self.uq_d[q] + 1] = uc[self.uq_d[q] + 1] + 1
        for d in 0..nd:
            uc[d + 1] = uc[d + 1] + uc[d]
        let ub: buf<int> = new_buf(int, self.nuq + 1)
        let ufill: buf<int> = new_buf(int, nd + 1)
        for q in 0..self.nuq:
            let d = self.uq_d[q]
            ub[uc[d] + ufill[d]] = self.uq_b[q]
            ufill[d] = ufill[d] + 1
        let inm: buf<int> = new_buf(int, f.nb + 1)
        let stack: buf<int> = new_buf(int, f.nb + 1)
        let lvb: buf<int> = new_buf(int, 64)
        let nlv = 0
        let lvs: buf<int> = new_buf(int, nd + 1)
        let lve: buf<int> = new_buf(int, nd + 1)
        for d in 0..nd:
            lvs[d] = nlv
            let stamp = d + 1
            let db = self.ra_dblk[d]
            for q in uc[d]..uc[d + 1]:
                let u = ub[q]
                if inm[u] == stamp || u == db:
                    continue
                let sp = 0
                stack[0] = u
                sp = 1
                inm[u] = stamp
                while sp > 0:
                    sp = sp - 1
                    let x = stack[sp]
                    if nlv >= len(lvb):
                        lvb = buf_resize(lvb, (nlv + 1) * 2)
                    lvb[nlv] = x
                    nlv = nlv + 1
                    if bs[x] < self.ra_lo[d]:
                        self.ra_lo[d] = bs[x]
                    if bs[x] > self.ra_hi[d]:
                        self.ra_hi[d] = bs[x]
                    for r in pc[x]..pc[x + 1]:
                        let pb = pred[r]
                        if be[pb] + 1 > self.ra_hi[d]:
                            self.ra_hi[d] = be[pb] + 1
                        if be[pb] + 1 < self.ra_lo[d]:
                            self.ra_lo[d] = be[pb] + 1
                        if pb != db && inm[pb] != stamp:
                            inm[pb] = stamp
                            stack[sp] = pb
                            sp = sp + 1
            lve[d] = nlv
        /#/ coalescing: a value computed in block `b` and passed on a back edge to the parameter `p` may
        /#/ take p's register when p is not read after it (in `b`, or in what follows `b`) and the value
        /#/ does not leave `b`; their ranges overlap only because p stays alive on its other paths
        let coal: buf<int> = new_buf(int, nd + 1)
        for d in 0..nd:
            coal[d] = -1
        for b in 0..f.nb:
            self.term_edges(f, b)
            for k in 0..self.ned:
                let e = self.ed[k]
                let t = f.eto[e]
                if t < 0 || at[t] > at[b]:
                    continue
                let pp = f.pfirst[t]
                for j in 0..f.eargn[e]:
                    let x = self.res(f, f.pool[f.eargs[e] + j])
                    let dx = self.did[x]
                    let dp = self.did[pp]
                    if dx >= 0 && dp >= 0 && f.op[x] != int(Op.Param) && f.blk[x] == b && coal[dx] < 0:
                        let ok = !self.live_out_of(f, b, dx, &lvb, &lvs, &lve)
                        if self.live_out_of(f, b, dp, &lvb, &lvs, &lve):
                            ok = false
                        let i = f.nx[x]
                        while ok && i >= 0:
                            for q in 0..f.nval(i):
                                if f.val_at(i, q) >= 0 && self.res(f, f.val_at(i, q)) == pp:
                                    ok = false
                            i = f.nx[i]
                        for k2 in 0..self.ned:
                            let e2 = self.ed[k2]
                            for j2 in 0..f.eargn[e2]:
                                if self.res(f, f.pool[f.eargs[e2] + j2]) == pp:
                                    ok = false
                        if ok:
                            coal[dx] = dp
                    pp = f.nx[pp]
        /#/ what a register is worth to a value: its uses (weighted by loop depth) per position of its range
        let dn: buf<int> = new_buf(int, nd + 1)
        for d in 0..nd:
            dn[d] = self.ra_wt[d] * 1024 // (self.ra_hi[d] - self.ra_lo[d] + 2)
        /#/ linear scan, by start
        let top = pos + 4
        let first: buf<int> = new_buf(int, top + 1)
        let link: buf<int> = new_buf(int, nd + 1)
        for q in 0..top + 1:
            first[q] = -1
        let sd = nd - 1
        while sd >= 0:
            link[sd] = first[self.ra_lo[sd]]
            first[self.ra_lo[sd]] = sd
            sd = sd - 1
        /#/ the caller-saved registers first (r10, then r8 and r9, the registers of the fifth and sixth
        /#/ argument), then the saved ones
        let regs: buf<int> = new_buf(int, 10)
        regs[0] = 10
        regs[1] = 8
        regs[2] = 9
        regs[3] = 11
        regs[4] = 7
        regs[5] = 3
        regs[6] = 12
        regs[7] = 13
        regs[8] = 14
        regs[9] = 15
        let ent: buf<int> = new_buf(int, nd + 1)
        let ep = f.pfirst[0]
        while ep >= 0:
            if self.did[ep] >= 0:
                ent[self.did[ep]] = 1
            ep = f.nx[ep]
        for k in 0..self.nhc:
            ent[self.did[self.hc[k]]] = 1
        let occ: buf<int> = new_buf(int, 10)
        for r in 0..10:
            occ[r] = -1
        let used: buf<int> = new_buf(int, 10)
        /#/ the xmm registers 2 to 15 for floats that are not alive across a call (all are caller-saved);
        /#/ the arguments are loaded into xmm0 to xmm7, so a parameter or an argument stays in 8 to 15
        let occx: buf<int> = new_buf(int, 16)
        for r in 0..16:
            occx[r] = -1
        for q in 0..top + 1:
            let cd = first[q]
            while cd >= 0:
                let d = cd
                let nxt = link[d]
                let fr_x = -1
                let rd = f.rep[dv[d]]
                if (rd == int(Rp.F32) || rd == int(Rp.F64)) && !self.crosses(self.ra_lo[d], self.ra_hi[d]):
                    let lowx = 2
                    if ent[d] == 1 || self.at_call(self.ra_hi[d]):
                        lowx = 8
                    for r in 2..16:
                        if occx[r] >= 0 && self.ra_hi[occx[r]] < self.ra_lo[d]:
                            occx[r] = -1
                    for r in lowx..16:
                        if occx[r] < 0 && fr_x < 0:
                            fr_x = r
                    if fr_x >= 0:
                        occx[fr_x] = d
                        self.xhome[dv[d]] = fr_x
                        if rd == int(Rp.F32):
                            self.xsg[dv[d]] = 1
                        cd = nxt
                        continue
                /#/ which of the caller-saved registers `d` may take: not one that a call it is alive
                /#/ across may write; only r10 when it is an argument of the call it ends at or a
                /#/ parameter of the function (loading the arguments or the parameters would overwrite it)
                let cm = self.cm_in(self.ra_lo[d], self.ra_hi[d])
                let restr = ent[d] == 1 || self.at_call(self.ra_hi[d])
                for r in 0..10:
                    if occ[r] >= 0 && self.ra_hi[occ[r]] < self.ra_lo[d]:
                        occ[r] = -1
                let fr = -1
                /#/ the hint: the register of the first operand when it ends where `d` begins
                let hint = self.hint_reg(f, dv[d])
                let shared = -1
                if coal[d] >= 0 && self.home[dv[coal[d]]] >= 0 && self.ra_lo[coal[d]] < self.ra_lo[d]:
                    for r in 0..10:
                        if regs[r] == self.home[dv[coal[d]]] && occ[r] == coal[d] && self.reg_ok(r, cm, restr):
                            shared = r
                if shared >= 0:
                    fr = shared
                if hint >= 0 && fr < 0:
                    for r in 0..10:
                        if regs[r] == hint && occ[r] < 0 && self.reg_ok(r, cm, restr):
                            fr = r
                for r in 0..10:
                    if occ[r] < 0 && fr < 0 && self.reg_ok(r, cm, restr):
                        fr = r
                if fr >= 0:
                    if shared < 0 || self.ra_hi[d] > self.ra_hi[occ[fr]]:
                        occ[fr] = d
                    self.home[dv[d]] = regs[fr]
                    used[fr] = 1
                else:
                    /#/ the least wanted of the live ones and this one goes to the frame
                    let worst = -1
                    for r in 0..10:
                        if self.reg_ok(r, cm, restr):
                            if worst < 0 || dn[occ[r]] < dn[occ[worst]]:
                                worst = r
                    if dn[occ[worst]] < dn[d]:
                        self.home[dv[occ[worst]]] = -1
                        self.home[dv[d]] = regs[worst]
                        occ[worst] = d
                cd = nxt
        /#/ the check: nothing in a caller-saved register is alive across a call, and r8 and r9
        /#/ hold neither a parameter nor an argument of the call that ends the value
        for d in 0..nd:
            let h = self.home[dv[d]]
            if h == 7 || h == 8 || h == 9 || h == 10 || h == 11:
                let bit = 0
                if h == 8:
                    bit = 1
                elif h == 9:
                    bit = 2
                elif h == 11:
                    bit = 3
                elif h == 7:
                    bit = 4
                if ((self.cm_in(self.ra_lo[d], self.ra_hi[d]) >> bit) & 1) == 1:
                    self.err = 1
                if h != 10 && (ent[d] == 1 || self.at_call(self.ra_hi[d])):
                    self.err = 1
        for d in 0..nd:
            let xh = self.xhome[dv[d]]
            if xh >= 0:
                if self.crosses(self.ra_lo[d], self.ra_hi[d]) || xh < 2:
                    self.err = 1
                if xh < 8 && (ent[d] == 1 || self.at_call(self.ra_hi[d])):
                    self.err = 1
        /#/ what this function may write: the registers of its calls, and its own caller-saved homes
        for r in 0..5:
            if used[r] == 1:
                self.fmask = self.fmask | (1 << r)
        if len(self.saved) < 6:
            self.saved = new_buf(int, 8)
        for r in 0..10:
            if used[r] == 1 && r >= 5:
                self.saved[self.nsaved] = regs[r]
                self.nsaved = self.nsaved + 1

    /#/ For an instruction that computes into its first operand's register (two-address): the
    /#/ register that operand has, else -1.
    fn hint_reg(self, f: &Fun, v: int) => int:
        let op = f.op[v]
        if op == int(Op.Add) || op == int(Op.Sub) || op == int(Op.Mul) || op == int(Op.And) || op == int(Op.Or) || op == int(Op.Xor) || op == int(Op.Shl) || op == int(Op.AShr) || op == int(Op.LShr) || op == int(Op.Neg) || op == int(Op.Not):
            if f.a[v] >= 0:
                return self.home[self.res(f, f.a[v])]
            return -1
        if op == int(Op.Trunc) || op == int(Op.Bitcast) || op == int(Op.PtrToInt) || op == int(Op.IntToPtr) || op == int(Op.SExt) || op == int(Op.ZExt):
            if f.a[v] >= 0:
                return self.home[self.res(f, f.a[v])]
        return -1

    /#/ Give the float constant `v` a number as a value to keep in a register, once; returns the new count.
    fn hoist_const(self, f: &Fun, v: int, nd: int) => int:
        if v < 0:
            return nd
        let x = self.res(f, v)
        if f.op[x] != int(Op.Const) || self.did[x] >= 0:
            return nd
        if f.rep[x] != int(Rp.F64) && f.rep[x] != int(Rp.F32):
            return nd
        if self.nhc >= len(self.hc):
            self.hc = buf_resize(self.hc, (self.nhc + 1) * 2)
        self.hc[self.nhc] = x
        self.nhc = self.nhc + 1
        self.did[x] = nd
        return nd + 1

    fn note_use(self, f: &Fun, v: int, b: int, p: int, w: int) => void:
        if v < 0:
            return
        let x = self.res(f, v)
        let d = self.did[x]
        if d < 0:
            return
        self.ra_wt[d] = self.ra_wt[d] + w
        if p < self.ra_lo[d]:
            self.ra_lo[d] = p
        if p > self.ra_hi[d]:
            self.ra_hi[d] = p
        if self.ra_dset[d] == 1 && self.ra_dblk[d] == b:
            return
        if self.nuq >= len(self.uq_d):
            self.uq_d = buf_resize(self.uq_d, (self.nuq + 1) * 2)
            self.uq_b = buf_resize(self.uq_b, (self.nuq + 1) * 2)
        self.uq_d[self.nuq] = d
        self.uq_b[self.nuq] = b
        self.nuq = self.nuq + 1

    /#/ Is value `d` live out of block `b`: live into one of its successors?
    fn live_out_of(self, f: &Fun, b: int, d: int, lvb: &buf<int>, lvs: &buf<int>, lve: &buf<int>) => bool:
        self.term_edges(f, b)
        for k in 0..self.ned:
            let t = f.eto[self.ed[k]]
            if t >= 0:
                for q in lvs[d]..lve[d]:
                    if lvb[q] == t:
                        return true
        return false

    /#/ ---- frame -------------------------------------------------------------

    fn place_size(self, rs: &Reps, r: int) => int:
        let s = round8(rsize(rs, r))
        if s < 8:
            return 8
        return s

    /#/ Gives every value its place; the size of the frame.
    fn layout(self, f: &Fun, rs: &Reps) => void:
        if len(self.voff) < f.ni + 1:
            self.voff = new_buf(int, f.ni + 1)
            self.sh = new_buf(int, f.ni + 1)
        for v in 0..f.ni:
            self.sh[v] = 0
        let sbx = self.a.sbx
        /#/ sandbox code keeps aggregates and the slots whose address is taken in the shadow frame, in
        /#/ the linear memory: a pointer to them is an offset like any other, and the host stack holds
        /#/ only what the code cannot name (return addresses, saved registers, spilled scalars)
        let scur = 0
        let cur = self.rbase + 8 * self.nsaved
        let tmp = 0
        for b in 0..f.nb:
            let p = f.pfirst[b]
            while p >= 0:
                if self.home[p] < 0 && self.xhome[p] < 0:
                    if sbx && f.rep[p] >= rp_first_agg():
                        self.voff[p] = 0 - scur
                        self.sh[p] = 1
                        scur = scur + self.place_size(rs, f.rep[p])
                    else:
                        cur = cur + self.place_size(rs, f.rep[p])
                        self.voff[p] = cur
                p = f.nx[p]
            let i = f.bfirst[b]
            while i >= 0:
                let op = f.op[i]
                if op == int(Op.Slot):
                    let sz = round8(f.ty[i])
                    if f.ty[i] < 1:
                        sz = sz + 8
                    if sbx:
                        self.voff[i] = 0 - scur
                        self.sh[i] = 1
                        scur = scur + sz
                    else:
                        cur = cur + sz
                        self.voff[i] = cur
                elif f.rep[i] != int(Rp.Void) && op != int(Op.OwnMove) && self.home[i] < 0 && self.xhome[i] < 0:
                    if sbx && f.rep[i] >= rp_first_agg():
                        self.voff[i] = 0 - scur
                        self.sh[i] = 1
                        scur = scur + self.place_size(rs, f.rep[i])
                    else:
                        cur = cur + self.place_size(rs, f.rep[i])
                        self.voff[i] = cur
                i = f.nx[i]
        for e in 0..f.ne:
            if f.eto[e] >= 0:
                let sum = 0
                for k in 0..f.eargn[e]:
                    sum = sum + self.place_size(rs, f.rep[self.res(f, f.pool[f.eargs[e] + k])])
                if sum > tmp:
                    tmp = sum
        cur = cur + tmp
        self.tmp = cur
        self.frame = (cur + 15) // 16 * 16
        self.sframe = (scur + 15) // 16 * 16
        /#/ a frame larger than the guard below the shadow stack could be stepped over
        if self.sframe > 32768:
            self.err = 1

    /#/ ---- edges -------------------------------------------------------------

    /#/ Copies what edge `e` passes into the parameters of the block it enters; through a scratch
    /#/ area when an argument is itself a parameter of that block (the copies are simultaneous).
    fn edge_copy(self, f: &Fun, rs: &Reps, e: int) => void:
        let to = f.eto[e]
        let n = f.eargn[e]
        if n == 0:
            return
        let hazard = false
        let pj = f.pfirst[to]
        for k in 0..n:
            let x = self.res(f, f.pool[f.eargs[e] + k])
            if f.op[x] == int(Op.Param) && f.blk[x] == to:
                hazard = true
            /#/ a parameter already written must not be what a later argument reads
            let hx = self.hid(x)
            if hx >= 0:
                let q = f.pfirst[to]
                for j in 0..k:
                    if self.hid(q) == hx:
                        hazard = true
                    q = f.nx[q]
        if !hazard:
            let p = f.pfirst[to]
            for k in 0..n:
                if self.home[p] >= 0:
                    self.ld(self.home[p], f, f.pool[f.eargs[e] + k])
                elif self.xhome[p] >= 0:
                    let ax = self.res(f, f.pool[f.eargs[e] + k])
                    if self.xhome[ax] >= 0:
                        if self.xhome[ax] != self.xhome[p]:
                            self.a.movaps(self.xhome[p], self.xhome[ax])
                    else:
                        self.ld(0, f, ax)
                        self.st(p, 0)
                else:
                    self.val_to(f, rs, self.vb(p), 0 - self.voff[p], f.pool[f.eargs[e] + k])
                p = f.nx[p]
            return
        /#/ every parameter in a register: the copies as a sequence of moves, each after the ones that read
        /#/ its register; a cycle goes through rcx (general) or xmm0 (floats)
        let allreg = true
        let pp = f.pfirst[to]
        for k in 0..n:
            if self.home[pp] < 0 && self.xhome[pp] < 0:
                allreg = false
            pp = f.nx[pp]
        if allreg:
            self.edge_moves(f, e)
            return
        let at = 0
        for k in 0..n:
            let v = f.pool[f.eargs[e] + k]
            self.val_to(f, rs, 5, 0 - self.tmp + at, v)
            at = at + self.place_size(rs, f.rep[self.res(f, v)])
        let p = f.pfirst[to]
        at = 0
        for k in 0..n:
            let sz = self.place_size(rs, f.rep[p])
            if self.home[p] >= 0:
                self.a.load(self.home[p], 5, 0 - self.tmp + at, 8)
            elif self.xhome[p] >= 0:
                self.a.load(0, 5, 0 - self.tmp + at, 8)
                self.st(p, 0)
            else:
                self.copy_mem(self.vb(p), 0 - self.voff[p], 5, 0 - self.tmp + at, sz)
            at = at + sz
            p = f.nx[p]

    /#/ The register a move reads, as `hid` numbers it; -1 when it reads a constant, an address or the frame.
    fn move_src(self, f: &Fun, x: int) => int:
        let k = f.op[x]
        if k == int(Op.Const) || k == int(Op.Undef) || k == int(Op.StrLit) || k == int(Op.Slot):
            return -1
        return self.hid(x)

    /#/ The simultaneous copies of edge `e` into the parameters (all in registers) as moves in an order
    /#/ where no move overwrites what a later one reads; a cycle is broken through a scratch register.
    fn edge_moves(self, f: &Fun, e: int) => void:
        let to = f.eto[e]
        let n = f.eargn[e]
        let pd: buf<int> = new_buf(int, n + 1)
        let pa: buf<int> = new_buf(int, n + 1)
        let ps: buf<int> = new_buf(int, n + 1)
        let done: buf<int> = new_buf(int, n + 1)
        let p = f.pfirst[to]
        for k in 0..n:
            pd[k] = p
            pa[k] = self.res(f, f.pool[f.eargs[e] + k])
            ps[k] = self.move_src(f, pa[k])
            p = f.nx[p]
        let left = n
        while left > 0:
            let progress = false
            for k in 0..n:
                if done[k] == 0:
                    let d = self.hid(pd[k])
                    let blocked = false
                    for j in 0..n:
                        if j != k && done[j] == 0 && ps[j] == d:
                            blocked = true
                    if !blocked:
                        self.emit_move(f, pd[k], pa[k], ps[k])
                        done[k] = 1
                        left = left - 1
                        progress = true
            if !progress:
                /#/ a cycle: some pending move reads a register that another pending move writes
                let s = -1
                for k in 0..n:
                    if done[k] == 0 && s < 0:
                        let d = self.hid(pd[k])
                        for j in 0..n:
                            if j != k && done[j] == 0 && ps[j] == d && s < 0:
                                s = d
                if s < 32:
                    self.a.mov_rr(1, s)
                else:
                    self.a.movaps(0, s - 32)
                for j in 0..n:
                    if done[j] == 0 && ps[j] == s:
                        if s < 32:
                            ps[j] = -2
                        else:
                            ps[j] = -3

    /#/ One move: parameter `p` from the value `ax` (which sits in the register numbered `src`, or -2 / -3
    /#/ when that was copied to rcx / xmm0).
    fn emit_move(self, f: &Fun, p: int, ax: int, src: int) => void:
        if self.home[p] >= 0:
            if src == -2:
                self.a.mov_rr(self.home[p], 1)
            elif src == -3:
                self.a.movq_r(self.home[p], 0, self.xsg[ax] == 1)
            else:
                self.ld(self.home[p], f, ax)
        else:
            if src == -3:
                self.a.movaps(self.xhome[p], 0)
            elif src == -2:
                self.st(p, 1)
            elif self.xhome[ax] >= 0 && src >= 32:
                if self.xhome[ax] != self.xhome[p]:
                    self.a.movaps(self.xhome[p], self.xhome[ax])
            else:
                self.ld(0, f, ax)
                self.st(p, 0)

    /#/ A number for the register of `x`, general ones as they are and xmm ones from 32; -1 in the frame.
    fn hid(self, x: int) => int:
        if self.home[x] >= 0:
            return self.home[x]
        if self.xhome[x] >= 0:
            return 32 + self.xhome[x]
        return -1

    /#/ ---- calls -------------------------------------------------------------

    fn is_int_class(self, r: int) => bool:
        return r != int(Rp.F32) && r != int(Rp.F64)

    /#/ The call to the symbol `sym` (or the address in r11 when `sym` < 0) with the values queued
    /#/ in `av`; the result of instruction `i` is stored.
    fn do_call(self, f: &Fun, rs: &Reps, i: int, sym: int, variadic: bool) => void:
        let ret = f.rep[i]
        let sret = ret >= rp_first_agg()
        /#/ which arguments go on the stack
        let ni = 0
        let nx = 0
        if sret:
            ni = 1
        let on_stack = 0
        for k in 0..self.nav:
            let r = f.rep[self.res(f, self.av[k])]
            if r >= rp_first_agg() || self.is_int_class(r):
                if ni < 6:
                    ni = ni + 1
                else:
                    on_stack = on_stack + 1
            elif nx < 8:
                nx = nx + 1
            else:
                on_stack = on_stack + 1
        if on_stack % 2 == 1:
            self.a.sub_ri(4, 8)
        /#/ the stack arguments, last first
        let k = self.nav - 1
        while k >= 0:
            let r = f.rep[self.res(f, self.av[k])]
            let reg_ok = false
            /#/ recompute whether this one fits in a register: count the ones before it
            let ci = 0
            if sret:
                ci = 1
            let cx = 0
            for j in 0..k:
                let rj = f.rep[self.res(f, self.av[j])]
                if rj >= rp_first_agg() || self.is_int_class(rj):
                    ci = ci + 1
                else:
                    cx = cx + 1
            if r >= rp_first_agg() || self.is_int_class(r):
                reg_ok = ci < 6
            else:
                reg_ok = cx < 8
            if !reg_ok:
                if r >= rp_first_agg():
                    let x = self.res(f, self.av[k])
                    if f.op[x] == int(Op.Undef):
                        self.a.lea_rip(0, 1, 0)
                    else:
                        self.a.lea(0, self.vb(x), 0 - self.voff[x])
                else:
                    self.ld(0, f, self.av[k])
                self.a.push(0)
            k = k - 1
        if sret:
            self.a.lea(7, self.vb(i), 0 - self.voff[i])
        let ci = 0
        if sret:
            ci = 1
        let cx = 0
        for an in 0..self.nav:
            let v = self.av[an]
            let x = self.res(f, v)
            let r = f.rep[x]
            if r >= rp_first_agg():
                if ci < 6:
                    if f.op[x] == int(Op.Undef):
                        self.a.lea_rip(int_reg(ci), 1, 0)
                    else:
                        self.a.lea(int_reg(ci), self.vb(x), 0 - self.voff[x])
                ci = ci + 1
            elif self.is_int_class(r):
                if ci < 6:
                    self.ld(int_reg(ci), f, v)
                ci = ci + 1
            else:
                if cx < 8:
                    if self.xhome[x] >= 0:
                        self.a.movaps(cx, self.xhome[x])
                    else:
                        self.ld(0, f, v)
                        self.a.movq_x(cx, 0, r == int(Rp.F32))
                cx = cx + 1
        if variadic:
            self.a.mov_ri(0, nx)
        if sym < 0:
            self.a.call_reg(11)
        else:
            self.a.call_sym(sym)
        let pop = on_stack
        if on_stack % 2 == 1:
            pop = pop + 1
        if pop > 0:
            self.a.add_ri(4, pop * 8)
        if ret == int(Rp.Void) || sret || f.uses[i] == 0:
            return
        if self.is_int_class(ret):
            self.st(i, 0)
        else:
            self.xfin(f, i, 0)

    /#/ The symbol of the function the name number `id` of `sy` stands for.
    fn callee(self, sy: &Names, id: int) => int:
        let w = new_txt()
        sy.put(&w, id)
        return self.o.sym(&w)

    /#/ ---- instructions ------------------------------------------------------

    fn cc_of(self, p: int) => int:
        if p == int(Pr.Eq):
            return cc_e()
        if p == int(Pr.Ne):
            return cc_ne()
        if p == int(Pr.SLt):
            return cc_l()
        if p == int(Pr.SLe):
            return cc_le()
        if p == int(Pr.SGt):
            return cc_g()
        if p == int(Pr.SGe):
            return cc_ge()
        if p == int(Pr.ULt):
            return cc_b()
        if p == int(Pr.ULe):
            return cc_be()
        if p == int(Pr.UGt):
            return cc_a()
        return cc_ae()

    fn is_signed_pred(self, p: int) => bool:
        return p == int(Pr.SLt) || p == int(Pr.SLe) || p == int(Pr.SGt) || p == int(Pr.SGe)

    /#/ Is the compare `i` used only by the branch right after it? Then the flags carry it.
    fn fused(self, f: &Fun, i: int) => bool:
        let n = f.nx[i]
        if n < 0 || f.op[n] != int(Op.CondBr) || f.uses[i] != 1:
            return false
        return self.res(f, f.a[n]) == i

    /#/ Is the float compare `i` one the flags carry in a single condition (not == or !=)?
    fn fflag_ok(self, f: &Fun, i: int) => bool:
        let p = f.aux[i]
        return p == int(Pr.OLt) || p == int(Pr.OLe) || p == int(Pr.OGt) || p == int(Pr.OGe)

    /#/ Compare the operands of the float compare `i` and return the condition that holds when it is true.
    /#/ An unordered result sets CF, so `a` and `ae` are false for it, as the compare requires.
    fn fcmp_flags(self, f: &Fun, i: int) => int:
        let p = f.aux[i]
        let single = f.rep[self.res(f, f.a[i])] == int(Rp.F32)
        let xa = self.xsrc(f, f.a[i], 0)
        let xb = self.xsrc(f, f.b[i], 1)
        if p == int(Pr.OLt) || p == int(Pr.OLe):
            self.a.ucomi(single, xb, xa)
        else:
            self.a.ucomi(single, xa, xb)
        if p == int(Pr.OLt) || p == int(Pr.OGt):
            return cc_a()
        return cc_ae()

    /#/ Is `v` a constant small enough that, times an element size of at most 8, it is a displacement?
    fn near_const(self, f: &Fun, v: int) => bool:
        let x = self.res(f, v)
        if f.op[x] != int(Op.Const):
            return false
        let r = f.rep[x]
        if r != int(Rp.I64) && r != int(Rp.Ptr):
            return false
        return f.aux[x] >= 0 - 100000000 && f.aux[x] <= 100000000

    /#/ Is `v` a 64-bit constant that fits the sign-extended 32-bit immediate of an instruction?
    fn small_imm(self, f: &Fun, v: int) => bool:
        let x = self.res(f, v)
        if f.op[x] != int(Op.Const):
            return false
        let r = f.rep[x]
        if r != int(Rp.I64) && r != int(Rp.Ptr):
            return false
        return f.aux[x] >= 0 - 2147483648 && f.aux[x] <= 2147483647

    /#/ Sets the flags for the integer compare `i`.
    fn cmp_flags(self, f: &Fun, i: int) => void:
        let signed = self.is_signed_pred(f.aux[i])
        let wr = f.rep[self.res(f, f.a[i])]
        if wr == int(Rp.I64) || wr == int(Rp.Ptr):
            /#/ a whole register: compare it where it lives
            let la = self.src(f, f.a[i], 0)
            if self.small_imm(f, f.b[i]):
                self.a.cmp_ri(la, f.aux[self.res(f, f.b[i])])
            else:
                self.a.cmp_rr(la, self.src(f, f.b[i], 1))
            return
        self.ld_ext(0, f, f.a[i], signed)
        if self.small_imm(f, f.b[i]):
            self.a.cmp_ri(0, f.aux[self.res(f, f.b[i])])
            return
        self.ld_ext(1, f, f.b[i], signed)
        self.a.cmp_rr(0, 1)

    /#/ Division or remainder of the 64-bit value `i`'s first operand by the constant `d` >= 2,
    /#/ without a divide instruction; false if `op` and `d` have no such form here.
    fn div_const(self, f: &Fun, i: int, op: int, d: int) => bool:
        let signed = op == int(Op.SDiv) || op == int(Op.SRem)
        let rem = op == int(Op.SRem) || op == int(Op.URem)
        let pow2 = (d & (d - 1)) == 0
        let k = 0
        while (1 << k) < d:
            k = k + 1
        if !signed:
            if !pow2:
                return false
            self.ld(0, f, f.a[i])
            if rem:
                self.a.and_ri(0, d - 1)
            else:
                self.a.shift_i(5, 0, k)
            self.st(i, 0)
            return true
        self.ld(1, f, f.a[i])
        if pow2:
            /#/ x + (d - 1 when x is negative), then shifted
            self.a.mov_rr(0, 1)
            self.a.shift_i(7, 0, 63)
            self.a.shift_i(5, 0, 64 - k)
            self.a.add_rr(0, 1)
            if rem:
                self.a.shift_i(7, 0, k)
                self.a.shift_i(4, 0, k)
                self.a.sub_rr(1, 0)
                self.st(i, 1)
            else:
                self.a.shift_i(7, 0, k)
                self.st(i, 0)
            return true
        /#/ q = (mulh(m, x) + x >> (l - 1)) - (x >> 63), with m = 1 + floor(2^(63 + l) / d)
        self.a.mov_ri(0, magic_mult(d, k))
        self.a.grp3(5, 1)
        self.a.add_rr(2, 1)
        self.a.shift_i(7, 2, k - 1)
        self.a.mov_rr(0, 1)
        self.a.shift_i(7, 0, 63)
        self.a.sub_rr(2, 0)
        if rem:
            self.a.imul_rri(2, 2, d)
            self.a.sub_rr(1, 2)
            self.st(i, 1)
        else:
            self.st(i, 2)
        return true

    fn gen_inst(self, f: &Fun, rs: &Reps, sy: &Names, i: int, next: int) => void:
        let op = f.op[i]
        let r = f.rep[i]
        if op == int(Op.Param) || op == int(Op.Slot) || op == int(Op.OwnMove) || op == int(Op.Const) || op == int(Op.StrLit) || op == int(Op.Undef):
            return
        if op == int(Op.Add) || op == int(Op.Sub) || op == int(Op.Mul) || op == int(Op.And) || op == int(Op.Or) || op == int(Op.Xor):
            let d = self.home[i]
            if d >= 0:
                /#/ the result has a register: work in it, with the operands where they live
                let a = f.a[i]
                let b = f.b[i]
                if self.home_of(f, b) == d && op != int(Op.Sub):
                    a = f.b[i]
                    b = f.a[i]
                if self.home_of(f, b) != d:
                    if self.small_imm(f, b):
                        let v = f.aux[self.res(f, b)]
                        if op == int(Op.Mul):
                            if v > 0 && (v & (v - 1)) == 0:
                                self.ld(d, f, a)
                                let sh = 0
                                while (1 << sh) < v:
                                    sh = sh + 1
                                self.a.shift_i(4, d, sh)
                            else:
                                self.a.imul_rri(d, self.src(f, a, 0), v)
                            return
                        if op == int(Op.Add) && self.home_of(f, a) >= 0:
                            self.a.lea(d, self.home_of(f, a), v)
                            return
                        self.ld(d, f, a)
                        if op == int(Op.Add):
                            self.a.add_ri(d, v)
                        elif op == int(Op.Sub):
                            self.a.sub_ri(d, v)
                        elif op == int(Op.And):
                            self.a.and_ri(d, v)
                        elif op == int(Op.Or):
                            self.a.or_ri(d, v)
                        else:
                            self.a.xor_ri(d, v)
                        return
                    if op == int(Op.Add) && self.home_of(f, a) >= 0 && self.home_of(f, a) != d && self.home_of(f, b) >= 0:
                        /#/ both operands live on: one lea instead of a copy and an add
                        self.a.lea_idx(d, self.home_of(f, a), self.home_of(f, b), 1)
                        return
                    self.ld(d, f, a)
                    let rb = self.src(f, b, 1)
                    if op == int(Op.Add):
                        self.a.add_rr(d, rb)
                    elif op == int(Op.Sub):
                        self.a.sub_rr(d, rb)
                    elif op == int(Op.Mul):
                        self.a.imul_rr(d, rb)
                    elif op == int(Op.And):
                        self.a.and_rr(d, rb)
                    elif op == int(Op.Or):
                        self.a.or_rr(d, rb)
                    else:
                        self.a.xor_rr(d, rb)
                    return
            self.ld(0, f, f.a[i])
            if (op == int(Op.Add) || op == int(Op.Sub)) && self.small_imm(f, f.b[i]):
                if op == int(Op.Add):
                    self.a.add_ri(0, f.aux[self.res(f, f.b[i])])
                else:
                    self.a.sub_ri(0, f.aux[self.res(f, f.b[i])])
                self.st(i, 0)
                return
            self.ld(1, f, f.b[i])
            if op == int(Op.Add):
                self.a.add_rr(0, 1)
            elif op == int(Op.Sub):
                self.a.sub_rr(0, 1)
            elif op == int(Op.Mul):
                self.a.imul_rr(0, 1)
            elif op == int(Op.And):
                self.a.and_rr(0, 1)
            elif op == int(Op.Or):
                self.a.or_rr(0, 1)
            else:
                self.a.xor_rr(0, 1)
            self.st(i, 0)
            return
        if op == int(Op.SDiv) || op == int(Op.SRem) || op == int(Op.UDiv) || op == int(Op.URem):
            let signed = op == int(Op.SDiv) || op == int(Op.SRem)
            if r == int(Rp.I64) && self.small_imm(f, f.b[i]) && f.aux[self.res(f, f.b[i])] >= 2:
                if self.div_const(f, i, op, f.aux[self.res(f, f.b[i])]):
                    return
            self.ld_ext(0, f, f.a[i], signed)
            self.ld_ext(1, f, f.b[i], signed)
            if signed:
                self.a.cqo()
                self.a.idiv(1)
            else:
                self.a.mov_ri(2, 0)
                self.a.div(1)
            if op == int(Op.SDiv) || op == int(Op.UDiv):
                self.st(i, 0)
            else:
                self.st(i, 2)
            return
        if op == int(Op.Shl) || op == int(Op.AShr) || op == int(Op.LShr):
            if self.small_imm(f, f.b[i]):
                let k = f.aux[self.res(f, f.b[i])]
                if k >= 0 && k < 64:
                    let sc = 4
                    if op == int(Op.LShr):
                        sc = 5
                    elif op == int(Op.AShr):
                        sc = 7
                    let d = self.home[i]
                    if d >= 0:
                        self.ld_ext(d, f, f.a[i], op == int(Op.AShr))
                        self.a.shift_i(sc, d, k)
                    else:
                        self.ld_ext(0, f, f.a[i], op == int(Op.AShr))
                        self.a.shift_i(sc, 0, k)
                        self.st(i, 0)
                    return
            self.ld_ext(0, f, f.a[i], op == int(Op.AShr))
            self.ld(1, f, f.b[i])
            if op == int(Op.Shl):
                self.a.shift_cl(4, 0)
            elif op == int(Op.LShr):
                self.a.shift_cl(5, 0)
            else:
                self.a.shift_cl(7, 0)
            self.st(i, 0)
            return
        if op == int(Op.FnAddr):
            self.a.lea_rip(0, self.callee(sy, f.aux[i]), 0)
            self.st(i, 0)
            return
        if op == int(Op.Neg) || op == int(Op.Not):
            self.ld(0, f, f.a[i])
            if op == int(Op.Neg):
                self.a.neg(0)
            else:
                self.a.not_(0)
            self.st(i, 0)
            return
        if op == int(Op.FNeg):
            let single = r == int(Rp.F32)
            let xa = self.xsrc(f, f.a[i], 0)
            let xd = self.xdst(i)
            if single:
                self.a.mov_ri(1, 2147483648)
            else:
                self.a.mov_ri(1, 0 - 9223372036854775807 - 1)
            self.a.movq_x(1, 1, false)
            if xd != xa:
                self.a.movaps(xd, xa)
            self.a.xorps(xd, 1)
            self.xfin(f, i, xd)
            return
        if op == int(Op.FAdd) || op == int(Op.FSub) || op == int(Op.FMul) || op == int(Op.FDiv):
            let single = r == int(Rp.F32)
            let code = 88
            if op == int(Op.FMul):
                code = 89
            elif op == int(Op.FSub):
                code = 92
            elif op == int(Op.FDiv):
                code = 94
            let xa = self.xsrc(f, f.a[i], 0)
            let xb = self.xsrc(f, f.b[i], 1)
            let xd = self.xdst(i)
            if xd == xa:
                self.a.sse(code, single, xd, xb)
            elif xd == xb && (op == int(Op.FAdd) || op == int(Op.FMul)):
                self.a.sse(code, single, xd, xa)
            elif xd != xb:
                self.a.movaps(xd, xa)
                self.a.sse(code, single, xd, xb)
            else:
                self.a.movaps(0, xa)
                self.a.sse(code, single, 0, xb)
                self.a.movaps(xd, 0)
            self.xfin(f, i, xd)
            return
        if op == int(Op.FRem):
            let single = r == int(Rp.F32)
            let xa = self.xsrc(f, f.a[i], 0)
            if xa != 0:
                self.a.movaps(0, xa)
            let xb = self.xsrc(f, f.b[i], 1)
            if xb != 1:
                self.a.movaps(1, xb)
            let nm = new_txt()
            if single:
                nm.put("fmodf")
            else:
                nm.put("fmod")
            self.a.call_sym(self.o.sym(&nm))
            self.xfin(f, i, 0)
            return
        if op == int(Op.Cmp):
            if self.fused(f, i):
                return
            self.cmp_flags(f, i)
            if self.home[i] >= 0:
                self.a.setcc(self.cc_of(f.aux[i]), self.home[i])
            else:
                self.a.setcc(self.cc_of(f.aux[i]), 0)
                self.st(i, 0)
            return
        if op == int(Op.FCmp):
            let p = f.aux[i]
            if self.fflag_ok(f, i) && self.fused(f, i):
                return
            let single = f.rep[self.res(f, f.a[i])] == int(Rp.F32)
            let xa = self.xsrc(f, f.a[i], 0)
            let xb = self.xsrc(f, f.b[i], 1)
            if p == int(Pr.OLt) || p == int(Pr.OLe):
                self.a.ucomi(single, xb, xa)
                if p == int(Pr.OLt):
                    self.a.setcc(cc_a(), 0)
                else:
                    self.a.setcc(cc_ae(), 0)
            elif p == int(Pr.OGt) || p == int(Pr.OGe):
                self.a.ucomi(single, xa, xb)
                if p == int(Pr.OGt):
                    self.a.setcc(cc_a(), 0)
                else:
                    self.a.setcc(cc_ae(), 0)
            else:
                self.a.ucomi(single, xa, xb)
                if p == int(Pr.OEq):
                    self.a.setcc(cc_e(), 0)
                    self.a.setcc(cc_np(), 1)
                else:
                    self.a.setcc(cc_ne(), 0)
                    self.a.setcc(cc_np(), 1)
                self.a.and_rr(0, 1)
            self.st(i, 0)
            return
        if op == int(Op.Trunc) || op == int(Op.Bitcast) || op == int(Op.PtrToInt) || op == int(Op.IntToPtr):
            if self.home[i] >= 0:
                self.ld(self.home[i], f, f.a[i])
                return
            self.ld(0, f, f.a[i])
            self.st(i, 0)
            return
        if op == int(Op.SExt) || op == int(Op.ZExt):
            if self.home[i] >= 0:
                self.ld_ext(self.home[i], f, f.a[i], op == int(Op.SExt))
                return
            self.ld_ext(0, f, f.a[i], op == int(Op.SExt))
            self.st(i, 0)
            return
        if op == int(Op.SiToFp) || op == int(Op.UiToFp):
            let single = r == int(Rp.F32)
            let signed = op == int(Op.SiToFp)
            let xd = self.xdst(i)
            self.ld_ext(0, f, f.a[i], signed)
            if signed || f.rep[self.res(f, f.a[i])] != int(Rp.I64):
                self.a.cvt_si2f(xd, 0, single)
            else:
                let pos = self.a.new_label()
                let done = self.a.new_label()
                self.a.test_rr(0, 0)
                self.a.jcc(9, pos)
                self.a.mov_rr(1, 0)
                self.a.shift_i(5, 0, 1)
                self.a.mov_ri(2, 1)
                self.a.and_rr(1, 2)
                self.a.or_rr(0, 1)
                self.a.cvt_si2f(xd, 0, single)
                self.a.sse(88, single, xd, xd)
                self.a.jmp(done)
                self.a.bind(pos)
                self.a.cvt_si2f(xd, 0, single)
                self.a.bind(done)
            self.xfin(f, i, xd)
            return
        if op == int(Op.FpToSi) || op == int(Op.FpToUi):
            let single = f.rep[self.res(f, f.a[i])] == int(Rp.F32)
            let xa = self.xsrc(f, f.a[i], 0)
            if op == int(Op.FpToUi) && r == int(Rp.I64):
                let small = self.a.new_label()
                let done = self.a.new_label()
                if xa != 0:
                    self.a.movaps(0, xa)
                if single:
                    self.a.mov_ri(1, 1593835520)
                else:
                    self.a.mov_ri(1, 4890909195324358656)
                self.a.movq_x(1, 1, single)
                self.a.ucomi(single, 0, 1)
                self.a.jcc(cc_b(), small)
                self.a.sse(92, single, 0, 1)
                self.a.cvt_f2si(0, 0, single)
                self.a.mov_ri(1, 0 - 9223372036854775807 - 1)
                self.a.xor_rr(0, 1)
                self.a.jmp(done)
                self.a.bind(small)
                self.a.cvt_f2si(0, 0, single)
                self.a.bind(done)
            else:
                self.a.cvt_f2si(0, xa, single)
            self.st(i, 0)
            return
        if op == int(Op.FpExt) || op == int(Op.FpTrunc):
            let to_single = op == int(Op.FpTrunc)
            let xa = self.xsrc(f, f.a[i], 0)
            let xd = self.xdst(i)
            self.a.cvt_ff(xd, xa, to_single)
            self.xfin(f, i, xd)
            return
        if (op == int(Op.Field) || op == int(Op.Index)) && self.folds(f, i):
            return
        if op == int(Op.Field):
            let d = self.home[i]
            if d < 0:
                d = 0
            let rb = self.src(f, f.a[i], 0)
            if f.aux[i] == 0 && rb == d:
                self.st(i, d)
                return
            self.a.lea(d, rb, f.aux[i])
            self.st(i, d)
            return
        if op == int(Op.Index):
            let d = self.home[i]
            if d < 0:
                d = 0
            let sz = f.aux[i]
            let ba = self.res(f, f.a[i])
            if f.op[ba] == int(Op.StrLit) && (sz == 1 || sz == 2 || sz == 4 || sz == 8) && self.near_const(f, f.b[i]):
                /#/ a place in the text of a literal: one rip-relative lea
                self.a.lea_rip(d, 1, self.sbase + self.so(f.aux[ba]) + f.aux[self.res(f, f.b[i])] * sz)
                self.st(i, d)
                return
            let ra = self.src(f, f.a[i], 0)
            let rb = 1
            if !((sz == 1 || sz == 2 || sz == 4 || sz == 8) && self.near_const(f, f.b[i])):
                rb = self.src(f, f.b[i], 1)
            if (sz == 1 || sz == 2 || sz == 4 || sz == 8) && self.near_const(f, f.b[i]):
                let dp = f.aux[self.res(f, f.b[i])] * sz
                if !(dp == 0 && ra == d):
                    self.a.lea(d, ra, dp)
            elif sz == 1 || sz == 2 || sz == 4 || sz == 8:
                self.a.lea_idx(d, ra, rb, sz)
            else:
                self.a.imul_rri(1, rb, sz)
                self.a.lea_idx(d, ra, 1, 1)
            self.st(i, d)
            return
        if op == int(Op.Extract):
            let ar = f.rep[self.res(f, f.a[i])]
            let eo = elem_off(rs, ar, f.aux[i])
            let sb = self.ab_reg(f, f.a[i])
            let sd = self.ab_disp(f, f.a[i]) + eo
            if r >= rp_first_agg():
                self.copy_mem(self.vb(i), 0 - self.voff[i], sb, sd, rsize(rs, r))
            elif self.xhome[i] >= 0:
                self.a.load_x(self.xhome[i], sb, sd, r == int(Rp.F32))
            else:
                let d = self.home[i]
                if d < 0:
                    d = 0
                self.a.load(d, sb, sd, rsize(rs, r))
                self.st(i, d)
            return
        if op == int(Op.Insert):
            let eo = elem_off(rs, r, f.aux[i])
            let sb = self.ab_reg(f, f.a[i])
            self.copy_mem(self.vb(i), 0 - self.voff[i], sb, self.ab_disp(f, f.a[i]), rsize(rs, r))
            let er = f.rep[self.res(f, f.b[i])]
            if er >= rp_first_agg():
                let eb = self.ab_reg(f, f.b[i])
                self.copy_mem(self.vb(i), 0 - self.voff[i] + eo, eb, self.ab_disp(f, f.b[i]), rsize(rs, er))
            else:
                self.ld(0, f, f.b[i])
                self.a.store(self.vb(i), 0 - self.voff[i] + eo, 0, rsize(rs, er))
            return
        if op == int(Op.Load):
            if r >= rp_first_agg():
                self.ld(6, f, f.a[i])
                self.copy_mem(self.vb(i), 0 - self.voff[i], 6, 0, rsize(rs, r))
            elif self.xhome[i] >= 0:
                let xd = self.xhome[i]
                let sg = r == int(Rp.F32)
                let x = self.res(f, f.a[i])
                if self.folds(f, x):
                    self.addr_of(f, x, 6, 1)
                    if self.am_idx >= 0:
                        self.a.load_x_idx(xd, self.am_base, self.am_idx, self.am_scale, 0, sg)
                    else:
                        self.a.load_x(xd, self.am_base, self.am_disp, sg)
                else:
                    self.a.load_x(xd, self.src(f, f.a[i], 6), 0, sg)
            else:
                let d = self.home[i]
                if d < 0:
                    d = 0
                let x = self.res(f, f.a[i])
                if self.folds(f, x):
                    self.addr_of(f, x, 6, 1)
                    if self.am_idx >= 0:
                        self.a.load_idx(d, self.am_base, self.am_idx, self.am_scale, 0, rsize(rs, r))
                    else:
                        self.a.load(d, self.am_base, self.am_disp, rsize(rs, r))
                else:
                    self.a.load(d, self.src(f, f.a[i], 6), 0, rsize(rs, r))
                self.st(i, d)
            return
        if op == int(Op.Store):
            let vr = f.rep[self.res(f, f.b[i])]
            if vr >= rp_first_agg():
                self.ld(7, f, f.a[i])
                let sb = self.ab_reg(f, f.b[i])
                self.copy_mem(7, 0, sb, self.ab_disp(f, f.b[i]), rsize(rs, vr))
            elif self.xhome[self.res(f, f.b[i])] >= 0:
                let xv = self.xhome[self.res(f, f.b[i])]
                let sg = vr == int(Rp.F32)
                let x = self.res(f, f.a[i])
                if self.folds(f, x):
                    self.addr_of(f, x, 1, 6)
                    if self.am_idx >= 0:
                        self.a.store_x_idx(self.am_base, self.am_idx, self.am_scale, 0, xv, sg)
                    else:
                        self.a.store_x(self.am_base, self.am_disp, xv, sg)
                else:
                    self.a.store_x(self.src(f, f.a[i], 1), 0, xv, sg)
            else:
                let rv = self.src(f, f.b[i], 0)
                let x = self.res(f, f.a[i])
                if self.folds(f, x):
                    self.addr_of(f, x, 1, 6)
                    if self.am_idx >= 0:
                        self.a.store_idx(self.am_base, self.am_idx, self.am_scale, 0, rv, rsize(rs, vr))
                    else:
                        self.a.store(self.am_base, self.am_disp, rv, rsize(rs, vr))
                else:
                    self.a.store(self.src(f, f.a[i], 1), 0, rv, rsize(rs, vr))
            return
        if op == int(Op.Alloc):
            self.a.mov_ri(7, f.ty[i])
            let nm = new_txt()
            nm.put("malloc")
            self.a.call_sym(self.o.sym(&nm))
            self.st(i, 0)
            return
        if op == int(Op.Free):
            self.ld(7, f, f.a[i])
            let nm = new_txt()
            nm.put("free")
            self.a.call_sym(self.o.sym(&nm))
            return
        if op == int(Op.Drop) || op == int(Op.Clone):
            self.nav = 0
            self.push_arg(f.a[i])
            self.do_call(f, rs, i, self.callee(sy, f.aux[i]), false)
            return
        if op == int(Op.Call) || op == int(Op.CCall) || op == int(Op.CallI):
            self.nav = 0
            for k in 0..f.b[i]:
                self.push_arg(f.pool[f.a[i] + k])
            if op == int(Op.CallI) && self.a.sbx:
                /#/ a function value would have to be a checked table index
                self.bad()
                return
            if op == int(Op.CallI):
                self.ld(11, f, f.c[i])
                self.do_call(f, rs, i, 0 - 1, false)
            else:
                self.do_call(f, rs, i, self.callee(sy, f.aux[i]), op == int(Op.CCall) && f.c[i] != 0)
            return
        if op == int(Op.Br):
            let e = f.aux[i]
            self.edge_copy(f, rs, e)
            if f.eto[e] != next:
                self.a.jmp(f.eto[e])
            return
        if op == int(Op.CondBr):
            let e1 = f.b[i]
            let e2 = f.c[i]
            let c = self.res(f, f.a[i])
            let cc = cc_ne()
            if f.op[c] == int(Op.Cmp) && self.fused(f, c):
                self.cmp_flags(f, c)
                cc = self.cc_of(f.aux[c])
            elif f.op[c] == int(Op.FCmp) && self.fflag_ok(f, c) && self.fused(f, c):
                cc = self.fcmp_flags(f, c)
            else:
                self.ld_ext(0, f, f.a[i], false)
                self.a.extend(0, 0, 1, false)
                self.a.test_rr(0, 0)
            if f.eargn[e1] == 0 && f.eargn[e2] == 0:
                /#/ no moves on either edge: one conditional jump, the other way falls through
                if f.eto[e2] == next:
                    self.a.jcc(cc, f.eto[e1])
                elif f.eto[e1] == next:
                    self.a.jcc(cc ^ 1, f.eto[e2])
                else:
                    self.a.jcc(cc, f.eto[e1])
                    self.a.jmp(f.eto[e2])
                return
            if f.eargn[e1] == 0:
                /#/ the true edge needs no moves: jump straight to its block
                self.a.jcc(cc, f.eto[e1])
                self.edge_copy(f, rs, e2)
                if f.eto[e2] != next:
                    self.a.jmp(f.eto[e2])
                return
            if f.eargn[e2] == 0:
                self.a.jcc(cc ^ 1, f.eto[e2])
                self.edge_copy(f, rs, e1)
                if f.eto[e1] != next:
                    self.a.jmp(f.eto[e1])
                return
            let yes = self.a.new_label()
            self.a.jcc(cc, yes)
            self.edge_copy(f, rs, e2)
            self.a.jmp(f.eto[e2])
            self.a.bind(yes)
            self.edge_copy(f, rs, e1)
            if f.eto[e1] != next:
                self.a.jmp(f.eto[e1])
            return
        if op == int(Op.Switch):
            self.ld_ext(0, f, f.a[i], true)
            for k in 0..f.b[i]:
                let skip = self.a.new_label()
                let e = f.pool[f.aux[i] + k * 2 + 1]
                self.a.mov_ri(1, f.pool[f.aux[i] + k * 2])
                self.a.cmp_rr(0, 1)
                self.a.jcc(cc_ne(), skip)
                self.edge_copy(f, rs, e)
                self.a.jmp(f.eto[e])
                self.a.bind(skip)
            self.edge_copy(f, rs, f.c[i])
            self.a.jmp(f.eto[f.c[i]])
            return
        if op == int(Op.Ret):
            if f.a[i] >= 0:
                let vr = f.rep[self.res(f, f.a[i])]
                if vr >= rp_first_agg():
                    self.a.load(7, 5, 0 - 8, 8)
                    let sb = self.ab_reg(f, f.a[i])
                    self.copy_mem(7, 0, sb, self.ab_disp(f, f.a[i]), rsize(rs, vr))
                elif self.is_int_class(vr):
                    self.ld(0, f, f.a[i])
                else:
                    let rx = self.res(f, f.a[i])
                    if self.xhome[rx] >= 0:
                        self.a.movaps(0, self.xhome[rx])
                    else:
                        self.ld(0, f, f.a[i])
                        self.a.movq_x(0, 0, vr == int(Rp.F32))
            if self.epi_jump:
                self.a.jmp(self.epi)
            else:
                self.epilogue()
            return
        if op == int(Op.Unreachable):
            self.a.ud2()
            return
        self.bad()

    /#/ ---- functions ---------------------------------------------------------

    /#/ Generates function `f`; returns false if something could not be translated.
    fn gen_fun(self, f: &Fun, rs: &Reps, sy: &Names) => bool:
        self.err = 0
        self.rbase = 0
        if f.ret >= rp_first_agg():
            self.rbase = 8
        self.a.begin_fun()
        if len(self.ord) < f.nb + 1:
            self.ord = new_buf(int, f.nb + 1)
            self.emit = new_buf(int, f.nb + 1)
        /#/ the registers are given along the plain order (a header before its loop), the code is
        /#/ written in the rotated one
        block_order(f, &self.ord, false)
        block_order(f, &self.emit, true)
        self.alloc_regs(f, rs)
        self.count_uses(f)
        self.layout(f, rs)
        let start = self.a.pos()
        for b in 0..f.nb:
            self.a.new_label()
        self.a.push(5)
        self.a.mov_rr(5, 4)
        /#/ [rbp-8] is the place of the pointer for a returned aggregate (rdi); the saved registers
        /#/ follow, then the locals
        if self.rbase > 0:
            self.a.push(7)
        for k in 0..self.nsaved:
            self.a.push(self.saved[k])
        if self.frame > self.rbase + 8 * self.nsaved:
            self.a.sub_ri(4, self.frame - self.rbase - 8 * self.nsaved)
        if self.sframe > 0:
            self.a.sub_ri(14, self.sframe)
        let nret = 0
        for b in 0..f.nb:
            if f.blast[b] >= 0 && f.op[f.blast[b]] == int(Op.Ret):
                nret = nret + 1
        self.epi_jump = self.nsaved > 0 && nret > 1
        self.epi = self.a.new_label()
        /#/ the parameters of the entry block
        let ci = 0
        let cx = 0
        let cs = 0
        if f.ret >= rp_first_agg():
            ci = 1
        let p = f.pfirst[0]
        while p >= 0:
            let r = f.rep[p]
            if r >= rp_first_agg() || self.is_int_class(r):
                if ci < 6:
                    if r >= rp_first_agg():
                        self.copy_mem(self.vb(p), 0 - self.voff[p], int_reg(ci), 0, rsize(rs, r))
                    else:
                        self.st(p, int_reg(ci))
                else:
                    self.a.load(0, 5, 16 + 8 * cs, 8)
                    if r >= rp_first_agg():
                        self.a.mov_rr(6, 0)
                        self.copy_mem(self.vb(p), 0 - self.voff[p], 6, 0, rsize(rs, r))
                    else:
                        self.st(p, 0)
                    cs = cs + 1
                ci = ci + 1
            else:
                if cx < 8:
                    if self.xhome[p] >= 0:
                        self.a.movaps(self.xhome[p], cx)
                    else:
                        self.a.movq_r(0, cx, r == int(Rp.F32))
                        self.st(p, 0)
                else:
                    self.a.load(0, 5, 16 + 8 * cs, 8)
                    self.st(p, 0)
                    cs = cs + 1
                cx = cx + 1
            p = f.nx[p]
        for k in 0..self.nhc:
            let c = self.hc[k]
            if self.xhome[c] >= 0:
                self.ld(0, f, c)
                self.a.movq_x(self.xhome[c], 0, f.rep[c] == int(Rp.F32))
            elif self.home[c] >= 0:
                /#/ a constant that only a store or a call argument reads got a general register
                self.ld(self.home[c], f, c)
        self.mk_n = 0
        let last_ln = 0
        for oi in 0..f.nb:
            let b = self.emit[oi]
            self.a.bind(b)
            let i = f.bfirst[b]
            while i >= 0:
                if f.ln[i] > 0 && f.ln[i] != last_ln:
                    last_ln = f.ln[i]
                    if self.mk_n >= len(self.mk_l):
                        self.mk_l = buf_resize(self.mk_l, (self.mk_n + 1) * 2)
                        self.mk_ln = buf_resize(self.mk_ln, (self.mk_n + 1) * 2)
                    let ml = self.a.mark()
                    self.mk_l[self.mk_n] = ml
                    self.mk_ln[self.mk_n] = last_ln
                    self.mk_n = self.mk_n + 1
                let nxt = -1
                if f.nx[i] < 0 && oi + 1 < f.nb:
                    nxt = self.emit[oi + 1]
                self.gen_inst(f, rs, sy, i, nxt)
                i = f.nx[i]
        if self.epi_jump:
            self.a.bind(self.epi)
            self.epilogue()
        let ok = self.a.end_fun()
        let w = new_txt()
        for k in 0..len(f.nm):
            w.put_byte(f.nm[k])
        let sym = self.o.sym(&w)
        self.o.define(sym, start, self.a.pos() - start)
        if ok && self.err == 0 && self.mk_n > 0:
            if self.lf_n >= len(self.lf_sym):
                self.lf_sym = buf_resize(self.lf_sym, (self.lf_n + 1) * 2)
                self.lf_start = buf_resize(self.lf_start, (self.lf_n + 1) * 2)
                self.lf_m0 = buf_resize(self.lf_m0, (self.lf_n + 1) * 2)
            self.lf_sym[self.lf_n] = sym
            self.lf_start[self.lf_n] = start
            self.lf_m0[self.lf_n] = self.lm_n
            self.lf_n = self.lf_n + 1
            for k in 0..self.mk_n:
                if self.lm_n >= len(self.lm_at):
                    self.lm_at = buf_resize(self.lm_at, (self.lm_n + 1) * 2)
                    self.lm_ln = buf_resize(self.lm_ln, (self.lm_n + 1) * 2)
                self.lm_at[self.lm_n] = self.a.lab[self.mk_l[k]]
                self.lm_ln[self.lm_n] = self.mk_ln[k]
                self.lm_n = self.lm_n + 1
        if self.cur >= 0 && ok && self.err == 0:
            if self.cur >= len(self.msk):
                let old = len(self.msk)
                self.msk = buf_resize(self.msk, (self.cur + 1) * 2)
                for q in old..len(self.msk):
                    self.msk[q] = 0
            self.msk[self.cur] = 8 + self.fmask
        return ok && self.err == 0

/#/ ---- the places of the lines of the flattened text ------------------------------------------------
/#/ The driver gives the stretches of the flattened text (from a line on, a file and a line of that
/#/ file) so that the line marks can name `file:line`; without them lines stay as numbers.
let dbg_seg_line = new_buf(int, 1)
let dbg_seg_src = new_buf(int, 1)
let dbg_seg_unit = new_buf(int, 1)
let dbg_nseg = 0
let dbg_units = new_txt()
let dbg_lines = 0
let dbg_dir = new_txt()
/#/ Variables and their types go in the table too (set with `-O0 -g`).
let dbg_vars = false

fn set_debug_vars() => void:
    dbg_vars = true

fn set_line_map(seg_line: &buf<int>, seg_src: &buf<int>, seg_unit: &buf<int>, nseg: int, units: &Txt, lines: int, dir: &Txt) => void:
    dbg_seg_line = new_buf(int, nseg + 1)
    dbg_seg_src = new_buf(int, nseg + 1)
    dbg_seg_unit = new_buf(int, nseg + 1)
    for k in 0..nseg:
        dbg_seg_line[k] = seg_line[k]
        dbg_seg_src[k] = seg_src[k]
        dbg_seg_unit[k] = seg_unit[k]
    dbg_nseg = nseg
    dbg_units = new_txt()
    dbg_units.put_all(units)
    dbg_lines = lines
    dbg_dir = new_txt()
    dbg_dir.put_all(dir)

/#/ The stretch of the flattened text that line `line` (1-based) is in, -1 when there is none.
fn dbg_seg_of(line: int) => int:
    if line < 1 || line > dbg_lines || dbg_nseg == 0:
        return 0 - 1
    let lo = 0
    let hi = dbg_nseg
    while lo < hi:
        let mid = (lo + hi) // 2
        if dbg_seg_line[mid] <= line - 1:
            lo = mid + 1
        else:
            hi = mid
    return lo - 1

/#/ The source file number `u` appended to `out`.
fn put_unit_name(out: &Txt, u: int) => void:
    let k = 0
    let s = 0
    for i in 0..dbg_units.n:
        if dbg_units.b[i] == 10:
            if k == u:
                for q in s..i:
                    out.put_byte(dbg_units.b[q])
                return
            k = k + 1
            s = i + 1

/#/ The line marks as text: `D directory` once when known, `F name` for each function, then
/#/ `L offset place` for each place where the code of another line starts (the offset from the start
/#/ of the function; the place is `file:line` when the driver gave the map, else the line of the
/#/ flattened text).
fn lines_dump(g: &Gen, out: &Txt) => void:
    if dbg_dir.n > 0:
        out.put("D ")
        out.put_all(&dbg_dir)
        out.put_byte(10)
    out.put_all(&g.dt.out)
    for k in 0..g.lf_n:
        let fn_txt = new_txt()
        let s = g.lf_sym[k] - 2
        for q in g.o.s_name[s]..g.o.s_name[s] + 4096:
            if g.o.names.b[q] == 0:
                break
            fn_txt.put_byte(g.o.names.b[q])
        let hi = g.lm_n
        if k + 1 < g.lf_n:
            hi = g.lf_m0[k + 1]
        let rows = new_txt()
        for m in g.lf_m0[k]..hi:
            /#/ a later mark at the same offset replaces an earlier one
            if m + 1 < hi && g.lm_at[m + 1] == g.lm_at[m]:
                continue
            let ln = g.lm_ln[m]
            if dbg_nseg > 0:
                let sg = dbg_seg_of(ln)
                if sg < 0:
                    continue
                rows.put("L ")
                rows.put_int(g.lm_at[m] - g.lf_start[k])
                rows.put_byte(32)
                put_unit_name(&rows, dbg_seg_unit[sg])
                rows.put_byte(58)
                rows.put_int(dbg_seg_src[sg] + (ln - 1 - dbg_seg_line[sg]))
                rows.put_byte(10)
            else:
                rows.put("L ")
                rows.put_int(g.lm_at[m] - g.lf_start[k])
                rows.put_byte(32)
                rows.put_int(ln)
                rows.put_byte(10)
        if rows.n > 0:
            out.put("F ")
            out.put_all(&fn_txt)
            out.put_byte(10)
            out.put_all(&rows)
            if k < len(g.vr_s) && g.vr_e[k] > g.vr_s[k]:
                for q in g.vr_s[k]..g.vr_e[k]:
                    out.put_byte(g.vtxt.b[q])

fn new_gen() => Gen:
    return Gen { a: new_asm(), o: new_obj(), voff: new_buf(int, 64), sh: new_buf(int, 64), sframe: 0, tmp: 0, frame: 0, err: 0, av: new_buf(int, 16), nav: 0, sbase: 256, soff: new_buf(int, 16), nstr: 0, home: new_buf(int, 64), xhome: new_buf(int, 64), ord: new_buf(int, 16), emit: new_buf(int, 16), xsg: new_buf(int, 64), did: new_buf(int, 64), nsaved: 0, rbase: 0, saved: new_buf(int, 8), ed: new_buf(int, 16), ned: 0, ra_lo: new_buf(int, 1), ra_hi: new_buf(int, 1), ra_wt: new_buf(int, 1), uq_d: new_buf(int, 16), uq_b: new_buf(int, 16), nuq: 0, ra_dblk: new_buf(int, 1), ra_dset: new_buf(int, 1), ra_cp: new_buf(int, 16), ra_ncp: 0, ra_cm: new_buf(int, 16), cur: -1, msk: new_buf(int, 16), fmask: 0, nuse: new_buf(int, 64), am_base: 0, am_idx: -1, am_scale: 1, am_disp: 0, epi: 0, epi_jump: false, hc: new_buf(int, 16), nhc: 0, lm_at: new_buf(int, 64), lm_ln: new_buf(int, 64), lm_n: 0, mk_l: new_buf(int, 64), mk_ln: new_buf(int, 64), mk_n: 0, lf_sym: new_buf(int, 64), lf_start: new_buf(int, 64), lf_m0: new_buf(int, 64), lf_n: 0, dt: new_dbg_types(), vtxt: new_txt(), vr_s: new_buf(int, 64), vr_e: new_buf(int, 64) }

/#/ The multiplier that divides by `d` (not a power of two; `l` is the log2 of `d` rounded up):
/#/ 1 + floor(2^(63 + l) / d), taken as a 64-bit pattern, by long division one bit at a time.
fn magic_mult(d: int, l: int) => int:
    let q = 0
    let r = 0
    let bit = 63 + l
    while bit >= 0:
        r = r * 2
        if bit == 63 + l:
            r = r + 1
        if r >= d:
            r = r - d
            if bit < 64:
                q = q | (1 << bit)
        bit = bit - 1
    return q + 1

fn rsize_scalar(r: int) => int:
    if r == int(Rp.I8):
        return 1
    if r == int(Rp.I16):
        return 2
    if r == int(Rp.I32) || r == int(Rp.F32):
        return 4
    return 8



let stats_on = false
let lint_on = false
let lint_txt = new_txt()

/#/ one row per function: name, then the numbers
class FnStats:
    nm: Txt
    nm_at: buf<int>
    v: buf<int>
    n: int

/#/ columns of `FnStats.v`
fn st_cols() => int:
    return 13

let fstats = new_fnstats()

fn new_fnstats() => FnStats:
    return FnStats { nm: new_txt(), nm_at: new_buf(int, 64), v: new_buf(int, 64 * 13), n: 0 }

fn set_stats() => void:
    stats_on = true

fn set_lint_perf() => void:
    lint_on = true

/#/ The runtime that is linked in after the program is not scanned.
fn no_perf() => void:
    stats_on = false
    lint_on = false

/#/ the place of a line of the flattened text: `file:line` when the driver gave the map
fn put_place(out: &Txt, ln: int) => void:
    if ln <= 0:
        out.put("?")
        return
    let sg = dbg_seg_of(ln)
    if sg < 0 || dbg_nseg == 0:
        out.put("line ")
        out.put_int(ln)
        return
    put_unit_name(out, dbg_seg_unit[sg])
    out.put_byte(58)
    out.put_int(dbg_seg_src[sg] + (ln - 1 - dbg_seg_line[sg]))

/#/ the last finding, so that the same one is not made twice
let last_finding = new_txt()

fn finding(f: &Fun, i: int, fname: &Txt, code: &str, msg: &str) => void:
    let t = new_txt()
    put_place(&t, f.ln[i])
    t.put(": ")
    t.put(code)
    t.put(": in '")
    t.put_all(fname)
    t.put("': ")
    t.put(msg)
    t.put_byte(10)
    if t.same(&last_finding):
        return
    last_finding = t
    lint_txt.put_all(&last_finding)

fn is_call(op: int) => bool:
    return op == int(Op.Call) || op == int(Op.CCall) || op == int(Op.CallI)

/#/ The name of the callee of call `i` (empty for an indirect call).
fn callee_name(f: &Fun, names: &Names, i: int) => Txt:
    let w = new_txt()
    if f.op[i] == int(Op.Call) || f.op[i] == int(Op.CCall):
        names.put(&w, f.aux[i])
    return w

/#/ Marks the operands of instruction `i` as escaping uses in `esc` (by value number).
fn mark_operands(f: &Fun, i: int, esc: &buf<int>) => void:
    let op = f.op[i]
    if op == int(Op.Br) || op == int(Op.Unreachable) || op == int(Op.Const) || op == int(Op.Param) || op == int(Op.Slot) || op == int(Op.Alloc):
        return
    if op == int(Op.Load):
        return
    if op == int(Op.Store):
        let v = f.follow(f.b[i])
        if v >= 0:
            esc[v] = esc[v] + 1
        return
    if is_call(op):
        for k in 0..f.b[i]:
            let v = f.follow(f.pool[f.a[i] + k])
            if v >= 0:
                esc[v] = esc[v] + 1
        if op == int(Op.CallI) && f.c[i] >= 0:
            let v = f.follow(f.c[i])
            esc[v] = esc[v] + 1
        return
    if op == int(Op.CondBr):
        return
    if op == int(Op.Free) || op == int(Op.Drop):
        return
    if f.a[i] >= 0:
        let v = f.follow(f.a[i])
        if v >= 0:
            esc[v] = esc[v] + 1
    if f.b[i] >= 0:
        let v = f.follow(f.b[i])
        if v >= 0:
            esc[v] = esc[v] + 1
    if f.c[i] >= 0:
        let v = f.follow(f.c[i])
        if v >= 0:
            esc[v] = esc[v] + 1

/#/ Looks at the function `f` (named `fname`) and the code the generator made for it: `code` bytes,
/#/ `spills` values in the frame, `nsaved` registers saved, a `frame` of that many bytes.
fn scan_fun(f: &Fun, names: &Names, fname: &Txt, code: int, spills: int, nsaved: int, frame: int) => void:
    /#/ the loops: a back edge goes to a block that was made before the one it leaves
    let depth: buf<int> = new_buf(int, f.nb + 1)
    let lhead: buf<int> = new_buf(int, f.nb + 1)
    let nloops = 0
    for e in 0..f.ne:
        let from = f.efrom[e]
        let to = f.eto[e]
        if from >= 0 && to >= 0 && to <= from && from < f.nb:
            /#/ the loop is the blocks that reach the back edge without passing the header; when that
            /#/ walk gets back to the entry, the header does not dominate the edge and it is no loop
            let mark: buf<int> = new_buf(int, f.nb + 1)
            mark[from] = 1
            mark[to] = 1
            let changed = true
            while changed:
                changed = false
                for e2 in 0..f.ne:
                    let a = f.efrom[e2]
                    let z = f.eto[e2]
                    if a >= 0 && z >= 0 && a < f.nb && z < f.nb && mark[z] == 1 && z != to && mark[a] == 0:
                        mark[a] = 1
                        changed = true
            if to == 0 || mark[0] == 0:
                nloops = nloops + 1
                for b in 0..f.nb:
                    if mark[b] == 1:
                        depth[b] = depth[b] + 1
                        lhead[b] = to
    let esc: buf<int> = new_buf(int, f.ni + 1)
    let reads: buf<int> = new_buf(int, f.ni + 1)
    let writes: buf<int> = new_buf(int, f.ni + 1)
    let last_store: buf<int> = new_buf(int, f.ni + 1)
    let frees: buf<int> = new_buf(int, f.ni + 1)
    for e in 0..f.ne:
        if f.efrom[e] >= 0:
            for k in 0..f.eargn[e]:
                let v = f.follow(f.pool[f.eargs[e] + k])
                if v >= 0:
                    esc[v] = esc[v] + 1
    let ninstr = 0
    let nloads = 0
    let nstores = 0
    let ncalls = 0
    let nallocs = 0
    let ntraps = 0
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            ninstr = ninstr + 1
            let op = f.op[i]
            if op == int(Op.Load):
                nloads = nloads + 1
                let p = f.follow(f.a[i])
                if p >= 0 && f.op[p] == int(Op.Slot):
                    reads[p] = reads[p] + 1
            elif op == int(Op.Store):
                nstores = nstores + 1
                let p = f.follow(f.a[i])
                if p >= 0 && f.op[p] == int(Op.Slot):
                    writes[p] = writes[p] + 1
                    last_store[p] = i
            elif is_call(op):
                ncalls = ncalls + 1
            elif op == int(Op.Alloc) || op == int(Op.Clone):
                nallocs = nallocs + 1
            elif op == int(Op.Unreachable):
                ntraps = ntraps + 1
            if op == int(Op.Free) || op == int(Op.Drop):
                let p = f.follow(f.a[i])
                if p >= 0:
                    frees[p] = frees[p] + 1
            mark_operands(f, i, &esc)
            i = f.nx[i]
    if stats_on:
        let r = fstats.n
        if r >= len(fstats.nm_at):
            fstats.nm_at = buf_resize(fstats.nm_at, (r + 1) * 2)
            fstats.v = buf_resize(fstats.v, (r + 1) * 2 * st_cols())
        fstats.nm_at[r] = fstats.nm.n
        fstats.nm.put_all(fname)
        fstats.nm.put_byte(0)
        let base = r * st_cols()
        fstats.v[base] = code
        fstats.v[base + 1] = ninstr
        fstats.v[base + 2] = f.nb
        fstats.v[base + 3] = nloops
        fstats.v[base + 4] = nloads
        fstats.v[base + 5] = nstores
        fstats.v[base + 6] = ncalls
        fstats.v[base + 7] = nallocs
        fstats.v[base + 8] = ntraps
        fstats.v[base + 9] = spills
        fstats.v[base + 10] = nsaved
        fstats.v[base + 11] = frame
        fstats.v[base + 12] = 0
        fstats.n = r + 1
    if !lint_on:
        return
    let alloc_ln = 0 - 1
    for b in 0..f.nb:
        let i = f.bfirst[b]
        let seen_ptr: buf<int> = new_buf(int, 8)
        let seen_n = 0
        while i >= 0:
            let op = f.op[i]
            if depth[b] > 0:
                if op == int(Op.Alloc) || op == int(Op.Clone):
                    finding(f, i, fname, "perf", "heap allocation inside a loop; allocate once outside it")
                elif op == int(Op.Call) || op == int(Op.CCall):
                    let cn = callee_name(f, names, i)
                    if cn.is("malloc") || cn.is("calloc") || cn.is("strdup") || cn.is("realloc"):
                        alloc_ln = f.ln[i]
                        finding(f, i, fname, "perf", "allocation call inside a loop; allocate once outside it")
                    elif cn.is("memcpy") && f.ln[i] != alloc_ln:
                        finding(f, i, fname, "perf", "memcpy inside a loop; a copy per iteration (a string or an aggregate copied again and again)")
                elif op == int(Op.SDiv) || op == int(Op.UDiv) || op == int(Op.SRem) || op == int(Op.URem) || op == int(Op.FDiv):
                    let d = f.follow(f.b[i])
                    if d >= 0 && !f.is_const(d) && f.op[d] != int(Op.Const) && f.blk[d] < lhead[b]:
                        finding(f, i, fname, "perf", "division by a value that does not change in the loop; hoist the division (a reciprocal, or a shift for a power of two)")
            /#/ arithmetic that does nothing
            if op == int(Op.Add) || op == int(Op.Sub) || op == int(Op.Or) || op == int(Op.Xor) || op == int(Op.Shl) || op == int(Op.AShr) || op == int(Op.LShr):
                let y = f.follow(f.b[i])
                if y >= 0 && f.is_const(y) && f.cval(y) == 0:
                    finding(f, i, fname, "pointless", "arithmetic with 0 changes nothing")
            if op == int(Op.Mul) || op == int(Op.SDiv) || op == int(Op.UDiv):
                let y = f.follow(f.b[i])
                if y >= 0 && f.is_const(y) && f.cval(y) == 1:
                    finding(f, i, fname, "pointless", "multiplication or division by 1 changes nothing")
            if op == int(Op.Cmp):
                if f.follow(f.a[i]) == f.follow(f.b[i]):
                    finding(f, i, fname, "pointless", "a value compared with itself")
            /#/ the same address loaded twice with no write in between
            if op == int(Op.Load):
                let p = f.follow(f.a[i])
                let dup = false
                for k in 0..seen_n:
                    if seen_ptr[k] == p:
                        dup = true
                if dup:
                    finding(f, i, fname, "perf", "load of an address that was loaded just before, with no store or call in between")
                elif seen_n < 8:
                    seen_ptr[seen_n] = p
                    seen_n = seen_n + 1
            if op == int(Op.Store) || is_call(op) || op == int(Op.Free) || op == int(Op.Drop):
                seen_n = 0
            i = f.nx[i]
    /#/ stores nobody reads, and blocks that are allocated and only freed
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let op = f.op[i]
            if op == int(Op.Slot) && writes[i] > 0 && reads[i] == 0 && esc[i] == 0:
                finding(f, last_store[i], fname, "pointless", "a variable is stored to but never read")
            if op == int(Op.Alloc) && esc[i] == 0 && reads[i] == 0:
                let used = false
                for u in 0..f.ni:
                    if f.op[u] == int(Op.Load) || f.op[u] == int(Op.Store) || f.op[u] == int(Op.Field):
                        if f.follow(f.a[u]) == i:
                            used = true
                if !used && frees[i] > 0:
                    finding(f, i, fname, "pointless", "a block is allocated and freed without being used")
            i = f.nx[i]
    if spills > 16:
        lint_txt.put("?: perf: in '")
        lint_txt.put_all(fname)
        lint_txt.put("': ")
        lint_txt.put_int(spills)
        lint_txt.put(" values live in the frame (register pressure); split the function or shorten the live ranges\n")

fn pf_col(out: &Txt, v: int, w: int) => void:
    let t = new_txt()
    t.put_int(v)
    for k in t.n..w:
        out.put_byte(32)
    out.put_all(&t)

/#/ The `--stats` table: the `top` functions with the most code, then the totals.
fn stats_report(out: &Txt, top: int) => void:
    let used: buf<int> = new_buf(int, fstats.n + 1)
    let tot: buf<int> = new_buf(int, st_cols())
    for r in 0..fstats.n:
        for c in 0..st_cols():
            tot[c] = tot[c] + fstats.v[r * st_cols() + c]
    out.put("   code  instrs  blocks  loops  loads  stores  calls  allocs  traps  spills  saved  frame  function\n")
    for k in 0..top:
        let best = 0 - 1
        let bv = 0 - 1
        for r in 0..fstats.n:
            if used[r] == 0 && fstats.v[r * st_cols()] > bv:
                bv = fstats.v[r * st_cols()]
                best = r
        if best < 0:
            break
        used[best] = 1
        for c in 0..12:
            pf_col(out, fstats.v[best * st_cols() + c], 7)
        out.put("  ")
        let p = fstats.nm_at[best]
        while fstats.nm.b[p] != 0:
            out.put_byte(fstats.nm.b[p])
            p = p + 1
        out.put_byte(10)
    out.put("\n")
    for c in 0..12:
        pf_col(out, tot[c], 7)
    out.put("  total of ")
    out.put_int(fstats.n)
    out.put(" functions\n")



/#/ The ownership checker. See RULES.md.
/#/
/#/ Each function is lowered to a graph of events (`Flow.build_*`), then three analyses run on
/#/ it: liveness (backwards), move state and loans (forwards, to a fixed point). Findings are
/#/ reported in one last pass over the settled states.
/#/ The type checker: gives every expression of a module a type and reports what does not fit.
/#/
/#/ `check_types(t, g, a, m)` runs after `declare_types` has typed every signature of the
/#/ modules involved. The type of node `n` is `typer.node[n]`; locals live in the scope table
/#/ with their types in `ty`. The rules are in RULES.md.


enum Bop:
    Add
    Sub
    Mul
    Div
    IDiv
    Rem
    BitAnd
    BitOr
    BitXor
    Shl
    Shr
    And
    Or
    Eq
    Ne
    Lt
    Le
    Gt
    Ge
    Other

/#/ The operator a binary operator token kind stands for.
fn op_of(k: int) => int:
    if k == int(Tk.Plus):
        return int(Bop.Add)
    if k == int(Tk.Minus):
        return int(Bop.Sub)
    if k == int(Tk.Star):
        return int(Bop.Mul)
    if k == int(Tk.Slash):
        return int(Bop.Div)
    if k == int(Tk.SlashSlash):
        return int(Bop.IDiv)
    if k == int(Tk.Percent):
        return int(Bop.Rem)
    if k == int(Tk.Amp):
        return int(Bop.BitAnd)
    if k == int(Tk.Pipe):
        return int(Bop.BitOr)
    if k == int(Tk.Caret):
        return int(Bop.BitXor)
    if k == int(Tk.Shl):
        return int(Bop.Shl)
    if k == int(Tk.Shr):
        return int(Bop.Shr)
    if k == int(Tk.AmpAmp):
        return int(Bop.And)
    if k == int(Tk.PipePipe):
        return int(Bop.Or)
    if k == int(Tk.EqEq):
        return int(Bop.Eq)
    if k == int(Tk.NotEq):
        return int(Bop.Ne)
    if k == int(Tk.Lt):
        return int(Bop.Lt)
    if k == int(Tk.Le):
        return int(Bop.Le)
    if k == int(Tk.Gt):
        return int(Bop.Gt)
    if k == int(Tk.Ge):
        return int(Bop.Ge)
    return int(Bop.Other)

/#/ The value of integer literal token `tok`. `big` is set when it does not fit an `int`.
fn lit_digits(a: &Ast, tok: int) => int:
    let s = a.toks.start[tok]
    let e = a.toks.end[tok]
    let base = 10
    if e - s > 2 && a.byte_at(s) == '0':
        let p = a.byte_at(s + 1)
        if p == 'x' || p == 'X':
            base = 16
            s = s + 2
        elif p == 'b' || p == 'B':
            base = 2
            s = s + 2
        elif p == 'o' || p == 'O':
            base = 8
            s = s + 2
    let v = 0
    for i in s..e:
        let b = a.byte_at(i)
        let d = -1
        if b >= '0' && b <= '9':
            d = b - '0'
        elif b >= 'a' && b <= 'f':
            d = b - 'a' + 10
        elif b >= 'A' && b <= 'F':
            d = b - 'A' + 10
        if d >= 0 && d < base:
            if v > (9223372036854775807 - d) // base:
                return -1
            v = v * base + d
    return v

class Typer:
    rd: Reader
    diags: TDiags
    node: buf<int>
    ret: int
    loops: int
    self_class: int
    in_fn: int
    /#/ bindings of the type parameters of the call or member being checked
    binds: buf<int>
    cur: int

    fn err(self, tok: int, code: int, want: int, found: int) => void:
        self.diags.add(tok, code, want, found)

    fn set(self, n: int, ty: int) => int:
        self.node[n] = ty
        return ty

    /#/ How many expression nodes the checker visited and how many of them it could not type.
    fn visited(self, a: &Ast) => int:
        let c = 0
        for i in 0..a.count:
            if self.node[i] >= 0:
                c = c + 1
        return c

    /#/ The scope row a name token refers to; -1 when it names nothing.
    fn lookup(self, a: &Ast, tok: int) => int:
        return self.rd.sc.loc.find_tok(a, tok, 0)

    fn declare_local(self, a: &Ast, tok: int, kind: int, ty: int) => void:
        let r = self.rd.sc.loc.add_tok(a, tok, kind, -1, self.cur)
        self.rd.sc.loc.ty[r] = ty

    fn pop(self, mark: int) => void:
        self.rd.sc.loc.truncate(mark)

    /#/ ---- what fits what -------------------------------------------------

    /#/ Is `anc` the class `cls` or one of its ancestors? Both are class rows of `g`.
    fn inherits(self, g: &Syms, cls: int, anc: int) => bool:
        let cur = cls
        let depth = 0
        while cur >= 0 && depth < 32:
            if cur == anc:
                return true
            let next = -1
            for i in 0..g.n:
                if g.info[i] == cur && g.kind[i] == int(Sk.Parent):
                    next = g.find_class_row(i)
            cur = next
            depth = depth + 1
        return false

    /#/ Can a value of type `from` be used where `to` is wanted?
    fn fits(self, t: &Tys, g: &Syms, from: int, to: int) => bool:
        if from == to || t.kind[from] == int(Ty.Error) || t.kind[to] == int(Ty.Error):
            return true
        let fk = t.kind[from]
        let tk = t.kind[to]
        if fk == int(Ty.Int) && tk == int(Ty.Int):
            let fb = t.a[from]
            let tb = t.a[to]
            if t.b[from] == t.b[to]:
                return fb <= tb
            if t.b[from] == 0 && t.b[to] == 1:
                return fb < tb
            return false
        if fk == int(Ty.Float) && tk == int(Ty.Float):
            return t.a[from] <= t.a[to]
        if fk == int(Ty.Ref) && tk == int(Ty.Ref):
            if t.b[to] == 1 && t.b[from] == 0:
                return false
            let ft = t.a[from]
            let tt = t.a[to]
            if self.fits_target(t, g, ft, tt):
                return true
            /#/ a borrowed buffer or array is a view of its elements
            return false
        if fk == int(Ty.Array) && tk == int(Ty.Slice):
            return t.a[from] == t.a[to]
        if fk == int(Ty.Ref) && tk == int(Ty.Slice):
            let target = t.a[from]
            if t.kind[target] == int(Ty.Buf) && t.a[target] == t.a[to]:
                return true
            if t.kind[target] == int(Ty.Array) && t.a[target] == t.a[to]:
                return true
            return false
        if fk == int(Ty.Named) && tk == int(Ty.Named):
            return t.c[from] == t.c[to] && t.c[from] == 0 && self.inherits(g, t.a[from], t.a[to])
        if tk == int(Ty.Object):
            return fk == int(Ty.Str) || fk == int(Ty.Named) || fk == int(Ty.Ref) || fk == int(Ty.Buf) || fk == int(Ty.Slice)
        if fk == int(Ty.Object):
            return tk == int(Ty.Buf)
        if fk == int(Ty.Tuple) && tk == int(Ty.Tuple) && t.b[from] == t.b[to]:
            for i in 0..t.b[from]:
                if !self.fits(t, g, t.arg(from, i), t.arg(to, i)):
                    return false
            return true
        return false

    /#/ The target of `&target`: `&D` fits `&A` for an ancestor `A`.
    fn fits_target(self, t: &Tys, g: &Syms, from: int, to: int) => bool:
        if from == to || t.kind[from] == int(Ty.Error) || t.kind[to] == int(Ty.Error):
            return true
        if t.kind[from] == int(Ty.Named) && t.kind[to] == int(Ty.Named) && t.c[from] == 0 && t.c[to] == 0:
            return self.inherits(g, t.a[from], t.a[to])
        return false

    /#/ ---- literals -----------------------------------------------------

    /#/ Is node `n` an integer literal, a character, or `-` one: a number that takes the type
    /#/ it is wanted as?
    fn is_flex(self, a: &Ast, n: int) => bool:
        let k = a.kind[n]
        if k == int(Nk.Int) || k == int(Nk.Char):
            return true
        if k == int(Nk.Unary) && a.pc[n] == int(Tk.Minus) && a.pa[n] >= 0:
            return a.kind[a.pa[n]] == int(Nk.Int)
        return false

    /#/ The type of integer literal `n` (negated when `neg`) where `want` is wanted.
    fn int_lit(self, t: &Tys, a: &Ast, n: int, want: int, neg: bool) => int:
        let tok = a.tok[n]
        let v = 0
        if a.kind[n] == int(Nk.Char):
            v = char_value(a, tok)
        else:
            v = lit_digits(a, tok)
        let big = v < 0
        if want >= 0:
            let k = t.kind[want]
            if k == int(Ty.Int):
                if big:
                    if !neg && t.b[want] == 0 && t.a[want] == 8:
                        return want
                elif self.int_fits(t, want, v, neg):
                    return want
            elif k == int(Ty.Object) && v == 0 && !neg:
                return want
        if big:
            /#/ above the largest 64-bit unsigned number the type could hold: it would be -1
            self.err(tok, int(Te.Mismatch), want, t.int_ty(8, true))
        return t.int_ty(8, true)

    fn int_fits(self, t: &Tys, ty: int, v: int, neg: bool) => bool:
        let bytes = t.a[ty]
        if bytes >= 8:
            if t.b[ty] == 1:
                return true
            return !neg || v == 0
        let bits = bytes * 8
        let limit = 1
        for i in 0..bits:
            limit = limit * 2
        if t.b[ty] == 1:
            let half = limit // 2
            if neg:
                return v <= half
            return v < half
        if neg:
            return v == 0
        return v < limit

    /#/ ---- expressions ---------------------------------------------------

    /#/ Types expression `n`; `want` is the type the context hopes for (-1: none), which lets
    /#/ a literal take it. Records and returns the type.
    fn expr(self, t: &Tys, g: &Syms, a: &Ast, n: int, want: int) => int:
        if n < 0:
            return 0
        let k = a.kind[n]
        if k == int(Nk.Int) || k == int(Nk.Char):
            return self.set(n, self.int_lit(t, a, n, want, false))
        if k == int(Nk.Float):
            if want >= 0 && t.kind[want] == int(Ty.Float):
                return self.set(n, want)
            return self.set(n, t.float_ty(8))
        if k == int(Nk.Str):
            if want >= 0 && t.kind[want] == int(Ty.Ref) && t.b[want] == 0 && t.kind[t.a[want]] == int(Ty.Str):
                return self.set(n, want)
            return self.set(n, t.simple(int(Ty.Str)))
        if k == int(Nk.FStr):
            let p = a.child[n]
            while p >= 0:
                let pt = self.value(t, g, a, a.pa[p], -1)
                let base = pt
                if t.kind[base] == int(Ty.Ref):
                    base = t.a[base]
                let bk = t.kind[base]
                if bk != int(Ty.Str) && bk != int(Ty.Int) && bk != int(Ty.Float) && bk != int(Ty.Bool) && bk != int(Ty.Error):
                    self.err(a.tok[a.pa[p]], int(Te.InvalidOperation), -1, pt)
                let sp = fspec_of(a, p)
                if sp.present:
                    let bad = !sp.ok
                    if bk == int(Ty.Str) || bk == int(Ty.Bool):
                        bad = bad || sp.kind != 0 || sp.prec >= 0 || sp.zero
                    elif bk == int(Ty.Int):
                        bad = bad || sp.prec >= 0 || sp.kind == 'f'
                    elif bk == int(Ty.Float):
                        bad = bad || (sp.kind != 0 && sp.kind != 'f')
                    if bad:
                        self.err(a.tok[a.pa[p]], int(Te.InvalidOperation), -1, pt)
                p = a.next[p]
            return self.set(n, t.simple(int(Ty.Str)))
        if k == int(Nk.Bool):
            return self.set(n, t.simple(int(Ty.Bool)))
        if k == int(Nk.Name):
            return self.set(n, self.name(t, g, a, n))
        if k == int(Nk.Binary):
            return self.set(n, self.binary(t, g, a, n, want))
        if k == int(Nk.Unary):
            return self.set(n, self.unary(t, g, a, n, want))
        if k == int(Nk.Call):
            return self.set(n, self.call(t, g, a, n, want))
        if k == int(Nk.Member):
            return self.set(n, self.member(t, g, a, n))
        if k == int(Nk.Index):
            return self.set(n, self.index(t, g, a, n))
        if k == int(Nk.Cast):
            return self.set(n, self.cast(t, g, a, n))
        if k == int(Nk.Tuple):
            return self.set(n, self.tuple(t, g, a, n, want))
        if k == int(Nk.Array):
            return self.set(n, self.array(t, g, a, n, want))
        if k == int(Nk.StructLit):
            return self.set(n, self.struct_lit(t, g, a, n))
        if k == int(Nk.Range):
            self.expr(t, g, a, a.pa[n], -1)
            self.expr(t, g, a, a.pb[n], -1)
            return self.set(n, 0)
        if k == int(Nk.Fn):
            return self.set(n, self.function(t, g, a, n, -1))
        return self.set(n, 0)

    /#/ Types `n` as a value: `void` is no value.
    fn value(self, t: &Tys, g: &Syms, a: &Ast, n: int, want: int) => int:
        let ty = self.expr(t, g, a, n, want)
        if t.kind[ty] == int(Ty.Void):
            self.err(a.tok[n], int(Te.Mismatch), want, ty)
            return 0
        return ty

    /#/ Types `n` where `want` is required: a mismatch is reported once.
    fn expect(self, t: &Tys, g: &Syms, a: &Ast, n: int, want: int) => int:
        let ty = self.value(t, g, a, n, want)
        if !self.fits(t, g, ty, want):
            self.err(a.tok[n], int(Te.Mismatch), want, ty)
        return ty

    fn name(self, t: &Tys, g: &Syms, a: &Ast, n: int) => int:
        let r = self.lookup(a, a.tok[n])
        if r < 0:
            return 0
        let k = self.rd.sc.loc.kind[r]
        if k == int(Sk.Local) || k == int(Sk.Param) || k == int(Sk.Global) || k == int(Sk.Fn):
            let ty = self.rd.sc.loc.ty[r]
            if ty < 0:
                return 0
            return ty
        return 0

    /#/ ---- operators ---------------------------------------------------------

    fn strip_refs(self, t: &Tys, ty: int) => int:
        let cur = ty
        while t.kind[cur] == int(Ty.Ref):
            cur = t.a[cur]
        return cur

    /#/ The common type of two numbers, 0 when neither fits the other.
    fn join(self, t: &Tys, g: &Syms, l: int, r: int) => int:
        if self.fits(t, g, l, r):
            return r
        if self.fits(t, g, r, l):
            return l
        return -1

    fn binary(self, t: &Tys, g: &Syms, a: &Ast, n: int, want: int) => int:
        let l = a.pa[n]
        let r = a.pb[n]
        let op = op_of(a.pc[n])
        let tok = a.pd[n]
        if tok < 0:
            tok = a.tok[n]
        let compare = op >= int(Bop.Eq) && op <= int(Bop.Ge)
        let logic = op == int(Bop.And) || op == int(Bop.Or)
        let wl = -1
        if !compare && !logic && want >= 0 && t.kind[want] != int(Ty.Bool):
            wl = want
        let lt = 0
        let rt = 0
        if self.is_flex(a, l) && !self.is_flex(a, r):
            rt = self.value(t, g, a, r, -1)
            lt = self.value(t, g, a, l, rt)
        elif self.is_flex(a, r):
            lt = self.value(t, g, a, l, wl)
            rt = self.value(t, g, a, r, lt)
        else:
            lt = self.value(t, g, a, l, wl)
            rt = self.value(t, g, a, r, -1)
        let bool_ty = t.simple(int(Ty.Bool))
        if t.kind[lt] == int(Ty.Error) || t.kind[rt] == int(Ty.Error):
            if compare || logic:
                return bool_ty
            return 0
        if logic:
            if t.kind[lt] != int(Ty.Bool) || t.kind[rt] != int(Ty.Bool):
                self.err(tok, int(Te.InvalidOperation), lt, rt)
            return bool_ty
        if compare:
            let ok = false
            if op == int(Bop.Eq) || op == int(Bop.Ne):
                ok = self.fits(t, g, lt, rt) || self.fits(t, g, rt, lt)
                if t.kind[lt] == int(Ty.Void) || t.kind[lt] == int(Ty.Fn):
                    ok = false
            else:
                let l2 = self.strip_refs(t, lt)
                let r2 = self.strip_refs(t, rt)
                if t.is_numeric(lt) && t.is_numeric(rt):
                    ok = self.join(t, g, lt, rt) >= 0
                elif t.kind[l2] == int(Ty.Str) && t.kind[r2] == int(Ty.Str):
                    ok = true
            if !ok:
                self.err(tok, int(Te.InvalidOperation), lt, rt)
            return bool_ty
        if op == int(Bop.Add):
            let l2 = self.strip_refs(t, lt)
            let r2 = self.strip_refs(t, rt)
            if t.kind[l2] == int(Ty.Str) && t.kind[r2] == int(Ty.Str):
                return t.simple(int(Ty.Str))
        /#/ pointer arithmetic: an `object` moves by bytes
        if (op == int(Bop.Add) || op == int(Bop.Sub)) && t.kind[lt] == int(Ty.Object) && t.is_int(rt):
            return lt
        if op == int(Bop.Add) && t.kind[rt] == int(Ty.Object) && t.is_int(lt):
            return rt
        if op == int(Bop.BitAnd) || op == int(Bop.BitOr) || op == int(Bop.BitXor) || op == int(Bop.IDiv) || op == int(Bop.Shl) || op == int(Bop.Shr):
            if !t.is_int(lt) || !t.is_int(rt):
                self.err(tok, int(Te.InvalidOperation), lt, rt)
                return 0
            if op == int(Bop.Shl) || op == int(Bop.Shr):
                return lt
            let j = self.join(t, g, lt, rt)
            if j < 0:
                self.err(tok, int(Te.InvalidOperation), lt, rt)
                return 0
            return j
        if !t.is_numeric(lt) || !t.is_numeric(rt):
            self.err(tok, int(Te.InvalidOperation), lt, rt)
            return 0
        if op == int(Bop.Div) && (t.is_int(lt) || t.is_int(rt)):
            self.err(tok, int(Te.InvalidOperation), lt, rt)
            return 0
        let j = self.join(t, g, lt, rt)
        if j < 0:
            self.err(tok, int(Te.InvalidOperation), lt, rt)
            return 0
        return j

    fn unary(self, t: &Tys, g: &Syms, a: &Ast, n: int, want: int) => int:
        let o = a.pa[n]
        let k = a.pc[n]
        let tok = a.tok[n]
        if k == int(Tk.Minus):
            if o >= 0 && a.kind[o] == int(Nk.Int):
                return self.set(o, self.int_lit(t, a, o, want, true))
            let ty = self.value(t, g, a, o, want)
            if !t.is_numeric(ty) && !t.is_error(ty):
                self.err(tok, int(Te.InvalidOperation), ty, ty)
                return 0
            return ty
        if k == int(Tk.Bang):
            let ty = self.value(t, g, a, o, -1)
            if t.kind[ty] != int(Ty.Bool) && !t.is_error(ty):
                self.err(tok, int(Te.InvalidOperation), ty, ty)
            return t.simple(int(Ty.Bool))
        if k == int(Tk.Tilde):
            let ty = self.value(t, g, a, o, want)
            if !t.is_int(ty) && !t.is_error(ty):
                self.err(tok, int(Te.InvalidOperation), ty, ty)
                return 0
            return ty
        if k == int(Tk.Amp):
            let ty = self.value(t, g, a, o, -1)
            if t.is_error(ty):
                return 0
            return t.ref_to(ty, a.pd[n] == 1)
        if k == int(Tk.Star):
            let ty = self.value(t, g, a, o, -1)
            if t.kind[ty] == int(Ty.Ref):
                return t.a[ty]
            if !t.is_error(ty):
                self.err(tok, int(Te.InvalidOperation), ty, ty)
            return 0
        if k == int(Tk.KwClone):
            let ty = self.value(t, g, a, o, want)
            if t.kind[ty] == int(Ty.Buf):
                self.err(tok, int(Te.InvalidOperation), ty, ty)
            return ty
        return self.value(t, g, a, o, want)

    /#/ ---- generics ------------------------------------------------------------

    fn reset_binds(self) => void:
        for i in 0..16:
            self.binds[i] = -1

    fn has_param(self, t: &Tys, ty: int) => bool:
        let k = t.kind[ty]
        if k == int(Ty.Param):
            return true
        if k == int(Ty.Ref) || k == int(Ty.Slice) || k == int(Ty.Buf) || k == int(Ty.Array):
            if t.a[ty] < 0:
                return false
            return self.has_param(t, t.a[ty])
        if k == int(Ty.Tuple) || k == int(Ty.Named) || k == int(Ty.Fn):
            for i in 0..t.count_of(ty):
                if self.has_param(t, t.arg(ty, i)):
                    return true
            if k == int(Ty.Fn):
                return self.has_param(t, t.c[ty])
        return false

    /#/ Matches parameter type `p` (which may name type parameters) against argument type `x`,
    /#/ recording what each type parameter stands for.
    fn bind(self, t: &Tys, g: &Syms, p: int, x: int) => bool:
        if t.is_error(x) || t.is_error(p):
            return true
        let pk = t.kind[p]
        if !self.has_param(t, p):
            return self.fits(t, g, x, p)
        if pk == int(Ty.Param):
            let k = t.a[p]
            if k >= 16:
                return true
            if self.binds[k] < 0:
                self.binds[k] = x
                return true
            return self.fits(t, g, x, self.binds[k]) || self.fits(t, g, self.binds[k], x)
        let xk = t.kind[x]
        if pk == int(Ty.Slice) && xk == int(Ty.Ref):
            let target = t.a[x]
            if t.kind[target] == int(Ty.Buf) || t.kind[target] == int(Ty.Array):
                return self.bind(t, g, t.a[p], t.a[target])
        if pk != xk:
            return false
        if pk == int(Ty.Ref) || pk == int(Ty.Slice) || pk == int(Ty.Buf) || pk == int(Ty.Array):
            return self.bind(t, g, t.a[p], t.a[x])
        if pk == int(Ty.Tuple) || pk == int(Ty.Named) || pk == int(Ty.Fn):
            if t.count_of(p) != t.count_of(x):
                return false
            for i in 0..t.count_of(p):
                if !self.bind(t, g, t.arg(p, i), t.arg(x, i)):
                    return false
            if pk == int(Ty.Fn):
                return self.bind(t, g, t.c[p], t.c[x])
            return true
        return false

    /#/ `ty` with each type parameter replaced by what it was bound to (Error when unbound).
    fn subst(self, t: &Tys, ty: int) => int:
        if !self.has_param(t, ty):
            return ty
        let k = t.kind[ty]
        if k == int(Ty.Param):
            if t.a[ty] < 16 && self.binds[t.a[ty]] >= 0:
                return self.binds[t.a[ty]]
            return 0
        if k == int(Ty.Ref):
            return t.ref_to(self.subst(t, t.a[ty]), t.b[ty] == 1)
        if k == int(Ty.Slice):
            return t.slice_of(self.subst(t, t.a[ty]))
        if k == int(Ty.Buf):
            return t.buf_of(self.subst(t, t.a[ty]))
        if k == int(Ty.Array):
            return t.array_of(self.subst(t, t.a[ty]), t.b[ty])
        let count = t.count_of(ty)
        let items = new_buf(int, count + 1)
        for i in 0..count:
            items[i] = self.subst(t, t.arg(ty, i))
        let start = t.args_n
        for i in 0..count:
            t.push_arg(items[i])
        if k == int(Ty.Tuple):
            return t.intern(int(Ty.Tuple), 0, count, 0, start)
        if k == int(Ty.Fn):
            return t.intern(int(Ty.Fn), 0, count, self.subst(t, t.c[ty]), start)
        return t.intern(int(Ty.Named), t.a[ty], 0, count, start)

    /#/ For a value of class type `ty`: binds the class's type parameters to its type arguments.
    fn bind_named(self, t: &Tys, ty: int) => void:
        self.reset_binds()
        if t.kind[ty] == int(Ty.Named):
            for i in 0..t.count_of(ty):
                if i < 16:
                    self.binds[i] = t.arg(ty, i)

    /#/ ---- members and calls ----------------------------------------------------

    /#/ The row of `g` declaring a member of kind `kind` named `tok` in class `ci` or an
    /#/ ancestor; -1 when there is none.
    fn find_member(self, g: &Syms, a: &Ast, ci: int, tok: int, kind: int) => int:
        let cur = ci
        let depth = 0
        while cur >= 0 && depth < 32:
            let r = member_of(g, a, cur, tok, kind)
            if r >= 0:
                return r
            let next = -1
            for i in 0..g.n:
                if g.info[i] == cur && g.kind[i] == int(Sk.Parent):
                    next = g.find_class_row(i)
            cur = next
            depth = depth + 1
        return -1

    /#/ Is `n` a name that stands for an enum? Returns the enum's row in `g`, else -1.
    fn enum_of(self, a: &Ast, n: int) => int:
        if n < 0 || a.kind[n] != int(Nk.Name):
            return -1
        let r = self.lookup(a, a.tok[n])
        if r >= 0 && self.rd.sc.loc.kind[r] == int(Sk.Enum):
            return self.rd.sc.loc.info[r]
        return -1

    fn member(self, t: &Tys, g: &Syms, a: &Ast, n: int) => int:
        let o = a.pa[n]
        let tok = a.tok[n]
        let en = self.enum_of(a, o)
        if en >= 0:
            let r = member_of(g, a, en, tok, int(Sk.Variant))
            if r < 0:
                self.err(tok, int(Te.VariantNotFound), 0, 0)
                return 0
            if g.ty[r] < 0:
                return 0
            return g.ty[r]
        if a.pd[n] == 1:
            return 0
        let ot = self.strip_refs(t, self.value(t, g, a, o, -1))
        if t.kind[ot] == int(Ty.Error) || t.kind[ot] == int(Ty.Object):
            return 0
        if t.kind[ot] != int(Ty.Named):
            self.err(tok, int(Te.FieldNotFound), 0, ot)
            return 0
        let r = self.find_member(g, a, t.a[ot], tok, int(Sk.Field))
        if r >= 0:
            if g.ty[r] < 0:
                return 0
            self.bind_named(t, ot)
            return self.subst(t, g.ty[r])
        let m = self.find_member(g, a, t.a[ot], tok, int(Sk.Method))
        if m >= 0 && g.ty[m] >= 0:
            return g.ty[m]
        self.err(tok, int(Te.FieldNotFound), 0, ot)
        return 0

    /#/ Checks the arguments of call `n` against function type `fty`, skipping the first
    /#/ `skip` parameters (the receiver). Returns the result type.
    fn check_args(self, t: &Tys, g: &Syms, a: &Ast, n: int, fty: int, skip: int, tok: int) => int:
        let params = t.count_of(fty) - skip
        let given = 0
        let c = a.child[n]
        while c >= 0:
            given = given + 1
            c = a.next[c]
        if given != params:
            self.err(tok, int(Te.ArityMismatch), params, given)
            c = a.child[n]
            while c >= 0:
                self.value(t, g, a, c, -1)
                c = a.next[c]
            return self.subst(t, t.c[fty])
        let i = 0
        c = a.child[n]
        while c >= 0:
            let p = t.arg(fty, skip + i)
            if self.has_param(t, p):
                let x = self.value(t, g, a, c, -1)
                if !self.bind(t, g, p, x):
                    self.err(a.tok[c], int(Te.Mismatch), self.subst(t, p), x)
            else:
                self.expect(t, g, a, c, p)
            i = i + 1
            c = a.next[c]
        return self.subst(t, t.c[fty])

    /#/ A call of a C function: the signature of the `.cfc` file, with the leniency C needs. Any
    /#/ integer or float width goes, an `object` takes any pointer-like value or a literal `0`,
    /#/ a `string` takes a string or a pointer. A variadic function takes more arguments.
    fn extern_call(self, t: &Tys, g: &Syms, a: &Ast, n: int, sig: int, variadic: bool, tok: int) => int:
        let params = t.count_of(sig)
        let given = 0
        let c = a.child[n]
        while c >= 0:
            given = given + 1
            c = a.next[c]
        if given < params || (given > params && !variadic):
            self.err(tok, int(Te.ArityMismatch), params, given)
            self.args_untyped(t, g, a, n)
            return t.c[sig]
        let i = 0
        c = a.child[n]
        while c >= 0:
            if i < params:
                let p = t.arg(sig, i)
                let want = -1
                if t.kind[p] == int(Ty.Int) || t.kind[p] == int(Ty.Float) || t.kind[p] == int(Ty.Bool):
                    want = p
                let x = self.value(t, g, a, c, want)
                if !self.extern_fits(t, g, a, c, p, x):
                    self.err(a.tok[c], int(Te.Mismatch), p, x)
            else:
                let x = self.value(t, g, a, c, -1)
                /#/ C has no `bool` to pass in a variadic tail
                if t.kind[x] == int(Ty.Bool):
                    self.err(a.tok[c], int(Te.Mismatch), 0, x)
            i = i + 1
            c = a.next[c]
        return t.c[sig]

    fn extern_fits(self, t: &Tys, g: &Syms, a: &Ast, c: int, p: int, x: int) => bool:
        if t.is_error(p) || t.is_error(x):
            return true
        let pk = t.kind[p]
        let xk = t.kind[x]
        if pk == int(Ty.Int):
            return xk == int(Ty.Int)
        if pk == int(Ty.Float):
            return xk == int(Ty.Float)
        let pointer = xk == int(Ty.Str) || xk == int(Ty.Ref) || xk == int(Ty.Object) || xk == int(Ty.Buf) || xk == int(Ty.Slice) || xk == int(Ty.Array) || xk == int(Ty.Named)
        if pk == int(Ty.Str):
            return pointer && xk != int(Ty.Named)
        if pk == int(Ty.Object):
            return pointer || (a.kind[c] == int(Nk.Int) && tok_is(a, a.tok[c], "0"))
        return self.fits(t, g, x, p)

    fn args_untyped(self, t: &Tys, g: &Syms, a: &Ast, n: int) => void:
        let c = a.child[n]
        while c >= 0:
            self.value(t, g, a, c, -1)
            c = a.next[c]

    /#/ A cast `x as T` or `T(x)`.
    fn cast_ok(self, t: &Tys, g: &Syms, from: int, to: int) => bool:
        if from == to || t.is_error(from) || t.is_error(to):
            return true
        let fk = t.kind[from]
        let tk = t.kind[to]
        if (fk == int(Ty.Int) || fk == int(Ty.Float)) && (tk == int(Ty.Int) || tk == int(Ty.Float)):
            return true
        if (fk == int(Ty.Int) || fk == int(Ty.Float)) && tk == int(Ty.Bool):
            return true
        if fk == int(Ty.Object) && (tk == int(Ty.Int) || tk == int(Ty.Ref) || tk == int(Ty.Buf) || tk == int(Ty.Str) || tk == int(Ty.Named)):
            return true
        if fk == int(Ty.Int) && tk == int(Ty.Object):
            return true
        if fk == int(Ty.Named) && tk == int(Ty.Int):
            return true
        return self.fits(t, g, from, to)

    fn cast(self, t: &Tys, g: &Syms, a: &Ast, n: int) => int:
        let from = self.value(t, g, a, a.pa[n], -1)
        let to = self.rd.from_ref(t, a, a.pb[n])
        if !self.cast_ok(t, g, from, to):
            self.err(a.tok[n], int(Te.InvalidOperation), to, from)
        return to

    fn call(self, t: &Tys, g: &Syms, a: &Ast, n: int, want: int) => int:
        let callee = a.pa[n]
        if callee < 0:
            return 0
        let ck = a.kind[callee]
        let tok = a.tok[callee]
        if ck == int(Nk.Name):
            let r = self.lookup(a, tok)
            if r < 0:
                self.args_untyped(t, g, a, n)
                return 0
            let k = self.rd.sc.loc.kind[r]
            if k == int(Sk.Builtin):
                return self.builtin_call(t, g, a, n, tok)
            if k == int(Sk.Extern):
                let sig = self.rd.sc.loc.ty[r]
                if sig >= 0 && t.kind[sig] == int(Ty.Fn):
                    return self.extern_call(t, g, a, n, sig, self.rd.sc.loc.info[r] == 1, tok)
                self.args_untyped(t, g, a, n)
                return 0
            if k == int(Sk.Class) || k == int(Sk.Enum) || k == int(Sk.Module):
                self.args_untyped(t, g, a, n)
                return 0
        if ck == int(Nk.Member) && a.pd[callee] == 1:
            return self.static_call(t, g, a, n, callee)
        if ck == int(Nk.Member):
            return self.method_call(t, g, a, n, callee)
        let fty = self.value(t, g, a, callee, -1)
        if t.kind[fty] == int(Ty.Error):
            self.args_untyped(t, g, a, n)
            return 0
        if t.kind[fty] != int(Ty.Fn):
            self.err(tok, int(Te.NotCallable), 0, fty)
            self.args_untyped(t, g, a, n)
            return 0
        self.reset_binds()
        let res = self.check_args(t, g, a, n, fty, 0, tok)
        if ck == int(Nk.Name):
            /#/ every type parameter of the function must be fixed by the arguments
            let tp = self.tparams_of(a, tok)
            for k in 0..tp:
                if k < 16 && self.binds[k] < 0:
                    self.err(tok, int(Te.InvalidOperation), 0, 0)
                    break
        return res

    /#/ How many type parameters the top-level function named by `tok` has.
    fn tparams_of(self, a: &Ast, tok: int) => int:
        let it = a.child[a.root]
        while it >= 0:
            if a.kind[it] == int(Nk.Fn) && a.pa[it] >= 0 && same_tok(a, a.pa[it], tok):
                let k = 0
                let c = a.child[it]
                while c >= 0:
                    if a.kind[c] == int(Nk.TypeParam):
                        k = k + 1
                    c = a.next[c]
                return k
            it = a.next[it]
        return 0

    /#/ `Class::name(args)`: a function of the class that takes no `self`.
    fn static_call(self, t: &Tys, g: &Syms, a: &Ast, n: int, callee: int) => int:
        let o = a.pa[callee]
        let tok = a.tok[callee]
        let ci = -1
        if o >= 0 && a.kind[o] == int(Nk.Name):
            let r = self.lookup(a, a.tok[o])
            if r >= 0 && self.rd.sc.loc.kind[r] == int(Sk.Class):
                ci = self.rd.sc.loc.info[r]
        if ci < 0:
            self.args_untyped(t, g, a, n)
            return 0
        let m = self.find_member(g, a, ci, tok, int(Sk.Method))
        if m < 0:
            self.err(tok, int(Te.MethodNotFound), 0, t.named(ci))
            self.args_untyped(t, g, a, n)
            return 0
        if g.ty[m] < 0:
            self.args_untyped(t, g, a, n)
            return 0
        self.reset_binds()
        self.set(callee, g.ty[m])
        return self.check_args(t, g, a, n, g.ty[m], 0, tok)

    fn method_call(self, t: &Tys, g: &Syms, a: &Ast, n: int, callee: int) => int:
        let o = a.pa[callee]
        let tok = a.tok[callee]
        let en = self.enum_of(a, o)
        if en >= 0:
            let fty = self.member(t, g, a, callee)
            self.set(callee, fty)
            if t.kind[fty] == int(Ty.Fn):
                self.reset_binds()
                return self.check_args(t, g, a, n, fty, 0, tok)
            self.args_untyped(t, g, a, n)
            if t.kind[fty] == int(Ty.Error):
                return 0
            self.err(tok, int(Te.NotCallable), 0, fty)
            return 0
        let ot = self.strip_refs(t, self.value(t, g, a, o, -1))
        if t.kind[ot] == int(Ty.Error) || t.kind[ot] == int(Ty.Object):
            self.args_untyped(t, g, a, n)
            return 0
        if t.kind[ot] != int(Ty.Named):
            self.err(tok, int(Te.MethodNotFound), 0, ot)
            self.args_untyped(t, g, a, n)
            return 0
        let m = self.find_member(g, a, t.a[ot], tok, int(Sk.Method))
        if m < 0:
            /#/ `obj.assign("field", v)` is part of every class
            if tok_is(a, tok, "assign"):
                let nm = a.child[n]
                let fr = -1
                if nm >= 0 && a.next[nm] >= 0 && a.kind[nm] == int(Nk.Str):
                    let s0 = a.toks.start[a.tok[nm]] + 1
                    let e0 = a.toks.end[a.tok[nm]] - 1
                    let h0 = g.span_hash(a, s0, e0)
                    for i in 0..g.n:
                        if g.info[i] == t.a[ot] && g.kind[i] == int(Sk.Field) && g.ty[i] >= 0 && g.same_span(i, a, s0, e0, h0):
                            fr = i
                if fr >= 0:
                    self.value(t, g, a, nm, -1)
                    self.expect(t, g, a, a.next[nm], g.ty[fr])
                else:
                    self.args_untyped(t, g, a, n)
                return t.simple(int(Ty.Void))
            let f = self.find_member(g, a, t.a[ot], tok, int(Sk.Field))
            if f >= 0 && g.ty[f] >= 0 && t.kind[g.ty[f]] == int(Ty.Fn):
                self.reset_binds()
                return self.check_args(t, g, a, n, g.ty[f], 0, tok)
            self.err(tok, int(Te.MethodNotFound), 0, ot)
            self.args_untyped(t, g, a, n)
            return 0
        if g.ty[m] < 0:
            self.args_untyped(t, g, a, n)
            return 0
        self.bind_named(t, ot)
        self.set(callee, g.ty[m])
        return self.check_args(t, g, a, n, g.ty[m], 1, tok)

    /#/ `len`, `sizeof`, the sized casts and the buffer intrinsics.
    fn builtin_call(self, t: &Tys, g: &Syms, a: &Ast, n: int, tok: int) => int:
        let first = a.child[n]
        if tok_is(a, tok, "len"):
            self.args_untyped(t, g, a, n)
            if first >= 0:
                let lk = t.kind[self.strip_refs(t, self.node[first])]
                if lk == int(Ty.Int) || lk == int(Ty.Float) || lk == int(Ty.Bool) || lk == int(Ty.Named):
                    self.err(tok, int(Te.InvalidOperation), 0, self.node[first])
            return t.int_ty(8, true)
        if tok_is(a, tok, "sizeof"):
            return t.int_ty(8, true)
        if tok_is(a, tok, "new_buf"):
            if first < 0 || a.kind[first] != int(Nk.Name):
                self.args_untyped(t, g, a, n)
                return 0
            let elem = self.rd.named_ty(t, a, a.tok[first])
            let count = a.next[first]
            if count >= 0:
                self.expect(t, g, a, count, t.int_ty(8, true))
            return t.buf_of(elem)
        if tok_is(a, tok, "buf_resize"):
            let b = self.value(t, g, a, first, -1)
            if first >= 0 && a.next[first] >= 0:
                self.expect(t, g, a, a.next[first], t.int_ty(8, true))
            return b
        if tok_is(a, tok, "buf_ptr"):
            self.args_untyped(t, g, a, n)
            return t.simple(int(Ty.Object))
        /#/ raw memory and system calls, for the runtime that has no C library under it
        if tok_is(a, tok, "peek8") || tok_is(a, tok, "peek64") || tok_is(a, tok, "syscall") || tok_is(a, tok, "call_addr"):
            self.args_untyped(t, g, a, n)
            return t.int_ty(8, true)
        /#/ a new string of n bytes of text (zero bytes, ended), and byte i of a string set
        if tok_is(a, tok, "str_alloc"):
            self.args_untyped(t, g, a, n)
            return t.simple(int(Ty.Str))
        if tok_is(a, tok, "str_put"):
            self.args_untyped(t, g, a, n)
            return t.simple(int(Ty.Void))
        if tok_is(a, tok, "poke8") || tok_is(a, tok, "poke64"):
            self.args_untyped(t, g, a, n)
            return t.simple(int(Ty.Void))
        if tok_is(a, tok, "subslice"):
            let b = self.strip_refs(t, self.value(t, g, a, first, -1))
            let c = a.next[first]
            while c >= 0 && first >= 0:
                self.value(t, g, a, c, t.int_ty(8, true))
                c = a.next[c]
            if t.kind[b] == int(Ty.Buf) || t.kind[b] == int(Ty.Slice) || t.kind[b] == int(Ty.Array):
                return t.slice_of(t.a[b])
            return 0
        if tok_is(a, tok, "wrapping_add") || tok_is(a, tok, "wrapping_sub") || tok_is(a, tok, "wrapping_mul"):
            let l = self.value(t, g, a, first, -1)
            if first >= 0 && a.next[first] >= 0:
                self.expect(t, g, a, a.next[first], l)
            return l
        if tok_is(a, tok, "range") || tok_is(a, tok, "nil"):
            self.args_untyped(t, g, a, n)
            return 0
        /#/ the casts: int(x), float(x), bool(x), u8(x), str(x) ...
        let to = self.rd.named_ty(t, a, tok)
        if first >= 0:
            let from = self.value(t, g, a, first, -1)
            if !self.cast_ok(t, g, from, to):
                self.err(tok, int(Te.InvalidOperation), to, from)
        return to

    /#/ ---- composite expressions -----------------------------------------------

    fn index(self, t: &Tys, g: &Syms, a: &Ast, n: int) => int:
        let o = self.strip_refs(t, self.value(t, g, a, a.pa[n], -1))
        let i = a.pb[n]
        let k = t.kind[o]
        let int_ty = t.int_ty(8, true)
        if i >= 0 && a.kind[i] == int(Nk.Range):
            self.expr(t, g, a, i, -1)
            self.expect_index(t, g, a, a.pa[i])
            self.expect_index(t, g, a, a.pb[i])
            if k == int(Ty.Buf) || k == int(Ty.Slice) || k == int(Ty.Array):
                if t.a[o] >= 0:
                    return t.slice_of(t.a[o])
            return 0
        self.expect_index(t, g, a, i)
        if t.is_error(o):
            return 0
        if k == int(Ty.Array) || k == int(Ty.Slice) || (k == int(Ty.Buf) && t.a[o] >= 0):
            return t.a[o]
        if k == int(Ty.Str):
            return t.int_ty(1, false)
        if k == int(Ty.Object) || k == int(Ty.Buf):
            return 0
        self.err(a.tok[n], int(Te.InvalidOperation), o, o)
        return 0

    /#/ An index or a range bound is an integer of any width.
    fn expect_index(self, t: &Tys, g: &Syms, a: &Ast, i: int) => void:
        if i < 0:
            return
        let ty = self.value(t, g, a, i, t.int_ty(8, true))
        if !t.is_int(ty) && !t.is_error(ty):
            self.err(a.tok[i], int(Te.Mismatch), t.int_ty(8, true), ty)

    fn tuple(self, t: &Tys, g: &Syms, a: &Ast, n: int, want: int) => int:
        let count = 0
        let c = a.child[n]
        while c >= 0:
            count = count + 1
            c = a.next[c]
        let items = new_buf(int, count + 1)
        let w = -1
        if want >= 0 && t.kind[want] == int(Ty.Tuple) && t.count_of(want) == count:
            w = want
        let i = 0
        c = a.child[n]
        while c >= 0:
            let ew = -1
            if w >= 0:
                ew = t.arg(w, i)
            items[i] = self.value(t, g, a, c, ew)
            i = i + 1
            c = a.next[c]
        let start = t.args_n
        for k in 0..count:
            t.push_arg(items[k])
        return t.intern(int(Ty.Tuple), 0, count, 0, start)

    fn array(self, t: &Tys, g: &Syms, a: &Ast, n: int, want: int) => int:
        let elem = -1
        if want >= 0 && (t.kind[want] == int(Ty.Array) || t.kind[want] == int(Ty.Slice)):
            elem = t.a[want]
        let count = 0
        let c = a.child[n]
        while c >= 0:
            if elem < 0:
                elem = self.value(t, g, a, c, -1)
            else:
                self.expect(t, g, a, c, elem)
            count = count + 1
            c = a.next[c]
        if elem < 0:
            /#/ nothing says what an empty array holds
            self.err(a.tok[n], int(Te.UnknownType), 0, 0)
            return 0
        return t.array_of(elem, count)

    fn struct_lit(self, t: &Tys, g: &Syms, a: &Ast, n: int) => int:
        let tn = a.pa[n]
        let ci = -1
        if tn >= 0 && a.kind[tn] == int(Nk.Name):
            let r = self.lookup(a, a.tok[tn])
            if r >= 0 && self.rd.sc.loc.kind[r] == int(Sk.Class):
                ci = self.rd.sc.loc.info[r]
        if ci < 0:
            let f = a.child[n]
            while f >= 0:
                self.value(t, g, a, a.pa[f], -1)
                f = a.next[f]
            return 0
        self.reset_binds()
        let f = a.child[n]
        while f >= 0:
            let fr = self.find_member(g, a, ci, a.tok[f], int(Sk.Field))
            if fr < 0:
                self.value(t, g, a, a.pa[f], -1)
                self.err(a.tok[f], int(Te.FieldNotFound), 0, t.named(ci))
            elif g.ty[fr] < 0:
                self.value(t, g, a, a.pa[f], -1)
            elif self.has_param(t, g.ty[fr]):
                let x = self.value(t, g, a, a.pa[f], -1)
                if !self.bind(t, g, g.ty[fr], x):
                    self.err(a.tok[f], int(Te.Mismatch), self.subst(t, g.ty[fr]), x)
            else:
                self.expect(t, g, a, a.pa[f], g.ty[fr])
            f = a.next[f]
        let params = g.ty[ci]
        if params <= 0:
            return t.named(ci)
        let start = t.args_n
        for i in 0..params:
            if i < 16 && self.binds[i] >= 0:
                t.push_arg(self.binds[i])
            else:
                t.push_arg(0)
        return t.intern(int(Ty.Named), ci, 0, params, start)

    /#/ ---- functions and statements ----------------------------------------------

    /#/ Checks the body of function `f` and returns its type. `class_ty` is the class type of a
    /#/ method (its `self`), -1 otherwise.
    /#/ `#name` after a signature names a function that takes the error: not the function itself,
    /#/ and one parameter that is a class.
    fn check_listeners(self, t: &Tys, a: &Ast, f: int) => void:
        let l = a.child[f]
        while l >= 0:
            if a.kind[l] == int(Nk.Listener):
                let s = a.toks.start[a.tok[l]] + 1
                let e = a.toks.end[a.tok[l]]
                if a.pa[f] >= 0 && e - s == a.toks.end[a.pa[f]] - a.toks.start[a.pa[f]]:
                    let same = true
                    for q in 0..e - s:
                        if a.byte_at(s + q) != a.byte_at(a.toks.start[a.pa[f]] + q):
                            same = false
                    if same:
                        self.err(a.tok[l], int(Te.Mismatch), 0, 0)
                        l = a.next[l]
                        continue
                let r = self.rd.sc.loc.find_span(a, s, e, 0)
                if r >= 0 && self.rd.sc.loc.kind[r] == int(Sk.Fn):
                    let sig = self.rd.sc.loc.ty[r]
                    if sig >= 0 && t.kind[sig] == int(Ty.Fn):
                        if t.count_of(sig) != 1 || t.kind[t.arg(sig, 0)] != int(Ty.Named):
                            self.err(a.tok[l], int(Te.Mismatch), 0, 0)
            l = a.next[l]

    fn function(self, t: &Tys, g: &Syms, a: &Ast, f: int, class_ty: int) => int:
        let fty = self.rd.fn_sig(t, a, f, class_ty)
        if a.pc[f] < 0:
            return fty
        self.check_listeners(t, a, f)
        let saved_ret = self.ret
        let saved_loops = self.loops
        let saved_in = self.in_fn
        let mark = self.rd.sc.loc.n
        self.rd.bind_params(t, a, f)
        let i = 0
        let p = a.child[f]
        while p >= 0:
            if a.kind[p] == int(Nk.Param) || a.kind[p] == int(Nk.SelfParam):
                if i < t.count_of(fty):
                    self.declare_local(a, a.tok[p], int(Sk.Param), t.arg(fty, i))
                    self.node[p] = t.arg(fty, i)
                i = i + 1
            p = a.next[p]
        self.ret = t.c[fty]
        self.loops = 0
        self.in_fn = 1
        self.block(t, g, a, a.pc[f])
        if class_ty >= 0 && t.kind[self.ret] != int(Ty.Void) && a.pc[f] >= 0:
            let last = a.child[a.pc[f]]
            let tail = -1
            while last >= 0:
                tail = last
                last = a.next[last]
            if tail >= 0 && a.kind[tail] == int(Nk.ExprStmt) && a.pa[tail] >= 0:
                let x = self.node[a.pa[tail]]
                if !self.fits(t, g, x, self.ret):
                    self.err(a.tok[tail], int(Te.Mismatch), self.ret, x)
        self.pop(mark)
        self.ret = saved_ret
        self.loops = saved_loops
        self.in_fn = saved_in
        return fty

    fn block(self, t: &Tys, g: &Syms, a: &Ast, b: int) => void:
        if b < 0:
            return
        let mark = self.rd.sc.loc.n
        let c = a.child[b]
        while c >= 0:
            self.stmt(t, g, a, c)
            c = a.next[c]
        self.pop(mark)

    /#/ A pattern that matches every value: a binder, `_`, or a tuple or struct of such.
    fn irrefutable(self, a: &Ast, p: int) => bool:
        if p < 0:
            return false
        let k = a.kind[p]
        if k == int(Nk.Name):
            let r = self.lookup(a, a.tok[p])
            return tok_is(a, a.tok[p], "_") || r < 0 || self.rd.sc.loc.kind[r] == int(Sk.Local) || self.rd.sc.loc.kind[r] == int(Sk.Param)
        if k == int(Nk.Tuple):
            let c = a.child[p]
            while c >= 0:
                if !self.irrefutable(a, c):
                    return false
                c = a.next[c]
            return true
        if k == int(Nk.StructLit):
            let f = a.child[p]
            while f >= 0:
                if !self.irrefutable(a, a.pa[f]):
                    return false
                f = a.next[f]
            return true
        return false

    /#/ The builtin class `Error`, -1 when the table has none.
    fn error_class(self, g: &Syms) => int:
        for i in 0..g.n:
            if g.kind[i] == int(Sk.Class) && g.mod[i] == -1 && g.size[i] == 5 && g.pool[g.off[i]] == 'E' && g.pool[g.off[i] + 4] == 'r':
                return g.info[i]
        return -1

    fn cond(self, t: &Tys, g: &Syms, a: &Ast, c: int) => void:
        if c < 0:
            return
        self.expect(t, g, a, c, t.simple(int(Ty.Bool)))

    fn stmt(self, t: &Tys, g: &Syms, a: &Ast, n: int) => void:
        let k = a.kind[n]
        if k == int(Nk.Let):
            self.let_stmt(t, g, a, n)
        elif k == int(Nk.Assign):
            let tt = self.expr(t, g, a, a.pa[n], -1)
            let lhs = a.pa[n]
            if a.kind[lhs] == int(Nk.Unary) && a.pc[lhs] == int(Tk.Star) && a.pa[lhs] >= 0:
                /#/ a store through `&T` (not `&mut T`)
                let rt = self.node[a.pa[lhs]]
                if t.kind[rt] == int(Ty.Ref) && t.b[rt] == 0:
                    self.err(a.tok[n], int(Te.InvalidOperation), 0, rt)
            elif a.kind[lhs] == int(Nk.Index) && a.pa[lhs] >= 0 && t.kind[self.node[a.pa[lhs]]] == int(Ty.Array) && t.is_resource(tt):
                /#/ an element that must be released cannot be overwritten in place
                self.err(a.tok[n], int(Te.InvalidOperation), 0, tt)
            if t.is_error(tt):
                self.value(t, g, a, a.pb[n], -1)
            else:
                self.expect(t, g, a, a.pb[n], tt)
        elif k == int(Nk.Return):
            self.return_stmt(t, g, a, n)
        elif k == int(Nk.Raise):
            let x = self.expr(t, g, a, a.pa[n], -1)
            let er = self.error_class(g)
            let ok = t.is_error(x)
            if t.kind[x] == int(Ty.Named) && er >= 0 && self.inherits(g, t.a[x], er):
                ok = true
            if t.kind[x] == int(Ty.Object):
                ok = true
            if !ok:
                self.err(a.tok[n], int(Te.Mismatch), 0, x)
        elif k == int(Nk.Clean):
            /#/ `clean out` is gone: a resource is released with `rm`
            self.err(a.tok[n], int(Te.InvalidType), 0, 0)
        elif k == int(Nk.ExprStmt) || k == int(Nk.Rm):
            self.expr(t, g, a, a.pa[n], -1)
            let extra = a.child[n]
            while extra >= 0:
                self.expr(t, g, a, extra, -1)
                extra = a.next[extra]
        elif k == int(Nk.Mv):
            let ty = self.expr(t, g, a, a.pa[n], -1)
            self.node[n] = ty
            if a.pc[n] == 1 && t.kind[ty] == int(Ty.Buf):
                self.err(a.tok[a.pa[n]], int(Te.InvalidOperation), ty, ty)
            if a.pb[n] >= 0:
                self.declare_local(a, a.pb[n], int(Sk.Local), ty)
        elif k == int(Nk.TypeAlias):
            if a.pa[n] >= 0:
                let r = self.rd.sc.loc.add_tok(a, a.pa[n], int(Sk.Alias), -1, self.cur)
                self.rd.sc.loc.ty[r] = self.rd.from_ref(t, a, a.pb[n])
        elif k == int(Nk.If):
            self.cond(t, g, a, a.pa[n])
            self.block(t, g, a, a.pb[n])
            let e = a.pc[n]
            if e >= 0:
                if a.kind[e] == int(Nk.If):
                    self.stmt(t, g, a, e)
                else:
                    self.block(t, g, a, e)
        elif k == int(Nk.While):
            self.cond(t, g, a, a.pa[n])
            self.loops = self.loops + 1
            self.block(t, g, a, a.pb[n])
            self.loops = self.loops - 1
        elif k == int(Nk.For):
            self.for_stmt(t, g, a, n)
        elif k == int(Nk.Match):
            self.match_stmt(t, g, a, n)
        elif k == int(Nk.Fn):
            if a.pa[n] >= 0:
                let sig = self.rd.fn_sig(t, a, n, -1)
                self.declare_local(a, a.pa[n], int(Sk.Fn), sig)
            self.function(t, g, a, n, -1)

    fn let_stmt(self, t: &Tys, g: &Syms, a: &Ast, n: int) => void:
        let ty = -1
        if a.pb[n] >= 0:
            ty = self.rd.from_ref(t, a, a.pb[n])
        if a.pc[n] >= 0:
            if ty >= 0:
                self.expect(t, g, a, a.pc[n], ty)
            else:
                ty = self.value(t, g, a, a.pc[n], -1)
        if ty < 0:
            ty = 0
        let init = a.pc[n]
        if init >= 0 && a.kind[init] == int(Nk.Index) && a.pb[init] >= 0 && a.kind[a.pb[init]] == int(Nk.Range):
            /#/ a view of a buffer lives only as long as the statement that makes it
            self.err(a.tok[n], int(Te.InvalidType), 0, ty)
        /#/ the type of the variable a `let` declares is recorded on the statement
        self.node[n] = ty
        if a.pa[n] < 0:
            return
        if self.in_fn == 1:
            self.declare_local(a, a.pa[n], int(Sk.Local), ty)
        else:
            let r = g.find_in_module(a, a.pa[n], self.cur)
            if r >= 0:
                g.ty[r] = ty
            let s = self.lookup(a, a.pa[n])
            if s >= 0:
                self.rd.sc.loc.ty[s] = ty

    fn return_stmt(self, t: &Tys, g: &Syms, a: &Ast, n: int) => void:
        if self.in_fn == 0:
            return
        let v = a.pa[n]
        let void_ty = t.simple(int(Ty.Void))
        if v >= 0:
            if t.kind[self.ret] == int(Ty.Void):
                let x = self.expr(t, g, a, v, -1)
                if !t.is_error(x):
                    self.err(a.tok[n], int(Te.Mismatch), void_ty, x)
            else:
                self.expect(t, g, a, v, self.ret)
        elif t.kind[self.ret] != int(Ty.Void) && !t.is_error(self.ret):
            self.err(a.tok[n], int(Te.Mismatch), self.ret, void_ty)

    fn for_stmt(self, t: &Tys, g: &Syms, a: &Ast, n: int) => void:
        let it = a.pb[n]
        let elem = 0
        if it >= 0 && a.kind[it] == int(Nk.Range):
            let l = a.pa[it]
            let r = a.pb[it]
            let lt = 0
            let rt = 0
            if self.is_flex(a, l) && !self.is_flex(a, r):
                rt = self.value(t, g, a, r, -1)
                lt = self.value(t, g, a, l, rt)
            else:
                lt = self.value(t, g, a, l, -1)
                rt = self.value(t, g, a, r, lt)
            if !t.is_int(lt) && !t.is_error(lt):
                self.err(a.tok[l], int(Te.Mismatch), t.int_ty(8, true), lt)
            if !t.is_int(rt) && !t.is_error(rt):
                self.err(a.tok[r], int(Te.Mismatch), t.int_ty(8, true), rt)
            let j = self.join(t, g, lt, rt)
            if j >= 0 && t.is_int(lt) && t.is_int(rt):
                elem = j
            elif t.is_int(lt):
                elem = lt
            self.set(it, 0)
        elif it >= 0 && a.kind[it] == int(Nk.Call) && a.pa[it] >= 0 && a.kind[a.pa[it]] == int(Nk.Name) && tok_is(a, a.tok[a.pa[it]], "range") && a.child[it] >= 0 && (a.next[a.child[it]] < 0 || a.next[a.next[a.child[it]]] < 0):
            /#/ `range(a, b)` and `range(b)` count like `a..b`
            let c0 = a.child[it]
            let l = c0
            let r = a.next[c0]
            if r < 0:
                r = c0
                l = -1
            let rt = self.value(t, g, a, r, -1)
            let lt = rt
            if l >= 0:
                lt = self.value(t, g, a, l, rt)
            if !t.is_int(lt) && !t.is_error(lt):
                self.err(a.tok[c0], int(Te.Mismatch), t.int_ty(8, true), lt)
            if !t.is_int(rt) && !t.is_error(rt):
                self.err(a.tok[r], int(Te.Mismatch), t.int_ty(8, true), rt)
            let j = self.join(t, g, lt, rt)
            if j >= 0 && t.is_int(lt) && t.is_int(rt):
                elem = j
            elif t.is_int(rt):
                elem = rt
            self.set(it, 0)
        else:
            let ct = self.strip_refs(t, self.value(t, g, a, it, -1))
            let k = t.kind[ct]
            if k == int(Ty.Array) || k == int(Ty.Slice) || (k == int(Ty.Buf) && t.a[ct] >= 0):
                elem = t.a[ct]
            elif k == int(Ty.Tuple) && t.count_of(ct) > 0:
                elem = t.arg(ct, 0)
            elif k == int(Ty.Str):
                elem = t.int_ty(1, false)
            elif k != int(Ty.Error):
                self.err(a.tok[it], int(Te.InvalidType), 0, ct)
        self.loops = self.loops + 1
        let mark = self.rd.sc.loc.n
        self.node[n] = elem
        if a.pa[n] >= 0:
            self.declare_local(a, a.pa[n], int(Sk.Local), elem)
        if a.pc[n] >= 0:
            let c = a.child[a.pc[n]]
            while c >= 0:
                self.stmt(t, g, a, c)
                c = a.next[c]
        self.pop(mark)
        self.loops = self.loops - 1

    fn match_stmt(self, t: &Tys, g: &Syms, a: &Ast, n: int) => void:
        let st = self.expr(t, g, a, a.pa[n], -1)
        let arm = a.child[n]
        let first = -1
        /#/ covered[0..16) the variants matched; 16: how many; 17: bits for `true` (1) and `false` (2); 18: a catch-all
        let covered = new_buf(int, 19)
        let sc = self.strip_refs(t, st)
        let en = -1
        if t.kind[sc] == int(Ty.Named) && g.kind[t.a[sc]] == int(Sk.Enum):
            en = t.a[sc]
        while arm >= 0:
            let mark = self.rd.sc.loc.n
            self.pattern(t, g, a, a.pa[arm], st)
            if a.pc[arm] >= 0:
                self.cond(t, g, a, a.pc[arm])
            else:
                /#/ an arm with a guard may not match, so it covers nothing
                self.cover(t, g, a, en, a.pa[arm], &covered)
            if a.pb[arm] >= 0:
                let c = a.child[a.pb[arm]]
                let only = c
                while c >= 0:
                    self.stmt(t, g, a, c)
                    c = a.next[c]
                /#/ arms that are a bare value must agree on its type
                if only >= 0 && a.next[only] < 0 && a.kind[only] == int(Nk.ExprStmt) && a.pa[only] >= 0:
                    let x = self.node[a.pa[only]]
                    if x >= 0 && t.kind[x] != int(Ty.Void) && !t.is_error(x):
                        if first < 0:
                            first = x
                        elif !self.fits(t, g, x, first) && !self.fits(t, g, first, x):
                            self.err(a.tok[only], int(Te.Mismatch), first, x)
            self.pop(mark)
            arm = a.next[arm]
        let seen = covered[16]
        let truth = covered[17]
        if covered[18] != 0 || a.child[n] < 0:
            return
        let total = 0
        if en >= 0:
            for i in 0..g.n:
                if g.info[i] == en && g.kind[i] == int(Sk.Variant):
                    total = total + 1
            if seen >= total:
                return
        elif t.kind[sc] == int(Ty.Bool) && truth == 3:
            return
        elif t.is_error(sc):
            return
        self.err(a.tok[n], int(Te.NonExhaustive), 0, st)

    /#/ What the pattern `p` of an unguarded arm covers, recorded in `cov` (see `match_stmt`);
    /#/ every alternative of an or-pattern counts.
    fn cover(self, t: &Tys, g: &Syms, a: &Ast, en: int, p: int, cov: &buf<int>) => void:
        if p < 0:
            return
        if a.kind[p] == int(Nk.Binary) && a.pc[p] == int(Tk.Pipe):
            self.cover(t, g, a, en, a.pa[p], cov)
            self.cover(t, g, a, en, a.pb[p], cov)
        elif self.irrefutable(a, p):
            cov[18] = 1
        elif a.kind[p] == int(Nk.Bool):
            if tok_is(a, a.tok[p], "true"):
                cov[17] = cov[17] | 1
            else:
                cov[17] = cov[17] | 2
        elif en >= 0:
            let v = p
            if a.kind[p] == int(Nk.Call):
                v = a.pa[p]
            if v >= 0 && a.kind[v] == int(Nk.Member):
                let vr = member_of(g, a, en, a.tok[v], int(Sk.Variant))
                let dup = false
                for i in 0..cov[16]:
                    if cov[i] == vr:
                        dup = true
                if vr >= 0 && !dup && cov[16] < 16:
                    cov[cov[16]] = vr
                    cov[16] = cov[16] + 1

    /#/ A pattern of type `st`: names bind, `E.V(p, ...)` binds the payload, anything else is
    /#/ a value of that type.
    fn pattern(self, t: &Tys, g: &Syms, a: &Ast, p: int, st0: int) => void:
        if p < 0:
            return
        let k = a.kind[p]
        /#/ a variant pattern looks through a reference to the enum it matches
        let st = st0
        if k == int(Nk.Call) || k == int(Nk.Member):
            st = self.strip_refs(t, st0)
        if k == int(Nk.Name):
            if tok_is(a, a.tok[p], "_"):
                return
            let r = self.lookup(a, a.tok[p])
            if r >= 0 && self.rd.sc.loc.kind[r] != int(Sk.Local) && self.rd.sc.loc.kind[r] != int(Sk.Param):
                self.expect(t, g, a, p, st)
            else:
                self.declare_local(a, a.tok[p], int(Sk.Local), st)
                self.set(p, st)
        elif k == int(Nk.Call):
            let callee = a.pa[p]
            let vt = 0
            if callee >= 0 && a.kind[callee] == int(Nk.Member):
                vt = self.expr(t, g, a, callee, -1)
            let i = 0
            let c = a.child[p]
            while c >= 0:
                let pt = 0
                if t.kind[vt] == int(Ty.Fn) && i < t.count_of(vt):
                    pt = t.arg(vt, i)
                self.pattern(t, g, a, c, pt)
                i = i + 1
                c = a.next[c]
            if t.kind[vt] == int(Ty.Fn):
                let e = t.c[vt]
                if !self.fits(t, g, e, st):
                    self.err(a.tok[p], int(Te.Mismatch), st, e)
            self.set(p, st)
        elif k == int(Nk.Tuple):
            if t.kind[st] != int(Ty.Tuple) && !t.is_error(st):
                self.err(a.tok[p], int(Te.Mismatch), st, st)
            let i = 0
            let c = a.child[p]
            while c >= 0:
                let pt = 0
                if t.kind[st] == int(Ty.Tuple) && i < t.count_of(st):
                    pt = t.arg(st, i)
                self.pattern(t, g, a, c, pt)
                i = i + 1
                c = a.next[c]
        elif k == int(Nk.Binary) && a.pc[p] == int(Tk.Pipe):
            /#/ `A(n) | B(n)`: the second alternative's names must have the types the first gave
            let mark = self.rd.sc.loc.n
            self.pattern(t, g, a, a.pa[p], st0)
            let mid = self.rd.sc.loc.n
            self.pattern(t, g, a, a.pb[p], st0)
            for r in mid..self.rd.sc.loc.n:
                for j in mark..mid:
                    if self.rd.sc.loc.hash[r] == self.rd.sc.loc.hash[j] && self.rd.sc.loc.size[r] == self.rd.sc.loc.size[j] && self.rd.sc.loc.ty[r] != self.rd.sc.loc.ty[j] && self.rd.sc.loc.kind[j] == int(Sk.Local):
                        self.err(a.tok[p], int(Te.Mismatch), self.rd.sc.loc.ty[j], self.rd.sc.loc.ty[r])
            self.rd.sc.loc.truncate(mid)
            self.set(p, st0)
        elif k == int(Nk.StructLit):
            let tn = a.pa[p]
            let ci = -1
            if tn >= 0 && a.kind[tn] == int(Nk.Name):
                let r = self.lookup(a, a.tok[tn])
                if r >= 0 && self.rd.sc.loc.kind[r] == int(Sk.Class):
                    ci = self.rd.sc.loc.info[r]
            let f = a.child[p]
            while f >= 0:
                let ft = 0
                if ci >= 0:
                    let fr = self.find_member(g, a, ci, a.tok[f], int(Sk.Field))
                    if fr >= 0 && g.ty[fr] >= 0:
                        ft = g.ty[fr]
                self.pattern(t, g, a, a.pa[f], ft)
                f = a.next[f]
        else:
            self.expect(t, g, a, p, st)

    /#/ ---- a module ---------------------------------------------------------------

    fn class_decl(self, t: &Tys, g: &Syms, a: &Ast, cl: int) => void:
        let ci = g.find_in_module(a, a.pa[cl], self.cur)
        if ci < 0:
            return
        let mark = self.rd.sc.loc.n
        self.rd.bind_params(t, a, cl)
        let self_ty = self_type(t, g, ci)
        let f = a.child[cl]
        while f >= 0:
            if a.kind[f] == int(Nk.Fn):
                self.function(t, g, a, f, self_ty)
            f = a.next[f]
        self.pop(mark)

    fn module(self, t: &Tys, g: &Syms, a: &Ast) => void:
        let it = a.child[a.root]
        while it >= 0:
            if a.kind[it] == int(Nk.Let):
                self.let_stmt(t, g, a, it)
            it = a.next[it]
        it = a.child[a.root]
        while it >= 0:
            let k = a.kind[it]
            if k == int(Nk.Fn):
                self.function(t, g, a, it, -1)
            elif k == int(Nk.Class):
                self.class_decl(t, g, a, it)
            elif k != int(Nk.Let) && k != int(Nk.Use) && k != int(Nk.Enum) && k != int(Nk.TypeAlias):
                self.stmt(t, g, a, it)
            it = a.next[it]

/#/ The value of character literal token `tok` (`'a'`, `'\n'`, a UTF-8 character).
fn char_value(a: &Ast, tok: int) => int:
    let s = a.toks.start[tok] + 1
    let e = a.toks.end[tok] - 1
    if s >= e:
        return 0
    let b = a.byte_at(s)
    if b == '\\':
        let c = a.byte_at(s + 1)
        if c == 'n':
            return 10
        if c == 't':
            return 9
        if c == 'r':
            return 13
        if c == '0':
            return 0
        return c
    if b < 128:
        return b
    let extra = 1
    let v = b % 32
    if b >= 240:
        extra = 3
        v = b % 8
    elif b >= 224:
        extra = 2
        v = b % 16
    for i in 1..extra + 1:
        v = v * 64 + a.byte_at(s + i) % 64
    return v

fn new_typer(a: &Ast, g: &Syms, m: int) => Typer:
    let nodes: buf<int> = new_buf(int, a.count + 1)
    for i in 0..a.count + 1:
        nodes[i] = -1
    return Typer { rd: Reader { sc: scope_of(a, g, m) }, diags: new_tdiags(), node: nodes, ret: 0, loops: 0, self_class: -1, in_fn: 0, binds: new_buf(int, 16), cur: m }

/#/ Types module `m` (tree `a`) of `g`. `declare_types` must have run on it and on the modules
/#/ it imports from. The findings are in the result's `diags`.
fn check_types(t: &Tys, g: &Syms, a: &Ast, m: int) => Typer:
    let r = new_typer(a, g, m)
    r.module(t, g, a)
    return r

/#/ What the ownership checker reports. The numbers are the Rust compiler's.
enum Oe:
    UseAfterMove
    UseAfterDrop
    CopyResource
    BorrowViolation
    ReturnsLocalRef
    BorrowConflict

fn oe_number(code: int) => int:
    if code == int(Oe.UseAfterMove):
        return 300
    if code == int(Oe.UseAfterDrop):
        return 301
    if code == int(Oe.CopyResource):
        return 302
    if code == int(Oe.BorrowViolation):
        return 303
    if code == int(Oe.ReturnsLocalRef):
        return 400
    return 401

/#/ A finding: the token it is about and its code.
class ODiags:
    tok: buf<int>
    code: buf<int>
    n: int

    fn add(self, tok: int, code: int) => void:
        if self.n >= len(self.tok):
            let cap = (self.n + 1) * 2
            self.tok = buf_resize(self.tok, cap)
            self.code = buf_resize(self.code, cap)
        /#/ the same finding is not reported twice
        for i in 0..self.n:
            if self.tok[i] == tok && self.code[i] == code:
                return
        self.tok[self.n] = tok
        self.code[self.n] = code
        self.n = self.n + 1

    fn count(self, code: int) => int:
        let c = 0
        for i in 0..self.n:
            if self.code[i] == code:
                c = c + 1
        return c

fn new_odiags() => ODiags:
    return ODiags { tok: new_buf(int, 8), code: new_buf(int, 8), n: 0 }


enum Ev:
    Let
    Assign
    Use
    Consume
    Move
    Borrow
    Drop
    Write
    Bind
    Flow
    Ret
    Scope
    End

/#/ Hash of the bytes of token `tok`: the name of a field in a place.
fn tok_hash(a: &Ast, tok: int) => int:
    let h = 0
    for k in a.toks.start[tok]..a.toks.end[tok]:
        h = hash_step(h, a.byte_at(k))
    return h

/#/ The top-level function named like token `tok`, -1 if none.
fn top_fn(a: &Ast, tok: int) => int:
    let it = a.child[a.root]
    while it >= 0:
        if a.kind[it] == int(Nk.Fn) && a.pa[it] >= 0 && same_tok(a, a.pa[it], tok):
            return it
        it = a.next[it]
    return -1

/#/ The index of the parameter of `f` named like token `tok`, -1 if none.
fn param_index(a: &Ast, f: int, tok: int) => int:
    let i = 0
    let p = a.child[f]
    while p >= 0:
        if a.kind[p] == int(Nk.Param):
            if same_tok(a, a.tok[p], tok):
                return i
            i = i + 1
        p = a.next[p]
    return -1

/#/ The returns of statement `c` (in function `f`) as a mask of the parameters they give back;
/#/ -1 when one gives back something else.
fn returns_of(a: &Ast, f: int, c: int, mask: int) => int:
    if c < 0 || mask == -1:
        return mask
    let k = a.kind[c]
    if k == int(Nk.Return):
        let e = a.pa[c]
        if e < 0:
            return mask
        if a.kind[e] != int(Nk.Name):
            return -1
        let pi = param_index(a, f, a.tok[e])
        if pi < 0 || pi >= 60:
            return -1
        return mask | (1 << pi)
    if k == int(Nk.Block):
        let s = a.child[c]
        while s >= 0:
            mask = returns_of(a, f, s, mask)
            s = a.next[s]
        return mask
    if k == int(Nk.If):
        mask = returns_of(a, f, a.pb[c], mask)
        return returns_of(a, f, a.pc[c], mask)
    if k == int(Nk.While):
        return returns_of(a, f, a.pb[c], mask)
    if k == int(Nk.For):
        return returns_of(a, f, a.pc[c], mask)
    if k == int(Nk.Match):
        let arm = a.child[c]
        while arm >= 0:
            mask = returns_of(a, f, a.pb[arm], mask)
            arm = a.next[arm]
    return mask

/#/ Which parameters of `f` it can return, as a mask; -1 for any.
fn returned_params(a: &Ast, f: int) => int:
    return returns_of(a, f, a.pc[f], 0)

class Flow:
    /#/ events: kind, variable, node, and four operands whose meaning depends on the kind
    ek: buf<int>
    ev: buf<int>
    en: buf<int>
    ea: buf<int>
    eb: buf<int>
    ec: buf<int>
    ed: buf<int>
    ne: int
    /#/ blocks of events and the edges between them
    bs: buf<int>
    be: buf<int>
    nb: int
    ef: buf<int>
    et: buf<int>
    nedge: int
    cur: int
    /#/ variables
    v_tok: buf<int>
    v_ty: buf<int>
    v_param: buf<int>
    v_node: buf<int>
    v_exit: buf<int>
    nv: int
    /#/ scope: variable names -> ids, and the stack of live ids
    sc: Syms
    ss: buf<int>
    sn: int
    /#/ loops: head block, exit block, scope depth at entry
    lh: buf<int>
    lx: buf<int>
    ld: buf<int>
    nl_loops: int
    /#/ places and loans
    pp: buf<int>
    pn: int
    pt: buf<int>
    plen: int
    pvar: int
    lroot: buf<int>
    lps: buf<int>
    lpl: buf<int>
    lmut: buf<int>
    lthru: buf<int>
    nl: int
    s0: int
    target: int
    /#/ results
    diags: ODiags
    moved_at: buf<int>
    lv_start: buf<int>
    lv_pos: buf<int>
    lv_blk: buf<int>
    lv_w: int
    reach: buf<int>
    st_in: buf<int>
    live_in: buf<int>
    live_out: buf<int>
    w: buf<int>
    exit_of: buf<int>

    /#/ ---- the graph ---------------------------------------------------------

    fn ev_add(self, kind: int, var: int, node: int, a: int, b: int, c: int, d: int) => void:
        if self.ne >= len(self.ek):
            let cap = (self.ne + 1) * 2
            self.ek = buf_resize(self.ek, cap)
            self.ev = buf_resize(self.ev, cap)
            self.en = buf_resize(self.en, cap)
            self.ea = buf_resize(self.ea, cap)
            self.eb = buf_resize(self.eb, cap)
            self.ec = buf_resize(self.ec, cap)
            self.ed = buf_resize(self.ed, cap)
        let i = self.ne
        self.ek[i] = kind
        self.ev[i] = var
        self.en[i] = node
        self.ea[i] = a
        self.eb[i] = b
        self.ec[i] = c
        self.ed[i] = d
        self.ne = i + 1

    fn new_block(self) => int:
        if self.nb >= len(self.bs):
            let cap = (self.nb + 1) * 2
            self.bs = buf_resize(self.bs, cap)
            self.be = buf_resize(self.be, cap)
        let b = self.nb
        self.bs[b] = 0
        self.be[b] = 0
        self.nb = b + 1
        return b

    /#/ Makes `b` the block events are added to; the one left is closed.
    fn enter(self, b: int) => void:
        if self.cur >= 0:
            self.be[self.cur] = self.ne
        self.cur = b
        self.bs[b] = self.ne

    fn edge(self, f: int, t: int) => void:
        if self.nedge >= len(self.ef):
            let cap = (self.nedge + 1) * 2
            self.ef = buf_resize(self.ef, cap)
            self.et = buf_resize(self.et, cap)
        self.ef[self.nedge] = f
        self.et[self.nedge] = t
        self.nedge = self.nedge + 1

    /#/ Code after a jump is unreachable: it goes to a block nothing leads to.
    fn dead_block(self) => void:
        self.enter(self.new_block())

    fn add_var(self, a: &Ast, tok: int, ty: int, param: bool, node: int) => int:
        if self.nv >= len(self.v_tok):
            let cap = (self.nv + 1) * 2
            self.v_tok = buf_resize(self.v_tok, cap)
            self.v_ty = buf_resize(self.v_ty, cap)
            self.v_param = buf_resize(self.v_param, cap)
            self.v_node = buf_resize(self.v_node, cap)
            self.v_exit = buf_resize(self.v_exit, cap)
        let id = self.nv
        self.v_tok[id] = tok
        self.v_ty[id] = ty
        self.v_param[id] = 0
        if param:
            self.v_param[id] = 1
        self.v_node[id] = node
        self.v_exit[id] = 0
        self.nv = id + 1
        self.sc.add_tok(a, tok, int(Sk.Local), id, 0)
        if self.sn >= len(self.ss):
            self.ss = buf_resize(self.ss, (self.sn + 1) * 2)
        self.ss[self.sn] = id
        self.sn = self.sn + 1
        return id

    fn lookup_var(self, a: &Ast, tok: int) => int:
        let r = self.sc.find_tok(a, tok, 0)
        if r >= 0 && self.sc.kind[r] == int(Sk.Local):
            return self.sc.info[r]
        return -1

    /#/ Ends the scope back to depth `depth`: its variables go out of scope, last declared first.
    fn close_scope(self, depth: int, mark: int) => void:
        let i = self.sn - 1
        while i >= depth:
            self.ev_add(int(Ev.Scope), self.ss[i], -1, 0, 0, 0, 0)
            i = i - 1
        self.sc.truncate(mark)
        self.sn = depth

    /#/ A jump out of scopes down to `depth` drops what is declared in them, without closing them.
    fn leave_scopes(self, depth: int) => void:
        let i = self.sn - 1
        while i >= depth:
            self.ev_add(int(Ev.Scope), self.ss[i], -1, 0, 0, 0, 0)
            i = i - 1

    /#/ ---- places ------------------------------------------------------------

    /#/ Is `n` a place (a variable, or fields and indexes of one)? Fills `pvar` and `pt`.
    /#/ Does the place expression `n` start at a module-level `let`? Those are owned by the program
    /#/ for its whole run: a resource is read in place, never moved or copied out.
    fn global_root(self, g: &Syms, ty: &Typer, a: &Ast, n: int) => bool:
        if n < 0:
            return false
        let k = a.kind[n]
        if k == int(Nk.Name):
            if self.lookup_var(a, a.tok[n]) >= 0:
                return false
            let r = g.find_in_module(a, a.tok[n], ty.cur)
            return r >= 0 && g.kind[r] == int(Sk.Global)
        if (k == int(Nk.Member) && a.pd[n] != 1) || k == int(Nk.Index):
            return self.global_root(g, ty, a, a.pa[n])
        return false

    fn place(self, a: &Ast, n: int) => bool:
        if n < 0:
            return false
        let k = a.kind[n]
        if k == int(Nk.Name):
            self.pvar = self.lookup_var(a, a.tok[n])
            self.plen = 0
            return self.pvar >= 0
        if k == int(Nk.Member) && a.pd[n] != 1:
            if !self.place(a, a.pa[n]):
                return false
            self.push_path(tok_hash(a, a.tok[n]))
            return true
        if k == int(Nk.Index):
            if !self.place(a, a.pa[n]):
                return false
            self.push_path(-1)
            return true
        return false

    fn push_path(self, h: int) => void:
        if self.plen >= len(self.pt):
            self.pt = buf_resize(self.pt, (self.plen + 1) * 2)
        self.pt[self.plen] = h
        self.plen = self.plen + 1

    /#/ Stores the path in `pt` in the pool and returns where it starts.
    fn keep_path(self) => int:
        let start = self.pn
        for i in 0..self.plen:
            if self.pn >= len(self.pp):
                self.pp = buf_resize(self.pp, (self.pn + 1) * 2)
            self.pp[self.pn] = self.pt[i]
            self.pn = self.pn + 1
        return start

    /#/ Evaluates what a place expression needs before it is accessed: the index expressions
    /#/ and a root that is not a variable.
    fn place_subs(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        if n < 0:
            return
        let k = a.kind[n]
        if k == int(Nk.Name):
            return
        if k == int(Nk.Member) && a.pd[n] != 1:
            self.place_subs(t, g, ty, a, a.pa[n])
        elif k == int(Nk.Index):
            self.place_subs(t, g, ty, a, a.pa[n])
            self.ex(t, g, ty, a, a.pb[n], true)
        else:
            self.ex(t, g, ty, a, n, false)

    /#/ Is `n` written like the place the current assignment stores to (`p = f(p)`)? The
    /#/ value is taken out and put back, so the place is never left empty.
    fn is_target(self, a: &Ast, n: int) => bool:
        let tg = self.target
        if tg < 0 || a.end[tg] - a.tok[tg] != a.end[n] - a.tok[n]:
            return false
        for k in 0..a.end[n] - a.tok[n]:
            let x = a.tok[n] + k
            let y = a.tok[tg] + k
            if a.toks.end[x] - a.toks.start[x] != a.toks.end[y] - a.toks.start[y]:
                return false
            for b in 0..a.toks.end[x] - a.toks.start[x]:
                if a.byte_at(a.toks.start[x] + b) != a.byte_at(a.toks.start[y] + b):
                    return false
        return true

    /#/ `b[i..j]` is a view of the buffer, not an element taken out of it.
    fn is_slice_of(self, a: &Ast, n: int) => bool:
        return a.kind[n] == int(Nk.Index) && a.pb[n] >= 0 && a.kind[a.pb[n]] == int(Nk.Range)

    fn own_of(self, t: &Tys, g: &Syms, x: int) => int:
        if x < 0 || t.is_error(x):
            return int(Own.Copy)
        let o = st_own(t, g, x)
        if o == int(Own.Unknown):
            return int(Own.Copy)
        return o

    /#/ ---- expressions -------------------------------------------------------

    /#/ Adds the events of expression `n`. `value` is true where the result is taken as a
    /#/ value (and so moves a resource), false where it is only looked at.
    fn ex(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int, value: bool) => void:
        if n < 0:
            return
        let k = a.kind[n]
        let x = ty.node[n]
        if k == int(Nk.Name):
            let v = self.lookup_var(a, a.tok[n])
            if v < 0:
                if value && x >= 0 && self.global_root(g, ty, a, n) && self.own_of(t, g, x) == int(Own.Move):
                    self.diags.add(a.tok[n], int(Oe.CopyResource))
                return
            if value && self.own_of(t, g, self.v_ty[v]) == int(Own.Move):
                self.ev_add(int(Ev.Consume), v, n, 0, 0, 0, 0)
            else:
                self.ev_add(int(Ev.Use), v, n, 0, 0, 0, 0)
        elif k == int(Nk.Member) || k == int(Nk.Index):
            self.place_subs(t, g, ty, a, n)
            if self.place(a, n):
                let v = self.pvar
                if value && x >= 0 && self.own_of(t, g, x) == int(Own.Move) && !self.is_target(a, n) && !self.is_slice_of(a, n):
                    self.diags.add(a.tok[n], int(Oe.CopyResource))
                self.ev_add(int(Ev.Use), v, n, self.keep_path(), self.plen, 0, 0)
            elif value && x >= 0 && self.own_of(t, g, x) == int(Own.Move) && !self.is_target(a, n) && !self.is_slice_of(a, n) && self.global_root(g, ty, a, n):
                self.diags.add(a.tok[n], int(Oe.CopyResource))
        elif k == int(Nk.Unary):
            self.unary(t, g, ty, a, n, value)
        elif k == int(Nk.Binary):
            self.ex(t, g, ty, a, a.pa[n], false)
            self.ex(t, g, ty, a, a.pb[n], false)
        elif k == int(Nk.Cast):
            self.ex(t, g, ty, a, a.pa[n], false)
        elif k == int(Nk.Call):
            self.call(t, g, ty, a, n)
        elif k == int(Nk.StructLit):
            let f = a.child[n]
            while f >= 0:
                /#/ a field taken out of another value is a copy of a resource; a variable is
                /#/ only looked at (the later `rm` of it is accepted)
                let fk = a.kind[a.pa[f]]
                self.ex(t, g, ty, a, a.pa[f], fk == int(Nk.Member) || fk == int(Nk.Index))
                f = a.next[f]
        elif k == int(Nk.Tuple) || k == int(Nk.Array):
            let c = a.child[n]
            while c >= 0:
                self.ex(t, g, ty, a, c, false)
                c = a.next[c]
        elif k == int(Nk.Range):
            self.ex(t, g, ty, a, a.pa[n], true)
            self.ex(t, g, ty, a, a.pb[n], true)
        elif k == int(Nk.FStr):
            self.fstr(t, g, ty, a, n)

    /#/ The expressions of an f-string are read, not moved.
    fn fstr(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        let p = a.child[n]
        while p >= 0:
            self.ex(t, g, ty, a, a.pa[p], false)
            p = a.next[p]

    fn unary(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int, value: bool) => void:
        let k = a.pc[n]
        let o = a.pa[n]
        if k == int(Tk.Amp):
            self.place_subs(t, g, ty, a, o)
            if self.place(a, o):
                let v = self.pvar
                let mutable = 0
                if a.pd[n] == 1:
                    mutable = 1
                let loan = -1
                if self.nl < 60:
                    loan = self.nl
                    self.lroot[loan] = v
                    self.lps[loan] = self.keep_path()
                    self.lpl[loan] = self.plen
                    self.lmut[loan] = mutable
                    let thru = 0
                    if t.kind[self.v_ty[v]] == int(Ty.Ref) || self.v_param[v] != 0:
                        thru = 1
                    self.lthru[loan] = thru
                    self.nl = self.nl + 1
                    self.ev_add(int(Ev.Borrow), v, n, self.lps[loan], self.plen, mutable, loan)
                else:
                    self.ev_add(int(Ev.Use), v, n, 0, 0, 0, 0)
            return
        if k == int(Tk.Star):
            let x = ty.node[n]
            if value && x >= 0 && self.own_of(t, g, x) == int(Own.Move):
                self.diags.add(a.tok[n], int(Oe.CopyResource))
            self.ex(t, g, ty, a, o, false)
            return
        if k == int(Tk.KwClone) || k == int(Tk.KwCopy):
            self.ex(t, g, ty, a, o, false)
            return
        self.ex(t, g, ty, a, o, false)

    /#/ Arguments of a call are values, except to builtins and C functions, which only borrow.
    fn call(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        let callee = a.pa[n]
        let by_value = true
        let sig = -1
        if callee >= 0 && a.kind[callee] == int(Nk.Name):
            if self.lookup_var(a, a.tok[callee]) >= 0:
                self.ex(t, g, ty, a, callee, false)
            else:
                let r = ty.lookup(a, a.tok[callee])
                if r >= 0 && (ty.rd.sc.loc.kind[r] == int(Sk.Builtin) || ty.rd.sc.loc.kind[r] == int(Sk.Extern)):
                    by_value = false
                elif r >= 0 && ty.rd.sc.loc.kind[r] == int(Sk.Fn):
                    sig = ty.rd.sc.loc.ty[r]
        elif callee >= 0 && a.kind[callee] == int(Nk.Member):
            self.place_subs(t, g, ty, a, a.pa[callee])
            if self.place(a, a.pa[callee]):
                self.ev_add(int(Ev.Use), self.pvar, callee, self.keep_path(), self.plen, 0, 0)
        elif callee >= 0:
            self.ex(t, g, ty, a, callee, false)
        let c = a.child[n]
        let i = 0
        while c >= 0:
            let v = by_value
            /#/ a `buf` given to an `object` parameter is only a pointer to look through
            if sig >= 0 && t.kind[sig] == int(Ty.Fn) && i < t.count_of(sig) && t.kind[t.arg(sig, i)] == int(Ty.Object):
                v = false
            self.ex(t, g, ty, a, c, v)
            c = a.next[c]
            i = i + 1

    /#/ ---- statements --------------------------------------------------------

    fn stmt_start(self) => void:
        self.s0 = self.nl

    /#/ Ends a statement: loans that were not stored anywhere end with it.
    fn stmt_end(self) => void:
        self.ev_add(int(Ev.End), -1, -1, 0, 0, 0, 0)

    /#/ `dst` receives the value of `init`: references hold the loans it created and the ones
    /#/ its reference arguments hold.
    fn bind_loans(self, t: &Tys, ty: &Typer, a: &Ast, dst: int, init: int) => void:
        if dst < 0 || init < 0 || t.kind[self.v_ty[dst]] != int(Ty.Ref):
            return
        if self.nl > self.s0 && a.kind[init] == int(Nk.Unary):
            self.ev_add(int(Ev.Bind), dst, init, self.s0, self.nl, 0, 0)
        elif self.nl > self.s0 && a.kind[init] == int(Nk.Call):
            self.bind_call_loans(a, dst, init)
        self.flow_from(a, dst, init)

    /#/ `dst = f(&a, &b)`: it holds the loans of the arguments the function can return; for a
    /#/ function that is not known, all of them.
    fn bind_call_loans(self, a: &Ast, dst: int, init: int) => void:
        let mask = -1
        let callee = a.pa[init]
        if callee >= 0 && a.kind[callee] == int(Nk.Name) && self.lookup_var(a, a.tok[callee]) < 0:
            let f = top_fn(a, a.tok[callee])
            if f >= 0:
                mask = returned_params(a, f)
        if mask == -1:
            self.ev_add(int(Ev.Bind), dst, init, self.s0, self.nl, 0, 0)
            return
        let l = self.s0
        let i = 0
        let c = a.child[init]
        while c >= 0:
            if a.kind[c] != int(Nk.Unary) || a.pc[c] != int(Tk.Amp):
                self.ev_add(int(Ev.Bind), dst, init, self.s0, self.nl, 0, 0)
                return
            if l < self.nl && (mask & (1 << i)) != 0:
                self.ev_add(int(Ev.Bind), dst, init, l, l + 1, 0, 0)
            if l < self.nl:
                l = l + 1
            i = i + 1
            c = a.next[c]

    fn flow_from(self, a: &Ast, dst: int, e: int) => void:
        if e < 0:
            return
        if a.kind[e] == int(Nk.Name):
            let src = self.lookup_var(a, a.tok[e])
            if src >= 0 && src != dst:
                self.ev_add(int(Ev.Flow), dst, e, src, 0, 0, 0)

    fn block(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, b: int) => void:
        if b < 0:
            return
        let depth = self.sn
        let mark = self.sc.n
        let c = a.child[b]
        while c >= 0:
            self.stmt(t, g, ty, a, c)
            c = a.next[c]
        self.close_scope(depth, mark)

    fn stmt(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        let k = a.kind[n]
        self.stmt_start()
        if k == int(Nk.Let):
            self.ex(t, g, ty, a, a.pc[n], true)
            if a.pa[n] >= 0:
                let v = self.add_var(a, a.pa[n], ty.node[n], false, n)
                self.ev_add(int(Ev.Let), v, n, 0, 0, 0, 0)
                self.bind_loans(t, ty, a, v, a.pc[n])
            self.stmt_end()
        elif k == int(Nk.Assign):
            self.assign(t, g, ty, a, n)
        elif k == int(Nk.Return):
            self.ex(t, g, ty, a, a.pa[n], true)
            let rv = -1
            let l0 = self.nl
            let rt = -1
            if a.pa[n] >= 0:
                rt = ty.node[a.pa[n]]
            if rt >= 0 && t.kind[rt] == int(Ty.Ref):
                l0 = self.s0
                if a.kind[a.pa[n]] == int(Nk.Name):
                    rv = self.lookup_var(a, a.tok[a.pa[n]])
            self.ev_add(int(Ev.Ret), rv, n, l0, self.nl, 0, 0)
            self.leave_scopes(0)
            self.dead_block()
        elif k == int(Nk.Raise):
            self.ex(t, g, ty, a, a.pa[n], true)
            self.stmt_end()
        elif k == int(Nk.ExprStmt):
            self.ex(t, g, ty, a, a.pa[n], false)
            self.stmt_end()
        elif k == int(Nk.Rm):
            self.rm_target(t, g, ty, a, a.pa[n])
            let extra = a.child[n]
            while extra >= 0:
                self.rm_target(t, g, ty, a, extra)
                extra = a.next[extra]
            self.stmt_end()
        elif k == int(Nk.Clean):
            self.diags.add(a.tok[n], int(Oe.CopyResource))
            self.stmt_end()
        elif k == int(Nk.Mv):
            let src = -1
            if a.pa[n] >= 0 && a.kind[a.pa[n]] == int(Nk.Name):
                src = self.lookup_var(a, a.tok[a.pa[n]])
            if src >= 0:
                if a.pc[n] == 1:
                    self.ev_add(int(Ev.Use), src, a.pa[n], 0, 0, 0, 0)
                else:
                    self.ev_add(int(Ev.Move), src, a.pa[n], 0, 0, 0, 0)
            elif a.pc[n] != 1 && self.global_root(g, ty, a, a.pa[n]):
                self.diags.add(a.tok[a.pa[n]], int(Oe.CopyResource))
            if a.pb[n] >= 0:
                let ty_of = 0
                if src >= 0:
                    ty_of = self.v_ty[src]
                let v = self.add_var(a, a.pb[n], ty_of, false, n)
                self.ev_add(int(Ev.Let), v, n, 0, 0, 0, 0)
            self.stmt_end()
        elif k == int(Nk.If):
            self.if_stmt(t, g, ty, a, n)
        elif k == int(Nk.While):
            self.while_stmt(t, g, ty, a, n)
        elif k == int(Nk.For):
            self.for_stmt(t, g, ty, a, n)
        elif k == int(Nk.Match):
            self.match_stmt(t, g, ty, a, n)
        elif k == int(Nk.Break):
            if self.nl_loops > 0:
                let l = self.nl_loops - 1
                self.leave_scopes(self.ld[l])
                self.edge(self.cur, self.lx[l])
            self.dead_block()
        elif k == int(Nk.Continue):
            if self.nl_loops > 0:
                let l = self.nl_loops - 1
                self.leave_scopes(self.ld[l])
                self.edge(self.cur, self.lh[l])
            self.dead_block()

    fn rm_target(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, e: int) => void:
        if e < 0:
            return
        if a.kind[e] == int(Nk.Name):
            let v = self.lookup_var(a, a.tok[e])
            if v >= 0:
                self.ev_add(int(Ev.Drop), v, e, 0, 0, 0, 0)
            elif self.global_root(g, ty, a, e):
                /#/ a module-level `let` lives as long as the program
                self.diags.add(a.tok[e], int(Oe.CopyResource))
        else:
            self.ex(t, g, ty, a, e, false)

    fn assign(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        let target = a.pa[n]
        self.target = target
        self.ex(t, g, ty, a, a.pb[n], true)
        self.target = -1
        if target >= 0 && a.kind[target] == int(Nk.Name):
            let v = self.lookup_var(a, a.tok[target])
            if v >= 0:
                self.ev_add(int(Ev.Assign), v, n, 0, 0, 0, 0)
                self.bind_loans(t, ty, a, v, a.pb[n])
        else:
            self.place_subs(t, g, ty, a, target)
            if self.place(a, target):
                self.ev_add(int(Ev.Write), self.pvar, n, self.keep_path(), self.plen, 0, 0)
            elif target >= 0 && a.kind[target] == int(Nk.Unary):
                self.ex(t, g, ty, a, a.pa[target], false)
        self.stmt_end()

    fn if_stmt(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        self.ex(t, g, ty, a, a.pa[n], true)
        self.stmt_end()
        let head = self.cur
        let then_b = self.new_block()
        let join = self.new_block()
        self.edge(head, then_b)
        self.enter(then_b)
        self.block(t, g, ty, a, a.pb[n])
        self.edge(self.cur, join)
        let e = a.pc[n]
        if e >= 0:
            let else_b = self.new_block()
            self.edge(head, else_b)
            self.enter(else_b)
            if a.kind[e] == int(Nk.If):
                self.stmt(t, g, ty, a, e)
            else:
                self.block(t, g, ty, a, e)
            self.edge(self.cur, join)
        else:
            self.edge(head, join)
        self.enter(join)

    fn push_loop(self, head: int, exit: int) => void:
        if self.nl_loops >= len(self.lh):
            let cap = (self.nl_loops + 1) * 2
            self.lh = buf_resize(self.lh, cap)
            self.lx = buf_resize(self.lx, cap)
            self.ld = buf_resize(self.ld, cap)
        self.lh[self.nl_loops] = head
        self.lx[self.nl_loops] = exit
        self.ld[self.nl_loops] = self.sn
        self.nl_loops = self.nl_loops + 1

    fn while_stmt(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        let pre = self.cur
        let head = self.new_block()
        let body = self.new_block()
        let exit = self.new_block()
        self.edge(pre, head)
        self.enter(head)
        self.ex(t, g, ty, a, a.pa[n], true)
        self.stmt_end()
        self.edge(head, body)
        self.edge(head, exit)
        self.push_loop(head, exit)
        self.enter(body)
        self.block(t, g, ty, a, a.pb[n])
        self.edge(self.cur, head)
        self.nl_loops = self.nl_loops - 1
        self.enter(exit)

    fn for_stmt(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        self.ex(t, g, ty, a, a.pb[n], false)
        self.stmt_end()
        let pre = self.cur
        let head = self.new_block()
        let body = self.new_block()
        let exit = self.new_block()
        self.edge(pre, head)
        self.enter(head)
        self.edge(head, body)
        self.edge(head, exit)
        self.push_loop(head, exit)
        self.enter(body)
        let depth = self.sn
        let mark = self.sc.n
        if a.pa[n] >= 0:
            let v = self.add_var(a, a.pa[n], ty.node[n], false, n)
            self.ev_add(int(Ev.Let), v, n, 0, 0, 0, 0)
        self.block(t, g, ty, a, a.pc[n])
        self.close_scope(depth, mark)
        self.edge(self.cur, head)
        self.nl_loops = self.nl_loops - 1
        self.enter(exit)

    /#/ Names in a pattern that bind a new variable get the type the checker gave them.
    fn pattern(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, p: int) => void:
        if p < 0:
            return
        let k = a.kind[p]
        if k == int(Nk.Name):
            if tok_is(a, a.tok[p], "_"):
                return
            if self.lookup_var(a, a.tok[p]) >= 0 || ty.lookup(a, a.tok[p]) < 0:
                let v = self.add_var(a, a.tok[p], ty.node[p], false, p)
                self.ev_add(int(Ev.Let), v, p, 0, 0, 0, 0)
        elif k == int(Nk.Call) || k == int(Nk.Tuple):
            let c = a.child[p]
            while c >= 0:
                self.pattern(t, g, ty, a, c)
                c = a.next[c]
        elif k == int(Nk.StructLit):
            let f = a.child[p]
            while f >= 0:
                self.pattern(t, g, ty, a, a.pa[f])
                f = a.next[f]
        elif k == int(Nk.Binary) && a.pc[p] == int(Tk.Pipe):
            /#/ the alternatives bind the same names: the first one makes the variables
            self.pattern(t, g, ty, a, a.pa[p])

    fn match_stmt(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        let s = a.pa[n]
        self.ex(t, g, ty, a, s, false)
        self.stmt_end()
        let head = self.cur
        let join = self.new_block()
        let arm = a.child[n]
        while arm >= 0:
            let ab = self.new_block()
            self.edge(head, ab)
            self.enter(ab)
            let depth = self.sn
            let mark = self.sc.n
            self.pattern(t, g, ty, a, a.pa[arm])
            if a.pc[arm] >= 0:
                self.stmt_start()
                self.ex(t, g, ty, a, a.pc[arm], true)
                self.stmt_end()
            self.block(t, g, ty, a, a.pb[arm])
            self.close_scope(depth, mark)
            self.edge(self.cur, join)
            arm = a.next[arm]
        if a.child[n] < 0:
            self.edge(head, join)
        self.enter(join)

    /#/ ---- analyses ----------------------------------------------------------

    /#/ Does variable `v` stay in use after event `i`?
    fn live_at(self, i: int, v: int) => bool:
        let b = self.lv_blk[i]
        /#/ the first event of the variable after `i`: a read makes it live, an end does not
        let lo = self.lv_start[v]
        let hi = self.lv_start[v + 1]
        while lo < hi:
            let mid = (lo + hi) // 2
            if self.lv_pos[mid] > i:
                hi = mid
            else:
                lo = mid + 1
        if lo < self.lv_start[v + 1] && self.lv_pos[lo] < self.be[b]:
            return self.reads_var(self.ek[self.lv_pos[lo]])
        return ((self.live_out[b * self.lv_w + v // 60] >> (v % 60)) & 1) != 0

    /#/ Backwards: which variables are read later. A variable is a bit of its block's `live_in` and
    /#/ `live_out` (words of 60 bits). Inside a block the answer for one event is found from the
    /#/ events of that variable (`lv_pos`, by variable, in event order), see `live_at`.
    fn liveness(self) => void:
        let nv = self.nv
        let wn = nv // 60 + 1
        self.lv_w = wn
        self.live_in = new_buf(int, self.nb * wn + 1)
        self.live_out = new_buf(int, self.nb * wn + 1)
        let gen: buf<int> = new_buf(int, self.nb * wn + 1)
        let kill: buf<int> = new_buf(int, self.nb * wn + 1)
        /#/ the events that read or end a variable, by variable
        self.lv_start = new_buf(int, nv + 2)
        self.lv_blk = new_buf(int, self.ne + 1)
        for b in 0..self.nb:
            for i in self.bs[b]..self.be[b]:
                self.lv_blk[i] = b
                let k = self.ek[i]
                let x = self.ev[i]
                if self.reads_var(k):
                    self.lv_start[x + 1] = self.lv_start[x + 1] + 1
                    if ((kill[b * wn + x // 60] >> (x % 60)) & 1) == 0:
                        gen[b * wn + x // 60] = gen[b * wn + x // 60] | (1 << (x % 60))
                elif k == int(Ev.Let) || k == int(Ev.Assign):
                    self.lv_start[x + 1] = self.lv_start[x + 1] + 1
                    kill[b * wn + x // 60] = kill[b * wn + x // 60] | (1 << (x % 60))
        for v in 0..nv:
            self.lv_start[v + 1] = self.lv_start[v + 1] + self.lv_start[v]
        self.lv_pos = new_buf(int, self.lv_start[nv] + 1)
        let fill: buf<int> = new_buf(int, nv + 1)
        for i in 0..self.ne:
            let k = self.ek[i]
            if self.reads_var(k) || k == int(Ev.Let) || k == int(Ev.Assign):
                let x = self.ev[i]
                self.lv_pos[self.lv_start[x] + fill[x]] = i
                fill[x] = fill[x] + 1
        let changed = true
        while changed:
            changed = false
            for e in 0..self.nedge:
                let f = self.ef[e]
                let to = self.et[e]
                for j in 0..wn:
                    let x = self.live_out[f * wn + j] | self.live_in[to * wn + j]
                    if x != self.live_out[f * wn + j]:
                        self.live_out[f * wn + j] = x
                        changed = true
            let b = self.nb - 1
            while b >= 0:
                for j in 0..wn:
                    let x = gen[b * wn + j] | (self.live_out[b * wn + j] & (0 - 1 - kill[b * wn + j]))
                    if x != self.live_in[b * wn + j]:
                        self.live_in[b * wn + j] = x
                        changed = true
                b = b - 1

    fn reads_var(self, k: int) => bool:
        return k == int(Ev.Use) || k == int(Ev.Consume) || k == int(Ev.Borrow) || k == int(Ev.Move) || k == int(Ev.Write)

    /#/ Do two places of the same variable overlap? An index step matches any index.
    fn overlap(self, s1: int, l1: int, s2: int, l2: int) => bool:
        let n = l1
        if l2 < n:
            n = l2
        for i in 0..n:
            let x = self.pp[s1 + i]
            let y = self.pp[s2 + i]
            if x != y && x != -1 && y != -1:
                return false
        return true

    /#/ The loans in force at event `i`: those of the statement so far, and those held by a
    /#/ variable that is still used later (`scoped`: still in scope, which is what a new borrow
    /#/ is checked against).
    fn active(self, i: int, scoped: bool) => int:
        let nv = self.nv
        let m = self.w[2 * nv]
        for h in 0..nv:
            if self.w[nv + h] != 0 && (scoped || self.live_at(i, h)):
                m = m | self.w[nv + h]
        return m

    /#/ kind: 0 read, 1 write/move/drop, 2 shared borrow, 3 mutable borrow
    fn access(self, a: &Ast, i: int, node: int, v: int, ps: int, pl: int, kind: int) => void:
        let m = self.active(i, kind >= 2)
        if m == 0:
            return
        for l in 0..self.nl:
            if (m & (1 << l)) != 0 && self.lroot[l] == v && self.overlap(ps, pl, self.lps[l], self.lpl[l]):
                if kind >= 2:
                    if kind == 3 || self.lmut[l] != 0:
                        self.diags.add(a.tok[node], int(Oe.BorrowConflict))
                elif kind == 1 || self.lmut[l] != 0:
                    self.diags.add(a.tok[node], int(Oe.BorrowViolation))

    fn check_state(self, a: &Ast, node: int, v: int) => void:
        let s = self.w[v]
        if (s & 2) != 0:
            self.diags.add(a.tok[node], int(Oe.UseAfterMove))
        elif (s & 4) != 0:
            self.diags.add(a.tok[node], int(Oe.UseAfterDrop))

    /#/ One event on the working state `w`. With `report`, findings are recorded.
    fn step(self, a: &Ast, i: int, report: bool) => void:
        let nv = self.nv
        let k = self.ek[i]
        let v = self.ev[i]
        let n = self.en[i]
        if k == int(Ev.Let):
            self.w[v] = 1
            self.w[nv + v] = 0
        elif k == int(Ev.Assign):
            if report:
                self.access(a, i, n, v, 0, 0, 1)
            self.w[v] = 1
            self.w[nv + v] = 0
        elif k == int(Ev.Use):
            if report:
                self.check_state(a, n, v)
                self.access(a, i, n, v, self.ea[i], self.eb[i], 0)
        elif k == int(Ev.Consume):
            if report:
                self.check_state(a, n, v)
                self.access(a, i, n, v, 0, 0, 1)
            if self.live_at(i, v):
                if report:
                    self.diags.add(a.tok[n], int(Oe.CopyResource))
            else:
                self.w[v] = 2
                if report:
                    self.moved_at[n] = 1
        elif k == int(Ev.Move):
            if report:
                self.check_state(a, n, v)
                self.access(a, i, n, v, 0, 0, 1)
            self.w[v] = 2
        elif k == int(Ev.Borrow):
            if report:
                self.check_state(a, n, v)
                self.access(a, i, n, v, self.ea[i], self.eb[i], 2 + self.ec[i])
            self.w[2 * nv] = self.w[2 * nv] | (1 << self.ed[i])
        elif k == int(Ev.Drop):
            if report:
                let s = self.w[v]
                if (s & 2) != 0:
                    self.diags.add(a.tok[n], int(Oe.UseAfterMove))
                elif (s & 4) != 0:
                    self.diags.add(a.tok[n], int(Oe.UseAfterDrop))
                self.access(a, i, n, v, 0, 0, 1)
            self.w[v] = 4
        elif k == int(Ev.Write):
            if report:
                self.check_state(a, n, v)
                self.access(a, i, n, v, self.ea[i], self.eb[i], 1)
        elif k == int(Ev.Bind):
            let mask = 0
            for l in self.ea[i]..self.eb[i]:
                mask = mask | (1 << l)
            self.w[nv + v] = self.w[nv + v] | mask
        elif k == int(Ev.Flow):
            self.w[nv + v] = self.w[nv + v] | self.w[nv + self.ea[i]]
        elif k == int(Ev.Ret):
            if report:
                for l in self.ea[i]..self.eb[i]:
                    if self.lthru[l] == 0:
                        self.diags.add(a.tok[n], int(Oe.ReturnsLocalRef))
                if v >= 0:
                    for l in 0..self.nl:
                        if (self.w[nv + v] & (1 << l)) != 0 && self.lthru[l] == 0:
                            self.diags.add(a.tok[n], int(Oe.ReturnsLocalRef))
        elif k == int(Ev.Scope):
            if report:
                let s = self.w[v]
                if (s & 1) != 0:
                    self.v_exit[v] = self.v_exit[v] | 1
                if (s & 6) != 0:
                    self.v_exit[v] = self.v_exit[v] | 2
            self.w[nv + v] = 0
        elif k == int(Ev.End):
            self.w[2 * nv] = 0

    /#/ Forwards to a fixed point, then once more to report.
    fn solve(self, a: &Ast) => void:
        let nv = self.nv
        let width = 2 * nv + 1
        self.w = new_buf(int, width)
        self.st_in = new_buf(int, self.nb * width + 1)
        self.reach = new_buf(int, self.nb + 1)
        self.reach[0] = 1
        /#/ the edges out of each block
        let oc: buf<int> = new_buf(int, self.nb + 2)
        for e in 0..self.nedge:
            oc[self.ef[e] + 1] = oc[self.ef[e] + 1] + 1
        for b in 0..self.nb:
            oc[b + 1] = oc[b + 1] + oc[b]
        let oe: buf<int> = new_buf(int, self.nedge + 1)
        let ofill: buf<int> = new_buf(int, self.nb + 1)
        for e in 0..self.nedge:
            oe[oc[self.ef[e]] + ofill[self.ef[e]]] = e
            ofill[self.ef[e]] = ofill[self.ef[e]] + 1
        /#/ blocks whose entry state changed are run again, the others are not
        let dirty: buf<int> = new_buf(int, self.nb + 1)
        let work: buf<int> = new_buf(int, self.nb * 8 + 8)
        let wh = 0
        let wt = 0
        work[0] = 0
        wt = 1
        dirty[0] = 1
        let budget = self.nb * 100 + 100
        while wh < wt && budget > 0:
            budget = budget - 1
            let b = work[wh % len(work)]
            wh = wh + 1
            dirty[b] = 0
            self.run_block(a, b, width, false)
            for k in oc[b]..oc[b + 1]:
                let to = self.et[oe[k]]
                let grew = false
                if self.reach[to] == 0:
                    self.reach[to] = 1
                    for j in 0..width:
                        self.st_in[to * width + j] = self.w[j]
                    grew = true
                else:
                    for j in 0..width:
                        let x = self.st_in[to * width + j] | self.w[j]
                        if x != self.st_in[to * width + j]:
                            self.st_in[to * width + j] = x
                            grew = true
                if grew && dirty[to] == 0 && wt - wh < len(work):
                    dirty[to] = 1
                    work[wt % len(work)] = to
                    wt = wt + 1
        for b in 0..self.nb:
            if self.reach[b] != 0:
                self.run_block(a, b, width, true)

    fn run_block(self, a: &Ast, b: int, width: int, report: bool) => void:
        for j in 0..width:
            self.w[j] = self.st_in[b * width + j]
        for i in self.bs[b]..self.be[b]:
            self.step(a, i, report)

    fn reset(self) => void:
        self.ne = 0
        self.nb = 0
        self.nedge = 0
        self.cur = -1
        self.nv = 0
        self.sn = 0
        self.nl_loops = 0
        self.pn = 0
        self.nl = 0
        self.s0 = 0
        self.sc.truncate(0)

    /#/ Checks one function (`f` is its Fn node; methods and plain functions alike).
    fn function(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, f: int) => void:
        let body = a.pc[f]
        if body < 0:
            return
        self.reset()
        self.enter(self.new_block())
        let p = a.child[f]
        while p >= 0:
            if a.kind[p] == int(Nk.Param) || a.kind[p] == int(Nk.SelfParam):
                let v = self.add_var(a, a.tok[p], ty.node[p], true, p)
                if a.kind[p] == int(Nk.SelfParam):
                    self.v_param[v] = 2
                self.ev_add(int(Ev.Let), v, p, 0, 0, 0, 0)
            p = a.next[p]
        self.block(t, g, ty, a, body)
        self.leave_scopes(0)
        self.be[self.cur] = self.ne
        self.liveness()
        self.solve(a)
        for v in 0..self.nv:
            self.exit_of[self.v_node[v]] = self.v_exit[v]

fn new_flow(a: &Ast) => Flow:
    return Flow { ek: new_buf(int, 64), ev: new_buf(int, 64), en: new_buf(int, 64), ea: new_buf(int, 64), eb: new_buf(int, 64), ec: new_buf(int, 64), ed: new_buf(int, 64), ne: 0, bs: new_buf(int, 16), be: new_buf(int, 16), nb: 0, ef: new_buf(int, 16), et: new_buf(int, 16), nedge: 0, cur: -1, v_tok: new_buf(int, 16), v_ty: new_buf(int, 16), v_param: new_buf(int, 16), v_node: new_buf(int, 16), v_exit: new_buf(int, 16), nv: 0, sc: new_syms(), ss: new_buf(int, 16), sn: 0, lh: new_buf(int, 8), lx: new_buf(int, 8), ld: new_buf(int, 8), nl_loops: 0, pp: new_buf(int, 64), pn: 0, pt: new_buf(int, 16), plen: 0, pvar: -1, lroot: new_buf(int, 64), lps: new_buf(int, 64), lpl: new_buf(int, 64), lmut: new_buf(int, 64), lthru: new_buf(int, 64), nl: 0, s0: 0, target: -1, diags: new_odiags(), moved_at: new_buf(int, a.count + 1), exit_of: new_buf(int, a.count + 1), lv_start: new_buf(int, 1), lv_pos: new_buf(int, 1), lv_blk: new_buf(int, 1), lv_w: 1, reach: new_buf(int, 1), st_in: new_buf(int, 1), live_in: new_buf(int, 1), live_out: new_buf(int, 1), w: new_buf(int, 1) }

/#/ Checks every function and method of module `m` (tree `a`); `ty` is the typer's result for
/#/ it. Findings are in `diags`, implicit moves in `moved_at`.
fn check_own(t: &Tys, g: &Syms, a: &Ast, ty: &Typer) => Flow:
    let f = new_flow(a)
    let it = a.child[a.root]
    while it >= 0:
        let k = a.kind[it]
        if k == int(Nk.Fn):
            f.function(t, g, ty, a, it)
        elif k == int(Nk.Class):
            let c = a.child[it]
            while c >= 0:
                if a.kind[c] == int(Nk.Fn):
                    f.function(t, g, ty, a, c)
                c = a.next[c]
        it = a.next[it]
    return f

/#/ The double nearest to a decimal literal, rounded to even, for the cases the quick exact
/#/ conversion in `float_bits` cannot do (a long mantissa, a large or small exponent). The value is
/#/ m * 10^scale with m below 10^18, worked out on a bignum of 48 limbs of 28 bits.

fn dec_zero(a: &buf<int>) => void:
    for i in 0..48:
        a[i] = 0

fn dec_set(a: &buf<int>, v: int) => void:
    dec_zero(a)
    let w = v
    let i = 0
    while w > 0:
        a[i] = w % 268435456
        w = w // 268435456
        i += 1

fn dec_copy(d: &buf<int>, s: &buf<int>) => void:
    for i in 0..48:
        d[i] = s[i]

/#/ a = a * m, for 0 <= m <= 2^28
fn dec_mul(a: &buf<int>, m: int) => void:
    let carry = 0
    for i in 0..48:
        let t = a[i] * m + carry
        a[i] = t % 268435456
        carry = t // 268435456

/#/ a = a * 2^bits
fn dec_shl(a: &buf<int>, bits: int) => void:
    let left = bits
    while left > 0:
        let step = left
        if step > 27:
            step = 27
        let p = 1
        for z in 0..step:
            p = p * 2
        dec_mul(a, p)
        left -= step

/#/ -1, 0 or 1 as a is below, equal to or above b
fn dec_cmp(a: &buf<int>, b: &buf<int>) => int:
    let i = 47
    while i >= 0:
        if a[i] < b[i]:
            return -1
        if a[i] > b[i]:
            return 1
        i -= 1
    return 0

/#/ a = a - b, for a >= b
fn dec_sub(a: &buf<int>, b: &buf<int>) => void:
    let borrow = 0
    for i in 0..48:
        let t = a[i] - b[i] - borrow
        borrow = 0
        if t < 0:
            t += 268435456
            borrow = 1
        a[i] = t

/#/ The number of bits of a (0 for zero).
fn dec_bits(a: &buf<int>) => int:
    let i = 47
    while i >= 0 && a[i] == 0:
        i -= 1
    if i < 0:
        return 0
    let n = 0
    let w = a[i]
    while w > 0:
        w = w // 2
        n += 1
    return i * 28 + n

/#/ The bits of the double nearest to m * 10^scale (m > 0); -1 when it is too large or too long to do.
fn decimal_bits(m: int, scale: int) => int:
    if scale > 310:
        return -1
    if scale < -342:
        return 0
    let r: buf<int> = new_buf(int, 48)
    let d: buf<int> = new_buf(int, 48)
    let t: buf<int> = new_buf(int, 48)
    dec_set(&r, m)
    dec_set(&d, 1)
    if scale >= 0:
        for i in 0..scale:
            dec_mul(&r, 10)
    else:
        for i in 0..0 - scale:
            dec_mul(&d, 10)
    /#/ scale r / d into (2^55, 2^57): q = floor(r / d) then has 56 or 57 bits and value = q * 2^-k
    let k = 56 + dec_bits(&d) - dec_bits(&r)
    if k > 0:
        dec_shl(&r, k)
    else:
        dec_shl(&d, 0 - k)
    let q = 0
    let b = 56
    while b >= 0:
        dec_copy(&t, &d)
        dec_shl(&t, b)
        if dec_cmp(&t, &r) <= 0:
            dec_sub(&r, &t)
            q = q + (1 << b)
        b -= 1
    let sticky = dec_bits(&r) > 0
    let nb = 0
    let w = q
    while w > 0:
        w = w // 2
        nb += 1
    let e2 = 0 - k
    let ulp = e2 + nb - 53
    if ulp < 0 - 1074:
        ulp = 0 - 1074
    let shift = ulp - e2
    if shift > nb:
        return 0
    let mant = q >> shift
    let rem = q - (mant << shift)
    let half = 1 << (shift - 1)
    if rem > half || (rem == half && (sticky || mant % 2 == 1)):
        mant += 1
    if mant >= 9007199254740992:
        mant = mant // 2
        ulp += 1
    if ulp == 0 - 1074:
        return mant
    let biased = ulp + 52 + 1023
    if biased >= 2047:
        return -1
    return (biased << 52) | (mant - 4503599627370496)


/#/ The IR representation of a type; -1 when it has none yet.
fn rep_of(t: &Tys, g: &Syms, x: int) => int:
    let k = t.kind[x]
    if k == int(Ty.Void):
        return int(Rp.Void)
    if k == int(Ty.Bool):
        return int(Rp.I8)
    if k == int(Ty.Int):
        if t.a[x] == 1:
            return int(Rp.I8)
        if t.a[x] == 2:
            return int(Rp.I16)
        if t.a[x] == 4:
            return int(Rp.I32)
        if t.a[x] == 8:
            return int(Rp.I64)
        return -1
    if k == int(Ty.Float):
        if t.a[x] == 4:
            return int(Rp.F32)
        if t.a[x] == 8:
            return int(Rp.F64)
        return -1
    if k == int(Ty.Str) || k == int(Ty.Object) || k == int(Ty.Ref) || k == int(Ty.Fn):
        return int(Rp.Ptr)
    if k == int(Ty.Buf) && t.a[x] < 0:
        return int(Rp.Ptr)
    if k == int(Ty.Array):
        return int(Rp.Ptr)
    if k == int(Ty.Named):
        if g.kind[t.a[x]] == int(Sk.Class):
            return int(Rp.Ptr)
        if g.kind[t.a[x]] == int(Sk.Enum):
            if has_payload(t, g, t.a[x]):
                return int(Rp.Ptr)
            return int(Rp.I64)
    return -1

/#/ A function of the program named like one the generated code calls in the C library would take
/#/ its place; its symbol gets a suffix.
fn keep_off_runtime(w: &Txt) => void:
    let names = "malloc free calloc strlen strdup memcpy strcmp write exit open read close remove access chmod clock_gettime fork waitpid _exit execve fflush system"
    let lo = 0
    for i in 0..len(names) + 1:
        if i == len(names) || names[i] == ' ':
            if w.n == i - lo:
                let same = true
                for k in 0..w.n:
                    if w.b[k] != names[lo + k]:
                        same = false
                if same:
                    w.put("__cf")
                    return
            lo = i + 1

/#/ Is `x` an integer type that is signed?
fn is_signed(t: &Tys, x: int) => bool:
    return t.kind[x] == int(Ty.Int) && t.b[x] == 1

fn bytes_of_rep(r: int) => int:
    if r == int(Rp.I8):
        return 1
    if r == int(Rp.I16):
        return 2
    if r == int(Rp.I32) || r == int(Rp.F32):
        return 4
    return 8

/#/ The bits of the float literal at `tok`, as a double or (`single`) as a float; -1 when
/#/ the literal is not one this can convert exactly (more than 18 digits, an exponent out of range,
/#/ and for a `float(4)` a long mantissa or a large exponent).
fn float_bits(a: &Ast, tok: int, single: bool) => int:
    let s = a.toks.start[tok]
    let e = a.toks.end[tok]
    let m = 0
    let digits = 0
    let scale = 0
    let seen_dot = false
    let k = s
    while k < e:
        let c = a.byte_at(k)
        if c >= '0' && c <= '9':
            m = m * 10 + (c - '0')
            if m > 0:
                digits = digits + 1
            if seen_dot:
                scale = scale - 1
        elif c == '.':
            seen_dot = true
        elif c == 'e' || c == 'E':
            break
        elif c != '_':
            return -1
        k = k + 1
    if k < e:
        k = k + 1
        let neg = false
        if k < e && (a.byte_at(k) == '-' || a.byte_at(k) == '+'):
            neg = a.byte_at(k) == '-'
            k = k + 1
        let x = 0
        while k < e:
            x = x * 10 + (a.byte_at(k) - '0')
            k = k + 1
        if neg:
            x = 0 - x
        scale = scale + x
    while scale < 0 && m > 0 && m % 10 == 0:
        m = m // 10
        scale = scale + 1
    if digits > 18:
        return -1
    if m == 0:
        return 0
    if m > 9007199254740992 || scale > 22 || scale < -22:
        if single:
            return -1
        return decimal_bits(m, scale)
    let v = float(m)
    let p = 1.0
    let q = scale
    if q < 0:
        q = 0 - q
    for i in 0..q:
        p = p * 10.0
    if scale < 0:
        v = v / p
    else:
        v = v * p
    let ex = 0
    while v >= 2.0:
        v = v / 2.0
        ex = ex + 1
    while v < 1.0:
        v = v * 2.0
        ex = ex - 1
    if single:
        let frac = int((v - 1.0) * 8388608.0 + 0.5)
        if frac >= 8388608:
            frac = 0
            ex = ex + 1
        if ex < -126 || ex > 127:
            return -1
        return ((ex + 127) << 23) | frac
    if ex < -1022 || ex > 1023:
        return -1
    let frac = int((v - 1.0) * 4503599627370496.0)
    return ((ex + 1023) << 52) | frac

/#/ Does a value of type `x` own something that has to be released?
fn needs_drop(t: &Tys, g: &Syms, x: int) => bool:
    let k = t.kind[x]
    if k == int(Ty.Str) || k == int(Ty.Array):
        return true
    if k == int(Ty.Buf):
        return t.a[x] >= 0
    if k == int(Ty.Tuple):
        for i in 0..t.count_of(x):
            if needs_drop(t, g, t.arg(x, i)):
                return true
        return false
    if k == int(Ty.Named):
        if g.kind[t.a[x]] == int(Sk.Enum):
            return has_payload(t, g, t.a[x])
        return g.kind[t.a[x]] == int(Sk.Class)
    return false

/#/ Is `x` a class none of whose fields owns anything? Its drop is then only the free.
fn class_plain(t: &Tys, g: &Syms, x: int) => bool:
    if g.kind[t.a[x]] != int(Sk.Class):
        return false
    let cur = t.a[x]
    let n = 0
    while cur >= 0 && n < 8:
        for i in 0..g.n:
            if g.info[i] == cur && g.kind[i] == int(Sk.Field) && g.ty[i] >= 0:
                if needs_drop(t, g, subst_env(t, g.ty[i], x)):
                    return false
        n = n + 1
        let next = -1
        for i in 0..g.n:
            if g.info[i] == cur && g.kind[i] == int(Sk.Parent):
                next = g.find_class_row(i)
        cur = next
    return true

/#/ Is a value of type `x` moved, not copied, when it is used as a value? (Arrays are
/#/ copied: a copy is a new block.)
fn is_moved(t: &Tys, g: &Syms, x: int) => bool:
    return needs_drop(t, g, x) && t.kind[x] != int(Ty.Array)

/#/ The value of a hexadecimal digit, -1 for any other byte.
fn hex_val(c: int) => int:
    if c >= '0' && c <= '9':
        return c - '0'
    if c >= 'a' && c <= 'f':
        return c - 'a' + 10
    if c >= 'A' && c <= 'F':
        return c - 'A' + 10
    return 0 - 1

/#/ `--emit-ir`: the optimized IR of every function is printed before it is translated.
let ir_dump = false

/#/ With `--emit-lines` the line marks of the code made are put in `lines_txt` (see `lines_dump`).
let lines_on = false
let lines_txt = new_txt()
/#/ With `-g` the same table goes into the object, for the linker to make DWARF of.
let dbg_on = false

fn set_lines() => void:
    lines_on = true

fn set_debug() => void:
    dbg_on = true
    lines_on = true

/#/ The line marks of what is made from now on are not wanted (the runtime that is linked in).
fn no_lines() => void:
    dbg_on = false
    dbg_vars = false
    lines_on = false

fn set_ir_dump() => void:
    ir_dump = true

/#/ The verifier runs on every function unless the driver turned it off (`--verify` turns it back on).
let verify_on = true

fn set_verify(on: bool) => void:
    verify_on = on

class Lower:
    f: Fun
    rs: Reps
    names: Names
    nstr: int
    /#/ C functions called: name, signature type, variadic
    cd_name: buf<int>
    cd_sig: buf<int>
    cd_var: buf<int>
    cd_n: int
    /#/ variables
    sc: Syms
    v_rep: buf<int>
    v_ty: buf<int>
    nv: int
    /#/ the value of a variable at the end of a block, by (variable, block)
    dk: buf<int>
    dv: buf<int>
    dn: int
    /#/ blocks: sealed, the parameters waiting for their arguments, the edges that reach it
    sealed: buf<int>
    inc_head: buf<int>
    inc_var: buf<int>
    inc_par: buf<int>
    inc_next: buf<int>
    inc_n: int
    pe_head: buf<int>
    pe_next: buf<int>
    /#/ loops: where `continue` and `break` go
    lc: buf<int>
    lb: buf<int>
    nloops: int
    /#/ variables that live in a slot: its value, or -1; the names `&` is applied to
    v_slot: buf<int>
    /#/ `-O0 -g`: the variables kept in slots for the debug table: function (name number), type, slot,
    /#/ 1 for a parameter, and the name (at `dv_nm` in `dv_names`, NUL-ended)
    dv_fn: buf<int>
    dv_tid: buf<int>
    dv_slot: buf<int>
    dv_par: buf<int>
    dv_nm: buf<int>
    dv_names: Txt
    dv_n: int
    in_params: bool
    /#/ the variable holding 1 while a variable still owns its value, or -1
    v_flag: buf<int>
    /#/ owned temporaries that were only borrowed: released at the end of the statement
    tmp_v: buf<int>
    tmp_ty: buf<int>
    tmp_n: int
    no_own: int
    /#/ the owning variables in scope, innermost last
    own_st: buf<int>
    own_n: int
    /#/ the scope depth each loop was entered at
    ld: buf<int>
    /#/ drop and clone functions still to be generated: type, kind (0 drop, 1 clone)
    glue_ty: buf<int>
    glue_kind: buf<int>
    glue_n: int
    glue_done: int
    /#/ the fields of a class in layout order: type and offset
    lay_ty: buf<int>
    lay_off: buf<int>
    lay_n: int
    addr: Names
    scanned: int
    /#/ the type of the field or element the last lookup found
    fty: int
    /#/ names of what generated code calls
    rt_exit: int
    rt_calloc: int
    rt_strlen: int
    rt_malloc: int
    main_fn: bool
    rt_free: int
    rt_strdup: int
    rt_memcpy: int
    rt_strcmp: int
    rt_write: int
    /#/ while the later alternative of an or-pattern binds: the scope row where its names start
    or_mark: int
    /#/ 0: the function is emitted as lowered; above: the optimizer runs first
    opt: int
    /#/ 0: LLVM text, 1: x86-64 machine code in an object file
    mc: Gen
    sbytes: Txt
    mc_err: int
    ver_err: int
    /#/ the functions lowered so far, kept as IR until `finish`
    lib: Lib
    /#/ the name number of the function in `f`
    cur_id: int
    /#/ per class row of the globals: its chain of ancestors (`ch_len` + 1, 0 when not made yet; the
    /#/ classes are `ch_at[sym * 8 ..]`) and its field rows (`fl_len` + 1, `fl_from` into `fl_pool`);
    /#/ made again when the globals have grown (`fc_gn`)
    fc_gn: int
    ch_len: buf<int>
    ch_at: buf<int>
    fl_len: buf<int>
    fl_from: buf<int>
    fl_pool: buf<int>
    fl_n: int
    /#/ the type arguments the function being lowered is instantiated with, as `Name<A, B>`; -1 if none
    penv: int
    /#/ scratch: what `unify` found for each type parameter
    ue: buf<int>
    /#/ instances asked for and not lowered yet: function node, arguments, class row
    iq_node: buf<int>
    iq_env: buf<int>
    iq_cls: buf<int>
    /#/ the name an instance is lowered under, -1 for the one its node spells
    iq_nm: buf<int>
    iq_n: int
    iq_done: int
    /#/ the name of the listener of the function being lowered, -1 for none
    lis: int
    /#/ the functions declared in the body being lowered: name token, node, and the name they get
    nf_tok: buf<int>
    nf_node: buf<int>
    nf_id: buf<int>
    nf_n: int
    /#/ the name the function being lowered is given, -1 for the one its node spells
    pnm: int
    /#/ the block whose last expression is the value returned, the `match` whose arms' blocks are
    /#/ such blocks, and the expression statement to lower as a `return`; -1 for none
    tailb: int
    tailm: int
    retx: int
    /#/ the module-level `let`s: the symbol name and the size in bytes
    /#/ for a unit built apart: a suffix that keeps the names the compiler makes (glue, instances) from
    /#/ meeting those of another object; empty for a whole program
    tag: Txt
    /#/ the code calls the number-printing runtime (`__cf_fmt_int` and the others)
    uses_rt: bool
    /#/ the functions being lowered belong to another file: they are kept for inlining only
    ext_mode: bool
    ext_slot: buf<int>
    gl_name: buf<int>
    gl_size: buf<int>
    gl_n: int
    /#/ the return type of the function
    ret_ty: int
    bad: int
    bad_node: int

    /#/ The type of node `n`, with the type parameters of the instance being lowered replaced.
    fn nd(self, t: &Tys, ty: &Typer, n: int) => int:
        return subst_env(t, ty.node[n], self.penv)

    /#/ `base` with `__N` for the instance arguments `env`.
    fn inst_name(self, base: &Txt, env: int) => int:
        let w = new_txt()
        w.put_all(base)
        w.put("__")
        w.put_int(env)
        w.put_all(&self.tag)
        return self.names.intern(&w)

    /#/ Asks for the function node `node` (of class row `cls`, -1 for a free function) to be
    /#/ lowered with the arguments `env`.
    fn want_instance(self, node: int, env: int, cls: int) => void:
        for i in 0..self.iq_n:
            if self.iq_node[i] == node && self.iq_env[i] == env && self.iq_cls[i] == cls:
                return
        if self.iq_n >= len(self.iq_node):
            let cap = (self.iq_n + 1) * 2
            self.iq_node = buf_resize(self.iq_node, cap)
            self.iq_env = buf_resize(self.iq_env, cap)
            self.iq_cls = buf_resize(self.iq_cls, cap)
            self.iq_nm = buf_resize(self.iq_nm, cap)
        self.iq_node[self.iq_n] = node
        self.iq_env[self.iq_n] = env
        self.iq_cls[self.iq_n] = cls
        self.iq_nm[self.iq_n] = -1
        self.iq_n = self.iq_n + 1

    /#/ Asks for the function node `node`, declared inside a body, to be lowered as name `nm`.
    fn want_named(self, node: int, nm: int) => void:
        self.want_instance(node, -1, -1)
        self.iq_nm[self.iq_n - 1] = nm

    /#/ Lowers the instances asked for, and those they ask for in turn; their text goes to `o`.
    fn run_instances(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, o: &Txt) => void:
        while self.iq_done < self.iq_n:
            let i = self.iq_done
            self.iq_done = i + 1
            self.penv = self.iq_env[i]
            self.pnm = self.iq_nm[i]
            self.function(t, g, ty, a, self.iq_node[i], self.iq_cls[i])
            self.penv = -1
            self.pnm = -1
            if self.bad > 0:
                return
            self.keep_current()

    /#/ The function node of the top-level function named by token `tok` of `a`, -1 if none.
    fn fn_node_of(self, a: &Ast, tok: int) => int:
        let it = a.child[a.root]
        while it >= 0:
            if a.kind[it] == int(Nk.Fn) && a.pa[it] == tok:
                return it
            it = a.next[it]
        return -1

    /#/ The method node named like token `tok` in the class node of class row `row`, -1 if none.
    fn method_node_of(self, g: &Syms, a: &Ast, row: int, tok: int) => int:
        let it = a.child[a.root]
        while it >= 0:
            if a.kind[it] == int(Nk.Class) && a.pa[it] >= 0 && g.tok[row] == a.pa[it]:
                let m = a.child[it]
                while m >= 0:
                    if a.kind[m] == int(Nk.Fn) && a.pa[m] >= 0 && same_text(a, a.pa[m], tok):
                        return m
                    m = a.next[m]
            it = a.next[it]
        return -1

    /#/ Binds the type parameters in `p` (a type of a generic signature) to what they stand for
    /#/ in `x`, into `env`.
    fn unify(self, t: &Tys, p: int, x: int) => void:
        if p < 0 || x < 0:
            return
        let k = t.kind[p]
        if k == int(Ty.Param):
            if t.a[p] < len(self.ue) && self.ue[t.a[p]] < 0:
                self.ue[t.a[p]] = x
            return
        if t.kind[x] != k:
            return
        if k == int(Ty.Ref) || k == int(Ty.Slice) || k == int(Ty.Array) || (k == int(Ty.Buf) && t.a[p] >= 0 && t.a[x] >= 0):
            self.unify(t, t.a[p], t.a[x])
            return
        if k == int(Ty.Tuple) || k == int(Ty.Fn) || k == int(Ty.Named):
            if t.count_of(p) != t.count_of(x):
                return
            for i in 0..t.count_of(p):
                self.unify(t, t.arg(p, i), t.arg(x, i))

    fn unsupported(self, n: int) => void:
        if self.bad == 0:
            self.bad_node = n
        self.bad = self.bad + 1

    /#/ ---- blocks and edges ----------------------------------------------------

    fn new_block(self) => int:
        let b = self.f.new_block()
        if b >= len(self.sealed):
            let cap = (b + 1) * 2
            self.sealed = buf_resize(self.sealed, cap)
            self.inc_head = buf_resize(self.inc_head, cap)
            self.pe_head = buf_resize(self.pe_head, cap)
        self.sealed[b] = 0
        self.inc_head[b] = -1
        self.pe_head[b] = -1
        return b

    /#/ Remembers that edge `e` reaches `target`.
    fn note_edge(self, e: int, target: int) => void:
        if e >= len(self.pe_next):
            self.pe_next = buf_resize(self.pe_next, (e + 1) * 2)
        self.pe_next[e] = self.pe_head[target]
        self.pe_head[target] = e

    /#/ Ends the current block with a jump.
    fn jump(self, target: int) => void:
        if self.f.terminated(self.f.cur):
            return
        let t = self.f.br(target)
        self.note_edge(self.f.aux[t], target)

    fn branch(self, cond: int, yes: int, no: int) => void:
        if self.f.terminated(self.f.cur):
            return
        let e1 = self.f.mk_edge(yes)
        let e2 = self.f.mk_edge(no)
        self.note_edge(e1, yes)
        self.note_edge(e2, no)
        self.f.condbr(cond, e1, e2)

    /#/ Moves on to a block nothing reaches: the code after a `return` or `break`.
    fn dead_block(self) => void:
        let b = self.new_block()
        self.sealed[b] = 1
        self.f.set_block(b)

    /#/ ---- variables -----------------------------------------------------------

    fn d_find(self, v: int, b: int) => int:
        let key = v * 4194304 + b + 1
        let m = len(self.dk) - 1
        let h = (key * 40503) & m
        while self.dk[h] != 0:
            if self.dk[h] == key:
                return self.dv[h]
            h = (h + 1) & m
        return -1

    fn d_set(self, v: int, b: int, val: int) => void:
        if (self.dn + 1) * 2 > len(self.dk):
            let cap = len(self.dk) * 2
            let nk: buf<int> = new_buf(int, cap)
            let nv: buf<int> = new_buf(int, cap)
            for i in 0..cap:
                nk[i] = 0
            for i in 0..len(self.dk):
                let key = self.dk[i]
                if key != 0:
                    let h = (key * 40503) & (cap - 1)
                    while nk[h] != 0:
                        h = (h + 1) & (cap - 1)
                    nk[h] = key
                    nv[h] = self.dv[i]
            self.dk = nk
            self.dv = nv
        let key = v * 4194304 + b + 1
        self.d_put(key, val)

    fn d_put(self, key: int, val: int) => void:
        let m = len(self.dk) - 1
        let h = (key * 40503) & m
        while self.dk[h] != 0 && self.dk[h] != key:
            h = (h + 1) & m
        if self.dk[h] == 0:
            self.dn = self.dn + 1
        self.dk[h] = key
        self.dv[h] = val

    fn write_var(self, v: int, b: int, val: int) => void:
        self.d_set(v, b, val)

    fn read_var(self, v: int, b: int) => int:
        let x = self.d_find(v, b)
        if x >= 0:
            return self.f.follow(x)
        return self.read_rec(v, b)

    fn read_rec(self, v: int, b: int) => int:
        let rep = self.v_rep[v]
        if self.sealed[b] == 0:
            let p = self.f.param(b, rep, -1)
            if self.inc_n >= len(self.inc_var):
                let cap = (self.inc_n + 1) * 2
                self.inc_var = buf_resize(self.inc_var, cap)
                self.inc_par = buf_resize(self.inc_par, cap)
                self.inc_next = buf_resize(self.inc_next, cap)
            /#/ kept in creation order: a list with a tail would do; the lists are short
            self.inc_var[self.inc_n] = v
            self.inc_par[self.inc_n] = p
            self.inc_next[self.inc_n] = -1
            let last = self.inc_head[b]
            if last < 0:
                self.inc_head[b] = self.inc_n
            else:
                while self.inc_next[last] >= 0:
                    last = self.inc_next[last]
                self.inc_next[last] = self.inc_n
            self.inc_n = self.inc_n + 1
            self.write_var(v, b, p)
            return p
        let n = 0
        let only = -1
        let e = self.pe_head[b]
        while e >= 0:
            if self.f.eto[e] == b:
                n = n + 1
                only = e
            e = self.pe_next[e]
        let val = -1
        if n == 0:
            val = self.f.undef(rep)
        elif n == 1:
            val = self.read_var(v, self.f.efrom[only])
        else:
            let p = self.f.param(b, rep, -1)
            self.write_var(v, b, p)
            self.fill(v, b)
            val = p
        self.write_var(v, b, val)
        return val

    /#/ Passes the value of `v` along every edge into `b`, for the parameter just made.
    fn fill(self, v: int, b: int) => void:
        /#/ the edges in the order they were made
        let es: buf<int> = new_buf(int, 8)
        let n = 0
        let e = self.pe_head[b]
        while e >= 0:
            if self.f.eto[e] == b:
                if n >= len(es):
                    es = buf_resize(es, n * 2)
                es[n] = e
                n = n + 1
            e = self.pe_next[e]
        let k = n - 1
        while k >= 0:
            let x = self.read_var(v, self.f.efrom[es[k]])
            edge_push(&self.f, es[k], x)
            k = k - 1

    /#/ All the edges into `b` exist now.
    fn seal(self, b: int) => void:
        let i = self.inc_head[b]
        while i >= 0:
            self.fill(self.inc_var[i], b)
            i = self.inc_next[i]
        self.inc_head[b] = -1
        self.sealed[b] = 1

    fn new_var(self, a: &Ast, tok: int, rep: int, ty: int) => int:
        if self.nv >= len(self.v_rep):
            self.v_rep = buf_resize(self.v_rep, (self.nv + 1) * 2)
            self.v_ty = buf_resize(self.v_ty, (self.nv + 1) * 2)
            self.v_slot = buf_resize(self.v_slot, (self.nv + 1) * 2)
            self.v_flag = buf_resize(self.v_flag, (self.nv + 1) * 2)
        let id = self.nv
        self.v_rep[id] = rep
        self.v_ty[id] = ty
        self.v_slot[id] = -1
        self.v_flag[id] = -1
        self.nv = id + 1
        if tok >= 0:
            self.sc.add_tok(a, tok, int(Sk.Local), id, 0)
        return id

    /#/ ---- conversions ---------------------------------------------------------

    /#/ `x`, of type `from`, as a value of type `to`.
    fn coerce(self, t: &Tys, g: &Syms, x: int, from: int, to: int) => int:
        if t.kind[to] == int(Ty.Slice) && t.kind[from] == int(Ty.Array):
            /#/ an array lent as a slice: its address and its length
            let sl = self.f.insert(self.f.undef(self.rep(t, g, to)), x, 0)
            return self.f.insert(sl, self.f.cint(int(Rp.I64), t.b[from]), 1)
        if t.kind[to] == int(Ty.Slice) && t.kind[from] == int(Ty.Ref) && t.kind[t.a[from]] == int(Ty.Buf) && t.a[t.a[from]] >= 0:
            /#/ a buffer lent as a slice: the buffer's own pointer and length
            return self.f.load(self.rep(t, g, to), -1, x)
        return self.coerce_rep(t, x, from, self.rep(t, g, to), to)

    fn coerce_rep(self, t: &Tys, x: int, from: int, tr: int, to: int) => int:
        let fr = self.f.rep[x]
        if fr == tr || tr < 0:
            return x
        let ti = rp_is_int(tr)
        let fi = rp_is_int(fr)
        if t.kind[to] == int(Ty.Bool):
            if fi:
                return self.f.cmp(int(Pr.Ne), x, self.f.cint(fr, 0))
            if rp_is_float(fr):
                return self.f.fcmp(int(Pr.ONe), x, self.f.cfloat(fr, 0))
            return x
        if fi && ti:
            if rp_bits(tr) > rp_bits(fr):
                if is_signed(t, from):
                    return self.f.conv(int(Op.SExt), tr, x)
                return self.f.conv(int(Op.ZExt), tr, x)
            return self.f.conv(int(Op.Trunc), tr, x)
        if fi && rp_is_float(tr):
            if is_signed(t, from):
                return self.f.conv(int(Op.SiToFp), tr, x)
            return self.f.conv(int(Op.UiToFp), tr, x)
        if rp_is_float(fr) && ti:
            if is_signed(t, to):
                return self.f.conv(int(Op.FpToSi), tr, x)
            return self.f.conv(int(Op.FpToUi), tr, x)
        if rp_is_float(fr) && rp_is_float(tr):
            if tr == int(Rp.F64) && fr == int(Rp.F32):
                return self.f.conv(int(Op.FpExt), tr, x)
            return self.f.conv(int(Op.FpTrunc), tr, x)
        if fr == int(Rp.Ptr) && ti:
            return self.f.conv(int(Op.PtrToInt), tr, x)
        if fi && tr == int(Rp.Ptr):
            return self.f.conv(int(Op.IntToPtr), tr, x)
        return x

    /#/ ---- expressions ---------------------------------------------------------

    /#/ The bytes of string literal token `tok`, escapes resolved.
    fn str_text(self, a: &Ast, tok: int) => Txt:
        return self.str_range(a, a.toks.start[tok] + 1, a.toks.end[tok] - 1)

    /#/ The bytes `s`..`e` of the source read as the inside of a string literal.
    fn str_range(self, a: &Ast, s: int, e: int) => Txt:
        return self.str_range_f(a, s, e, false)

    /#/ Like `str_range`; in the text of an f-string (`fstr`) `{{` and `}}` are one brace.
    fn str_range_f(self, a: &Ast, s: int, e: int, fstr: bool) => Txt:
        let body = new_txt()
        let k = s
        while k < e:
            let c = a.byte_at(k)
            if fstr && (c == '{' || c == '}') && k + 1 < e && a.byte_at(k + 1) == c:
                k = k + 1
            if c == '\\' && k + 1 < e:
                k = k + 1
                let d = a.byte_at(k)
                if d == 'n':
                    c = 10
                elif d == 't':
                    c = 9
                elif d == 'r':
                    c = 13
                elif d == '0':
                    c = 0
                elif d == 'x' && k + 2 < e && hex_val(a.byte_at(k + 1)) >= 0 && hex_val(a.byte_at(k + 2)) >= 0:
                    c = hex_val(a.byte_at(k + 1)) * 16 + hex_val(a.byte_at(k + 2))
                    k = k + 2
                else:
                    c = d
            body.put_byte(c)
            k = k + 1
        return body

    /#/ Appends the bytes of string literal `tok` to `o`.
    fn put_text(self, o: &Txt, a: &Ast, tok: int) => void:
        let body = self.str_text(a, tok)
        o.put_all(&body)

    fn text_global(self, body: &Txt) => int:
        let id = self.nstr
        self.nstr = id + 1
        /#/ the length of the text comes first, as in every string
        for i in 0..8:
            self.sbytes.put_byte((body.n >> (8 * i)) & 255)
        self.mc.add_str(self.sbytes.n)
        self.sbytes.put_all(body)
        self.sbytes.put_byte(0)
        return id

    fn str_lit(self, a: &Ast, tok: int) => int:
        let body = self.str_text(a, tok)
        return self.text_global(&body)

    fn binary(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let op = op_of(a.pc[n])
        let l = a.pa[n]
        let r = a.pb[n]
        if op == int(Bop.And) || op == int(Bop.Or):
            return self.logic(t, g, ty, a, n, op == int(Bop.And))
        let lt = self.nd(t, ty, l)
        let rt = self.nd(t, ty, r)
        if t.kind[self.strip_refs(t, lt)] == int(Ty.Str) && t.kind[self.strip_refs(t, rt)] == int(Ty.Str):
            return self.str_op(t, g, ty, a, n, op)
        if self.rep(t, g, lt) < 0 || self.rep(t, g, rt) < 0 || t.kind[lt] == int(Ty.Str) || t.kind[rt] == int(Ty.Str):
            self.unsupported(n)
            return self.f.undef(int(Rp.I8))
        let x = self.ex(t, g, ty, a, l)
        let y = self.ex(t, g, ty, a, r)
        if op >= int(Bop.Eq) && op <= int(Bop.Ge):
            return self.compare(t, g, op, x, y, lt, rt)
        let res = self.nd(t, ty, n)
        let rr = self.rep(t, g, res)
        if rr < 0 || t.kind[res] == int(Ty.Object):
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let is_flt = rp_is_float(rr)
        if op == int(Bop.Shl) || op == int(Bop.Shr):
            let amount = self.coerce(t, g, y, rt, res)
            let v = self.coerce(t, g, x, lt, res)
            if op == int(Bop.Shl):
                return self.f.bin(int(Op.Shl), v, amount)
            if is_signed(t, res):
                return self.f.bin(int(Op.AShr), v, amount)
            return self.f.bin(int(Op.LShr), v, amount)
        let v = self.coerce(t, g, x, lt, res)
        let w = self.coerce(t, g, y, rt, res)
        let sg = is_signed(t, res)
        if op == int(Bop.Add):
            if is_flt:
                return self.f.bin(int(Op.FAdd), v, w)
            return self.f.bin(int(Op.Add), v, w)
        if op == int(Bop.Sub):
            if is_flt:
                return self.f.bin(int(Op.FSub), v, w)
            return self.f.bin(int(Op.Sub), v, w)
        if op == int(Bop.Mul):
            if is_flt:
                return self.f.bin(int(Op.FMul), v, w)
            return self.f.bin(int(Op.Mul), v, w)
        if op == int(Bop.Div):
            return self.f.bin(int(Op.FDiv), v, w)
        if op == int(Bop.IDiv):
            if sg:
                return self.f.bin(int(Op.SDiv), v, w)
            return self.f.bin(int(Op.UDiv), v, w)
        if op == int(Bop.Rem):
            if is_flt:
                return self.f.bin(int(Op.FRem), v, w)
            if sg:
                return self.f.bin(int(Op.SRem), v, w)
            return self.f.bin(int(Op.URem), v, w)
        if op == int(Bop.BitAnd):
            return self.f.bin(int(Op.And), v, w)
        if op == int(Bop.BitOr):
            return self.f.bin(int(Op.Or), v, w)
        return self.f.bin(int(Op.Xor), v, w)

    /#/ A comparison of two values of types `lt` and `rt`, as a `bool`.
    /#/ `a + b` of strings makes a new string; `==` and `!=` compare the text.
    fn str_op(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int, op: int) => int:
        let x = self.exb(t, g, ty, a, a.pa[n])
        let y = self.exb(t, g, ty, a, a.pb[n])
        if op == int(Bop.Eq) || op == int(Bop.Ne):
            self.f.arg(x)
            self.f.arg(y)
            let c = self.f.ccall(int(Rp.I32), 2, self.rt_strcmp, 0)
            let p = int(Pr.Eq)
            if op == int(Bop.Ne):
                p = int(Pr.Ne)
            return self.f.cmp(p, c, self.f.cint(int(Rp.I32), 0))
        if op != int(Bop.Add):
            self.unsupported(n)
            return self.f.undef(int(Rp.Ptr))
        return self.str_cat(x, y)

    /#/ The length of the string `p`: the word before its text.
    fn str_len_of(self, p: int) => int:
        return self.f.load(int(Rp.I64), -1, self.f.index(p, self.f.cint(int(Rp.I64), -8), 1))

    /#/ A new string of `n` bytes of text: the length is set, the text is for the caller to fill
    /#/ (and to end with a zero byte).
    fn str_new(self, n: int) => int:
        self.f.arg(self.f.bin(int(Op.Add), n, self.f.cint(int(Rp.I64), 9)))
        let b = self.f.ccall(int(Rp.Ptr), 1, self.rt_malloc, 0)
        self.f.store(b, n)
        return self.f.index(b, self.f.cint(int(Rp.I64), 8), 1)

    /#/ A new string with the text of `x`.
    fn str_dup(self, x: int) => int:
        return self.str_copy(x, self.str_len_of(x))

    /#/ A new string with the text of a C string, which has no length of its own.
    fn str_from_c(self, x: int) => int:
        self.f.arg(x)
        return self.str_copy(x, self.f.ccall(int(Rp.I64), 1, self.rt_strlen, 0))

    fn str_copy(self, x: int, n: int) => int:
        let p = self.str_new(n)
        self.f.arg(p)
        self.f.arg(x)
        self.f.arg(self.f.bin(int(Op.Add), n, self.f.cint(int(Rp.I64), 1)))
        self.f.ccall(int(Rp.Ptr), 3, self.rt_memcpy, 0)
        return p

    /#/ Releases the string `x`; a null string (an element of a new buffer) is left alone.
    fn str_free(self, x: int) => void:
        if self.f.terminated(self.f.cur):
            return
        let yes = self.new_block()
        let join = self.new_block()
        self.branch(self.f.cmp(int(Pr.Ne), self.f.conv(int(Op.PtrToInt), int(Rp.I64), x), self.f.cint(int(Rp.I64), 0)), yes, join)
        self.seal(yes)
        self.f.set_block(yes)
        self.f.free(self.f.index(x, self.f.cint(int(Rp.I64), -8), 1))
        self.jump(join)
        self.seal(join)
        self.f.set_block(join)

    /#/ A new string: the text of `x` and then the text of `y`.
    fn str_cat(self, x: int, y: int) => int:
        let lx = self.str_len_of(x)
        let ly = self.str_len_of(y)
        let p = self.str_new(self.f.bin(int(Op.Add), lx, ly))
        self.f.arg(p)
        self.f.arg(x)
        self.f.arg(lx)
        self.f.ccall(int(Rp.Ptr), 3, self.rt_memcpy, 0)
        self.f.arg(self.f.index(p, lx, 1))
        self.f.arg(y)
        self.f.arg(self.f.bin(int(Op.Add), ly, self.f.cint(int(Rp.I64), 1)))
        self.f.ccall(int(Rp.Ptr), 3, self.rt_memcpy, 0)
        return p

    /#/ `f"text {expr} text"`: the text pieces and the expressions, each as text, joined. A string
    /#/ expression is only read; an int or float is printed by the runtime into a fresh string.
    fn fstr(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let tk = a.tok[n]
        let from = a.toks.start[tk] + 2
        let e = a.toks.end[tk] - 1
        let empty = new_txt()
        let acc = self.f.strlit(self.text_global(&empty))
        let owned = false
        let p = a.child[n]
        while p >= 0:
            if a.pb[p] > from:
                let body = self.str_range_f(a, from, a.pb[p], true)
                let nx = self.str_cat(acc, self.f.strlit(self.text_global(&body)))
                if owned:
                    self.str_free(acc)
                acc = nx
                owned = true
            let x = a.pa[p]
            let xt = self.strip_refs(t, self.nd(t, ty, x))
            let sp = fspec_of(a, p)
            let fresh = -1
            let v = -1
            if t.kind[xt] == int(Ty.Str):
                v = self.exb(t, g, ty, a, x)
            elif t.kind[xt] == int(Ty.Bool):
                /#/ two strings, each with its own length word: the address is picked by arithmetic
                let no = new_txt()
                no.put("false")
                let yes = new_txt()
                yes.put("true")
                let na = self.f.conv(int(Op.PtrToInt), int(Rp.I64), self.f.strlit(self.text_global(&no)))
                let ya = self.f.conv(int(Op.PtrToInt), int(Rp.I64), self.f.strlit(self.text_global(&yes)))
                let flag = self.f.conv(int(Op.ZExt), int(Rp.I64), self.ex(t, g, ty, a, x))
                let sum = self.f.bin(int(Op.Add), na, self.f.bin(int(Op.Mul), flag, self.f.bin(int(Op.Sub), ya, na)))
                v = self.f.conv(int(Op.IntToPtr), int(Rp.Ptr), sum)
            elif t.kind[xt] == int(Ty.Int) || t.kind[xt] == int(Ty.Float):
                /#/ the text comes from the runtime in rt/src/fmt.cf, which the driver adds to the program
                let num = self.ex(t, g, ty, a, x)
                let rt = new_txt()
                if t.kind[xt] == int(Ty.Int):
                    num = self.coerce(t, g, num, self.nd(t, ty, x), t.int_ty(8, true))
                    if sp.kind == 'x' || sp.kind == 'X' || sp.kind == 'b' || sp.kind == 'o':
                        rt.put("__cf_fmt_radix")
                        let radix = 16
                        if sp.kind == 'b':
                            radix = 2
                        if sp.kind == 'o':
                            radix = 8
                        let upper = 0
                        if sp.kind == 'X':
                            upper = 1
                        self.f.arg(num)
                        self.f.arg(self.f.cint(int(Rp.I64), radix))
                        self.f.arg(self.f.cint(int(Rp.I64), upper))
                    else:
                        rt.put("__cf_fmt_int")
                        self.f.arg(num)
                else:
                    num = self.coerce(t, g, num, self.nd(t, ty, x), t.float_ty(8))
                    if sp.prec >= 0 || sp.kind == 'f':
                        rt.put("__cf_fmt_fixed")
                        let digits = sp.prec
                        if digits < 0:
                            digits = 6
                        self.f.arg(num)
                        self.f.arg(self.f.cint(int(Rp.I64), digits))
                    else:
                        rt.put("__cf_fmt_float")
                        self.f.arg(num)
                self.uses_rt = true
                fresh = self.f.call(int(Rp.Ptr), -1, self.names.intern(&rt))
                v = fresh
            else:
                self.unsupported(n)
                return acc
            if sp.width > 0:
                let numeric = t.kind[xt] == int(Ty.Int) || t.kind[xt] == int(Ty.Float)
                let rt = new_txt()
                self.f.arg(v)
                if sp.zero && sp.align == 0 && numeric:
                    rt.put("__cf_pad_zero")
                    self.f.arg(self.f.cint(int(Rp.I64), sp.width))
                else:
                    rt.put("__cf_pad")
                    self.f.arg(self.f.cint(int(Rp.I64), sp.width))
                    let al = sp.align
                    if al == 0:
                        al = 1
                        if numeric:
                            al = 2
                    self.f.arg(self.f.cint(int(Rp.I64), al))
                    let fl = sp.fill
                    if sp.zero && sp.align != 0:
                        fl = 48
                    self.f.arg(self.f.cint(int(Rp.I64), fl))
                self.uses_rt = true
                let padded = self.f.call(int(Rp.Ptr), -1, self.names.intern(&rt))
                if fresh >= 0:
                    self.str_free(fresh)
                fresh = padded
                v = padded
            let nx = self.str_cat(acc, v)
            if owned:
                self.str_free(acc)
            acc = nx
            owned = true
            if fresh >= 0:
                self.str_free(fresh)
            from = a.pc[p] + 1
            p = a.next[p]
        if e > from:
            let body = self.str_range_f(a, from, e, true)
            let nx = self.str_cat(acc, self.f.strlit(self.text_global(&body)))
            if owned:
                self.str_free(acc)
            acc = nx
            owned = true
        if !owned:
            acc = self.str_cat(acc, self.f.strlit(self.text_global(&empty)))
        return acc

    fn compare(self, t: &Tys, g: &Syms, op: int, x: int, y: int, lt: int, rt: int) => int:
        let fx = self.f.rep[x]
        let fy = self.f.rep[y]
        let wide = lt
        if rp_is_float(fy) && !rp_is_float(fx):
            wide = rt
        elif bytes_of_rep(fy) > bytes_of_rep(fx) && rp_is_float(fx) == rp_is_float(fy):
            wide = rt
        let v = self.coerce(t, g, x, lt, wide)
        let w = self.coerce(t, g, y, rt, wide)
        let wr = self.rep(t, g, wide)
        if rp_is_float(wr):
            let p = int(Pr.OEq)
            if op == int(Bop.Ne):
                p = int(Pr.ONe)
            elif op == int(Bop.Lt):
                p = int(Pr.OLt)
            elif op == int(Bop.Le):
                p = int(Pr.OLe)
            elif op == int(Bop.Gt):
                p = int(Pr.OGt)
            elif op == int(Bop.Ge):
                p = int(Pr.OGe)
            return self.f.fcmp(p, v, w)
        let sg = is_signed(t, wide)
        let p = int(Pr.Eq)
        if op == int(Bop.Ne):
            p = int(Pr.Ne)
        elif op == int(Bop.Lt):
            p = int(Pr.SLt)
            if !sg:
                p = int(Pr.ULt)
        elif op == int(Bop.Le):
            p = int(Pr.SLe)
            if !sg:
                p = int(Pr.ULe)
        elif op == int(Bop.Gt):
            p = int(Pr.SGt)
            if !sg:
                p = int(Pr.UGt)
        elif op == int(Bop.Ge):
            p = int(Pr.SGe)
            if !sg:
                p = int(Pr.UGe)
        return self.f.cmp(p, v, w)

    /#/ `l && r` and `l || r`: the right side runs only when the left does not decide. The
    /#/ result is a variable written on both paths and read where they meet.
    fn logic(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int, is_and: bool) => int:
        let res = self.new_var(a, -1, int(Rp.I8), -1)
        let l = self.ex(t, g, ty, a, a.pa[n])
        let rhs = self.new_block()
        let join = self.new_block()
        self.write_var(res, self.f.cur, self.f.cint(int(Rp.I8), 0))
        if !is_and:
            self.write_var(res, self.f.cur, self.f.cint(int(Rp.I8), 1))
        if is_and:
            self.branch(l, rhs, join)
        else:
            self.branch(l, join, rhs)
        self.seal(rhs)
        self.f.set_block(rhs)
        /#/ the temporaries of the right side exist only on this path: they are released here, not at the
        /#/ end of the statement where the paths have met
        let mark = self.tmp_n
        let r = self.ex(t, g, ty, a, a.pb[n])
        if self.reachable():
            let q = self.tmp_n - 1
            while q >= mark:
                self.drop_value(t, g, self.tmp_v[q], self.tmp_ty[q])
                q = q - 1
        self.tmp_n = mark
        self.write_var(res, self.f.cur, r)
        self.jump(join)
        self.seal(join)
        self.f.set_block(join)
        return self.read_var(res, join)

    /#/ The slot of the function declared in this body that token `tok` names, -1 if none.
    fn nested_find(self, a: &Ast, tok: int) => int:
        let i = self.nf_n
        while i > 0:
            i = i - 1
            if same_text(a, self.nf_tok[i], tok):
                return i
        return -1

    /#/ Declares the function node `n` in this body; it is lowered as `outer__name`.
    fn nested_declare(self, a: &Ast, n: int) => void:
        let w = new_txt()
        self.names.put(&w, self.cur_id)
        w.put("__")
        for q in a.toks.start[a.pa[n]]..a.toks.end[a.pa[n]]:
            w.put_byte(a.byte_at(q))
        let id = self.names.intern(&w)
        if self.nf_n >= len(self.nf_tok):
            let cap = (self.nf_n + 1) * 2
            self.nf_tok = buf_resize(self.nf_tok, cap)
            self.nf_node = buf_resize(self.nf_node, cap)
            self.nf_id = buf_resize(self.nf_id, cap)
        self.nf_tok[self.nf_n] = a.pa[n]
        self.nf_node[self.nf_n] = n
        self.nf_id[self.nf_n] = id
        self.nf_n = self.nf_n + 1
        self.want_named(n, id)

    /#/ Lets a function declared in a body call itself by its name.
    fn nested_declare_self(self, a: &Ast, n: int) => void:
        if a.pa[n] < 0:
            return
        self.nf_tok[0] = a.pa[n]
        self.nf_node[0] = n
        self.nf_id[0] = self.pnm
        self.nf_n = 1

    /#/ The row of the module-level `let` that token `tok` names, -1 if none.
    fn global_row(self, g: &Syms, ty: &Typer, a: &Ast, tok: int) => int:
        let r = g.find_in_module(a, tok, ty.cur)
        if r >= 0 && g.kind[r] == int(Sk.Global):
            return r
        return -1

    /#/ The symbol of the module-level `let` named by token `tok`.
    fn global_sym(self, a: &Ast, tok: int) => int:
        let w = new_txt()
        w.put("coffee_g_")
        for q in a.toks.start[tok]..a.toks.end[tok]:
            w.put_byte(a.byte_at(q))
        return self.names.intern(&w)

    /#/ Makes the module-level `let`s exist and gives them their values; this opens `main`.
    fn init_globals(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast) => void:
        let it = a.child[a.root]
        while it >= 0:
            if a.kind[it] == int(Nk.Let) && a.pa[it] >= 0:
                let vt = self.nd(t, ty, it)
                let vr = self.rep(t, g, vt)
                if vr < 0 || vr == int(Rp.Void) || a.pc[it] < 0:
                    self.unsupported(it)
                    return
                let id = self.global_sym(a, a.pa[it])
                if self.gl_n >= len(self.gl_name):
                    let cap = (self.gl_n + 1) * 2
                    self.gl_name = buf_resize(self.gl_name, cap)
                    self.gl_size = buf_resize(self.gl_size, cap)
                self.gl_name[self.gl_n] = id
                self.gl_size[self.gl_n] = rsize(&self.rs, vr)
                self.gl_n = self.gl_n + 1
                let val = self.sink(t, g, ty, a, a.pc[it], vt)
                self.f.store(self.f.fnaddr(id), val)
            it = a.next[it]

    /#/ For a text with no `main` (a runtime linked into other programs): its module-level `let`s
    /#/ exist, zero, in this object; nothing stores their initial values.
    fn declare_globals(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast) => void:
        let it = a.child[a.root]
        while it >= 0:
            if a.kind[it] == int(Nk.Let) && a.pa[it] >= 0:
                let vr = self.rep(t, g, self.nd(t, ty, it))
                if vr > 0:
                    if self.gl_n >= len(self.gl_name):
                        let cap = (self.gl_n + 1) * 2
                        self.gl_name = buf_resize(self.gl_name, cap)
                        self.gl_size = buf_resize(self.gl_size, cap)
                    self.gl_name[self.gl_n] = self.global_sym(a, a.pa[it])
                    self.gl_size[self.gl_n] = rsize(&self.rs, vr)
                    self.gl_n = self.gl_n + 1
            it = a.next[it]

    /#/ The address of the anonymous function `n`; it is lowered as `outer__fnN`.
    fn anon_fn(self, a: &Ast, n: int) => int:
        let w = new_txt()
        self.names.put(&w, self.cur_id)
        w.put("__fn")
        w.put_int(n)
        let id = self.names.intern(&w)
        self.want_named(n, id)
        return self.f.fnaddr(id)

    /#/ A call through the variable `lv` that holds a function.
    fn call_indirect(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int, lv: int) => int:
        let sig = self.v_ty[lv]
        let rr = self.rep(t, g, t.c[sig])
        if rr < 0:
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let fv = self.var_read(lv)
        let vals: buf<int> = new_buf(int, 8)
        let i = 0
        let c = a.child[n]
        while c >= 0:
            if i >= len(vals):
                vals = buf_resize(vals, i * 2)
            let at = self.nd(t, ty, c)
            let v = self.ex(t, g, ty, a, c)
            if i < t.count_of(sig):
                v = self.coerce(t, g, v, at, t.arg(sig, i))
                if t.kind[t.arg(sig, i)] != int(Ty.Ref) && !(t.kind[t.arg(sig, i)] == int(Ty.Slice) && t.kind[at] == int(Ty.Array)):
                    v = self.consume(t, g, a, c, v, at)
            vals[i] = v
            i = i + 1
            c = a.next[c]
        for j in 0..i:
            self.f.arg(vals[j])
        return self.f.calli(rr, -1, fv)

    /#/ A call of the function declared in this body at slot `slot`.
    fn call_nested(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int, slot: int) => int:
        let sig = ty.rd.fn_sig(t, a, self.nf_node[slot], -1)
        let rr = self.rep(t, g, t.c[sig])
        if rr < 0:
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let vals: buf<int> = new_buf(int, 8)
        let i = 0
        let c = a.child[n]
        while c >= 0:
            if i >= len(vals):
                vals = buf_resize(vals, i * 2)
            let at = self.nd(t, ty, c)
            let v = self.ex(t, g, ty, a, c)
            if i < t.count_of(sig):
                v = self.coerce(t, g, v, at, t.arg(sig, i))
                if t.kind[t.arg(sig, i)] != int(Ty.Ref) && !(t.kind[t.arg(sig, i)] == int(Ty.Slice) && t.kind[at] == int(Ty.Array)):
                    v = self.consume(t, g, a, c, v, at)
            vals[i] = v
            i = i + 1
            c = a.next[c]
        for j in 0..i:
            self.f.arg(vals[j])
        return self.f.call(rr, -1, self.nf_id[slot])

    fn call(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let callee = a.pa[n]
        let res = self.nd(t, ty, n)
        if callee >= 0 && a.kind[callee] == int(Nk.Member):
            if self.enum_row(ty, a, a.pa[callee]) >= 0:
                return self.variant(t, g, ty, a, callee, n)
            return self.member_call(t, g, ty, a, n)
        if callee < 0 || a.kind[callee] != int(Nk.Name):
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let lv = self.lookup(a, a.tok[callee])
        if lv >= 0 && t.kind[self.v_ty[lv]] == int(Ty.Fn):
            return self.call_indirect(t, g, ty, a, n, lv)
        let nfi = self.nested_find(a, a.tok[callee])
        if nfi >= 0:
            return self.call_nested(t, g, ty, a, n, nfi)
        let r = ty.lookup(a, a.tok[callee])
        if r < 0:
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let k = ty.rd.sc.loc.kind[r]
        if k == int(Sk.Builtin):
            if tok_is(a, a.tok[callee], "len"):
                return self.len_call(t, g, ty, a, n)
            if tok_is(a, a.tok[callee], "sizeof"):
                /#/ the bytes a value of the named type takes; for a class, its block
                let sx = ty.rd.named_ty(t, a, a.tok[a.child[n]])
                let sz = st_block(t, g, sx)
                if sz < 0:
                    sz = st_size(t, g, sx)
                return self.f.cint(int(Rp.I64), sz)
            if tok_is(a, a.tok[callee], "new_buf"):
                return self.new_buf_call(t, g, ty, a, n)
            if tok_is(a, a.tok[callee], "buf_resize"):
                return self.buf_resize_call(t, g, ty, a, n)
            if tok_is(a, a.tok[callee], "wrapping_add") || tok_is(a, a.tok[callee], "wrapping_sub") || tok_is(a, a.tok[callee], "wrapping_mul"):
                /#/ arithmetic here never traps, so the wrapping forms are the plain operations
                let l = a.child[n]
                if l < 0 || a.next[l] < 0 || self.rep(t, g, res) < 0:
                    self.unsupported(n)
                    return self.f.undef(int(Rp.I64))
                let r2 = a.next[l]
                let wl = self.coerce(t, g, self.ex(t, g, ty, a, l), self.nd(t, ty, l), res)
                let wr = self.coerce(t, g, self.ex(t, g, ty, a, r2), self.nd(t, ty, r2), res)
                let op = int(Op.Mul)
                if tok_is(a, a.tok[callee], "wrapping_add"):
                    op = int(Op.Add)
                elif tok_is(a, a.tok[callee], "wrapping_sub"):
                    op = int(Op.Sub)
                return self.f.bin(op, wl, wr)
            if tok_is(a, a.tok[callee], "peek8") || tok_is(a, a.tok[callee], "peek64"):
                let addr = self.ex(t, g, ty, a, a.child[n])
                if tok_is(a, a.tok[callee], "peek8"):
                    return self.f.conv(int(Op.ZExt), int(Rp.I64), self.f.load(int(Rp.I8), -1, addr))
                return self.f.load(int(Rp.I64), -1, addr)
            if tok_is(a, a.tok[callee], "poke8") || tok_is(a, a.tok[callee], "poke64"):
                let addr = self.ex(t, g, ty, a, a.child[n])
                let val = self.coerce(t, g, self.ex(t, g, ty, a, a.next[a.child[n]]), self.nd(t, ty, a.next[a.child[n]]), t.int_ty(8, true))
                if tok_is(a, a.tok[callee], "poke8"):
                    val = self.f.conv(int(Op.Trunc), int(Rp.I8), val)
                self.f.store(addr, val)
                return self.f.undef(int(Rp.I64))
            if tok_is(a, a.tok[callee], "str_alloc"):
                let len = self.coerce(t, g, self.ex(t, g, ty, a, a.child[n]), self.nd(t, ty, a.child[n]), t.int_ty(8, true))
                let sp = self.str_new(len)
                self.f.store(self.f.index(sp, len, 1), self.f.cint(int(Rp.I8), 0))
                return sp
            if tok_is(a, a.tok[callee], "str_put"):
                let sv = a.child[n]
                let iv = a.next[sv]
                let cv = a.next[iv]
                let sp = self.exb(t, g, ty, a, sv)
                let ix = self.coerce(t, g, self.ex(t, g, ty, a, iv), self.nd(t, ty, iv), t.int_ty(8, true))
                let ch = self.coerce(t, g, self.ex(t, g, ty, a, cv), self.nd(t, ty, cv), t.int_ty(8, true))
                self.f.store(self.f.index(sp, ix, 1), self.f.conv(int(Op.Trunc), int(Rp.I8), ch))
                return self.f.undef(int(Rp.I64))
            if tok_is(a, a.tok[callee], "call_addr"):
                /#/ `call_addr(addr, args..)` calls the code at `addr` the way one of our functions is called
                let ca = a.child[n]
                let target = self.coerce(t, g, self.ex(t, g, ty, a, ca), self.nd(t, ty, ca), t.int_ty(8, true))
                let cvals: buf<int> = new_buf(int, 8)
                let cn = 0
                ca = a.next[ca]
                while ca >= 0 && cn < 6:
                    cvals[cn] = self.coerce(t, g, self.ex(t, g, ty, a, ca), self.nd(t, ty, ca), t.int_ty(8, true))
                    cn = cn + 1
                    ca = a.next[ca]
                for j in 0..cn:
                    self.f.arg(cvals[j])
                return self.f.calli(int(Rp.I64), -1, target)
            if tok_is(a, a.tok[callee], "syscall"):
                /#/ `cf_syscall(n, a, b, c, d, e, f)` is supplied by the linker
                let sc = a.child[n]
                let vals: buf<int> = new_buf(int, 8)
                for j in 0..7:
                    if sc < 0:
                        vals[j] = self.f.cint(int(Rp.I64), 0)
                    else:
                        vals[j] = self.coerce(t, g, self.ex(t, g, ty, a, sc), self.nd(t, ty, sc), t.int_ty(8, true))
                        sc = a.next[sc]
                for j in 0..7:
                    self.f.arg(vals[j])
                let w = new_txt()
                w.put("cf_syscall")
                return self.f.ccall(int(Rp.I64), 7, self.names.intern(&w), 0)
            if tok_is(a, a.tok[callee], "buf_ptr"):
                /#/ the buffer is only borrowed: reading it as a value would move it into a temporary
                /#/ that is freed at the end of the statement
                let arg = a.child[n]
                let v = self.exb(t, g, ty, a, arg)
                let at = self.strip_refs(t, self.nd(t, ty, arg))
                if t.kind[at] == int(Ty.Buf) || t.kind[at] == int(Ty.Slice):
                    return self.f.extract(int(Rp.Ptr), v, 0)
                return v
            return self.cast_call(t, g, ty, a, n)
        if k != int(Sk.Fn) && k != int(Sk.Extern):
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let sig = ty.rd.sc.loc.ty[r]
        if sig < 0 || t.kind[sig] != int(Ty.Fn):
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let variadic = 0
        if k == int(Sk.Extern) && ty.rd.sc.loc.info[r] == 1:
            variadic = 1
        let inst_env = -1
        let fnode = -1
        if k == int(Sk.Fn):
            fnode = self.fn_node_of(a, ty.rd.sc.loc.tok[r])
            if fnode >= 0 && type_param_count(a, fnode) > 0:
                inst_env = self.infer_env(t, ty, a, n, sig, type_param_count(a, fnode))
                if inst_env < 0:
                    self.unsupported(n)
                    return self.f.undef(int(Rp.I64))
                sig = subst_env(t, sig, inst_env)
        let fixed = t.count_of(sig)
        if variadic == 1:
            fixed = fixed - 1
        let ret = t.c[sig]
        let rr = self.rep(t, g, ret)
        if rr < 0:
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let vals: buf<int> = new_buf(int, 8)
        let i = 0
        let c = a.child[n]
        while c >= 0:
            if i >= len(vals):
                vals = buf_resize(vals, i * 2)
            let at = self.nd(t, ty, c)
            let v = -1
            if k == int(Sk.Extern):
                v = self.exb(t, g, ty, a, c)
            else:
                v = self.ex(t, g, ty, a, c)
            if i < fixed:
                v = self.coerce(t, g, v, at, t.arg(sig, i))
                if t.kind[t.arg(sig, i)] != int(Ty.Ref) && !(t.kind[t.arg(sig, i)] == int(Ty.Slice) && t.kind[at] == int(Ty.Array)) && k != int(Sk.Extern):
                    v = self.consume(t, g, a, c, v, at)
            vals[i] = v
            i = i + 1
            c = a.next[c]
        for j in 0..i:
            self.f.arg(vals[j])
        let name = new_txt()
        for q in a.toks.start[a.tok[callee]]..a.toks.end[a.tok[callee]]:
            name.put_byte(a.byte_at(q))
        if k != int(Sk.Extern) && inst_env < 0 && !(fnode >= 0 && a.pd[fnode] == 1):
            keep_off_runtime(&name)
        let id = self.names.intern(&name)
        if inst_env >= 0:
            id = self.inst_name(&name, inst_env)
            self.want_instance(fnode, inst_env, -1)
        if k == int(Sk.Extern):
            self.note_c(id, sig, variadic)
            return self.f.ccall(rr, fixed, id, variadic)
        return self.f.call(rr, -1, id)

    /#/ The arguments the type parameters of the generic function called by `n` (of signature
    /#/ `sig`) stand for, as `Name<A, B>`; -1 when a parameter is not fixed by the call.
    fn infer_env(self, t: &Tys, ty: &Typer, a: &Ast, n: int, sig: int, count: int) => int:
        for i in 0..16:
            self.ue[i] = -1
        let c = a.child[n]
        let i = 0
        while c >= 0 && i < t.count_of(sig):
            self.unify(t, t.arg(sig, i), self.nd(t, ty, c))
            i = i + 1
            c = a.next[c]
        self.unify(t, t.c[sig], self.nd(t, ty, n))
        for k in 0..count:
            if self.ue[k] < 0:
                return -1
        let start = t.args_n
        for k in 0..count:
            t.push_arg(self.ue[k])
        return t.intern(int(Ty.Named), 0, 0, count, start)

    fn note_c(self, id: int, sig: int, variadic: int) => void:
        if id == self.rt_exit || id == self.rt_calloc || id == self.rt_strlen || id == self.rt_malloc || id == self.rt_free || id == self.rt_strdup || id == self.rt_memcpy || id == self.rt_strcmp || id == self.rt_write:
            return
        for i in 0..self.cd_n:
            if self.cd_name[i] == id:
                return
        if self.cd_n >= len(self.cd_name):
            let cap = (self.cd_n + 1) * 2
            self.cd_name = buf_resize(self.cd_name, cap)
            self.cd_sig = buf_resize(self.cd_sig, cap)
            self.cd_var = buf_resize(self.cd_var, cap)
        self.cd_name[self.cd_n] = id
        self.cd_sig[self.cd_n] = sig
        self.cd_var[self.cd_n] = variadic
        self.cd_n = self.cd_n + 1

    /#/ `int(x)`, `float(x)`, `bool(x)`, `u8(x)`: the sized casts.
    fn cast_call(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let first = a.child[n]
        let res = self.nd(t, ty, n)
        if first < 0 || a.next[first] >= 0 || self.rep(t, g, res) < 0 || self.rep(t, g, self.nd(t, ty, first)) < 0 || t.kind[res] == int(Ty.Str):
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let x = self.ex(t, g, ty, a, first)
        return self.coerce(t, g, x, self.nd(t, ty, first), res)

    fn ex(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let k = a.kind[n]
        let x = self.nd(t, ty, n)
        let r = self.rep(t, g, x)
        if k == int(Nk.Int) && t.kind[x] == int(Ty.Object):
            /#/ `0` as an `object`: the null pointer
            return self.f.cint(int(Rp.Ptr), 0)
        if k == int(Nk.Int) || k == int(Nk.Char):
            if r < 0 || r == int(Rp.Ptr):
                self.unsupported(n)
                return self.f.undef(int(Rp.I64))
            if k == int(Nk.Char):
                return self.f.cint(r, char_value(a, a.tok[n]))
            return self.f.cint(r, lit_digits(a, a.tok[n]))
        if k == int(Nk.Float):
            if r != int(Rp.F64) && r != int(Rp.F32):
                self.unsupported(n)
                return self.f.undef(int(Rp.F64))
            let bits = float_bits(a, a.tok[n], r == int(Rp.F32))
            if bits < 0:
                self.unsupported(n)
                return self.f.undef(r)
            return self.f.cfloat(r, bits)
        if k == int(Nk.Bool):
            let v = 0
            if a.byte_at(a.toks.start[a.tok[n]]) == 't':
                v = 1
            return self.f.cint(int(Rp.I8), v)
        if k == int(Nk.Str):
            let lit = self.f.strlit(self.str_lit(a, a.tok[n]))
            if t.kind[x] == int(Ty.Str):
                return self.str_dup(lit)
            return lit
        if k == int(Nk.Fn) && a.pa[n] < 0:
            return self.anon_fn(a, n)
        if k == int(Nk.FStr):
            return self.fstr(t, g, ty, a, n)
        if k == int(Nk.Name):
            let v = self.lookup(a, a.tok[n])
            if v < 0:
                if self.global_row(g, ty, a, a.tok[n]) >= 0 && r >= 0:
                    return self.f.load(r, -1, self.f.fnaddr(self.global_sym(a, a.tok[n])))
                self.unsupported(n)
                return self.f.undef(int(Rp.I64))
            return self.var_read(v)
        if k == int(Nk.Binary):
            return self.binary(t, g, ty, a, n)
        if k == int(Nk.Unary):
            return self.unary(t, g, ty, a, n)
        if k == int(Nk.Call):
            return self.call(t, g, ty, a, n)
        if k == int(Nk.Cast):
            let v = self.ex(t, g, ty, a, a.pa[n])
            if self.rep(t, g, self.nd(t, ty, a.pa[n])) < 0 || r < 0:
                self.unsupported(n)
                return v
            if t.kind[x] == int(Ty.Str) && t.kind[self.strip_refs(t, self.nd(t, ty, a.pa[n]))] == int(Ty.Object):
                /#/ a C string has no length word: the cast makes a string of its own
                return self.str_from_c(v)
            return self.coerce(t, g, v, self.nd(t, ty, a.pa[n]), x)
        if k == int(Nk.Member):
            return self.member(t, g, ty, a, n)
        if k == int(Nk.Index):
            if a.pb[n] >= 0 && a.kind[a.pb[n]] == int(Nk.Range):
                return self.slice_range(t, g, ty, a, n)
            if t.kind[self.strip_refs(t, self.nd(t, ty, a.pa[n]))] == int(Ty.Str):
                return self.str_byte(t, g, ty, a, n)
            let p = self.element_addr(t, g, ty, a, n)
            return self.f.load(self.rep(t, g, self.fty), -1, p)
        if k == int(Nk.StructLit):
            return self.struct_lit(t, g, ty, a, n)
        if k == int(Nk.Tuple):
            return self.tuple_lit(t, g, ty, a, n)
        if k == int(Nk.Array):
            return self.array_lit(t, g, ty, a, n)
        self.unsupported(n)
        return self.f.undef(int(Rp.I64))

    fn lookup(self, a: &Ast, tok: int) => int:
        let r = self.sc.find_tok(a, tok, 0)
        if r >= 0 && self.sc.kind[r] == int(Sk.Local):
            return self.sc.info[r]
        return -1

    fn unary(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let k = a.pc[n]
        let o = a.pa[n]
        let x = self.nd(t, ty, o)
        if k == int(Tk.Amp):
            return self.borrow(t, g, ty, a, n)
        if k == int(Tk.KwClone) || k == int(Tk.KwMv):
            let res = self.nd(t, ty, n)
            if self.rep(t, g, res) < 0:
                self.unsupported(n)
                return self.f.undef(int(Rp.I64))
            let v = self.ex(t, g, ty, a, o)
            if k == int(Tk.KwClone):
                if needs_drop(t, g, res):
                    return self.clone_value(t, g, v, res)
                return v
            return self.consume(t, g, a, o, v, res)
        if k == int(Tk.Star):
            if t.kind[x] != int(Ty.Ref):
                self.unsupported(n)
                return self.f.undef(int(Rp.I64))
            let target = t.a[x]
            let p = self.ex(t, g, ty, a, o)
            if is_handle(t, g, target):
                return p
            let r = self.rep(t, g, target)
            if r < 0:
                self.unsupported(n)
                return p
            return self.f.load(r, -1, p)
        if self.rep(t, g, x) < 0 || t.kind[x] == int(Ty.Ref):
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let v = self.ex(t, g, ty, a, o)
        if k == int(Tk.Minus):
            let res = self.nd(t, ty, n)
            v = self.coerce(t, g, v, x, res)
            if t.kind[res] == int(Ty.Float):
                return self.f.raw(int(Op.FNeg), self.f.rep[v], -1, v, -1, -1, 0)
            return self.f.neg(v)
        if k == int(Tk.Bang):
            return self.f.bin(int(Op.Xor), v, self.f.cint(int(Rp.I8), 1))
        if k == int(Tk.Tilde):
            return self.f.bnot(v)
        self.unsupported(n)
        return v

    /#/ `&x` and `&mut x`: the handle itself for a handle type, else the address of the slot.
    fn borrow(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let o = a.pa[n]
        let x = self.nd(t, ty, o)
        if is_handle(t, g, x):
            return self.exb(t, g, ty, a, o)
        if a.kind[o] == int(Nk.Name):
            let v = self.lookup(a, a.tok[o])
            if v >= 0 && self.v_slot[v] >= 0:
                return self.v_slot[v]
            if v < 0 && self.global_row(g, ty, a, a.tok[o]) >= 0 && self.rep(t, g, x) >= 0:
                return self.f.fnaddr(self.global_sym(a, a.tok[o]))
        if a.kind[o] == int(Nk.Member) && t.kind[self.strip_refs(t, self.nd(t, ty, a.pa[o]))] == int(Ty.Named) && self.rep(t, g, x) >= 0:
            return self.field_addr(t, g, ty, a, o)
        if a.kind[o] == int(Nk.Index) && self.rep(t, g, x) >= 0:
            return self.element_addr(t, g, ty, a, o)
        self.unsupported(n)
        return self.f.undef(int(Rp.Ptr))

    /#/ ---- statements ----------------------------------------------------------

    fn block(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, b: int) => void:
        let mark = self.sc.n
        let own_mark = self.own_n
        let c = a.child[b]
        let is_tail = b == self.tailb
        while c >= 0:
            if is_tail && a.next[c] < 0:
                if a.kind[c] == int(Nk.ExprStmt) && a.pa[c] >= 0 && t.kind[self.ret_ty] != int(Ty.Void) && t.kind[self.nd(t, ty, a.pa[c])] != int(Ty.Void):
                    self.retx = c
                elif a.kind[c] == int(Nk.Match):
                    self.tailm = c
            self.stmt(t, g, ty, a, c)
            c = a.next[c]
        if !self.f.terminated(self.f.cur):
            self.drop_scope(t, g, a, own_mark)
        self.own_n = own_mark
        self.sc.truncate(mark)

    fn stmt(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        if a.tok[n] >= 0:
            self.f.line = a.toks.line[a.tok[n]]
        self.stmt_inner(t, g, ty, a, n)
        self.flush_temps(t, g)

    fn stmt_inner(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        let k = a.kind[n]
        if k == int(Nk.ExprStmt) && self.retx == n:
            k = int(Nk.Return)
            self.retx = -1
        if k == int(Nk.Let):
            let vt = self.nd(t, ty, n)
            let vr = self.rep(t, g, vt)
            if vr < 0 || vr == int(Rp.Void):
                self.unsupported(n)
                return
            let val = -1
            if a.pc[n] >= 0:
                val = self.sink(t, g, ty, a, a.pc[n], vt)
            else:
                val = self.f.undef(vr)
            self.bind_var(t, g, a, a.pa[n], vt, val)
        elif k == int(Nk.Assign):
            self.assign(t, g, ty, a, n)
        elif k == int(Nk.ExprStmt):
            let e = a.pa[n]
            let v = self.ex(t, g, ty, a, e)
            let et = self.nd(t, ty, e)
            if needs_drop(t, g, et) && (a.kind[e] == int(Nk.Call) || a.kind[e] == int(Nk.StructLit) || a.kind[e] == int(Nk.Unary)):
                self.drop_value(t, g, v, et)
        elif k == int(Nk.Return):
            if a.pa[n] >= 0 && t.kind[self.ret_ty] != int(Ty.Void):
                let v = self.sink(t, g, ty, a, a.pa[n], self.ret_ty)
                self.flush_temps(t, g)
                self.drop_scope(t, g, a, 0)
                self.f.ret_v(v)
            else:
                if a.pa[n] >= 0:
                    self.ex(t, g, ty, a, a.pa[n])
                self.drop_scope(t, g, a, 0)
                self.ret_unit()
            self.dead_block()
        elif k == int(Nk.Raise):
            self.raise_stmt(t, g, ty, a, n)
        elif k == int(Nk.Match):
            self.match_stmt(t, g, ty, a, n)
        elif k == int(Nk.Rm):
            self.rm_stmt(t, g, ty, a, a.pa[n])
            let extra = a.child[n]
            while extra >= 0:
                self.rm_stmt(t, g, ty, a, extra)
                extra = a.next[extra]
        elif k == int(Nk.Mv):
            self.mv_stmt(t, g, ty, a, n)
        elif k == int(Nk.If):
            self.if_stmt(t, g, ty, a, n)
        elif k == int(Nk.While):
            self.while_stmt(t, g, ty, a, n)
        elif k == int(Nk.For):
            self.for_stmt(t, g, ty, a, n)
        elif k == int(Nk.Break) || k == int(Nk.Continue):
            if self.nloops == 0:
                self.unsupported(n)
                return
            self.drop_scope(t, g, a, self.ld[self.nloops - 1])
            if k == int(Nk.Break):
                self.jump(self.lb[self.nloops - 1])
            else:
                self.jump(self.lc[self.nloops - 1])
            self.dead_block()
        elif k == int(Nk.Fn) && a.pa[n] >= 0:
            self.nested_declare(a, n)
        elif k == int(Nk.Class) && type_param_count(a, n) == 0:
            let row = g.find_in_module(a, a.pa[n], ty.cur)
            if row < 0:
                self.unsupported(n)
                return
            let m = a.child[n]
            while m >= 0:
                if a.kind[m] == int(Nk.Fn):
                    self.want_instance(m, -1, row)
                m = a.next[m]
        else:
            self.unsupported(n)

    fn assign(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        let target = a.pa[n]
        let tk = a.kind[target]
        if tk == int(Nk.Name):
            let v = self.lookup(a, a.tok[target])
            if v < 0 && self.global_row(g, ty, a, a.tok[target]) >= 0:
                let gt = self.nd(t, ty, target)
                if self.rep(t, g, gt) < 0:
                    self.unsupported(n)
                    return
                let gv = self.sink(t, g, ty, a, a.pb[n], gt)
                let slot = self.f.fnaddr(self.global_sym(a, a.tok[target]))
                /#/ what the global owned is released once the new value is known
                if needs_drop(t, g, gt):
                    self.drop_value(t, g, self.f.load(self.rep(t, g, gt), -1, slot), gt)
                self.f.store(slot, gv)
                return
            if v < 0:
                self.unsupported(n)
                return
            let val = self.sink(t, g, ty, a, a.pb[n], self.v_ty[v])
            /#/ what the variable owned is released once the new value is known
            self.drop_var(t, g, a, v)
            self.var_write(v, val)
            if self.v_flag[v] >= 0:
                self.write_var(self.v_flag[v], self.f.cur, self.f.cint(int(Rp.I8), 1))
        elif tk == int(Nk.Member) || tk == int(Nk.Index) || (tk == int(Nk.Unary) && a.pc[target] == int(Tk.Star)):
            let tt = self.nd(t, ty, target)
            if self.rep(t, g, tt) < 0:
                self.unsupported(n)
                return
            let val = self.sink(t, g, ty, a, a.pb[n], tt)
            let p = -1
            if tk == int(Nk.Member):
                p = self.field_addr(t, g, ty, a, target)
            elif tk == int(Nk.Index):
                p = self.element_addr(t, g, ty, a, target)
            else:
                p = self.ex(t, g, ty, a, a.pa[target])
            if needs_drop(t, g, tt):
                let old = self.f.load(self.rep(t, g, tt), -1, p)
                if tk == int(Nk.Index) && self.rep(t, g, tt) == int(Rp.Ptr):
                    /#/ the elements of a new buffer are zero: nothing to release in them yet
                    let yes = self.new_block()
                    let join = self.new_block()
                    self.branch(self.f.cmp(int(Pr.Ne), old, self.f.cint(int(Rp.Ptr), 0)), yes, join)
                    self.seal(yes)
                    self.f.set_block(yes)
                    self.drop_value(t, g, old, tt)
                    self.jump(join)
                    self.seal(join)
                    self.f.set_block(join)
                else:
                    self.drop_value(t, g, old, tt)
            self.f.store(p, val)
        else:
            self.unsupported(n)

    /#/ The value of `n` for a place that wants type `to` and takes ownership of it.
    fn sink(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int, to: int) => int:
        let from = self.nd(t, ty, n)
        let v = self.coerce(t, g, self.ex(t, g, ty, a, n), from, to)
        if t.kind[to] == int(Ty.Slice) && t.kind[from] == int(Ty.Array):
            /#/ lent, not copied: the array stays with its owner
            return v
        return self.consume(t, g, a, n, v, from)

    fn rm_stmt(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, e: int) => void:
        if e < 0:
            return
        if a.kind[e] != int(Nk.Name):
            self.unsupported(e)
            return
        let v = self.lookup(a, a.tok[e])
        if v < 0:
            self.unsupported(e)
            return
        self.drop_var(t, g, a, v)

    /#/ `mv a b` and `clone a b`: a new variable `b` made from `a`.
    fn mv_stmt(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        let src = a.pa[n]
        let x = self.nd(t, ty, n)
        if src < 0 || a.kind[src] != int(Nk.Name) || self.rep(t, g, x) < 0 || a.pb[n] < 0:
            self.unsupported(n)
            return
        let v = self.ex(t, g, ty, a, src)
        if a.pc[n] == 1:
            v = self.clone_value(t, g, v, x)
        else:
            v = self.consume(t, g, a, src, v, x)
        self.bind_var(t, g, a, a.pb[n], x, v)

    /#/ Branches to `yes` or `no` on the condition `n`: `&&`, `||` and `!` become jumps, not a value that
    /#/ is made and then tested.
    fn cond_jump(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int, yes: int, no: int) => void:
        let k = a.kind[n]
        if k == int(Nk.Binary):
            let op = op_of(a.pc[n])
            if op == int(Bop.And) || op == int(Bop.Or):
                let mid = self.new_block()
                if op == int(Bop.And):
                    self.cond_jump(t, g, ty, a, a.pa[n], mid, no)
                else:
                    self.cond_jump(t, g, ty, a, a.pa[n], yes, mid)
                self.seal(mid)
                self.f.set_block(mid)
                self.cond_jump(t, g, ty, a, a.pb[n], yes, no)
                return
        if k == int(Nk.Unary) && a.pc[n] == int(Tk.Bang):
            self.cond_jump(t, g, ty, a, a.pa[n], no, yes)
            return
        /#/ the temporaries of this test live only on the path that made them
        let mark = self.tmp_n
        let c = self.ex(t, g, ty, a, n)
        if self.reachable():
            let q = self.tmp_n - 1
            while q >= mark:
                self.drop_value(t, g, self.tmp_v[q], self.tmp_ty[q])
                q = q - 1
        self.tmp_n = mark
        self.branch(c, yes, no)

    fn if_stmt(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        let yes = self.new_block()
        let no = self.new_block()
        let join = self.new_block()
        self.cond_jump(t, g, ty, a, a.pa[n], yes, no)
        self.flush_temps(t, g)
        self.seal(yes)
        self.seal(no)
        self.f.set_block(yes)
        self.block(t, g, ty, a, a.pb[n])
        self.jump(join)
        self.f.set_block(no)
        let e = a.pc[n]
        if e >= 0:
            if a.kind[e] == int(Nk.If):
                self.if_stmt(t, g, ty, a, e)
            else:
                self.block(t, g, ty, a, e)
        self.jump(join)
        self.seal(join)
        self.f.set_block(join)

    fn push_loop(self, cont: int, brk: int) => void:
        if self.nloops >= len(self.lc):
            self.lc = buf_resize(self.lc, (self.nloops + 1) * 2)
            self.lb = buf_resize(self.lb, (self.nloops + 1) * 2)
            self.ld = buf_resize(self.ld, (self.nloops + 1) * 2)
        self.ld[self.nloops] = self.own_n
        self.lc[self.nloops] = cont
        self.lb[self.nloops] = brk
        self.nloops = self.nloops + 1

    fn while_stmt(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        let head = self.new_block()
        let body = self.new_block()
        let exit = self.new_block()
        self.jump(head)
        self.f.set_block(head)
        self.cond_jump(t, g, ty, a, a.pa[n], body, exit)
        self.flush_temps(t, g)
        self.seal(body)
        self.f.set_block(body)
        self.push_loop(head, exit)
        self.block(t, g, ty, a, a.pb[n])
        self.nloops = self.nloops - 1
        self.jump(head)
        self.seal(head)
        self.seal(exit)
        self.f.set_block(exit)

    /#/ `for i in a..b`: a counter that runs from `a` to `b - 1`; `i` is its value each time.
    fn for_stmt(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        let it = a.pb[n]
        if a.pa[n] < 0:
            self.unsupported(n)
            return
        let vt = self.nd(t, ty, n)
        let vr = self.rep(t, g, vt)
        if vr < 0 || vr == int(Rp.Void):
            self.unsupported(n)
            return
        let lo = -1
        let hi = -1
        let data = -1
        let cr = vr
        let ct = vt
        /#/ `range(a, b)` and `range(b)` are the same as `a..b`
        let rlo = -1
        let rhi = -1
        let is_range = false
        if a.kind[it] == int(Nk.Range):
            rlo = a.pa[it]
            rhi = a.pb[it]
            is_range = true
        elif a.kind[it] == int(Nk.Call) && a.pa[it] >= 0 && a.kind[a.pa[it]] == int(Nk.Name) && tok_is(a, a.tok[a.pa[it]], "range"):
            let c0 = a.child[it]
            if c0 >= 0 && a.next[c0] >= 0 && a.next[a.next[c0]] < 0:
                rlo = c0
                rhi = a.next[c0]
                is_range = true
            elif c0 >= 0 && a.next[c0] < 0:
                rhi = c0
                is_range = true
        if is_range:
            if !rp_is_int(vr):
                self.unsupported(n)
                return
            if rlo >= 0:
                lo = self.coerce(t, g, self.ex(t, g, ty, a, rlo), self.nd(t, ty, rlo), vt)
            else:
                lo = self.f.cint(vr, 0)
            hi = self.coerce(t, g, self.ex(t, g, ty, a, rhi), self.nd(t, ty, rhi), vt)
        elif t.kind[self.strip_refs(t, self.nd(t, ty, it))] == int(Ty.Tuple):
            self.for_tuple(t, g, ty, a, n, vt, vr)
            return
        else:
            /#/ the elements of an array, buffer or slice, taken one by one (copies only)
            let ot = self.strip_refs(t, self.nd(t, ty, it))
            let k = t.kind[ot]
            if !(k == int(Ty.Array) || (k == int(Ty.Buf) && t.a[ot] >= 0) || k == int(Ty.Slice)) || needs_drop(t, g, vt):
                self.unsupported(n)
                return
            cr = int(Rp.I64)
            ct = t.int_ty(8, true)
            lo = self.f.cint(cr, 0)
            if k == int(Ty.Array):
                data = self.exb(t, g, ty, a, it)
                hi = self.f.cint(cr, t.b[ot])
            else:
                let agg = self.agg_of(t, g, ty, a, it)
                data = self.f.extract(int(Rp.Ptr), agg, 0)
                hi = self.f.extract(cr, agg, 1)
        let counter = self.new_var(a, -1, cr, ct)
        self.write_var(counter, self.f.cur, lo)
        let head = self.new_block()
        let body = self.new_block()
        let latch = self.new_block()
        let exit = self.new_block()
        self.jump(head)
        self.f.set_block(head)
        let i = self.read_var(counter, head)
        let lt = int(Pr.SLt)
        if !is_signed(t, ct):
            lt = int(Pr.ULt)
        self.branch(self.f.cmp(lt, i, hi), body, exit)
        self.seal(body)
        self.f.set_block(body)
        let mark = self.sc.n
        let cv = self.read_var(counter, body)
        if data >= 0:
            cv = self.f.load(vr, -1, self.f.index(data, cv, st_size(t, g, vt)))
        self.bind_var(t, g, a, a.pa[n], vt, cv)
        self.push_loop(latch, exit)
        self.block(t, g, ty, a, a.pc[n])
        self.nloops = self.nloops - 1
        self.sc.truncate(mark)
        self.jump(latch)
        self.seal(latch)
        self.f.set_block(latch)
        let cur = self.read_var(counter, latch)
        self.write_var(counter, latch, self.f.bin(int(Op.Add), cur, self.f.cint(cr, 1)))
        self.jump(head)
        self.seal(head)
        self.seal(exit)
        self.f.set_block(exit)

    /#/ `for x in tuple`: the body once per element, in order.
    fn for_tuple(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int, vt: int, vr: int) => void:
        let it = a.pb[n]
        let tt = self.strip_refs(t, self.nd(t, ty, it))
        if needs_drop(t, g, vt):
            self.unsupported(n)
            return
        for i in 0..t.count_of(tt):
            if self.rep(t, g, t.arg(tt, i)) != vr:
                self.unsupported(n)
                return
        let agg = self.agg_of(t, g, ty, a, it)
        let exit = self.new_block()
        for i in 0..t.count_of(tt):
            let nxt = self.new_block()
            let mark = self.sc.n
            self.bind_var(t, g, a, a.pa[n], vt, self.f.extract(vr, agg, i))
            self.push_loop(nxt, exit)
            self.block(t, g, ty, a, a.pc[n])
            self.nloops = self.nloops - 1
            self.sc.truncate(mark)
            self.jump(nxt)
            self.seal(nxt)
            self.f.set_block(nxt)
        self.jump(exit)
        self.seal(exit)
        self.f.set_block(exit)

    /#/ ---- raise ---------------------------------------------------------------

    /#/ The row of the builtin class `Error`, -1 when there is none.
    fn error_row(self, g: &Syms) => int:
        for i in 0..g.n:
            if g.kind[i] == int(Sk.Class) && g.mod[i] == -1 && g.size[i] == 5 && g.pool[g.off[i]] == 'E' && g.pool[g.off[i] + 4] == 'r':
                return g.info[i]
        return -1

    /#/ The class row the name `o` stands for, -1 when it is no class.
    fn class_row(self, ty: &Typer, a: &Ast, o: int) => int:
        if o < 0 || a.kind[o] != int(Nk.Name):
            return -1
        let r = ty.lookup(a, a.tok[o])
        if r < 0 || ty.rd.sc.loc.kind[r] != int(Sk.Class):
            return -1
        return ty.rd.sc.loc.info[r]

    /#/ `raise`: in a function with a listener, the listener is called with an `Error` and its
    /#/ result is what the function returns; otherwise the error is printed and the process ends.
    fn raise_stmt(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        let e = a.pa[n]
        let er = self.error_row(g)
        if e < 0 || er < 0:
            self.unsupported(n)
            return
        let ety = t.named(er)
        let cr = -1
        if a.kind[e] == int(Nk.Call):
            cr = self.class_row(ty, a, a.pa[e])
        let first = -1
        let second = -1
        if cr >= 0:
            first = a.child[e]
            if first >= 0:
                second = a.next[first]
        if self.lis >= 0:
            let ep = -1
            if cr >= 0:
                ep = self.f.alloc(st_block(t, g, ety))
                let code = self.f.cint(int(Rp.I64), 0 - 1)
                if first >= 0 && t.kind[self.nd(t, ty, first)] == int(Ty.Int):
                    code = self.coerce(t, g, self.ex(t, g, ty, a, first), self.nd(t, ty, first), t.int_ty(8, true))
                let note = self.f.cint(int(Rp.Ptr), 0)
                if second >= 0 && t.kind[self.strip_refs(t, self.nd(t, ty, second))] == int(Ty.Str):
                    let nt = self.nd(t, ty, second)
                    let v = self.ex(t, g, ty, a, second)
                    if t.kind[nt] == int(Ty.Str):
                        note = self.consume(t, g, a, second, v, nt)
                    else:
                        note = self.str_dup(v)
                self.f.store(self.f.field(ep, 0), code)
                self.f.store(self.f.field(ep, 8), note)
                self.f.store(self.f.field(ep, 16), self.f.cint(int(Rp.Ptr), 0))
            else:
                ep = self.sink(t, g, ty, a, e, self.nd(t, ty, e))
            self.flush_temps(t, g)
            self.drop_scope(t, g, a, 0)
            self.f.arg(ep)
            let rr = self.rep(t, g, self.ret_ty)
            if t.kind[self.ret_ty] == int(Ty.Void):
                self.f.call(int(Rp.Void), -1, self.lis)
                self.f.ret_void()
            else:
                self.f.ret_v(self.f.call(rr, -1, self.lis))
            self.dead_block()
            return
        let msg = new_txt()
        msg.put("[E")
        let name = self.nd(t, ty, e)
        if cr >= 0:
            if first >= 0 && a.kind[first] == int(Nk.Int):
                msg.put_int(lit_digits(a, a.tok[first]))
            else:
                msg.put("-1")
            msg.put("]: ")
            for q in a.toks.start[a.tok[a.pa[e]]]..a.toks.end[a.tok[a.pa[e]]]:
                msg.put_byte(a.byte_at(q))
            msg.put_byte(10)
            if second >= 0 && a.kind[second] == int(Nk.Str):
                msg.put("note: ")
                self.put_text(&msg, a, a.tok[second])
                msg.put_byte(10)
            let c = first
            while c >= 0:
                self.exb(t, g, ty, a, c)
                c = a.next[c]
        else:
            msg.put("-1]: ")
            let st = self.strip_refs(t, name)
            if t.kind[st] == int(Ty.Named):
                let row = t.a[st]
                for q in g.off[row]..g.off[row] + g.size[row]:
                    msg.put_byte(g.pool[q])
            msg.put_byte(10)
            let v = self.ex(t, g, ty, a, e)
            if needs_drop(t, g, name) && (a.kind[e] == int(Nk.StructLit) || a.kind[e] == int(Nk.Call)):
                self.drop_value(t, g, v, name)
        self.flush_temps(t, g)
        self.drop_scope(t, g, a, 0)
        self.f.arg(self.f.cint(int(Rp.I32), 2))
        self.f.arg(self.f.strlit(self.text_global(&msg)))
        self.f.arg(self.f.cint(int(Rp.I64), msg.n))
        self.f.ccall(int(Rp.I64), 3, self.rt_write, 0)
        self.trap()
        self.dead_block()

    /#/ ---- enums and match -----------------------------------------------------

    /#/ The enum row `o` (a Name) names, or -1.
    fn enum_row(self, ty: &Typer, a: &Ast, o: int) => int:
        if o < 0 || a.kind[o] != int(Nk.Name):
            return -1
        let r = ty.lookup(a, a.tok[o])
        if r < 0 || ty.rd.sc.loc.kind[r] != int(Sk.Enum):
            return -1
        return ty.rd.sc.loc.info[r]

    /#/ Position of variant row `v` among the variants of its enum.
    fn variant_index(self, g: &Syms, v: int) => int:
        let k = 0
        for i in 0..v:
            if g.info[i] == g.info[v] && g.kind[i] == int(Sk.Variant):
                k = k + 1
        return k

    /#/ The payload of variant row `v` of enum type `x`: types in `lay_ty`, offsets in `lay_off`
    /#/ (after the 8-byte tag).
    fn payload_layout(self, t: &Tys, g: &Syms, x: int, v: int) => void:
        self.lay_n = 0
        let sig = g.ty[v]
        if sig < 0 || t.kind[sig] != int(Ty.Fn):
            return
        let off = 8
        for i in 0..t.count_of(sig):
            let ft = subst_env(t, t.arg(sig, i), x)
            off = align_up(off, st_align(t, g, ft))
            if self.lay_n >= len(self.lay_ty):
                self.lay_ty = buf_resize(self.lay_ty, (self.lay_n + 1) * 2)
                self.lay_off = buf_resize(self.lay_off, (self.lay_n + 1) * 2)
            self.lay_ty[self.lay_n] = ft
            self.lay_off[self.lay_n] = off
            self.lay_n = self.lay_n + 1
            off = off + st_size(t, g, ft)

    /#/ `Enum::Variant` and `Enum::Variant(args)`; `callee` is the Member node, `n` the whole.
    fn variant(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, callee: int, n: int) => int:
        let x = self.nd(t, ty, n)
        let er = self.enum_row(ty, a, a.pa[callee])
        let v = -1
        if er >= 0:
            v = member_of(g, a, er, a.tok[callee], int(Sk.Variant))
        if v < 0 || t.kind[x] != int(Ty.Named):
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let tag = self.variant_index(g, v)
        if !has_payload(t, g, er):
            return self.f.cint(int(Rp.I64), tag)
        let p = self.f.alloc(st_block(t, g, x))
        self.f.store(self.f.field(p, 0), self.f.cint(int(Rp.I64), tag))
        if n != callee:
            self.payload_layout(t, g, x, v)
            let offs: buf<int> = new_buf(int, self.lay_n + 1)
            let tys: buf<int> = new_buf(int, self.lay_n + 1)
            let cnt = self.lay_n
            for i in 0..cnt:
                offs[i] = self.lay_off[i]
                tys[i] = self.lay_ty[i]
            let c = a.child[n]
            let i = 0
            while c >= 0 && i < cnt:
                let val = self.sink(t, g, ty, a, c, tys[i])
                self.f.store(self.f.field(p, offs[i]), val)
                i = i + 1
                c = a.next[c]
        return p

    /#/ The number a literal pattern `p` stands for, with a leading minus; `ok` is 0 when it is not one.
    fn pattern_int(self, a: &Ast, p: int) => int:
        let k = a.kind[p]
        if k == int(Nk.Int):
            return lit_digits(a, a.tok[p])
        if k == int(Nk.Char):
            return char_value(a, a.tok[p])
        if k == int(Nk.Bool):
            if a.byte_at(a.toks.start[a.tok[p]]) == 't':
                return 1
            return 0
        if k == int(Nk.Unary) && a.pc[p] == int(Tk.Minus) && a.pa[p] >= 0 && a.kind[a.pa[p]] == int(Nk.Int):
            return 0 - lit_digits(a, a.tok[a.pa[p]])
        return 0

    fn is_int_pattern(self, a: &Ast, p: int) => bool:
        let k = a.kind[p]
        if k == int(Nk.Int) || k == int(Nk.Char) || k == int(Nk.Bool):
            return true
        return k == int(Nk.Unary) && a.pc[p] == int(Tk.Minus) && a.pa[p] >= 0 && a.kind[a.pa[p]] == int(Nk.Int)

    /#/ The payload patterns of variant `vr` in call pattern `p`, tested against the fields of `v`.
    fn pat_payload(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, p: int, v: int, x: int, vr: int, fail: int) => void:
        self.payload_layout(t, g, x, vr)
        let offs: buf<int> = new_buf(int, self.lay_n + 1)
        let tys: buf<int> = new_buf(int, self.lay_n + 1)
        let cnt = self.lay_n
        for i in 0..cnt:
            offs[i] = self.lay_off[i]
            tys[i] = self.lay_ty[i]
        let c = a.child[p]
        let i = 0
        while c >= 0 && i < cnt:
            let r = self.rep(t, g, tys[i])
            if r < 0:
                self.unsupported(c)
            else:
                self.pat_test(t, g, ty, a, c, self.f.load(r, -1, self.f.field(v, offs[i])), tys[i], fail)
            i = i + 1
            c = a.next[c]

    /#/ Goes on in a new block when value `v` of type `x` matches pattern `p`, else branches to
    /#/ `fail`. A name matches anything; a variant, a literal or a tuple of patterns is tested
    /#/ part by part, so a payload is read only after its tag matched.
    fn pat_test(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, p: int, v: int, x: int, fail: int) => void:
        let k = a.kind[p]
        if k == int(Nk.Name):
            return
        if k == int(Nk.Binary) && a.pc[p] == int(Tk.Pipe):
            /#/ `A | B`: B is tried when A fails
            let second = self.new_block()
            let join = self.new_block()
            self.pat_test(t, g, ty, a, a.pa[p], v, x, second)
            self.jump(join)
            self.seal(second)
            self.f.set_block(second)
            self.pat_test(t, g, ty, a, a.pb[p], v, x, fail)
            self.jump(join)
            self.seal(join)
            self.f.set_block(join)
            return
        if k == int(Nk.StructLit) && t.kind[x] == int(Ty.Named) && g.kind[t.a[x]] == int(Sk.Class):
            let fi = a.child[p]
            while fi >= 0:
                let off = self.find_field(t, g, a, x, a.tok[fi])
                let ft = self.fty
                if off < 0 || self.rep(t, g, ft) < 0:
                    self.unsupported(fi)
                    return
                self.pat_test(t, g, ty, a, a.pa[fi], self.f.load(self.rep(t, g, ft), -1, self.f.field(v, off)), ft, fail)
                fi = a.next[fi]
            return
        let en = -1
        if t.kind[x] == int(Ty.Named) && g.kind[t.a[x]] == int(Sk.Enum):
            en = t.a[x]
        let vr = -1
        if en >= 0 && k == int(Nk.Member):
            vr = member_of(g, a, en, a.tok[p], int(Sk.Variant))
        elif en >= 0 && k == int(Nk.Call) && a.pa[p] >= 0 && a.kind[a.pa[p]] == int(Nk.Member):
            vr = member_of(g, a, en, a.tok[a.pa[p]], int(Sk.Variant))
        if vr >= 0:
            let tag = v
            if has_payload(t, g, en):
                tag = self.f.load(int(Rp.I64), -1, self.f.field(v, 0))
            let cont = self.new_block()
            self.branch(self.f.cmp(int(Pr.Eq), tag, self.f.cint(int(Rp.I64), self.variant_index(g, vr))), cont, fail)
            self.seal(cont)
            self.f.set_block(cont)
            if k == int(Nk.Call):
                self.pat_payload(t, g, ty, a, p, v, x, vr, fail)
            return
        let r = self.rep(t, g, x)
        let cond = -1
        if en < 0 && r >= 0 && rp_is_int(r) && self.is_int_pattern(a, p):
            cond = self.f.cmp(int(Pr.Eq), v, self.f.cint(r, self.pattern_int(a, p)))
        elif k == int(Nk.Float) && (r == int(Rp.F64) || r == int(Rp.F32)):
            let bits = float_bits(a, a.tok[p], r == int(Rp.F32))
            if bits >= 0:
                cond = self.f.fcmp(int(Pr.OEq), v, self.f.cfloat(r, bits))
        elif k == int(Nk.Str) && t.kind[x] == int(Ty.Str):
            self.f.arg(v)
            self.f.arg(self.f.strlit(self.str_lit(a, a.tok[p])))
            cond = self.f.cmp(int(Pr.Eq), self.f.ccall(int(Rp.I32), 2, self.rt_strcmp, 0), self.f.cint(int(Rp.I32), 0))
        elif k == int(Nk.Tuple) && t.kind[x] == int(Ty.Tuple):
            let c = a.child[p]
            let i = 0
            while c >= 0 && i < t.count_of(x):
                let et = t.arg(x, i)
                self.pat_test(t, g, ty, a, c, self.f.extract(self.rep(t, g, et), v, i), et, fail)
                i = i + 1
                c = a.next[c]
            return
        if cond < 0:
            self.unsupported(p)
            return
        let cont = self.new_block()
        self.branch(cond, cont, fail)
        self.seal(cont)
        self.f.set_block(cont)

    /#/ Is `p` a name that binds the matched value (not `_`, not a constant)?
    fn is_binder(self, ty: &Typer, a: &Ast, p: int) => bool:
        if a.kind[p] != int(Nk.Name) || tok_is(a, a.tok[p], "_"):
            return false
        return self.lookup(a, a.tok[p]) >= 0 || ty.lookup(a, a.tok[p]) < 0

    /#/ Binds the names of pattern `p` in the arm. `v` is the matched value, `x` its type. A bound
    /#/ resource is a copy owned by the arm.
    fn pattern_bind(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, p: int, v: int, x: int) => void:
        let k = a.kind[p]
        if k == int(Nk.Name):
            if self.is_binder(ty, a, p):
                let val = v
                if needs_drop(t, g, x):
                    val = self.clone_value(t, g, v, x)
                self.bind_var(t, g, a, a.tok[p], x, val)
        elif k == int(Nk.Call) && t.kind[x] == int(Ty.Named) && g.kind[t.a[x]] == int(Sk.Enum):
            self.bind_variant(t, g, ty, a, p, v, x, t.a[x])
        elif k == int(Nk.StructLit) && t.kind[x] == int(Ty.Named) && g.kind[t.a[x]] == int(Sk.Class):
            let fi = a.child[p]
            while fi >= 0:
                let off = self.find_field(t, g, a, x, a.tok[fi])
                let ft = self.fty
                if off >= 0 && self.rep(t, g, ft) >= 0:
                    self.pattern_bind(t, g, ty, a, a.pa[fi], self.f.load(self.rep(t, g, ft), -1, self.f.field(v, off)), ft)
                fi = a.next[fi]
        elif k == int(Nk.Tuple) && t.kind[x] == int(Ty.Tuple):
            let c = a.child[p]
            let i = 0
            while c >= 0 && i < t.count_of(x):
                let et = t.arg(x, i)
                self.pattern_bind(t, g, ty, a, c, self.f.extract(self.rep(t, g, et), v, i), et)
                i = i + 1
                c = a.next[c]
        elif k == int(Nk.Binary) && a.pc[p] == int(Tk.Pipe):
            /#/ `A(n) | B(n)`: the first alternative that matches binds; the second writes the
            /#/ same variables, so the names are one variable on both paths
            let second = self.new_block()
            let join = self.new_block()
            let saved = self.or_mark
            let mark = self.sc.n
            self.pat_test(t, g, ty, a, a.pa[p], v, x, second)
            self.pattern_bind(t, g, ty, a, a.pa[p], v, x)
            self.jump(join)
            self.seal(second)
            self.f.set_block(second)
            self.or_mark = mark
            self.pattern_bind(t, g, ty, a, a.pb[p], v, x)
            self.or_mark = saved
            self.jump(join)
            self.seal(join)
            self.f.set_block(join)

    /#/ Binds the payload names of the variant pattern `p`.
    fn bind_variant(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, p: int, v: int, x: int, en: int) => void:
        let vr = member_of(g, a, en, a.tok[a.pa[p]], int(Sk.Variant))
        if vr < 0:
            return
        self.payload_layout(t, g, x, vr)
        let offs: buf<int> = new_buf(int, self.lay_n + 1)
        let tys: buf<int> = new_buf(int, self.lay_n + 1)
        let cnt = self.lay_n
        for i in 0..cnt:
            offs[i] = self.lay_off[i]
            tys[i] = self.lay_ty[i]
        let c = a.child[p]
        let i = 0
        while c >= 0 && i < cnt:
            let r = self.rep(t, g, tys[i])
            if r < 0:
                self.unsupported(c)
            else:
                self.pattern_bind(t, g, ty, a, c, self.f.load(r, -1, self.f.field(v, offs[i])), tys[i])
            i = i + 1
            c = a.next[c]

    /#/ `match`: the arms are tried in order; a name or `_` matches anything. A payload that is
    /#/ bound is a copy owned by the arm.
    fn match_stmt(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        let s = a.pa[n]
        let st = self.strip_refs(t, self.nd(t, ty, s))
        let sv = self.exb(t, g, ty, a, s)
        if t.kind[self.nd(t, ty, s)] == int(Ty.Ref) && !is_handle(t, g, st) && self.rep(t, g, st) >= 0:
            sv = self.f.load(self.rep(t, g, st), -1, sv)
        if self.rep(t, g, st) < 0:
            self.unsupported(n)
            return
        let join = self.new_block()
        let tail_arms = self.tailm == n
        self.tailm = -1
        let arm = a.child[n]
        while arm >= 0:
            let p = a.pa[arm]
            let next = self.new_block()
            self.pat_test(t, g, ty, a, p, sv, st, next)
            let own_mark = self.own_n
            let mark = self.sc.n
            self.pattern_bind(t, g, ty, a, p, sv, st)
            if a.pc[arm] >= 0:
                let ok = self.new_block()
                let gf = self.new_block()
                self.branch(self.ex(t, g, ty, a, a.pc[arm]), ok, gf)
                self.seal(ok)
                self.seal(gf)
                self.f.set_block(gf)
                self.drop_scope(t, g, a, own_mark)
                self.jump(next)
                self.f.set_block(ok)
            if tail_arms:
                self.tailb = a.pb[arm]
            self.block(t, g, ty, a, a.pb[arm])
            self.tailb = -1
            if !self.f.terminated(self.f.cur):
                self.drop_scope(t, g, a, own_mark)
            self.own_n = own_mark
            self.sc.truncate(mark)
            self.jump(join)
            self.seal(next)
            self.f.set_block(next)
            arm = a.next[arm]
        self.jump(join)
        self.seal(join)
        self.f.set_block(join)

    /#/ Drop glue of an enum with payloads: the fields of the live variant, then the block.
    fn glue_enum_drop(self, t: &Tys, g: &Syms, x: int, p0: int) => void:
        let en = t.a[x]
        /#/ the last field of a variant that is the enum itself is released by looping, not by
        /#/ a call: a long list does not use a stack frame per node
        let top = self.f.new_block()
        self.f.arg(p0)
        self.f.br(top)
        self.f.set_block(top)
        let cur = self.f.param(top, int(Rp.Ptr), -1)
        let tag = self.f.load(int(Rp.I64), -1, self.f.field(cur, 0))
        let end = self.f.new_block()
        let nv = 0
        let rows: buf<int> = new_buf(int, 8)
        let blocks: buf<int> = new_buf(int, 8)
        for i in 0..g.n:
            if g.info[i] == en && g.kind[i] == int(Sk.Variant):
                self.payload_layout(t, g, x, i)
                let owned = false
                for k in 0..self.lay_n:
                    if needs_drop(t, g, self.lay_ty[k]):
                        owned = true
                if owned:
                    if nv >= len(rows):
                        rows = buf_resize(rows, nv * 2)
                        blocks = buf_resize(blocks, nv * 2)
                    rows[nv] = i
                    blocks[nv] = self.f.new_block()
                    nv = nv + 1
        for k in 0..nv:
            self.f.sw_case(self.variant_index(g, rows[k]), self.f.mk_edge(blocks[k]))
        self.f.switch(tag, self.f.mk_edge(end))
        for k in 0..nv:
            self.f.set_block(blocks[k])
            self.payload_layout(t, g, x, rows[k])
            let tail = -1
            for q in 0..self.lay_n:
                if self.lay_ty[q] == x:
                    tail = q
            let nxt = -1
            if tail >= 0:
                nxt = self.f.load(int(Rp.Ptr), -1, self.f.field(cur, self.lay_off[tail]))
            for q in 0..self.lay_n:
                let ft = self.lay_ty[q]
                if q != tail && needs_drop(t, g, ft):
                    self.drop_value(t, g, self.f.load(self.rep(t, g, ft), -1, self.f.field(cur, self.lay_off[q])), ft)
            self.f.free(cur)
            if tail >= 0:
                self.f.arg(nxt)
                self.f.br(top)
            else:
                self.f.ret_void()
        self.f.set_block(end)
        self.f.free(cur)
        self.f.ret_void()

    /#/ Clone glue of an enum with payloads: the tag, and the fields of the live variant.
    fn glue_enum_clone(self, t: &Tys, g: &Syms, x: int, p: int) => void:
        let en = t.a[x]
        let q = self.f.alloc(st_block(t, g, x))
        let tag = self.f.load(int(Rp.I64), -1, self.f.field(p, 0))
        self.f.store(self.f.field(q, 0), tag)
        let end = self.f.new_block()
        let nv = 0
        let rows: buf<int> = new_buf(int, 8)
        let blocks: buf<int> = new_buf(int, 8)
        for i in 0..g.n:
            if g.info[i] == en && g.kind[i] == int(Sk.Variant):
                self.payload_layout(t, g, x, i)
                if self.lay_n > 0:
                    if nv >= len(rows):
                        rows = buf_resize(rows, nv * 2)
                        blocks = buf_resize(blocks, nv * 2)
                    rows[nv] = i
                    blocks[nv] = self.f.new_block()
                    nv = nv + 1
        for k in 0..nv:
            self.f.sw_case(self.variant_index(g, rows[k]), self.f.mk_edge(blocks[k]))
        self.f.switch(tag, self.f.mk_edge(end))
        for k in 0..nv:
            self.f.set_block(blocks[k])
            self.payload_layout(t, g, x, rows[k])
            for j in 0..self.lay_n:
                let ft = self.lay_ty[j]
                let v = self.f.load(self.rep(t, g, ft), -1, self.f.field(p, self.lay_off[j]))
                if needs_drop(t, g, ft):
                    v = self.clone_value(t, g, v, ft)
                self.f.store(self.f.field(q, self.lay_off[j]), v)
            self.f.br(end)
        self.f.set_block(end)
        self.f.ret_v(q)

    /#/ ---- representations, slots, places ---------------------------------------

    /#/ The representation of type `x`: a scalar, a pointer, or an aggregate (`buf<T>`, a
    /#/ slice, a tuple); -1 when it has none.
    fn rep(self, t: &Tys, g: &Syms, x: int) => int:
        let r = rep_of(t, g, x)
        if r >= 0:
            return r
        let k = t.kind[x]
        if (k == int(Ty.Buf) && t.a[x] >= 0) || k == int(Ty.Slice):
            let items: buf<int> = new_buf(int, 2)
            items[0] = int(Rp.Ptr)
            items[1] = int(Rp.I64)
            return self.rs.agg(&items, 2)
        if k == int(Ty.Tuple):
            let n = t.count_of(x)
            let items: buf<int> = new_buf(int, n + 1)
            for i in 0..n:
                let e = self.rep(t, g, t.arg(x, i))
                if e <= 0:
                    return -1
                items[i] = e
            return self.rs.agg(&items, n)
        return -1

    /#/ Every name `&` is applied to in the module: those variables live in a slot.
    fn scan_addr(self, a: &Ast, fn_node: int) => void:
        /#/ the names that `&` is taken of in this function: its nodes follow it in the table, up to
        /#/ the next item
        self.addr = new_names()
        let end = a.count
        if a.next[fn_node] > fn_node:
            end = a.next[fn_node]
        for i in fn_node..end:
            if a.kind[i] == int(Nk.Unary) && a.pc[i] == int(Tk.Amp) && a.pa[i] >= 0 && a.kind[a.pa[i]] == int(Nk.Name):
                let w = new_txt()
                for q in a.toks.start[a.tok[a.pa[i]]]..a.toks.end[a.tok[a.pa[i]]]:
                    w.put_byte(a.byte_at(q))
                self.addr.intern(&w)

    fn is_addr(self, a: &Ast, tok: int) => bool:
        let w = new_txt()
        for q in a.toks.start[tok]..a.toks.end[tok]:
            w.put_byte(a.byte_at(q))
        return self.addr.find(&w) >= 0

    /#/ A new variable named by `tok` holding `val`: in a slot when `&` is taken of it.
    fn bind_var(self, t: &Tys, g: &Syms, a: &Ast, tok: int, vt: int, val: int) => int:
        if self.or_mark >= 0:
            let row = self.sc.find_tok(a, tok, self.or_mark)
            if row >= 0 && self.sc.kind[row] == int(Sk.Local):
                let old = self.sc.info[row]
                self.var_write(old, val)
                if self.v_flag[old] >= 0:
                    self.write_var(self.v_flag[old], self.f.cur, self.f.cint(int(Rp.I8), 1))
                return old
        let vr = self.rep(t, g, vt)
        let v = self.new_var(a, tok, vr, vt)
        let handle = is_handle(t, g, vt)
        let taken = tok >= 0 && self.is_addr(a, tok)
        if tok >= 0 && ((!handle && (dbg_vars || taken)) || (handle && dbg_vars)):
            let sz = 8
            if !handle:
                sz = st_size(t, g, vt)
            let s = self.f.slot(sz)
            self.v_slot[v] = s
            self.f.store(s, val)
            if dbg_vars:
                self.dv_add(t, g, a, tok, vt, s)
        else:
            self.write_var(v, self.f.cur, val)
        if self.no_own == 0:
            self.own_bind(t, g, a, v, vt)
        return v

    /#/ Notes variable `tok` of type `vt` in `slot` for the debug table.
    fn dv_add(self, t: &Tys, g: &Syms, a: &Ast, tok: int, vt: int, slot: int) => void:
        let tid = dbg_type(&self.mc.dt, t, g, vt)
        if tid < 0:
            return
        if self.dv_n >= len(self.dv_fn):
            let cap = (self.dv_n + 1) * 2
            self.dv_fn = buf_resize(self.dv_fn, cap)
            self.dv_tid = buf_resize(self.dv_tid, cap)
            self.dv_slot = buf_resize(self.dv_slot, cap)
            self.dv_par = buf_resize(self.dv_par, cap)
            self.dv_nm = buf_resize(self.dv_nm, cap)
        self.dv_fn[self.dv_n] = self.cur_id
        self.dv_tid[self.dv_n] = tid
        self.dv_slot[self.dv_n] = slot
        self.dv_par[self.dv_n] = 0
        if self.in_params:
            self.dv_par[self.dv_n] = 1
        self.dv_nm[self.dv_n] = self.dv_names.n
        for q in a.toks.start[tok]..a.toks.end[tok]:
            self.dv_names.put_byte(a.byte_at(q))
        self.dv_names.put_byte(0)
        self.dv_n = self.dv_n + 1

    /#/ The variables of function `id` as `V name type offset P|L` lines for the function just made.
    fn dump_vars(self, id: int, lf: int) => void:
        let mc = &self.mc
        if lf >= len(mc.vr_s):
            mc.vr_s = buf_resize(mc.vr_s, (lf + 1) * 2)
            mc.vr_e = buf_resize(mc.vr_e, (lf + 1) * 2)
        mc.vr_s[lf] = mc.vtxt.n
        for k in 0..self.dv_n:
            if self.dv_fn[k] == id:
                mc.vtxt.put("V ")
                let q = self.dv_nm[k]
                while self.dv_names.b[q] != 0:
                    mc.vtxt.put_byte(self.dv_names.b[q])
                    q = q + 1
                mc.vtxt.put_byte(32)
                mc.vtxt.put_int(self.dv_tid[k])
                mc.vtxt.put_byte(32)
                mc.vtxt.put_int(0 - mc.voff[self.dv_slot[k]])
                if self.dv_par[k] == 1:
                    mc.vtxt.put(" P\n")
                else:
                    mc.vtxt.put(" L\n")
        mc.vr_e[lf] = mc.vtxt.n

    fn var_read(self, v: int) => int:
        if self.v_slot[v] >= 0:
            return self.f.load(self.v_rep[v], -1, self.v_slot[v])
        return self.read_var(v, self.f.cur)

    fn var_write(self, v: int, val: int) => void:
        if self.v_slot[v] >= 0:
            self.f.store(self.v_slot[v], val)
        else:
            self.write_var(v, self.f.cur, val)

    fn strip_refs(self, t: &Tys, x: int) => int:
        let c = x
        while t.kind[c] == int(Ty.Ref):
            c = t.a[c]
        return c

    /#/ The offset of field `tok` in class type `cls` (ancestors' fields come first); the field's
    /#/ type is left in `fty`. -1 when there is no such field.
    fn find_field(self, t: &Tys, g: &Syms, a: &Ast, cls: int, tok: int) => int:
        return self.find_field_by(t, g, a, cls, a.toks.start[tok], a.toks.end[tok])

    /#/ Like `find_field`, for the name spelled by the bytes `s`..`e` of the source.
    fn find_field_by(self, t: &Tys, g: &Syms, a: &Ast, cls: int, s: int, e: int) => int:
        self.fc_check(g)
        let sym = t.a[cls]
        if self.ch_len[sym] == 0:
            let chain: buf<int> = new_buf(int, 8)
            let n = 0
            let cur = sym
            while cur >= 0 && n < 8:
                chain[n] = cur
                n = n + 1
                let next = -1
                for i in 0..g.n:
                    if g.info[i] == cur && g.kind[i] == int(Sk.Parent):
                        next = g.find_class_row(i)
                cur = next
            for k in 0..n:
                self.ch_at[sym * 8 + k] = chain[k]
            self.ch_len[sym] = n + 1
        return self.find_field_span(t, g, a, cls, sym, self.ch_len[sym] - 1, s, e)

    /#/ Makes the caches of `find_field_by` empty when the globals have more rows than they were made for.
    fn fc_check(self, g: &Syms) => void:
        if self.fc_gn == g.n:
            return
        self.fc_gn = g.n
        if len(self.ch_len) < g.n + 1:
            self.ch_len = new_buf(int, g.n * 2 + 1)
            self.ch_at = new_buf(int, (g.n * 2 + 1) * 8)
            self.fl_len = new_buf(int, g.n * 2 + 1)
            self.fl_from = new_buf(int, g.n * 2 + 1)
        else:
            for i in 0..len(self.ch_len):
                self.ch_len[i] = 0
                self.fl_len[i] = 0
        self.fl_n = 0

    /#/ The field rows of class row `owner`, in order, in `fl_pool[fl_from[owner] ..]`.
    fn field_rows(self, g: &Syms, owner: int) => int:
        if self.fl_len[owner] == 0:
            self.fl_from[owner] = self.fl_n
            let k = 0
            for i in 0..g.n:
                if g.info[i] == owner && g.kind[i] == int(Sk.Field) && g.ty[i] >= 0:
                    if self.fl_n >= len(self.fl_pool):
                        self.fl_pool = buf_resize(self.fl_pool, (self.fl_n + 1) * 2)
                    self.fl_pool[self.fl_n] = i
                    self.fl_n = self.fl_n + 1
                    k = k + 1
            self.fl_len[owner] = k + 1
        return self.fl_len[owner] - 1

    /#/ The search of `find_field_by`, given the `n` classes of the chain of `sym`, root first at `n - 1`.
    fn find_field_span(self, t: &Tys, g: &Syms, a: &Ast, cls: int, sym: int, n: int, s: int, e: int) => int:
        let h = g.span_hash(a, s, e)
        let off = 0
        let c = n - 1
        while c >= 0:
            let owner = self.ch_at[sym * 8 + c]
            let cnt = self.field_rows(g, owner)
            let from = self.fl_from[owner]
            for q in 0..cnt:
                let i = self.fl_pool[from + q]
                let ft = subst_env(t, g.ty[i], cls)
                off = align_up(off, st_align(t, g, ft))
                if g.same_span(i, a, s, e, h):
                    self.fty = ft
                    return off
                off = off + st_size(t, g, ft)
            c = c - 1
        return -1

    /#/ The address of field `n` (a Member node) of a class value.
    fn field_addr(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let o = a.pa[n]
        let ot = self.strip_refs(t, self.nd(t, ty, o))
        if t.kind[ot] != int(Ty.Named) || g.kind[t.a[ot]] != int(Sk.Class):
            self.unsupported(n)
            return self.f.undef(int(Rp.Ptr))
        let off = self.find_field(t, g, a, ot, a.tok[n])
        if off < 0:
            self.unsupported(n)
            return self.f.undef(int(Rp.Ptr))
        return self.f.field(self.exb(t, g, ty, a, o), off)

    /#/ The value of an aggregate (`buf<T>`, slice, tuple) held by `o`, which may be a reference.
    fn agg_of(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, o: int) => int:
        let v = self.exb(t, g, ty, a, o)
        let ot = self.nd(t, ty, o)
        if t.kind[ot] == int(Ty.Ref):
            return self.f.load(self.rep(t, g, t.a[ot]), -1, v)
        return v

    fn trap(self) => void:
        self.f.arg(self.f.cint(int(Rp.I32), 1))
        self.f.ccall(int(Rp.Void), 1, self.rt_exit, 0)
        self.f.unreachable()

    /#/ The address of element `n` (an Index node), after a bounds check; the element type is
    /#/ left in `fty`.
    /#/ `s[i]` on a string: the byte, after a check against the length (as the Rust compiler does).
    fn str_byte(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let it = self.nd(t, ty, a.pb[n])
        let r = self.rep(t, g, self.nd(t, ty, n))
        if !t.is_int(it) || r < 0:
            self.unsupported(n)
            return self.f.undef(int(Rp.I8))
        let base = self.exb(t, g, ty, a, a.pa[n])
        let i = self.coerce(t, g, self.ex(t, g, ty, a, a.pb[n]), it, t.int_ty(8, true))
        let count = self.str_len_of(base)
        let good = self.new_block()
        let bad = self.new_block()
        self.branch(self.f.cmp(int(Pr.ULt), i, count), good, bad)
        self.seal(good)
        self.seal(bad)
        self.f.set_block(bad)
        self.trap()
        self.f.set_block(good)
        return self.f.load(r, -1, self.f.index(base, i, 1))

    /#/ Returns from a function without a value; the program's exit status is 0 when `main` has none.
    fn ret_unit(self) => void:
        if self.main_fn:
            self.f.ret_v(self.f.cint(int(Rp.I64), 0))
        else:
            self.f.ret_void()

    /#/ Traps unless `cond` holds.
    fn guard(self, cond: int) => void:
        let good = self.new_block()
        let bad = self.new_block()
        self.branch(cond, good, bad)
        self.seal(good)
        self.seal(bad)
        self.f.set_block(bad)
        self.trap()
        self.f.set_block(good)

    /#/ `b[lo..hi]`: a view of part of a buffer, slice or array; an end left out is the start or
    /#/ the length.
    fn slice_range(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let o = a.pa[n]
        let ot = self.strip_refs(t, self.nd(t, ty, o))
        let k = t.kind[ot]
        let sr = self.rep(t, g, self.nd(t, ty, n))
        if sr < 0 || !((k == int(Ty.Buf) && t.a[ot] >= 0) || k == int(Ty.Slice) || k == int(Ty.Array)):
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let data = -1
        let count = -1
        if k == int(Ty.Array):
            data = self.ex(t, g, ty, a, o)
            count = self.f.cint(int(Rp.I64), t.b[ot])
        else:
            let agg = self.agg_of(t, g, ty, a, o)
            data = self.f.extract(int(Rp.Ptr), agg, 0)
            count = self.f.extract(int(Rp.I64), agg, 1)
        let r = a.pb[n]
        let i64 = t.int_ty(8, true)
        let lo = self.f.cint(int(Rp.I64), 0)
        if a.pa[r] >= 0:
            lo = self.coerce(t, g, self.ex(t, g, ty, a, a.pa[r]), self.nd(t, ty, a.pa[r]), i64)
        let hi = count
        if a.pb[r] >= 0:
            hi = self.coerce(t, g, self.ex(t, g, ty, a, a.pb[r]), self.nd(t, ty, a.pb[r]), i64)
        self.guard(self.f.cmp(int(Pr.ULe), lo, hi))
        self.guard(self.f.cmp(int(Pr.ULe), hi, count))
        let start = self.f.index(data, lo, st_size(t, g, t.a[ot]))
        let len = self.f.bin(int(Op.Sub), hi, lo)
        return self.f.insert(self.f.insert(self.f.undef(sr), start, 0), len, 1)

    fn element_addr(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let o = a.pa[n]
        let ot = self.strip_refs(t, self.nd(t, ty, o))
        let k = t.kind[ot]
        if !((k == int(Ty.Buf) && t.a[ot] >= 0) || k == int(Ty.Slice) || k == int(Ty.Array)):
            self.unsupported(n)
            return self.f.undef(int(Rp.Ptr))
        let it = self.nd(t, ty, a.pb[n])
        if !t.is_int(it):
            self.unsupported(n)
            return self.f.undef(int(Rp.Ptr))
        let data = -1
        let count = -1
        if k == int(Ty.Array):
            data = self.ex(t, g, ty, a, o)
            count = self.f.cint(int(Rp.I64), t.b[ot])
        else:
            let agg = self.agg_of(t, g, ty, a, o)
            data = self.f.extract(int(Rp.Ptr), agg, 0)
            count = self.f.extract(int(Rp.I64), agg, 1)
        let i = self.coerce(t, g, self.ex(t, g, ty, a, a.pb[n]), it, t.int_ty(8, true))
        let good = self.new_block()
        let bad = self.new_block()
        self.branch(self.f.cmp(int(Pr.ULt), i, count), good, bad)
        self.seal(good)
        self.seal(bad)
        self.f.set_block(bad)
        self.trap()
        self.f.set_block(good)
        let elem = t.a[ot]
        self.fty = elem
        return self.f.index(data, i, st_size(t, g, elem))

    /#/ `Name { field: value, ... }`: a block of the class's size with every field stored.
    fn struct_lit(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let x = self.nd(t, ty, n)
        if t.kind[x] != int(Ty.Named) || g.kind[t.a[x]] != int(Sk.Class):
            self.unsupported(n)
            return self.f.undef(int(Rp.Ptr))
        let p = self.f.alloc(st_block(t, g, x))
        let fi = a.child[n]
        while fi >= 0:
            let off = self.find_field(t, g, a, x, a.tok[fi])
            if off < 0:
                self.unsupported(fi)
                return p
            let ft = self.fty
            let v = self.sink(t, g, ty, a, a.pa[fi], ft)
            self.f.store(self.f.field(p, off), v)
            fi = a.next[fi]
        return p

    fn tuple_lit(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let x = self.nd(t, ty, n)
        let r = self.rep(t, g, x)
        if r < 0 || t.kind[x] != int(Ty.Tuple):
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let agg = self.f.undef(r)
        let c = a.child[n]
        let i = 0
        while c >= 0:
            let v = self.sink(t, g, ty, a, c, t.arg(x, i))
            agg = self.f.insert(agg, v, i)
            i = i + 1
            c = a.next[c]
        return agg

    fn array_lit(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let x = self.nd(t, ty, n)
        if t.kind[x] != int(Ty.Array) || self.rep(t, g, t.a[x]) < 0:
            self.unsupported(n)
            return self.f.undef(int(Rp.Ptr))
        let size = st_size(t, g, t.a[x])
        let p = self.f.alloc(size * t.b[x])
        let c = a.child[n]
        let i = 0
        while c >= 0:
            let v = self.sink(t, g, ty, a, c, t.a[x])
            self.f.store(self.f.index(p, self.f.cint(int(Rp.I64), i), size), v)
            i = i + 1
            c = a.next[c]
        return p

    /#/ `a.b`: a field of a class, or an element of a tuple.
    fn member(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let o = a.pa[n]
        if self.enum_row(ty, a, o) >= 0:
            return self.variant(t, g, ty, a, n, n)
        let ot = self.strip_refs(t, self.nd(t, ty, o))
        let r = self.rep(t, g, self.nd(t, ty, n))
        if r < 0:
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        if t.kind[ot] == int(Ty.Tuple):
            let agg = self.agg_of(t, g, ty, a, o)
            return self.f.extract(r, agg, lit_digits(a, a.tok[n]))
        return self.f.load(r, -1, self.field_addr(t, g, ty, a, n))

    /#/ `len(x)` of a buffer, slice, array or string.
    fn len_call(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let o = a.child[n]
        let ot = self.strip_refs(t, self.nd(t, ty, o))
        let k = t.kind[ot]
        if k == int(Ty.Array):
            self.ex(t, g, ty, a, o)
            return self.f.cint(int(Rp.I64), t.b[ot])
        if (k == int(Ty.Buf) && t.a[ot] >= 0) || k == int(Ty.Slice):
            return self.f.extract(int(Rp.I64), self.agg_of(t, g, ty, a, o), 1)
        if k == int(Ty.Str):
            return self.str_len_of(self.exb(t, g, ty, a, o))
        self.unsupported(n)
        return self.f.cint(int(Rp.I64), 0)

    /#/ `new_buf(T, n)`: `n` zeroed elements.
    fn new_buf_call(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let x = self.nd(t, ty, n)
        let r = self.rep(t, g, x)
        let c = a.next[a.child[n]]
        if r < 0 || t.kind[x] != int(Ty.Buf) || t.a[x] < 0 || c < 0 || self.rep(t, g, t.a[x]) < 0:
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let cnt = self.coerce(t, g, self.ex(t, g, ty, a, c), self.nd(t, ty, c), t.int_ty(8, true))
        self.f.arg(cnt)
        self.f.arg(self.f.cint(int(Rp.I64), st_size(t, g, t.a[x])))
        let p = self.f.ccall(int(Rp.Ptr), 2, self.rt_calloc, 0)
        let agg = self.f.insert(self.f.undef(r), p, 0)
        return self.f.insert(agg, cnt, 1)

    /#/ `buf_resize(b, n)`: a zeroed block of `n` elements with the first elements of `b` copied in.
    /#/ `b` is left as it is, so the assignment `b = buf_resize(b, n)` drops (frees) the old block.
    fn buf_resize_call(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let x = self.nd(t, ty, n)
        let r = self.rep(t, g, x)
        let old = a.child[n]
        let c = -1
        if old >= 0:
            c = a.next[old]
        if r < 0 || t.kind[x] != int(Ty.Buf) || t.a[x] < 0 || c < 0 || self.rep(t, g, t.a[x]) < 0:
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let size = st_size(t, g, t.a[x])
        let ov = self.ex(t, g, ty, a, old)
        let odata = self.f.extract(int(Rp.Ptr), ov, 0)
        let olen = self.f.extract(int(Rp.I64), ov, 1)
        let cnt = self.coerce(t, g, self.ex(t, g, ty, a, c), self.nd(t, ty, c), t.int_ty(8, true))
        self.f.arg(cnt)
        self.f.arg(self.f.cint(int(Rp.I64), size))
        let p = self.f.ccall(int(Rp.Ptr), 2, self.rt_calloc, 0)
        /#/ the elements kept: the shorter of the two lengths
        let lt = self.f.conv(int(Op.ZExt), int(Rp.I64), self.f.cmp(int(Pr.ULt), olen, cnt))
        let keep = self.f.bin(int(Op.Add), cnt, self.f.bin(int(Op.Mul), self.f.bin(int(Op.Sub), olen, cnt), lt))
        self.f.arg(p)
        self.f.arg(odata)
        self.f.arg(self.f.bin(int(Op.Mul), keep, self.f.cint(int(Rp.I64), size)))
        self.f.ccall(int(Rp.Ptr), 3, self.rt_memcpy, 0)
        let agg = self.f.insert(self.f.undef(r), p, 0)
        return self.f.insert(agg, cnt, 1)

    /#/ The mangled name of a method or static function `name` of the class `row`.
    fn method_name(self, g: &Syms, a: &Ast, row: int, tok: int) => int:
        let w = new_txt()
        for q in g.off[row]..g.off[row] + g.size[row]:
            w.put_byte(g.pool[q])
        w.put_byte('_')
        for q in a.toks.start[tok]..a.toks.end[tok]:
            w.put_byte(a.byte_at(q))
        return self.names.intern(&w)

    /#/ `obj.m(args)` and `Class::f(args)`.
    /#/ `obj.assign("field", v)`: stores `v` in the field of that name.
    fn assign_call(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let callee = a.pa[n]
        let o = a.pa[callee]
        let ot = self.strip_refs(t, self.nd(t, ty, o))
        let name = a.child[n]
        let val = -1
        if name >= 0:
            val = a.next[name]
        if t.kind[ot] != int(Ty.Named) || g.kind[t.a[ot]] != int(Sk.Class) || name < 0 || val < 0 || a.kind[name] != int(Nk.Str):
            self.unsupported(n)
            return self.f.undef(int(Rp.Void))
        let off = self.find_field_by(t, g, a, ot, a.toks.start[a.tok[name]] + 1, a.toks.end[a.tok[name]] - 1)
        let ft = self.fty
        if off < 0 || self.rep(t, g, ft) < 0:
            self.unsupported(n)
            return self.f.undef(int(Rp.Void))
        let recv = self.exb(t, g, ty, a, o)
        let v = self.sink(t, g, ty, a, val, ft)
        let p = self.f.field(recv, off)
        /#/ what the field owned is released once the new value is known
        if needs_drop(t, g, ft):
            self.drop_value(t, g, self.f.load(self.rep(t, g, ft), -1, p), ft)
        self.f.store(p, v)
        return self.f.undef(int(Rp.Void))

    fn member_call(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let callee = a.pa[n]
        let sig = self.nd(t, ty, callee)
        let o = a.pa[callee]
        if tok_is(a, a.tok[callee], "assign") && (sig < 0 || t.kind[sig] != int(Ty.Fn)):
            return self.assign_call(t, g, ty, a, n)
        if sig < 0 || t.kind[sig] != int(Ty.Fn) || o < 0:
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let row = -1
        let first = 0
        let recv = -1
        if a.pd[callee] == 1:
            let sr = ty.lookup(a, a.tok[o])
            if sr < 0 || ty.rd.sc.loc.kind[sr] != int(Sk.Class):
                self.unsupported(n)
                return self.f.undef(int(Rp.I64))
            row = ty.rd.sc.loc.info[sr]
        else:
            let ot = self.strip_refs(t, self.nd(t, ty, o))
            if t.kind[ot] != int(Ty.Named) || g.kind[t.a[ot]] != int(Sk.Class):
                self.unsupported(n)
                return self.f.undef(int(Rp.I64))
            row = t.a[ot]
            recv = self.exb(t, g, ty, a, o)
            first = 1
            sig = subst_env(t, sig, ot)
        let rr = self.rep(t, g, t.c[sig])
        if rr < 0:
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let vals: buf<int> = new_buf(int, 8)
        let i = 0
        if first == 1:
            vals[0] = recv
            i = 1
        let c = a.child[n]
        while c >= 0:
            if i >= len(vals):
                vals = buf_resize(vals, i * 2)
            let v = self.ex(t, g, ty, a, c)
            if i < t.count_of(sig):
                v = self.coerce(t, g, v, self.nd(t, ty, c), t.arg(sig, i))
                if t.kind[t.arg(sig, i)] != int(Ty.Ref):
                    v = self.consume(t, g, a, c, v, self.nd(t, ty, c))
            vals[i] = v
            i = i + 1
            c = a.next[c]
        for j in 0..i:
            self.f.arg(vals[j])
        let mid = self.method_name(g, a, row, a.tok[callee])
        if g.ty[row] > 0:
            if first == 0:
                self.unsupported(n)
                return self.f.undef(int(Rp.I64))
            let ot = self.strip_refs(t, self.nd(t, ty, o))
            let mn = self.method_node_of(g, a, row, a.tok[callee])
            if mn < 0:
                self.unsupported(n)
                return self.f.undef(int(Rp.I64))
            let base = new_txt()
            self.names.put(&base, mid)
            mid = self.inst_name(&base, ot)
            self.want_instance(mn, ot, row)
        return self.f.call(rr, -1, mid)

    /#/ ---- ownership -----------------------------------------------------------

    /#/ The value of `n` where it is only borrowed: a literal stays static, a temporary that
    /#/ owns something is released at the end of the statement.
    fn exb(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        if a.kind[n] == int(Nk.Str):
            return self.f.strlit(self.str_lit(a, a.tok[n]))
        let v = self.ex(t, g, ty, a, n)
        let x = self.nd(t, ty, n)
        let k = a.kind[n]
        if needs_drop(t, g, x) && (k == int(Nk.Call) || k == int(Nk.StructLit) || k == int(Nk.Array) || k == int(Nk.Binary) || k == int(Nk.Unary)):
            if self.tmp_n >= len(self.tmp_v):
                self.tmp_v = buf_resize(self.tmp_v, (self.tmp_n + 1) * 2)
                self.tmp_ty = buf_resize(self.tmp_ty, (self.tmp_n + 1) * 2)
            self.tmp_v[self.tmp_n] = v
            self.tmp_ty[self.tmp_n] = x
            self.tmp_n = self.tmp_n + 1
        return v

    fn flush_temps(self, t: &Tys, g: &Syms) => void:
        if self.reachable():
            let i = self.tmp_n - 1
            while i >= 0:
                self.drop_value(t, g, self.tmp_v[i], self.tmp_ty[i])
                i = i - 1
        self.tmp_n = 0

    /#/ The name number of the glue function of type `x`: `drop.N` (kind 0) or `clone.N`
    /#/ (kind 1); it is generated when the module is finished.
    fn glue(self, x: int, kind: int) => int:
        let w = new_txt()
        if kind == 0:
            w.put("drop.")
        else:
            w.put("clone.")
        w.put_int(x)
        w.put_all(&self.tag)
        let id = self.names.intern(&w)
        for i in 0..self.glue_n:
            if self.glue_ty[i] == x && self.glue_kind[i] == kind:
                return id
        if self.glue_n >= len(self.glue_ty):
            self.glue_ty = buf_resize(self.glue_ty, (self.glue_n + 1) * 2)
            self.glue_kind = buf_resize(self.glue_kind, (self.glue_n + 1) * 2)
        self.glue_ty[self.glue_n] = x
        self.glue_kind[self.glue_n] = kind
        self.glue_n = self.glue_n + 1
        return id

    /#/ Releases the value `v` of type `x`.
    fn drop_value(self, t: &Tys, g: &Syms, v: int, x: int) => void:
        let k = t.kind[x]
        if k == int(Ty.Str):
            self.str_free(v)
        elif k == int(Ty.Buf):
            self.f.free(self.f.extract(int(Rp.Ptr), v, 0))
        elif k == int(Ty.Array) && !needs_drop(t, g, t.a[x]):
            self.f.free_n(v, st_size(t, g, t.a[x]) * t.b[x])
        elif k == int(Ty.Named) && class_plain(t, g, x):
            /#/ nothing inside to release: the drop is the free, no call
            self.f.free_n(v, st_block(t, g, x))
        elif k == int(Ty.Tuple):
            for i in 0..t.count_of(x):
                let et = t.arg(x, i)
                if needs_drop(t, g, et):
                    self.drop_value(t, g, self.f.extract(self.rep(t, g, et), v, i), et)
        else:
            self.f.drop_of(v, self.glue(x, 0))

    /#/ A deep copy of `v`, of type `x`.
    fn clone_value(self, t: &Tys, g: &Syms, v: int, x: int) => int:
        let k = t.kind[x]
        if k == int(Ty.Str):
            return self.str_dup(v)
        if k == int(Ty.Array) && !needs_drop(t, g, t.a[x]):
            let bytes = st_size(t, g, t.a[x]) * t.b[x]
            let p = self.f.alloc(bytes)
            self.f.arg(p)
            self.f.arg(v)
            self.f.arg(self.f.cint(int(Rp.I64), bytes))
            self.f.ccall(int(Rp.Ptr), 3, self.rt_memcpy, 0)
            return p
        if k == int(Ty.Buf) && t.a[x] >= 0 && !needs_drop(t, g, t.a[x]):
            /#/ a buffer of plain elements: a block of its own with the same elements
            let size = st_size(t, g, t.a[x])
            let data = self.f.extract(int(Rp.Ptr), v, 0)
            let cnt = self.f.extract(int(Rp.I64), v, 1)
            self.f.arg(cnt)
            self.f.arg(self.f.cint(int(Rp.I64), size))
            let p = self.f.ccall(int(Rp.Ptr), 2, self.rt_calloc, 0)
            self.f.arg(p)
            self.f.arg(data)
            self.f.arg(self.f.bin(int(Op.Mul), cnt, self.f.cint(int(Rp.I64), size)))
            self.f.ccall(int(Rp.Ptr), 3, self.rt_memcpy, 0)
            let agg = self.f.insert(self.f.undef(self.rep(t, g, x)), p, 0)
            return self.f.insert(agg, cnt, 1)
        if k == int(Ty.Named) || k == int(Ty.Array):
            return self.f.clone_of(v, self.glue(x, 1))
        if k == int(Ty.Tuple):
            let agg = v
            for i in 0..t.count_of(x):
                let et = t.arg(x, i)
                if needs_drop(t, g, et):
                    let e = self.f.extract(self.rep(t, g, et), v, i)
                    agg = self.f.insert(agg, self.clone_value(t, g, e, et), i)
            return agg
        self.f.arg(v)
        return v

    /#/ The variable `v` has just been made; if its type owns something it gets a flag.
    fn own_bind(self, t: &Tys, g: &Syms, a: &Ast, v: int, vt: int) => void:
        if !needs_drop(t, g, vt):
            return
        let fv = self.new_var(a, -1, int(Rp.I8), -1)
        self.write_var(fv, self.f.cur, self.f.cint(int(Rp.I8), 1))
        self.v_flag[v] = fv
        if self.own_n >= len(self.own_st):
            self.own_st = buf_resize(self.own_st, (self.own_n + 1) * 2)
        self.own_st[self.own_n] = v
        self.own_n = self.own_n + 1

    /#/ Can control reach the current block?
    fn reachable(self) => bool:
        let b = self.f.cur
        if b == 0:
            return true
        let e = self.pe_head[b]
        while e >= 0:
            if self.f.eto[e] == b:
                return true
            e = self.pe_next[e]
        return false

    /#/ Releases what `v` still owns; nothing when it was moved away.
    fn drop_var(self, t: &Tys, g: &Syms, a: &Ast, v: int) => void:
        let fv = self.v_flag[v]
        if fv < 0:
            return
        let fl = self.read_var(fv, self.f.cur)
        if self.f.is_const(fl):
            if self.f.cval(fl) != 0:
                self.drop_value(t, g, self.var_read(v), self.v_ty[v])
            self.write_var(fv, self.f.cur, self.f.cint(int(Rp.I8), 0))
            return
        let yes = self.new_block()
        let join = self.new_block()
        self.branch(fl, yes, join)
        self.seal(yes)
        self.f.set_block(yes)
        self.drop_value(t, g, self.var_read(v), self.v_ty[v])
        self.write_var(fv, yes, self.f.cint(int(Rp.I8), 0))
        self.jump(join)
        self.seal(join)
        self.f.set_block(join)

    /#/ Drops the owning variables declared since scope depth `mark`, innermost first.
    fn drop_scope(self, t: &Tys, g: &Syms, a: &Ast, mark: int) => void:
        if !self.reachable():
            return
        let i = self.own_n - 1
        while i >= mark:
            self.drop_var(t, g, a, self.own_st[i])
            i = i - 1

    /#/ `v` was used where a value of type `x` is wanted, by the expression `n`: a variable
    /#/ that is moved gives up what it owned; an array is copied.
    fn consume(self, t: &Tys, g: &Syms, a: &Ast, n: int, v: int, x: int) => int:
        if !needs_drop(t, g, x):
            return v
        let k = a.kind[n]
        if k == int(Nk.Name):
            let var = self.lookup(a, a.tok[n])
            if var >= 0 && self.v_flag[var] >= 0:
                if is_moved(t, g, x):
                    self.write_var(self.v_flag[var], self.f.cur, self.f.cint(int(Rp.I8), 0))
                    return v
                return self.clone_value(t, g, v, x)
            if var < 0 && t.kind[x] == int(Ty.Array):
                /#/ a module-level array is read in place; a copy is a new block
                return self.clone_value(t, g, v, x)
            return v
        if (k == int(Nk.Member) || k == int(Nk.Index)) && t.kind[x] == int(Ty.Array):
            return self.clone_value(t, g, v, x)
        return v


    /#/ The fields of class type `x` in layout order, in `lay_ty` and `lay_off`.
    fn layout(self, t: &Tys, g: &Syms, x: int) => void:
        let chain: buf<int> = new_buf(int, 8)
        let n = 0
        let cur = t.a[x]
        while cur >= 0 && n < 8:
            chain[n] = cur
            n = n + 1
            let next = -1
            for i in 0..g.n:
                if g.info[i] == cur && g.kind[i] == int(Sk.Parent):
                    next = g.find_class_row(i)
            cur = next
        self.lay_n = 0
        let off = 0
        let c = n - 1
        while c >= 0:
            for i in 0..g.n:
                if g.info[i] == chain[c] && g.kind[i] == int(Sk.Field) && g.ty[i] >= 0:
                    let ft = subst_env(t, g.ty[i], x)
                    off = align_up(off, st_align(t, g, ft))
                    if self.lay_n >= len(self.lay_ty):
                        self.lay_ty = buf_resize(self.lay_ty, (self.lay_n + 1) * 2)
                        self.lay_off = buf_resize(self.lay_off, (self.lay_n + 1) * 2)
                    self.lay_ty[self.lay_n] = ft
                    self.lay_off[self.lay_n] = off
                    self.lay_n = self.lay_n + 1
                    off = off + st_size(t, g, ft)
            c = c - 1

    /#/ Generates the drop and clone functions asked for so far, as machine code.
    fn emit_glue(self, t: &Tys, g: &Syms) => void:
        while self.glue_done < self.glue_n:
            let x = self.glue_ty[self.glue_done]
            let kind = self.glue_kind[self.glue_done]
            self.glue_done = self.glue_done + 1
            let name = new_txt()
            if kind == 0:
                name.put("drop.")
            else:
                name.put("clone.")
            name.put_int(x)
            name.put_all(&self.tag)
            if kind == 0:
                self.f.reset(&name, int(Rp.Void))
            else:
                self.f.reset(&name, int(Rp.Ptr))
            self.sc.truncate(0)
            let b = self.f.new_block()
            self.f.set_block(b)
            let p = self.f.param(b, int(Rp.Ptr), -1)
            if t.kind[x] == int(Ty.Array):
                self.glue_array(t, g, x, p, kind)
            elif g.kind[t.a[x]] == int(Sk.Enum):
                if kind == 0:
                    self.glue_enum_drop(t, g, x, p)
                else:
                    self.glue_enum_clone(t, g, x, p)
            else:
                self.layout(t, g, x)
                if kind == 0 && self.glue_class_loop(t, g, x, p):
                    self.keep_glue(&name)
                    continue
                if kind == 0:
                    self.glue_drop_fields(t, g, p)
                    self.f.free_n(p, st_block(t, g, x))
                    self.f.ret_void()
                else:
                    let q = self.f.alloc(st_block(t, g, x))
                    self.glue_clone_fields(t, g, p, q)
                    self.f.ret_v(q)
            self.keep_glue(&name)

    fn keep_glue(self, name: &Txt) => void:
        self.cur_id = self.names.intern(name)
        self.ext_mode = false
        self.keep_current()

    /#/ Drop glue of a class whose last owned field is an enum that holds the class again
    /#/ (`next: Option` with `Some(L)`): the chain is released by looping. False, with nothing
    /#/ emitted, when the class has no such field.
    fn glue_class_loop(self, t: &Tys, g: &Syms, x: int, p0: int) => bool:
        let n = self.lay_n
        let ftys: buf<int> = new_buf(int, n + 1)
        let foffs: buf<int> = new_buf(int, n + 1)
        for i in 0..n:
            ftys[i] = self.lay_ty[i]
            foffs[i] = self.lay_off[i]
        let tail = -1
        let var = -1
        let vfield = -1
        for i in 0..n:
            let et = ftys[i]
            if t.kind[et] == int(Ty.Named) && g.kind[t.a[et]] == int(Sk.Enum) && has_payload(t, g, t.a[et]):
                for v in 0..g.n:
                    if g.info[v] == t.a[et] && g.kind[v] == int(Sk.Variant) && var < 0:
                        self.payload_layout(t, g, et, v)
                        for q in 0..self.lay_n:
                            if self.lay_ty[q] == x:
                                tail = i
                                var = v
                                vfield = q
        if tail < 0:
            return false
        let et = ftys[tail]
        let top = self.f.new_block()
        self.f.arg(p0)
        self.f.br(top)
        self.f.set_block(top)
        let cur = self.f.param(top, int(Rp.Ptr), -1)
        for i in 0..n:
            if i != tail && needs_drop(t, g, ftys[i]):
                self.drop_value(t, g, self.f.load(self.rep(t, g, ftys[i]), -1, self.f.field(cur, foffs[i])), ftys[i])
        let e = self.f.load(int(Rp.Ptr), -1, self.f.field(cur, foffs[tail]))
        self.f.free(cur)
        let tag = self.f.load(int(Rp.I64), -1, self.f.field(e, 0))
        let hit = self.f.new_block()
        let other = self.f.new_block()
        self.f.sw_case(self.variant_index(g, var), self.f.mk_edge(hit))
        self.f.switch(tag, self.f.mk_edge(other))
        self.f.set_block(other)
        self.drop_value(t, g, e, et)
        self.f.ret_void()
        self.f.set_block(hit)
        self.payload_layout(t, g, et, var)
        let nxt = self.f.load(int(Rp.Ptr), -1, self.f.field(e, self.lay_off[vfield]))
        for q in 0..self.lay_n:
            if q != vfield && needs_drop(t, g, self.lay_ty[q]):
                self.drop_value(t, g, self.f.load(self.rep(t, g, self.lay_ty[q]), -1, self.f.field(e, self.lay_off[q])), self.lay_ty[q])
        self.f.free(e)
        self.f.arg(nxt)
        self.f.br(top)
        return true

    /#/ Drop or clone glue of `[T; N]` with owning elements: each element, then the block.
    fn glue_array(self, t: &Tys, g: &Syms, x: int, p: int, kind: int) => void:
        let et = t.a[x]
        let size = st_size(t, g, et)
        let r = self.rep(t, g, et)
        if kind == 0:
            for i in 0..t.b[x]:
                let v = self.f.load(r, -1, self.f.index(p, self.f.cint(int(Rp.I64), i), size))
                self.drop_value(t, g, v, et)
            self.f.free_n(p, size * t.b[x])
            self.f.ret_void()
        else:
            let q = self.f.alloc(size * t.b[x])
            for i in 0..t.b[x]:
                let v = self.f.load(r, -1, self.f.index(p, self.f.cint(int(Rp.I64), i), size))
                if needs_drop(t, g, et):
                    v = self.clone_value(t, g, v, et)
                self.f.store(self.f.index(q, self.f.cint(int(Rp.I64), i), size), v)
            self.f.ret_v(q)

    fn glue_drop_fields(self, t: &Tys, g: &Syms, p: int) => void:
        for i in 0..self.lay_n:
            let ft = self.lay_ty[i]
            if needs_drop(t, g, ft):
                let v = self.f.load(self.rep(t, g, ft), -1, self.f.field(p, self.lay_off[i]))
                self.drop_value(t, g, v, ft)

    fn glue_clone_fields(self, t: &Tys, g: &Syms, p: int, q: int) => void:
        for i in 0..self.lay_n:
            let ft = self.lay_ty[i]
            let v = self.f.load(self.rep(t, g, ft), -1, self.f.field(p, self.lay_off[i]))
            if needs_drop(t, g, ft):
                v = self.clone_value(t, g, v, ft)
            self.f.store(self.f.field(q, self.lay_off[i]), v)

    /#/ ---- functions -----------------------------------------------------------

    /#/ Lowers the function node `fn_node` into `self.f`; `bad` says whether it could not.
    fn function(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, fn_node: int, cls: int) => void:
        self.bad = 0
        self.scan_addr(a, fn_node)
        let body = a.pc[fn_node]
        let class_ty = -1
        if cls >= 0:
            class_ty = t.named(cls)
            if self.penv >= 0 && g.ty[cls] > 0:
                class_ty = self.penv
        let sig0 = ty.rd.fn_sig(t, a, fn_node, class_ty)
        if cls >= 0 && g.ty[cls] > 0:
            /#/ the declared signature knows the type parameters of the class
            let mr = member_of(g, a, cls, a.pa[fn_node], int(Sk.Method))
            if mr >= 0 && g.ty[mr] >= 0:
                sig0 = g.ty[mr]
        let sig = subst_env(t, sig0, self.penv)
        let rr = self.rep(t, g, t.c[sig])
        let name = new_txt()
        if cls >= 0:
            for q in g.off[cls]..g.off[cls] + g.size[cls]:
                name.put_byte(g.pool[q])
            name.put_byte('_')
        if self.pnm >= 0:
            self.names.put(&name, self.pnm)
        else:
            for q in a.toks.start[a.pa[fn_node]]..a.toks.end[a.pa[fn_node]]:
                name.put_byte(a.byte_at(q))
            if cls < 0 && self.penv < 0 && a.pd[fn_node] != 1:
                keep_off_runtime(&name)
            if self.penv >= 0:
                name.put("__")
                name.put_int(self.penv)
                name.put_all(&self.tag)
        let is_main = cls < 0 && self.pnm < 0 && self.penv < 0 && a.pa[fn_node] >= 0 && tok_is(a, a.pa[fn_node], "main")
        if is_main && rr == int(Rp.Void):
            /#/ a `main` without a value still hands the system an exit status: 0
            self.f.reset(&name, int(Rp.I64))
        else:
            self.f.reset(&name, rr)
        self.cur_id = self.names.intern(&name)
        self.nf_n = 0
        if self.pnm >= 0:
            self.nested_declare_self(a, fn_node)
        self.sc.truncate(0)
        self.dk = new_buf(int, 64)
        for i in 0..64:
            self.dk[i] = 0
        self.dv = new_buf(int, 64)
        self.dn = 0
        self.nv = 0
        self.inc_n = 0
        self.nloops = 0
        self.own_n = 0
        self.ret_ty = t.c[sig]
        self.lis = -1
        let lp = a.child[fn_node]
        while lp >= 0:
            if a.kind[lp] == int(Nk.Listener):
                let ln = new_txt()
                for q in a.toks.start[a.tok[lp]] + 1..a.toks.end[a.tok[lp]]:
                    ln.put_byte(a.byte_at(q))
                if !ln.same(&name):
                    self.lis = self.names.intern(&ln)
            lp = a.next[lp]
        if rr < 0 || body < 0:
            self.unsupported(fn_node)
            return
        let entry = self.new_block()
        self.sealed[entry] = 1
        self.f.set_block(entry)
        let p = a.child[fn_node]
        let i = 0
        while p >= 0:
            if a.kind[p] == int(Nk.TypeParam) && self.penv < 0:
                self.unsupported(p)
                return
            if a.kind[p] == int(Nk.Param) || a.kind[p] == int(Nk.SelfParam):
                let pt = t.arg(sig, i)
                let pr = self.rep(t, g, pt)
                if pr < 0 || pr == int(Rp.Void):
                    self.unsupported(p)
                    return
                /#/ `self` is borrowed from the caller
                if a.kind[p] == int(Nk.SelfParam):
                    self.no_own = 1
                self.in_params = true
                /#/ a reference parameter is marked (type 0): what it points to can be read at any point of the function
                let pty = -1
                if t.kind[pt] == int(Ty.Ref):
                    pty = 0
                self.bind_var(t, g, a, a.tok[p], pt, self.f.param(entry, pr, pty))
                self.in_params = false
                self.no_own = 0
                i = i + 1
            p = a.next[p]
        self.main_fn = false
        if cls < 0 && self.pnm < 0 && self.penv < 0 && a.pa[fn_node] >= 0 && tok_is(a, a.pa[fn_node], "main"):
            self.main_fn = true
            self.init_globals(t, g, ty, a)
        self.tailb = -1
        if rr != int(Rp.Void):
            self.tailb = body
        self.tailm = -1
        self.retx = -1
        self.block(t, g, ty, a, body)
        self.tailb = -1
        if !self.f.terminated(self.f.cur):
            if rr == int(Rp.Void):
                self.drop_scope(t, g, a, 0)
                self.ret_unit()
            else:
                self.f.unreachable()
        simplify_params(&self.f)

    /#/ Stores the function in `self.f` in the module; `finish` optimizes and emits them all.
    fn keep_current(self) => void:
        if self.lib.nf >= len(self.ext_slot):
            self.ext_slot = buf_resize(self.ext_slot, (self.lib.nf + 1) * 2)
        self.ext_slot[self.lib.nf] = 0
        if self.ext_mode:
            self.ext_slot[self.lib.nf] = 1
        self.lib.save(&self.f, self.lib.nf, self.cur_id)

    /#/ Optimizes the functions kept, callees first.
    fn optimize_module(self) => void:
        if self.opt > 0:
            module_opt(&self.lib, &self.f, &self.rs)

    /#/ Generates machine code for the functions kept.
    fn generate(self) => void:
        /#/ callees first: what a function writes is known when its callers are generated
        let order = call_order(&self.lib)
        for k in 0..self.lib.nf:
            let n = order[k]
            if self.ext_slot[n] == 1:
                continue
            self.lib.restore(n, &self.f)
            if ir_dump:
                let o = ir_text(&self.f, &self.rs)
                for q in 0..o.n:
                    say_byte(o.b[q])
            self.mc.cur = self.lib.f_id[n]
            let marked = self.mc.lf_n
            self.put_fun()
            if dbg_vars && self.mc.lf_n > marked:
                self.dump_vars(self.lib.f_id[n], self.mc.lf_n - 1)
            self.mc.cur = -1

    /#/ The function in `self.f` as machine code; a verifier finding is counted.
    fn put_fun(self) => void:
        if verify_on:
            let vd = verify(&self.f)
            if vd.n > 0:
                self.ver_err = self.ver_err + 1
                if ir_dump:
                    say(f"verifier: {vd.n} findings in a function, first: code {vd.code[0]} instruction {vd.inst[0]} block {vd.blk[0]}\n")
        let code0 = self.mc.a.pos()
        if !self.mc.gen_fun(&self.f, &self.rs, &self.names):
            self.mc_err = self.mc_err + 1
        if stats_on || lint_on:
            let fname = new_txt()
            let fid = self.mc.cur
            if fid < 0:
                fid = self.cur_id
            self.names.put(&fname, fid)
            let spills = 0
            for i in 0..self.f.ni:
                if self.f.uses[i] > 0 && self.f.op[i] != int(Op.Slot) && self.mc.home[i] < 0 && self.mc.xhome[i] < 0 && self.f.rep[i] != int(Rp.Void):
                    spills = spills + 1
            scan_fun(&self.f, &self.names, &fname, self.mc.a.pos() - code0, spills, self.mc.nsaved, self.mc.frame)

    /#/ The object file.
    fn object(self) => Txt:
        if lines_on:
            let lt = new_txt()
            lines_dump(&self.mc, &lt)
            lines_txt.put_all(&lt)
            if dbg_on:
                self.mc.o.dbg = lt
        self.mc.add_rodata(&self.sbytes)
        for k in 0..self.gl_n:
            let w = new_txt()
            self.names.put(&w, self.gl_name[k])
            self.mc.add_global(&w, self.gl_size[k])
        return self.mc.elf()

fn type_param_count(a: &Ast, f: int) => int:
    let k = 0
    let c = a.child[f]
    while c >= 0:
        if a.kind[c] == int(Nk.TypeParam):
            k = k + 1
        c = a.next[c]
    return k

/#/ Do tokens `x` and `y` of `a` spell the same name?
fn same_text(a: &Ast, x: int, y: int) => bool:
    let n = a.toks.end[x] - a.toks.start[x]
    if n != a.toks.end[y] - a.toks.start[y]:
        return false
    for k in 0..n:
        if a.byte_at(a.toks.start[x] + k) != a.byte_at(a.toks.start[y] + k):
            return false
    return true

fn new_lower() => Lower:
    let lw = make_lower()
    lw.rt_exit = lw.names.add("exit")
    lw.rt_calloc = lw.names.add("calloc")
    lw.rt_strlen = lw.names.add("strlen")
    lw.rt_malloc = lw.names.add("malloc")
    lw.rt_free = lw.names.add("free")
    lw.rt_strdup = lw.names.add("strdup")
    lw.rt_memcpy = lw.names.add("memcpy")
    lw.rt_strcmp = lw.names.add("strcmp")
    lw.rt_write = lw.names.add("write")
    return lw

