/#/ `--static`: the objects are linked by `cfld`'s linker, in this process, into an executable that
/#/ needs no C library. The program gets the runtime of `rt/src/min.cf` (`min_rt_text`).
use * in exe
use chmod, system in libc of c

/#/ `-g`: the executable keeps the names of its functions and data (a symbol table); without it the
/#/ file has none, which is what a release build wants.
let keep_syms = false

fn set_keep_syms() => void:
    keep_syms = true

/#/ The `cc` command start for linking: sections nobody reaches are dropped, and the symbols too
/#/ unless `-g` was given.
fn cc_link_start() => Txt:
    /#/ for Windows the MinGW-w64 cross compiler links (and supplies the C library)
    let t = txt_of("cc")
    if target_os == os_windows():
        t = txt_of("x86_64-w64-mingw32-gcc")
    if keep_syms:
        t.put(" -w -Wl,--gc-sections -o '")
    else:
        t.put(" -w -s -Wl,--gc-sections -o '")
    return t

/#/ Links the objects into `out`: `paths` has one object per line, `quoted` the same as `'a' 'b'` for
/#/ `cc`, `flags` is what the program's `.cfc` files add to the `cc` line. With `static_link` the
/#/ built-in linker goes first; when `quiet` (the choice was automatic) and it cannot, `cc` is tried.
/#/ 0 on success.
fn link_objects(paths: &Txt, quoted: &Txt, flags: &Txt, out: &Txt, static_link: bool, quiet: bool) => int:
    if static_link:
        let rc = link_static(paths, out, quiet)
        if rc == 0 || !quiet:
            return rc
    if target_arch == 0 && target_os == os_linux() && (use_builtin_dynamic || system("command -v cc > /dev/null 2>&1") != 0):
        return link_dynamic(paths, flags, out)
    let cmd = cc_link_start()
    cmd.put_all(out)
    cmd.put("'")
    cmd.put_all(quoted)
    cmd.put_all(flags)
    cmd.put(" -lm")
    if system(txt_str(&cmd)) != 0:
        return 1
    return 0

/#/ `--no-cc`: x86-64 programs are linked dynamically by the built-in linker even where `cc` exists.
let use_builtin_dynamic = false

fn set_builtin_dynamic() => void:
    use_builtin_dynamic = true

/#/ Links dynamically without `cc`: the objects in `paths`, the shared libraries named by the `-l` and
/#/ `-L` words of `flags` (the `.cfc` files' libraries), and the C library and the math library.
fn link_dynamic(paths: &Txt, flags: &Txt, out: &Txt) => int:
    let l = new_linker()
    l.dyn_on = true
    l.syms = false
    let lo = 0
    for i in 0..paths.n:
        if paths.b[i] == 10:
            let p = slice(paths, lo, i)
            let data = read_file(&p)
            if data.n < 0:
                say(f"error: cannot read '{txt_str(&p)}'\n")
                return 1
            l.add_file(&data, &p)
            lo = i + 1
    let dirs = new_txt()
    let names = txt_of("c\nm\n")
    let n = flags.n
    let i = 0
    while i < n:
        if i + 4 < n && flags.b[i] == 45 && flags.b[i + 1] == 76 && flags.b[i + 2] == 39:
            let j = i + 3
            while j < n && flags.b[j] != 39:
                dirs.put_byte(flags.b[j])
                j = j + 1
            dirs.put_byte(10)
            i = j
        elif i + 2 < n && flags.b[i] == 45 && flags.b[i + 1] == 108 && (i == 0 || flags.b[i - 1] == 32):
            let j = i + 2
            while j < n && flags.b[j] != 32:
                names.put_byte(flags.b[j])
                j = j + 1
            names.put_byte(10)
            i = j
        i = i + 1
    lo = 0
    for k in 0..names.n:
        if names.b[k] == 10:
            let nm = slice(&names, lo, k)
            lo = k + 1
            let sp = find_shared(&dirs, &nm)
            if sp.n > 0:
                let sd = read_file(&sp)
                l.add_shared(&sd, &sp)
    let exe = link_exe(&l)
    if exe.n == 0:
        return 1
    write_file(out, &exe)
    chmod(txt_str(out), 493)
    return 0

/#/ Links the object files named in `paths` (one per line) into the executable `out`.
fn link_static(paths: &Txt, out: &Txt, quiet: bool) => int:
    let l = new_linker()
    l.quiet = quiet
    l.syms = keep_syms
    let lo = 0
    for i in 0..paths.n:
        if paths.b[i] == 10:
            let p = slice(paths, lo, i)
            let data = read_file(&p)
            if data.n < 0:
                say(f"error: cannot read '{txt_str(&p)}'\n")
                return 1
            l.add_file(&data, &p)
            lo = i + 1
    let exe = link_exe(&l)
    if exe.n == 0:
        return 1
    write_file(out, &exe)
    chmod(txt_str(out), 493)
    return 0

/#/ The C functions `rt/src/min.cf` defines, space-separated.
fn min_provides() => str:
    return " malloc free calloc memcpy strlen strdup strcmp open read write close remove access chmod clock_gettime fork waitpid system exit _exit execve fflush "

/#/ Does the program (flattened text) import only what the built-in C library has? Then it can be
/#/ linked without `cc`.
fn can_link_static(t: &Txt, libs_ok: bool) => bool:
    let lo = 0
    let have = min_provides()
    for i in 0..t.n + 1:
        if i == t.n || t.b[i] == 10:
            if i - lo > 8 && find_in(t, lo, i, " of c") >= 0 && t.b[lo] == int('u') && t.b[lo + 1] == int('s') && t.b[lo + 2] == int('e'):
                let lib = c_lib_name(t, lo, i)
                if !lib.is("libc") && (lib.is("libm") || !libs_ok):
                    return false
                /#/ the names between `use ` and ` in `
                let stop = find_in(t, lo, i, " in ")
                let name = new_txt()
                for k in lo + 4..stop + 1:
                    if !lib.is("libc"):
                        break
                    if k == stop || t.b[k] == 44 || t.b[k] == 32:
                        if name.n > 0:
                            let probe = txt_of(" ")
                            probe.put_all(&name)
                            probe.put(" ")
                            let ps = txt_str(&probe)
                            let ht = txt_of(&have)
                            if find_in(&ht, 0, ht.n, &ps) < 0:
                                return false
                            name = new_txt()
                    else:
                        name.put_byte(t.b[k])
            lo = i + 1
    return true
