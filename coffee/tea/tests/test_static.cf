/#/ `coffee2 --static` links with the linker of `ld/` and the C library of `rt/src/min.cf`: the
/#/ program needs no shared library and still allocates, copies strings and prints numbers.
use * in say
use * in txt
use * in cstr
use * in files
use system, fflush in libc of c

fn expect(what: int, got: int, want: int) => int:
    if got != want:
        say(f"MISS #{what}: got {got}, want {want}\n")
        fflush(0)
        return 1
    return 0

fn status(cmd: &str) => int:
    return (system(cmd) >> 8) & 255

fn put(path: &str, text: &str) => void:
    write_file(&txt_of(path), &txt_of(text))

fn main() => int:
    let m = 0
    system("rm -rf st && mkdir st")
    put("st/a.cf", "class P:\n    x: int\n    name: str\n\nfn main() => int:\n    let b: buf<int> = new_buf(int, 4)\n    for i in 0..1000:\n        let p = P { x: i, name: f\"n{i}\" }\n        b[1] = b[1] + len(p.name)\n    let s = f\"{b[1]} {2.5}\"\n    return len(s)\n")
    m = m + expect(1, status("coffee2 st/a.cf --static -o st/a"), 0)
    m = m + expect(2, status("st/a"), 8)
    m = m + expect(3, status("ldd st/a > /dev/null 2>&1"), 1)
    m = m + expect(4, status("coffee2 st/a.cf --static --incremental st/ic -o st/b"), 0)
    m = m + expect(5, status("st/b"), 8)
    /#/ a void main exits 0
    put("st/v.cf", "fn main() => void:\n    let a = 1\n")
    m = m + expect(6, status("coffee2 st/v.cf --static -o st/v"), 0)
    m = m + expect(7, status("st/v"), 0)
    /#/ strlen, memcpy and strcmp over every length and alignment
    put("st/l.cf", "fn main() => int:\n    let s = \"\"\n    for n in 0..70:\n        if len(s) != n:\n            return 1\n        let t = s + \"x\"\n        let u = s + \"x\"\n        if t != u:\n            return 2\n        s = t\n    return 0\n")
    m = m + expect(8, status("coffee2 st/l.cf --static -o st/l"), 0)
    m = m + expect(9, status("st/l"), 0)
    return m
