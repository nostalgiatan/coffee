/#/ `tea jit` on a small project written to a scratch directory: it runs the program through
/#/ `cfjit`, keeps the `.cir` while nothing changed and makes it again when a source did. `tea`,
/#/ `coffee2` and `cfjit` are found through PATH.
use * in say
use * in txt
use * in cstr
use * in files
use system, fflush in libc of c

fn expect(what: int, got: int, want: int) => int:
    if got != want:
        say(f"MISS #{what}: got {got}, want {want}\n")
        fflush(0)
        return 1
    return 0

fn main() => int:
    let m = 0
    system("rm -rf jproj && mkdir -p jproj/src jproj/lib")
    write_file(&txt_of("jproj/coffee.toml"), &txt_of("[package]\nname = \"hello\"\n\n[build]\nmain = \"src/main.cf\"\ninclude = [\"lib\"]\n"))
    write_file(&txt_of("jproj/lib/two.cf"), &txt_of("fn two() => int:\n    return 2\n"))
    write_file(&txt_of("jproj/src/main.cf"), &txt_of("use * in two\n\nfn main() => int:\n    return two() + 40\n"))
    let st = system("cd jproj && tea jit > jit.log 2>&1")
    m = m + expect(1, (st >> 8) & 255, 42)
    m = m + expect(2, system("test -f jproj/target/jit/main.cir"), 0)
    /#/ nothing changed: the same file stays
    system("cd jproj && cp target/jit/main.cir first.cir && sleep 1 && tea jit > /dev/null 2>&1")
    m = m + expect(3, system("test ! target/jit/main.cir -nt jproj/first.cir"), 0)
    /#/ a source changed: made again, with the new result
    system("sleep 1")
    write_file(&txt_of("jproj/lib/two.cf"), &txt_of("fn two() => int:\n    return 3\n"))
    st = system("cd jproj && tea jit > jit.log 2>&1")
    m = m + expect(4, (st >> 8) & 255, 43)
    /#/ arguments after -- are not options of tea
    st = system("cd jproj && tea jit --no-run -- x > jit.log 2>&1")
    m = m + expect(5, (st >> 8) & 255, 0)
    write_file(&txt_of("jproj/src/main.cf"), &txt_of("fn main() => int:\n    return nope()\n"))
    st = system("cd jproj && tea jit > bad.log 2>&1")
    m = m + expect(6, (st >> 8) & 255, 1)
    return m
