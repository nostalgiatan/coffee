/#/ `tea build` and `tea run`: compile the entry of `coffee.toml` (`[build] main`, default
/#/ `src/main.cf`) with `coffee2` into `target/build/<package name>`; `run` then starts it.
/#/
/#/     tea build [-O0..-O3] [-I dir]... [--compiler path] [--whole] [--debug]
/#/     tea run   [-O0..-O3] [-I dir]... [--compiler path] [--whole] [--debug] [-- program arguments...]
/#/
/#/ The build is incremental: one object per source file in `target/obj`, rebuilt only when it or the
/#/ interface of another file changed. `--whole` makes one object for the program instead.
/#/ `--debug` builds into `target/debug` with `-g` (the file keeps the names of its functions) and, unless
/#/ a level is given, `-O0`; the default is a release build: `target/build`, no symbols, functions start on 16-byte boundaries (`--align`).
use system, fflush in libc of c

class Build:
    compiler: Txt
    /#/ ` -I 'dir'` for each directory given on the command line
    inc: Txt
    /#/ ` -O1` or empty
    level: Txt
    /#/ the program's arguments, each ` 'word'`
    args: Txt
    /#/ true: one object for the whole program, no cache
    whole: bool
    debug: bool
    bad: int

fn parse_build(a: &Args) => Build:
    let b = Build { compiler: txt_of("coffee2"), inc: new_txt(), level: new_txt(), args: new_txt(), whole: false, debug: false, bad: 0 }
    let i = 2
    let rest = false
    while i < a.n:
        let w = a.get(i)
        if rest:
            b.args.put(" '")
            quote_into(&b.args, &w)
            b.args.put("'")
        elif w.is("--"):
            rest = true
        elif w.is("-I") && i + 1 < a.n:
            let d = a.get(i + 1)
            b.inc.put(" -I '")
            b.inc.put_all(&d)
            b.inc.put("'")
            i = i + 1
        elif w.is("--debug"):
            b.debug = true
        elif w.is("--whole"):
            b.whole = true
        elif w.is("--compiler") && i + 1 < a.n:
            b.compiler = a.get(i + 1)
            i = i + 1
        elif w.n == 3 && w.b[0] == '-' && w.b[1] == 'O' && w.b[2] >= '0' && w.b[2] <= '3':
            b.level = txt_of(" ")
            b.level.put_all(&w)
        else:
            say(f"tea: unknown option '{txt_str(&w)}'\n")
            b.bad = 1
        i = i + 1
    if b.debug && b.level.n == 0:
        b.level = txt_of(" -O0")
    return b

/#/ `w` with each `'` written as `'\''`, to sit between single quotes in a shell command.
fn quote_into(out: &Txt, w: &Txt) => void:
    for i in 0..w.n:
        if w.b[i] == '\'':
            out.put("'\\''")
        else:
            out.put_byte(w.b[i])

/#/ target/build/<name>
fn program_path(b: &Build, pr: &Project) => Txt:
    let p = txt_of("target/build/")
    if b.debug:
        p = txt_of("target/debug/")
    p.put_all(&pr.name)
    return p

/#/ Compiles the entry; 0 when it worked.
fn build_program(b: &Build, pr: &Project) => int:
    if b.debug:
        system("mkdir -p target/debug")
    else:
        system("mkdir -p target/build")
    let out = program_path(b, pr)
    let c = txt_of("'")
    c.put_all(&b.compiler)
    c.put("' '")
    c.put_all(&pr.main)
    c.put("'")
    c.put_all(&b.inc)
    c.put_all(&pr.build_inc)
    c.put_all(&b.level)
    if b.debug:
        c.put(" -g")
    else:
        c.put(" --align")
    if !b.whole:
        if b.debug:
            c.put(" --incremental target/obj-debug")
        else:
            c.put(" --incremental target/obj")
    c.put(" -o '")
    c.put_all(&out)
    c.put("'")
    if system(txt_str(&c)) != 0:
        say("tea: build failed\n")
        fflush(0)
        return 1
    return 0

fn run_build(a: &Args) => int:
    let b = parse_build(a)
    if b.bad > 0:
        return 2
    let pr = load_project(true)
    return build_program(&b, &pr)

fn run_run(a: &Args) => int:
    let b = parse_build(a)
    if b.bad > 0:
        return 2
    let pr = load_project(true)
    if build_program(&b, &pr) != 0:
        return 1
    let c = txt_of("'")
    c.put_all(&program_path(&b, &pr))
    c.put("'")
    c.put_all(&b.args)
    fflush(0)
    let st = system(txt_str(&c))
    return (st >> 8) & 255
