/#/ tea, the tool around the compiler. Each command is a module of its own; `main` only picks one.
/#/
/#/     tea test    run the tests of this directory (src/cmd_test.cf)
/#/     tea build   compile the entry of coffee.toml (src/cmd_build.cf)
/#/     tea run     build, then run the program
/#/     tea jit     run the program through the JIT (src/cmd_jit.cf)
/#/     tea prof    run the program under the sampling profiler (src/cmd_prof.cf)
use * in txt
use * in cstr
use * in files
use * in args
use * in toml
use * in project
use * in cmd_test
use * in cmd_build
use * in cmd_jit
use * in cmd_prof
use fflush in libc of c

fn usage() => int:
    say("usage: tea <command> [options]\n\ncommands:\n  test    run the tests of this directory\n  build   compile the entry of coffee.toml\n  run     build, then run the program\n  jit     run the program through the JIT\n  prof    profile the program (hot functions and lines)\n")
    fflush(0)
    return 2

fn main() => int:
    let a = read_args()
    if a.n < 2:
        return usage()
    if a.is(1, "test"):
        return run_test(&a)
    if a.is(1, "build"):
        return run_build(&a)
    if a.is(1, "run"):
        return run_run(&a)
    if a.is(1, "jit"):
        return run_jit(&a)
    if a.is(1, "prof"):
        return run_prof(&a)
    say("tea: unknown command\n")
    return usage()
