use * in say
use * in drive
use fflush in libc of c

/#/ The instructions left in the blocks, and the blocks.
fn count(f: &Fun) => int:
    let n = 0
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            n = n + 1
            i = f.nx[i]
    return n

fn count_op(f: &Fun, op: int) => int:
    let n = 0
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            if f.op[i] == op:
                n = n + 1
            i = f.nx[i]
    return n

fn expect(what: int, got: int, want: int) => int:
    if got != want:
        say(f"MISS #{what}: got {got}, want {want}\n")
        fflush(0)
        return 1
    return 0

fn sound(what: int, f: &Fun) => int:
    let d = verify(f)
    if d.n != 0:
        say(f"MISS #{what}: verifier code {d.code[0]}\n")
        fflush(0)
        return 1
    return 0

/#/ A program with a loop, a constant branch and a class value.
fn sample() => str:
    return "class P:\n    a: int\n    b: int\n\nfn f(k: int) => int:\n    let p = P { a: k, b: 2 }\n    let t = 0\n    for i in 0..k:\n        t = t + p.a * p.b\n    if true:\n        return t\n    return 0\n\nfn main() => int:\n    return f(3)\n"

fn main() => int:
    let m = 0
    let i64 = int(Rp.I64)
    let i8 = int(Rp.I8)
    /#/ a branch on a constant: the other arm goes, and the arm taken joins the entry
    let g = new_fun("fold", i64)
    let e = g.new_block()
    let yes = g.new_block()
    let no = g.new_block()
    g.set_block(e)
    let x = g.param(e, i64, -1)
    let ey = g.mk_edge(yes)
    let en = g.mk_edge(no)
    g.condbr(g.cint(i8, 1), ey, en)
    g.set_block(yes)
    g.ret_v(g.bin(int(Op.Add), x, g.cint(i64, 1)))
    g.set_block(no)
    g.ret_v(g.bin(int(Op.Sub), x, g.cint(i64, 1)))
    m = m + sound(1, &g)
    optimize(&g)
    m = m + sound(2, &g)
    m = m + expect(3, g.nb, 1)
    m = m + expect(4, count(&g), 2)
    /#/ values nobody uses go, chains of them too
    let d = new_fun("dead", i64)
    let d0 = d.new_block()
    d.set_block(d0)
    let p = d.param(d0, i64, -1)
    let a1 = d.bin(int(Op.Mul), p, p)
    let a2 = d.bin(int(Op.Add), a1, p)
    d.bin(int(Op.Sub), a2, a1)
    d.ret_v(p)
    optimize(&d)
    m = m + sound(5, &d)
    m = m + expect(6, count(&d), 1)
    /#/ a loop parameter that nothing reads goes with the arguments passed to it
    let l = new_fun("loop", i64)
    let l0 = l.new_block()
    let head = l.new_block()
    let body = l.new_block()
    let done = l.new_block()
    l.set_block(l0)
    let n = l.param(l0, i64, -1)
    l.arg(l.cint(i64, 0))
    l.arg(l.cint(i64, 7))
    l.br(head)
    l.set_block(head)
    let i = l.param(head, i64, -1)
    let junk = l.param(head, i64, -1)
    let t = l.mk_edge(body)
    let fl = l.mk_edge(done)
    l.condbr(l.cmp(int(Pr.SLt), i, n), t, fl)
    l.set_block(body)
    l.arg(l.bin(int(Op.Add), i, l.cint(i64, 1)))
    l.arg(junk)
    l.br(head)
    l.set_block(done)
    l.ret_v(i)
    m = m + sound(7, &l)
    optimize(&l)
    m = m + sound(8, &l)
    m = m + expect(9, l.npar[1], 1)
    /#/ an allocation that is only freed is no allocation
    let h = new_fun("heap", i64)
    let h0 = h.new_block()
    h.set_block(h0)
    let hp = h.alloc(16)
    h.free(hp)
    h.ret_v(h.cint(i64, 3))
    optimize(&h)
    m = m + sound(10, &h)
    m = m + expect(11, count(&h), 1)
    /#/ a block used and freed in one place goes to the stack: no alloc, no free, one slot
    let sa = new_fun("stack", i64)
    let sa0 = sa.new_block()
    sa.set_block(sa0)
    let sp = sa.alloc(16)
    sa.store(sa.field(sp, 8), sa.cint(i64, 5))
    let sl = sa.load(i64, -1, sa.field(sp, 8))
    sa.free_n(sp, 16)
    sa.ret_v(sl)
    optimize(&sa)
    m = m + sound(30, &sa)
    m = m + expect(31, count_op(&sa, int(Op.Alloc)), 0)
    m = m + expect(32, count_op(&sa, int(Op.Free)), 0)
    m = m + expect(33, count_op(&sa, int(Op.Slot)), 1)
    /#/ one that is passed to a call, or stored, stays on the heap
    let sb = new_fun("escapes", i64)
    let sb0 = sb.new_block()
    sb.set_block(sb0)
    let sq = sb.alloc(16)
    sb.arg(sq)
    sb.ccall(i64, 1, 1, 0)
    sb.free_n(sq, 16)
    sb.ret_v(sb.cint(i64, 0))
    optimize(&sb)
    m = m + sound(34, &sb)
    m = m + expect(35, count_op(&sb, int(Op.Alloc)), 1)
    m = m + expect(36, count_op(&sb, int(Op.Free)), 1)
    /#/ a block freed in another block than it was made in stays too
    let sc = new_fun("far", i64)
    let sc0 = sc.new_block()
    let sc1 = sc.new_block()
    let sc2 = sc.new_block()
    sc.set_block(sc0)
    let sflag = sc.param(sc0, int(Rp.I8), -1)
    let sr = sc.alloc(16)
    sc.store(sr, sc.cint(i64, 1))
    let se1 = sc.mk_edge(sc1)
    let se2 = sc.mk_edge(sc2)
    sc.condbr(sflag, se1, se2)
    sc.set_block(sc1)
    sc.free_n(sr, 16)
    sc.ret_v(sc.cint(i64, 0))
    sc.set_block(sc2)
    sc.ret_v(sc.cint(i64, 1))
    optimize(&sc)
    m = m + sound(38, &sc)
    m = m + expect(37, count_op(&sc, int(Op.Alloc)) + count_op(&sc, int(Op.Free)), 2)
    /#/ `clone x` whose original is dropped at once is `x`
    let c = new_fun("copy", int(Rp.Ptr))
    let c0 = c.new_block()
    c.set_block(c0)
    let cx = c.param(c0, int(Rp.Ptr), -1)
    let cy = c.clone_of(cx, 1)
    c.drop_of(cx, 1)
    c.ret_v(cy)
    m = m + sound(12, &c)
    optimize(&c)
    m = m + sound(13, &c)
    m = m + expect(14, count(&c), 1)
    /#/ but not when the original is still used
    let k = new_fun("keep", int(Rp.Ptr))
    let k0 = k.new_block()
    k.set_block(k0)
    let kx = k.param(k0, int(Rp.Ptr), -1)
    let ky = k.clone_of(kx, 1)
    k.drop_of(kx, 1)
    k.drop_of(ky, 1)
    k.ret_v(kx)
    optimize(&k)
    m = m + expect(15, count(&k), 4)
    /#/ a block that only one jump enters joins its block, its parameter being what the jump passes
    let j = new_fun("join", i64)
    let j0 = j.new_block()
    let j1 = j.new_block()
    j.set_block(j0)
    let jp = j.param(j0, i64, -1)
    j.arg(j.bin(int(Op.Add), jp, j.cint(i64, 5)))
    j.br(j1)
    j.set_block(j1)
    let jq = j.param(j1, i64, -1)
    j.ret_v(j.bin(int(Op.Mul), jq, jq))
    m = m + sound(16, &j)
    optimize(&j)
    m = m + sound(17, &j)
    m = m + expect(18, j.nb, 1)
    m = m + expect(19, count(&j), 3)
    /#/ on lowered programs: never longer, and shorter where there is something to remove
    let raw = lowered_lines(sample(), 0, "f")
    let opt = lowered_lines(sample(), 1, "f")
    let shorter = 0
    if raw > opt:
        shorter = 1
    say(f"lowered lines: {raw}, optimized {opt}\n")
    m = m + expect(20, shorter, 1)
    m = m + expect(21, run_src(sample(), true), 18)
    return m
