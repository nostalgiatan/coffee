/#/ Branches to labels, forward and back, are patched when the function ends.
fn branches() => int:
    let m = 0
    let a = new_asm()
    a.begin_fun()
    let top = a.new_label()
    let out = a.new_label()
    a.bind(top)
    a64_bcc(&a, ac_eq(), out)
    a64_b(&a, top)
    a64_cbz(&a, 9, out)
    a64_cbnz(&a, 9, top)
    a.bind(out)
    a64_ret(&a)
    if !a64_end_fun(&a):
        say("MISS branches: end_fun\n")
        return 1
    let w = words(5)
    w[0] = 1409286272
    w[1] = 402653183
    w[2] = 3019898953
    w[3] = 3053453225
    w[4] = 3596551104
    m = m + same(900, &a, &w)
    /#/ a label never bound
    let b = new_asm()
    b.begin_fun()
    let l = b.new_label()
    a64_b(&b, l)
    if a64_end_fun(&b):
        say("MISS branches: an unbound label was accepted\n")
        m = m + 1
    return m

/#/ Does the object hold the 4-byte word `w` (little-endian) at some multiple of 4 from `from`?
fn has_word(o: &Txt, w: int) => bool:
    for k in 0..o.n - 3:
        if o.b[k] == (w & 255) && o.b[k + 1] == ((w >> 8) & 255) && o.b[k + 2] == ((w >> 16) & 255) && o.b[k + 3] == ((w >> 24) & 255):
            return true
    return false

fn target_is(name: &str) => int:
    let t = new_txt()
    t.put(name)
    return set_target(&t)

/#/ A program compiled for aarch64 is an ELF object of that machine with the prologue, a call and
/#/ the return in it; the same program for x86-64 afterwards is not.
fn object() => int:
    let m = 0
    let src = "fn fib(n: int) => int:\n    if n < 2:\n        return n\n    return fib(n - 1) + fib(n - 2)\n\nfn main() => int:\n    return fib(10)\n"
    if target_is("aarch64-linux") != 0:
        say("MISS object: no aarch64 target\n")
        return 1
    let o = build_src(clone src, 1)
    if o.n == 0:
        say("MISS object: no aarch64 object\n")
        return 1
    if o.b[18] != 183 || o.b[19] != 0:
        say("MISS object: the machine is not aarch64\n")
        m = m + 1
    if !has_word(&o, 2835381245):
        say("MISS object: no stp x29, x30, [sp]\n")
        m = m + 1
    if !has_word(&o, 3596551104):
        say("MISS object: no ret\n")
        m = m + 1
    if !has_word(&o, 2483027968):
        say("MISS object: no bl\n")
        m = m + 1
    if target_is("x86_64-linux") != 0:
        return m + 1
    let x = build_src(clone src, 1)
    if x.n == 0 || x.b[18] != 62:
        say("MISS object: the x86-64 object is not x86-64\n")
        m = m + 1
    if has_word(&x, 3596551104):
        say("MISS object: aarch64 code in the x86-64 object\n")
        m = m + 1
    return m

fn main() => int:
    let m = 0
    m = m + part0()
    m = m + part1()
    m = m + part2()
    m = m + part3()
    m = m + part4()
    m = m + branches()
    m = m + object()
    return m
