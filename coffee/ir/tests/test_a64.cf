/#/ The aarch64 assembler: the words each encoder writes, checked against the ones LLVM's assembler
/#/ (llvm-mc 21, -triple=aarch64) makes for the same instruction. A target without a decoder at hand
/#/ can still run this; the generated code is run in coffee/ir/tools/a64sim.py instead.
use * in say
use * in asm
use * in asm_a64
use * in drive
use * in target

/#/ Does the code of `a` hold exactly the words `w`?
fn same(what: int, a: &Asm, w: &buf<int>) => int:
    if a.pos() != 4 * len(w):
        say(f"MISS #{what}: {a.pos()} bytes, want {4 * len(w)}\n")
        return 1
    for k in 0..len(w):
        let got = a64_get(a, 4 * k)
        if got != w[k]:
            say(f"MISS #{what}: word {k} is {got}, want {w[k]}\n")
            return 1
    return 0

fn words(n: int) => buf<int>:
    return new_buf(int, n)

