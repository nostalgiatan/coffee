/#/ f-strings: `{expression}` of str, int, float and bool, run under the leak checker.
use * in say
use * in drive
use fflush in libc of c

fn expect(what: int, got: int, want: int) => int:
    if got != want:
        say(f"MISS #{what}: got {got}, want {want}\n")
        fflush(0)
        return 1
    return 0

/#/ A program whose `main` returns 0 when the f-string `body` (using the prelude's names) equals `want`.
fn same(prelude: str, body: str, want: str) => str:
    return "class P:\n    name: str\n    n: int\n\nfn who(s: &str) => str:\n    return f\"<{s}>\"\n\nfn five() => int:\n    return 5\n\nfn main() => int:\n    let n = 5\n    let x = 2.5\n    let b = true\n    let name = \"ab\"\n    let p = P { name: \"pp\", n: 7 }\n" + prelude + "    let s = f\"" + body + "\"\n    if s == \"" + want + "\":\n        return 0\n    return 1\n"

fn main() => int:
    let m = 0
    m = m + expect(1, run_src(same("", "n={n}", "n=5"), true), 0)
    m = m + expect(2, run_src(same("", "{n + 1}|{n * n - 1}", "6|24"), true), 0)
    m = m + expect(3, run_src(same("", "{x} {x * 2.0} {0.1}", "2.5 5.0 0.1"), true), 0)
    m = m + expect(4, run_src(same("", "{b} {!b} {n > 3}", "true false true"), true), 0)
    m = m + expect(5, run_src(same("", "{name}/{p.name}/{p.n}", "ab/pp/7"), true), 0)
    m = m + expect(6, run_src(same("", "{who(&name)} {five()} {-n}", "<ab> 5 -5"), true), 0)
    m = m + expect(7, run_src(same("", "plain", "plain"), true), 0)
    m = m + expect(8, run_src(same("", "{n}{n}{n}", "555"), true), 0)
    m = m + expect(9, run_src(same("", "a { b } c", "a { b } c"), true), 0)
    m = m + expect(10, run_src(same("    let k: int(4)+ = 9\n", "{k}", "9"), true), 0)
    m = m + expect(11, run_src(same("    let big = 9000000000\n", "{big}", "9000000000"), true), 0)
    m = m + expect(12, run_src(same("", "{who(&who(&name))}", "<<ab>>"), true), 0)
    /#/ an expression that is not text, an int, a float or a bool is refused
    m = m + expect(13, first_error(same("", "{p}", "x")), 100 + 4)
    /#/ `{{` and `}}` are braces of the text, and a string may stand inside `{}`
    m = m + expect(14, run_src(same("", "{{n}} {n} }}", "{n} 5 }"), true), 0)
    m = m + expect(15, run_src(same("", "{name + \"!\"}", "ab!"), true), 0)
    m = m + expect(16, run_src(same("", "a{{{n}}}b", "a{5}b"), true), 0)
    m = m + expect(17, run_src(same("", "{who(&(name + \"}\"))}", "<ab}>"), true), 0)
    /#/ format specs: width, alignment, fill, zero padding, base, precision
    m = m + expect(18, run_src(same("", "[{name:5}][{name:>5}][{name:^6}][{name:*<4}]", "[ab   ][   ab][  ab  ][ab**]"), true), 0)
    m = m + expect(19, run_src(same("", "[{n:3}][{n:<3}][{n:03}][{-n:04}][{n:x}][{255:X}][{n:b}][{n:o}]", "[  5][5  ][005][-005][5][FF][101][5]"), true), 0)
    m = m + expect(20, run_src(same("", "[{x:.0}][{x:.3}][{x:8.2}][{x:08.1}][{x:f}][{0.125:.2}][{b:6}]", "[2][2.500][    2.50][000002.5][2.500000][0.12][true  ]"), true), 0)
    m = m + expect(21, run_src(same("", "[{n + 1:3}][{who(&name):6}]", "[  6][<ab>  ]"), true), 0)
    /#/ a spec the value cannot take is refused
    m = m + expect(22, first_error(same("", "{n:.2}", "x")), 100 + 4)
    m = m + expect(23, first_error(same("", "{name:x}", "x")), 100 + 4)
    m = m + expect(24, first_error(same("", "{x:b}", "x")), 100 + 4)
    m = m + expect(25, first_error(same("", "{n:q}", "x")), 100 + 4)
    return m
