/#/ Names every module sees: the primitive types, the casts and the intrinsics.
fn builtin_names() => str:
    return "int float bool str string void nil buf object len new_buf buf_resize buf_ptr subslice sizeof range wrapping_add wrapping_sub wrapping_mul peek8 peek64 poke8 poke64 str_alloc str_put syscall call_addr i8 i16 i32 i64 u8 u16 u32 u64 f32 f64"

/#/ Adds each space-separated word of `words` as a module-less row of `kind`.
fn add_words(g: &Syms, words: &str, kind: int) => void:
    let start = 0
    for i in 0..len(words) + 1:
        if i == len(words) || byte(words, i) == ' ':
            if i > start:
                let b = g.pool_n
                let h = 0
                for k in start..i:
                    g.put_byte(byte(words, k))
                    h = hash_step(h, byte(words, k))
                g.push_row(b, h, kind, -1, -1, -1)
            start = i + 1

/#/ Globals with what every module sees already in: the casts and intrinsics, the bundled C
/#/ functions and types, and the builtin class `Error`.
fn new_globals() => Syms:
    let g = new_syms()
    let builtins = builtin_names()
    add_words(&g, &builtins, int(Sk.Builtin))
    let c_funcs = c_function_names()
    add_words(&g, &c_funcs, int(Sk.Extern))
    let c_types = c_type_names()
    add_words(&g, &c_types, int(Sk.Builtin))
    let e = g.add_text("Error", int(Sk.Class), 0, -1)
    g.info[e] = e
    g.add_text("code", int(Sk.Field), e, -1)
    g.add_text("note", int(Sk.Field), e, -1)
    g.add_text("e", int(Sk.Field), e, -1)
    return g

/#/ The number of ordinary parameters of fn node `f`.
fn param_count(a: &Ast, f: int) => int:
    let c = 0
    let p = a.child[f]
    while p >= 0:
        if a.kind[p] == int(Nk.Param):
            c = c + 1
        p = a.next[p]
    return c

/#/ Adds the top-level names of `a` to `g` as module `name`; returns the module id.
fn declare_module(g: &Syms, a: &Ast, name: &str) => int:
    let m = g.add_text(name, int(Sk.Module), 0, -1)
    g.mod[m] = m
    let it = a.child[a.root]
    while it >= 0:
        let k = a.kind[it]
        if k == int(Nk.Fn) && a.pa[it] >= 0:
            g.add_tok(a, a.pa[it], int(Sk.Fn), param_count(a, it), m)
        elif k == int(Nk.Class) && a.pa[it] >= 0:
            let ci = g.add_tok(a, a.pa[it], int(Sk.Class), 0, m)
            g.info[ci] = ci
            if a.pb[it] >= 0:
                g.add_tok(a, a.pb[it], int(Sk.Parent), ci, m)
            let f = a.child[it]
            while f >= 0:
                if a.kind[f] == int(Nk.Field):
                    g.add_tok(a, a.tok[f], int(Sk.Field), ci, m)
                elif a.kind[f] == int(Nk.Fn) && a.pa[f] >= 0:
                    g.add_tok(a, a.pa[f], int(Sk.Method), ci, m)
                f = a.next[f]
        elif k == int(Nk.Enum) && a.pa[it] >= 0:
            let ei = g.add_tok(a, a.pa[it], int(Sk.Enum), 0, m)
            g.info[ei] = ei
            let v = a.child[it]
            while v >= 0:
                if a.kind[v] == int(Nk.Variant):
                    g.add_tok(a, a.tok[v], int(Sk.Variant), ei, m)
                v = a.next[v]
        elif k == int(Nk.Let) && a.pa[it] >= 0:
            g.add_tok(a, a.pa[it], int(Sk.Global), 0, m)
        elif k == int(Nk.TypeAlias) && a.pa[it] >= 0:
            g.add_tok(a, a.pa[it], int(Sk.Alias), 0, m)
        elif k == int(Nk.Use) && a.pa[it] >= 0 && a.pc[it] != 1:
            /#/ `use * in x` is transitive: whoever imports this module sees x's names too
            let s = a.child[it]
            while s >= 0:
                if a.kind[s] == int(Nk.Star):
                    g.add_tok(a, a.pa[it], int(Sk.Import), 1, m)
                s = a.next[s]
        it = a.next[it]
    return m

/#/ A name another module can import.
fn exported(kind: int) => bool:
    return kind == int(Sk.Fn) || kind == int(Sk.Class) || kind == int(Sk.Enum) || kind == int(Sk.Global) || kind == int(Sk.Alias)

fn tok_is(a: &Ast, tok: int, word: &str) => bool:
    let s = a.toks.start[tok]
    let e = a.toks.end[tok]
    if e - s != len(word):
        return false
    for k in 0..len(word):
        if a.byte_at(s + k) != byte(word, k):
            return false
    return true

fn same_tok(a: &Ast, t1: int, t2: int) => bool:
    let s1 = a.toks.start[t1]
    let l1 = a.toks.end[t1] - s1
    let s2 = a.toks.start[t2]
    if a.toks.end[t2] - s2 != l1:
        return false
    for k in 0..l1:
        if a.byte_at(s1 + k) != a.byte_at(s2 + k):
            return false
    return true

/#/ Does a `break` that belongs to the loop around `st` appear in it?
fn has_break(a: &Ast, st: int) => bool:
    if st < 0:
        return false
    let k = a.kind[st]
    if k == int(Nk.Break):
        return true
    if k == int(Nk.If):
        return has_break(a, a.pb[st]) || has_break(a, a.pc[st])
    if k == int(Nk.Block):
        let c = a.child[st]
        while c >= 0:
            if has_break(a, c):
                return true
            c = a.next[c]
        return false
    if k == int(Nk.Match):
        let arm = a.child[st]
        while arm >= 0:
            if has_break(a, a.pb[arm]):
                return true
            arm = a.next[arm]
    return false

/#/ Can control not run off the end of statement `st`?
fn ends(a: &Ast, st: int) => bool:
    if st < 0:
        return false
    let k = a.kind[st]
    if k == int(Nk.Return) || k == int(Nk.Raise):
        return true
    if k == int(Nk.Block):
        let c = a.child[st]
        while c >= 0:
            if ends(a, c):
                return true
            c = a.next[c]
        return false
    if k == int(Nk.If):
        return a.pc[st] >= 0 && ends(a, a.pb[st]) && ends(a, a.pc[st])
    if k == int(Nk.While):
        return a.pa[st] >= 0 && a.kind[a.pa[st]] == int(Nk.Bool) && tok_is(a, a.tok[a.pa[st]], "true") && !has_break(a, a.pb[st])
    if k == int(Nk.Match):
        let arm = a.child[st]
        if arm < 0:
            return false
        while arm >= 0:
            if !ends_arm(a, a.pb[arm]):
                return false
            arm = a.next[arm]
        return true
    return false

/#/ An arm ends when its body does, or when its last statement is a bare value.
fn ends_arm(a: &Ast, body: int) => bool:
    if body < 0:
        return false
    if ends(a, body):
        return true
    let c = a.child[body]
    let last = -1
    while c >= 0:
        last = c
        c = a.next[c]
    return last >= 0 && a.kind[last] == int(Nk.ExprStmt)

/#/ Is the last statement of `body` a bare expression?
fn last_is_value(a: &Ast, body: int) => bool:
    if body < 0:
        return false
    let c = a.child[body]
    let last = -1
    while c >= 0:
        last = c
        c = a.next[c]
    return last >= 0 && a.kind[last] == int(Nk.ExprStmt)

class Checker:
    loc: Syms
    diags: Diags
    fn_base: int
    loops: int
    in_fn: int
    ret_void: bool
    cur: int
    seen: buf<int>
    seen_n: int
    capture_lo: int
    capture_named: bool
    cur_class: int

    fn diag(self, tok: int, code: int) => void:
        self.diags.add(tok, code)

    /#/ ---- scope ---------------------------------------------------------

    fn pop(self, mark: int) => void:
        let i = mark
        while i < self.loc.n:
            if self.loc.kind[i] == int(Sk.Local) && self.loc.used[i] == 0 && self.loc.first_byte(i) != '_':
                self.diag(self.loc.tok[i], int(Sk.Local) * 0 + int(Sc.UnusedVariable))
            i = i + 1
        self.loc.truncate(mark)

    /#/ Declares a local or parameter; redeclaring a live one of this function is an error.
    fn declare(self, a: &Ast, tok: int, kind: int) => void:
        let prior = self.loc.find_tok(a, tok, self.fn_base)
        if prior >= 0 && (self.loc.kind[prior] == int(Sk.Local) || self.loc.kind[prior] == int(Sk.Param)):
            self.diag(tok, int(Sc.DuplicateName))
        self.loc.add_tok(a, tok, kind, -1, self.cur)

    /#/ A read of the name at `tok`.
    fn use_name(self, a: &Ast, tok: int) => void:
        let i = self.loc.find_tok(a, tok, 0)
        if i < 0:
            self.diag(tok, int(Sc.UndefinedName))
        else:
            self.loc.used[i] = 1
            self.check_capture(i, tok)

    /#/ A nested function or anonymous function cannot read the locals around it.
    fn check_capture(self, i: int, tok: int) => void:
        if self.capture_lo >= 0 && i >= self.capture_lo && i < self.fn_base:
            if self.loc.kind[i] == int(Sk.Local) || self.loc.kind[i] == int(Sk.Param):
                if self.capture_named:
                    self.diag(tok, int(Sc.UndefinedName))
                else:
                    self.diag(tok, int(Sc.CaptureViolation))

    /#/ ---- types ---------------------------------------------------------

    fn type_ref(self, a: &Ast, t: int) => void:
        if t < 0:
            return
        let i = a.tok[t]
        while i < a.end[t]:
            if a.toks.kind[i] == int(Tk.Ident):
                let after_amp = i > a.tok[t] && a.toks.kind[i - 1] == int(Tk.Amp)
                if !(after_amp && tok_is(a, i, "mut")):
                    let r = self.loc.find_tok(a, i, 0)
                    if r < 0:
                        self.diag(i, int(Sc.UndefinedType))
                    else:
                        self.loc.used[r] = 1
            i = i + 1

    /#/ ---- expressions ---------------------------------------------------

    fn expr(self, a: &Ast, g: &Syms, n: int) => void:
        if n < 0:
            return
        let k = a.kind[n]
        if k == int(Nk.Name):
            self.use_name(a, a.tok[n])
        elif k == int(Nk.Binary) || k == int(Nk.Index) || k == int(Nk.Range):
            self.expr(a, g, a.pa[n])
            self.expr(a, g, a.pb[n])
        elif k == int(Nk.Unary):
            self.expr(a, g, a.pa[n])
        elif k == int(Nk.Member):
            self.expr(a, g, a.pa[n])
            self.member(a, g, n)
        elif k == int(Nk.Cast):
            self.expr(a, g, a.pa[n])
            self.type_ref(a, a.pb[n])
        elif k == int(Nk.Call):
            self.call(a, g, n)
        elif k == int(Nk.StructLit):
            self.struct_lit(a, g, n)
        elif k == int(Nk.Array) || k == int(Nk.Tuple):
            let c = a.child[n]
            while c >= 0:
                self.expr(a, g, c)
                c = a.next[c]
        elif k == int(Nk.FStr):
            self.fstr(a, g, n)
        elif k == int(Nk.Fn):
            self.function(a, g, n, false)

    /#/ `v.name` on a variable whose class is known: the class must have that field or method.
    fn member(self, a: &Ast, g: &Syms, n: int) => void:
        let o = a.pa[n]
        if a.pd[n] == 1 || o < 0 || a.kind[o] != int(Nk.Name) || a.tok[n] < 0:
            return
        let r = self.loc.find_tok(a, a.tok[o], 0)
        if r < 0 || (self.loc.kind[r] != int(Sk.Local) && self.loc.kind[r] != int(Sk.Param)):
            return
        let ci = self.loc.info[r]
        if tok_is(a, a.tok[n], "assign"):
            return
        if ci >= 0 && self.member_row(a, g, ci, a.tok[n], true) == -1:
            self.diag(a.tok[n], int(Sc.UnknownField))

    fn call(self, a: &Ast, g: &Syms, n: int) => void:
        let callee = a.pa[n]
        let before = self.diags.n
        self.expr(a, g, callee)
        /#/ an unknown member that is called is a missing method, not a missing field
        for k in before..self.diags.n:
            if self.diags.code[k] == int(Sc.UnknownField) && callee >= 0 && a.kind[callee] == int(Nk.Member) && self.diags.tok[k] == a.tok[callee]:
                self.diags.code[k] = int(Sc.UnknownMethod)
        let argc = 0
        let c = a.child[n]
        while c >= 0:
            self.expr(a, g, c)
            argc = argc + 1
            c = a.next[c]
        if callee >= 0 && a.kind[callee] == int(Nk.Name):
            let i = self.loc.find_tok(a, a.tok[callee], 0)
            if i >= 0 && self.loc.kind[i] == int(Sk.Fn) && self.loc.info[i] != argc:
                self.diag(a.tok[callee], int(Sc.ArityMismatch))

    /#/ `Class { f: v, ... }`: the class exists and the fields are exactly its own.
    fn struct_lit(self, a: &Ast, g: &Syms, n: int) => void:
        let t = a.pa[n]
        let ci = -1
        if t >= 0 && a.kind[t] == int(Nk.Name):
            let i = self.loc.find_tok(a, a.tok[t], 0)
            if i < 0:
                self.diag(a.tok[t], int(Sc.UndefinedName))
            else:
                self.loc.used[i] = 1
                if self.loc.kind[i] == int(Sk.Class):
                    ci = self.loc.info[i]
                elif self.loc.kind[i] != int(Sk.TypeParam):
                    self.diag(a.tok[t], int(Sc.NotAClass))
        else:
            self.expr(a, g, t)
        let given = 0
        let f = a.child[n]
        while f >= 0:
            self.expr(a, g, a.pa[f])
            if ci >= 0 && self.field_of(a, g, ci, a.tok[f]) < 0:
                self.diag(a.tok[f], int(Sc.UnknownField))
            given = given + 1
            f = a.next[f]
        if ci >= 0:
            self.missing_fields(a, g, ci, n)

    /#/ The Field row of class `ci`, or of one of its ancestors, named like `tok`; -1 if none.
    fn field_of(self, a: &Ast, g: &Syms, ci: int, tok: int) => int:
        return self.member_row(a, g, ci, tok, false)

    /#/ Like `field_of`, with methods counted too when `methods`. -2 when an ancestor cannot
    /#/ be found, so nothing can be said.
    fn member_row(self, a: &Ast, g: &Syms, ci: int, tok: int, methods: bool) => int:
        let s = a.toks.start[tok]
        let e = a.toks.end[tok]
        let h = g.span_hash(a, s, e)
        let cur = ci
        let depth = 0
        while cur >= 0 && depth < 32:
            let next = -1
            let has_parent = false
            let best = -1
            let last_parent = -1
            let q = g.member_head(cur) - 1
            while q >= 0:
                if (g.kind[q] == int(Sk.Field) || (methods && g.kind[q] == int(Sk.Method))) && (best < 0 || q < best) && g.same_span(q, a, s, e, h):
                    best = q
                if g.kind[q] == int(Sk.Parent) && q > last_parent:
                    last_parent = q
                q = g.member_next(q) - 1
            if best >= 0:
                return best
            if last_parent >= 0:
                has_parent = true
                next = g.find_class_row(last_parent)
            if has_parent && next < 0:
                return -2
            cur = next
            depth = depth + 1
        return -1

    /#/ Every field of class `ci` must be given in struct literal `n`.
    fn missing_fields(self, a: &Ast, g: &Syms, ci: int, n: int) => void:
        let cur = ci
        let depth = 0
        while cur >= 0 && depth < 32:
            let next = -1
            for i in 0..g.n:
                if g.info[i] != cur:
                    continue
                if g.kind[i] == int(Sk.Parent):
                    next = g.find_class_row(i)
                if g.kind[i] == int(Sk.Field):
                    let found = false
                    let f = a.child[n]
                    while f >= 0:
                        if g.same_span(i, a, a.toks.start[a.tok[f]], a.toks.end[a.tok[f]], g.span_hash(a, a.toks.start[a.tok[f]], a.toks.end[a.tok[f]])):
                            found = true
                        f = a.next[f]
                    if !found:
                        self.diag(a.tok[n], int(Sc.MissingField))
            cur = next
            depth = depth + 1

    /#/ `{name}` inside an f-string reads `name`. Only marks it used: the text is not parsed.
    fn fstr(self, a: &Ast, g: &Syms, n: int) => void:
        let p = a.child[n]
        while p >= 0:
            self.expr(a, g, a.pa[p])
            p = a.next[p]

    /#/ ---- statements ----------------------------------------------------

    fn stmts(self, a: &Ast, g: &Syms, block: int) => void:
        if block < 0:
            return
        let c = a.child[block]
        while c >= 0:
            self.stmt(a, g, c)
            c = a.next[c]

    fn block(self, a: &Ast, g: &Syms, b: int) => void:
        if b < 0:
            return
        let mark = self.loc.n
        self.stmts(a, g, b)
        self.pop(mark)

    fn stmt(self, a: &Ast, g: &Syms, n: int) => void:
        let k = a.kind[n]
        if k == int(Nk.Let):
            self.expr(a, g, a.pc[n])
            /#/ a class or enum name alone is a type, not a value
            let init = a.pc[n]
            if init >= 0 && a.kind[init] == int(Nk.Name):
                let ir = self.loc.find_tok(a, a.tok[init], 0)
                if ir >= 0 && (self.loc.kind[ir] == int(Sk.Class) || self.loc.kind[ir] == int(Sk.Enum)):
                    self.diag(a.tok[init], int(Sc.UndefinedName))
            self.type_ref(a, a.pb[n])
            if a.pa[n] >= 0:
                if self.in_fn == 0:
                    self.loc.used[self.loc.find_tok(a, a.pa[n], 0)] = 1
                else:
                    self.declare(a, a.pa[n], int(Sk.Local))
                    let ci = self.class_of_type(a, a.pb[n])
                    if ci < 0:
                        ci = self.class_of_literal(a, a.pc[n])
                    self.loc.info[self.loc.n - 1] = ci
        elif k == int(Nk.Assign):
            let t = a.pa[n]
            if t >= 0 && a.kind[t] == int(Nk.Name):
                let i = self.loc.find_tok(a, a.tok[t], 0)
                if i < 0:
                    self.diag(a.tok[t], int(Sc.UndefinedName))
            else:
                self.expr(a, g, t)
            self.expr(a, g, a.pb[n])
        elif k == int(Nk.Return):
            self.ret(a, g, n)
        elif k == int(Nk.Clean):
            /#/ `clean out` is a type error, not an undefined name
            return
        elif k == int(Nk.Raise) || k == int(Nk.Rm) || k == int(Nk.ExprStmt):
            self.expr(a, g, a.pa[n])
            let extra = a.child[n]
            while extra >= 0:
                self.expr(a, g, extra)
                extra = a.next[extra]
        elif k == int(Nk.Mv):
            self.expr(a, g, a.pa[n])
            if a.pb[n] >= 0:
                self.declare(a, a.pb[n], int(Sk.Local))
        elif k == int(Nk.TypeAlias):
            self.type_ref(a, a.pb[n])
            if self.in_fn == 1 && a.pa[n] >= 0:
                self.loc.add_tok(a, a.pa[n], int(Sk.Alias), -1, self.cur)
        elif k == int(Nk.If):
            self.expr(a, g, a.pa[n])
            self.block(a, g, a.pb[n])
            let e = a.pc[n]
            if e >= 0:
                if a.kind[e] == int(Nk.If):
                    self.stmt(a, g, e)
                else:
                    self.block(a, g, e)
        elif k == int(Nk.While):
            self.expr(a, g, a.pa[n])
            self.loops = self.loops + 1
            self.block(a, g, a.pb[n])
            self.loops = self.loops - 1
        elif k == int(Nk.For):
            self.expr(a, g, a.pb[n])
            self.loops = self.loops + 1
            let mark = self.loc.n
            if a.pa[n] >= 0:
                self.declare(a, a.pa[n], int(Sk.Local))
                self.loc.used[self.loc.n - 1] = 1
            self.stmts(a, g, a.pc[n])
            self.pop(mark)
            self.loops = self.loops - 1
        elif k == int(Nk.Match):
            self.expr(a, g, a.pa[n])
            let arm = a.child[n]
            while arm >= 0:
                let mark = self.loc.n
                self.pattern(a, g, a.pa[arm])
                self.expr(a, g, a.pc[arm])
                self.stmts(a, g, a.pb[arm])
                self.pop(mark)
                arm = a.next[arm]
        elif k == int(Nk.Break):
            if self.loops == 0:
                self.diag(a.tok[n], int(Sc.BreakOutsideLoop))
        elif k == int(Nk.Continue):
            if self.loops == 0:
                self.diag(a.tok[n], int(Sc.ContinueOutsideLoop))
        elif k == int(Nk.Fn):
            if a.pa[n] >= 0:
                self.loc.add_tok(a, a.pa[n], int(Sk.Fn), param_count(a, n), self.cur)
            self.function(a, g, n, false)
        elif k == int(Nk.Class):
            if a.pa[n] >= 0:
                self.loc.add_tok(a, a.pa[n], int(Sk.Class), -1, self.cur)
            self.class_decl(a, g, n)
        elif k == int(Nk.Enum):
            if a.pa[n] >= 0:
                self.loc.add_tok(a, a.pa[n], int(Sk.Enum), -1, self.cur)
            self.enum_decl(a, g, n)

    fn ret(self, a: &Ast, g: &Syms, n: int) => void:
        self.expr(a, g, a.pa[n])
        if self.in_fn == 0:
            self.diag(a.tok[n], int(Sc.ReturnOutsideFn))
        elif a.pa[n] >= 0 && self.ret_void:
            self.diag(a.tok[n], int(Sc.ReturnValueInVoid))
        elif a.pa[n] < 0 && !self.ret_void:
            self.diag(a.tok[n], int(Sc.MissingReturnValue))

    /#/ A pattern binds the names inside a variant pattern (`E.S(s)`), ignores `_` and
    /#/ otherwise reads constants.
    fn pattern(self, a: &Ast, g: &Syms, p: int) => void:
        if p < 0:
            return
        let k = a.kind[p]
        if k == int(Nk.Name):
            if tok_is(a, a.tok[p], "_"):
                return
            let i = self.loc.find_tok(a, a.tok[p], 0)
            if i >= 0 && self.loc.kind[i] != int(Sk.Local) && self.loc.kind[i] != int(Sk.Param):
                self.loc.used[i] = 1
            else:
                self.declare(a, a.tok[p], int(Sk.Local))
                self.loc.used[self.loc.n - 1] = 1
        elif k == int(Nk.Call):
            self.expr(a, g, a.pa[p])
            let c = a.child[p]
            while c >= 0:
                self.pattern(a, g, c)
                c = a.next[c]
        elif k == int(Nk.Tuple):
            let c = a.child[p]
            while c >= 0:
                self.pattern(a, g, c)
                c = a.next[c]
        elif k == int(Nk.StructLit):
            /#/ `Point { x: 0, y: b }`: each field holds a pattern
            let t = a.pa[p]
            if t >= 0 && a.kind[t] == int(Nk.Name):
                self.use_name(a, a.tok[t])
            let f = a.child[p]
            while f >= 0:
                self.pattern(a, g, a.pa[f])
                f = a.next[f]
        elif k == int(Nk.Binary) && a.pc[p] == int(Tk.Pipe):
            /#/ `A(n) | B(n)`: every alternative binds the same names
            let mark = self.loc.n
            self.pattern(a, g, a.pa[p])
            let mid = self.loc.n
            let seen: buf<int> = new_buf(int, mid - mark + 1)
            self.pattern_alt(a, g, a.pb[p], mark, mid, &seen)
            for i in 0..mid - mark:
                if seen[i] == 0 && self.loc.kind[mark + i] == int(Sk.Local):
                    self.diag(a.tok[p], int(Sc.UndefinedName))
        else:
            self.expr(a, g, p)

    /#/ A later alternative of an or-pattern: its names are the ones rows `mark..mid` already bound.
    fn pattern_alt(self, a: &Ast, g: &Syms, p: int, mark: int, mid: int, seen: &buf<int>) => void:
        if p < 0:
            return
        let k = a.kind[p]
        if k == int(Nk.Name):
            if tok_is(a, a.tok[p], "_"):
                return
            let i = self.loc.find_tok(a, a.tok[p], mark)
            if i >= 0 && i < mid:
                seen[i - mark] = 1
                return
            let o = self.loc.find_tok(a, a.tok[p], 0)
            if o >= 0 && self.loc.kind[o] != int(Sk.Local) && self.loc.kind[o] != int(Sk.Param):
                self.loc.used[o] = 1
            else:
                self.diag(a.tok[p], int(Sc.UndefinedName))
        elif k == int(Nk.Call):
            self.expr(a, g, a.pa[p])
            let c = a.child[p]
            while c >= 0:
                self.pattern_alt(a, g, c, mark, mid, seen)
                c = a.next[c]
        elif k == int(Nk.Tuple):
            let c = a.child[p]
            while c >= 0:
                self.pattern_alt(a, g, c, mark, mid, seen)
                c = a.next[c]
        elif k == int(Nk.StructLit):
            let t = a.pa[p]
            if t >= 0 && a.kind[t] == int(Nk.Name):
                self.use_name(a, a.tok[t])
            let f = a.child[p]
            while f >= 0:
                self.pattern_alt(a, g, a.pa[f], mark, mid, seen)
                f = a.next[f]
        elif k == int(Nk.Binary) && a.pc[p] == int(Tk.Pipe):
            self.pattern_alt(a, g, a.pa[p], mark, mid, seen)
            self.pattern_alt(a, g, a.pb[p], mark, mid, seen)
        else:
            self.expr(a, g, p)

    /#/ The class of `Class { ... }`, -1 for any other expression.
    fn class_of_literal(self, a: &Ast, e: int) => int:
        if e < 0 || a.kind[e] != int(Nk.StructLit):
            return -1
        let t = a.pa[e]
        if t < 0 || a.kind[t] != int(Nk.Name):
            return -1
        let r = self.loc.find_tok(a, a.tok[t], 0)
        if r >= 0 && self.loc.kind[r] == int(Sk.Class):
            return self.loc.info[r]
        return -1

    /#/ ---- declarations --------------------------------------------------

    /#/ `#name` names a function that must exist.
    fn listener(self, a: &Ast, l: int) => void:
        let t = a.tok[l]
        let s = a.toks.start[t] + 1
        let i = self.loc.find_span(a, s, a.toks.end[t], 0)
        if i < 0 || self.loc.kind[i] != int(Sk.Fn):
            self.diag(t, int(Sc.UndefinedName))
        else:
            self.loc.used[i] = 1

    /#/ The global row of the class a single-name type (`Box`, `&Box`, `&mut Box`) names; -1
    /#/ when it is anything else.
    fn class_of_type(self, a: &Ast, t: int) => int:
        if t < 0:
            return -1
        let i = a.tok[t]
        while i < a.end[t] && (a.toks.kind[i] == int(Tk.Amp) || tok_is(a, i, "mut")):
            i = i + 1
        if i != a.end[t] - 1 || a.toks.kind[i] != int(Tk.Ident):
            return -1
        let r = self.loc.find_tok(a, i, 0)
        if r >= 0 && self.loc.kind[r] == int(Sk.Class):
            return self.loc.info[r]
        return -1


    /#/ `method`: a method whose last statement is a bare expression returns its value.
    fn function(self, a: &Ast, g: &Syms, f: int, method: bool) => void:
        let saved_base = self.fn_base
        let saved_loops = self.loops
        let saved_in = self.in_fn
        let saved_void = self.ret_void
        let saved_capture = self.capture_lo
        let saved_named = self.capture_named
        let mark = self.loc.n
        if self.in_fn == 1:
            self.capture_lo = saved_base
            self.capture_named = a.pa[f] >= 0
        self.fn_base = mark
        self.loops = 0
        self.in_fn = 1
        let p = a.child[f]
        while p >= 0:
            if a.kind[p] == int(Nk.TypeParam):
                self.declare(a, a.tok[p], int(Sk.TypeParam))
            p = a.next[p]
        p = a.child[f]
        while p >= 0:
            if a.kind[p] == int(Nk.Param):
                self.type_ref(a, a.pa[p])
                self.declare(a, a.tok[p], int(Sk.Param))
                self.loc.info[self.loc.n - 1] = self.class_of_type(a, a.pa[p])
            elif a.kind[p] == int(Nk.SelfParam):
                self.declare(a, a.tok[p], int(Sk.Param))
                self.loc.info[self.loc.n - 1] = self.cur_class
            elif a.kind[p] == int(Nk.Listener):
                self.listener(a, p)
            p = a.next[p]
        let rt = a.pb[f]
        self.type_ref(a, rt)
        self.ret_void = rt < 0 || (a.end[rt] - a.tok[rt] == 1 && tok_is(a, a.tok[rt], "void")) || (a.end[rt] - a.tok[rt] == 2 && a.toks.kind[a.tok[rt]] == int(Tk.LParen))
        let body = a.pc[f]
        if body >= 0:
            self.stmts(a, g, body)
            if !self.ret_void && !ends(a, body) && !(method && last_is_value(a, body)):
                let at = a.tok[f]
                if a.pa[f] >= 0:
                    at = a.pa[f]
                self.diag(at, int(Sc.MissingReturn))
        self.pop(mark)
        self.fn_base = saved_base
        self.capture_lo = saved_capture
        self.capture_named = saved_named
        self.loops = saved_loops
        self.in_fn = saved_in
        self.ret_void = saved_void

    fn class_decl(self, a: &Ast, g: &Syms, c: int) => void:
        let mark = self.loc.n
        let saved_base = self.fn_base
        let saved_class = self.cur_class
        self.cur_class = -1
        if a.pa[c] >= 0:
            let own = self.loc.find_tok(a, a.pa[c], 0)
            if own >= 0 && self.loc.kind[own] == int(Sk.Class):
                self.cur_class = self.loc.info[own]
        self.fn_base = mark
        let m = a.child[c]
        while m >= 0:
            if a.kind[m] == int(Nk.TypeParam):
                self.declare(a, a.tok[m], int(Sk.TypeParam))
            m = a.next[m]
        if a.pb[c] >= 0:
            let pi = self.loc.find_tok(a, a.pb[c], 0)
            if pi < 0 || self.loc.kind[pi] != int(Sk.Class):
                self.diag(a.pb[c], int(Sc.UnknownParent))
            else:
                self.loc.used[pi] = 1
        m = a.child[c]
        while m >= 0:
            let k = a.kind[m]
            if k == int(Nk.Field):
                self.type_ref(a, a.pa[m])
                self.dup_member(a, c, m, a.tok[m])
            elif k == int(Nk.Fn):
                self.dup_member(a, c, m, a.pa[m])
                self.function(a, g, m, true)
            m = a.next[m]
        self.fn_base = saved_base
        self.cur_class = saved_class
        self.loc.truncate(mark)

    /#/ Is the member named by `tok` already declared by an earlier member of `c`?
    fn dup_member(self, a: &Ast, c: int, m: int, tok: int) => void:
        if tok < 0:
            return
        let o = a.child[c]
        while o >= 0 && o != m:
            let other = -1
            if a.kind[o] == int(Nk.Field):
                other = a.tok[o]
            elif a.kind[o] == int(Nk.Fn):
                other = a.pa[o]
            if other >= 0 && same_tok(a, other, tok):
                self.diag(tok, int(Sc.DuplicateName))
                return
            o = a.next[o]

    fn enum_decl(self, a: &Ast, g: &Syms, e: int) => void:
        let v = a.child[e]
        while v >= 0:
            let o = a.child[e]
            while o != v:
                if same_tok(a, a.tok[o], a.tok[v]):
                    self.diag(a.tok[v], int(Sc.DuplicateName))
                    break
                o = a.next[o]
            let f = a.child[v]
            while f >= 0:
                self.type_ref(a, a.pa[f])
                f = a.next[f]
            v = a.next[v]

    /#/ ---- modules -------------------------------------------------------

    /#/ Brings the builtins, the module's own names and its imports into scope.
    fn prelude(self, a: &Ast, g: &Syms, m: int) => void:
        for i in 0..g.n:
            if g.mod[i] == -1 && (g.kind[i] == int(Sk.Builtin) || g.kind[i] == int(Sk.Extern) || g.kind[i] == int(Sk.Class) || g.kind[i] == int(Sk.Alias)):
                self.loc.copy_row(g, i)
        for i in 0..g.n:
            if g.mod[i] == m && exported(g.kind[i]):
                self.loc.copy_row(g, i)
        let it = a.child[a.root]
        while it >= 0:
            if a.kind[it] == int(Nk.Use):
                self.import(a, g, it)
            it = a.next[it]

    /#/ A function imported from a C library takes the signature a `.cfc` (bundled, or the program's own) gave it.
    fn bundled_sig(self, a: &Ast, g: &Syms, r: int, tok: int) => void:
        let st = a.toks.start[tok]
        let en = a.toks.end[tok]
        let h = g.span_hash(a, st, en)
        for i in 0..g.n:
            if g.kind[i] == int(Sk.Extern) && g.mod[i] == -1 && g.same_span(i, a, st, en, h):
                self.loc.ty[r] = g.ty[i]
                self.loc.info[r] = g.info[i]

    fn import(self, a: &Ast, g: &Syms, u: int) => void:
        if a.pa[u] < 0:
            return
        if a.pc[u] == 1:
            let s = a.child[u]
            while s >= 0:
                if a.kind[s] == int(Nk.Name):
                    let r = self.loc.add_tok(a, a.tok[s], int(Sk.Extern), -1, -1)
                    self.bundled_sig(a, g, r, a.tok[s])
                    if self.loc.ty[r] < 0 && !tok_is(a, a.pa[u], "libc") && !tok_is(a, a.pa[u], "libm"):
                        /#/ no `.cfc` gave this function a signature
                        self.diag(a.tok[s], int(Sc.UnknownCSymbol))
                s = a.next[s]
            return
        let mid = g.find_module(a, a.pa[u])
        if mid < 0:
            self.diag(a.pa[u], int(Sc.UnknownModule))
            return
        if a.child[u] < 0:
            /#/ `use m` imports the whole module
            self.import_all(g, mid)
            return
        let s = a.child[u]
        while s >= 0:
            if a.kind[s] == int(Nk.Star):
                self.import_all(g, mid)
            else:
                let i = g.find_in_module(a, a.tok[s], mid)
                if i < 0 || !exported(g.kind[i]):
                    self.diag(a.tok[s], int(Sc.UnknownImport))
                else:
                    self.import_row(g, i)
            s = a.next[s]

    /#/ Everything module `mid` exports and, transitively, what it star-imports.
    fn import_all(self, g: &Syms, mid: int) => void:
        for k in 0..self.seen_n:
            if self.seen[k] == mid:
                return
        if self.seen_n >= len(self.seen):
            self.seen = buf_resize(self.seen, (self.seen_n + 1) * 2)
        self.seen[self.seen_n] = mid
        self.seen_n = self.seen_n + 1
        for i in 0..g.n:
            if g.mod[i] == mid && exported(g.kind[i]):
                self.import_row(g, i)
        for i in 0..g.n:
            if g.mod[i] == mid && g.kind[i] == int(Sk.Import):
                let t = g.find_module_row(i)
                if t >= 0:
                    self.import_all(g, t)

    /#/ Copies global row `i` into scope unless the same name is already imported.
    fn import_row(self, g: &Syms, i: int) => void:
        for k in 0..self.loc.n:
            if self.loc.hash[k] == g.hash[i] && self.loc.size[k] == g.size[i] && self.loc.mod[k] == g.mod[i] && self.loc.kind[k] == g.kind[i]:
                return
        self.loc.copy_row(g, i)

    /#/ Module-level duplicates: two top-level items with one name.
    fn top_duplicates(self, a: &Ast) => void:
        let it = a.child[a.root]
        while it >= 0:
            let name = self.item_name(a, it)
            if name >= 0 && a.kind[it] == int(Nk.Class) && tok_is(a, name, "Error"):
                self.diag(name, int(Sc.DuplicateName))
            if name >= 0:
                let o = a.child[a.root]
                while o != it:
                    let other = self.item_name(a, o)
                    if other >= 0 && same_tok(a, other, name):
                        if a.kind[it] == int(Nk.Fn) && tok_is(a, name, "main"):
                            self.diag(name, int(Sc.DuplicateMain))
                        else:
                            self.diag(name, int(Sc.DuplicateName))
                        break
                    o = a.next[o]
            it = a.next[it]

    fn item_name(self, a: &Ast, it: int) => int:
        let k = a.kind[it]
        if k == int(Nk.Fn) || k == int(Nk.Class) || k == int(Nk.Enum) || k == int(Nk.Let):
            return a.pa[it]
        return -1

    fn module(self, a: &Ast, g: &Syms, m: int) => void:
        self.cur = m
        self.prelude(a, g, m)
        self.top_duplicates(a)
        let it = a.child[a.root]
        while it >= 0:
            let k = a.kind[it]
            if k == int(Nk.Fn):
                self.function(a, g, it, false)
            elif k == int(Nk.Class):
                self.class_decl(a, g, it)
            elif k == int(Nk.Enum):
                self.enum_decl(a, g, it)
            elif k != int(Nk.Use):
                self.stmt(a, g, it)
            it = a.next[it]

/#/ A checker holding only the names module `m` sees (the module's own, imported ones and
/#/ the builtins): the scope the type checker reads signatures in.
fn scope_of(a: &Ast, g: &Syms, m: int) => Checker:
    let c = Checker { loc: new_syms(), diags: new_diags(), fn_base: 0, loops: 0, in_fn: 0, ret_void: true, cur: m, seen: new_buf(int, 8), seen_n: 0, capture_lo: -1, capture_named: true, cur_class: -1 }
    c.cur = m
    c.prelude(a, g, m)
    return c

/#/ Checks module `m` of `g` (see `declare_module`) whose tree is `a`; the findings are in
/#/ the result's `diags`.
fn check(a: &Ast, g: &Syms, m: int) => Checker:
    let c = Checker { loc: new_syms(), diags: new_diags(), fn_base: 0, loops: 0, in_fn: 0, ret_void: true, cur: m, seen: new_buf(int, 8), seen_n: 0, capture_lo: -1, capture_named: true, cur_class: -1 }
    c.module(a, g, m)
    return c



enum Ty:
    Error
    Void
    Bool
    Str
    Object
    Int
    Float
    Buf
    Slice
    Array
    Ref
    Tuple
    Fn
    Named
    Param

class Tys:
    kind: buf<int>
    a: buf<int>
    b: buf<int>
    c: buf<int>
    hash: buf<int>
    /#/ chains of types by hash: heads (type + 1) and next
    bh: buf<int>
    bn: buf<int>
    n: int
    args: buf<int>
    args_n: int
    /#/ the cursor of `from_ref`
    pos: int
    params: int
    /#/ 1 while the first `>` of a `>>` token has been taken
    half: int

    fn grow(self) => void:
        if self.n < len(self.kind):
            return
        let cap = (self.n + 1) * 2
        self.kind = buf_resize(self.kind, cap)
        self.a = buf_resize(self.a, cap)
        self.b = buf_resize(self.b, cap)
        self.c = buf_resize(self.c, cap)
        self.hash = buf_resize(self.hash, cap)
        self.bn = buf_resize(self.bn, cap)

    fn set_pos(self, p: int) => void:
        self.pos = p

    fn set_half(self, h: int) => void:
        self.half = h

    fn set_args_n(self, n: int) => void:
        self.args_n = n

    fn push_arg(self, t: int) => void:
        if self.args_n >= len(self.args):
            self.args = buf_resize(self.args, (self.args_n + 1) * 2)
        self.args[self.args_n] = t
        self.args_n = self.args_n + 1

    fn list_hash(self, start: int, count: int) => int:
        let h = 7
        for i in 0..count:
            h = (h * 31 + self.args[start + i] + 1) % 1000003
        return h

    /#/ The id of the type with these operands, adding it when new. For the list kinds the
    /#/ arguments were just pushed from `start`; an equal earlier list replaces them.
    fn intern(self, kind: int, a: int, b: int, c: int, start: int) => int:
        let list = kind == int(Ty.Tuple) || kind == int(Ty.Fn) || kind == int(Ty.Named)
        let count = 0
        if list:
            if kind == int(Ty.Named):
                count = c
            else:
                count = b
            a = a
        let h = (kind * 31 + a + 1) % 1000003
        h = (h * 31 + b + 1) % 1000003
        h = (h * 31 + c + 1) % 1000003
        if list:
            h = (h * 31 + self.list_hash(start, count)) % 1000003
        let j = self.bh[(h & 1073741823) % len(self.bh)] - 1
        while j >= 0:
            if self.hash[j] == h && self.kind[j] == kind:
                let same = false
                if list:
                    same = self.same_list(j, kind, a, b, c, start, count)
                else:
                    same = self.a[j] == a && self.b[j] == b && self.c[j] == c
                if same:
                    if list:
                        self.args_n = start
                    return j
            j = self.bn[j] - 1
        self.grow()
        let i = self.n
        self.kind[i] = kind
        if kind == int(Ty.Named):
            self.a[i] = a
            self.b[i] = start
            self.c[i] = count
        elif kind == int(Ty.Tuple) || kind == int(Ty.Fn):
            self.a[i] = start
            self.b[i] = count
            self.c[i] = c
        else:
            self.a[i] = a
            self.b[i] = b
            self.c[i] = c
        self.hash[i] = h
        self.bn[i] = self.bh[(h & 1073741823) % len(self.bh)]
        self.bh[(h & 1073741823) % len(self.bh)] = i + 1
        self.n = i + 1
        return i

    fn same_list(self, i: int, kind: int, a: int, b: int, c: int, start: int, count: int) => bool:
        if kind == int(Ty.Named):
            if self.a[i] != a || self.c[i] != count:
                return false
        else:
            if self.b[i] != count || self.c[i] != c:
                return false
        let at = self.b[i]
        if kind != int(Ty.Named):
            at = self.a[i]
        for k in 0..count:
            if self.args[at + k] != self.args[start + k]:
                return false
        return true

    fn simple(self, kind: int) => int:
        return self.intern(kind, 0, 0, 0, 0)

    fn int_ty(self, bytes: int, signed: bool) => int:
        let s = 0
        if signed:
            s = 1
        return self.intern(int(Ty.Int), bytes, s, 0, 0)

    fn float_ty(self, bytes: int) => int:
        return self.intern(int(Ty.Float), bytes, 0, 0, 0)

    fn buf_of(self, elem: int) => int:
        return self.intern(int(Ty.Buf), elem, 0, 0, 0)

    fn slice_of(self, elem: int) => int:
        return self.intern(int(Ty.Slice), elem, 0, 0, 0)

    fn array_of(self, elem: int, count: int) => int:
        return self.intern(int(Ty.Array), elem, count, 0, 0)

    fn ref_to(self, target: int, mutable: bool) => int:
        let m = 0
        if mutable:
            m = 1
        return self.intern(int(Ty.Ref), target, m, 0, 0)

    fn named(self, row: int) => int:
        return self.intern(int(Ty.Named), row, 0, 0, self.args_n)

    fn param_ty(self, number: int) => int:
        return self.intern(int(Ty.Param), number, 0, 0, 0)

    /#/ The nth argument of a list type.
    fn arg(self, t: int, i: int) => int:
        return self.args[self.args_n_of(t) + i]

    fn args_n_of(self, t: int) => int:
        if self.kind[t] == int(Ty.Named):
            return self.b[t]
        return self.a[t]

    fn count_of(self, t: int) => int:
        if self.kind[t] == int(Ty.Named):
            return self.c[t]
        return self.b[t]

    fn is_int(self, t: int) => bool:
        return self.kind[t] == int(Ty.Int)

    fn is_numeric(self, t: int) => bool:
        return self.kind[t] == int(Ty.Int) || self.kind[t] == int(Ty.Float)

    fn is_error(self, t: int) => bool:
        return self.kind[t] == int(Ty.Error)

    /#/ Resources move and are dropped; values are copied. A `&T` is a value.
    fn is_resource(self, t: int) => bool:
        let k = self.kind[t]
        if k == int(Ty.Str) || k == int(Ty.Buf) || k == int(Ty.Slice) || k == int(Ty.Object) || k == int(Ty.Named):
            return true
        if k == int(Ty.Array):
            return self.is_resource(self.a[t])
        if k == int(Ty.Tuple):
            for i in 0..self.b[t]:
                if self.is_resource(self.arg(t, i)):
                    return true
        return false

fn new_tys() => Tys:
    let t = Tys { kind: new_buf(int, 32), a: new_buf(int, 32), b: new_buf(int, 32), c: new_buf(int, 32), hash: new_buf(int, 32), bh: new_buf(int, 16384), bn: new_buf(int, 32), n: 0, args: new_buf(int, 32), args_n: 0, pos: 0, params: 0, half: 0 }
    /#/ id 0 is the Error type, so that a zeroed slot reads as "already reported"
    t.simple(int(Ty.Error))
    return t


/#/ The number spelled by integer token `tok`.
fn tok_number(a: &Ast, tok: int) => int:
    let n = 0
    for k in a.toks.start[tok]..a.toks.end[tok]:
        let b = a.byte_at(k)
        if b >= '0' && b <= '9':
            n = n * 10 + (b - '0')
    return n

/#/ Text built a byte at a time.
class Out:
    b: buf<int>
    n: int

    fn put_byte(self, c: int) => void:
        if self.n >= len(self.b):
            self.b = buf_resize(self.b, (self.n + 1) * 2)
        self.b[self.n] = c
        self.n = self.n + 1

    fn put(self, s: &str) => void:
        for i in 0..len(s):
            self.put_byte(byte(s, i))

    fn put_int(self, v: int) => void:
        if v < 0:
            self.put_byte('-')
            self.put_int(0 - v)
        elif v < 10:
            self.put_byte('0' + v)
        else:
            self.put_int(v // 10)
            self.put_byte('0' + v % 10)

    fn put_row(self, g: &Syms, i: int) => void:
        for k in 0..g.size[i]:
            self.put_byte(g.pool[g.off[i] + k])

    /#/ Does the text equal `want`?
    fn is(self, want: &str) => bool:
        if self.n != len(want):
            return false
        for i in 0..self.n:
            if self.b[i] != byte(want, i):
                return false
        return true

fn new_out() => Out:
    return Out { b: new_buf(int, 64), n: 0 }

/#/ Writes a readable spelling of type `x`, for messages and tests.
fn show(o: &Out, t: &Tys, g: &Syms, x: int) => void:
    if x < 0:
        o.put("_")
        return
    let k = t.kind[x]
    if k == int(Ty.Error):
        o.put("?")
    elif k == int(Ty.Void):
        o.put("void")
    elif k == int(Ty.Bool):
        o.put("bool")
    elif k == int(Ty.Str):
        o.put("str")
    elif k == int(Ty.Object):
        o.put("object")
    elif k == int(Ty.Int):
        o.put("int(")
        o.put_int(t.a[x])
        if t.b[x] == 1:
            o.put(")+")
        else:
            o.put(")-")
    elif k == int(Ty.Float):
        o.put("float(")
        o.put_int(t.a[x])
        o.put(")")
    elif k == int(Ty.Buf):
        if t.a[x] < 0:
            o.put("buf")
        else:
            o.put("buf<")
            show(o, t, g, t.a[x])
            o.put(">")
    elif k == int(Ty.Slice):
        o.put("[")
        show(o, t, g, t.a[x])
        o.put("]")
    elif k == int(Ty.Array):
        o.put("[")
        show(o, t, g, t.a[x])
        o.put("; ")
        o.put_int(t.b[x])
        o.put("]")
    elif k == int(Ty.Ref):
        if t.b[x] == 1:
            o.put("&mut ")
        else:
            o.put("&")
        show(o, t, g, t.a[x])
    elif k == int(Ty.Tuple):
        o.put("(")
        show_list(o, t, g, x)
        o.put(")")
    elif k == int(Ty.Fn):
        o.put("fn(")
        show_list(o, t, g, x)
        o.put(") => ")
        show(o, t, g, t.c[x])
    elif k == int(Ty.Named):
        o.put_row(g, t.a[x])
        if t.c[x] > 0:
            o.put("<")
            show_list(o, t, g, x)
            o.put(">")
    elif k == int(Ty.Param):
        o.put("T")
        o.put_int(t.a[x])
    else:
        o.put("?")

fn show_list(o: &Out, t: &Tys, g: &Syms, x: int) => void:
    for i in 0..t.count_of(x):
        if i > 0:
            o.put(", ")
        show(o, t, g, t.arg(x, i))


class Reader:
    sc: Checker

    /#/ The type spelled by the name `tok` in a scope: a builtin, class, enum or alias. Error when
    /#/ it names none of them (the analyzer reports that).
    fn named_ty(self, t: &Tys, a: &Ast, tok: int) => int:
        if tok_is(a, tok, "int") || tok_is(a, tok, "i64"):
            return t.int_ty(8, true)
        if tok_is(a, tok, "i8"):
            return t.int_ty(1, true)
        if tok_is(a, tok, "i16"):
            return t.int_ty(2, true)
        if tok_is(a, tok, "i32"):
            return t.int_ty(4, true)
        if tok_is(a, tok, "u8"):
            return t.int_ty(1, false)
        if tok_is(a, tok, "u16"):
            return t.int_ty(2, false)
        if tok_is(a, tok, "u32"):
            return t.int_ty(4, false)
        if tok_is(a, tok, "u64"):
            return t.int_ty(8, false)
        if tok_is(a, tok, "float") || tok_is(a, tok, "f64"):
            return t.float_ty(8)
        if tok_is(a, tok, "f32"):
            return t.float_ty(4)
        if tok_is(a, tok, "bool"):
            return t.simple(int(Ty.Bool))
        if tok_is(a, tok, "str") || tok_is(a, tok, "string"):
            return t.simple(int(Ty.Str))
        if tok_is(a, tok, "void"):
            return t.simple(int(Ty.Void))
        if tok_is(a, tok, "object"):
            return t.simple(int(Ty.Object))
        if tok_is(a, tok, "buf"):
            return t.buf_of(-1)
        let r = self.sc.loc.find_tok(a, tok, 0)
        if r < 0:
            return 0
        if self.sc.loc.kind[r] == int(Sk.Class) || self.sc.loc.kind[r] == int(Sk.Enum):
            return t.named(self.sc.loc.info[r])
        if self.sc.loc.kind[r] == int(Sk.Alias) && self.sc.loc.ty[r] >= 0:
            return self.sc.loc.ty[r]
        if self.sc.loc.kind[r] == int(Sk.TypeParam) && self.sc.loc.ty[r] >= 0:
            return self.sc.loc.ty[r]
        return 0

    /#/ Reads one type at `t.pos`.
    fn read_ty(self, t: &Tys, a: &Ast, end: int) => int:
        if t.pos >= end:
            return 0
        let k = a.toks.kind[t.pos]
        if k == int(Tk.Amp):
            t.set_pos(t.pos + 1)
            let mutable = false
            if t.pos < end && tok_is(a, t.pos, "mut"):
                mutable = true
                t.set_pos(t.pos + 1)
            let target = self.read_ty(t, a, end)
            return t.ref_to(target, mutable)
        if k == int(Tk.LBracket):
            t.set_pos(t.pos + 1)
            let elem = self.read_ty(t, a, end)
            let result = t.slice_of(elem)
            if t.pos < end && a.toks.kind[t.pos] == int(Tk.Semi):
                t.set_pos(t.pos + 1)
                let count = -1
                if t.pos < end && a.toks.kind[t.pos] == int(Tk.Int):
                    count = tok_number(a, t.pos)
                t.set_pos(t.pos + 1)
                result = t.array_of(elem, count)
            if t.pos < end && a.toks.kind[t.pos] == int(Tk.RBracket):
                t.set_pos(t.pos + 1)
            return result
        if k == int(Tk.LParen):
            t.set_pos(t.pos + 1)
            let items = self.read_list(t, a, end, int(Tk.RParen))
            /#/ `()` is the type of nothing
            if items == 0:
                return t.simple(int(Ty.Void))
            return t.intern(int(Ty.Tuple), 0, items, 0, t.args_n - items)
        if k == int(Tk.KwFn):
            t.set_pos(t.pos + 1)
            let items = 0
            if t.pos < end && a.toks.kind[t.pos] == int(Tk.LParen):
                t.set_pos(t.pos + 1)
                items = self.read_list(t, a, end, int(Tk.RParen))
            let start = t.args_n - items
            let ret = t.simple(int(Ty.Void))
            if t.pos < end && a.toks.kind[t.pos] == int(Tk.Arrow):
                t.set_pos(t.pos + 1)
                ret = self.read_ty(t, a, end)
            return t.intern(int(Ty.Fn), 0, items, ret, start)
        if k == int(Tk.KwInt) || k == int(Tk.KwFloat):
            let is_flt = k == int(Tk.KwFloat)
            t.set_pos(t.pos + 1)
            let bytes = 8
            let signed = true
            if t.pos + 2 < end && a.toks.kind[t.pos] == int(Tk.LParen) && a.toks.kind[t.pos + 1] == int(Tk.Int):
                bytes = tok_number(a, t.pos + 1)
                t.set_pos(t.pos + 3)
                if !is_flt && t.pos < end:
                    if a.toks.kind[t.pos] == int(Tk.Minus):
                        signed = false
                        t.set_pos(t.pos + 1)
                    elif a.toks.kind[t.pos] == int(Tk.Plus):
                        t.set_pos(t.pos + 1)
            if is_flt:
                return t.float_ty(bytes)
            return t.int_ty(bytes, signed)
        let name = t.pos
        t.set_pos(t.pos + 1)
        if t.pos < end && a.toks.kind[t.pos] == int(Tk.Lt):
            t.set_pos(t.pos + 1)
            let before = t.args_n
            let items = self.read_list(t, a, end, int(Tk.Gt))
            let start = t.args_n - items
            if tok_is(a, name, "buf") && items == 1:
                let elem = t.args[start]
                t.set_args_n(start)
                return t.buf_of(elem)
            let base = self.named_ty(t, a, name)
            if t.kind[base] == int(Ty.Named):
                return t.intern(int(Ty.Named), t.a[base], 0, items, start)
            t.set_args_n(before)
            return 0
        return self.named_ty(t, a, name)

    /#/ Reads comma-separated types up to the token `close`, pushes them as arguments and returns
    /#/ how many there were.
    fn read_list(self, t: &Tys, a: &Ast, end: int, close: int) => int:
        /#/ nested lists push their own arguments while this one is being read, so each
        /#/ element is collected first and pushed after
        let found = new_buf(int, 8)
        let count = 0
        while t.pos < end && a.toks.kind[t.pos] != close && !(close == int(Tk.Gt) && a.toks.kind[t.pos] == int(Tk.Shr)):
            let before = t.pos
            let item = self.read_ty(t, a, end)
            if count >= len(found):
                found = buf_resize(found, count * 2 + 2)
            found[count] = item
            count = count + 1
            if t.pos < end && a.toks.kind[t.pos] == int(Tk.Comma):
                t.set_pos(t.pos + 1)
            if t.pos == before:
                break
        if t.pos < end && close == int(Tk.Gt) && a.toks.kind[t.pos] == int(Tk.Shr):
            /#/ `>>` closes two lists: the first takes half of it, the second the rest
            if t.half == 1:
                t.set_half(0)
                t.set_pos(t.pos + 1)
            else:
                t.set_half(1)
        elif t.pos < end && a.toks.kind[t.pos] == close:
            t.set_pos(t.pos + 1)
        for i in 0..count:
            t.push_arg(found[i])
        return count

    /#/ The type a TypeRef node spells.
    fn from_ref(self, t: &Tys, a: &Ast, node: int) => int:
        if node < 0:
            return 0
        t.set_pos(a.tok[node])
        return self.read_ty(t, a, a.end[node])

    /#/ Gives the type parameters among `f`'s children the numbers 0, 1, … in `scope` and returns
    /#/ the scope mark to pop back to.
    fn bind_params(self, t: &Tys, a: &Ast, f: int) => int:
        let mark = self.sc.loc.n
        let k = 0
        let p = a.child[f]
        while p >= 0:
            if a.kind[p] == int(Nk.TypeParam):
                let r = self.sc.loc.add_tok(a, a.tok[p], int(Sk.TypeParam), -1, -1)
                self.sc.loc.ty[r] = t.param_ty(k)
                k = k + 1
            p = a.next[p]
        return mark

    /#/ The function type of `f` seen from `scope`; a method gets `&mut Class` first.
    fn fn_sig(self, t: &Tys, a: &Ast, f: int, class_ty: int) => int:
        let mark = self.bind_params(t, a, f)
        let items = new_buf(int, 8)
        let count = 0
        let p = a.child[f]
        while p >= 0:
            if a.kind[p] == int(Nk.Param):
                if count >= len(items):
                    items = buf_resize(items, count * 2)
                items[count] = self.from_ref(t, a, a.pa[p])
                count = count + 1
            elif a.kind[p] == int(Nk.SelfParam):
                /#/ `self` is the class itself (a method borrows it)
                if count >= len(items):
                    items = buf_resize(items, count * 2)
                if class_ty >= 0:
                    items[count] = class_ty
                else:
                    items[count] = 0
                count = count + 1
            p = a.next[p]
        let ret = t.simple(int(Ty.Void))
        if a.pb[f] >= 0:
            ret = self.from_ref(t, a, a.pb[f])
        let start = t.args_n
        for i in 0..count:
            t.push_arg(items[i])
        self.sc.loc.truncate(mark)
        return t.intern(int(Ty.Fn), 0, count, ret, start)

/#/ What the type checker reports. The numbers are the Rust compiler's.
enum Te:
    Mismatch
    UnknownType
    ArityMismatch
    InvalidOperation
    NotCallable
    FieldNotFound
    MethodNotFound
    VariantNotFound
    InvalidType
    ControlFlow
    NonExhaustive

fn te_number(code: int) => int:
    if code == int(Te.Mismatch):
        return 100
    if code == int(Te.UnknownType):
        return 101
    if code == int(Te.ArityMismatch):
        return 103
    if code == int(Te.InvalidOperation):
        return 104
    if code == int(Te.NotCallable):
        return 105
    if code == int(Te.FieldNotFound):
        return 106
    if code == int(Te.MethodNotFound):
        return 107
    if code == int(Te.VariantNotFound):
        return 108
    if code == int(Te.InvalidType):
        return 110
    if code == int(Te.ControlFlow):
        return 111
    return 112

/#/ A finding: the token it is about, its code and, for a mismatch, the two types.
class TDiags:
    tok: buf<int>
    code: buf<int>
    want: buf<int>
    found: buf<int>
    n: int

    fn add(self, tok: int, code: int, want: int, found: int) => void:
        if self.n >= len(self.tok):
            let cap = (self.n + 1) * 2
            self.tok = buf_resize(self.tok, cap)
            self.code = buf_resize(self.code, cap)
            self.want = buf_resize(self.want, cap)
            self.found = buf_resize(self.found, cap)
        self.tok[self.n] = tok
        self.code[self.n] = code
        self.want[self.n] = want
        self.found[self.n] = found
        self.n = self.n + 1

    fn count(self, code: int) => int:
        let c = 0
        for i in 0..self.n:
            if self.code[i] == code:
                c = c + 1
        return c

fn new_tdiags() => TDiags:
    return TDiags { tok: new_buf(int, 8), code: new_buf(int, 8), want: new_buf(int, 8), found: new_buf(int, 8), n: 0 }


/#/ The row of `g` that declares the member of class or enum `owner` named by `tok`, of kind
/#/ `kind`; -1 when there is none.
fn member_of(g: &Syms, a: &Ast, owner: int, tok: int, kind: int) => int:
    let s = a.toks.start[tok]
    let e = a.toks.end[tok]
    let h = g.span_hash(a, s, e)
    let best = -1
    let q = g.member_head(owner) - 1
    while q >= 0:
        if g.kind[q] == kind && (best < 0 || q < best) && g.same_span(q, a, s, e, h):
            best = q
        q = g.member_next(q) - 1
    return best

/#/ Declares the types of module `m`, whose tree is `a`. The modules it imports from must be
/#/ declared first.
/#/ Signatures of the bundled C functions go to their `Extern` rows (`info` is 1 for a variadic
/#/ one), once per table; they come from the `.cfc` text the way a module's own do.
fn declare_c(t: &Tys, g: &Syms) => void:
    for i in 0..g.n:
        if g.kind[i] == int(Sk.Extern) && g.mod[i] == -1 && g.ty[i] >= 0:
            return
    declare_c_lib(t, g, c_libc_source(), "libc.cfc", true)
    declare_c_lib(t, g, c_libm_source(), "libm.cfc", true)
    declare_error(t, g)

/#/ The fields of the builtin class `Error`: `code: int`, `note: str`, `e: object`.
fn declare_error(t: &Tys, g: &Syms) => void:
    for i in 0..g.n:
        if g.kind[i] == int(Sk.Class) && g.mod[i] == -1 && g.size[i] == 5 && g.pool[g.off[i]] == 'E' && g.pool[g.off[i] + 4] == 'r':
            for f in 0..g.n:
                if g.info[f] == i && g.kind[f] == int(Sk.Field) && g.mod[f] == -1:
                    let c = g.pool[g.off[f]]
                    if c == 'c':
                        g.ty[f] = t.int_ty(8, true)
                    elif c == 'n':
                        g.ty[f] = t.simple(int(Ty.Str))
                    else:
                        g.ty[f] = t.simple(int(Ty.Object))

/#/ The C functions a program's own `.cfc` text declares (the texts of all its C libraries
/#/ together): they become `Extern` rows like the bundled ones. A name the bundled tables have
/#/ keeps its signature.
fn declare_user_cfc(t: &Tys, g: &Syms, src: str, name: &str) => void:
    declare_c(t, g)
    declare_c_lib(t, g, src, name, false)

fn declare_c_lib(t: &Tys, g: &Syms, src: str, name: &str, bundled: bool) => void:
    let a = parse(src)
    let m = declare_module(g, &a, name)
    declare_module_types(t, g, &a, m)
    let it = a.child[a.root]
    /#/ a type the `.cfc` declares (`type FILE: object`) is visible to every program
    while it >= 0:
        if a.kind[it] == int(Nk.TypeAlias) && a.pa[it] >= 0:
            let r = g.find_in_module(&a, a.pa[it], m)
            if r >= 0 && g.ty[r] >= 0:
                let w = g.add_tok(&a, a.pa[it], int(Sk.Alias), -1, -1)
                g.ty[w] = g.ty[r]
        it = a.next[it]
    it = a.child[a.root]
    while it >= 0:
        if a.kind[it] == int(Nk.Fn) && a.pa[it] >= 0:
            let r = g.find_in_module(&a, a.pa[it], m)
            if r >= 0 && g.ty[r] >= 0:
                let sig = g.ty[r]
                let count = t.count_of(sig)
                let variadic = false
                if count > 0 && t.kind[t.arg(sig, count - 1)] == int(Ty.Object):
                    let last = a.child[it]
                    let name_tok = -1
                    while last >= 0:
                        if a.kind[last] == int(Nk.Param):
                            name_tok = a.tok[last]
                        last = a.next[last]
                    if name_tok >= 0 && tok_is(&a, name_tok, "args"):
                        variadic = true
                if variadic:
                    let start = t.args_n
                    for k in 0..count - 1:
                        t.push_arg(t.arg(sig, k))
                    sig = t.intern(int(Ty.Fn), 0, count - 1, t.c[sig], start)
                let tk = a.pa[it]
                let h = g.span_hash(&a, a.toks.start[tk], a.toks.end[tk])
                let known = false
                for e in 0..g.n:
                    if g.kind[e] == int(Sk.Extern) && g.mod[e] == -1 && g.same_span(e, &a, a.toks.start[tk], a.toks.end[tk], h):
                        known = true
                if !known:
                    g.add_tok(&a, tk, int(Sk.Extern), -1, -1)
                for e in 0..g.n:
                    if g.kind[e] == int(Sk.Extern) && g.mod[e] == -1 && g.same_span(e, &a, a.toks.start[tk], a.toks.end[tk], h):
                        if bundled || g.ty[e] < 0:
                            g.ty[e] = sig
                            if variadic:
                                g.info[e] = 1
        it = a.next[it]

fn declare_types(t: &Tys, g: &Syms, a: &Ast, m: int) => void:
    declare_c(t, g)
    declare_module_types(t, g, a, m)

fn declare_module_types(t: &Tys, g: &Syms, a: &Ast, m: int) => void:
    let rd = Reader { sc: scope_of(a, g, m) }
    let it = a.child[a.root]
    /#/ aliases first: signatures may spell them
    while it >= 0:
        if a.kind[it] == int(Nk.TypeAlias) && a.pa[it] >= 0:
            let r = g.find_in_module(a, a.pa[it], m)
            let aty = rd.from_ref(t, a, a.pb[it])
            if r >= 0:
                g.ty[r] = aty
            let s = rd.sc.loc.find_tok(a, a.pa[it], 0)
            if s >= 0:
                rd.sc.loc.ty[s] = aty
        it = a.next[it]
    it = a.child[a.root]
    while it >= 0:
        let k = a.kind[it]
        if k == int(Nk.Fn) && a.pa[it] >= 0:
            let r = g.find_in_module(a, a.pa[it], m)
            if r >= 0:
                g.ty[r] = rd.fn_sig(t, a, it, -1)
        elif k == int(Nk.Class) && a.pa[it] >= 0:
            declare_class(t, g, &rd, a, it, m)
        elif k == int(Nk.Enum) && a.pa[it] >= 0:
            declare_enum(t, g, &rd, a, it, m)
        elif k == int(Nk.Let) && a.pa[it] >= 0 && a.pb[it] >= 0:
            let r = g.find_in_module(a, a.pa[it], m)
            if r >= 0:
                g.ty[r] = rd.from_ref(t, a, a.pb[it])
        it = a.next[it]

fn count_params(a: &Ast, f: int) => int:
    let k = 0
    let p = a.child[f]
    while p >= 0:
        if a.kind[p] == int(Nk.TypeParam):
            k = k + 1
        p = a.next[p]
    return k

/#/ The type of `self` in a method of class row `ci`: the class, applied to its own type
/#/ parameters when it has some.
fn self_type(t: &Tys, g: &Syms, ci: int) => int:
    let n = g.ty[ci]
    if n <= 0:
        return t.named(g.info[ci])
    let start = t.args_n
    for i in 0..n:
        t.push_arg(t.param_ty(i))
    return t.intern(int(Ty.Named), g.info[ci], 0, n, start)

fn declare_class(t: &Tys, g: &Syms, rd: &Reader, a: &Ast, cl: int, m: int) => void:
    let ci = g.find_in_module(a, a.pa[cl], m)
    if ci < 0:
        return
    /#/ the class row's `ty` is its number of type parameters
    g.ty[ci] = count_params(a, cl)
    let self_ty = self_type(t, g, ci)
    let mark = rd.bind_params(t, a, cl)
    let f = a.child[cl]
    while f >= 0:
        if a.kind[f] == int(Nk.Field):
            let r = member_of(g, a, ci, a.tok[f], int(Sk.Field))
            if r >= 0:
                g.ty[r] = rd.from_ref(t, a, a.pa[f])
        elif a.kind[f] == int(Nk.Fn) && a.pa[f] >= 0:
            let r = member_of(g, a, ci, a.pa[f], int(Sk.Method))
            if r >= 0:
                g.ty[r] = rd.fn_sig(t, a, f, self_ty)
        f = a.next[f]
    rd.sc.loc.truncate(mark)

/#/ A variant is a value of the enum, or a function from its payload to the enum.
fn declare_enum(t: &Tys, g: &Syms, rd: &Reader, a: &Ast, en: int, m: int) => void:
    let ei = g.find_in_module(a, a.pa[en], m)
    if ei < 0:
        return
    let enum_ty = t.named(g.info[ei])
    let v = a.child[en]
    while v >= 0:
        if a.kind[v] == int(Nk.Variant):
            let r = member_of(g, a, ei, a.tok[v], int(Sk.Variant))
            let items = new_buf(int, 4)
            let count = 0
            let f = a.child[v]
            while f >= 0:
                if a.kind[f] == int(Nk.VField):
                    if count >= len(items):
                        items = buf_resize(items, count * 2)
                    items[count] = rd.from_ref(t, a, a.pa[f])
                    count = count + 1
                f = a.next[f]
            if r >= 0:
                if count == 0:
                    g.ty[r] = enum_ty
                else:
                    let start = t.args_n
                    for i in 0..count:
                        t.push_arg(items[i])
                    g.ty[r] = t.intern(int(Ty.Fn), 0, count, enum_ty, start)
        v = a.next[v]


enum Own:
    Copy
    Move
    Borrow
    Unknown

enum Drop:
    Nothing
    Free
    Elems
    Fields
    Variant
    Unknown

enum Clone:
    Bit
    Deep
    Shallow
    Never
    Unknown

/#/ `ty` with the type parameters replaced by the type arguments of `env`, a `Name<A, B>`.
fn subst_env(t: &Tys, ty: int, env: int) => int:
    if env < 0 || ty < 0 || t.kind[env] != int(Ty.Named):
        return ty
    let k = t.kind[ty]
    if k == int(Ty.Param):
        if t.a[ty] < t.count_of(env):
            return t.arg(env, t.a[ty])
        return 0
    if k == int(Ty.Ref):
        return t.ref_to(subst_env(t, t.a[ty], env), t.b[ty] == 1)
    if k == int(Ty.Slice):
        return t.slice_of(subst_env(t, t.a[ty], env))
    if k == int(Ty.Buf):
        if t.a[ty] < 0:
            return ty
        return t.buf_of(subst_env(t, t.a[ty], env))
    if k == int(Ty.Array):
        return t.array_of(subst_env(t, t.a[ty], env), t.b[ty])
    if k == int(Ty.Tuple) || k == int(Ty.Fn) || k == int(Ty.Named):
        let count = t.count_of(ty)
        let items = new_buf(int, count + 1)
        for i in 0..count:
            items[i] = subst_env(t, t.arg(ty, i), env)
        let start = t.args_n
        for i in 0..count:
            t.push_arg(items[i])
        if k == int(Ty.Tuple):
            return t.intern(int(Ty.Tuple), 0, count, 0, start)
        if k == int(Ty.Fn):
            return t.intern(int(Ty.Fn), 0, count, subst_env(t, t.c[ty], env), start)
        return t.intern(int(Ty.Named), t.a[ty], 0, count, start)
    return ty

/#/ Does enum `e` (a row of `g`) have a variant that carries values?
fn has_payload(t: &Tys, g: &Syms, e: int) => bool:
    let q = g.member_head(e) - 1
    while q >= 0:
        if g.kind[q] == int(Sk.Variant) && g.ty[q] >= 0 && t.kind[g.ty[q]] == int(Ty.Fn):
            return true
        q = g.member_next(q) - 1
    return false

/#/ Is the value of `x` a single pointer to a block it stands for?
fn is_handle(t: &Tys, g: &Syms, x: int) => bool:
    let k = t.kind[x]
    if k == int(Ty.Str) || k == int(Ty.Object) || k == int(Ty.Array):
        return true
    if k == int(Ty.Buf):
        return t.a[x] < 0
    if k == int(Ty.Named):
        if g.kind[t.a[x]] == int(Sk.Enum):
            return has_payload(t, g, t.a[x])
        return true
    return false

fn align_up(n: int, a: int) => int:
    if a <= 1:
        return n
    return (n + a - 1) // a * a

/#/ The alignment of a value of `x`; 1 when it has none.
fn st_align(t: &Tys, g: &Syms, x: int) => int:
    let k = t.kind[x]
    if k == int(Ty.Void) || k == int(Ty.Bool) || k == int(Ty.Error):
        return 1
    if k == int(Ty.Int) || k == int(Ty.Float):
        return t.a[x]
    if k == int(Ty.Tuple):
        let a = 1
        for i in 0..t.count_of(x):
            let fa = st_align(t, g, t.arg(x, i))
            if fa > a:
                a = fa
        return a
    return 8

/#/ The size of a value of `x`: what it takes in a register, a variable or a field.
fn st_size(t: &Tys, g: &Syms, x: int) => int:
    let k = t.kind[x]
    if k == int(Ty.Void) || k == int(Ty.Error):
        return 0
    if k == int(Ty.Bool):
        return 1
    if k == int(Ty.Int) || k == int(Ty.Float):
        return t.a[x]
    if k == int(Ty.Slice):
        return 16
    if k == int(Ty.Buf):
        if t.a[x] < 0:
            return 8
        return 16
    if k == int(Ty.Tuple):
        let n = 0
        for i in 0..t.count_of(x):
            let f = t.arg(x, i)
            n = align_up(n, st_align(t, g, f)) + st_size(t, g, f)
        return align_up(n, st_align(t, g, x))
    if k == int(Ty.Named) && g.kind[t.a[x]] == int(Sk.Enum) && !has_payload(t, g, t.a[x]):
        return 8
    return 8

/#/ The size of the block a handle points at; -1 when it is not known statically.
fn st_block(t: &Tys, g: &Syms, x: int) => int:
    let k = t.kind[x]
    if k == int(Ty.Array):
        if t.b[x] < 0:
            return -1
        return t.b[x] * st_size(t, g, t.a[x])
    if k == int(Ty.Named):
        if g.kind[t.a[x]] == int(Sk.Enum):
            return enum_block(t, g, x)
        return class_block(t, g, x, 0)
    return -1

/#/ A class's block: the fields of its ancestors, then its own. `mode` 0 gives the size, 1 the
/#/ alignment.
fn class_block(t: &Tys, g: &Syms, x: int, mode: int) => int:
    let chain = new_buf(int, 8)
    let n = 0
    let cur = t.a[x]
    while cur >= 0 && n < 8:
        chain[n] = cur
        n = n + 1
        let next = -1
        for i in 0..g.n:
            if g.info[i] == cur && g.kind[i] == int(Sk.Parent):
                next = g.find_class_row(i)
        cur = next
    let size = 0
    let align = 1
    let c = n - 1
    while c >= 0:
        for i in 0..g.n:
            if g.info[i] == chain[c] && g.kind[i] == int(Sk.Field) && g.ty[i] >= 0:
                let f = subst_env(t, g.ty[i], x)
                let fa = st_align(t, g, f)
                size = align_up(size, fa) + st_size(t, g, f)
                if fa > align:
                    align = fa
        c = c - 1
    if mode == 1:
        return align
    return align_up(size, align)

/#/ An enum with payloads is `{i64 tag, payload}`, as big as its biggest variant.
fn enum_block(t: &Tys, g: &Syms, x: int) => int:
    let best = 8
    for i in 0..g.n:
        if g.info[i] == t.a[x] && g.kind[i] == int(Sk.Variant) && g.ty[i] >= 0 && t.kind[g.ty[i]] == int(Ty.Fn):
            let v = g.ty[i]
            let n = 8
            for k in 0..t.count_of(v):
                let f = subst_env(t, t.arg(v, k), x)
                n = align_up(n, st_align(t, g, f)) + st_size(t, g, f)
            n = align_up(n, 8)
            if n > best:
                best = n
    return best

/#/ Copy, move or borrow.
fn st_own(t: &Tys, g: &Syms, x: int) => int:
    let k = t.kind[x]
    if k == int(Ty.Void) || k == int(Ty.Bool) || k == int(Ty.Int) || k == int(Ty.Float) || k == int(Ty.Fn):
        return int(Own.Copy)
    if k == int(Ty.Ref):
        return int(Own.Borrow)
    if k == int(Ty.Str) || k == int(Ty.Object) || k == int(Ty.Buf) || k == int(Ty.Slice):
        return int(Own.Move)
    if k == int(Ty.Array):
        return st_own(t, g, t.a[x])
    if k == int(Ty.Tuple):
        for i in 0..t.count_of(x):
            if st_own(t, g, t.arg(x, i)) != int(Own.Copy):
                return int(Own.Move)
        return int(Own.Copy)
    if k == int(Ty.Named):
        if g.kind[t.a[x]] == int(Sk.Enum) && !has_payload(t, g, t.a[x]):
            return int(Own.Copy)
        return int(Own.Move)
    return int(Own.Unknown)

/#/ What dropping a value of `x` does.
fn st_drop(t: &Tys, g: &Syms, x: int) => int:
    let k = t.kind[x]
    if k == int(Ty.Void) || k == int(Ty.Bool) || k == int(Ty.Int) || k == int(Ty.Float) || k == int(Ty.Fn) || k == int(Ty.Ref) || k == int(Ty.Object):
        return int(Drop.Nothing)
    if k == int(Ty.Str) || k == int(Ty.Buf):
        return int(Drop.Free)
    if k == int(Ty.Slice):
        return int(Drop.Elems)
    if k == int(Ty.Array):
        if st_own(t, g, x) == int(Own.Copy):
            return int(Drop.Nothing)
        return int(Drop.Elems)
    if k == int(Ty.Tuple):
        if st_own(t, g, x) == int(Own.Copy):
            return int(Drop.Nothing)
        return int(Drop.Fields)
    if k == int(Ty.Named):
        if g.kind[t.a[x]] == int(Sk.Enum):
            if has_payload(t, g, t.a[x]):
                return int(Drop.Variant)
            return int(Drop.Nothing)
        return int(Drop.Fields)
    return int(Drop.Unknown)

/#/ What `clone` of a value of `x` does.
fn st_clone(t: &Tys, g: &Syms, x: int) => int:
    let k = t.kind[x]
    if st_own(t, g, x) == int(Own.Copy):
        return int(Clone.Bit)
    if k == int(Ty.Buf):
        return int(Clone.Never)
    if k == int(Ty.Object) || k == int(Ty.Ref) || k == int(Ty.Slice):
        return int(Clone.Shallow)
    if k == int(Ty.Str) || k == int(Ty.Array) || k == int(Ty.Tuple) || k == int(Ty.Named):
        return int(Clone.Deep)
    return int(Clone.Unknown)

/#/ The LLVM type of a value of `x`, spelled out.
fn st_repr(o: &Out, t: &Tys, g: &Syms, x: int) => void:
    let k = t.kind[x]
    if k == int(Ty.Void):
        o.put("none")
    elif k == int(Ty.Bool):
        o.put("i8")
    elif k == int(Ty.Int):
        o.put("i")
        o.put_int(t.a[x] * 8)
    elif k == int(Ty.Float):
        o.put("f")
        o.put_int(t.a[x] * 8)
    elif k == int(Ty.Slice) || (k == int(Ty.Buf) && t.a[x] >= 0):
        o.put("{ptr, i64}")
    elif k == int(Ty.Tuple):
        o.put("{")
        for i in 0..t.count_of(x):
            if i > 0:
                o.put(", ")
            st_repr(o, t, g, t.arg(x, i))
        o.put("}")
    elif k == int(Ty.Named) && g.kind[t.a[x]] == int(Sk.Enum) && !has_payload(t, g, t.a[x]):
        o.put("i64")
    elif k == int(Ty.Error) || k == int(Ty.Param):
        o.put("?")
    else:
        o.put("ptr")

fn put_own(o: &Out, own: int) => void:
    if own == int(Own.Copy):
        o.put("copy")
        return
    if own == int(Own.Move):
        o.put("move")
        return
    if own == int(Own.Borrow):
        o.put("borrow")
        return
    o.put("?")

fn put_drop(o: &Out, d: int) => void:
    if d == int(Drop.Nothing):
        o.put("nothing")
        return
    if d == int(Drop.Free):
        o.put("free")
        return
    if d == int(Drop.Elems):
        o.put("elems")
        return
    if d == int(Drop.Fields):
        o.put("fields")
        return
    if d == int(Drop.Variant):
        o.put("variant")
        return
    o.put("?")

fn put_clone(o: &Out, c: int) => void:
    if c == int(Clone.Bit):
        o.put("bit")
        return
    if c == int(Clone.Deep):
        o.put("deep")
        return
    if c == int(Clone.Shallow):
        o.put("shallow")
        return
    if c == int(Clone.Never):
        o.put("never")
        return
    o.put("?")

/#/ `repr size/align own drop clone`, and `block N` for a handle with a known block.
fn describe(o: &Out, t: &Tys, g: &Syms, x: int) => void:
    st_repr(o, t, g, x)
    o.put(" ")
    o.put_int(st_size(t, g, x))
    o.put("/")
    o.put_int(st_align(t, g, x))
    o.put(" ")
    put_own(o, st_own(t, g, x))
    o.put(" ")
    put_drop(o, st_drop(t, g, x))
    o.put(" ")
    put_clone(o, st_clone(t, g, x))
    if is_handle(t, g, x) && st_block(t, g, x) >= 0:
        o.put(" block ")
        o.put_int(st_block(t, g, x))



class DbgTypes:
    done: buf<int>
    n: int
    out: Txt

fn new_dbg_types() => DbgTypes:
    return DbgTypes { done: new_buf(int, 64), n: 0, out: new_txt() }

/#/ Is the id new? Then it is entered.
fn dbg_new(d: &DbgTypes, id: int) => bool:
    for i in 0..d.n:
        if d.done[i] == id:
            return false
    if d.n >= len(d.done):
        d.done = buf_resize(d.done, (d.n + 1) * 2)
    d.done[d.n] = id
    d.n = d.n + 1
    return true

fn dbg_int(d: &DbgTypes) => int:
    if dbg_new(d, 3000000):
        d.out.put("T 3000000 i 8 1\n")
    return 3000000

fn dbg_ptr(d: &DbgTypes, id: int, target: int) => void:
    d.out.put("T ")
    d.out.put_int(id)
    d.out.put(" p ")
    d.out.put_int(target)
    d.out.put_byte(10)

fn dbg_put_name(d: &DbgTypes, g: &Syms, row: int) => void:
    for k in 0..g.size[row]:
        d.out.put_byte(g.pool[g.off[row] + k])

/#/ A pair of pointer and length as a struct.
fn dbg_pair(d: &DbgTypes, id: int, name: &str, elem: int) => void:
    let li = dbg_int(d)
    let pid = 2000000 + elem
    if dbg_new(d, pid):
        dbg_ptr(d, pid, elem)
    d.out.put("T ")
    d.out.put_int(id)
    d.out.put(" S ")
    d.out.put(name)
    d.out.put(" 16 2 ptr:")
    d.out.put_int(pid)
    d.out.put(":0 len:")
    d.out.put_int(li)
    d.out.put(":8\n")

/#/ The struct line of class `x` (the fields of its ancestors first), and the types of its fields.
fn dbg_class(d: &DbgTypes, t: &Tys, g: &Syms, x: int) => void:
    let chain = new_buf(int, 8)
    let n = 0
    let cur = t.a[x]
    while cur >= 0 && n < 8:
        chain[n] = cur
        n = n + 1
        let next = -1
        for i in 0..g.n:
            if g.info[i] == cur && g.kind[i] == int(Sk.Parent):
                next = g.find_class_row(i)
        cur = next
    let fields = new_txt()
    let nf = 0
    let size = 0
    let c = n - 1
    while c >= 0:
        for i in 0..g.n:
            if g.info[i] == chain[c] && g.kind[i] == int(Sk.Field) && g.ty[i] >= 0:
                let f = subst_env(t, g.ty[i], x)
                let fid = dbg_type(d, t, g, f)
                size = align_up(size, st_align(t, g, f))
                fields.put_byte(32)
                for k in 0..g.size[i]:
                    fields.put_byte(g.pool[g.off[i] + k])
                fields.put_byte(58)
                fields.put_int(fid)
                fields.put_byte(58)
                fields.put_int(size)
                size = size + st_size(t, g, f)
                nf = nf + 1
        c = c - 1
    d.out.put("T ")
    d.out.put_int(x)
    d.out.put(" S ")
    dbg_put_name(d, g, t.a[x])
    d.out.put_byte(32)
    d.out.put_int(align_up(size, st_align(t, g, x)))
    d.out.put_byte(32)
    d.out.put_int(nf)
    d.out.put_all(&fields)
    d.out.put_byte(10)

/#/ The block of enum `x` that has payloads: the tag, and each variant's payload over the same bytes
/#/ (only the variant the tag names holds values).
fn dbg_enum(d: &DbgTypes, t: &Tys, g: &Syms, x: int) => void:
    let row = t.a[x]
    let li = dbg_int(d)
    let members = new_txt()
    let nm = 0
    for v in 0..g.n:
        if g.info[v] == row && g.kind[v] == int(Sk.Variant):
            let sig = g.ty[v]
            if sig >= 0 && t.kind[sig] == int(Ty.Fn) && t.count_of(sig) > 0:
                let fields = new_txt()
                let off = 8
                for i in 0..t.count_of(sig):
                    let ft = subst_env(t, t.arg(sig, i), x)
                    let fid = dbg_type(d, t, g, ft)
                    off = align_up(off, st_align(t, g, ft))
                    fields.put(" _")
                    fields.put_int(i)
                    fields.put_byte(58)
                    fields.put_int(fid)
                    fields.put_byte(58)
                    fields.put_int(off)
                    off = off + st_size(t, g, ft)
                let sid = 5000000 + x * 64 + nm
                d.out.put("T ")
                d.out.put_int(sid)
                d.out.put(" S ")
                dbg_put_name(d, g, v)
                d.out.put_byte(32)
                d.out.put_int(off)
                d.out.put_byte(32)
                d.out.put_int(t.count_of(sig))
                d.out.put_all(&fields)
                d.out.put_byte(10)
                members.put_byte(32)
                for k in 0..g.size[v]:
                    members.put_byte(g.pool[g.off[v] + k])
                members.put_byte(58)
                members.put_int(sid)
                members.put(":0")
                nm = nm + 1
    d.out.put("T ")
    d.out.put_int(4000000 + x)
    d.out.put(" S ")
    dbg_put_name(d, g, row)
    d.out.put_byte(32)
    d.out.put_int(st_block(t, g, x))
    d.out.put_byte(32)
    d.out.put_int(nm + 1)
    d.out.put(" tag:")
    d.out.put_int(li)
    d.out.put(":0")
    d.out.put_all(&members)
    d.out.put_byte(10)

/#/ Describes type `x` and what it names, once; the id a variable of this type has.
fn dbg_type(d: &DbgTypes, t: &Tys, g: &Syms, x: int) => int:
    let k = t.kind[x]
    if k == int(Ty.Void) || k == int(Ty.Error):
        return 0 - 1
    let id = x
    if k == int(Ty.Named) && g.kind[t.a[x]] != int(Sk.Enum):
        id = 1000000 + x
    if !dbg_new(d, id):
        return id
    if k == int(Ty.Int):
        d.out.put("T ")
        d.out.put_int(id)
        d.out.put(" i ")
        d.out.put_int(t.a[x])
        d.out.put_byte(32)
        d.out.put_int(t.b[x])
        d.out.put_byte(10)
    elif k == int(Ty.Float):
        d.out.put("T ")
        d.out.put_int(id)
        d.out.put(" f ")
        d.out.put_int(t.a[x])
        d.out.put_byte(10)
    elif k == int(Ty.Bool):
        d.out.put("T ")
        d.out.put_int(id)
        d.out.put(" b\n")
    elif k == int(Ty.Str):
        d.out.put("T ")
        d.out.put_int(id)
        d.out.put(" s\n")
    elif k == int(Ty.Ref):
        let inner = t.a[x]
        let target = dbg_type(d, t, g, inner)
        if t.kind[inner] == int(Ty.Named) && g.kind[t.a[inner]] != int(Sk.Enum):
            /#/ a reference to a class is the class's own pointer
            target = inner
        elif t.kind[inner] == int(Ty.Named) && has_payload(t, g, t.a[inner]):
            target = 4000000 + inner
        dbg_ptr(d, id, target)
    elif k == int(Ty.Array):
        let target = dbg_type(d, t, g, t.a[x])
        dbg_ptr(d, id, target)
    elif k == int(Ty.Buf) && t.a[x] >= 0:
        let elem = dbg_type(d, t, g, t.a[x])
        dbg_pair(d, id, "buf", elem)
    elif k == int(Ty.Slice):
        let elem = dbg_type(d, t, g, t.a[x])
        dbg_pair(d, id, "slice", elem)
    elif k == int(Ty.Tuple):
        let fields = new_txt()
        let off = 0
        for i in 0..t.count_of(x):
            let f = t.arg(x, i)
            let fid = dbg_type(d, t, g, f)
            off = align_up(off, st_align(t, g, f))
            fields.put(" _")
            fields.put_int(i)
            fields.put_byte(58)
            fields.put_int(fid)
            fields.put_byte(58)
            fields.put_int(off)
            off = off + st_size(t, g, f)
        d.out.put("T ")
        d.out.put_int(id)
        d.out.put(" S tuple ")
        d.out.put_int(st_size(t, g, x))
        d.out.put_byte(32)
        d.out.put_int(t.count_of(x))
        d.out.put_all(&fields)
        d.out.put_byte(10)
    elif k == int(Ty.Named) && g.kind[t.a[x]] == int(Sk.Enum):
        if has_payload(t, g, t.a[x]):
            dbg_ptr(d, id, 4000000 + x)
            if dbg_new(d, 4000000 + x):
                dbg_enum(d, t, g, x)
        else:
            d.out.put("T ")
            d.out.put_int(id)
            d.out.put(" i 8 0\n")
    elif k == int(Ty.Named):
        /#/ the variable holds a pointer to the struct
        dbg_ptr(d, id, x)
        if dbg_new(d, x):
            dbg_class(d, t, g, x)
    elif k == int(Ty.Object) || k == int(Ty.Buf):
        dbg_ptr(d, id, 0 - 1)
    else:
        d.out.put("T ")
        d.out.put_int(id)
        d.out.put(" o ")
        d.out.put_int(st_size(t, g, x))
        d.out.put_byte(10)
    return id


/#/ The places of the lines of the flattened text and the line tables of the code, which the code generator fills for debuggers and profilers (shared by all targets).


/#/ x86-64: which registers a value may live in, the allocation of them over live ranges, the frame layout and the moves along edges. The machine's facts (the pool, the caller-saved slots, call masks) are in target_x86.cf.


/#/ x86-64: the System V calling convention, passing arguments and taking results.



/#/ x86-64: the machine instructions of each IR operation, and the loads and stores of operands.




/#/ x86-64: the vector loop (`VLoop`) as SSE2.





/#/ x86-64: one function (prologue, blocks, epilogue), and the object file.










fn g_elf(g: &Gen) => Txt:
    return write_elf(&g.o, &g.a)

/#/ The saved registers come back by pop, from below the frame's locals.
fn g_epilogue(g: &Gen) => void:
    if g.sframe > 0:
        g.a.add_ri(14, g.sframe)
    if g.nsaved > 0:
        if g.frame > g.rbase + 8 * g.nsaved:
            g.a.lea(4, 5, 0 - g.rbase - 8 * g.nsaved)
        let k = g.nsaved - 1
        while k >= 0:
            g.a.pop(g.saved[k])
            k = k - 1
    g.a.leave()
    g.a.ret()

/#/ Generates function `f`; returns false if something could not be translated.
fn g_gen_fun(g: &Gen, f: &Fun, rs: &Reps, sy: &Names) => bool:
    g.err = 0
    g.rbase = 0
    if f.ret >= rp_first_agg():
        g.rbase = 8
    g.a.begin_fun()
    g.nfk = 0
    g.nfu = 0
    let nm = new_txt()
    for k in 0..len(f.nm):
        nm.put_byte(f.nm[k])
    g.fsym = g.o.sym(&nm)
    if len(g.ord) < f.nb + 1:
        g.ord = new_buf(int, f.nb + 1)
        g.emit = new_buf(int, f.nb + 1)
    /#/ the registers are given along the plain order (a header before its loop), the code is
    /#/ written in the rotated one
    block_order(f, &g.ord, false)
    block_order(f, &g.emit, true)
    g_alloc_regs(g, f, rs)
    g_count_uses(g, f)
    g_layout(g, f, rs)
    let start = g.a.pos()
    for b in 0..f.nb:
        g.a.new_label()
    g.a.push(5)
    g.a.mov_rr(5, 4)
    /#/ [rbp-8] is the place of the pointer for a returned aggregate (rdi); the saved registers
    /#/ follow, then the locals
    if g.rbase > 0:
        g.a.push(7)
    for k in 0..g.nsaved:
        g.a.push(g.saved[k])
    if g.frame > g.rbase + 8 * g.nsaved:
        g.a.sub_ri(4, g.frame - g.rbase - 8 * g.nsaved)
    if g.sframe > 0:
        g.a.sub_ri(14, g.sframe)
    let nret = 0
    for b in 0..f.nb:
        if f.blast[b] >= 0 && f.op[f.blast[b]] == int(Op.Ret):
            nret = nret + 1
    g.epi_jump = g.nsaved > 0 && nret > 1
    g.epi = g.a.new_label()
    /#/ the parameters of the entry block
    let ci = 0
    let cx = 0
    let cs = 0
    if f.ret >= rp_first_agg():
        ci = 1
    let p = f.pfirst[0]
    while p >= 0:
        let r = f.rep[p]
        if r >= rp_first_agg() || g_is_int_class(g, r):
            if ci < 6:
                if r >= rp_first_agg():
                    g_copy_mem(g, g_vb(g, p), 0 - g.voff[p], int_reg(ci), 0, rsize(rs, r))
                else:
                    g_st(g, p, int_reg(ci))
            else:
                g.a.load(0, 5, 16 + 8 * cs, 8)
                if r >= rp_first_agg():
                    g.a.mov_rr(6, 0)
                    g_copy_mem(g, g_vb(g, p), 0 - g.voff[p], 6, 0, rsize(rs, r))
                else:
                    g_st(g, p, 0)
                cs = cs + 1
            ci = ci + 1
        else:
            if cx < 8:
                if g.xhome[p] >= 0:
                    g.a.movaps(g.xhome[p], cx)
                else:
                    g.a.movq_r(0, cx, r == int(Rp.F32))
                    g_st(g, p, 0)
            else:
                g.a.load(0, 5, 16 + 8 * cs, 8)
                g_st(g, p, 0)
                cs = cs + 1
            cx = cx + 1
        p = f.nx[p]
    for k in 0..g.nhc:
        let c = g.hc[k]
        if g.xhome[c] >= 0:
            g_ld(g, 0, f, c)
            g.a.movq_x(g.xhome[c], 0, f.rep[c] == int(Rp.F32))
        elif g.home[c] >= 0:
            /#/ a constant that only a store or a call argument reads got a general register
            g_ld(g, g.home[c], f, c)
    g.mk_n = 0
    let last_ln = 0
    for oi in 0..f.nb:
        let b = g.emit[oi]
        g.a.bind(b)
        let i = f.bfirst[b]
        while i >= 0:
            if f.ln[i] > 0 && f.ln[i] != last_ln:
                last_ln = f.ln[i]
                if g.mk_n >= len(g.mk_l):
                    g.mk_l = buf_resize(g.mk_l, (g.mk_n + 1) * 2)
                    g.mk_ln = buf_resize(g.mk_ln, (g.mk_n + 1) * 2)
                let ml = g.a.mark()
                g.mk_l[g.mk_n] = ml
                g.mk_ln[g.mk_n] = last_ln
                g.mk_n = g.mk_n + 1
            let nxt = -1
            if f.nx[i] < 0 && oi + 1 < f.nb:
                nxt = g.emit[oi + 1]
            g_gen_inst(g, f, rs, sy, i, nxt)
            i = f.nx[i]
    if g.epi_jump:
        g.a.bind(g.epi)
        g_epilogue(g)
    if g.nfk > 0:
        while (g.a.pos() - start) % 8 != 0:
            g.a.byte(204)
        for k in 0..g.nfk:
            g.a.bind(g.fk_lab[k])
            g.a.le64(g.fk_bits[k])
    let ok = g.a.end_fun()
    for u in 0..g.nfu:
        g.a.rl_add[g.fu_rl[u]] = g.a.lab[g.fk_lab[g.fu_k[u]]] - start - 4
    let w = new_txt()
    for k in 0..len(f.nm):
        w.put_byte(f.nm[k])
    let sym = g.o.sym(&w)
    g.o.define(sym, start, g.a.pos() - start)
    if ok && g.err == 0 && g.mk_n > 0:
        if g.lf_n >= len(g.lf_sym):
            g.lf_sym = buf_resize(g.lf_sym, (g.lf_n + 1) * 2)
            g.lf_start = buf_resize(g.lf_start, (g.lf_n + 1) * 2)
            g.lf_m0 = buf_resize(g.lf_m0, (g.lf_n + 1) * 2)
        g.lf_sym[g.lf_n] = sym
        g.lf_start[g.lf_n] = start
        g.lf_m0[g.lf_n] = g.lm_n
        g.lf_n = g.lf_n + 1
        for k in 0..g.mk_n:
            if g.lm_n >= len(g.lm_at):
                g.lm_at = buf_resize(g.lm_at, (g.lm_n + 1) * 2)
                g.lm_ln = buf_resize(g.lm_ln, (g.lm_n + 1) * 2)
            g.lm_at[g.lm_n] = g.a.lab[g.mk_l[k]]
            g.lm_ln[g.lm_n] = g.mk_ln[k]
            g.lm_n = g.lm_n + 1
    if g.cur >= 0 && ok && g.err == 0:
        if g.cur >= len(g.msk):
            let old = len(g.msk)
            g.msk = buf_resize(g.msk, (g.cur + 1) * 2)
            for q in old..len(g.msk):
                g.msk[q] = 0
        g.msk[g.cur] = 8 + g.fmask
    return ok && g.err == 0





/#/ The vector loop `i`: while a whole vector of elements is left (`i0 + W <= n`), it computes `W` elements
/#/ at once and steps `W`; its value is where it stopped, from where the scalar loop that follows goes on.
/#/ The arguments are the start and the end, the base address of each buffer, the loop invariants (kept
/#/ in xmm8..), then the program (see `vectorize`): a postfix list of loads, invariants, operations and
/#/ stores. It writes rax, rcx, rdx, rsi, rdi, r8..r11 and every xmm register, like a call.
fn g_gen_vloop(g: &Gen, f: &Fun, i: int) => void:
    let base = f.a[i]
    let lane = f.c[i] & 15
    /#/ a reduction: 0 none, else 1 +, 2 -, 3 ^, 4 |, 5 &; the accumulator is in the slot that is the first operand
    let rk = f.c[i] >> 4
    let np = f.aux[i] & 255
    let ni = (f.aux[i] >> 8) & 255
    let plen = f.aux[i] >> 16
    if g.a.sbx:
        /#/ the scalar loop does it all
        /#/ (with a reduction the slot is the first operand and still holds the accumulator)
        let k0 = 0
        if rk > 0:
            k0 = 1
        g_ld(g, 0, f, f.pool[base + k0])
        g_st(g, i, 0)
        return
    let eb = 4
    let w = 4
    let fl = true
    let dbl = false
    if lane == 1:
        eb = 8
        w = 2
        dbl = true
    elif lane == 2:
        eb = 1
        w = 16
        fl = false
    elif lane == 3:
        eb = 2
        w = 8
        fl = false
    elif lane == 4:
        fl = false
    elif lane == 5:
        eb = 8
        w = 2
        fl = false
    let nops = 2 + np + ni
    if rk > 0:
        nops = nops + 1
    for k in 0..nops:
        g_ld(g, 0, f, f.pool[base + k])
        g.a.push(0)
    /#/ the invariants, from the last
    for q in 0..ni:
        let j = ni - 1 - q
        g.a.pop(0)
        if eb == 4:
            g.a.extend(0, 0, 4, false)
            g.a.mov_ri(2, 4294967297)
            g.a.imul_rr(0, 2)
        elif eb == 2:
            g.a.extend(0, 0, 2, false)
            g.a.mov_ri(2, 281479271743489)
            g.a.imul_rr(0, 2)
        elif eb == 1:
            g.a.extend(0, 0, 1, false)
            g.a.mov_ri(2, 72340172838076673)
            g.a.imul_rr(0, 2)
        g.a.movq_x(8 + j, 0, false)
        g.a.splat_q(8 + j)
    /#/ the buffers: rdx, rsi, r8, r9, r10, r11, rdi
    let preg = g_vl_reg(g, 0)
    for q in 0..np:
        let k = np - 1 - q
        g.a.pop(g_vl_reg(g, k))
    g.a.pop(1)
    g.a.pop(0)
    if rk == 5:
        g.a.vec_op(true, 118, 7, 7)
    elif rk > 0:
        g.a.xorps(7, 7)
    /#/ two vectors a round while two are left, then one at a time
    g.a.add_ri(1, 1 - 2 * w)
    let top2 = g.a.new_label()
    let done2 = g.a.new_label()
    g.a.cmp_rr(0, 1)
    g.a.jcc(13, done2)
    g.a.bind(top2)
    g_vl_body(g, f, base + nops, plen, eb, lane, fl, dbl, 0, rk)
    g_vl_body(g, f, base + nops, plen, eb, lane, fl, dbl, 16, rk)
    g.a.add_ri(0, 2 * w)
    g.a.cmp_rr(0, 1)
    g.a.jcc(12, top2)
    g.a.bind(done2)
    g.a.add_ri(1, w)
    let top = g.a.new_label()
    let done = g.a.new_label()
    g.a.cmp_rr(0, 1)
    g.a.jcc(13, done)
    g.a.bind(top)
    g_vl_body(g, f, base + nops, plen, eb, lane, fl, dbl, 0, rk)
    g.a.add_ri(0, w)
    g.a.cmp_rr(0, 1)
    g.a.jcc(12, top)
    g.a.bind(done)
    if rk > 0:
        /#/ the two halves of the accumulator together, then with the value in the slot, which gets the result
        g.a.pop(2)
        g.a.movaps(0, 7)
        g.a.vec_op(true, 109, 0, 0)
        let cop = 212
        if rk == 3:
            cop = 239
        elif rk == 4:
            cop = 235
        elif rk == 5:
            cop = 219
        g.a.vec_op(true, cop, 7, 0)
        g.a.movq_r(1, 7, false)
        g.a.load(6, 2, 0, 8)
        if rk == 3:
            g.a.xor_rr(6, 1)
        elif rk == 4:
            g.a.or_rr(6, 1)
        elif rk == 5:
            g.a.and_rr(6, 1)
        else:
            g.a.add_rr(6, 1)
        g.a.store(2, 0, 6, 8)
    g_st(g, i, 0)

/#/ The program of a vector loop for the vector at the index in rax plus `disp` bytes.
fn g_vl_body(g: &Gen, f: &Fun, pbase: int, plen: int, eb: int, lane: int, fl: bool, dbl: bool, disp: int, rk: int) => void:
    /#/ `inv[k]` is the invariant a stack slot stands for (it is copied only when something writes to the slot)
    let inv: buf<int> = new_buf(int, plen + 2)
    let sp = 0
    for q in 0..plen:
        let tk = f.cval(g_res(g, f, f.pool[pbase + q]))
        let code = tk & 255
        let arg = tk >> 8
        if code == 1:
            g.a.vload(sp, g_vl_reg(g, arg), 0, eb, disp)
            inv[sp] = -1
            sp = sp + 1
        elif code == 2:
            inv[sp] = arg
            sp = sp + 1
        elif code == 3:
            sp = sp - 1
            if inv[sp - 1] >= 0:
                g.a.movaps(sp - 1, 8 + inv[sp - 1])
                inv[sp - 1] = -1
            let src = sp
            if inv[sp] >= 0:
                src = 8 + inv[sp]
            g_vl_bin(g, arg, lane, fl, dbl, sp - 1, src)
        else:
            if inv[sp - 1] >= 0:
                g.a.movaps(sp - 1, 8 + inv[sp - 1])
            g.a.vstore(g_vl_reg(g, arg), 0, eb, sp - 1, disp)
            sp = sp - 1
    if rk > 0:
        /#/ the value of the round goes into the accumulator, xmm7
        if inv[sp - 1] >= 0:
            g.a.movaps(sp - 1, 8 + inv[sp - 1])
        let opc = 212
        if rk == 2:
            opc = 251
        elif rk == 3:
            opc = 239
        elif rk == 4:
            opc = 235
        elif rk == 5:
            opc = 219
        g.a.vec_op(true, opc, 7, sp - 1)

/#/ The register of buffer `k` of a vector loop.
fn g_vl_reg(g: &Gen, k: int) => int:
    if k == 0:
        return 2
    if k == 1:
        return 6
    if k == 2:
        return 8
    if k == 3:
        return 9
    if k == 4:
        return 10
    if k == 5:
        return 11
    return 7

/#/ `x[a] = x[a] op x[b]` for the vector operation `op` (add 0, sub 1, mul 2, div 3, and 4, or 5, xor 6).
fn g_vl_bin(g: &Gen, op: int, lane: int, fl: bool, dbl: bool, a: int, b: int) => void:
    if fl:
        let opc = 88
        if op == 1:
            opc = 92
        elif op == 2:
            opc = 89
        elif op == 3:
            opc = 94
        g.a.vec_op(dbl, opc, a, b)
        return
    let opc = 0
    if op == 4:
        opc = 219
    elif op == 5:
        opc = 235
    elif op == 6:
        opc = 239
    elif op == 0:
        opc = 252 + (lane - 2)
        if lane == 5:
            opc = 212
    elif op == 1:
        opc = 248 + (lane - 2)
        if lane == 5:
            opc = 251
    else:
        opc = 213
    g.a.vec_op(true, opc, a, b)






/#/ The value an operand stands for, through forwarding and `own.move`.
fn g_res(g: &Gen, f: &Fun, v: int) => int:
    let x = f.follow(v)
    while f.op[x] == int(Op.OwnMove):
        x = f.follow(f.a[x])
    return x

/#/ reg = the value (a scalar, 8 bytes; narrower ones have meaningful low bytes only)
fn g_ld(g: &Gen, reg: int, f: &Fun, v: int) => void:
    let x = g_res(g, f, v)
    let k = f.op[x]
    if k == int(Op.Const):
        let r = f.rep[x]
        if r == int(Rp.F32):
            g.a.mov_ri(reg, f.aux[x] & 4294967295)
        else:
            g.a.mov_ri(reg, f.aux[x])
    elif k == int(Op.Undef):
        g.a.mov_ri(reg, 0)
    elif k == int(Op.StrLit):
        g.a.lea_rip(reg, 1, g.sbase + g_so(g, f.aux[x]))
    elif k == int(Op.Slot):
        g.a.lea(reg, g_vb(g, x), 0 - g.voff[x])
    elif g.home[x] >= 0:
        if g.home[x] != reg:
            g.a.mov_rr(reg, g.home[x])
    elif g.xhome[x] >= 0:
        g.a.movq_r(reg, g.xhome[x], g.xsg[x] == 1)
    else:
        g.a.load(reg, 5, 0 - g.voff[x], 8)

fn g_so(g: &Gen, id: int) => int:
    return g.soff[id]

/#/ The base register of the bytes of value `x`: rbp, or r14 for the shadow frame of sandbox code.
fn g_vb(g: &Gen, x: int) => int:
    if g.a.sbx && g.sh[x] == 1:
        return 14
    return 5

/#/ The register that holds `v`: its own when it has one, else `scratch`, loaded with it.
fn g_src(g: &Gen, f: &Fun, v: int, scratch: int) => int:
    let h = g.home[g_res(g, f, v)]
    if h >= 0:
        return h
    g_ld(g, scratch, f, v)
    return scratch

/#/ The register of `v` when it has one, else -1.
fn g_home_of(g: &Gen, f: &Fun, v: int) => int:
    return g.home[g_res(g, f, v)]

/#/ reg = the value extended from its width
fn g_ld_ext(g: &Gen, reg: int, f: &Fun, v: int, signed: bool) => void:
    g_ld(g, reg, f, v)
    let x = g_res(g, f, v)
    let r = f.rep[x]
    if f.op[x] == int(Op.Cmp):
        /#/ the result of a compare is 0 or 1 in a whole register already
        return
    if r == int(Rp.I8) || r == int(Rp.I16) || r == int(Rp.I32):
        g.a.extend(reg, reg, rsize_scalar(r), signed)

/#/ mov [rbp - place of i], reg
fn g_st(g: &Gen, i: int, reg: int) => void:
    if g.home[i] >= 0:
        if g.home[i] != reg:
            g.a.mov_rr(g.home[i], reg)
    elif g.xhome[i] >= 0:
        g.a.movq_x(g.xhome[i], reg, g.xsg[i] == 1)
    else:
        g.a.store(5, 0 - g.voff[i], reg, 8)

/#/ The xmm register of float `v`: its own when it has one, else `scratch`, loaded with it.
fn g_xsrc(g: &Gen, f: &Fun, v: int, scratch: int) => int:
    let x = g_res(g, f, v)
    if g.xhome[x] >= 0:
        return g.xhome[x]
    if f.op[x] == int(Op.Const) && !g.a.sbx:
        g_load_fconst(g, scratch, f, x)
        return scratch
    g_ld(g, 0, f, x)
    g.a.movq_x(scratch, 0, f.rep[x] == int(Rp.F32))
    return scratch

/#/ xmm `reg` = the float constant `x`, read from the pool after the function's code.
fn g_load_fconst(g: &Gen, reg: int, f: &Fun, x: int) => void:
    let single = f.rep[x] == int(Rp.F32)
    let bits = f.aux[x]
    if single:
        bits = bits & 4294967295
    let k = 0
    while k < g.nfk && g.fk_bits[k] != bits:
        k = k + 1
    if k == g.nfk:
        if k >= len(g.fk_bits):
            g.fk_bits = buf_resize(g.fk_bits, (k + 1) * 2)
            g.fk_lab = buf_resize(g.fk_lab, (k + 1) * 2)
        g.fk_bits[k] = bits
        g.fk_lab[k] = g.a.new_label()
        g.nfk = k + 1
    if g.nfu >= len(g.fu_rl):
        g.fu_rl = buf_resize(g.fu_rl, (g.nfu + 1) * 2)
        g.fu_k = buf_resize(g.fu_k, (g.nfu + 1) * 2)
    g.a.load_x_sym(reg, single, g.fsym)
    g.fu_rl[g.nfu] = g.a.nrl - 1
    g.fu_k[g.nfu] = k
    g.nfu = g.nfu + 1

/#/ Where instruction `i` (a float) makes its result: its xmm register, else xmm0.
fn g_xdst(g: &Gen, i: int) => int:
    if g.xhome[i] >= 0:
        return g.xhome[i]
    return 0

/#/ The result of instruction `i` is in xmm `x`: kept there, or stored.
fn g_xfin(g: &Gen, f: &Fun, i: int, x: int) => void:
    if g.xhome[i] >= 0:
        if g.xhome[i] != x:
            g.a.movaps(g.xhome[i], x)
    else:
        g.a.movq_r(0, x, f.rep[i] == int(Rp.F32))
        g_st(g, i, 0)

/#/ For an aggregate value: the base register and displacement of its bytes.
fn g_ab_reg(g: &Gen, f: &Fun, v: int) => int:
    let x = g_res(g, f, v)
    if f.op[x] == int(Op.Undef):
        g.a.lea_rip(6, 1, 0)
        return 6
    return g_vb(g, x)

fn g_ab_disp(g: &Gen, f: &Fun, v: int) => int:
    let x = g_res(g, f, v)
    if f.op[x] == int(Op.Undef):
        return 0
    return 0 - g.voff[x]

/#/ n bytes from [sb + sd] to [db + dd], through rax.
fn g_copy_mem(g: &Gen, db: int, dd: int, sb: int, sd: int, n: int) => void:
    let k = 0
    while k + 8 <= n:
        g.a.load(0, sb, sd + k, 8)
        g.a.store(db, dd + k, 0, 8)
        k = k + 8
    if k + 4 <= n:
        g.a.load(0, sb, sd + k, 4)
        g.a.store(db, dd + k, 0, 4)
        k = k + 4
    if k + 2 <= n:
        g.a.load(0, sb, sd + k, 2)
        g.a.store(db, dd + k, 0, 2)
        k = k + 2
    if k < n:
        g.a.load(0, sb, sd + k, 1)
        g.a.store(db, dd + k, 0, 1)

/#/ Value `v` to [db + dd], in full: a scalar as 8 bytes, an aggregate as its layout.
fn g_val_to(g: &Gen, f: &Fun, rs: &Reps, db: int, dd: int, v: int) => void:
    let x = g_res(g, f, v)
    let r = f.rep[x]
    if r >= rp_first_agg():
        let sb = g_ab_reg(g, f, x)
        g_copy_mem(g, db, dd, sb, g_ab_disp(g, f, x), rsize(rs, r))
    elif g.home[x] >= 0:
        g.a.store(db, dd, g.home[x], 8)
    else:
        g_ld(g, 0, f, x)
        g.a.store(db, dd, 0, 8)

/#/ ---- registers -----------------------------------------------------------

fn g_is_signed_pred(g: &Gen, p: int) => bool:
    return p == int(Pr.SLt) || p == int(Pr.SLe) || p == int(Pr.SGt) || p == int(Pr.SGe)

/#/ Is the compare `i` used only by the branch right after it? Then the flags carry it.
fn g_fused(g: &Gen, f: &Fun, i: int) => bool:
    let n = f.nx[i]
    if n < 0 || f.op[n] != int(Op.CondBr) || f.uses[i] != 1:
        return false
    return g_res(g, f, f.a[n]) == i

/#/ Is the float compare `i` one the flags carry in a single condition (not == or !=)?
fn g_fflag_ok(g: &Gen, f: &Fun, i: int) => bool:
    let p = f.aux[i]
    return p == int(Pr.OLt) || p == int(Pr.OLe) || p == int(Pr.OGt) || p == int(Pr.OGe)

/#/ Compare the operands of the float compare `i` and return the condition that holds when it is true.
/#/ An unordered result sets CF, so `a` and `ae` are false for it, as the compare requires.
fn g_fcmp_flags(g: &Gen, f: &Fun, i: int) => int:
    let p = f.aux[i]
    let single = f.rep[g_res(g, f, f.a[i])] == int(Rp.F32)
    let xa = g_xsrc(g, f, f.a[i], 0)
    let xb = g_xsrc(g, f, f.b[i], 1)
    if p == int(Pr.OLt) || p == int(Pr.OLe):
        g.a.ucomi(single, xb, xa)
    else:
        g.a.ucomi(single, xa, xb)
    if p == int(Pr.OLt) || p == int(Pr.OGt):
        return cc_a()
    return cc_ae()

/#/ Is `v` a constant small enough that, times an element size of at most 8, it is a displacement?
fn g_near_const(g: &Gen, f: &Fun, v: int) => bool:
    let x = g_res(g, f, v)
    if f.op[x] != int(Op.Const):
        return false
    let r = f.rep[x]
    if r != int(Rp.I64) && r != int(Rp.Ptr):
        return false
    return f.aux[x] >= 0 - 100000000 && f.aux[x] <= 100000000

/#/ Is `v` a 64-bit constant that fits the sign-extended 32-bit immediate of an instruction?
fn g_small_imm(g: &Gen, f: &Fun, v: int) => bool:
    let x = g_res(g, f, v)
    if f.op[x] != int(Op.Const):
        return false
    let r = f.rep[x]
    if r != int(Rp.I64) && r != int(Rp.Ptr):
        return false
    return f.aux[x] >= 0 - 2147483648 && f.aux[x] <= 2147483647

/#/ Sets the flags for the integer compare `i`.
fn g_cmp_flags(g: &Gen, f: &Fun, i: int) => void:
    let signed = g_is_signed_pred(g, f.aux[i])
    let wr = f.rep[g_res(g, f, f.a[i])]
    if wr == int(Rp.I64) || wr == int(Rp.Ptr):
        /#/ a whole register: compare it where it lives
        let la = g_src(g, f, f.a[i], 0)
        if g_small_imm(g, f, f.b[i]):
            g.a.cmp_ri(la, f.aux[g_res(g, f, f.b[i])])
        else:
            g.a.cmp_rr(la, g_src(g, f, f.b[i], 1))
        return
    g_ld_ext(g, 0, f, f.a[i], signed)
    if g_small_imm(g, f, f.b[i]):
        g.a.cmp_ri(0, f.aux[g_res(g, f, f.b[i])])
        return
    g_ld_ext(g, 1, f, f.b[i], signed)
    g.a.cmp_rr(0, 1)

fn g_gen_inst(g: &Gen, f: &Fun, rs: &Reps, sy: &Names, i: int, next: int) => void:
    let op = f.op[i]
    let r = f.rep[i]
    if op == int(Op.Param) || op == int(Op.Slot) || op == int(Op.OwnMove) || op == int(Op.Const) || op == int(Op.StrLit) || op == int(Op.Undef):
        return
    if op == int(Op.Add) || op == int(Op.Sub) || op == int(Op.Mul) || op == int(Op.And) || op == int(Op.Or) || op == int(Op.Xor):
        let d = g.home[i]
        if d >= 0:
            /#/ the result has a register: work in it, with the operands where they live
            let a = f.a[i]
            let b = f.b[i]
            if g_home_of(g, f, b) == d && op != int(Op.Sub):
                a = f.b[i]
                b = f.a[i]
            if g_home_of(g, f, b) != d:
                if g_small_imm(g, f, b):
                    let v = f.aux[g_res(g, f, b)]
                    if op == int(Op.Mul):
                        if v > 0 && (v & (v - 1)) == 0:
                            g_ld(g, d, f, a)
                            let sh = 0
                            while (1 << sh) < v:
                                sh = sh + 1
                            g.a.shift_i(4, d, sh)
                        else:
                            g.a.imul_rri(d, g_src(g, f, a, 0), v)
                        return
                    if op == int(Op.Add) && g_home_of(g, f, a) >= 0:
                        g.a.lea(d, g_home_of(g, f, a), v)
                        return
                    g_ld(g, d, f, a)
                    if op == int(Op.Add):
                        g.a.add_ri(d, v)
                    elif op == int(Op.Sub):
                        g.a.sub_ri(d, v)
                    elif op == int(Op.And):
                        g.a.and_ri(d, v)
                    elif op == int(Op.Or):
                        g.a.or_ri(d, v)
                    else:
                        g.a.xor_ri(d, v)
                    return
                if op == int(Op.Add) && g_home_of(g, f, a) >= 0 && g_home_of(g, f, a) != d && g_home_of(g, f, b) >= 0:
                    /#/ both operands live on: one lea instead of a copy and an add
                    g.a.lea_idx(d, g_home_of(g, f, a), g_home_of(g, f, b), 1)
                    return
                g_ld(g, d, f, a)
                let rb = g_src(g, f, b, 1)
                if op == int(Op.Add):
                    g.a.add_rr(d, rb)
                elif op == int(Op.Sub):
                    g.a.sub_rr(d, rb)
                elif op == int(Op.Mul):
                    g.a.imul_rr(d, rb)
                elif op == int(Op.And):
                    g.a.and_rr(d, rb)
                elif op == int(Op.Or):
                    g.a.or_rr(d, rb)
                else:
                    g.a.xor_rr(d, rb)
                return
        g_ld(g, 0, f, f.a[i])
        if (op == int(Op.Add) || op == int(Op.Sub)) && g_small_imm(g, f, f.b[i]):
            if op == int(Op.Add):
                g.a.add_ri(0, f.aux[g_res(g, f, f.b[i])])
            else:
                g.a.sub_ri(0, f.aux[g_res(g, f, f.b[i])])
            g_st(g, i, 0)
            return
        g_ld(g, 1, f, f.b[i])
        if op == int(Op.Add):
            g.a.add_rr(0, 1)
        elif op == int(Op.Sub):
            g.a.sub_rr(0, 1)
        elif op == int(Op.Mul):
            g.a.imul_rr(0, 1)
        elif op == int(Op.And):
            g.a.and_rr(0, 1)
        elif op == int(Op.Or):
            g.a.or_rr(0, 1)
        else:
            g.a.xor_rr(0, 1)
        g_st(g, i, 0)
        return
    if op == int(Op.SMulHi):
        g_ld(g, 1, f, f.a[i])
        g_ld(g, 0, f, f.b[i])
        g.a.grp3(5, 1)
        g_st(g, i, 2)
        return
    if op == int(Op.SDiv) || op == int(Op.SRem) || op == int(Op.UDiv) || op == int(Op.URem):
        let signed = op == int(Op.SDiv) || op == int(Op.SRem)
        g_ld_ext(g, 0, f, f.a[i], signed)
        g_ld_ext(g, 1, f, f.b[i], signed)
        if signed:
            g.a.cqo()
            g.a.idiv(1)
        else:
            g.a.mov_ri(2, 0)
            g.a.div(1)
        if op == int(Op.SDiv) || op == int(Op.UDiv):
            g_st(g, i, 0)
        else:
            g_st(g, i, 2)
        return
    if op == int(Op.Shl) || op == int(Op.AShr) || op == int(Op.LShr):
        if g_small_imm(g, f, f.b[i]):
            let k = f.aux[g_res(g, f, f.b[i])]
            if k >= 0 && k < 64:
                let sc = 4
                if op == int(Op.LShr):
                    sc = 5
                elif op == int(Op.AShr):
                    sc = 7
                let d = g.home[i]
                if d >= 0:
                    g_ld_ext(g, d, f, f.a[i], op == int(Op.AShr))
                    g.a.shift_i(sc, d, k)
                else:
                    g_ld_ext(g, 0, f, f.a[i], op == int(Op.AShr))
                    g.a.shift_i(sc, 0, k)
                    g_st(g, i, 0)
                return
        g_ld_ext(g, 0, f, f.a[i], op == int(Op.AShr))
        g_ld(g, 1, f, f.b[i])
        if op == int(Op.Shl):
            g.a.shift_cl(4, 0)
        elif op == int(Op.LShr):
            g.a.shift_cl(5, 0)
        else:
            g.a.shift_cl(7, 0)
        g_st(g, i, 0)
        return
    if op == int(Op.FnAddr):
        g.a.lea_rip(0, g_callee(g, sy, f.aux[i]), 0)
        g_st(g, i, 0)
        return
    if op == int(Op.Neg) || op == int(Op.Not):
        g_ld(g, 0, f, f.a[i])
        if op == int(Op.Neg):
            g.a.neg(0)
        else:
            g.a.not_(0)
        g_st(g, i, 0)
        return
    if op == int(Op.FNeg):
        let single = r == int(Rp.F32)
        let xa = g_xsrc(g, f, f.a[i], 0)
        let xd = g_xdst(g, i)
        if single:
            g.a.mov_ri(1, 2147483648)
        else:
            g.a.mov_ri(1, 0 - 9223372036854775807 - 1)
        g.a.movq_x(1, 1, false)
        if xd != xa:
            g.a.movaps(xd, xa)
        g.a.xorps(xd, 1)
        g_xfin(g, f, i, xd)
        return
    if op == int(Op.FAdd) || op == int(Op.FSub) || op == int(Op.FMul) || op == int(Op.FDiv):
        let single = r == int(Rp.F32)
        let code = 88
        if op == int(Op.FMul):
            code = 89
        elif op == int(Op.FSub):
            code = 92
        elif op == int(Op.FDiv):
            code = 94
        let xa = g_xsrc(g, f, f.a[i], 0)
        let xb = g_xsrc(g, f, f.b[i], 1)
        let xd = g_xdst(g, i)
        if xd == xa:
            g.a.sse(code, single, xd, xb)
        elif xd == xb && (op == int(Op.FAdd) || op == int(Op.FMul)):
            g.a.sse(code, single, xd, xa)
        elif xd != xb:
            g.a.movaps(xd, xa)
            g.a.sse(code, single, xd, xb)
        else:
            g.a.movaps(0, xa)
            g.a.sse(code, single, 0, xb)
            g.a.movaps(xd, 0)
        g_xfin(g, f, i, xd)
        return
    if op == int(Op.Cmp):
        if g_fused(g, f, i):
            return
        g_cmp_flags(g, f, i)
        if g.home[i] >= 0:
            g.a.setcc(g_cc_of(g, f.aux[i]), g.home[i])
        else:
            g.a.setcc(g_cc_of(g, f.aux[i]), 0)
            g_st(g, i, 0)
        return
    if op == int(Op.FCmp):
        let p = f.aux[i]
        if g_fflag_ok(g, f, i) && g_fused(g, f, i):
            return
        let single = f.rep[g_res(g, f, f.a[i])] == int(Rp.F32)
        let xa = g_xsrc(g, f, f.a[i], 0)
        let xb = g_xsrc(g, f, f.b[i], 1)
        if p == int(Pr.OLt) || p == int(Pr.OLe):
            g.a.ucomi(single, xb, xa)
            if p == int(Pr.OLt):
                g.a.setcc(cc_a(), 0)
            else:
                g.a.setcc(cc_ae(), 0)
        elif p == int(Pr.OGt) || p == int(Pr.OGe):
            g.a.ucomi(single, xa, xb)
            if p == int(Pr.OGt):
                g.a.setcc(cc_a(), 0)
            else:
                g.a.setcc(cc_ae(), 0)
        else:
            g.a.ucomi(single, xa, xb)
            if p == int(Pr.OEq):
                g.a.setcc(cc_e(), 0)
                g.a.setcc(cc_np(), 1)
            else:
                g.a.setcc(cc_ne(), 0)
                g.a.setcc(cc_np(), 1)
            g.a.and_rr(0, 1)
        g_st(g, i, 0)
        return
    if op == int(Op.Trunc) || op == int(Op.Bitcast) || op == int(Op.PtrToInt) || op == int(Op.IntToPtr):
        if g.home[i] >= 0:
            g_ld(g, g.home[i], f, f.a[i])
            return
        g_ld(g, 0, f, f.a[i])
        g_st(g, i, 0)
        return
    if op == int(Op.SExt) || op == int(Op.ZExt):
        if g.home[i] >= 0:
            g_ld_ext(g, g.home[i], f, f.a[i], op == int(Op.SExt))
            return
        g_ld_ext(g, 0, f, f.a[i], op == int(Op.SExt))
        g_st(g, i, 0)
        return
    if op == int(Op.SiToFp) || op == int(Op.UiToFp):
        let single = r == int(Rp.F32)
        let signed = op == int(Op.SiToFp)
        let xd = g_xdst(g, i)
        g_ld_ext(g, 0, f, f.a[i], signed)
        if signed || f.rep[g_res(g, f, f.a[i])] != int(Rp.I64):
            g.a.cvt_si2f(xd, 0, single)
        else:
            let pos = g.a.new_label()
            let done = g.a.new_label()
            g.a.test_rr(0, 0)
            g.a.jcc(9, pos)
            g.a.mov_rr(1, 0)
            g.a.shift_i(5, 0, 1)
            g.a.mov_ri(2, 1)
            g.a.and_rr(1, 2)
            g.a.or_rr(0, 1)
            g.a.cvt_si2f(xd, 0, single)
            g.a.sse(88, single, xd, xd)
            g.a.jmp(done)
            g.a.bind(pos)
            g.a.cvt_si2f(xd, 0, single)
            g.a.bind(done)
        g_xfin(g, f, i, xd)
        return
    if op == int(Op.FpToSi) || op == int(Op.FpToUi):
        let single = f.rep[g_res(g, f, f.a[i])] == int(Rp.F32)
        let xa = g_xsrc(g, f, f.a[i], 0)
        if op == int(Op.FpToUi) && r == int(Rp.I64):
            let small = g.a.new_label()
            let done = g.a.new_label()
            if xa != 0:
                g.a.movaps(0, xa)
            if single:
                g.a.mov_ri(1, 1593835520)
            else:
                g.a.mov_ri(1, 4890909195324358656)
            g.a.movq_x(1, 1, single)
            g.a.ucomi(single, 0, 1)
            g.a.jcc(cc_b(), small)
            g.a.sse(92, single, 0, 1)
            g.a.cvt_f2si(0, 0, single)
            g.a.mov_ri(1, 0 - 9223372036854775807 - 1)
            g.a.xor_rr(0, 1)
            g.a.jmp(done)
            g.a.bind(small)
            g.a.cvt_f2si(0, 0, single)
            g.a.bind(done)
        else:
            g.a.cvt_f2si(0, xa, single)
        g_st(g, i, 0)
        return
    if op == int(Op.FpExt) || op == int(Op.FpTrunc):
        let to_single = op == int(Op.FpTrunc)
        let xa = g_xsrc(g, f, f.a[i], 0)
        let xd = g_xdst(g, i)
        g.a.cvt_ff(xd, xa, to_single)
        g_xfin(g, f, i, xd)
        return
    if (op == int(Op.Field) || op == int(Op.Index)) && g_folds(g, f, i):
        return
    if op == int(Op.Field):
        let d = g.home[i]
        if d < 0:
            d = 0
        let rb = g_src(g, f, f.a[i], 0)
        if f.aux[i] == 0 && rb == d:
            g_st(g, i, d)
            return
        g.a.lea(d, rb, f.aux[i])
        g_st(g, i, d)
        return
    if op == int(Op.Index):
        let d = g.home[i]
        if d < 0:
            d = 0
        let sz = f.aux[i]
        let ba = g_res(g, f, f.a[i])
        if f.op[ba] == int(Op.StrLit) && (sz == 1 || sz == 2 || sz == 4 || sz == 8) && g_near_const(g, f, f.b[i]):
            /#/ a place in the text of a literal: one rip-relative lea
            g.a.lea_rip(d, 1, g.sbase + g_so(g, f.aux[ba]) + f.aux[g_res(g, f, f.b[i])] * sz)
            g_st(g, i, d)
            return
        let ra = g_src(g, f, f.a[i], 0)
        let rb = 1
        if !((sz == 1 || sz == 2 || sz == 4 || sz == 8) && g_near_const(g, f, f.b[i])):
            rb = g_src(g, f, f.b[i], 1)
        if (sz == 1 || sz == 2 || sz == 4 || sz == 8) && g_near_const(g, f, f.b[i]):
            let dp = f.aux[g_res(g, f, f.b[i])] * sz
            if !(dp == 0 && ra == d):
                g.a.lea(d, ra, dp)
        elif sz == 1 || sz == 2 || sz == 4 || sz == 8:
            g.a.lea_idx(d, ra, rb, sz)
        else:
            g.a.imul_rri(1, rb, sz)
            g.a.lea_idx(d, ra, 1, 1)
        g_st(g, i, d)
        return
    if op == int(Op.Extract):
        let ar = f.rep[g_res(g, f, f.a[i])]
        let eo = elem_off(rs, ar, f.aux[i])
        let sb = g_ab_reg(g, f, f.a[i])
        let sd = g_ab_disp(g, f, f.a[i]) + eo
        if r >= rp_first_agg():
            g_copy_mem(g, g_vb(g, i), 0 - g.voff[i], sb, sd, rsize(rs, r))
        elif g.xhome[i] >= 0:
            g.a.load_x(g.xhome[i], sb, sd, r == int(Rp.F32))
        else:
            let d = g.home[i]
            if d < 0:
                d = 0
            g.a.load(d, sb, sd, rsize(rs, r))
            g_st(g, i, d)
        return
    if op == int(Op.Insert):
        let eo = elem_off(rs, r, f.aux[i])
        let sb = g_ab_reg(g, f, f.a[i])
        g_copy_mem(g, g_vb(g, i), 0 - g.voff[i], sb, g_ab_disp(g, f, f.a[i]), rsize(rs, r))
        let er = f.rep[g_res(g, f, f.b[i])]
        if er >= rp_first_agg():
            let eb = g_ab_reg(g, f, f.b[i])
            g_copy_mem(g, g_vb(g, i), 0 - g.voff[i] + eo, eb, g_ab_disp(g, f, f.b[i]), rsize(rs, er))
        else:
            g_ld(g, 0, f, f.b[i])
            g.a.store(g_vb(g, i), 0 - g.voff[i] + eo, 0, rsize(rs, er))
        return
    if op == int(Op.Load):
        if r >= rp_first_agg():
            g_ld(g, 6, f, f.a[i])
            g_copy_mem(g, g_vb(g, i), 0 - g.voff[i], 6, 0, rsize(rs, r))
        elif g.xhome[i] >= 0:
            let xd = g.xhome[i]
            let sg = r == int(Rp.F32)
            let x = g_res(g, f, f.a[i])
            if g_folds(g, f, x):
                g_addr_of(g, f, x, 6, 1)
                if g.am_idx >= 0:
                    g.a.load_x_idx(xd, g.am_base, g.am_idx, g.am_scale, 0, sg)
                else:
                    g.a.load_x(xd, g.am_base, g.am_disp, sg)
            else:
                g.a.load_x(xd, g_src(g, f, f.a[i], 6), 0, sg)
        else:
            let d = g.home[i]
            if d < 0:
                d = 0
            let x = g_res(g, f, f.a[i])
            if g_folds(g, f, x):
                g_addr_of(g, f, x, 6, 1)
                if g.am_idx >= 0:
                    g.a.load_idx(d, g.am_base, g.am_idx, g.am_scale, 0, rsize(rs, r))
                else:
                    g.a.load(d, g.am_base, g.am_disp, rsize(rs, r))
            else:
                g.a.load(d, g_src(g, f, f.a[i], 6), 0, rsize(rs, r))
            g_st(g, i, d)
        return
    if op == int(Op.Store):
        let vr = f.rep[g_res(g, f, f.b[i])]
        if vr >= rp_first_agg():
            g_ld(g, 7, f, f.a[i])
            let sb = g_ab_reg(g, f, f.b[i])
            g_copy_mem(g, 7, 0, sb, g_ab_disp(g, f, f.b[i]), rsize(rs, vr))
        elif g.xhome[g_res(g, f, f.b[i])] >= 0:
            let xv = g.xhome[g_res(g, f, f.b[i])]
            let sg = vr == int(Rp.F32)
            let x = g_res(g, f, f.a[i])
            if g_folds(g, f, x):
                g_addr_of(g, f, x, 1, 6)
                if g.am_idx >= 0:
                    g.a.store_x_idx(g.am_base, g.am_idx, g.am_scale, 0, xv, sg)
                else:
                    g.a.store_x(g.am_base, g.am_disp, xv, sg)
            else:
                g.a.store_x(g_src(g, f, f.a[i], 1), 0, xv, sg)
        else:
            let rv = g_src(g, f, f.b[i], 0)
            let x = g_res(g, f, f.a[i])
            if g_folds(g, f, x):
                g_addr_of(g, f, x, 1, 6)
                if g.am_idx >= 0:
                    g.a.store_idx(g.am_base, g.am_idx, g.am_scale, 0, rv, rsize(rs, vr))
                else:
                    g.a.store(g.am_base, g.am_disp, rv, rsize(rs, vr))
            else:
                g.a.store(g_src(g, f, f.a[i], 1), 0, rv, rsize(rs, vr))
        return
    if op == int(Op.Drop) || op == int(Op.Clone):
        g.nav = 0
        g_push_arg(g, f.a[i])
        g_do_call(g, f, rs, i, g_callee(g, sy, f.aux[i]), false)
        return
    if op == int(Op.VLoop):
        g_gen_vloop(g, f, i)
        return
    if op == int(Op.Call) || op == int(Op.CCall) || op == int(Op.CallI):
        g.nav = 0
        for k in 0..f.b[i]:
            g_push_arg(g, f.pool[f.a[i] + k])
        if op == int(Op.CallI) && g.a.sbx:
            /#/ a function value would have to be a checked table index
            g_bad(g)
            return
        if op == int(Op.CallI):
            g_ld(g, 11, f, f.c[i])
            g_do_call(g, f, rs, i, 0 - 1, false)
        else:
            g_do_call(g, f, rs, i, g_callee(g, sy, f.aux[i]), op == int(Op.CCall) && f.c[i] != 0)
        return
    if op == int(Op.Br):
        let e = f.aux[i]
        g_edge_copy(g, f, rs, e)
        if f.eto[e] != next:
            g.a.jmp(f.eto[e])
        return
    if op == int(Op.CondBr):
        let e1 = f.b[i]
        let e2 = f.c[i]
        let c = g_res(g, f, f.a[i])
        let cc = cc_ne()
        if f.op[c] == int(Op.Cmp) && g_fused(g, f, c):
            g_cmp_flags(g, f, c)
            cc = g_cc_of(g, f.aux[c])
        elif f.op[c] == int(Op.FCmp) && g_fflag_ok(g, f, c) && g_fused(g, f, c):
            cc = g_fcmp_flags(g, f, c)
        else:
            g_ld_ext(g, 0, f, f.a[i], false)
            g.a.extend(0, 0, 1, false)
            g.a.test_rr(0, 0)
        if f.eargn[e1] == 0 && f.eargn[e2] == 0:
            /#/ no moves on either edge: one conditional jump, the other way falls through
            if f.eto[e2] == next:
                g.a.jcc(cc, f.eto[e1])
            elif f.eto[e1] == next:
                g.a.jcc(cc ^ 1, f.eto[e2])
            else:
                g.a.jcc(cc, f.eto[e1])
                g.a.jmp(f.eto[e2])
            return
        if f.eargn[e1] == 0:
            /#/ the true edge needs no moves: jump straight to its block
            g.a.jcc(cc, f.eto[e1])
            g_edge_copy(g, f, rs, e2)
            if f.eto[e2] != next:
                g.a.jmp(f.eto[e2])
            return
        if f.eargn[e2] == 0:
            g.a.jcc(cc ^ 1, f.eto[e2])
            g_edge_copy(g, f, rs, e1)
            if f.eto[e1] != next:
                g.a.jmp(f.eto[e1])
            return
        let yes = g.a.new_label()
        g.a.jcc(cc, yes)
        g_edge_copy(g, f, rs, e2)
        g.a.jmp(f.eto[e2])
        g.a.bind(yes)
        g_edge_copy(g, f, rs, e1)
        if f.eto[e1] != next:
            g.a.jmp(f.eto[e1])
        return
    if op == int(Op.Ret):
        if f.a[i] >= 0:
            let vr = f.rep[g_res(g, f, f.a[i])]
            if vr >= rp_first_agg():
                g.a.load(7, 5, 0 - 8, 8)
                let sb = g_ab_reg(g, f, f.a[i])
                g_copy_mem(g, 7, 0, sb, g_ab_disp(g, f, f.a[i]), rsize(rs, vr))
            elif g_is_int_class(g, vr):
                g_ld(g, 0, f, f.a[i])
            else:
                let rx = g_res(g, f, f.a[i])
                if g.xhome[rx] >= 0:
                    g.a.movaps(0, g.xhome[rx])
                else:
                    g_ld(g, 0, f, f.a[i])
                    g.a.movq_x(0, 0, vr == int(Rp.F32))
        if g.epi_jump:
            g.a.jmp(g.epi)
        else:
            g_epilogue(g)
        return
    if op == int(Op.Unreachable):
        g.a.ud2()
        return
    g_bad(g)

/#/ ---- functions ---------------------------------------------------------







fn g_push_arg(g: &Gen, v: int) => void:
    if g.nav >= len(g.av):
        g.av = buf_resize(g.av, (g.nav + 1) * 2)
    g.av[g.nav] = v
    g.nav = g.nav + 1

/#/ ---- values ------------------------------------------------------------

fn g_is_int_class(g: &Gen, r: int) => bool:
    return r != int(Rp.F32) && r != int(Rp.F64)

/#/ The call to the symbol `sym` (or the address in r11 when `sym` < 0) with the values queued
/#/ in `av`; the result of instruction `i` is stored.
fn g_do_call(g: &Gen, f: &Fun, rs: &Reps, i: int, sym: int, variadic: bool) => void:
    let ret = f.rep[i]
    let sret = ret >= rp_first_agg()
    /#/ which arguments go on the stack
    let ni = 0
    let nx = 0
    if sret:
        ni = 1
    let on_stack = 0
    for k in 0..g.nav:
        let r = f.rep[g_res(g, f, g.av[k])]
        if r >= rp_first_agg() || g_is_int_class(g, r):
            if ni < 6:
                ni = ni + 1
            else:
                on_stack = on_stack + 1
        elif nx < 8:
            nx = nx + 1
        else:
            on_stack = on_stack + 1
    if on_stack % 2 == 1:
        g.a.sub_ri(4, 8)
    /#/ the stack arguments, last first
    let k = g.nav - 1
    while k >= 0:
        let r = f.rep[g_res(g, f, g.av[k])]
        let reg_ok = false
        /#/ recompute whether this one fits in a register: count the ones before it
        let ci = 0
        if sret:
            ci = 1
        let cx = 0
        for j in 0..k:
            let rj = f.rep[g_res(g, f, g.av[j])]
            if rj >= rp_first_agg() || g_is_int_class(g, rj):
                ci = ci + 1
            else:
                cx = cx + 1
        if r >= rp_first_agg() || g_is_int_class(g, r):
            reg_ok = ci < 6
        else:
            reg_ok = cx < 8
        if !reg_ok:
            if r >= rp_first_agg():
                let x = g_res(g, f, g.av[k])
                if f.op[x] == int(Op.Undef):
                    g.a.lea_rip(0, 1, 0)
                else:
                    g.a.lea(0, g_vb(g, x), 0 - g.voff[x])
            else:
                g_ld(g, 0, f, g.av[k])
            g.a.push(0)
        k = k - 1
    if sret:
        g.a.lea(7, g_vb(g, i), 0 - g.voff[i])
    let ci = 0
    if sret:
        ci = 1
    let cx = 0
    for an in 0..g.nav:
        let v = g.av[an]
        let x = g_res(g, f, v)
        let r = f.rep[x]
        if r >= rp_first_agg():
            if ci < 6:
                if f.op[x] == int(Op.Undef):
                    g.a.lea_rip(int_reg(ci), 1, 0)
                else:
                    g.a.lea(int_reg(ci), g_vb(g, x), 0 - g.voff[x])
            ci = ci + 1
        elif g_is_int_class(g, r):
            if ci < 6:
                g_ld(g, int_reg(ci), f, v)
            ci = ci + 1
        else:
            if cx < 8:
                if g.xhome[x] >= 0:
                    g.a.movaps(cx, g.xhome[x])
                else:
                    g_ld(g, 0, f, v)
                    g.a.movq_x(cx, 0, r == int(Rp.F32))
            cx = cx + 1
    if variadic:
        g.a.mov_ri(0, nx)
    if sym < 0:
        g.a.call_reg(11)
    else:
        g.a.call_sym(sym)
    let pop = on_stack
    if on_stack % 2 == 1:
        pop = pop + 1
    if pop > 0:
        g.a.add_ri(4, pop * 8)
    if ret == int(Rp.Void) || sret || f.uses[i] == 0:
        return
    if g_is_int_class(g, ret):
        g_st(g, i, 0)
    else:
        g_xfin(g, f, i, 0)

/#/ The symbol of the function the name number `id` of `sy` stands for.
fn g_callee(g: &Gen, sy: &Names, id: int) => int:
    let w = new_txt()
    sy.put(&w, id)
    return g.o.sym(&w)

/#/ ---- instructions ------------------------------------------------------

fn g_cc_of(g: &Gen, p: int) => int:
    if p == int(Pr.Eq):
        return cc_e()
    if p == int(Pr.Ne):
        return cc_ne()
    if p == int(Pr.SLt):
        return cc_l()
    if p == int(Pr.SLe):
        return cc_le()
    if p == int(Pr.SGt):
        return cc_g()
    if p == int(Pr.SGe):
        return cc_ge()
    if p == int(Pr.ULt):
        return cc_b()
    if p == int(Pr.ULe):
        return cc_be()
    if p == int(Pr.UGt):
        return cc_a()
    return cc_ae()





/#/ The x86-64 target: the facts the register allocator and the call code need about the machine,
/#/ in one place. Register numbers are the machine's (rax 0, rcx 1, rdx 2, rbx 3, rsi 6, rdi 7, r8..r15).
/#/ The allocator works on pool slots, the index into the pool table; the first `tg_ncaller()` slots
/#/ are the caller-saved ones, the rest are saved by the function that uses them.

/#/ The number of general registers the allocator may hand out.
fn tg_npool() => int:
    return 10

/#/ The pool in the order the allocator tries it: the caller-saved registers first (r10, then r8 and
/#/ r9, the registers of the fifth and sixth argument, then r11 and rdi), then the saved ones (rbx,
/#/ r12..r15).
fn tg_pool() => buf<int>:
    let regs: buf<int> = new_buf(int, 10)
    regs[0] = 10
    regs[1] = 8
    regs[2] = 9
    regs[3] = 11
    regs[4] = 7
    regs[5] = 3
    regs[6] = 12
    regs[7] = 13
    regs[8] = 14
    regs[9] = 15
    return regs

/#/ How many of the first pool slots a call may overwrite.
fn tg_ncaller() => int:
    return 5

/#/ Is pool slot `s` kept for something else in sandboxed code (`sbx`: r14 is the shadow frame;
/#/ `bm`, the base-register form: r15 holds the start of the linear memory and r13 an address)?
fn tg_reserved(sbx: bool, bm: bool, s: int) => bool:
    if sbx && s == 8:
        return true
    return bm && (s == 7 || s == 9)

/#/ The bit that register `r` has in a call's write mask; the pool register of slot 0 (r10) has bit 0.
fn tg_call_bit(r: int) => int:
    if r == 8:
        return 1
    if r == 9:
        return 2
    if r == 11:
        return 3
    if r == 7:
        return 4
    return 0

/#/ Is `r` one of the registers a call may overwrite, apart from the scratch ones?
fn tg_is_caller_saved(r: int) => bool:
    return r == 7 || r == 8 || r == 9 || r == 10 || r == 11

/#/ The write mask of a call of a function not seen yet: every caller-saved pool register.
fn tg_mask_all() => int:
    return 31

/#/ The mask bits of the registers that carry the integer arguments past the fourth (r8 and r9)
/#/ and the aggregate argument or result (rdi).
fn tg_mask_arg5() => int:
    return 2

fn tg_mask_arg6() => int:
    return 4

fn tg_mask_rdi() => int:
    return 16

/#/ The first float register the allocator hands out (xmm0 and xmm1 are scratch), and the first of
/#/ those that carry the float parameters and arguments (xmm8..xmm15; a value there never lives
/#/ across a call or the entry).
fn tg_xmm_first() => int:
    return 2

fn tg_xmm_arg_first() => int:
    return 8




/#/ Can value `v` live in a register? Scalars made by instructions or block parameters.
fn g_wants_reg(g: &Gen, f: &Fun, v: int) => bool:
    if f.fwd[v] >= 0:
        return false
    let r = f.rep[v]
    if r == int(Rp.Void) || r >= rp_first_agg():
        return false
    let op = f.op[v]
    return !(op == int(Op.Slot) || op == int(Op.Const) || op == int(Op.StrLit) || op == int(Op.Undef) || op == int(Op.OwnMove))

/#/ Does instruction `i` make a call (so that the registers a callee may write are lost)?
fn g_is_clobber(g: &Gen, f: &Fun, i: int) => bool:
    let op = f.op[i]
    if g_uses_rdi(g, f, i):
        return true
    return op == int(Op.Call) || op == int(Op.CCall) || op == int(Op.CallI) || op == int(Op.Drop) || op == int(Op.Clone) || op == int(Op.VLoop)

/#/ Does instruction `i` use rdi as a scratch register (the aggregate store and return)?
fn g_uses_rdi(g: &Gen, f: &Fun, i: int) => bool:
    let op = f.op[i]
    if op == int(Op.Store) && f.rep[g_res(g, f, f.b[i])] >= rp_first_agg():
        return true
    return op == int(Op.Ret) && f.a[i] >= 0 && f.rep[g_res(g, f, f.a[i])] >= rp_first_agg()

/#/ The caller-saved registers that the call `i` may write: all of them unless it is a call of a
/#/ function of this object that was generated before (then what that one writes), and r8 and r9
/#/ when its arguments go through them.
fn g_site_mask(g: &Gen, f: &Fun, i: int) => int:
    if g_uses_rdi(g, f, i):
        return tg_mask_rdi()
    if f.op[i] != int(Op.Call):
        return tg_mask_all()
    let id = f.aux[i]
    let m = tg_mask_all()
    if id >= 0 && id < len(g.msk) && g.msk[id] > 0:
        m = g.msk[id] - 8
    if f.b[i] >= 5:
        m = m | tg_mask_arg5()
    if f.b[i] >= 6:
        m = m | tg_mask_arg6()
    if f.rep[i] >= rp_first_agg():
        m = m | tg_mask_arg5()
    if f.b[i] >= 1 || f.rep[i] >= rp_first_agg():
        m = m | tg_mask_rdi()
    return m

/#/ The registers written by the calls strictly between positions `lo` and `hi`.
fn g_cm_in(g: &Gen, lo: int, hi: int) => int:
    let a = 0
    let b = g.ra_ncp
    while a < b:
        let mid = (a + b) // 2
        if g.ra_cp[mid] > lo:
            b = mid
        else:
            a = mid + 1
    let m = 0
    while a < g.ra_ncp && g.ra_cp[a] < hi:
        m = m | g.ra_cm[a]
        a = a + 1
    return m

/#/ May a value that lives across calls writing `cm` and (`restr`) is a parameter or an argument
/#/ take register number `r` of the pool?
fn g_reg_ok(g: &Gen, r: int, cm: int, restr: bool) => bool:
    if tg_reserved(g.a.sbx, g.a.bm, r):
        return false
    if r >= tg_ncaller():
        return true
    if ((cm >> r) & 1) == 1:
        return false
    return r == 0 || !restr

/#/ Is there a call strictly between positions `lo` and `hi`?
fn g_crosses(g: &Gen, lo: int, hi: int) => bool:
    let a = 0
    let b = g.ra_ncp
    while a < b:
        let mid = (a + b) // 2
        if g.ra_cp[mid] > lo:
            b = mid
        else:
            a = mid + 1
    return a < g.ra_ncp && g.ra_cp[a] < hi

/#/ Counts the uses of every value of `f`, through forwarding and `own.move`.
fn g_count_uses(g: &Gen, f: &Fun) => void:
    if len(g.nuse) < f.ni + 1:
        g.nuse = new_buf(int, f.ni + 1)
    for v in 0..f.ni + 1:
        g.nuse[v] = 0
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            for k in 0..f.nval(i):
                let v = f.val_at(i, k)
                if v >= 0:
                    let x = g_res(g, f, v)
                    g.nuse[x] = g.nuse[x] + 1
            i = f.nx[i]
    for e in 0..f.ne:
        if f.eto[e] >= 0:
            for k in 0..f.eargn[e]:
                let x = g_res(g, f, f.pool[f.eargs[e] + k])
                g.nuse[x] = g.nuse[x] + 1

/#/ Is `x`, an `index` or a `field`, only the address of the scalar `load` or `store` right
/#/ after it? Then the access uses the address mode and `x` makes no code of its own.
fn g_folds(g: &Gen, f: &Fun, x: int) => bool:
    let op = f.op[x]
    if op != int(Op.Index) && op != int(Op.Field):
        return false
    if g.nuse[x] != 1 || f.fwd[x] >= 0:
        return false
    if op == int(Op.Index):
        let sz = f.aux[x]
        if sz != 1 && sz != 2 && sz != 4 && sz != 8:
            return false
    let u = f.nx[x]
    if u < 0:
        return false
    if f.op[u] == int(Op.Load):
        return g_res(g, f, f.a[u]) == x && f.rep[u] < rp_first_agg()
    if f.op[u] == int(Op.Store):
        let v = g_res(g, f, f.b[u])
        return g_res(g, f, f.a[u]) == x && v != x && f.rep[v] < rp_first_agg()
    return false

/#/ The address of the folded `x` as base, index, scale and displacement in `am_*`; what is not
/#/ in a register of its own is loaded into `s1` (the base) and `s2` (the index).
fn g_addr_of(g: &Gen, f: &Fun, x: int, s1: int, s2: int) => void:
    g.am_base = g_src(g, f, f.a[x], s1)
    if f.op[x] == int(Op.Index) && g_near_const(g, f, f.b[x]):
        g.am_idx = -1
        g.am_scale = 1
        g.am_disp = f.aux[g_res(g, f, f.b[x])] * f.aux[x]
    elif f.op[x] == int(Op.Index):
        g.am_idx = g_src(g, f, f.b[x], s2)
        g.am_scale = f.aux[x]
        g.am_disp = 0
    else:
        g.am_idx = -1
        g.am_scale = 1
        g.am_disp = f.aux[x]

/#/ Does a call stand at position `p`?
fn g_at_call(g: &Gen, p: int) => bool:
    let a = 0
    let b = g.ra_ncp
    while a < b:
        let mid = (a + b) // 2
        if g.ra_cp[mid] >= p:
            b = mid
        else:
            a = mid + 1
    return a < g.ra_ncp && g.ra_cp[a] == p

/#/ The edges leaving block `b`, in `ed`.
fn g_term_edges(g: &Gen, f: &Fun, b: int) => void:
    g.ned = 0
    let t = f.blast[b]
    if t < 0:
        return
    let op = f.op[t]
    if op == int(Op.Br):
        g_add_edge(g, f.aux[t])
    elif op == int(Op.CondBr):
        g_add_edge(g, f.b[t])
        g_add_edge(g, f.c[t])

fn g_add_edge(g: &Gen, e: int) => void:
    if g.ned >= len(g.ed):
        g.ed = buf_resize(g.ed, (g.ned + 1) * 2)
    g.ed[g.ned] = e
    g.ned = g.ned + 1

/#/ Chooses a register for the values that deserve one: `home` of every value (-1 for the frame).
/#/ Live ranges are single intervals of the block order, made from the liveness of every block.
fn g_alloc_regs(g: &Gen, f: &Fun, rs: &Reps) => void:
    let n = f.ni
    if len(g.home) < n + 1:
        g.home = new_buf(int, n + 1)
        g.xhome = new_buf(int, n + 1)
        g.xsg = new_buf(int, n + 1)
        g.did = new_buf(int, n + 1)
    for v in 0..n:
        g.home[v] = -1
        g.xhome[v] = -1
        g.xsg[v] = 0
        g.did[v] = -1
    g.nsaved = 0
    g.ra_ncp = 0
    g.fmask = 31
    let bs: buf<int> = new_buf(int, f.nb + 1)
    let be: buf<int> = new_buf(int, f.nb + 1)
    let depth: buf<int> = new_buf(int, f.nb + 1)
    /#/ loop depth: a back edge (to a block not after its source in the order of the code) wraps the
    /#/ blocks between
    let at: buf<int> = new_buf(int, f.nb + 1)
    for oi in 0..f.nb:
        at[g.ord[oi]] = oi
    for b in 0..f.nb:
        g_term_edges(g, f, b)
        for k in 0..g.ned:
            let t = f.eto[g.ed[k]]
            if t >= 0 && at[t] <= at[b]:
                for q in at[t]..at[b] + 1:
                    depth[g.ord[q]] = depth[g.ord[q]] + 1
    /#/ dense numbers, positions: uses at even numbers, definitions after them
    let nd = 0
    for b in 0..f.nb:
        let p = f.pfirst[b]
        while p >= 0:
            if g_wants_reg(g, f, p):
                g.did[p] = nd
                nd = nd + 1
            p = f.nx[p]
        let i = f.bfirst[b]
        while i >= 0:
            if g_wants_reg(g, f, i):
                g.did[i] = nd
                nd = nd + 1
            i = f.nx[i]
    g.nhc = 0
    /#/ a float constant used inside a loop is loaded once, at the entry (when the entry is no loop)
    let entry_ok = g.ord[0] == 0
    for b in 0..f.nb:
        g_term_edges(g, f, b)
        for k in 0..g.ned:
            if f.eto[g.ed[k]] == 0:
                entry_ok = false
    if entry_ok:
        for b in 0..f.nb:
            if depth[b] == 0:
                continue
            let i = f.bfirst[b]
            while i >= 0:
                for k in 0..f.nval(i):
                    nd = g_hoist_const(g, f, f.val_at(i, k), nd)
                i = f.nx[i]
            g_term_edges(g, f, b)
            for k in 0..g.ned:
                let e = g.ed[k]
                for j in 0..f.eargn[e]:
                    nd = g_hoist_const(g, f, f.pool[f.eargs[e] + j], nd)
    if nd == 0:
        return
    let dv: buf<int> = new_buf(int, nd + 1)
    g.ra_lo = new_buf(int, nd + 1)
    g.ra_hi = new_buf(int, nd + 1)
    g.ra_wt = new_buf(int, nd + 1)
    g.ra_dblk = new_buf(int, nd + 1)
    g.ra_dset = new_buf(int, nd + 1)
    g.nuq = 0
    for d in 0..nd:
        g.ra_lo[d] = 1000000000
        g.ra_hi[d] = -1
    g.fmask = 0
    let pos = 0
    for oi in 0..f.nb:
        let b = g.ord[oi]
        bs[b] = pos + 1
        let p = f.pfirst[b]
        let w = 1
        for q in 0..depth[b]:
            if w < 4096:
                w = w * 8
        while p >= 0:
            let d = g.did[p]
            if d >= 0:
                dv[d] = p
                g.ra_dblk[d] = b
                g.ra_lo[d] = pos + 1
                g.ra_hi[d] = pos + 1
                g.ra_wt[d] = g.ra_wt[d] + w
            p = f.nx[p]
        pos = pos + 2
        let i = f.bfirst[b]
        be[b] = bs[b]
        while i >= 0:
            be[b] = pos
            if g_is_clobber(g, f, i):
                if g.ra_ncp >= len(g.ra_cp):
                    g.ra_cp = buf_resize(g.ra_cp, (g.ra_ncp + 1) * 2)
                if g.ra_ncp >= len(g.ra_cm):
                    g.ra_cm = buf_resize(g.ra_cm, (g.ra_ncp + 1) * 2)
                g.ra_cp[g.ra_ncp] = pos
                g.ra_cm[g.ra_ncp] = g_site_mask(g, f, i)
                g.fmask = g.fmask | g.ra_cm[g.ra_ncp]
                g.ra_ncp = g.ra_ncp + 1
            let d = g.did[i]
            if d >= 0:
                dv[d] = i
                g.ra_dblk[d] = b
                g.ra_lo[d] = pos + 1
                g.ra_hi[d] = pos + 1
                g.ra_wt[d] = g.ra_wt[d] + w
            i = f.nx[i]
            pos = pos + 2
    for k in 0..g.nhc:
        let c = g.hc[k]
        let d = g.did[c]
        dv[d] = c
        g.ra_dblk[d] = 0
        g.ra_lo[d] = bs[0]
        g.ra_hi[d] = bs[0]
        g.ra_dset[d] = 1
    /#/ the uses: those of a value not defined (yet) in the block they are in make it live into the block
    for b in 0..f.nb:
        let w = 1
        for q in 0..depth[b]:
            if w < 4096:
                w = w * 8
        let p = f.pfirst[b]
        while p >= 0:
            if g.did[p] >= 0:
                g.ra_dset[g.did[p]] = 1
            p = f.nx[p]
        let i = f.bfirst[b]
        let ip = bs[b] + 1
        while i >= 0:
            for k in 0..f.nval(i):
                g_note_use(g, f, f.val_at(i, k), b, ip, w)
            let d = g.did[i]
            if d >= 0:
                g.ra_dset[d] = 1
            i = f.nx[i]
            ip = ip + 2
        g_term_edges(g, f, b)
        for k in 0..g.ned:
            let e = g.ed[k]
            for j in 0..f.eargn[e]:
                g_note_use(g, f, f.pool[f.eargs[e] + j], b, be[b], w)
    /#/ liveness: from each such use walk back over the predecessors up to the block of the definition;
    /#/ the blocks walked are the ones the value is live into, their predecessors the ones it is live
    /#/ out of. The ranges cover those. `lvs`/`lve` bound each value's blocks in `lvb`.
    let pc: buf<int> = new_buf(int, f.nb + 2)
    for b in 0..f.nb:
        g_term_edges(g, f, b)
        for k in 0..g.ned:
            let t = f.eto[g.ed[k]]
            if t >= 0:
                pc[t + 1] = pc[t + 1] + 1
    for b in 0..f.nb:
        pc[b + 1] = pc[b + 1] + pc[b]
    let pred: buf<int> = new_buf(int, pc[f.nb] + 1)
    let pfill: buf<int> = new_buf(int, f.nb + 1)
    for b in 0..f.nb:
        g_term_edges(g, f, b)
        for k in 0..g.ned:
            let t = f.eto[g.ed[k]]
            if t >= 0:
                pred[pc[t] + pfill[t]] = b
                pfill[t] = pfill[t] + 1
    /#/ the uses by value
    let uc: buf<int> = new_buf(int, nd + 2)
    for q in 0..g.nuq:
        uc[g.uq_d[q] + 1] = uc[g.uq_d[q] + 1] + 1
    for d in 0..nd:
        uc[d + 1] = uc[d + 1] + uc[d]
    let ub: buf<int> = new_buf(int, g.nuq + 1)
    let ufill: buf<int> = new_buf(int, nd + 1)
    for q in 0..g.nuq:
        let d = g.uq_d[q]
        ub[uc[d] + ufill[d]] = g.uq_b[q]
        ufill[d] = ufill[d] + 1
    let inm: buf<int> = new_buf(int, f.nb + 1)
    let stack: buf<int> = new_buf(int, f.nb + 1)
    let lvb: buf<int> = new_buf(int, 64)
    let nlv = 0
    let lvs: buf<int> = new_buf(int, nd + 1)
    let lve: buf<int> = new_buf(int, nd + 1)
    for d in 0..nd:
        lvs[d] = nlv
        let stamp = d + 1
        let db = g.ra_dblk[d]
        for q in uc[d]..uc[d + 1]:
            let u = ub[q]
            if inm[u] == stamp || u == db:
                continue
            let sp = 0
            stack[0] = u
            sp = 1
            inm[u] = stamp
            while sp > 0:
                sp = sp - 1
                let x = stack[sp]
                if nlv >= len(lvb):
                    lvb = buf_resize(lvb, (nlv + 1) * 2)
                lvb[nlv] = x
                nlv = nlv + 1
                if bs[x] < g.ra_lo[d]:
                    g.ra_lo[d] = bs[x]
                if bs[x] > g.ra_hi[d]:
                    g.ra_hi[d] = bs[x]
                for r in pc[x]..pc[x + 1]:
                    let pb = pred[r]
                    if be[pb] + 1 > g.ra_hi[d]:
                        g.ra_hi[d] = be[pb] + 1
                    if be[pb] + 1 < g.ra_lo[d]:
                        g.ra_lo[d] = be[pb] + 1
                    if pb != db && inm[pb] != stamp:
                        inm[pb] = stamp
                        stack[sp] = pb
                        sp = sp + 1
        lve[d] = nlv
    /#/ coalescing: a value computed in block `b` and passed on a back edge to the parameter `p` may
    /#/ take p's register when p is not read after it (in `b`, or in what follows `b`) and the value
    /#/ does not leave `b`; their ranges overlap only because p stays alive on its other paths
    let coal: buf<int> = new_buf(int, nd + 1)
    for d in 0..nd:
        coal[d] = -1
    for b in 0..f.nb:
        g_term_edges(g, f, b)
        for k in 0..g.ned:
            let e = g.ed[k]
            let t = f.eto[e]
            if t < 0 || at[t] > at[b]:
                continue
            let pp = f.pfirst[t]
            for j in 0..f.eargn[e]:
                let x = g_res(g, f, f.pool[f.eargs[e] + j])
                let dx = g.did[x]
                let dp = g.did[pp]
                if dx >= 0 && dp >= 0 && f.op[x] != int(Op.Param) && f.blk[x] == b && coal[dx] < 0:
                    let ok = !g_live_out_of(g, f, b, dx, &lvb, &lvs, &lve)
                    if g_live_out_of(g, f, b, dp, &lvb, &lvs, &lve):
                        ok = false
                    let i = f.nx[x]
                    while ok && i >= 0:
                        for q in 0..f.nval(i):
                            if f.val_at(i, q) >= 0 && g_res(g, f, f.val_at(i, q)) == pp:
                                ok = false
                        i = f.nx[i]
                    for k2 in 0..g.ned:
                        let e2 = g.ed[k2]
                        for j2 in 0..f.eargn[e2]:
                            if g_res(g, f, f.pool[f.eargs[e2] + j2]) == pp:
                                ok = false
                    if ok:
                        coal[dx] = dp
                pp = f.nx[pp]
    /#/ what a register is worth to a value: its uses (weighted by loop depth) per position of its range
    let dn: buf<int> = new_buf(int, nd + 1)
    for d in 0..nd:
        dn[d] = g.ra_wt[d] * 1024 // (g.ra_hi[d] - g.ra_lo[d] + 2)
    /#/ linear scan, by start
    let top = pos + 4
    let first: buf<int> = new_buf(int, top + 1)
    let link: buf<int> = new_buf(int, nd + 1)
    for q in 0..top + 1:
        first[q] = -1
    let sd = nd - 1
    while sd >= 0:
        link[sd] = first[g.ra_lo[sd]]
        first[g.ra_lo[sd]] = sd
        sd = sd - 1
    /#/ the caller-saved registers first (r10, then r8 and r9, the registers of the fifth and sixth
    /#/ argument), then the saved ones
    let regs = tg_pool()
    let ent: buf<int> = new_buf(int, nd + 1)
    let ep = f.pfirst[0]
    while ep >= 0:
        if g.did[ep] >= 0:
            ent[g.did[ep]] = 1
        ep = f.nx[ep]
    for k in 0..g.nhc:
        ent[g.did[g.hc[k]]] = 1
    let occ: buf<int> = new_buf(int, tg_npool())
    for r in 0..tg_npool():
        occ[r] = -1
    let used: buf<int> = new_buf(int, tg_npool())
    /#/ the xmm registers 2 to 15 for floats that are not alive across a call (all are caller-saved);
    /#/ the arguments are loaded into xmm0 to xmm7, so a parameter or an argument stays in 8 to 15
    let occx: buf<int> = new_buf(int, 16)
    for r in 0..16:
        occx[r] = -1
    for q in 0..top + 1:
        let cd = first[q]
        while cd >= 0:
            let d = cd
            let nxt = link[d]
            let fr_x = -1
            let rd = f.rep[dv[d]]
            if (rd == int(Rp.F32) || rd == int(Rp.F64)) && !g_crosses(g, g.ra_lo[d], g.ra_hi[d]):
                let lowx = 2
                if ent[d] == 1 || g_at_call(g, g.ra_hi[d]):
                    lowx = 8
                for r in 2..16:
                    if occx[r] >= 0 && g.ra_hi[occx[r]] < g.ra_lo[d]:
                        occx[r] = -1
                for r in lowx..16:
                    if occx[r] < 0 && fr_x < 0:
                        fr_x = r
                if fr_x >= 0:
                    occx[fr_x] = d
                    g.xhome[dv[d]] = fr_x
                    if rd == int(Rp.F32):
                        g.xsg[dv[d]] = 1
                    cd = nxt
                    continue
            /#/ which of the caller-saved registers `d` may take: not one that a call it is alive
            /#/ across may write; only r10 when it is an argument of the call it ends at or a
            /#/ parameter of the function (loading the arguments or the parameters would overwrite it)
            let cm = g_cm_in(g, g.ra_lo[d], g.ra_hi[d])
            let restr = ent[d] == 1 || g_at_call(g, g.ra_hi[d])
            for r in 0..10:
                if occ[r] >= 0 && g.ra_hi[occ[r]] < g.ra_lo[d]:
                    occ[r] = -1
            let fr = -1
            /#/ the hint: the register of the first operand when it ends where `d` begins
            let hint = g_hint_reg(g, f, dv[d])
            let shared = -1
            if coal[d] >= 0 && g.home[dv[coal[d]]] >= 0 && g.ra_lo[coal[d]] < g.ra_lo[d]:
                for r in 0..10:
                    if regs[r] == g.home[dv[coal[d]]] && occ[r] == coal[d] && g_reg_ok(g, r, cm, restr):
                        shared = r
            if shared >= 0:
                fr = shared
            if hint >= 0 && fr < 0:
                for r in 0..10:
                    if regs[r] == hint && occ[r] < 0 && g_reg_ok(g, r, cm, restr):
                        fr = r
            for r in 0..10:
                if occ[r] < 0 && fr < 0 && g_reg_ok(g, r, cm, restr):
                    fr = r
            if fr >= 0:
                if shared < 0 || g.ra_hi[d] > g.ra_hi[occ[fr]]:
                    occ[fr] = d
                g.home[dv[d]] = regs[fr]
                used[fr] = 1
            else:
                /#/ the least wanted of the live ones and this one goes to the frame
                let worst = -1
                for r in 0..10:
                    if g_reg_ok(g, r, cm, restr):
                        if worst < 0 || dn[occ[r]] < dn[occ[worst]]:
                            worst = r
                if dn[occ[worst]] < dn[d]:
                    g.home[dv[occ[worst]]] = -1
                    g.home[dv[d]] = regs[worst]
                    occ[worst] = d
            cd = nxt
    /#/ the check: nothing in a caller-saved register is alive across a call, and r8 and r9
    /#/ hold neither a parameter nor an argument of the call that ends the value
    for d in 0..nd:
        let h = g.home[dv[d]]
        if tg_is_caller_saved(h):
            let bit = tg_call_bit(h)
            if ((g_cm_in(g, g.ra_lo[d], g.ra_hi[d]) >> bit) & 1) == 1:
                g.err = 1
            if h != regs[0] && (ent[d] == 1 || g_at_call(g, g.ra_hi[d])):
                g.err = 1
    for d in 0..nd:
        let xh = g.xhome[dv[d]]
        if xh >= 0:
            if g_crosses(g, g.ra_lo[d], g.ra_hi[d]) || xh < tg_xmm_first():
                g.err = 1
            if xh < tg_xmm_arg_first() && (ent[d] == 1 || g_at_call(g, g.ra_hi[d])):
                g.err = 1
    /#/ what this function may write: the registers of its calls, and its own caller-saved homes
    for r in 0..tg_ncaller():
        if used[r] == 1:
            g.fmask = g.fmask | (1 << r)
    if len(g.saved) < 6:
        g.saved = new_buf(int, 8)
    for r in 0..tg_npool():
        if used[r] == 1 && r >= tg_ncaller():
            g.saved[g.nsaved] = regs[r]
            g.nsaved = g.nsaved + 1

/#/ For an instruction that computes into its first operand's register (two-address): the
/#/ register that operand has, else -1.
fn g_hint_reg(g: &Gen, f: &Fun, v: int) => int:
    let op = f.op[v]
    if op == int(Op.Add) || op == int(Op.Sub) || op == int(Op.Mul) || op == int(Op.And) || op == int(Op.Or) || op == int(Op.Xor) || op == int(Op.Shl) || op == int(Op.AShr) || op == int(Op.LShr) || op == int(Op.Neg) || op == int(Op.Not):
        if f.a[v] >= 0:
            return g.home[g_res(g, f, f.a[v])]
        return -1
    if op == int(Op.Trunc) || op == int(Op.Bitcast) || op == int(Op.PtrToInt) || op == int(Op.IntToPtr) || op == int(Op.SExt) || op == int(Op.ZExt):
        if f.a[v] >= 0:
            return g.home[g_res(g, f, f.a[v])]
    return -1

/#/ Give the float constant `v` a number as a value to keep in a register, once; returns the new count.
fn g_hoist_const(g: &Gen, f: &Fun, v: int, nd: int) => int:
    if v < 0:
        return nd
    let x = g_res(g, f, v)
    if f.op[x] != int(Op.Const) || g.did[x] >= 0:
        return nd
    if f.rep[x] != int(Rp.F64) && f.rep[x] != int(Rp.F32):
        return nd
    if g.nhc >= len(g.hc):
        g.hc = buf_resize(g.hc, (g.nhc + 1) * 2)
    g.hc[g.nhc] = x
    g.nhc = g.nhc + 1
    g.did[x] = nd
    return nd + 1

fn g_note_use(g: &Gen, f: &Fun, v: int, b: int, p: int, w: int) => void:
    if v < 0:
        return
    let x = g_res(g, f, v)
    let d = g.did[x]
    if d < 0:
        return
    g.ra_wt[d] = g.ra_wt[d] + w
    if p < g.ra_lo[d]:
        g.ra_lo[d] = p
    if p > g.ra_hi[d]:
        g.ra_hi[d] = p
    if g.ra_dset[d] == 1 && g.ra_dblk[d] == b:
        return
    if g.nuq >= len(g.uq_d):
        g.uq_d = buf_resize(g.uq_d, (g.nuq + 1) * 2)
        g.uq_b = buf_resize(g.uq_b, (g.nuq + 1) * 2)
    g.uq_d[g.nuq] = d
    g.uq_b[g.nuq] = b
    g.nuq = g.nuq + 1

/#/ Is value `d` live out of block `b`: live into one of its successors?
fn g_live_out_of(g: &Gen, f: &Fun, b: int, d: int, lvb: &buf<int>, lvs: &buf<int>, lve: &buf<int>) => bool:
    g_term_edges(g, f, b)
    for k in 0..g.ned:
        let t = f.eto[g.ed[k]]
        if t >= 0:
            for q in lvs[d]..lve[d]:
                if lvb[q] == t:
                    return true
    return false

/#/ ---- frame -------------------------------------------------------------

fn g_place_size(g: &Gen, rs: &Reps, r: int) => int:
    let s = round8(rsize(rs, r))
    if s < 8:
        return 8
    return s

/#/ Gives every value its place; the size of the frame.
fn g_layout(g: &Gen, f: &Fun, rs: &Reps) => void:
    if len(g.voff) < f.ni + 1:
        g.voff = new_buf(int, f.ni + 1)
        g.sh = new_buf(int, f.ni + 1)
    for v in 0..f.ni:
        g.sh[v] = 0
    let sbx = g.a.sbx
    /#/ sandbox code keeps aggregates and the slots whose address is taken in the shadow frame, in
    /#/ the linear memory: a pointer to them is an offset like any other, and the host stack holds
    /#/ only what the code cannot name (return addresses, saved registers, spilled scalars)
    let scur = 0
    let cur = g.rbase + 8 * g.nsaved
    let tmp = 0
    for b in 0..f.nb:
        let p = f.pfirst[b]
        while p >= 0:
            if g.home[p] < 0 && g.xhome[p] < 0:
                if sbx && f.rep[p] >= rp_first_agg():
                    g.voff[p] = 0 - scur
                    g.sh[p] = 1
                    scur = scur + g_place_size(g, rs, f.rep[p])
                else:
                    cur = cur + g_place_size(g, rs, f.rep[p])
                    g.voff[p] = cur
            p = f.nx[p]
        let i = f.bfirst[b]
        while i >= 0:
            let op = f.op[i]
            if op == int(Op.Slot):
                let sz = round8(f.ty[i])
                if f.ty[i] < 1:
                    sz = sz + 8
                if sbx:
                    g.voff[i] = 0 - scur
                    g.sh[i] = 1
                    scur = scur + sz
                else:
                    cur = cur + sz
                    g.voff[i] = cur
            elif f.rep[i] != int(Rp.Void) && op != int(Op.OwnMove) && g.home[i] < 0 && g.xhome[i] < 0:
                if sbx && f.rep[i] >= rp_first_agg():
                    g.voff[i] = 0 - scur
                    g.sh[i] = 1
                    scur = scur + g_place_size(g, rs, f.rep[i])
                else:
                    cur = cur + g_place_size(g, rs, f.rep[i])
                    g.voff[i] = cur
            i = f.nx[i]
    for e in 0..f.ne:
        if f.eto[e] >= 0:
            let sum = 0
            for k in 0..f.eargn[e]:
                sum = sum + g_place_size(g, rs, f.rep[g_res(g, f, f.pool[f.eargs[e] + k])])
            if sum > tmp:
                tmp = sum
    cur = cur + tmp
    g.tmp = cur
    g.frame = (cur + 15) // 16 * 16
    g.sframe = (scur + 15) // 16 * 16
    /#/ a frame larger than the guard below the shadow stack could be stepped over
    if g.sframe > 32768:
        g.err = 1

/#/ ---- edges -------------------------------------------------------------

/#/ Copies what edge `e` passes into the parameters of the block it enters; through a scratch
/#/ area when an argument is itself a parameter of that block (the copies are simultaneous).
fn g_edge_copy(g: &Gen, f: &Fun, rs: &Reps, e: int) => void:
    let to = f.eto[e]
    let n = f.eargn[e]
    if n == 0:
        return
    let hazard = false
    let pj = f.pfirst[to]
    for k in 0..n:
        let x = g_res(g, f, f.pool[f.eargs[e] + k])
        if f.op[x] == int(Op.Param) && f.blk[x] == to:
            hazard = true
        /#/ a parameter already written must not be what a later argument reads
        let hx = g_hid(g, x)
        if hx >= 0:
            let q = f.pfirst[to]
            for j in 0..k:
                if g_hid(g, q) == hx:
                    hazard = true
                q = f.nx[q]
    if !hazard:
        let p = f.pfirst[to]
        for k in 0..n:
            if g.home[p] >= 0:
                g_ld(g, g.home[p], f, f.pool[f.eargs[e] + k])
            elif g.xhome[p] >= 0:
                let ax = g_res(g, f, f.pool[f.eargs[e] + k])
                if g.xhome[ax] >= 0:
                    if g.xhome[ax] != g.xhome[p]:
                        g.a.movaps(g.xhome[p], g.xhome[ax])
                else:
                    g_ld(g, 0, f, ax)
                    g_st(g, p, 0)
            else:
                g_val_to(g, f, rs, g_vb(g, p), 0 - g.voff[p], f.pool[f.eargs[e] + k])
            p = f.nx[p]
        return
    /#/ every parameter in a register: the copies as a sequence of moves, each after the ones that read
    /#/ its register; a cycle goes through rcx (general) or xmm0 (floats)
    let allreg = true
    let pp = f.pfirst[to]
    for k in 0..n:
        if g.home[pp] < 0 && g.xhome[pp] < 0:
            allreg = false
        pp = f.nx[pp]
    if allreg:
        g_edge_moves(g, f, e)
        return
    let at = 0
    for k in 0..n:
        let v = f.pool[f.eargs[e] + k]
        g_val_to(g, f, rs, 5, 0 - g.tmp + at, v)
        at = at + g_place_size(g, rs, f.rep[g_res(g, f, v)])
    let p = f.pfirst[to]
    at = 0
    for k in 0..n:
        let sz = g_place_size(g, rs, f.rep[p])
        if g.home[p] >= 0:
            g.a.load(g.home[p], 5, 0 - g.tmp + at, 8)
        elif g.xhome[p] >= 0:
            g.a.load(0, 5, 0 - g.tmp + at, 8)
            g_st(g, p, 0)
        else:
            g_copy_mem(g, g_vb(g, p), 0 - g.voff[p], 5, 0 - g.tmp + at, sz)
        at = at + sz
        p = f.nx[p]

/#/ The register a move reads, as `hid` numbers it; -1 when it reads a constant, an address or the frame.
fn g_move_src(g: &Gen, f: &Fun, x: int) => int:
    let k = f.op[x]
    if k == int(Op.Const) || k == int(Op.Undef) || k == int(Op.StrLit) || k == int(Op.Slot):
        return -1
    return g_hid(g, x)

/#/ The simultaneous copies of edge `e` into the parameters (all in registers) as moves in an order
/#/ where no move overwrites what a later one reads; a cycle is broken through a scratch register.
fn g_edge_moves(g: &Gen, f: &Fun, e: int) => void:
    let to = f.eto[e]
    let n = f.eargn[e]
    let pd: buf<int> = new_buf(int, n + 1)
    let pa: buf<int> = new_buf(int, n + 1)
    let ps: buf<int> = new_buf(int, n + 1)
    let done: buf<int> = new_buf(int, n + 1)
    let p = f.pfirst[to]
    for k in 0..n:
        pd[k] = p
        pa[k] = g_res(g, f, f.pool[f.eargs[e] + k])
        ps[k] = g_move_src(g, f, pa[k])
        p = f.nx[p]
    let left = n
    while left > 0:
        let progress = false
        for k in 0..n:
            if done[k] == 0:
                let d = g_hid(g, pd[k])
                let blocked = false
                for j in 0..n:
                    if j != k && done[j] == 0 && ps[j] == d:
                        blocked = true
                if !blocked:
                    g_emit_move(g, f, pd[k], pa[k], ps[k])
                    done[k] = 1
                    left = left - 1
                    progress = true
        if !progress:
            /#/ a cycle: some pending move reads a register that another pending move writes
            let s = -1
            for k in 0..n:
                if done[k] == 0 && s < 0:
                    let d = g_hid(g, pd[k])
                    for j in 0..n:
                        if j != k && done[j] == 0 && ps[j] == d && s < 0:
                            s = d
            if s < 32:
                g.a.mov_rr(1, s)
            else:
                g.a.movaps(0, s - 32)
            for j in 0..n:
                if done[j] == 0 && ps[j] == s:
                    if s < 32:
                        ps[j] = -2
                    else:
                        ps[j] = -3

/#/ One move: parameter `p` from the value `ax` (which sits in the register numbered `src`, or -2 / -3
/#/ when that was copied to rcx / xmm0).
fn g_emit_move(g: &Gen, f: &Fun, p: int, ax: int, src: int) => void:
    if g.home[p] >= 0:
        if src == -2:
            g.a.mov_rr(g.home[p], 1)
        elif src == -3:
            g.a.movq_r(g.home[p], 0, g.xsg[ax] == 1)
        else:
            g_ld(g, g.home[p], f, ax)
    else:
        if src == -3:
            g.a.movaps(g.xhome[p], 0)
        elif src == -2:
            g_st(g, p, 1)
        elif g.xhome[ax] >= 0 && src >= 32:
            if g.xhome[ax] != g.xhome[p]:
                g.a.movaps(g.xhome[p], g.xhome[ax])
        else:
            g_ld(g, 0, f, ax)
            g_st(g, p, 0)

/#/ A number for the register of `x`, general ones as they are and xmm ones from 32; -1 in the frame.
fn g_hid(g: &Gen, x: int) => int:
    if g.home[x] >= 0:
        return g.home[x]
    if g.xhome[x] >= 0:
        return 32 + g.xhome[x]
    return -1

/#/ ---- calls -------------------------------------------------------------








/#/ ---- the places of the lines of the flattened text ------------------------------------------------
/#/ The driver gives the stretches of the flattened text (from a line on, a file and a line of that
/#/ file) so that the line marks can name `file:line`; without them lines stay as numbers.
let dbg_seg_line = new_buf(int, 1)

let dbg_seg_src = new_buf(int, 1)

let dbg_seg_unit = new_buf(int, 1)

let dbg_nseg = 0

let dbg_units = new_txt()

let dbg_lines = 0

let dbg_dir = new_txt()

/#/ Variables and their types go in the table too (set with `-O0 -g`).
let dbg_vars = false

fn set_debug_vars() => void:
    dbg_vars = true

fn set_line_map(seg_line: &buf<int>, seg_src: &buf<int>, seg_unit: &buf<int>, nseg: int, units: &Txt, lines: int, dir: &Txt) => void:
    dbg_seg_line = new_buf(int, nseg + 1)
    dbg_seg_src = new_buf(int, nseg + 1)
    dbg_seg_unit = new_buf(int, nseg + 1)
    for k in 0..nseg:
        dbg_seg_line[k] = seg_line[k]
        dbg_seg_src[k] = seg_src[k]
        dbg_seg_unit[k] = seg_unit[k]
    dbg_nseg = nseg
    dbg_units = new_txt()
    dbg_units.put_all(units)
    dbg_lines = lines
    dbg_dir = new_txt()
    dbg_dir.put_all(dir)

/#/ The stretch of the flattened text that line `line` (1-based) is in, -1 when there is none.
fn dbg_seg_of(line: int) => int:
    if line < 1 || line > dbg_lines || dbg_nseg == 0:
        return 0 - 1
    let lo = 0
    let hi = dbg_nseg
    while lo < hi:
        let mid = (lo + hi) // 2
        if dbg_seg_line[mid] <= line - 1:
            lo = mid + 1
        else:
            hi = mid
    return lo - 1

/#/ The source file number `u` appended to `out`.
fn put_unit_name(out: &Txt, u: int) => void:
    let k = 0
    let s = 0
    for i in 0..dbg_units.n:
        if dbg_units.b[i] == 10:
            if k == u:
                for q in s..i:
                    out.put_byte(dbg_units.b[q])
                return
            k = k + 1
            s = i + 1

/#/ The line marks as text: `D directory` once when known, `F name` for each function, then
/#/ `L offset place` for each place where the code of another line starts (the offset from the start
/#/ of the function; the place is `file:line` when the driver gave the map, else the line of the
/#/ flattened text).
fn lines_dump(g: &Gen, out: &Txt) => void:
    if dbg_dir.n > 0:
        out.put("D ")
        out.put_all(&dbg_dir)
        out.put_byte(10)
    out.put_all(&g.dt.out)
    for k in 0..g.lf_n:
        let fn_txt = new_txt()
        let s = g.lf_sym[k] - 2
        for q in g.o.s_name[s]..g.o.s_name[s] + 4096:
            if g.o.names.b[q] == 0:
                break
            fn_txt.put_byte(g.o.names.b[q])
        let hi = g.lm_n
        if k + 1 < g.lf_n:
            hi = g.lf_m0[k + 1]
        let rows = new_txt()
        for m in g.lf_m0[k]..hi:
            /#/ a later mark at the same offset replaces an earlier one
            if m + 1 < hi && g.lm_at[m + 1] == g.lm_at[m]:
                continue
            let ln = g.lm_ln[m]
            if dbg_nseg > 0:
                let sg = dbg_seg_of(ln)
                if sg < 0:
                    continue
                rows.put("L ")
                rows.put_int(g.lm_at[m] - g.lf_start[k])
                rows.put_byte(32)
                put_unit_name(&rows, dbg_seg_unit[sg])
                rows.put_byte(58)
                rows.put_int(dbg_seg_src[sg] + (ln - 1 - dbg_seg_line[sg]))
                rows.put_byte(10)
            else:
                rows.put("L ")
                rows.put_int(g.lm_at[m] - g.lf_start[k])
                rows.put_byte(32)
                rows.put_int(ln)
                rows.put_byte(10)
        if rows.n > 0:
            out.put("F ")
            out.put_all(&fn_txt)
            out.put_byte(10)
            out.put_all(&rows)
            if k < len(g.vr_s) && g.vr_e[k] > g.vr_s[k]:
                for q in g.vr_s[k]..g.vr_e[k]:
                    out.put_byte(g.vtxt.b[q])






fn int_reg(k: int) => int:
    if k == 0:
        return 7
    if k == 1:
        return 6
    if k == 2:
        return 2
    if k == 3:
        return 1
    if k == 4:
        return 8
    return 9

fn round8(n: int) => int:
    return (n + 7) // 8 * 8

class Gen:
    a: Asm
    o: Obj
    /#/ the place of each value, as the distance below rbp; for a `slot` its area
    voff: buf<int>
    /#/ sandbox code: 1 for a value whose bytes are in the shadow frame (r14 + offset), not the host frame
    sh: buf<int>
    sframe: int
    tmp: int
    frame: int
    err: int
    av: buf<int>
    nav: int
    /#/ where the string literals are in .rodata, by number
    sbase: int
    soff: buf<int>
    nstr: int
    /#/ the register a value lives in, -1 for the frame; the registers used (saved in the prologue)
    home: buf<int>
    xhome: buf<int>
    /#/ the order the blocks of the function are emitted in
    ord: buf<int>
    emit: buf<int>
    xsg: buf<int>
    did: buf<int>
    nsaved: int
    /#/ 8 when [rbp-8] holds the pointer a function returning an aggregate was given, else 0
    rbase: int
    saved: buf<int>
    /#/ the edges leaving a block
    ed: buf<int>
    ned: int
    ra_lo: buf<int>
    ra_hi: buf<int>
    ra_wt: buf<int>
    /#/ the uses that are not of a value defined in the same block: value and block, `nuq` of them
    uq_d: buf<int>
    uq_b: buf<int>
    nuq: int
    /#/ per dense value: the block it is defined in, and whether its definition was passed in the scan of the uses
    ra_dblk: buf<int>
    ra_dset: buf<int>
    /#/ the positions of the instructions that call something, in order
    ra_cp: buf<int>
    ra_ncp: int
    /#/ per call position: the caller-saved registers (bit 0 r10, 1 r8, 2 r9, 3 r11, 4 rdi) the callee may write
    ra_cm: buf<int>
    /#/ the name id of the function being generated (-1: none), and per name id of a function of this
    /#/ object already generated, 8 + the registers it and everything it calls may write
    cur: int
    msk: buf<int>
    fmask: int
    /#/ how many times each value is used, counted again for the function being generated
    nuse: buf<int>
    /#/ the address a load or store was folded into: base, index (-1 if none), scale, displacement
    am_base: int
    am_idx: int
    am_scale: int
    am_disp: int
    /#/ the shared exit of a function that saves registers: its label, and whether a return jumps there
    epi: int
    epi_jump: bool
    /#/ float constants kept in an xmm register from the entry on (they are used in loops)
    hc: buf<int>
    nhc: int
    /#/ float constants read from the end of the function's own code: the bits and label of each, and the
    /#/ relocations that read them (and which constant), with the symbol of the function
    fk_bits: buf<int>
    fk_lab: buf<int>
    nfk: int
    fu_rl: buf<int>
    fu_k: buf<int>
    nfu: int
    fsym: int
    /#/ the source lines of the code: the offset in the text of the object where the code of a line
    /#/ starts, and the line (of the flattened text); `mk_*` are those of the function being made
    lm_at: buf<int>
    lm_ln: buf<int>
    lm_n: int
    mk_l: buf<int>
    mk_ln: buf<int>
    mk_n: int
    /#/ the functions with line marks: symbol, start in the text, first mark
    lf_sym: buf<int>
    lf_start: buf<int>
    lf_m0: buf<int>
    lf_n: int
    /#/ `-O0 -g`: the types, and the variables of each function with a line table (`V` lines; `vr_s`/`vr_e`
    /#/ say which part of `vtxt` is the one of function number `lf` k)
    dt: DbgTypes
    vtxt: Txt
    vr_s: buf<int>
    vr_e: buf<int>


fn g_add_str(g: &Gen, off: int) => void:
    if g.nstr >= len(g.soff):
        g.soff = buf_resize(g.soff, (g.nstr + 1) * 2)
    g.soff[g.nstr] = off
    g.nstr = g.nstr + 1

fn g_add_rodata(g: &Gen, t: &Txt) => void:
    g.o.ro.put_all(t)

/#/ Makes `name` an object of `size` zero bytes in `.data`.
fn g_add_global(g: &Gen, name: &Txt, size: int) => void:
    g.o.define_data(g.o.sym(name), size)

fn g_bad(g: &Gen) => void:
    g.err = g.err + 1

fn new_gen() => Gen:
    return Gen { a: new_asm(), o: new_obj(), voff: new_buf(int, 64), sh: new_buf(int, 64), sframe: 0, tmp: 0, frame: 0, err: 0, av: new_buf(int, 16), nav: 0, sbase: 256, soff: new_buf(int, 16), nstr: 0, home: new_buf(int, 64), xhome: new_buf(int, 64), ord: new_buf(int, 16), emit: new_buf(int, 16), xsg: new_buf(int, 64), did: new_buf(int, 64), nsaved: 0, rbase: 0, saved: new_buf(int, 8), ed: new_buf(int, 16), ned: 0, ra_lo: new_buf(int, 1), ra_hi: new_buf(int, 1), ra_wt: new_buf(int, 1), uq_d: new_buf(int, 16), uq_b: new_buf(int, 16), nuq: 0, ra_dblk: new_buf(int, 1), ra_dset: new_buf(int, 1), ra_cp: new_buf(int, 16), ra_ncp: 0, ra_cm: new_buf(int, 16), cur: -1, msk: new_buf(int, 16), fmask: 0, nuse: new_buf(int, 64), am_base: 0, am_idx: -1, am_scale: 1, am_disp: 0, epi: 0, epi_jump: false, hc: new_buf(int, 16), nhc: 0, fk_bits: new_buf(int, 8), fk_lab: new_buf(int, 8), nfk: 0, fu_rl: new_buf(int, 16), fu_k: new_buf(int, 16), nfu: 0, fsym: 0, lm_at: new_buf(int, 64), lm_ln: new_buf(int, 64), lm_n: 0, mk_l: new_buf(int, 64), mk_ln: new_buf(int, 64), mk_n: 0, lf_sym: new_buf(int, 64), lf_start: new_buf(int, 64), lf_m0: new_buf(int, 64), lf_n: 0, dt: new_dbg_types(), vtxt: new_txt(), vr_s: new_buf(int, 64), vr_e: new_buf(int, 64) }

fn rsize_scalar(r: int) => int:
    if r == int(Rp.I8):
        return 1
    if r == int(Rp.I16):
        return 2
    if r == int(Rp.I32) || r == int(Rp.F32):
        return 4
    return 8






/#/ The architectures and systems a target name may use.
fn arch_x86_64() => int:
    return 0

fn arch_aarch64() => int:
    return 1

fn os_linux() => int:
    return 0

let target_arch = 0
let target_os = 0

/#/ Does the text begin with `p`?
fn has_prefix(t: &Txt, p: &str) => bool:
    if t.n < len(p):
        return false
    for i in 0..len(p):
        if t.b[i] != ch(p, i):
            return false
    return true

/#/ The names accepted by `--target=`, for the error message.
fn target_names() => str:
    return "x86_64-linux"

/#/ Chooses the target by its name; 0 when it was set, 1 when the name is unknown, 2 when it is known
/#/ but there is no code generator for it yet.
fn set_target(name: &Txt) => int:
    if name.is("x86_64-linux") || name.is("x86_64"):
        target_arch = arch_x86_64()
        target_os = os_linux()
        return 0
    if name.is("aarch64-linux") || name.is("aarch64"):
        return 2
    return 1

/#/ The code of function `f` for the target; false when it could not be made.
fn gen_function(g: &Gen, f: &Fun, rs: &Reps, sy: &Names) => bool:
    if target_arch == arch_x86_64():
        return g_gen_fun(g, f, rs, sy)
    return false


use fflush in libc of c

fn expect(what: int, got: int, want: int) => int:
    if got != want:
        say(f"MISS #{what}: got {got}, want {want}\n")
        fflush(0)
        return 1
    return 0

fn st(name: &str) => int:
    let t = txt_of(name)
    return set_target(&t)

fn hp(text: &str, p: &str) => int:
    let t = txt_of(text)
    return has_prefix(&t, p))

fn main() => int:
    let m = 0
    m = m + expect(1, st("x86_64-linux"), 0)
    m = m + expect(2, st("x86_64"), 0)
    m = m + expect(3, st("aarch64-linux"), 2)
    m = m + expect(4, st("riscv"), 1)
    m = m + expect(5, st(""), 1)
    m = m + expect(6, target_arch, arch_x86_64())
    m = m + expect(7, hp("--target=x", "--target="), 1)
    m = m + expect(8, hp("--targe", "--target="), 0)
    return m

