/#/ The target names `--target=` accepts.
/#/ Output that needs no C library beyond `write`: every stage prints with these.
use write in libc of c

/#/ Writes `s` to standard output, at once (no buffering).
fn say(s: str) => void:
    write(1, s as object, len(s))

/#/ Writes the byte `c` to standard output.
fn say_byte(c: int) => void:
    let b: buf<i8> = new_buf(i8, 1)
    b[0] = i8(c)
    write(1, buf_ptr(b), 1)

/#/ Which machine the code is made for. `--target=<arch>-<os>` names it; the default is the machine the
/#/ compiler runs on, x86-64 Linux, the only one there is so far. Everything that depends on the
/#/ target asks here: `gen_function` picks the code generator, and the pieces still to be made per
/#/ target (the runtime's system calls in `rt/src/min.cf`, the object and executable format in `elf.cf`
/#/ and `ld/`) are listed in docs/explanation/ir-lowering-design.md.
/#/ Text built a byte at a time: the buffer the printer and the emitter write to.
/#/ The operations of the IR and the one table that defines them. The printer, the verifier,
/#/ the folder and the emitter ask this table; none of them lists operations on its own.

enum Op:
    Param
    Const
    StrLit
    FnAddr
    Undef
    Add
    Sub
    Mul
    SDiv
    UDiv
    SRem
    URem
    And
    Or
    Xor
    Shl
    AShr
    LShr
    Neg
    Not
    FAdd
    FSub
    FMul
    FDiv
    FRem
    FNeg
    Cmp
    FCmp
    Trunc
    SExt
    ZExt
    FpToSi
    FpToUi
    SiToFp
    UiToFp
    FpExt
    FpTrunc
    Bitcast
    PtrToInt
    IntToPtr
    Extract
    Insert
    Slot
    Load
    Store
    Field
    Index
    Call
    CCall
    CallI
    Alloc
    Free
    Drop
    Clone
    OwnMove
    Br
    CondBr
    Switch
    Ret
    Unreachable
    VLoop
    SMulHi

/#/ Comparison predicates; the signedness of an integer compare is in the predicate.
enum Pr:
    Eq
    Ne
    SLt
    SLe
    SGt
    SGe
    ULt
    ULe
    UGt
    UGe
    OEq
    ONe
    OLt
    OLe
    OGt
    OGe

/#/ Properties of an operation, as bits.
fn f_pure() => int:
    return 1

fn f_comm() => int:
    return 2

fn f_reads() => int:
    return 4

fn f_writes() => int:
    return 8

fn f_term() => int:
    return 16

fn f_consumes() => int:
    return 32

fn f_trap() => int:
    return 64

fn f_allocs() => int:
    return 128

/#/ Byte `i` of a string.
fn ch(src: &str, i: int) => int:
    if i < 0 || i >= len(src):
        return 0
    return int(src[i])

/#/ Operand count of an operation whose number of operands varies (calls).
fn var_args() => int:
    return -1

class OpTab:
    pool: buf<int>
    pool_n: int
    off: buf<int>
    size: buf<int>
    nargs: buf<int>
    flags: buf<int>
    n: int

    fn def(self, name: &str, nargs: int, flags: int) => void:
        if self.n >= len(self.off):
            let cap = (self.n + 1) * 2
            self.off = buf_resize(self.off, cap)
            self.size = buf_resize(self.size, cap)
            self.nargs = buf_resize(self.nargs, cap)
            self.flags = buf_resize(self.flags, cap)
        self.off[self.n] = self.pool_n
        self.size[self.n] = len(name)
        self.nargs[self.n] = nargs
        self.flags[self.n] = flags
        for i in 0..len(name):
            if self.pool_n >= len(self.pool):
                self.pool = buf_resize(self.pool, (self.pool_n + 1) * 2)
            self.pool[self.pool_n] = ch(name, i)
            self.pool_n = self.pool_n + 1
        self.n = self.n + 1

    fn has(self, op: int, flag: int) => bool:
        return (self.flags[op] & flag) != 0

/#/ The table, one row per `Op` in the order of the enum.
fn new_optab() => OpTab:
    let t = OpTab { pool: new_buf(int, 256), pool_n: 0, off: new_buf(int, 64), size: new_buf(int, 64), nargs: new_buf(int, 64), flags: new_buf(int, 64), n: 0 }
    let p = f_pure()
    let c = f_pure() | f_comm()
    let pt = f_pure() | f_trap()
    t.def("param", 0, p)
    t.def("const", 0, p)
    t.def("str.lit", 0, p)
    t.def("fn.addr", 0, p)
    t.def("undef", 0, p)
    t.def("add", 2, c)
    t.def("sub", 2, p)
    t.def("mul", 2, c)
    t.def("sdiv", 2, pt)
    t.def("udiv", 2, pt)
    t.def("srem", 2, pt)
    t.def("urem", 2, pt)
    t.def("and", 2, c)
    t.def("or", 2, c)
    t.def("xor", 2, c)
    t.def("shl", 2, p)
    t.def("ashr", 2, p)
    t.def("lshr", 2, p)
    t.def("neg", 1, p)
    t.def("not", 1, p)
    t.def("fadd", 2, c)
    t.def("fsub", 2, p)
    t.def("fmul", 2, c)
    t.def("fdiv", 2, p)
    t.def("frem", 2, p)
    t.def("fneg", 1, p)
    t.def("cmp", 2, p)
    t.def("fcmp", 2, p)
    t.def("trunc", 1, p)
    t.def("sext", 1, p)
    t.def("zext", 1, p)
    t.def("fptosi", 1, p)
    t.def("fptoui", 1, p)
    t.def("sitofp", 1, p)
    t.def("uitofp", 1, p)
    t.def("fpext", 1, p)
    t.def("fptrunc", 1, p)
    t.def("bitcast", 1, p)
    t.def("ptrtoint", 1, p)
    t.def("inttoptr", 1, p)
    t.def("extract", 1, p)
    t.def("insert", 2, p)
    t.def("slot", 0, f_allocs())
    t.def("load", 1, f_reads())
    t.def("store", 2, f_writes())
    t.def("field", 1, p)
    t.def("index", 2, p)
    t.def("call", var_args(), f_reads() | f_writes() | f_allocs())
    t.def("ccall", var_args(), f_reads() | f_writes() | f_allocs())
    t.def("calli", var_args(), f_reads() | f_writes() | f_allocs())
    t.def("alloc", 0, f_allocs())
    t.def("free", 1, f_writes() | f_consumes())
    t.def("drop", 1, f_writes() | f_consumes())
    t.def("clone", 1, f_reads() | f_allocs())
    t.def("own.move", 1, f_consumes())
    t.def("br", 0, f_term())
    t.def("condbr", 1, f_term())
    t.def("switch", 1, f_term())
    t.def("ret", 1, f_term())
    t.def("unreachable", 0, f_term())
    /#/ The vector loop of `vectorize`: arguments as for a call; see `gen_vloop`.
    t.def("vloop", var_args(), f_reads() | f_writes())
    /#/ The high 64 bits of the signed 128-bit product; made by `legalize` for a division by a constant.
    t.def("smulhi", 2, p)
    return t


use write, open, close in libc of c

class Txt:
    b: buf<int>
    n: int

    fn put_byte(self, c: int) => void:
        if self.n >= len(self.b):
            self.b = buf_resize(self.b, (self.n + 1) * 2)
        self.b[self.n] = c
        self.n = self.n + 1

    fn put(self, s: &str) => void:
        for i in 0..len(s):
            self.put_byte(ch(s, i))

    fn clear(self) => void:
        self.n = 0

    fn put_all(self, w: &Txt) => void:
        if self.n + w.n > len(self.b):
            self.b = buf_resize(self.b, (self.n + w.n) * 2)
        for i in 0..w.n:
            self.b[self.n + i] = w.b[i]
        self.n = self.n + w.n

    fn put_int(self, v: int) => void:
        if v < 0 - 9223372036854775807:
            /#/ the smallest int has no negation
            self.put_byte('-')
            self.put_int(922337203685477580)
            self.put_byte('8')
        elif v < 0:
            self.put_byte('-')
            self.put_int(0 - v)
        elif v < 10:
            self.put_byte('0' + v)
        else:
            self.put_int(v // 10)
            self.put_byte('0' + v % 10)

    /#/ `v` (not negative) in lower-case hexadecimal.
    fn put_hex(self, v: int) => void:
        if v >= 16:
            self.put_hex(v >> 4)
        let d = v & 15
        if d < 10:
            self.put_byte('0' + d)
        else:
            self.put_byte('a' + d - 10)

    /#/ Is the text the same as `o`?
    fn same(self, o: &Txt) => bool:
        if self.n != o.n:
            return false
        for i in 0..self.n:
            if self.b[i] != o.b[i]:
                return false
        return true

    /#/ Does the text equal `want`?
    fn is(self, want: &str) => bool:
        if self.n != len(want):
            return false
        for i in 0..self.n:
            if self.b[i] != ch(want, i):
                return false
        return true

fn new_txt() => Txt:
    return Txt { b: new_buf(int, 256), n: 0 }


/#/ Writes the bytes of `t` to the file `path`.
fn save_bytes(path: str, t: &Txt) => void:
    let fd = open(path, 577, 420 as object)
    if fd < 0:
        return
    let chunk: buf<i8> = new_buf(i8, t.n + 1)
    for k in 0..t.n:
        chunk[k] = i8(t.b[k])
    let done = 0
    while done < t.n:
        let w = write(fd, (int(buf_ptr(chunk)) + done) as object, t.n - done)
        if w <= 0:
            break
        done = done + w
    close(fd)

/#/ From the IR of a function to x86-64, the plainest way: every value has a place in the frame,
/#/ an instruction loads its operands into registers, computes and stores the result. No register
/#/ allocation yet; the point is a correct code generator that stands on its own.
/#/
/#/ Scalars may live in the callee-saved registers rbx, r12 to r15 instead of the frame: a linear
/#/ scan over live ranges (from a dataflow over the blocks) gives the busiest values a register for
/#/ their whole range; the rest stay in the frame. Nothing is saved around calls, the callee keeps them.
/#/
/#/ Frame (rbp-relative): [rbp-8] the pointer a function returning an aggregate was given, then one
/#/ 8-byte-aligned place per value (the memory layout for an aggregate, 8 bytes for a scalar, whose
/#/ upper bytes are not meaningful), the `slot` areas, and a scratch area for edge copies.
/#/
/#/ Calls follow the System V convention for scalars (integers and pointers in rdi, rsi, rdx, rcx,
/#/ r8, r9, floats in xmm0 to xmm7, the rest on the stack). An aggregate is passed as a pointer to
/#/ its place in the caller's frame and returned through a pointer in the first integer register.
/#/ An x86-64 ELF relocatable object: one `.text.<name>` section per function with its own
/#/ `.rela.text.<name>` (so a linker can drop the functions nothing reaches), `.rodata`, the
/#/ symbols, and an empty `.note.GNU-stack` (so the linker keeps the stack non-executable).
/#/ Section 1 `.text` and section 3 `.rela.text` stay in their places, empty.
/#/
/#/ Symbol numbers in the object: 0 is null, 1 the `.rodata` section, then the symbols of `Obj`
/#/ in the order they were made (`2 + k`). All of them are global; the locals before them are the
/#/ two above.
/#/ An x86-64 assembler for the instructions the code generator uses: byte by byte into a `Txt`,
/#/ jumps by label with the offsets patched when a function ends, calls and string addresses as
/#/ relocations for the object file.
/#/
/#/ Registers are numbered as the hardware does: rax 0, rcx 1, rdx 2, rbx 3, rsp 4, rbp 5, rsi 6,
/#/ rdi 7, r8 to r15 as 8 to 15; xmm registers by their own number. A memory operand is always
/#/ `[base + disp32]`, and the base is never rsp or r12 (those need an index byte).
/#/ (It imports `modopt` for the IR modules below it: a module cannot be imported by two routes.)
/#/ The passes that look at the whole module: a summary of the effects of each function,
/#/ calls that need not be made, and the attributes the summary proves. They work on the IR in
/#/ the `Lib`; nothing here reads or writes LLVM text.
/#/
/#/ Effect bits of a function: it reads memory it does not own (1), writes memory (2),
/#/ allocates (4), calls C or something unknown (8), never returns (16), may not terminate (32).
/#/ The functions of a module, kept side by side as columns so the optimizer can look into one
/#/ while it works on another (inlining) and so each function can be summarized.
/#/
/#/ `save` appends the columns of a function to the store, `restore` puts them back into a `Fun`.
/#/ Indices inside a function are its own (from 0); the store only remembers where the rows are.
/#/ The optimizer: a short list of linear passes over one function, run once, in an order
/#/ chosen so that one run reaches the result.
/#/
/#/   cleanup:  branches on a constant become jumps, unreachable blocks go, a block with one
/#/             predecessor that jumps to it is merged into it, instructions and block
/#/             parameters nobody uses go
/#/   own-opt:  `alloc` that is only freed goes with its `free`; `clone x` whose original
/#/             is dropped right after, and used nowhere else, is `x` itself
/#/
/#/ Every pass keeps the use counts of the columns right, so the next one can rely on them.
/#/ Not here yet: effect summaries, inlining and the attributes that come from them.
/#/ Block parameters made after the edges to their block exist: appending an argument to an
/#/ edge, and the clean-up that removes the parameters that turned out to be one value.
/#/ Names of functions, by number: the table the lowering and the backend share.
/#/ The checker of the IR. It runs after the builder and after every pass in tests, so a
/#/ mistake in one is found where it was made. It checks the shape (one terminator, last),
/#/ the edges (target, number and type of arguments), the types the operation needs, and that
/#/ every use is dominated by its definition.
/#/ The text form of the IR: what tests compare against and what a person reads.
/#/
/#/     fn name(%0: i64, %1: ptr) -> i64:
    /#/ consts:
    /#/   %2 = const i64 7
    /#/ bb0:
    /#/   %3 = add i64 %0, %2
    /#/   condbr %4, bb1(%3), bb2()
/#/ A function of the IR and its builder.
/#/
/#/ Instruction `i` is a row of the columns `op rep ty a b c aux`; its result is the value `i`.
/#/ A constant, a `str.lit` or an `undef` belongs to no block (`blk` is -1): it is available
/#/ everywhere. Everything else sits in one block's list (`nx`/`pv`), and a block's parameters
/#/ are `param` instructions in a list of their own. `fwd[i]` points to the value that replaced
/#/ `i`; read operands through `res`.
/#/
/#/ Operands: a b c for the plain operations. A call keeps its arguments in `pool` from `a`, `b`
/#/ of them. Terminators leave through *edges* (`eto`, and the arguments the target's
/#/ parameters receive, in `pool`): `br` has one in `aux`, `condbr` two in `b` and `c`, `switch`
/#/ a default in `c` and `b` pairs (value, edge) in `pool` from `aux`.

/#/ The representations an IR value can have: what the storage table of coffee/types calls
/#/ the value of a type. A closed set, so the IR never parses a type name.
/#/
/#/ 0 is `void` (no value), 1..7 are the scalars, and a number from 8 up is an aggregate
/#/ `{r1, r2, ...}` of other representations (tuples, and the `{ptr, i64}` of `buf<T>`).

enum Rp:
    Void
    I8
    I16
    I32
    I64
    F32
    F64
    Ptr

fn rp_first_agg() => int:
    return 8

fn rp_bits(r: int) => int:
    if r == int(Rp.I8):
        return 8
    if r == int(Rp.I16):
        return 16
    if r == int(Rp.I32):
        return 32
    if r == int(Rp.I64):
        return 64
    return 0

fn rp_is_int(r: int) => bool:
    return r >= int(Rp.I8) && r <= int(Rp.I64)

fn rp_is_float(r: int) => bool:
    return r == int(Rp.F32) || r == int(Rp.F64)

/#/ Aggregate representations are shared: equal element lists, equal id.
class Reps:
    start: buf<int>
    count: buf<int>
    pool: buf<int>
    pool_n: int
    n: int

    fn find(self, items: &buf<int>, k: int) => int:
        for r in 0..self.n:
            if self.count[r] == k:
                let same = true
                for i in 0..k:
                    if self.pool[self.start[r] + i] != items[i]:
                        same = false
                if same:
                    return r + rp_first_agg()
        return -1

    fn agg(self, items: &buf<int>, k: int) => int:
        let f = self.find(items, k)
        if f >= 0:
            return f
        if self.n >= len(self.start):
            self.start = buf_resize(self.start, (self.n + 1) * 2)
            self.count = buf_resize(self.count, (self.n + 1) * 2)
        self.start[self.n] = self.pool_n
        self.count[self.n] = k
        for i in 0..k:
            if self.pool_n >= len(self.pool):
                self.pool = buf_resize(self.pool, (self.pool_n + 1) * 2)
            self.pool[self.pool_n] = items[i]
            self.pool_n = self.pool_n + 1
        self.n = self.n + 1
        return self.n - 1 + rp_first_agg()

    fn elem(self, r: int, i: int) => int:
        return self.pool[self.start[r - rp_first_agg()] + i]

    fn elems(self, r: int) => int:
        return self.count[r - rp_first_agg()]

fn new_reps() => Reps:
    return Reps { start: new_buf(int, 8), count: new_buf(int, 8), pool: new_buf(int, 16), pool_n: 0, n: 0 }

/#/ The memory layout of a representation: size, alignment, offset of an element.
/#/ Bytes of a value of representation `r` in memory.
fn rsize(rs: &Reps, r: int) => int:
    if r == int(Rp.Void):
        return 0
    if r == int(Rp.I8):
        return 1
    if r == int(Rp.I16):
        return 2
    if r == int(Rp.I32) || r == int(Rp.F32):
        return 4
    if r < rp_first_agg():
        return 8
    let off = 0
    let al = 1
    for i in 0..rs.elems(r):
        let e = rs.elem(r, i)
        let ea = ralign(rs, e)
        off = (off + ea - 1) // ea * ea + rsize(rs, e)
        if ea > al:
            al = ea
    return (off + al - 1) // al * al

fn ralign(rs: &Reps, r: int) => int:
    if r < rp_first_agg():
        let s = rsize(rs, r)
        if s == 0:
            return 1
        return s
    let al = 1
    for i in 0..rs.elems(r):
        let ea = ralign(rs, rs.elem(r, i))
        if ea > al:
            al = ea
    return al

/#/ Offset of element `idx` of aggregate `r`.
fn elem_off(rs: &Reps, r: int, idx: int) => int:
    let off = 0
    for i in 0..idx + 1:
        let e = rs.elem(r, i)
        let ea = ralign(rs, e)
        off = (off + ea - 1) // ea * ea
        if i < idx:
            off = off + rsize(rs, e)
    return off


/#/ 64-bit values are kept as they are; narrower ones as the signed value in their range.
fn wrap(r: int, v: int) => int:
    let n = rp_bits(r)
    if n == 64 || n == 0:
        return v
    let m = 1 << n
    let x = v % m
    if x < 0:
        x = x + m
    if x >= m // 2:
        x = x - m
    return x

/#/ The unsigned value of a narrow integer.
fn unsigned_of(r: int, v: int) => int:
    let n = rp_bits(r)
    if v < 0 && n < 64:
        return v + (1 << n)
    return v

/#/ Division that rounds toward zero, as the hardware does.
fn tdiv(x: int, y: int) => int:
    let ax = x
    let ay = y
    if ax < 0:
        ax = 0 - ax
    if ay < 0:
        ay = 0 - ay
    let q = ax // ay
    if (x < 0) != (y < 0):
        return 0 - q
    return q

/#/ Unsigned `x < y` on 64-bit patterns.
fn ult64(x: int, y: int) => bool:
    if (x < 0) == (y < 0):
        return x < y
    return x >= 0

fn mirror_pred(p: int) => int:
    if p == int(Pr.SLt):
        return int(Pr.SGt)
    if p == int(Pr.SLe):
        return int(Pr.SGe)
    if p == int(Pr.SGt):
        return int(Pr.SLt)
    if p == int(Pr.SGe):
        return int(Pr.SLe)
    if p == int(Pr.ULt):
        return int(Pr.UGt)
    if p == int(Pr.ULe):
        return int(Pr.UGe)
    if p == int(Pr.UGt):
        return int(Pr.ULt)
    if p == int(Pr.UGe):
        return int(Pr.ULe)
    return p

fn hmix(h: int, v: int) => int:
    return (h * 31 + v % 1000003 + 1000003) % 1000003

class Fun:
    nm: buf<int>
    ret: int
    tab: OpTab
    op: buf<int>
    rep: buf<int>
    ty: buf<int>
    a: buf<int>
    b: buf<int>
    c: buf<int>
    aux: buf<int>
    nx: buf<int>
    pv: buf<int>
    uses: buf<int>
    /#/ the line (of the flattened text) of the statement an instruction comes from, 0 when unknown
    ln: buf<int>
    /#/ the line given to the instructions made from now on
    line: int
    fwd: buf<int>
    blk: buf<int>
    ni: int
    bfirst: buf<int>
    blast: buf<int>
    pfirst: buf<int>
    plast: buf<int>
    npar: buf<int>
    nb: int
    efrom: buf<int>
    eto: buf<int>
    eargs: buf<int>
    eargn: buf<int>
    ne: int
    pool: buf<int>
    np: int
    pend: buf<int>
    pn: int
    cv: buf<int>
    ce: buf<int>
    cn: int
    cur: int
    vn: buf<int>
    vn_n: int
    /#/ what the optimizer proved about the function, printed as attributes: see `Fa`
    attrs: int

    /#/ ---- storage -----------------------------------------------------------

    /#/ Starts a new function in the same columns: the buffers keep their size.
    fn reset(self, name: &Txt, ret: int) => void:
        let nm: buf<int> = new_buf(int, name.n)
        for k in 0..name.n:
            nm[k] = name.b[k]
        self.nm = nm
        self.ret = ret
        self.ni = 0
        self.nb = 0
        self.ne = 0
        self.np = 0
        self.pn = 0
        self.cn = 0
        self.cur = -1
        self.line = 0
        self.attrs = 0
        self.clear_vn()

    fn set_attrs(self, a: int) => void:
        self.attrs = a

    /#/ Room for at least `ni` instructions, `nb` blocks, `ne` edges and `np` pool entries.
    fn ensure(self, ni: int, nb: int, ne: int, np: int) => void:
        if ni > len(self.op):
            let cap = ni + 1
            self.op = buf_resize(self.op, cap)
            self.rep = buf_resize(self.rep, cap)
            self.ty = buf_resize(self.ty, cap)
            self.a = buf_resize(self.a, cap)
            self.b = buf_resize(self.b, cap)
            self.c = buf_resize(self.c, cap)
            self.aux = buf_resize(self.aux, cap)
            self.nx = buf_resize(self.nx, cap)
            self.pv = buf_resize(self.pv, cap)
            self.uses = buf_resize(self.uses, cap)
            self.ln = buf_resize(self.ln, cap)
            self.fwd = buf_resize(self.fwd, cap)
            self.blk = buf_resize(self.blk, cap)
        if nb > len(self.bfirst):
            let cap = nb + 1
            self.bfirst = buf_resize(self.bfirst, cap)
            self.blast = buf_resize(self.blast, cap)
            self.pfirst = buf_resize(self.pfirst, cap)
            self.plast = buf_resize(self.plast, cap)
            self.npar = buf_resize(self.npar, cap)
        if ne > len(self.eto):
            let cap = ne + 1
            self.efrom = buf_resize(self.efrom, cap)
            self.eto = buf_resize(self.eto, cap)
            self.eargs = buf_resize(self.eargs, cap)
            self.eargn = buf_resize(self.eargn, cap)
        if np > len(self.pool):
            self.pool = buf_resize(self.pool, np + 1)

    /#/ The function has `ni` instructions, `nb` blocks, `ne` edges and `np` pool entries.
    fn set_counts(self, ni: int, nb: int, ne: int, np: int) => void:
        self.ni = ni
        self.nb = nb
        self.ne = ne
        self.np = np
        self.pn = 0
        self.cn = 0
        self.cur = -1

    /#/ Forgets the shared values: the table no longer describes the instructions.
    fn reset_vn(self) => void:
        self.clear_vn()

    /#/ An empty table of value numbers. One grown for a big function is dropped for a small one
    /#/ rather than cleared: clearing costs its size for every function after it.
    fn clear_vn(self) => void:
        if self.vn_n * 8 < len(self.vn) && len(self.vn) > 256:
            self.vn = new_buf(int, 64)
        elif self.vn_n > 0:
            for k in 0..len(self.vn):
                self.vn[k] = -1
        else:
            return
        if len(self.vn) == 64:
            for k in 0..64:
                self.vn[k] = -1
        self.vn_n = 0

    /#/ Sets operand `k` of instruction `i`, the inverse of `val_at`.
    fn set_val_at(self, i: int, k: int, v: int) => void:
        let o = self.op[i]
        if o == int(Op.Call) || o == int(Op.CCall) || o == int(Op.VLoop):
            self.pool[self.a[i] + k] = v
        elif o == int(Op.CallI):
            if k == 0:
                self.c[i] = v
            else:
                self.pool[self.a[i] + k - 1] = v
        elif k == 0:
            self.a[i] = v
        elif k == 1:
            self.b[i] = v
        else:
            self.c[i] = v

    fn follow(self, v: int) => int:
        let x = v
        while x >= 0 && self.fwd[x] >= 0:
            x = self.fwd[x]
        return x

    fn grow_i(self) => void:
        if self.ni >= len(self.op):
            let cap = (self.ni + 1) * 2
            self.op = buf_resize(self.op, cap)
            self.rep = buf_resize(self.rep, cap)
            self.ty = buf_resize(self.ty, cap)
            self.a = buf_resize(self.a, cap)
            self.b = buf_resize(self.b, cap)
            self.c = buf_resize(self.c, cap)
            self.aux = buf_resize(self.aux, cap)
            self.nx = buf_resize(self.nx, cap)
            self.pv = buf_resize(self.pv, cap)
            self.uses = buf_resize(self.uses, cap)
            self.ln = buf_resize(self.ln, cap)
            self.fwd = buf_resize(self.fwd, cap)
            self.blk = buf_resize(self.blk, cap)

    fn pool_put(self, v: int) => int:
        if self.np >= len(self.pool):
            self.pool = buf_resize(self.pool, (self.np + 1) * 2)
        self.pool[self.np] = v
        self.np = self.np + 1
        return self.np - 1

    /#/ ---- operands ----------------------------------------------------------

    /#/ How many value operands instruction `i` has, not counting what its edges pass.
    fn nval(self, i: int) => int:
        let o = self.op[i]
        if o == int(Op.Call) || o == int(Op.CCall) || o == int(Op.VLoop):
            return self.b[i]
        if o == int(Op.CallI):
            return self.b[i] + 1
        if o == int(Op.Ret):
            if self.a[i] >= 0:
                return 1
            return 0
        let n = self.tab.nargs[o]
        if n < 0:
            return 0
        return n

    fn val_at(self, i: int, k: int) => int:
        let o = self.op[i]
        if o == int(Op.Call) || o == int(Op.CCall) || o == int(Op.VLoop):
            return self.pool[self.a[i] + k]
        if o == int(Op.CallI):
            if k == 0:
                return self.c[i]
            return self.pool[self.a[i] + k - 1]
        if k == 0:
            return self.a[i]
        if k == 1:
            return self.b[i]
        return self.c[i]

    fn bump_uses(self, i: int, d: int) => void:
        for k in 0..self.nval(i):
            let v = self.val_at(i, k)
            if v >= 0:
                self.uses[v] = self.uses[v] + d

    /#/ ---- blocks ------------------------------------------------------------

    fn new_block(self) => int:
        if self.nb >= len(self.bfirst):
            let cap = (self.nb + 1) * 2
            self.bfirst = buf_resize(self.bfirst, cap)
            self.blast = buf_resize(self.blast, cap)
            self.pfirst = buf_resize(self.pfirst, cap)
            self.plast = buf_resize(self.plast, cap)
            self.npar = buf_resize(self.npar, cap)
        let n = self.nb
        self.bfirst[n] = -1
        self.blast[n] = -1
        self.pfirst[n] = -1
        self.plast[n] = -1
        self.npar[n] = 0
        self.nb = n + 1
        return n

    /#/ Keeps only the first `n` blocks (the optimizer renumbers them to the front).
    fn set_blocks(self, n: int) => void:
        self.nb = n

    fn set_block(self, b: int) => void:
        self.cur = b

    fn terminated(self, b: int) => bool:
        let l = self.blast[b]
        return l >= 0 && self.tab.has(self.op[l], f_term())

    /#/ A new parameter of block `b`; its value is the instruction.
    fn param(self, b: int, rep: int, ty: int) => int:
        let i = self.mk(int(Op.Param), rep, ty, -1, -1, -1, self.npar[b])
        self.blk[i] = b
        self.pv[i] = self.plast[b]
        if self.plast[b] >= 0:
            self.nx[self.plast[b]] = i
        else:
            self.pfirst[b] = i
        self.plast[b] = i
        self.npar[b] = self.npar[b] + 1
        return i

    /#/ The `k`-th parameter of block `b`.
    fn param_at(self, b: int, k: int) => int:
        let p = self.pfirst[b]
        for j in 0..k:
            p = self.nx[p]
        return p

    /#/ ---- instructions ------------------------------------------------------

    /#/ A new instruction, in no block yet.
    fn mk(self, op: int, rep: int, ty: int, a: int, b: int, c: int, aux: int) => int:
        self.grow_i()
        let i = self.ni
        self.op[i] = op
        self.rep[i] = rep
        self.ty[i] = ty
        self.a[i] = a
        self.b[i] = b
        self.c[i] = c
        self.aux[i] = aux
        self.nx[i] = -1
        self.pv[i] = -1
        self.uses[i] = 0
        self.ln[i] = self.line
        self.fwd[i] = -1
        self.blk[i] = -1
        self.ni = i + 1
        self.bump_uses(i, 1)
        return i

    fn link(self, i: int) => void:
        let b = self.cur
        self.blk[i] = b
        self.pv[i] = self.blast[b]
        self.nx[i] = -1
        if self.blast[b] >= 0:
            self.nx[self.blast[b]] = i
        else:
            self.bfirst[b] = i
        self.blast[b] = i

    /#/ A new instruction at the end of the current block.
    fn raw(self, op: int, rep: int, ty: int, a: int, b: int, c: int, aux: int) => int:
        let i = self.mk(op, rep, ty, a, b, c, aux)
        self.link(i)
        return i

    /#/ ---- sharing -----------------------------------------------------------

    fn key_hash(self, op: int, rep: int, a: int, b: int, c: int, aux: int) => int:
        let h = hmix(op, rep)
        h = hmix(h, a)
        h = hmix(h, b)
        h = hmix(h, c)
        return hmix(h, aux)

    fn vn_put(self, i: int) => void:
        let cap = len(self.vn)
        let h = self.key_hash(self.op[i], self.rep[i], self.a[i], self.b[i], self.c[i], self.aux[i]) % cap
        while self.vn[h] >= 0:
            h = (h + 1) % cap
        self.vn[h] = i

    fn vn_grow(self) => void:
        let ids: buf<int> = new_buf(int, self.vn_n + 1)
        let k = 0
        for j in 0..len(self.vn):
            if self.vn[j] >= 0:
                ids[k] = self.vn[j]
                k = k + 1
        let cap = len(self.vn) * 2
        self.vn = new_buf(int, cap)
        for j in 0..cap:
            self.vn[j] = -1
        for j in 0..k:
            self.vn_put(ids[j])

    /#/ The instruction with these operands in the current block (or a constant); a new one
    /#/ when there is none. Only for operations with no effect.
    fn share(self, op: int, rep: int, ty: int, a: int, b: int, c: int, aux: int) => int:
        let cap = len(self.vn)
        let h = self.key_hash(op, rep, a, b, c, aux) % cap
        while self.vn[h] >= 0:
            let e = self.vn[h]
            if self.op[e] == op && self.rep[e] == rep && self.a[e] == a && self.b[e] == b && self.c[e] == c && self.aux[e] == aux && (self.blk[e] < 0 || self.blk[e] == self.cur):
                return e
            h = (h + 1) % cap
        let i = 0
        if op == int(Op.Const) || op == int(Op.StrLit) || op == int(Op.Undef):
            i = self.mk(op, rep, ty, a, b, c, aux)
        else:
            i = self.raw(op, rep, ty, a, b, c, aux)
        self.vn_n = self.vn_n + 1
        if self.vn_n * 2 > len(self.vn):
            self.vn_grow()
        self.vn_put(i)
        return i

    /#/ ---- constants ---------------------------------------------------------

    fn cint(self, rep: int, v: int) => int:
        return self.share(int(Op.Const), rep, -1, -1, -1, -1, wrap(rep, v))

    /#/ A float constant, given as its bit pattern.
    fn cfloat(self, rep: int, bits: int) => int:
        return self.share(int(Op.Const), rep, -1, -1, -1, -1, bits)

    fn undef(self, rep: int) => int:
        return self.share(int(Op.Undef), rep, -1, -1, -1, -1, 0)

    fn strlit(self, id: int) => int:
        return self.share(int(Op.StrLit), int(Rp.Ptr), -1, -1, -1, -1, id)

    /#/ The address of the function named `id`.
    fn fnaddr(self, id: int) => int:
        return self.raw(int(Op.FnAddr), int(Rp.Ptr), -1, -1, -1, -1, id)

    fn is_const(self, v: int) => bool:
        return self.op[v] == int(Op.Const) && rp_is_int(self.rep[v])

    fn cval(self, v: int) => int:
        return self.aux[v]

    /#/ ---- arithmetic: folded, simplified and shared as it is built ----------

    fn can_fold(self, op: int, rep: int, x: int, y: int) => bool:
        if op == int(Op.Add) || op == int(Op.Sub) || op == int(Op.Mul) || op == int(Op.And) || op == int(Op.Or) || op == int(Op.Xor):
            return true
        let n = rp_bits(rep)
        if op == int(Op.Shl) || op == int(Op.AShr):
            return y >= 0 && y < n
        if op == int(Op.LShr):
            return y >= 0 && y < n && (n < 64 || x >= 0)
        if op == int(Op.SDiv) || op == int(Op.SRem):
            return y != 0 && !(y == -1 && x == wrap(rep, 1 << (n - 1)))
        if op == int(Op.UDiv) || op == int(Op.URem):
            return y != 0 && (n < 64 || (x >= 0 && y > 0))
        return false

    fn fold2(self, op: int, rep: int, x: int, y: int) => int:
        if op == int(Op.Add):
            return wrap(rep, x + y)
        if op == int(Op.Sub):
            return wrap(rep, x - y)
        if op == int(Op.Mul):
            return wrap(rep, x * y)
        if op == int(Op.And):
            return wrap(rep, x & y)
        if op == int(Op.Or):
            return wrap(rep, x | y)
        if op == int(Op.Xor):
            return wrap(rep, x ^ y)
        if op == int(Op.Shl):
            return wrap(rep, x << y)
        if op == int(Op.AShr):
            return wrap(rep, x >> y)
        if op == int(Op.LShr):
            return wrap(rep, unsigned_of(rep, x) >> y)
        if op == int(Op.SDiv):
            return wrap(rep, tdiv(x, y))
        if op == int(Op.SRem):
            return wrap(rep, x - tdiv(x, y) * y)
        let ux = unsigned_of(rep, x)
        let uy = unsigned_of(rep, y)
        if op == int(Op.UDiv):
            return wrap(rep, ux // uy)
        return wrap(rep, ux - (ux // uy) * uy)

    /#/ `x op y`. Constants fold, identities collapse, an equal earlier one is reused.
    fn bin(self, op: int, x0: int, y0: int) => int:
        let x = self.follow(x0)
        let y = self.follow(y0)
        let rep = self.rep[x]
        let ty = self.ty[x]
        if !rp_is_int(rep):
            return self.share(op, rep, ty, x, y, -1, 0)
        if self.tab.has(op, f_comm()):
            let swap = false
            if self.is_const(x) && !self.is_const(y):
                swap = true
            elif !self.is_const(x) && !self.is_const(y) && x > y:
                swap = true
            if swap:
                let t = x
                x = y
                y = t
        let xc = self.is_const(x)
        let yc = self.is_const(y)
        if xc && yc && self.can_fold(op, rep, self.cval(x), self.cval(y)):
            return self.cint(rep, self.fold2(op, rep, self.cval(x), self.cval(y)))
        let yv = 0
        if yc:
            yv = self.cval(y)
        if op == int(Op.Add) || op == int(Op.Sub) || op == int(Op.Or) || op == int(Op.Xor) || op == int(Op.Shl) || op == int(Op.AShr) || op == int(Op.LShr):
            if yc && yv == 0:
                return x
        /#/ (x + c1) + c2 is x + (c1 + c2)
        if op == int(Op.Add) && yc && self.op[x] == int(Op.Add) && self.is_const(self.follow(self.b[x])):
            return self.bin(int(Op.Add), self.follow(self.a[x]), self.cint(rep, wrap(rep, self.cval(self.follow(self.b[x])) + yv)))
        if op == int(Op.Mul):
            if yc && yv == 1:
                return x
            if yc && yv == 0:
                return y
        if op == int(Op.And):
            if yc && yv == 0:
                return y
            if yc && yv == -1:
                return x
        if op == int(Op.Or) && yc && yv == -1:
            return y
        if (op == int(Op.SDiv) || op == int(Op.UDiv)) && yc && yv == 1:
            return x
        if (op == int(Op.SRem) || op == int(Op.URem)) && yc && yv == 1:
            return self.cint(rep, 0)
        /#/ x % m is x - x / m * m, so that a quotient of the same x is made once
        if op == int(Op.SRem) && yc && yv >= 3 && (yv & (yv - 1)) != 0 && rep == int(Rp.I64):
            return self.bin(int(Op.Sub), x, self.bin(int(Op.Mul), self.bin(int(Op.SDiv), x, y), y))
        if x == y:
            if op == int(Op.Sub) || op == int(Op.Xor):
                return self.cint(rep, 0)
            if op == int(Op.And) || op == int(Op.Or):
                return x
        return self.share(op, rep, ty, x, y, -1, 0)

    fn neg(self, x0: int) => int:
        let x = self.follow(x0)
        let rep = self.rep[x]
        if self.is_const(x):
            return self.cint(rep, 0 - self.cval(x))
        if self.op[x] == int(Op.Neg):
            return self.follow(self.a[x])
        return self.share(int(Op.Neg), rep, self.ty[x], x, -1, -1, 0)

    /#/ Bitwise not.
    fn bnot(self, x0: int) => int:
        let x = self.follow(x0)
        let rep = self.rep[x]
        if self.is_const(x):
            return self.cint(rep, 0 - self.cval(x) - 1)
        if self.op[x] == int(Op.Not):
            return self.follow(self.a[x])
        return self.share(int(Op.Not), rep, self.ty[x], x, -1, -1, 0)

    fn cmp_fold(self, p: int, rep: int, x: int, y: int) => bool:
        if p == int(Pr.Eq):
            return x == y
        if p == int(Pr.Ne):
            return x != y
        if p == int(Pr.SLt):
            return x < y
        if p == int(Pr.SLe):
            return x <= y
        if p == int(Pr.SGt):
            return x > y
        if p == int(Pr.SGe):
            return x >= y
        let ux = unsigned_of(rep, x)
        let uy = unsigned_of(rep, y)
        let lt = false
        if rp_bits(rep) == 64:
            lt = ult64(ux, uy)
        else:
            lt = ux < uy
        if p == int(Pr.ULt):
            return lt
        if p == int(Pr.UGe):
            return !lt
        if p == int(Pr.UGt):
            return ux != uy && !lt
        return ux == uy || lt

    /#/ An integer comparison; the result is an `i8`.
    fn cmp(self, p: int, x0: int, y0: int) => int:
        let x = self.follow(x0)
        let y = self.follow(y0)
        let rep = self.rep[x]
        let i8 = int(Rp.I8)
        if self.is_const(x) && self.is_const(y):
            if self.cmp_fold(p, rep, self.cval(x), self.cval(y)):
                return self.cint(i8, 1)
            return self.cint(i8, 0)
        if x == y:
            if p == int(Pr.Eq) || p == int(Pr.SLe) || p == int(Pr.SGe) || p == int(Pr.ULe) || p == int(Pr.UGe):
                return self.cint(i8, 1)
            return self.cint(i8, 0)
        if self.is_const(x) && !self.is_const(y):
            let t = x
            x = y
            y = t
            p = mirror_pred(p)
        /#/ `x % 2^k` is zero exactly when the low k bits are (for either sign of x)
        if (p == int(Pr.Eq) || p == int(Pr.Ne)) && self.is_const(y) && self.cval(y) == 0 && (self.op[x] == int(Op.SRem) || self.op[x] == int(Op.URem)):
            let m = self.follow(self.b[x])
            if self.is_const(m) && self.cval(m) > 0 && (self.cval(m) & (self.cval(m) - 1)) == 0:
                let lo = self.bin(int(Op.And), self.a[x], self.cint(rep, self.cval(m) - 1))
                return self.share(int(Op.Cmp), i8, -1, lo, y, -1, p)
        return self.share(int(Op.Cmp), i8, -1, x, y, -1, p)

    /#/ A comparison of floats; never folded.
    fn fcmp(self, p: int, x0: int, y0: int) => int:
        return self.share(int(Op.FCmp), int(Rp.I8), -1, self.follow(x0), self.follow(y0), -1, p)

    /#/ A conversion to representation `to`.
    fn conv(self, op: int, to: int, x0: int) => int:
        let x = self.follow(x0)
        if self.rep[x] == to:
            return x
        if self.is_const(x) && rp_is_int(to):
            if op == int(Op.Trunc) || op == int(Op.SExt):
                return self.cint(to, self.cval(x))
            if op == int(Op.ZExt):
                return self.cint(to, unsigned_of(self.rep[x], self.cval(x)))
        return self.share(op, to, -1, x, -1, -1, 0)

    /#/ Element `idx` of `agg`: the value itself when `agg` was built by `insert`s of it.
    fn extract(self, rep: int, agg: int, idx: int) => int:
        let g = self.follow(agg)
        while self.op[g] == int(Op.Insert):
            if self.aux[g] == idx:
                return self.follow(self.b[g])
            g = self.follow(self.a[g])
        if self.op[g] == int(Op.Undef):
            return self.undef(rep)
        return self.share(int(Op.Extract), rep, -1, self.follow(agg), -1, -1, idx)

    fn insert(self, agg: int, v: int, idx: int) => int:
        let g = self.follow(agg)
        return self.share(int(Op.Insert), self.rep[g], self.ty[g], g, self.follow(v), -1, idx)

    /#/ ---- memory ------------------------------------------------------------

    fn slot(self, ty: int) => int:
        return self.raw(int(Op.Slot), int(Rp.Ptr), ty, -1, -1, -1, 0)

    fn load(self, rep: int, ty: int, p: int) => int:
        return self.raw(int(Op.Load), rep, ty, self.follow(p), -1, -1, 0)

    fn store(self, p: int, v: int) => int:
        return self.raw(int(Op.Store), int(Rp.Void), -1, self.follow(p), self.follow(v), -1, 0)

    /#/ The address of field `idx` (an offset in bytes) of the block `p` points to.
    fn field(self, p: int, off: int) => int:
        return self.share(int(Op.Field), int(Rp.Ptr), -1, self.follow(p), -1, -1, off)

    /#/ The address of element `i` (an i64) of an array of `size`-byte elements at `p`.
    fn index(self, p: int, i: int, size: int) => int:
        return self.share(int(Op.Index), int(Rp.Ptr), -1, self.follow(p), self.follow(i), -1, size)

    /#/ ---- calls and ownership -----------------------------------------------

    /#/ Queues an argument of the next call or edge.
    fn arg(self, v: int) => void:
        if self.pn >= len(self.pend):
            self.pend = buf_resize(self.pend, (self.pn + 1) * 2)
        self.pend[self.pn] = self.follow(v)
        self.pn = self.pn + 1

    fn take_pending(self) => int:
        let start = self.np
        for k in 0..self.pn:
            self.pool_put(self.pend[k])
        return start

    fn call(self, rep: int, ty: int, callee: int) => int:
        let n = self.pn
        let start = self.take_pending()
        self.pn = 0
        return self.raw(int(Op.Call), rep, ty, start, n, -1, callee)

    /#/ A C call; `variadic` is kept for the emitter.
    fn ccall(self, rep: int, ty: int, callee: int, variadic: int) => int:
        let n = self.pn
        let start = self.take_pending()
        self.pn = 0
        return self.raw(int(Op.CCall), rep, ty, start, n, variadic, callee)

    /#/ A vector loop (see `gen_vloop`): the queued arguments, `lane` the element kind, `shape` the counts.
    fn vloop(self, lane: int, shape: int) => int:
        let n = self.pn
        let start = self.take_pending()
        self.pn = 0
        return self.raw(int(Op.VLoop), int(Rp.I64), -1, start, n, lane, shape)

    fn calli(self, rep: int, ty: int, f: int) => int:
        let n = self.pn
        let start = self.take_pending()
        self.pn = 0
        return self.raw(int(Op.CallI), rep, ty, start, n, self.follow(f), 0)

    fn alloc(self, ty: int) => int:
        return self.raw(int(Op.Alloc), int(Rp.Ptr), ty, -1, -1, -1, 0)

    /#/ Releases the block of `p`.
    fn free(self, p: int) => int:
        return self.raw(int(Op.Free), int(Rp.Void), -1, self.follow(p), -1, -1, 0)

    /#/ Releases the block of `p`, which is `n` bytes (the size is what the type says, so a
    /#/ backend with its own allocator need not keep it in a header).
    fn free_n(self, p: int, n: int) => int:
        return self.raw(int(Op.Free), int(Rp.Void), -1, self.follow(p), -1, -1, n + 1)

    /#/ Drops the owner `v`; `glue` is the number of the function that does it.
    fn drop_of(self, v: int, glue: int) => int:
        return self.raw(int(Op.Drop), int(Rp.Void), -1, self.follow(v), -1, -1, glue)

    /#/ A deep copy of `v`, made by the function number `glue`.
    fn clone_of(self, v: int, glue: int) => int:
        let x = self.follow(v)
        return self.raw(int(Op.Clone), self.rep[x], -1, x, -1, -1, glue)

    /#/ ---- edges and terminators ---------------------------------------------

    /#/ An edge to `target` passing the queued arguments.
    fn mk_edge(self, target: int) => int:
        if self.ne >= len(self.eto):
            let cap = (self.ne + 1) * 2
            self.efrom = buf_resize(self.efrom, cap)
            self.eto = buf_resize(self.eto, cap)
            self.eargs = buf_resize(self.eargs, cap)
            self.eargn = buf_resize(self.eargn, cap)
        let e = self.ne
        self.efrom[e] = self.cur
        self.eto[e] = target
        self.eargn[e] = self.pn
        self.eargs[e] = self.take_pending()
        for k in 0..self.pn:
            let v = self.pool[self.eargs[e] + k]
            self.uses[v] = self.uses[v] + 1
        self.pn = 0
        self.ne = e + 1
        return e

    fn kill_edge(self, e: int) => void:
        for k in 0..self.eargn[e]:
            let v = self.pool[self.eargs[e] + k]
            self.uses[v] = self.uses[v] - 1
        self.eargn[e] = 0
        self.eto[e] = -1

    fn br(self, target: int) => int:
        let e = self.mk_edge(target)
        return self.raw(int(Op.Br), int(Rp.Void), -1, -1, -1, -1, e)

    /#/ A branch on `cond`; a constant condition is a plain jump.
    fn condbr(self, cond: int, e1: int, e2: int) => int:
        let c = self.follow(cond)
        if self.is_const(c):
            if self.cval(c) != 0:
                self.kill_edge(e2)
                return self.raw(int(Op.Br), int(Rp.Void), -1, -1, -1, -1, e1)
            self.kill_edge(e1)
            return self.raw(int(Op.Br), int(Rp.Void), -1, -1, -1, -1, e2)
        return self.raw(int(Op.CondBr), int(Rp.Void), -1, c, e1, e2, 0)

    fn sw_case(self, v: int, e: int) => void:
        if self.cn >= len(self.cv):
            self.cv = buf_resize(self.cv, (self.cn + 1) * 2)
            self.ce = buf_resize(self.ce, (self.cn + 1) * 2)
        self.cv[self.cn] = v
        self.ce[self.cn] = e
        self.cn = self.cn + 1

    fn switch(self, v: int, default_edge: int) => int:
        let n = self.cn
        let start = self.np
        for k in 0..n:
            self.pool_put(self.cv[k])
            self.pool_put(self.ce[k])
        self.cn = 0
        return self.raw(int(Op.Switch), int(Rp.Void), -1, self.follow(v), n, default_edge, start)

    fn ret_v(self, v: int) => int:
        return self.raw(int(Op.Ret), int(Rp.Void), -1, self.follow(v), -1, -1, 0)

    fn ret_void(self) => int:
        return self.raw(int(Op.Ret), int(Rp.Void), -1, -1, -1, -1, 0)

    fn unreachable(self) => int:
        return self.raw(int(Op.Unreachable), int(Rp.Void), -1, -1, -1, -1, 0)

    /#/ The edges that leave block `b`, in order; `k` counts from 0.
    fn nsucc(self, b: int) => int:
        let t = self.blast[b]
        if t < 0:
            return 0
        let o = self.op[t]
        if o == int(Op.Br):
            return 1
        if o == int(Op.CondBr):
            return 2
        if o == int(Op.Switch):
            return self.b[t] + 1
        return 0

    fn succ_edge(self, b: int, k: int) => int:
        let t = self.blast[b]
        let o = self.op[t]
        if o == int(Op.Br):
            return self.aux[t]
        if o == int(Op.CondBr):
            if k == 0:
                return self.b[t]
            return self.c[t]
        if k == 0:
            return self.c[t]
        return self.pool[self.aux[t] + (k - 1) * 2 + 1]

/#/ A function with the result representation `ret` (`Rp.Void` for none).
fn new_fun(name: &str, ret: int) => Fun:
    let nm: buf<int> = new_buf(int, len(name))
    for k in 0..len(name):
        nm[k] = ch(name, k)
    let vn: buf<int> = new_buf(int, 64)
    for k in 0..64:
        vn[k] = -1
    return Fun { nm: nm, ret: ret, tab: new_optab(), op: new_buf(int, 32), rep: new_buf(int, 32), ty: new_buf(int, 32), a: new_buf(int, 32), b: new_buf(int, 32), c: new_buf(int, 32), aux: new_buf(int, 32), nx: new_buf(int, 32), pv: new_buf(int, 32), uses: new_buf(int, 32), ln: new_buf(int, 32), line: 0, fwd: new_buf(int, 32), blk: new_buf(int, 32), ni: 0, bfirst: new_buf(int, 8), blast: new_buf(int, 8), pfirst: new_buf(int, 8), plast: new_buf(int, 8), npar: new_buf(int, 8), nb: 0, efrom: new_buf(int, 8), eto: new_buf(int, 8), eargs: new_buf(int, 8), eargn: new_buf(int, 8), ne: 0, pool: new_buf(int, 32), np: 0, pend: new_buf(int, 8), pn: 0, cv: new_buf(int, 8), ce: new_buf(int, 8), cn: 0, cur: -1, vn: vn, vn_n: 0, attrs: 0 }


fn put_pred(o: &Txt, p: int) => void:
    if p == int(Pr.Eq):
        o.put("eq")
        return
    if p == int(Pr.Ne):
        o.put("ne")
        return
    if p == int(Pr.SLt):
        o.put("slt")
        return
    if p == int(Pr.SLe):
        o.put("sle")
        return
    if p == int(Pr.SGt):
        o.put("sgt")
        return
    if p == int(Pr.SGe):
        o.put("sge")
        return
    if p == int(Pr.ULt):
        o.put("ult")
        return
    if p == int(Pr.ULe):
        o.put("ule")
        return
    if p == int(Pr.UGt):
        o.put("ugt")
        return
    if p == int(Pr.UGe):
        o.put("uge")
        return
    if p == int(Pr.OEq):
        o.put("oeq")
        return
    if p == int(Pr.ONe):
        o.put("one")
        return
    if p == int(Pr.OLt):
        o.put("olt")
        return
    if p == int(Pr.OLe):
        o.put("ole")
        return
    if p == int(Pr.OGt):
        o.put("ogt")
        return
    o.put("oge")

fn put_rep(o: &Txt, rs: &Reps, r: int) => void:
    if r == int(Rp.Void):
        o.put("void")
    elif r == int(Rp.I8):
        o.put("i8")
    elif r == int(Rp.I16):
        o.put("i16")
    elif r == int(Rp.I32):
        o.put("i32")
    elif r == int(Rp.I64):
        o.put("i64")
    elif r == int(Rp.F32):
        o.put("f32")
    elif r == int(Rp.F64):
        o.put("f64")
    elif r == int(Rp.Ptr):
        o.put("ptr")
    elif r >= rp_first_agg():
        o.put("{")
        for i in 0..rs.elems(r):
            if i > 0:
                o.put(", ")
            put_rep(o, rs, rs.elem(r, i))
        o.put("}")
    else:
        o.put("?")

fn put_val(o: &Txt, f: &Fun, v: int) => void:
    o.put("%")
    o.put_int(f.follow(v))

fn put_edge(o: &Txt, f: &Fun, e: int) => void:
    o.put("bb")
    o.put_int(f.eto[e])
    o.put("(")
    for k in 0..f.eargn[e]:
        if k > 0:
            o.put(", ")
        put_val(o, f, f.pool[f.eargs[e] + k])
    o.put(")")

fn put_args(o: &Txt, f: &Fun, start: int, n: int) => void:
    o.put("(")
    for k in 0..n:
        if k > 0:
            o.put(", ")
        put_val(o, f, f.pool[start + k])
    o.put(")")

fn put_inst(o: &Txt, f: &Fun, rs: &Reps, i: int) => void:
    let op = f.op[i]
    o.put("  ")
    if f.rep[i] != int(Rp.Void):
        put_val(o, f, i)
        o.put(" = ")
    for k in 0..f.tab.size[op]:
        o.put_byte(f.tab.pool[f.tab.off[op] + k])
    if op == int(Op.Cmp) || op == int(Op.FCmp):
        o.put(".")
        put_pred(o, f.aux[i])
    if f.rep[i] != int(Rp.Void):
        o.put(" ")
        put_rep(o, rs, f.rep[i])
    if op == int(Op.Const):
        o.put(" ")
        o.put_int(f.aux[i])
    elif op == int(Op.FnAddr):
        o.put(" @")
        o.put_int(f.aux[i])
    elif op == int(Op.StrLit):
        o.put(" #")
        o.put_int(f.aux[i])
    elif op == int(Op.Call) || op == int(Op.CCall):
        o.put(" @")
        o.put_int(f.aux[i])
        put_args(o, f, f.a[i], f.b[i])
        if op == int(Op.CCall) && f.c[i] != 0:
            o.put(" variadic")
    elif op == int(Op.VLoop):
        o.put(" lane ")
        o.put_int(f.c[i])
        put_args(o, f, f.a[i], f.b[i])
    elif op == int(Op.CallI):
        o.put(" ")
        put_val(o, f, f.c[i])
        put_args(o, f, f.a[i], f.b[i])
    elif op == int(Op.Br):
        o.put(" ")
        put_edge(o, f, f.aux[i])
    elif op == int(Op.CondBr):
        o.put(" ")
        put_val(o, f, f.a[i])
        o.put(", ")
        put_edge(o, f, f.b[i])
        o.put(", ")
        put_edge(o, f, f.c[i])
    elif op == int(Op.Switch):
        o.put(" ")
        put_val(o, f, f.a[i])
        o.put(", default ")
        put_edge(o, f, f.c[i])
        for k in 0..f.b[i]:
            o.put(", ")
            o.put_int(f.pool[f.aux[i] + k * 2])
            o.put(": ")
            put_edge(o, f, f.pool[f.aux[i] + k * 2 + 1])
    elif op == int(Op.Ret):
        if f.a[i] >= 0:
            o.put(" ")
            put_val(o, f, f.a[i])
    else:
        let n = f.nval(i)
        for k in 0..n:
            if k > 0:
                o.put(",")
            o.put(" ")
            put_val(o, f, f.val_at(i, k))
        if op == int(Op.Extract) || op == int(Op.Insert):
            o.put(", ")
            o.put_int(f.aux[i])
        elif op == int(Op.Field):
            o.put(", +")
            o.put_int(f.aux[i])
    o.put("\n")

fn put_fun(o: &Txt, f: &Fun, rs: &Reps) => void:
    o.put("fn ")
    for k in 0..len(f.nm):
        o.put_byte(f.nm[k])
    o.put("(")
    if f.nb > 0:
        let p = f.pfirst[0]
        while p >= 0:
            if p != f.pfirst[0]:
                o.put(", ")
            put_val(o, f, p)
            o.put(": ")
            put_rep(o, rs, f.rep[p])
            p = f.nx[p]
    o.put(") -> ")
    put_rep(o, rs, f.ret)
    o.put(":\n")
    let any = false
    for i in 0..f.ni:
        if f.blk[i] < 0 && f.fwd[i] < 0 && f.uses[i] > 0:
            if !any:
                o.put("consts:\n")
                any = true
            put_inst(o, f, rs, i)
    for b in 0..f.nb:
        o.put("bb")
        o.put_int(b)
        if b > 0 && f.npar[b] > 0:
            o.put("(")
            let p = f.pfirst[b]
            while p >= 0:
                if p != f.pfirst[b]:
                    o.put(", ")
                put_val(o, f, p)
                o.put(": ")
                put_rep(o, rs, f.rep[p])
                p = f.nx[p]
            o.put(")")
        o.put(":\n")
        let i = f.bfirst[b]
        while i >= 0:
            put_inst(o, f, rs, i)
            i = f.nx[i]

/#/ The text of function `f`.
fn ir_text(f: &Fun, rs: &Reps) => Txt:
    let o = new_txt()
    put_fun(&o, f, rs)
    return o


enum Ve:
    NoTerminator
    MidTerminator
    EdgeTarget
    EdgeArity
    EdgeType
    OpType
    NotDominated
    RetType

class VDiags:
    code: buf<int>
    inst: buf<int>
    blk: buf<int>
    n: int

    fn add(self, code: int, inst: int, blk: int) => void:
        if self.n >= len(self.code):
            let cap = (self.n + 1) * 2
            self.code = buf_resize(self.code, cap)
            self.inst = buf_resize(self.inst, cap)
            self.blk = buf_resize(self.blk, cap)
        self.code[self.n] = code
        self.inst[self.n] = inst
        self.blk[self.n] = blk
        self.n = self.n + 1

    fn count(self, code: int) => int:
        let c = 0
        for i in 0..self.n:
            if self.code[i] == code:
                c = c + 1
        return c

fn new_vdiags() => VDiags:
    return VDiags { code: new_buf(int, 8), inst: new_buf(int, 8), blk: new_buf(int, 8), n: 0 }

/#/ Are the operand and result representations what operation `i` needs?
fn types_ok(f: &Fun, i: int) => bool:
    let o = f.op[i]
    let r = f.rep[i]
    if o == int(Op.Add) || o == int(Op.Sub) || o == int(Op.Mul) || o == int(Op.SDiv) || o == int(Op.UDiv) || o == int(Op.SRem) || o == int(Op.URem) || o == int(Op.And) || o == int(Op.Or) || o == int(Op.Xor) || o == int(Op.Shl) || o == int(Op.AShr) || o == int(Op.LShr) || o == int(Op.SMulHi):
        return rp_is_int(r) && f.rep[f.follow(f.a[i])] == r && f.rep[f.follow(f.b[i])] == r
    if o == int(Op.Neg) || o == int(Op.Not):
        return rp_is_int(r) && f.rep[f.follow(f.a[i])] == r
    if o == int(Op.FAdd) || o == int(Op.FSub) || o == int(Op.FMul) || o == int(Op.FDiv) || o == int(Op.FRem):
        return rp_is_float(r) && f.rep[f.follow(f.a[i])] == r && f.rep[f.follow(f.b[i])] == r
    if o == int(Op.FNeg):
        return rp_is_float(r) && f.rep[f.follow(f.a[i])] == r
    if o == int(Op.Cmp):
        let x = f.rep[f.follow(f.a[i])]
        return r == int(Rp.I8) && x == f.rep[f.follow(f.b[i])] && (rp_is_int(x) || x == int(Rp.Ptr))
    if o == int(Op.FCmp):
        let x = f.rep[f.follow(f.a[i])]
        return r == int(Rp.I8) && rp_is_float(x) && x == f.rep[f.follow(f.b[i])]
    if o == int(Op.Trunc):
        let x = f.rep[f.follow(f.a[i])]
        return rp_is_int(x) && rp_is_int(r) && rp_bits(x) > rp_bits(r)
    if o == int(Op.SExt) || o == int(Op.ZExt):
        let x = f.rep[f.follow(f.a[i])]
        return rp_is_int(x) && rp_is_int(r) && rp_bits(x) < rp_bits(r)
    /#/ an address is a pointer, or the integer of `peek8` and `poke64` (the memory of the runtime)
    if o == int(Op.Load):
        let ar = f.rep[f.follow(f.a[i])]
        return (ar == int(Rp.Ptr) || ar == int(Rp.I64)) && r != int(Rp.Void)
    if o == int(Op.Store):
        let ar = f.rep[f.follow(f.a[i])]
        return (ar == int(Rp.Ptr) || ar == int(Rp.I64)) && f.rep[f.follow(f.b[i])] != int(Rp.Void)
    if o == int(Op.Field):
        return f.rep[f.follow(f.a[i])] == int(Rp.Ptr) && r == int(Rp.Ptr)
    if o == int(Op.Index):
        return f.rep[f.follow(f.a[i])] == int(Rp.Ptr) && rp_is_int(f.rep[f.follow(f.b[i])]) && r == int(Rp.Ptr)
    if o == int(Op.CondBr):
        return f.rep[f.follow(f.a[i])] == int(Rp.I8)
    if o == int(Op.Switch):
        return rp_is_int(f.rep[f.follow(f.a[i])])
    if o == int(Op.Extract) || o == int(Op.Insert):
        return f.rep[f.follow(f.a[i])] >= rp_first_agg()
    return true

fn dominates(idom: &buf<int>, a: int, b: int) => bool:
    let x = b
    while x >= 0:
        if x == a:
            return true
        if idom[x] == x:
            return false
        x = idom[x]
    return false

/#/ Checks function `f`; the findings are in the result.
fn verify(f: &Fun) => VDiags:
    let d = new_vdiags()
    let nb = f.nb
    /#/ position of each instruction in its block (parameters come before everything)
    let pos: buf<int> = new_buf(int, f.ni + 1)
    for b in 0..nb:
        let k = 0
        let i = f.bfirst[b]
        while i >= 0:
            pos[i] = k
            k = k + 1
            if f.tab.has(f.op[i], f_term()) && f.nx[i] >= 0:
                d.add(int(Ve.MidTerminator), i, b)
            if !types_ok(f, i):
                d.add(int(Ve.OpType), i, b)
            i = f.nx[i]
        if !f.terminated(b):
            d.add(int(Ve.NoTerminator), -1, b)
        else:
            let t = f.blast[b]
            if f.op[t] == int(Op.Ret):
                if f.ret == int(Rp.Void):
                    if f.a[t] >= 0:
                        d.add(int(Ve.RetType), t, b)
                elif f.a[t] < 0 || f.rep[f.follow(f.a[t])] != f.ret:
                    d.add(int(Ve.RetType), t, b)
            for s in 0..f.nsucc(b):
                let e = f.succ_edge(b, s)
                let to = f.eto[e]
                if to < 0 || to >= nb:
                    d.add(int(Ve.EdgeTarget), t, b)
                elif f.eargn[e] != f.npar[to]:
                    d.add(int(Ve.EdgeArity), t, b)
                else:
                    for ea in 0..f.eargn[e]:
                        if f.rep[f.follow(f.pool[f.eargs[e] + ea])] != f.rep[f.param_at(to, ea)]:
                            d.add(int(Ve.EdgeType), t, b)
    if nb == 0:
        return d
    /#/ blocks reachable from the entry, in reverse post-order
    let visited: buf<int> = new_buf(int, nb)
    let ci: buf<int> = new_buf(int, nb)
    let stack: buf<int> = new_buf(int, nb)
    let post: buf<int> = new_buf(int, nb)
    let sp = 1
    let np = 0
    stack[0] = 0
    visited[0] = 1
    while sp > 0:
        let b = stack[sp - 1]
        if f.terminated(b) && ci[b] < f.nsucc(b):
            let t = f.eto[f.succ_edge(b, ci[b])]
            ci[b] = ci[b] + 1
            if t >= 0 && t < nb && visited[t] == 0:
                visited[t] = 1
                stack[sp] = t
                sp = sp + 1
        else:
            post[np] = b
            np = np + 1
            sp = sp - 1
    let rpo: buf<int> = new_buf(int, nb)
    let num: buf<int> = new_buf(int, nb)
    for k in 0..np:
        rpo[k] = post[np - 1 - k]
        num[rpo[k]] = k
    /#/ the predecessors of each block among the reachable ones, in reverse post-order
    let pstart: buf<int> = new_buf(int, nb + 1)
    for k in 0..np:
        let pb = rpo[k]
        if f.terminated(pb):
            for s in 0..f.nsucc(pb):
                let t = f.eto[f.succ_edge(pb, s)]
                if t >= 0 && t < nb:
                    pstart[t + 1] = pstart[t + 1] + 1
    for b in 0..nb:
        pstart[b + 1] = pstart[b + 1] + pstart[b]
    let plist: buf<int> = new_buf(int, pstart[nb] + 1)
    let pfill: buf<int> = new_buf(int, nb + 1)
    for k in 0..np:
        let pb = rpo[k]
        if f.terminated(pb):
            for s in 0..f.nsucc(pb):
                let t = f.eto[f.succ_edge(pb, s)]
                if t >= 0 && t < nb:
                    plist[pstart[t] + pfill[t]] = pb
                    pfill[t] = pfill[t] + 1
    /#/ immediate dominators (Cooper, Harvey, Kennedy)
    let idom: buf<int> = new_buf(int, nb)
    for b in 0..nb:
        idom[b] = -1
    idom[0] = 0
    let changed = true
    while changed:
        changed = false
        for k in 1..np:
            let b = rpo[k]
            let nd = -1
            for pi in pstart[b]..pstart[b + 1]:
                let pb = plist[pi]
                if idom[pb] >= 0:
                    if nd < 0:
                        nd = pb
                    else:
                        let x = pb
                        let y = nd
                        while x != y:
                            while num[x] > num[y]:
                                x = idom[x]
                            while num[y] > num[x]:
                                y = idom[y]
                        nd = x
            if nd != idom[b]:
                idom[b] = nd
                changed = true
    /#/ every use must be dominated by its definition
    for k in 0..np:
        let b = rpo[k]
        let i = f.bfirst[b]
        while i >= 0:
            let nu = f.nval(i)
            for u in 0..nu:
                check_use(f, &d, &idom, &pos, f.val_at(i, u), i, b)
            if i == f.blast[b]:
                for s in 0..f.nsucc(b):
                    let e = f.succ_edge(b, s)
                    for a in 0..f.eargn[e]:
                        check_use(f, &d, &idom, &pos, f.pool[f.eargs[e] + a], i, b)
            i = f.nx[i]
    return d

fn check_use(f: &Fun, d: &VDiags, idom: &buf<int>, pos: &buf<int>, v: int, user: int, ub: int) => void:
    if v < 0:
        return
    let def = f.follow(v)
    let db = f.blk[def]
    if db < 0:
        return
    if db == ub:
        if f.op[def] == int(Op.Param):
            return
        if pos[def] >= pos[user]:
            d.add(int(Ve.NotDominated), user, ub)
        return
    if !dominates(idom, db, ub):
        d.add(int(Ve.NotDominated), user, ub)


/#/ Names of functions, by number.
class Names:
    b: buf<int>
    n: int
    off: buf<int>
    cnt: int
    /#/ chains of names by the hash of their text: heads (name + 1), next, hash of each
    nh: buf<int>
    nn: buf<int>
    hs: buf<int>

    fn add(self, name: &str) => int:
        if self.cnt + 1 >= len(self.off):
            self.off = buf_resize(self.off, (self.cnt + 2) * 2)
        self.off[self.cnt] = self.n
        for i in 0..len(name):
            if self.n >= len(self.b):
                self.b = buf_resize(self.b, (self.n + 1) * 2)
            self.b[self.n] = ch(name, i)
            self.n = self.n + 1
        self.off[self.cnt + 1] = self.n
        self.cnt = self.cnt + 1
        self.reg()
        return self.cnt - 1

    /#/ Enters the name just added (the last one) in the chains.
    fn reg(self) => void:
        let id = self.cnt - 1
        if id >= len(self.nn):
            self.nn = buf_resize(self.nn, (id + 1) * 2)
            self.hs = buf_resize(self.hs, (id + 1) * 2)
        let h = 1469598103934665603
        for k in self.off[id]..self.off[id + 1]:
            h = (h ^ self.b[k]) * 1099511628211
        h = h & 4611686018427387903
        self.hs[id] = h
        if self.cnt * 2 > len(self.nh):
            let cap = len(self.nh) * 2
            self.nh = new_buf(int, cap)
            for j in 0..id:
                self.nn[j] = self.nh[self.hs[j] % cap]
                self.nh[self.hs[j] % cap] = j + 1
        self.nn[id] = self.nh[h % len(self.nh)]
        self.nh[h % len(self.nh)] = id + 1

    fn put(self, o: &Txt, id: int) => void:
        for k in self.off[id]..self.off[id + 1]:
            o.put_byte(self.b[k])

    /#/ Adds the name spelled by `w` without looking for it first.
    fn add_bytes(self, w: &Txt) => int:
        if self.cnt + 1 >= len(self.off):
            self.off = buf_resize(self.off, (self.cnt + 2) * 2)
        self.off[self.cnt] = self.n
        for k in 0..w.n:
            if self.n >= len(self.b):
                self.b = buf_resize(self.b, (self.n + 1) * 2)
            self.b[self.n] = w.b[k]
            self.n = self.n + 1
        self.off[self.cnt + 1] = self.n
        self.cnt = self.cnt + 1
        self.reg()
        return self.cnt - 1

    /#/ The number of the name spelled by `w`; -1 when there is none.
    fn find(self, w: &Txt) => int:
        let h = 1469598103934665603
        for k in 0..w.n:
            h = (h ^ w.b[k]) * 1099511628211
        h = h & 4611686018427387903
        let id = self.nh[h % len(self.nh)] - 1
        while id >= 0:
            if self.hs[id] == h && self.off[id + 1] - self.off[id] == w.n:
                let same = true
                for k in 0..w.n:
                    if self.b[self.off[id] + k] != w.b[k]:
                        same = false
                        break
                if same:
                    return id
            id = self.nn[id] - 1
        return -1

    /#/ The number of the name spelled by `w`; added when new.
    fn intern(self, w: &Txt) => int:
        let found = self.find(w)
        if found >= 0:
            return found
        if self.cnt + 1 >= len(self.off):
            self.off = buf_resize(self.off, (self.cnt + 2) * 2)
        self.off[self.cnt] = self.n
        for k in 0..w.n:
            if self.n >= len(self.b):
                self.b = buf_resize(self.b, (self.n + 1) * 2)
            self.b[self.n] = w.b[k]
            self.n = self.n + 1
        self.off[self.cnt + 1] = self.n
        self.cnt = self.cnt + 1
        self.reg()
        return self.cnt - 1

fn new_names() => Names:
    return Names { b: new_buf(int, 64), n: 0, off: new_buf(int, 16), cnt: 0, nh: new_buf(int, 64), nn: new_buf(int, 16), hs: new_buf(int, 16) }


/#/ Appends `v` to the arguments edge `e` passes. The arguments move to the end of the pool.
fn edge_push(f: &Fun, e: int, v0: int) => void:
    let v = f.follow(v0)
    let n = f.eargn[e]
    let old = f.eargs[e]
    let start = f.np
    for k in 0..n:
        f.pool_put(f.pool[old + k])
    f.pool_put(v)
    f.eargs[e] = start
    f.eargn[e] = n + 1
    f.uses[v] = f.uses[v] + 1

/#/ Gives the parameter `p` (the `k`-th of block `b`) the value it always has, if there is
/#/ one: every edge into `b` passes the same value, or `p` itself around a loop.
fn trivial_param(f: &Fun, inf: &buf<int>, inl: &buf<int>, b: int, p: int, k: int) => bool:
    let same = -1
    for q in inf[b]..inf[b + 1]:
        let e = inl[q]
        if k < f.eargn[e]:
            let x = f.follow(f.pool[f.eargs[e] + k])
            if x != p:
                if same >= 0 && same != x:
                    return false
                same = x
    if same < 0:
        return false
    f.fwd[p] = same
    f.uses[same] = f.uses[same] + f.uses[p]
    return true

/#/ Removes every parameter that is one value, and the arguments passed to it.
fn simplify_params(f: &Fun) => void:
    /#/ the edges into each block: `inl[inf[b] .. inf[b + 1]]`
    let inf: buf<int> = new_buf(int, f.nb + 2)
    for e in 0..f.ne:
        if f.eto[e] >= 0:
            inf[f.eto[e] + 1] = inf[f.eto[e] + 1] + 1
    for b in 0..f.nb + 1:
        inf[b + 1] = inf[b + 1] + inf[b]
    let fill: buf<int> = new_buf(int, f.nb + 1)
    let inl: buf<int> = new_buf(int, f.ne + 1)
    for e in 0..f.ne:
        let t = f.eto[e]
        if t >= 0:
            inl[inf[t] + fill[t]] = e
            fill[t] = fill[t] + 1
    let changed = true
    while changed:
        changed = false
        for b in 1..f.nb:
            let p = f.pfirst[b]
            let k = 0
            while p >= 0:
                if f.fwd[p] < 0 && trivial_param(f, &inf, &inl, b, p, k):
                    changed = true
                p = f.nx[p]
                k = k + 1
    for b in 1..f.nb:
        let dead = 0
        let p = f.pfirst[b]
        while p >= 0:
            if f.fwd[p] >= 0:
                dead = dead + 1
            p = f.nx[p]
        if dead > 0:
            drop_params(f, b)

/#/ Takes the forwarded parameters out of block `b` and their arguments off its edges.
fn drop_params(f: &Fun, b: int) => void:
    let n = f.npar[b]
    let keep: buf<int> = new_buf(int, n + 1)
    let p = f.pfirst[b]
    let k = 0
    while p >= 0:
        keep[k] = 0
        if f.fwd[p] < 0:
            keep[k] = 1
        p = f.nx[p]
        k = k + 1
    for e in 0..f.ne:
        if f.eto[e] == b:
            let m = f.eargn[e]
            let start = f.np
            let out = 0
            for j in 0..m:
                if j < n && keep[j] == 0:
                    let x = f.pool[f.eargs[e] + j]
                    f.uses[x] = f.uses[x] - 1
                else:
                    f.pool_put(f.pool[f.eargs[e] + j])
                    out = out + 1
            f.eargs[e] = start
            f.eargn[e] = out
    let first = -1
    let last = -1
    let q = f.pfirst[b]
    let cnt = 0
    while q >= 0:
        let nxt = f.nx[q]
        if f.fwd[q] < 0:
            f.pv[q] = last
            f.nx[q] = -1
            if last >= 0:
                f.nx[last] = q
            else:
                first = q
            last = q
            f.aux[q] = cnt
            cnt = cnt + 1
        q = nxt
    f.pfirst[b] = first
    f.plast[b] = last
    f.npar[b] = cnt


/#/ Takes `i` out of its block's list (a parameter is not in that list).
fn unlink(f: &Fun, i: int) => void:
    let b = f.blk[i]
    let p = f.pv[i]
    let n = f.nx[i]
    if p >= 0:
        f.nx[p] = n
    else:
        f.bfirst[b] = n
    if n >= 0:
        f.pv[n] = p
    else:
        f.blast[b] = p
    f.pv[i] = -1
    f.nx[i] = -1

/#/ One use fewer for every operand of `i`.
fn unuse(f: &Fun, i: int) => void:
    for k in 0..f.nval(i):
        let v = f.val_at(i, k)
        if v >= 0:
            let x = f.follow(v)
            f.uses[x] = f.uses[x] - 1

/#/ An edge that goes nowhere any more: its arguments are not used.
fn cut_edge(f: &Fun, e: int) => void:
    if f.eto[e] < 0:
        return
    for k in 0..f.eargn[e]:
        let x = f.follow(f.pool[f.eargs[e] + k])
        f.uses[x] = f.uses[x] - 1
    f.eargn[e] = 0
    f.eto[e] = -1

/#/ Deletes instruction `i`: out of its list, its operands unused, its edges cut.
fn delete_inst(f: &Fun, i: int) => void:
    unuse(f, i)
    let o = f.op[i]
    if o == int(Op.Br) || o == int(Op.CondBr) || o == int(Op.Switch):
        for q in 0..f.nsucc(f.blk[i]):
            cut_edge(f, f.succ_edge(f.blk[i], q))
    unlink(f, i)

/#/ ---- constant branches ---------------------------------------------------

/#/ `condbr` on a constant is a `br` to the edge taken; the other edge is cut.
fn fold_branches(f: &Fun) => bool:
    let changed = false
    for b in 0..f.nb:
        let t = f.blast[b]
        if t >= 0 && f.op[t] == int(Op.CondBr):
            let c = f.follow(f.a[t])
            if f.is_const(c):
                let keep = f.b[t]
                let gone = f.c[t]
                if f.cval(c) == 0:
                    keep = f.c[t]
                    gone = f.b[t]
                cut_edge(f, gone)
                f.uses[c] = f.uses[c] - 1
                f.op[t] = int(Op.Br)
                f.aux[t] = keep
                f.a[t] = -1
                f.b[t] = -1
                f.c[t] = -1
                changed = true
    return changed

/#/ ---- jumps to jumps ----------------------------------------------------

/#/ An edge into a block that only jumps on goes to where that block goes, with what that jump passes.
/#/ The forwarding block loses its predecessors and is dropped as unreachable.
fn thread_jumps(f: &Fun) => bool:
    let changed = false
    for e in 0..f.ne:
        let guard = 0
        while f.eto[e] > 0 && f.eargn[e] == 0 && guard < 8:
            guard = guard + 1
            let b = f.eto[e]
            let t = f.blast[b]
            if f.npar[b] != 0 || t < 0 || f.bfirst[b] != t || f.op[t] != int(Op.Br):
                break
            let e2 = f.aux[t]
            let to = f.eto[e2]
            if to < 0 || to == b || e2 == e:
                break
            let at = f.np
            for k in 0..f.eargn[e2]:
                let v = f.pool[f.eargs[e2] + k]
                f.pool_put(v)
                f.uses[f.follow(v)] = f.uses[f.follow(v)] + 1
            f.eargs[e] = at
            f.eargn[e] = f.eargn[e2]
            f.eto[e] = to
            changed = true
    return changed

/#/ ---- unreachable blocks --------------------------------------------------

/#/ Removes the blocks no path from the entry reaches, and renumbers the rest.
fn drop_unreachable(f: &Fun) => bool:
    let seen: buf<int> = new_buf(int, f.nb + 1)
    let stack: buf<int> = new_buf(int, f.nb + 1)
    let sp = 0
    seen[0] = 1
    stack[0] = 0
    sp = 1
    while sp > 0:
        sp = sp - 1
        let b = stack[sp]
        for q in 0..f.nsucc(b):
            let e = f.succ_edge(b, q)
            let to = f.eto[e]
            if to >= 0 && seen[to] == 0:
                seen[to] = 1
                stack[sp] = to
                sp = sp + 1
    let dead = 0
    for b in 0..f.nb:
        if seen[b] == 0:
            dead = dead + 1
    if dead == 0:
        return false
    for b in 0..f.nb:
        if seen[b] == 0:
            let i = f.blast[b]
            while i >= 0:
                let p = f.pv[i]
                delete_inst(f, i)
                i = p
            f.bfirst[b] = -1
            f.blast[b] = -1
    /#/ renumber
    let map: buf<int> = new_buf(int, f.nb + 1)
    let n = 0
    for b in 0..f.nb:
        map[b] = -1
        if seen[b] == 1:
            map[b] = n
            n = n + 1
    for b in 0..f.nb:
        if seen[b] == 1:
            let nb = map[b]
            f.bfirst[nb] = f.bfirst[b]
            f.blast[nb] = f.blast[b]
            f.pfirst[nb] = f.pfirst[b]
            f.plast[nb] = f.plast[b]
            f.npar[nb] = f.npar[b]
            let i = f.bfirst[nb]
            while i >= 0:
                f.blk[i] = nb
                i = f.nx[i]
            let p = f.pfirst[nb]
            while p >= 0:
                f.blk[p] = nb
                p = f.nx[p]
    f.set_blocks(n)
    for e in 0..f.ne:
        if f.eto[e] >= 0:
            f.eto[e] = map[f.eto[e]]
        if f.efrom[e] >= 0:
            f.efrom[e] = map[f.efrom[e]]
    return true

/#/ ---- merging blocks ------------------------------------------------------

/#/ How many live edges enter block `b`.
fn pred_count(f: &Fun, b: int) => int:
    let n = 0
    for e in 0..f.ne:
        if f.eto[e] == b:
            n = n + 1
    return n

/#/ The first live edge that enters block `b`.
fn pred_first(f: &Fun, b: int) => int:
    for e in 0..f.ne:
        if f.eto[e] == b:
            return e
    return -1

/#/ A block that only one block enters, by a plain jump, joins that block.
fn merge_blocks(f: &Fun) => bool:
    let changed = false
    /#/ how many edges enter each block, and the first: joining blocks changes neither for the others
    let pcn: buf<int> = new_buf(int, f.nb + 1)
    let pfe: buf<int> = new_buf(int, f.nb + 1)
    for e in 0..f.ne:
        let t = f.eto[e]
        if t >= 0:
            if pcn[t] == 0:
                pfe[t] = e
            pcn[t] = pcn[t] + 1
    /#/ the block a joined block went into; the edges that leave it are renamed at the end
    let into: buf<int> = new_buf(int, f.nb + 1)
    for b in 0..f.nb:
        into[b] = b
    for b in 1..f.nb:
        if f.bfirst[b] >= 0 && pcn[b] == 1:
            let e = pfe[b]
            let a = f.efrom[e]
            while a >= 0 && into[a] != a:
                a = into[a]
            let t = -1
            if a >= 0:
                t = f.blast[a]
            if a != b && a >= 0 && t >= 0 && f.op[t] == int(Op.Br) && f.aux[t] == e:
                /#/ the parameters are what the edge passes
                let p = f.pfirst[b]
                let k = 0
                while p >= 0:
                    let x = f.follow(f.pool[f.eargs[e] + k])
                    f.fwd[p] = x
                    f.uses[x] = f.uses[x] + f.uses[p] - 1
                    p = f.nx[p]
                    k = k + 1
                f.pfirst[b] = -1
                f.plast[b] = -1
                f.npar[b] = 0
                /#/ the jump goes, the block's instructions follow the rest of `a`
                f.eargn[e] = 0
                f.eto[e] = -1
                unlink(f, t)
                let i = f.bfirst[b]
                while i >= 0:
                    f.blk[i] = a
                    i = f.nx[i]
                if f.bfirst[b] >= 0:
                    let l = f.blast[a]
                    if l >= 0:
                        f.nx[l] = f.bfirst[b]
                    else:
                        f.bfirst[a] = f.bfirst[b]
                    f.pv[f.bfirst[b]] = l
                    f.blast[a] = f.blast[b]
                f.bfirst[b] = -1
                f.blast[b] = -1
                into[b] = a
                changed = true
    if changed:
        for q in 0..f.ne:
            let x = f.efrom[q]
            while x >= 0 && into[x] != x:
                x = into[x]
            f.efrom[q] = x
    return changed

/#/ ---- dead code -----------------------------------------------------------

/#/ Can nobody tell that `i` was removed, when its value is not used?
fn removable(f: &Fun, i: int) => bool:
    let o = f.op[i]
    if f.tab.has(o, f_term()) || f.tab.has(o, f_writes()) || f.tab.has(o, f_consumes()):
        return false
    if o == int(Op.Param) || o == int(Op.Call) || o == int(Op.CCall) || o == int(Op.CallI) || o == int(Op.Clone) || o == int(Op.VLoop):
        return false
    return true

/#/ Removes the instructions whose value nobody uses, from the end of each block backwards.
/#/ The use counts, from the instructions and edges that are there.
fn recount_uses(f: &Fun) => void:
    for i in 0..f.ni:
        f.uses[i] = 0
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            for k in 0..f.nval(i):
                let v = f.val_at(i, k)
                if v >= 0:
                    let x = f.follow(v)
                    f.uses[x] = f.uses[x] + 1
            i = f.nx[i]
    for e in 0..f.ne:
        if f.eto[e] >= 0:
            for k in 0..f.eargn[e]:
                let x = f.follow(f.pool[f.eargs[e] + k])
                f.uses[x] = f.uses[x] + 1

fn dead_code(f: &Fun) => bool:
    let changed = false
    recount_uses(f)
    for b in 0..f.nb:
        let i = f.blast[b]
        while i >= 0:
            let p = f.pv[i]
            if f.uses[i] == 0 && f.fwd[i] < 0 && removable(f, i):
                delete_inst(f, i)
                changed = true
            i = p
    return changed

/#/ Removes the parameters of the blocks (not the entry's) that nobody uses, and the
/#/ arguments the edges pass to them.
fn dead_params(f: &Fun) => bool:
    let changed = false
    for b in 1..f.nb:
        let n = f.npar[b]
        let keep: buf<int> = new_buf(int, n + 1)
        let any = false
        let p = f.pfirst[b]
        let k = 0
        while p >= 0:
            keep[k] = 1
            /#/ nobody uses it, or only the jump around the loop hands it back to itself
            let own = 0
            for e in 0..f.ne:
                if f.eto[e] == b && k < f.eargn[e] && f.follow(f.pool[f.eargs[e] + k]) == p:
                    own = own + 1
            if f.uses[p] == own:
                keep[k] = 0
                any = true
            p = f.nx[p]
            k = k + 1
        if any:
            for e in 0..f.ne:
                if f.eto[e] == b:
                    let m = f.eargn[e]
                    let start = f.np
                    let out = 0
                    for j in 0..m:
                        if j < n && keep[j] == 0:
                            let x = f.follow(f.pool[f.eargs[e] + j])
                            f.uses[x] = f.uses[x] - 1
                        else:
                            f.pool_put(f.pool[f.eargs[e] + j])
                            out = out + 1
                    f.eargs[e] = start
                    f.eargn[e] = out
            let first = -1
            let last = -1
            let q = f.pfirst[b]
            let cnt = 0
            while q >= 0:
                let nxt = f.nx[q]
                if keep[f.aux[q]] == 1:
                    f.pv[q] = last
                    f.nx[q] = -1
                    if last >= 0:
                        f.nx[last] = q
                    else:
                        first = q
                    last = q
                    cnt = cnt + 1
                q = nxt
            /#/ parameter numbers are their position
            let r = first
            let pos = 0
            while r >= 0:
                f.aux[r] = pos
                pos = pos + 1
                r = f.nx[r]
            f.pfirst[b] = first
            f.plast[b] = last
            f.npar[b] = cnt
            changed = true
    return changed

/#/ ---- ownership -----------------------------------------------------------

/#/ An `alloc` whose only use is the `free` that follows is no allocation at all.
/#/ `y = clone x; ...; drop x` with no other use of `x` makes `y` be `x`: the copy is never made.
fn own_opt(f: &Fun) => bool:
    let changed = false
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let nxt = f.nx[i]
            let o = f.op[i]
            if o == int(Op.Alloc) && f.uses[i] == 1:
                let j = nxt
                while j >= 0 && !(f.op[j] == int(Op.Free) && f.follow(f.a[j]) == i):
                    j = f.nx[j]
                if j >= 0:
                    if nxt == j:
                        nxt = f.nx[j]
                    delete_inst(f, j)
                    delete_inst(f, i)
                    changed = true
            elif o == int(Op.Clone) && f.fwd[i] < 0:
                let x = f.follow(f.a[i])
                if f.uses[x] == 2:
                    let j = f.nx[i]
                    while j >= 0 && !(f.op[j] == int(Op.Drop) && f.follow(f.a[j]) == x):
                        j = f.nx[j]
                    if j >= 0:
                        if nxt == j:
                            nxt = f.nx[j]
                        delete_inst(f, j)
                        f.uses[x] = f.uses[x] + f.uses[i]
                        f.fwd[i] = x
                        unlink(f, i)
                        f.uses[x] = f.uses[x] - 1
                        changed = true
            i = nxt
    return changed

/#/ An `alloc` that is freed in its own block and used only by loads and stores through it (and
/#/ field and index addresses of it) in between does not outlive the block: it becomes a `slot`
/#/ and the `free` goes. A pointer that is passed, stored, returned or used elsewhere keeps it on the heap.
fn stack_alloc(f: &Fun) => bool:
    let ipos: buf<int> = new_buf(int, f.ni + 1)
    let free_of: buf<int> = new_buf(int, f.ni + 1)
    let base: buf<int> = new_buf(int, f.ni + 1)
    let bad: buf<int> = new_buf(int, f.ni + 1)
    let blk_of: buf<int> = new_buf(int, f.ni + 1)
    let any = false
    for i in 0..f.ni:
        free_of[i] = -1
        base[i] = -1
    for b in 0..f.nb:
        let i = f.bfirst[b]
        let n = 0
        while i >= 0:
            ipos[i] = n
            blk_of[i] = b
            n = n + 1
            i = f.nx[i]
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            if f.op[i] == int(Op.Alloc) && f.fwd[i] < 0 && f.ty[i] > 0 && f.ty[i] <= 4096:
                let j = f.nx[i]
                while j >= 0 && !(f.op[j] == int(Op.Free) && f.follow(f.a[j]) == i):
                    j = f.nx[j]
                if j >= 0:
                    free_of[i] = j
                    base[i] = i
                    any = true
            i = f.nx[i]
    if !any:
        return false
    /#/ addresses derived from a candidate
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            if (f.op[i] == int(Op.Field) || f.op[i] == int(Op.Index)) && base[f.follow(f.a[i])] >= 0:
                base[i] = base[f.follow(f.a[i])]
            i = f.nx[i]
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let o = f.op[i]
            if !(o == int(Op.Alloc) && free_of[i] >= 0):
                for q in 0..f.nval(i):
                    let v = f.val_at(i, q)
                    if v >= 0:
                        let x = f.follow(v)
                        let c = base[x]
                        if c >= 0:
                            let ok = false
                            if blk_of[i] == blk_of[c] && ipos[i] > ipos[c] && ipos[i] <= ipos[free_of[c]] && q == 0:
                                if o == int(Op.Load) || o == int(Op.Store) || o == int(Op.Field) || o == int(Op.Index):
                                    ok = true
                                if o == int(Op.Free) && i == free_of[c] && x == c:
                                    ok = true
                            if !ok:
                                bad[c] = 1
            i = f.nx[i]
    for e in 0..f.ne:
        if f.eto[e] >= 0:
            for k in 0..f.eargn[e]:
                let c = base[f.follow(f.pool[f.eargs[e] + k])]
                if c >= 0:
                    bad[c] = 1
    let changed = false
    for c in 0..f.ni:
        if free_of[c] >= 0 && bad[c] == 0 && f.op[c] == int(Op.Alloc):
            delete_inst(f, free_of[c])
            f.op[c] = int(Op.Slot)
            changed = true
    return changed

/#/ Runs the passes: cleanup, own-opt, cleanup again for what that exposed.
/#/ Moves every `extract` to just after the aggregate it reads, and keeps one of those that read
/#/ the same element: a field of a value defined before a loop is read once, not each time round.
fn hoist_extracts(f: &Fun) => bool:
    let changed = false
    let seen = 0
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let nxt = f.nx[i]
            if f.op[i] == int(Op.Extract) && f.fwd[i] < 0:
                seen = seen + 1
                let g = f.follow(f.a[i])
                let db = f.blk[g]
                if db >= 0 && db != b:
                    unlink(f, i)
                    f.blk[i] = db
                    if f.op[g] == int(Op.Param):
                        let first = f.bfirst[db]
                        f.pv[i] = -1
                        f.nx[i] = first
                        if first >= 0:
                            f.pv[first] = i
                        else:
                            f.blast[db] = i
                        f.bfirst[db] = i
                    else:
                        let n = f.nx[g]
                        f.pv[i] = g
                        f.nx[i] = n
                        f.nx[g] = i
                        if n >= 0:
                            f.pv[n] = i
                        else:
                            f.blast[db] = i
                    changed = true
            i = nxt
    if seen < 2:
        return changed
    /#/ the same element of the same aggregate: all of them are in one block now, the first dominates
    let cap = 16
    while cap < seen * 2:
        cap = cap * 2
    let tab: buf<int> = new_buf(int, cap)
    for q in 0..cap:
        tab[q] = -1
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let nxt = f.nx[i]
            if f.op[i] == int(Op.Extract) && f.fwd[i] < 0:
                let g = f.follow(f.a[i])
                let h = ((g * 31 + f.aux[i]) * 31 + f.rep[i]) % cap
                if h < 0:
                    h = h + cap
                let found = -1
                while tab[h] >= 0 && found < 0:
                    let e = tab[h]
                    if f.follow(f.a[e]) == g && f.aux[e] == f.aux[i] && f.rep[e] == f.rep[i]:
                        found = e
                    else:
                        h = (h + 1) % cap
                if found >= 0:
                    f.uses[found] = f.uses[found] + f.uses[i]
                    f.fwd[i] = found
                    unuse(f, i)
                    unlink(f, i)
                    changed = true
                else:
                    tab[h] = i
            i = nxt
    return changed

/#/ ---- common subexpressions and known conditions ------------------------------

/#/ Does the value of `i` depend on its operands alone (no memory, no call)?
fn pure_op(o: int) => bool:
    if o >= int(Op.Add) && o <= int(Op.FNeg) && o != int(Op.FRem):
        return true
    if o >= int(Op.Cmp) && o <= int(Op.Insert):
        return true
    return o == int(Op.Field) || o == int(Op.Index)

fn commutes(o: int) => bool:
    return o == int(Op.Add) || o == int(Op.Mul) || o == int(Op.And) || o == int(Op.Or) || o == int(Op.Xor) || o == int(Op.FAdd) || o == int(Op.FMul)

/#/ The operands of pure instruction `i` as values, the first two in a fixed order when the
/#/ operation commutes. Returns them in `k[0..3]`.
fn operands(f: &Fun, i: int, k: &buf<int>) => void:
    let x = -1
    let y = -1
    let z = -1
    if f.a[i] >= 0:
        x = f.follow(f.a[i])
    if f.b[i] >= 0:
        y = f.follow(f.b[i])
    if f.c[i] >= 0:
        z = f.follow(f.c[i])
    if commutes(f.op[i]) && x > y:
        let t = x
        x = y
        y = t
    k[0] = x
    k[1] = y
    k[2] = z

/#/ The blocks reachable from the entry in reverse post-order (`rpo`, the count returned) and their
/#/ immediate dominators (`idom`, -1 for the unreachable).
fn dominators(f: &Fun, rpo: &buf<int>, idom: &buf<int>, pc: &buf<int>, pl: &buf<int>) => int:
    let nb = f.nb
    let visited: buf<int> = new_buf(int, nb + 1)
    let ci: buf<int> = new_buf(int, nb + 1)
    let stack: buf<int> = new_buf(int, nb + 1)
    let post: buf<int> = new_buf(int, nb + 1)
    let sp = 1
    let np = 0
    stack[0] = 0
    visited[0] = 1
    while sp > 0:
        let b = stack[sp - 1]
        if f.terminated(b) && ci[b] < f.nsucc(b):
            /#/ the last successor first, so that the first one comes first in reverse post-order
            let t = f.eto[f.succ_edge(b, f.nsucc(b) - 1 - ci[b])]
            ci[b] = ci[b] + 1
            if t >= 0 && t < nb && visited[t] == 0:
                visited[t] = 1
                stack[sp] = t
                sp = sp + 1
        else:
            post[np] = b
            np = np + 1
            sp = sp - 1
    let num: buf<int> = new_buf(int, nb + 1)
    for k in 0..np:
        rpo[k] = post[np - 1 - k]
        num[rpo[k]] = k
    for b in 0..nb:
        idom[b] = -1
    idom[0] = 0
    /#/ the predecessors: those of block b are pl[pc[b] .. pc[b + 1]]
    for k in 0..np:
        let b = rpo[k]
        for s in 0..f.nsucc(b):
            let t = f.eto[f.succ_edge(b, s)]
            if t >= 0:
                pc[t + 1] = pc[t + 1] + 1
    for b in 0..nb:
        pc[b + 1] = pc[b + 1] + pc[b]
    let fill: buf<int> = new_buf(int, nb + 1)
    for k in 0..np:
        let b = rpo[k]
        for s in 0..f.nsucc(b):
            let t = f.eto[f.succ_edge(b, s)]
            if t >= 0:
                pl[pc[t] + fill[t]] = b
                fill[t] = fill[t] + 1
    let changed = true
    while changed:
        changed = false
        for k in 1..np:
            let b = rpo[k]
            let nd = -1
            for q in pc[b]..pc[b + 1]:
                let pb = pl[q]
                if idom[pb] >= 0:
                    if nd < 0:
                        nd = pb
                    else:
                        let x = pb
                        let y = nd
                        while x != y:
                            while num[x] > num[y]:
                                x = idom[x]
                            while num[y] > num[x]:
                                y = idom[y]
                        nd = x
            if nd != idom[b]:
                idom[b] = nd
                changed = true
    return np

/#/ Replaces instruction `i` by the value `v` everywhere.
fn replace_inst(f: &Fun, i: int, v: int) => void:
    f.uses[v] = f.uses[v] + f.uses[i]
    f.fwd[i] = v
    unuse(f, i)
    unlink(f, i)

/#/ Is the integer `v` never negative? A constant, or a loop counter: a block parameter that starts at a
/#/ small constant and only grows by small constants (it would take more than 2^50 steps to wrap).
fn nonneg(f: &Fun, v0: int) => bool:
    let v = f.follow(v0)
    if f.is_const(v):
        return f.cval(v) >= 0
    if f.op[v] != int(Op.Param) || f.blk[v] == 0 || f.rep[v] != int(Rp.I64):
        return false
    let b = f.blk[v]
    let k = 0
    let q = f.pfirst[b]
    while q >= 0 && q != v:
        q = f.nx[q]
        k = k + 1
    let seen = 0
    for e in 0..f.ne:
        if f.eto[e] == b:
            seen = seen + 1
            if k >= f.eargn[e]:
                return false
            let a = f.follow(f.pool[f.eargs[e] + k])
            if f.is_const(a):
                if f.cval(a) < 0 || f.cval(a) > 4294967296:
                    return false
            elif f.op[a] == int(Op.Add) && f.follow(f.a[a]) == v && f.is_const(f.follow(f.b[a])) && f.cval(f.follow(f.b[a])) >= 0 && f.cval(f.follow(f.b[a])) <= 256:
                seen = seen
            else:
                return false
    return seen > 0

/#/ Does the taken edge of `slt x, K'` settle `ult x, K`? Then x < K' <= K, and x is not negative.
fn implies_ult(f: &Fun, c2: int, c: int) => bool:
    if f.op[c] != int(Op.Cmp) || f.op[c2] != int(Op.Cmp):
        return false
    if f.aux[c] != int(Pr.ULt) || f.aux[c2] != int(Pr.SLt):
        return false
    let x = f.follow(f.a[c])
    let k = f.follow(f.b[c])
    let x2 = f.follow(f.a[c2])
    let k2 = f.follow(f.b[c2])
    if x != x2 || !f.is_const(k) || !f.is_const(k2) || f.rep[x] != int(Rp.I64):
        return false
    return f.cval(k2) <= f.cval(k) && nonneg(f, x)

/#/ A pure instruction that an instruction with the same operation and operands in a dominating
/#/ block already computed is that one. Then a branch on a condition that a dominating branch has
/#/ decided (the block is entered by one edge of it) goes one way only: the second bounds check
/#/ of `a[i]` and the checks the loop condition implies.
fn cse_branches(f: &Fun) => bool:
    if f.nb < 2:
        return false
    let nb = f.nb
    let rpo: buf<int> = new_buf(int, nb + 1)
    let idom: buf<int> = new_buf(int, nb + 1)
    let pc: buf<int> = new_buf(int, nb + 2)
    let pl: buf<int> = new_buf(int, f.ne + 1)
    let np = dominators(f, &rpo, &idom, &pc, &pl)
    let changed = false
    /#/ the dominator tree, and the single predecessor of each block (-1: none or several)
    let head: buf<int> = new_buf(int, nb + 1)
    let sib: buf<int> = new_buf(int, nb + 1)
    let npred: buf<int> = new_buf(int, nb + 1)
    let pred1: buf<int> = new_buf(int, nb + 1)
    for b in 0..nb:
        head[b] = -1
        pred1[b] = -1
    for k in 0..np:
        let b = rpo[k]
        if b != 0:
            sib[b] = head[idom[b]]
            head[idom[b]] = b
        for s in 0..f.nsucc(b):
            let t = f.eto[f.succ_edge(b, s)]
            if t >= 0:
                npred[t] = npred[t] + 1
                pred1[t] = b
    let cap = 64
    while cap < f.ni * 2:
        cap = cap * 2
    let tab: buf<int> = new_buf(int, cap)
    for q in 0..cap:
        tab[q] = -1
    let log: buf<int> = new_buf(int, f.ni + 1)
    let nlog = 0
    let mark: buf<int> = new_buf(int, nb + 1)
    let entered: buf<int> = new_buf(int, nb + 1)
    let stack: buf<int> = new_buf(int, nb + 1)
    let ka: buf<int> = new_buf(int, 4)
    let kb: buf<int> = new_buf(int, 4)
    let sp = 1
    stack[0] = 0
    while sp > 0:
        let b = stack[sp - 1]
        if entered[b] == 1:
            while nlog > mark[b]:
                nlog = nlog - 1
                tab[log[nlog]] = -1
            sp = sp - 1
        else:
            entered[b] = 1
            mark[b] = nlog
            let i = f.bfirst[b]
            while i >= 0:
                let nxt = f.nx[i]
                if pure_op(f.op[i]) && f.fwd[i] < 0:
                    operands(f, i, &ka)
                    let h = hmix(hmix(hmix(hmix(hmix(f.op[i], f.rep[i]), ka[0]), ka[1]), ka[2]), f.aux[i]) % cap
                    if h < 0:
                        h = h + cap
                    let found = -1
                    while tab[h] >= 0 && found < 0:
                        let e = tab[h]
                        if f.op[e] == f.op[i] && f.rep[e] == f.rep[i] && f.aux[e] == f.aux[i]:
                            operands(f, e, &kb)
                            if kb[0] == ka[0] && kb[1] == ka[1] && kb[2] == ka[2]:
                                found = e
                        if found < 0:
                            h = (h + 1) % cap
                    if found >= 0:
                        replace_inst(f, i, found)
                        changed = true
                    else:
                        tab[h] = i
                        log[nlog] = h
                        nlog = nlog + 1
                i = nxt
            /#/ a decided condition: walk up the blocks that are entered by one edge of a branch
            let t = f.blast[b]
            if t >= 0 && f.op[t] == int(Op.CondBr):
                let c = f.follow(f.a[t])
                if !f.is_const(c):
                    let x = b
                    let known = -1
                    while known < 0:
                        if npred[x] == 1:
                            let pb = pred1[x]
                            let pt = f.blast[pb]
                            if pt >= 0 && f.op[pt] == int(Op.CondBr) && f.follow(f.a[pt]) == c:
                                let et = f.eto[f.b[pt]]
                                let ef = f.eto[f.c[pt]]
                                if et == x && ef != x:
                                    known = 1
                                elif ef == x && et != x:
                                    known = 0
                            elif pt >= 0 && f.op[pt] == int(Op.CondBr) && implies_ult(f, f.follow(f.a[pt]), c):
                                if f.eto[f.b[pt]] == x && f.eto[f.c[pt]] != x:
                                    known = 1
                        if known < 0:
                            if x == 0 || idom[x] == x || idom[x] < 0:
                                break
                            x = idom[x]
                    if known >= 0:
                        let kc = f.cint(int(Rp.I8), known)
                        f.uses[c] = f.uses[c] - 1
                        f.uses[kc] = f.uses[kc] + 1
                        f.a[t] = kc
                        changed = true
            let ch = head[b]
            while ch >= 0:
                stack[sp] = ch
                sp = sp + 1
                ch = sib[ch]
    return changed

/#/ ---- value ranges and bounds checks --------------------------------------

/#/ Integer ranges are kept as `[lo, hi]` of 64-bit values; a bound of `rg_inf` or more in size is "no bound",
/#/ and a range with `lo > hi` is empty (not computed yet). Bounds that are kept are below 2^62, so adding two
/#/ cannot wrap.
let rg_inf = 4611686018427387904

class RgCtx:
    lo: buf<int>
    hi: buf<int>
    idom: buf<int>
    fcmp: buf<int>
    fpol: buf<int>
    need: buf<int>
    rl: int
    rh: int

fn rg_clamp(v: int) => int:
    if v >= rg_inf:
        return rg_inf
    if v <= 0 - rg_inf:
        return 0 - rg_inf
    return v

/#/ The predicate `p` seen from the other operand.
fn rg_mirror(p: int) => int:
    if p == int(Pr.SLt):
        return int(Pr.SGt)
    if p == int(Pr.SLe):
        return int(Pr.SGe)
    if p == int(Pr.SGt):
        return int(Pr.SLt)
    if p == int(Pr.SGe):
        return int(Pr.SLe)
    if p == int(Pr.ULt):
        return int(Pr.UGt)
    if p == int(Pr.ULe):
        return int(Pr.UGe)
    if p == int(Pr.UGt):
        return int(Pr.ULt)
    if p == int(Pr.UGe):
        return int(Pr.ULe)
    return p

/#/ The predicate that holds when `p` does not.
fn rg_negate(p: int) => int:
    if p == int(Pr.SLt):
        return int(Pr.SGe)
    if p == int(Pr.SLe):
        return int(Pr.SGt)
    if p == int(Pr.SGt):
        return int(Pr.SLe)
    if p == int(Pr.SGe):
        return int(Pr.SLt)
    if p == int(Pr.Eq):
        return int(Pr.Ne)
    if p == int(Pr.Ne):
        return int(Pr.Eq)
    if p == int(Pr.ULt):
        return int(Pr.UGe)
    if p == int(Pr.UGe):
        return int(Pr.ULt)
    if p == int(Pr.ULe):
        return int(Pr.UGt)
    if p == int(Pr.UGt):
        return int(Pr.ULe)
    return -1

/#/ The range of the whole value `v` (what it is wherever it is defined), without any branch's help.
fn rg_global(c: &RgCtx, f: &Fun, v: int) => void:
    if f.is_const(v):
        let k = rg_clamp(f.cval(v))
        c.rl = k
        c.rh = k
    elif f.rep[v] != int(Rp.I64):
        c.rl = 0 - rg_inf
        c.rh = rg_inf
    else:
        c.rl = c.lo[v]
        c.rh = c.hi[v]

/#/ The range of `v0` in block `b`: its own range, narrowed by the branches that decide the way into `b` or into a
/#/ block that dominates it.
fn rg_at(c: &RgCtx, f: &Fun, v0: int, b: int) => void:
    let v = f.follow(v0)
    rg_global(c, f, v)
    let lo = c.rl
    let hi = c.rh
    if f.is_const(v) || f.rep[v] != int(Rp.I64):
        return
    let x = b
    while x >= 0:
        let fc = c.fcmp[x]
        if fc >= 0:
            let a = f.follow(f.a[fc])
            let bb = f.follow(f.b[fc])
            if (a == v || bb == v) && a != bb:
                let pr = f.aux[fc]
                if c.fpol[x] == 0:
                    pr = rg_negate(pr)
                let other = bb
                if bb == v:
                    other = a
                    pr = rg_mirror(pr)
                if pr >= 0:
                    rg_global(c, f, other)
                    let ol = c.rl
                    let oh = c.rh
                    if pr == int(Pr.SLt) && oh < rg_inf:
                        hi = rg_min(hi, oh - 1)
                    elif pr == int(Pr.SLe) && oh < rg_inf:
                        hi = rg_min(hi, oh)
                    elif pr == int(Pr.SGt) && ol > 0 - rg_inf:
                        lo = rg_max(lo, ol + 1)
                    elif pr == int(Pr.SGe) && ol > 0 - rg_inf:
                        lo = rg_max(lo, ol)
                    elif pr == int(Pr.Eq):
                        lo = rg_max(lo, ol)
                        hi = rg_min(hi, oh)
                    elif (pr == int(Pr.ULt) || pr == int(Pr.ULe)) && ol >= 0 && oh < rg_inf:
                        lo = rg_max(lo, 0)
                        if pr == int(Pr.ULt):
                            hi = rg_min(hi, oh - 1)
                        else:
                            hi = rg_min(hi, oh)
        if x == 0 || c.idom[x] == x || c.idom[x] < 0:
            break
        x = c.idom[x]
    c.rl = lo
    c.rh = hi

fn rg_min(a: int, b: int) => int:
    if a < b:
        return a
    return b

fn rg_max(a: int, b: int) => int:
    if a > b:
        return a
    return b

/#/ The range of instruction `i` from the ranges of its operands in its block, left in `c.rl`, `c.rh`.
fn rg_eval(c: &RgCtx, f: &Fun, i: int) => void:
    let o = f.op[i]
    let b = f.blk[i]
    let top = rg_inf
    c.rl = 0 - top
    c.rh = top
    if f.rep[i] != int(Rp.I64):
        return
    if o == int(Op.Add) || o == int(Op.Sub) || o == int(Op.Mul):
        rg_at(c, f, f.a[i], b)
        let al = c.rl
        let ah = c.rh
        rg_at(c, f, f.b[i], b)
        let bl = c.rl
        let bh = c.rh
        if al > ah || bl > bh:
            c.rl = top
            c.rh = 0 - top
            return
        c.rl = 0 - top
        c.rh = top
        if o == int(Op.Add):
            if al > 0 - top && bl > 0 - top:
                c.rl = rg_clamp(al + bl)
            if ah < top && bh < top:
                c.rh = rg_clamp(ah + bh)
        elif o == int(Op.Sub):
            if al > 0 - top && bh < top:
                c.rl = rg_clamp(al - bh)
            if ah < top && bl > 0 - top:
                c.rh = rg_clamp(ah - bl)
        else:
            let lim = 2147483648
            if al > 0 - lim && ah < lim && bl > 0 - lim && bh < lim:
                let p1 = al * bl
                let p2 = al * bh
                let p3 = ah * bl
                let p4 = ah * bh
                c.rl = rg_min(rg_min(p1, p2), rg_min(p3, p4))
                c.rh = rg_max(rg_max(p1, p2), rg_max(p3, p4))
    elif o == int(Op.SRem) || o == int(Op.SDiv) || o == int(Op.And) || o == int(Op.AShr) || o == int(Op.LShr) || o == int(Op.Shl):
        rg_at(c, f, f.a[i], b)
        let al = c.rl
        let ah = c.rh
        let kb = f.follow(f.b[i])
        c.rl = 0 - top
        c.rh = top
        if al > ah:
            c.rl = top
            c.rh = 0 - top
            return
        if f.is_const(kb):
            let k = f.cval(kb)
            if o == int(Op.SRem) && k > 0:
                c.rl = 1 - k
                c.rh = k - 1
                if al >= 0:
                    c.rl = 0
                    if ah < k - 1:
                        c.rh = ah
            elif o == int(Op.SDiv) && k > 0:
                if al > 0 - top:
                    c.rl = al // k
                if ah < top:
                    c.rh = ah // k
            elif o == int(Op.And) && k >= 0:
                c.rl = 0
                c.rh = k
                if al >= 0 && ah < k:
                    c.rh = ah
            elif o == int(Op.AShr) && k >= 0 && k < 63:
                if al > 0 - top:
                    c.rl = al >> k
                if ah < top:
                    c.rh = ah >> k
            elif o == int(Op.LShr) && k > 0 && k < 63:
                c.rl = 0
                c.rh = 9223372036854775807 >> (k - 1)
                if al >= 0 && ah < top:
                    c.rh = ah >> k
                if c.rh >= top:
                    c.rh = top
            elif o == int(Op.Shl) && k >= 0 && k < 31 && al > 0 - 2147483648 && ah < 2147483648:
                c.rl = al << k
                c.rh = ah << k
    elif o == int(Op.ZExt) || o == int(Op.SExt):
        let r = f.rep[f.follow(f.a[i])]
        let bits = rp_bits(r)
        if bits > 0 && bits < 64:
            if o == int(Op.ZExt):
                c.rl = 0
                c.rh = (1 << bits) - 1
            else:
                c.rl = 0 - (1 << (bits - 1))
                c.rh = (1 << (bits - 1)) - 1

/#/ One round over the values in reverse post-order; `mode` 0 joins the new range into the old one, 1 widens
/#/ (a bound that moved goes to no bound), 2 takes the new range (narrowing, from a state that is already sound).
/#/ Returns whether a range changed.
fn rg_round(c: &RgCtx, f: &Fun, rpo: &buf<int>, np: int, inh: &buf<int>, innext: &buf<int>, mode: int) => bool:
    let changed = false
    for r in 0..np:
        let b = rpo[r]
        let p = f.pfirst[b]
        let k = 0
        while p >= 0:
            if f.rep[p] == int(Rp.I64) && f.fwd[p] < 0 && b != 0 && c.need[p] == 1:
                let nl = rg_inf
                let nh = 0 - rg_inf
                let e = inh[b]
                while e >= 0:
                    if k < f.eargn[e]:
                        rg_at(c, f, f.pool[f.eargs[e] + k], f.efrom[e])
                        nl = rg_min(nl, c.rl)
                        nh = rg_max(nh, c.rh)
                    else:
                        nl = 0 - rg_inf
                        nh = rg_inf
                    e = innext[e]
                if rg_set(c, p, nl, nh, mode):
                    changed = true
            p = f.nx[p]
            k = k + 1
        let i = f.bfirst[b]
        while i >= 0:
            if f.fwd[i] < 0 && f.rep[i] == int(Rp.I64) && c.need[i] == 1 && !f.is_const(i):
                rg_eval(c, f, i)
                if rg_set(c, i, c.rl, c.rh, mode):
                    changed = true
            i = f.nx[i]
    return changed

/#/ Stores a new range for `v` by the rules of `rg_round`; whether it differs from the old one.
fn rg_set(c: &RgCtx, v: int, nl: int, nh: int, mode: int) => bool:
    let ol = c.lo[v]
    let oh = c.hi[v]
    let l = nl
    let h = nh
    if mode == 0:
        if ol <= oh:
            l = rg_min(ol, nl)
            h = rg_max(oh, nh)
    elif mode == 1:
        if ol <= oh:
            if nl < ol:
                l = 0 - rg_inf
            else:
                l = ol
            if nh > oh:
                h = rg_inf
            else:
                h = oh
    if nl > nh:
        l = ol
        h = oh
    if l == ol && h == oh:
        return false
    c.lo[v] = l
    c.hi[v] = h
    return true

/#/ A bounds check `ult x, len` that the ranges (or the loop condition `x < len` on the way in) show to hold is
/#/ not made: its branch goes the one way. Ranges are of the loop counters and what is computed from them with
/#/ sums, products by constants and the like, narrowed by the branches that decide the way into a block.
fn range_checks(f: &Fun) => bool:
    if f.nb < 2 || f.ni > 6000:
        return false
    /#/ a check against a length that is not a constant can only be settled by a loop condition against the
    /#/ same value
    let upper: buf<int> = new_buf(int, f.ni + 1)
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            if f.op[i] == int(Op.Cmp) && (f.aux[i] == int(Pr.SLt) || f.aux[i] == int(Pr.SLe)) && f.fwd[i] < 0:
                upper[f.follow(f.b[i])] = 1
            i = f.nx[i]
    let cands = 0
    for b in 0..f.nb:
        let t = f.blast[b]
        if t >= 0 && f.op[t] == int(Op.CondBr):
            let cm = f.follow(f.a[t])
            if f.op[cm] == int(Op.Cmp) && f.aux[cm] == int(Pr.ULt) && !f.is_const(cm):
                let lv0 = f.follow(f.b[cm])
                if f.is_const(lv0) || upper[lv0] == 1:
                    cands = cands + 1
    if cands == 0:
        return false
    /#/ without a back edge there is no counter whose range could settle a check
    let looped = false
    for e in 0..f.ne:
        if f.efrom[e] >= 0 && f.eto[e] >= 0 && f.eto[e] <= f.efrom[e]:
            looped = true
    if !looped:
        return false
    let nb = f.nb
    let rpo: buf<int> = new_buf(int, nb + 1)
    let idom: buf<int> = new_buf(int, nb + 1)
    let pc: buf<int> = new_buf(int, nb + 2)
    let pl: buf<int> = new_buf(int, f.ne + 1)
    let np = dominators(f, &rpo, &idom, &pc, &pl)
    let inh: buf<int> = new_buf(int, nb + 1)
    let innext: buf<int> = new_buf(int, f.ne + 1)
    let nin: buf<int> = new_buf(int, nb + 1)
    let sedge: buf<int> = new_buf(int, nb + 1)
    for b in 0..nb:
        inh[b] = -1
        sedge[b] = -1
    for e in 0..f.ne:
        let from = f.efrom[e]
        let to = f.eto[e]
        if from >= 0 && to >= 0 && from < nb && to < nb && idom[from] >= 0:
            innext[e] = inh[to]
            inh[to] = e
            /#/ an edge from a block the target dominates (a back edge) does not count: the way in from
            /#/ outside decides what holds in the target and the blocks it dominates (a value does not change)
            let y = from
            let inside = false
            while !inside:
                if y == to:
                    inside = true
                elif y == 0 || idom[y] == y || idom[y] < 0:
                    break
                else:
                    y = idom[y]
            if !inside:
                nin[to] = nin[to] + 1
                sedge[to] = e
    let c = RgCtx { lo: new_buf(int, f.ni + 1), hi: new_buf(int, f.ni + 1), idom: idom, fcmp: new_buf(int, nb + 1), fpol: new_buf(int, nb + 1), need: new_buf(int, f.ni + 1), rl: 0, rh: 0 }
    for v in 0..f.ni:
        c.lo[v] = rg_inf
        c.hi[v] = 0 - rg_inf
    let ep = f.pfirst[0]
    while ep >= 0:
        c.lo[ep] = 0 - rg_inf
        c.hi[ep] = rg_inf
        ep = f.nx[ep]
    for b in 0..nb:
        c.fcmp[b] = -1
        if nin[b] == 1:
            let e = sedge[b]
            let p = f.efrom[e]
            let t = f.blast[p]
            if t >= 0 && f.op[t] == int(Op.CondBr) && f.b[t] != f.c[t]:
                let cm = f.follow(f.a[t])
                if f.op[cm] == int(Op.Cmp) && rp_is_int(f.rep[f.follow(f.a[cm])]) && f.rep[f.follow(f.a[cm])] == int(Rp.I64):
                    if e == f.b[t]:
                        c.fcmp[b] = cm
                        c.fpol[b] = 1
                    elif e == f.c[t]:
                        c.fcmp[b] = cm
                        c.fpol[b] = 0
    /#/ only the values the checks depend on get a range: the operands of the checked pairs, what those are
    /#/ computed from, and the other side of the branches that narrow them
    for b in 0..nb:
        let t = f.blast[b]
        if t >= 0 && f.op[t] == int(Op.CondBr):
            let cm = f.follow(f.a[t])
            if f.op[cm] == int(Op.Cmp) && f.aux[cm] == int(Pr.ULt) && !f.is_const(cm):
                c.need[f.follow(f.a[cm])] = 1
                c.need[f.follow(f.b[cm])] = 1
    let grew = true
    while grew:
        grew = false
        for b in 0..nb:
            let fc = c.fcmp[b]
            if fc >= 0:
                let x1 = f.follow(f.a[fc])
                let x2 = f.follow(f.b[fc])
                if (c.need[x1] == 1) != (c.need[x2] == 1):
                    c.need[x1] = 1
                    c.need[x2] = 1
                    grew = true
            if idom[b] >= 0:
                let p = f.pfirst[b]
                let k = 0
                while p >= 0:
                    if c.need[p] == 1 && b != 0:
                        let e = inh[b]
                        while e >= 0:
                            if k < f.eargn[e]:
                                let av = f.follow(f.pool[f.eargs[e] + k])
                                if c.need[av] == 0:
                                    c.need[av] = 1
                                    grew = true
                            e = innext[e]
                    p = f.nx[p]
                    k = k + 1
                let i = f.bfirst[b]
                while i >= 0:
                    if c.need[i] == 1 && f.fwd[i] < 0:
                        let o = f.op[i]
                        if o == int(Op.Add) || o == int(Op.Sub) || o == int(Op.Mul) || o == int(Op.SRem) || o == int(Op.SDiv) || o == int(Op.And) || o == int(Op.AShr) || o == int(Op.LShr) || o == int(Op.Shl):
                            let o1 = f.follow(f.a[i])
                            let o2 = f.follow(f.b[i])
                            if c.need[o1] == 0:
                                c.need[o1] = 1
                                grew = true
                            if c.need[o2] == 0:
                                c.need[o2] = 1
                                grew = true
                    i = f.nx[i]
    let rounds = 0
    while rg_round(&c, f, &rpo, np, &inh, &innext, 0) && rounds < 4:
        rounds = rounds + 1
    let wide = 0
    while rg_round(&c, f, &rpo, np, &inh, &innext, 1) && wide < 12:
        wide = wide + 1
    if wide >= 12:
        return false
    for q in 0..3:
        rg_round(&c, f, &rpo, np, &inh, &innext, 2)
    let changed = false
    for r in 0..np:
        let b = rpo[r]
        let t = f.blast[b]
        if t >= 0 && f.op[t] == int(Op.CondBr):
            let cm = f.follow(f.a[t])
            if f.op[cm] == int(Op.Cmp) && f.aux[cm] == int(Pr.ULt) && !f.is_const(cm):
                let x = f.follow(f.a[cm])
                let lv = f.follow(f.b[cm])
                if f.rep[x] == int(Rp.I64) && f.rep[lv] == int(Rp.I64):
                    rg_at(&c, f, x, b)
                    let xl = c.rl
                    let xh = c.rh
                    rg_at(&c, f, lv, b)
                    let ll = c.rl
                    let ok = xl >= 0 && xl <= xh && xh < ll
                    /#/ or the loop condition `x < len` on the way in, with x not negative
                    let y = b
                    while !ok && y >= 0:
                        let fc = c.fcmp[y]
                        if fc >= 0 && c.fpol[y] == 1 && f.aux[fc] == int(Pr.SLt) && f.follow(f.a[fc]) == x && f.follow(f.b[fc]) == lv && xl >= 0:
                            ok = true
                        if y == 0 || c.idom[y] == y || c.idom[y] < 0:
                            break
                        y = c.idom[y]
                    if ok:
                        let kc = f.cint(int(Rp.I8), 1)
                        f.uses[cm] = f.uses[cm] - 1
                        f.uses[kc] = f.uses[kc] + 1
                        f.a[t] = kc
                        changed = true
    return changed

/#/ ---- loop-invariant code ---------------------------------------------------

/#/ Does instruction `i` write memory or call something?
/#/ Is `v` the address of (a field of) what a reference parameter of the function points to?
fn deref_ok(f: &Fun, v: int) => bool:
    let x = f.follow(v)
    while x >= 0 && f.op[x] == int(Op.Field) && f.a[x] >= 0:
        x = f.follow(f.a[x])
    return x >= 0 && f.op[x] == int(Op.Param) && f.blk[x] == 0 && f.ty[x] == 0 && f.rep[x] == int(Rp.Ptr)

/#/ What kind of memory the write `i` changes: 1 for a store of a float, 2 for a store of a small integer,
/#/ 3 for a store of a 64-bit integer into a buffer element,
/#/ 0 for anything else. A float or a small integer is never part of the pointer or length of a buffer
/#/ (nor of the other 8-byte things), so such a store leaves those as they were; a load of a float is
/#/ changed by a store of a float only, a load of a small integer by a store of a small integer.
fn store_class(f: &Fun, i: int) => int:
    if f.op[i] != int(Op.Store) || f.b[i] < 0:
        return 0
    let r = f.rep[f.follow(f.b[i])]
    if rp_is_float(r):
        return 1
    if r == int(Rp.I8) || r == int(Rp.I16) || r == int(Rp.I32):
        return 2
    /#/ a wide integer stored into an element of a buffer: the header of a buffer (its pointer and length)
    /#/ is not in the block of elements, so a load through a reference parameter is not changed
    if r == int(Rp.I64) && f.op[f.follow(f.a[i])] == int(Op.Index):
        return 3
    return 0

/#/ May the load `i` read something that the writes of a loop (`mem`: of any kind, `memf`: only floats,
/#/ `memn`: only small integers, `memw`: only elements of buffers, which every load but one through a
/#/ reference parameter may read) change?
fn load_blocked(f: &Fun, i: int, mem: bool, memf: bool, memn: bool, memw: bool) => bool:
    if mem:
        return true
    let r = f.rep[i]
    if memf && rp_is_float(r):
        return true
    if memn && (r == int(Rp.I8) || r == int(Rp.I16) || r == int(Rp.I32)):
        return true
    if !memw:
        return false
    /#/ the pointer of a buffer, or a field (its length, a field of a class): not what a `&int` may point at
    return !(deref_ok(f, f.a[i]) && (r == int(Rp.Ptr) || f.op[f.follow(f.a[i])] == int(Op.Field)))

fn writes_memory(f: &Fun, i: int) => bool:
    let o = f.op[i]
    if o == int(Op.Store) || o == int(Op.Call) || o == int(Op.CCall) || o == int(Op.CallI) || o == int(Op.Alloc) || o == int(Op.Free) || o == int(Op.Drop) || o == int(Op.Clone) || o == int(Op.FRem):
        return true
    return f.tab.has(o, f_writes()) || f.tab.has(o, f_consumes())

/#/ Moves the instructions of a loop that depend only on what is computed before it to just before
/#/ the end of the block that enters the loop (made when the loop has several entries or the entry
/#/ block branches two ways). A load moves when nothing in the loop writes memory and it is in the
/#/ header, which runs whenever the loop is entered.
fn hoist_invariants(f: &Fun) => bool:
    if f.nb < 2:
        return false
    let nb = f.nb
    let rpo: buf<int> = new_buf(int, nb + 1)
    let idom: buf<int> = new_buf(int, nb + 1)
    let pc: buf<int> = new_buf(int, nb + 2)
    let pl: buf<int> = new_buf(int, f.ne + 1)
    let np = dominators(f, &rpo, &idom, &pc, &pl)
    let changed = false
    let inl: buf<int> = new_buf(int, nb + 1)
    let work: buf<int> = new_buf(int, nb + 1)
    let moved: buf<int> = new_buf(int, f.ni + 1)
    let list: buf<int> = new_buf(int, f.ni + 1)
    let k = np - 1
    let prev = 0
    while k >= 1:
        let h = rpo[k]
        k = k - 1
        /#/ what was marked for the loop before is not invariant in this one
        for r in 0..prev:
            moved[list[r]] = 0
        prev = 0
        /#/ the latches: predecessors that the header dominates
        let nw = 0
        for q in 0..nb:
            inl[q] = 0
        inl[h] = 1
        for q in pc[h]..pc[h + 1]:
            let t = pl[q]
            let x = t
            while x != h && x != 0 && idom[x] >= 0 && idom[x] != x:
                x = idom[x]
            if x == h && inl[t] == 0:
                inl[t] = 1
                work[nw] = t
                nw = nw + 1
        if nw == 0:
            continue
        while nw > 0:
            nw = nw - 1
            let b = work[nw]
            for q in pc[b]..pc[b + 1]:
                let t = pl[q]
                if inl[t] == 0 && idom[t] >= 0:
                    inl[t] = 1
                    work[nw] = t
                    nw = nw + 1
        /#/ memory written in the loop?
        /#/ (a store of a float cannot change an integer or pointer in memory, so such a loop leaves the
        /#/ buffer headers it indexes as they were: `memf` blocks only the loads of floats)
        let mem = false
        let memf = false
        let memn = false
        let memw = false
        for r in 0..np:
            let b = rpo[r]
            if inl[b] == 1:
                let i = f.bfirst[b]
                while i >= 0:
                    if writes_memory(f, i):
                        let sc = store_class(f, i)
                        if sc == 1:
                            memf = true
                        elif sc == 2:
                            memn = true
                        elif sc == 3:
                            memw = true
                        else:
                            mem = true
                    i = f.nx[i]
        /#/ the one block outside the loop that jumps to the header
        let pre0 = -1
        let outs0 = 0
        for e in 0..f.ne:
            if f.eto[e] == h:
                let fb = f.efrom[e]
                if fb >= 0 && fb < nb && inl[fb] == 0 && idom[fb] >= 0:
                    outs0 = outs0 + 1
                    pre0 = fb
        if outs0 != 1:
            pre0 = -1
        /#/ what can move, in order
        let n = 0
        for r in 0..np:
            let b = rpo[r]
            if inl[b] == 1:
                let i = f.bfirst[b]
                while i >= 0:
                    let o = f.op[i]
                    let nxt = f.nx[i]
                    /#/ a load of what the header loads, in a loop that writes nothing, is that load
                    if o == int(Op.Load) && !load_blocked(f, i, mem, memf, memn, memw) && b != h && f.fwd[i] < 0:
                        let j = f.bfirst[h]
                        let found = -1
                        while j >= 0 && found < 0:
                            if f.op[j] == int(Op.Load) && f.fwd[j] < 0 && f.rep[j] == f.rep[i] && f.ty[j] == f.ty[i] && f.follow(f.a[j]) == f.follow(f.a[i]):
                                found = j
                            j = f.nx[j]
                        /#/ or the last load of it in the block that enters the loop, if nothing writes after it
                        if found < 0 && pre0 >= 0:
                            let q = f.blast[pre0]
                            while q >= 0 && found < 0 && !writes_memory(f, q):
                                if f.op[q] == int(Op.Load) && f.fwd[q] < 0 && f.rep[q] == f.rep[i] && f.ty[q] == f.ty[i] && f.follow(f.a[q]) == f.follow(f.a[i]):
                                    found = q
                                q = f.pv[q]
                        if found >= 0:
                            replace_inst(f, i, found)
                            changed = true
                            i = nxt
                            continue
                    if o == int(Op.Load) && f.fwd[i] < 0 && !load_blocked(f, i, mem, memf, memn, memw) && b != h && deref_ok(f, f.a[i]):
                        /#/ a read through a reference parameter cannot fault, so it may run before the loop is known to be entered;
                        /#/ one equal to a load already moved is that load
                        let same = -1
                        for rr in 0..n:
                            let j = list[rr]
                            if same < 0 && f.op[j] == int(Op.Load) && f.rep[j] == f.rep[i] && f.ty[j] == f.ty[i] && f.follow(f.a[j]) == f.follow(f.a[i]):
                                same = j
                        if same >= 0:
                            replace_inst(f, i, same)
                            changed = true
                            i = nxt
                            continue
                        if f.blk[f.follow(f.a[i])] < 0 || inl[f.blk[f.follow(f.a[i])]] == 0:
                            moved[i] = 1
                            list[n] = i
                            n = n + 1
                            i = nxt
                            continue
                    if f.fwd[i] < 0 && (pure_op(o) || (o == int(Op.Load) && !load_blocked(f, i, mem, memf, memn, memw) && b == h)):
                        let ok = true
                        for u in 0..f.nval(i):
                            let v = f.val_at(i, u)
                            if v >= 0:
                                let x = f.follow(v)
                                if f.blk[x] >= 0 && inl[f.blk[x]] == 1 && moved[x] == 0:
                                    ok = false
                        if ok:
                            moved[i] = 1
                            list[n] = i
                            n = n + 1
                    i = f.nx[i]
        prev = n
        if n == 0:
            continue
        /#/ the block to move them to
        let outs = 0
        let oe = -1
        for e in 0..f.ne:
            let to = f.eto[e]
            if to == h:
                let fb = f.efrom[e]
                if fb >= 0 && fb < nb && inl[fb] == 0 && idom[fb] >= 0:
                    outs = outs + 1
                    oe = e
        if outs == 0:
            continue
        let pre = -1
        if outs == 1 && f.op[f.blast[f.efrom[oe]]] == int(Op.Br):
            pre = f.efrom[oe]
        else:
            let keep = f.cur
            pre = f.new_block()
            f.set_block(pre)
            let p = f.pfirst[h]
            while p >= 0:
                let q = f.param(pre, f.rep[p], f.ty[p])
                f.arg(q)
                p = f.nx[p]
            f.br(h)
            f.set_block(keep)
            for e in 0..f.ne - 1:
                if f.eto[e] == h:
                    let fb = f.efrom[e]
                    if fb >= 0 && fb < nb && inl[fb] == 0 && idom[fb] >= 0:
                        f.eto[e] = pre
            return true
        let t = f.blast[pre]
        for r in 0..n:
            let i = list[r]
            unlink(f, i)
            f.blk[i] = pre
            f.pv[i] = f.pv[t]
            f.nx[i] = t
            if f.pv[t] >= 0:
                f.nx[f.pv[t]] = i
            else:
                f.bfirst[pre] = i
            f.pv[t] = i
        changed = true
    return changed

/#/ ---- vectorization ----------------------------------------------------------

/#/ What a loop that can be done a vector at a time was found to be made of.
class VCtx:
    ok: bool
    /#/ the element kind: 0 f32, 1 f64, 2 i8, 3 i16, 4 i32, 5 i64
    lane: int
    /#/ the program: postfix tokens `code | arg << 8` (1 load of buffer arg, 2 invariant arg, 3 operation arg, 4 store to buffer arg)
    prog: buf<int>
    np: int
    ptrs: buf<int>
    nptr: int
    invs: buf<int>
    ninv: int
    depth: int
    stores: int
    /#/ the place of each instruction in the loop's order, and the place of the last store so far: a load before it
    /#/ cannot be done again after it
    seq: buf<int>
    minseq: int

fn new_vctx(lane: int, ni: int) => VCtx:
    return VCtx { ok: true, lane: lane, prog: new_buf(int, 64), np: 0, ptrs: new_buf(int, 8), nptr: 0, invs: new_buf(int, 8), ninv: 0, depth: 0, stores: 0, seq: new_buf(int, ni + 1), minseq: -1 }

/#/ The element kind of a value of representation `r`, -1 for none.
fn v_lane_of(r: int) => int:
    if r == int(Rp.F32):
        return 0
    if r == int(Rp.F64):
        return 1
    if r == int(Rp.I8):
        return 2
    if r == int(Rp.I16):
        return 3
    if r == int(Rp.I32):
        return 4
    if r == int(Rp.I64):
        return 5
    return -1

fn v_elem_rep(lane: int) => int:
    if lane == 0:
        return int(Rp.F32)
    if lane == 1:
        return int(Rp.F64)
    if lane == 2:
        return int(Rp.I8)
    if lane == 3:
        return int(Rp.I16)
    if lane == 4:
        return int(Rp.I32)
    return int(Rp.I64)

fn v_elem_size(lane: int) => int:
    if lane == 0 || lane == 4:
        return 4
    if lane == 1 || lane == 5:
        return 8
    if lane == 2:
        return 1
    return 2

fn v_push(c: &VCtx, code: int, arg: int) => void:
    if c.np >= len(c.prog):
        c.prog = buf_resize(c.prog, c.np * 2)
    c.prog[c.np] = code | (arg << 8)
    c.np = c.np + 1

fn v_outside(f: &Fun, inl: &buf<int>, v: int) => bool:
    return f.blk[v] < 0 || inl[f.blk[v]] == 0

/#/ Adds the program of the value `v0`.
fn v_emit(c: &VCtx, f: &Fun, inl: &buf<int>, iv: int, v0: int) => void:
    if !c.ok:
        return
    let v = f.follow(v0)
    let o = f.op[v]
    if v_outside(f, inl, v):
        let r = f.rep[v]
        let good = false
        if c.lane <= 1:
            good = r == v_elem_rep(c.lane)
        else:
            good = rp_is_int(r)
        if !good:
            c.ok = false
            return
        let j = 0
        while j < c.ninv && c.invs[j] != v:
            j = j + 1
        if j == c.ninv:
            if j >= 8:
                c.ok = false
                return
            c.invs[j] = v
            c.ninv = j + 1
        v_push(c, 2, j)
        c.depth = c.depth + 1
    elif o == int(Op.Load):
        let a = f.follow(f.a[v])
        if f.op[a] != int(Op.Index) || f.follow(f.b[a]) != iv || f.aux[a] != v_elem_size(c.lane) || f.rep[v] != v_elem_rep(c.lane):
            c.ok = false
            return
        let base = f.follow(f.a[a])
        if !v_outside(f, inl, base) || c.seq[v] < c.minseq:
            c.ok = false
            return
        let k = 0
        while k < c.nptr && c.ptrs[k] != base:
            k = k + 1
        if k == c.nptr:
            if k >= 7:
                c.ok = false
                return
            c.ptrs[k] = base
            c.nptr = k + 1
        v_push(c, 1, k)
        c.depth = c.depth + 1
    elif (o == int(Op.ZExt) || o == int(Op.SExt)) && c.lane >= 2 && c.lane <= 4:
        let x = f.follow(f.a[v])
        if f.op[x] != int(Op.Load) || v_outside(f, inl, x):
            c.ok = false
            return
        v_emit(c, f, inl, iv, x)
    else:
        let op = -1
        if c.lane <= 1:
            if f.rep[v] == v_elem_rep(c.lane):
                if o == int(Op.FAdd):
                    op = 0
                elif o == int(Op.FSub):
                    op = 1
                elif o == int(Op.FMul):
                    op = 2
                elif o == int(Op.FDiv):
                    op = 3
        elif f.rep[v] == int(Rp.I64):
            if o == int(Op.Add):
                op = 0
            elif o == int(Op.Sub):
                op = 1
            elif o == int(Op.Mul) && c.lane == 3:
                op = 2
            elif o == int(Op.And):
                op = 4
            elif o == int(Op.Or):
                op = 5
            elif o == int(Op.Xor):
                op = 6
        if op < 0:
            c.ok = false
            return
        v_emit(c, f, inl, iv, f.a[v])
        v_emit(c, f, inl, iv, f.b[v])
        v_push(c, 3, op)
        c.depth = c.depth - 1
    if c.depth > 6:
        c.ok = false

/#/ Is the loop headed by `h` one that can be done a vector at a time? A loop `for i in a..n` of one store to
/#/ `buf[i]` whose value is made of loads `buf[i]`, loop invariants and plain arithmetic, entered by a plain
/#/ jump. Then a vector loop goes in front of it: when `n` is within the length of every buffer checked, it
/#/ does as many elements as it can, a vector at a time, and the loop goes on with the rest (and fails the
/#/ check where it would have). Returns whether it changed anything; the loop is looked at once.
fn vectorize(f: &Fun) => bool:
    if f.nb < 3:
        return false
    let nb = f.nb
    let rpo: buf<int> = new_buf(int, nb + 1)
    let idom: buf<int> = new_buf(int, nb + 1)
    let pc: buf<int> = new_buf(int, nb + 2)
    let pl: buf<int> = new_buf(int, f.ne + 1)
    let np = dominators(f, &rpo, &idom, &pc, &pl)
    let inl: buf<int> = new_buf(int, nb + 1)
    let work: buf<int> = new_buf(int, nb + 1)
    for k in 1..np:
        let h = rpo[k]
        let hterm = f.blast[h]
        if hterm < 0 || f.op[hterm] != int(Op.CondBr) || (f.npar[h] != 1 && f.npar[h] != 2):
            continue
        /#/ the counter, and with a second parameter the accumulator of a reduction
        let iv = f.pfirst[h]
        let acc = -1
        let ipos = 0
        if f.npar[h] == 2:
            let c0 = f.follow(f.a[hterm])
            if f.op[c0] != int(Op.Cmp):
                continue
            let x0 = f.follow(f.a[c0])
            if x0 == f.nx[f.pfirst[h]]:
                iv = x0
                acc = f.pfirst[h]
                ipos = 1
            elif x0 == f.pfirst[h]:
                acc = f.nx[iv]
            if acc < 0 || f.rep[acc] != int(Rp.I64):
                continue
        if f.rep[iv] != int(Rp.I64):
            continue
        /#/ the loop
        let nw = 0
        for q in 0..nb:
            inl[q] = 0
        inl[h] = 1
        for q in pc[h]..pc[h + 1]:
            let t = pl[q]
            let y = t
            while y != h && y != 0 && idom[y] >= 0 && idom[y] != y:
                y = idom[y]
            if y == h && inl[t] == 0:
                inl[t] = 1
                work[nw] = t
                nw = nw + 1
        if nw == 0:
            continue
        while nw > 0:
            nw = nw - 1
            let b = work[nw]
            for q in pc[b]..pc[b + 1]:
                let t = pl[q]
                if inl[t] == 0 && idom[t] >= 0:
                    inl[t] = 1
                    work[nw] = t
                    nw = nw + 1
        /#/ the test `i < n` with the body on the true side
        let et = f.b[hterm]
        let ef = f.c[hterm]
        if f.eto[et] < 0 || f.eto[ef] < 0 || inl[f.eto[et]] == 0 || inl[f.eto[ef]] == 1:
            continue
        let cmpv = f.follow(f.a[hterm])
        if f.op[cmpv] != int(Op.Cmp) || f.aux[cmpv] != int(Pr.SLt) || f.follow(f.a[cmpv]) != iv:
            continue
        let n = f.follow(f.b[cmpv])
        if !v_outside(f, &inl, n):
            continue
        let ok = true
        let i = f.bfirst[h]
        while i >= 0:
            if i != hterm && i != cmpv:
                ok = false
            i = f.nx[i]
        if !ok:
            continue
        /#/ one entry from outside, a plain jump; one jump back, with i + 1
        let e0 = -1
        let n0 = 0
        let nlatch = 0
        let inext = -1
        let anext = -1
        let acc0 = -1
        let apos = 1 - ipos
        for e in 0..f.ne:
            if f.eto[e] == h && f.efrom[e] >= 0 && f.efrom[e] < nb:
                let fb = f.efrom[e]
                let tt = f.blast[fb]
                if inl[fb] == 1:
                    nlatch = nlatch + 1
                    if tt < 0 || f.op[tt] != int(Op.Br) || f.aux[tt] != e || f.eargn[e] != f.npar[h]:
                        ok = false
                    else:
                        inext = f.follow(f.pool[f.eargs[e] + ipos])
                        if acc >= 0:
                            anext = f.follow(f.pool[f.eargs[e] + apos])
                elif idom[fb] >= 0:
                    n0 = n0 + 1
                    e0 = e
                    if tt < 0 || f.op[tt] != int(Op.Br) || f.aux[tt] != e || f.eargn[e] != f.npar[h]:
                        ok = false
                    elif acc >= 0:
                        acc0 = f.follow(f.pool[f.eargs[e] + apos])
        if !ok || n0 != 1 || nlatch != 1:
            continue
        if f.op[inext] != int(Op.Add) || f.follow(f.a[inext]) != iv || !f.is_const(f.follow(f.b[inext])) || f.cval(f.follow(f.b[inext])) != 1:
            continue
        /#/ a reduction: the accumulator becomes `acc op e1 op e2 ...` (op: + - ^ | &; a chain of one operation, each
        /#/ link used once), and nothing else in the loop reads it
        let rk = 0
        let chain: buf<int> = new_buf(int, 6)
        let nch = 0
        let terms: buf<int> = new_buf(int, 6)
        let nt = 0
        if acc >= 0:
            if v_outside(f, &inl, anext) || f.rep[anext] != int(Rp.I64):
                continue
            let ro = f.op[anext]
            if ro == int(Op.Add):
                rk = 1
            elif ro == int(Op.Sub):
                rk = 2
            elif ro == int(Op.Xor):
                rk = 3
            elif ro == int(Op.Or):
                rk = 4
            elif ro == int(Op.And):
                rk = 5
            if rk == 0:
                continue
            let cur = anext
            let found = false
            let bad = false
            while !found && !bad:
                chain[nch] = cur
                nch = nch + 1
                let ca = f.follow(f.a[cur])
                let cb = f.follow(f.b[cur])
                if ca == acc:
                    terms[nt] = cb
                    nt = nt + 1
                    found = true
                elif cb == acc && rk != 2:
                    terms[nt] = ca
                    nt = nt + 1
                    found = true
                elif rk != 2 && nch < 5 && f.op[ca] == ro && f.uses[ca] == 1 && !v_outside(f, &inl, ca):
                    terms[nt] = cb
                    nt = nt + 1
                    cur = ca
                elif rk != 2 && nch < 5 && f.op[cb] == ro && f.uses[cb] == 1 && !v_outside(f, &inl, cb):
                    terms[nt] = ca
                    nt = nt + 1
                    cur = cb
                else:
                    bad = true
            if bad:
                continue
            for q in 0..nt:
                if terms[q] == acc:
                    ok = false
            for b in 0..nb:
                if inl[b] == 1:
                    let j = f.bfirst[b]
                    while j >= 0:
                        let inchain = false
                        for q in 0..nch:
                            if chain[q] == j:
                                inchain = true
                        if !inchain:
                            for q in 0..f.nval(j):
                                if f.val_at(j, q) >= 0 && f.follow(f.val_at(j, q)) == acc:
                                    ok = false
                        j = f.nx[j]
            if !ok:
                continue
        /#/ the body: plain instructions, checks of i against a length outside, one store
        let sts: buf<int> = new_buf(int, 4)
        let nstore = 0
        let checks: buf<int> = new_buf(int, 8)
        let nchk = 0
        let seq: buf<int> = new_buf(int, f.ni + 1)
        let sn = 0
        for r in 0..np:
            if inl[rpo[r]] == 1:
                let j = f.bfirst[rpo[r]]
                while j >= 0:
                    seq[j] = sn
                    sn = sn + 1
                    j = f.nx[j]
        for b in 0..nb:
            if inl[b] == 1 && b != h && ok:
                let j = f.bfirst[b]
                while j >= 0 && ok:
                    let o = f.op[j]
                    if o == int(Op.Store):
                        if nstore >= 4:
                            ok = false
                        else:
                            sts[nstore] = j
                            nstore = nstore + 1
                    elif o == int(Op.CondBr):
                        let cc = f.follow(f.a[j])
                        if f.op[cc] != int(Op.Cmp) || f.aux[cc] != int(Pr.ULt) || f.follow(f.a[cc]) != iv:
                            ok = false
                        else:
                            let l = f.follow(f.b[cc])
                            if !v_outside(f, &inl, l) || nchk >= 4:
                                ok = false
                            else:
                                let q = 0
                                while q < nchk && checks[q] != l:
                                    q = q + 1
                                if q == nchk:
                                    checks[q] = l
                                    nchk = nchk + 1
                        /#/ the other way is a failed check, which makes nothing the loop could be asked for
                        for s in 0..2:
                            let to = f.eto[f.succ_edge(b, s)]
                            if to >= 0 && inl[to] == 0:
                                let tb = f.blast[to]
                                if tb < 0 || f.op[tb] != int(Op.Unreachable):
                                    ok = false
                                let u = f.bfirst[to]
                                while u >= 0:
                                    for q in 0..f.nval(u):
                                        let x = f.val_at(u, q)
                                        if x >= 0 && !v_outside(f, &inl, f.follow(x)):
                                            ok = false
                                    u = f.nx[u]
                    elif o == int(Op.Br):
                        let nothing = 0
                    elif !(o == int(Op.Cmp) || o == int(Op.Index) || o == int(Op.Load) || o == int(Op.ZExt) || o == int(Op.SExt) || o == int(Op.Trunc) || o == int(Op.Add) || o == int(Op.Sub) || o == int(Op.Mul) || o == int(Op.And) || o == int(Op.Or) || o == int(Op.Xor) || o == int(Op.FAdd) || o == int(Op.FSub) || o == int(Op.FMul) || o == int(Op.FDiv)):
                        ok = false
                    j = f.nx[j]
        if !ok || (nstore < 1 && rk == 0) || (nstore > 0 && rk > 0):
            continue
        /#/ the stores in the order they run
        for x in 1..nstore:
            let y = x
            while y > 0 && seq[sts[y - 1]] > seq[sts[y]]:
                let tmp = sts[y]
                sts[y] = sts[y - 1]
                sts[y - 1] = tmp
                y = y - 1
        /#/ the program of each stored value
        let lane = 5
        if rk == 0:
            lane = v_lane_of(f.rep[f.follow(f.b[sts[0]])])
        if lane < 0:
            continue
        let c = new_vctx(lane, f.ni)
        for q in 0..f.ni:
            c.seq[q] = seq[q]
        for x in 0..nstore:
            let store = sts[x]
            let sa = f.follow(f.a[store])
            let sv = f.follow(f.b[store])
            if v_lane_of(f.rep[sv]) != lane || f.op[sa] != int(Op.Index) || f.follow(f.b[sa]) != iv || f.aux[sa] != v_elem_size(lane):
                c.ok = false
                break
            let sbase = f.follow(f.a[sa])
            if !v_outside(f, &inl, sbase):
                c.ok = false
                break
            c.minseq = -1
            if x > 0:
                c.minseq = seq[sts[x - 1]]
            if lane >= 2 && lane <= 4:
                if f.op[sv] != int(Op.Trunc):
                    c.ok = false
                    break
                v_emit(&c, f, &inl, iv, f.a[sv])
            else:
                v_emit(&c, f, &inl, iv, sv)
            if !c.ok || c.depth != 1:
                c.ok = false
                break
            let ks = 0
            while ks < c.nptr && c.ptrs[ks] != sbase:
                ks = ks + 1
            if ks == c.nptr:
                if ks >= 7:
                    c.ok = false
                    break
                c.ptrs[ks] = sbase
                c.nptr = ks + 1
            v_push(&c, 4, ks)
            c.depth = 0
        if rk > 0:
            c.minseq = -1
            let bop = 0
            if rk == 3:
                bop = 6
            elif rk == 4:
                bop = 5
            elif rk == 5:
                bop = 4
            for q in 0..nt:
                v_emit(&c, f, &inl, iv, terms[q])
                if q > 0:
                    v_push(&c, 3, bop)
                    c.depth = c.depth - 1
            if c.depth != 1:
                c.ok = false
        if !c.ok:
            continue
        /#/ with several stores, a buffer may be seen through a second pointer to it: only the headers of
        /#/ buffers that are reference parameters are known not to be offset views of each other
        if nstore > 1:
            for q in 0..c.nptr:
                let bq = c.ptrs[q]
                if f.op[bq] != int(Op.Load) || !deref_ok(f, f.a[bq]) || f.op[f.follow(f.a[bq])] != int(Op.Param):
                    ok = false
        /#/ nothing the loop makes is used after it (but i)
        for b in 0..nb:
            if inl[b] == 0:
                let j = f.bfirst[b]
                while j >= 0:
                    for q in 0..f.nval(j):
                        let x = f.val_at(j, q)
                        if x >= 0 && !v_outside(f, &inl, f.follow(x)) && f.follow(x) != iv && f.follow(x) != acc:
                            ok = false
                    j = f.nx[j]
        for e in 0..f.ne:
            if f.eto[e] >= 0 && f.efrom[e] >= 0 && f.efrom[e] < nb:
                for q in 0..f.eargn[e]:
                    let x = f.follow(f.pool[f.eargs[e] + q])
                    if inl[f.efrom[e]] == 0 || inl[f.eto[e]] == 0:
                        if !v_outside(f, &inl, x) && x != iv && x != acc && !(inl[f.efrom[e]] == 1 && inl[f.eto[e]] == 1):
                            ok = false
        if !ok:
            continue
        /#/ the entry: the checks, then the vector loop or the scalar one
        let pre = f.efrom[e0]
        let t = f.blast[pre]
        let i0 = f.follow(f.pool[f.eargs[e0] + ipos])
        let okv = -1
        for q in 0..nchk:
            f.set_block(pre)
            let cm = f.raw(int(Op.Cmp), int(Rp.I8), -1, n, checks[q], -1, int(Pr.SLe))
            link_before(f, cm, t)
            if okv < 0:
                okv = cm
            else:
                f.set_block(pre)
                let an = f.raw(int(Op.And), int(Rp.I8), -1, okv, cm, -1, 0)
                link_before(f, an, t)
                okv = an
        let vb = f.new_block()
        f.set_block(vb)
        let sl = -1
        if rk > 0:
            /#/ the accumulator goes through a slot of the frame: the loop reads it and writes the new value
            sl = f.slot(8)
            f.store(sl, acc0)
            f.arg(sl)
        f.arg(i0)
        f.arg(n)
        for q in 0..c.nptr:
            f.arg(c.ptrs[q])
        for q in 0..c.ninv:
            f.arg(c.invs[q])
        for q in 0..c.np:
            f.arg(f.cint(int(Rp.I64), c.prog[q]))
        let vl = f.vloop(lane | (rk << 4), c.nptr | (c.ninv << 8) | (c.np << 16))
        let accv = -1
        if rk > 0:
            accv = f.load(int(Rp.I64), -1, sl)
        if rk > 0 && ipos == 1:
            f.arg(accv)
        f.arg(vl)
        if rk > 0 && ipos == 0:
            f.arg(accv)
        f.br(h)
        unlink(f, t)
        f.set_block(pre)
        if okv < 0:
            cut_edge(f, e0)
            f.br(vb)
        else:
            let e1 = f.mk_edge(vb)
            f.condbr(okv, e1, e0)
        recount_uses(f)
        return true
    return false

/#/ ---- loop inversion ----------------------------------------------------------

/#/ The value `v` as seen from the end of a block that jumps to the loop header along edge `e`: a header
/#/ parameter is the edge's argument, a header instruction already copied is its copy.
fn inv_val(f: &Fun, v0: int, hpv: &buf<int>, nh: int, e: int, ks: &buf<int>, kd: &buf<int>, nk: int) => int:
    if v0 < 0:
        return v0
    let v = f.follow(v0)
    for q in 0..nh:
        if hpv[q] == v:
            return f.follow(f.pool[f.eargs[e] + q])
    for q in 0..nk:
        if ks[q] == v:
            return kd[q]
    return v

/#/ Replaces the jump `t` (along `e`) to a loop header by the header's test: copies of the header's
/#/ instructions, then a branch to the header along `e` when the test holds, else to `x` with `xa` as
/#/ the arguments of the exit (those of the old exit edge, then the header parameters used after the loop).
fn inv_site(f: &Fun, t: int, e: int, hterm: int, hpv: &buf<int>, nh: int, hi: &buf<int>, nhi: int, x: int, xa: &buf<int>, nxa: int, xp: &buf<int>, nxp: int, body_true: bool) => void:
    let blk = f.blk[t]
    let ks: buf<int> = new_buf(int, nhi + 1)
    let kd: buf<int> = new_buf(int, nhi + 1)
    for q in 0..nhi:
        let ins = hi[q]
        let a = inv_val(f, f.a[ins], hpv, nh, e, &ks, &kd, q)
        let b = inv_val(f, f.b[ins], hpv, nh, e, &ks, &kd, q)
        let c = inv_val(f, f.c[ins], hpv, nh, e, &ks, &kd, q)
        f.set_block(blk)
        let nw = f.raw(f.op[ins], f.rep[ins], f.ty[ins], a, b, c, f.aux[ins])
        link_before(f, nw, t)
        ks[q] = ins
        kd[q] = nw
    let cond = inv_val(f, f.a[hterm], hpv, nh, e, &ks, &kd, nhi)
    unlink(f, t)
    f.set_block(blk)
    for q in 0..nxa:
        f.arg(inv_val(f, xa[q], hpv, nh, e, &ks, &kd, nhi))
    for q in 0..nxp:
        f.arg(inv_val(f, hpv[xp[q]], hpv, nh, e, &ks, &kd, nhi))
    let e2 = f.mk_edge(x)
    if body_true:
        f.condbr(cond, e, e2)
    else:
        f.condbr(cond, e2, e)

/#/ A loop whose test is at the top (`while c` / `for`) is entered through the test and its body runs
/#/ only when the test held, so nothing in the body can be moved in front of the loop. Copying the test
/#/ in front of the loop and at each jump back makes the body the loop proper: its loads of what the loop
/#/ does not change can then be hoisted. Done for one loop that has such a load (and whose test is a
/#/ few plain instructions, with a single exit that nothing else enters); returns whether it did.
fn invert_loops(f: &Fun) => bool:
    if f.nb < 3:
        return false
    let nb = f.nb
    let rpo: buf<int> = new_buf(int, nb + 1)
    let idom: buf<int> = new_buf(int, nb + 1)
    let pc: buf<int> = new_buf(int, nb + 2)
    let pl: buf<int> = new_buf(int, f.ne + 1)
    let np = dominators(f, &rpo, &idom, &pc, &pl)
    let inl: buf<int> = new_buf(int, nb + 1)
    let work: buf<int> = new_buf(int, nb + 1)
    for k in 1..np:
        let h = rpo[k]
        let hterm = f.blast[h]
        if hterm < 0 || f.op[hterm] != int(Op.CondBr):
            continue
        /#/ the loop: the header and what reaches a jump back to it
        let nw = 0
        for q in 0..nb:
            inl[q] = 0
        inl[h] = 1
        for q in pc[h]..pc[h + 1]:
            let t = pl[q]
            let y = t
            while y != h && y != 0 && idom[y] >= 0 && idom[y] != y:
                y = idom[y]
            if y == h && inl[t] == 0:
                inl[t] = 1
                work[nw] = t
                nw = nw + 1
        if nw == 0:
            continue
        while nw > 0:
            nw = nw - 1
            let b = work[nw]
            for q in pc[b]..pc[b + 1]:
                let t = pl[q]
                if inl[t] == 0 && idom[t] >= 0:
                    inl[t] = 1
                    work[nw] = t
                    nw = nw + 1
        /#/ one way stays in the loop, the other leaves it to a block nothing else enters
        let et = f.b[hterm]
        let ef = f.c[hterm]
        if f.eto[et] < 0 || f.eto[ef] < 0:
            continue
        let in_t = inl[f.eto[et]] == 1
        let in_f = inl[f.eto[ef]] == 1
        if in_t == in_f:
            continue
        let ex = ef
        if !in_t:
            ex = et
        let x = f.eto[ex]
        if x == h || x == 0 || f.eargn[ex] != f.npar[x]:
            continue
        let nin = 0
        for e in 0..f.ne:
            if f.eto[e] == x:
                nin = nin + 1
        if nin != 1:
            continue
        /#/ the test: plain instructions only, a few
        let hi: buf<int> = new_buf(int, 8)
        let nhi = 0
        let ok = true
        let i = f.bfirst[h]
        while i >= 0 && ok:
            if i != hterm:
                if f.fwd[i] < 0:
                    if !pure_op(f.op[i]) || f.c[i] >= 0 && f.nval(i) > 3 || nhi >= 6:
                        ok = false
                    else:
                        hi[nhi] = i
                        nhi = nhi + 1
            i = f.nx[i]
        if !ok:
            continue
        /#/ the entries: one from outside ending in a plain jump, the jumps back plain too
        let e0 = -1
        let n0 = 0
        let nlatch = 0
        for e in 0..f.ne:
            if f.eto[e] == h && f.efrom[e] >= 0 && f.efrom[e] < nb:
                let fb = f.efrom[e]
                let tt = f.blast[fb]
                if inl[fb] == 1:
                    nlatch = nlatch + 1
                    if tt < 0 || f.op[tt] != int(Op.Br) || f.aux[tt] != e:
                        ok = false
                elif idom[fb] >= 0:
                    n0 = n0 + 1
                    e0 = e
                    if tt < 0 || f.op[tt] != int(Op.Br) || f.aux[tt] != e:
                        ok = false
        if !ok || n0 != 1 || nlatch == 0 || f.eargn[e0] != f.npar[h]:
            continue
        /#/ other ways out of the loop lead to a failed check only, which uses nothing the loop makes
        for b in 0..nb:
            if inl[b] == 1 && b != h && ok:
                for s in 0..f.nsucc(b):
                    let to = f.eto[f.succ_edge(b, s)]
                    if to >= 0 && inl[to] == 0:
                        let tb = f.blast[to]
                        if tb < 0 || f.op[tb] != int(Op.Unreachable):
                            ok = false
                        let j = f.bfirst[to]
                        while j >= 0:
                            for q in 0..f.nval(j):
                                let v = f.val_at(j, q)
                                if v >= 0 && f.blk[f.follow(v)] >= 0 && inl[f.blk[f.follow(v)]] == 1:
                                    ok = false
                            j = f.nx[j]
        if !ok:
            continue
        /#/ worth it: a load of something the loop does not change, in the body, that is not yet hoistable
        let mem = false
        let memf = false
        let memn = false
        let memw = false
        for b in 0..nb:
            if inl[b] == 1:
                let j = f.bfirst[b]
                while j >= 0:
                    if writes_memory(f, j):
                        let sc = store_class(f, j)
                        if sc == 1:
                            memf = true
                        elif sc == 2:
                            memn = true
                        elif sc == 3:
                            memw = true
                        else:
                            mem = true
                    j = f.nx[j]
        let gain = false
        for b in 0..nb:
            if inl[b] == 1 && b != h:
                let j = f.bfirst[b]
                while j >= 0:
                    if f.op[j] == int(Op.Load) && f.fwd[j] < 0 && !load_blocked(f, j, mem, memf, memn, memw) && !deref_ok(f, f.a[j]):
                        let ad = f.follow(f.a[j])
                        if f.blk[ad] < 0 || inl[f.blk[ad]] == 0:
                            gain = true
                    j = f.nx[j]
        if !gain:
            continue
        /#/ what the loop makes that is used after it: header instructions stop the transformation,
        /#/ header parameters get a parameter of the exit block
        let hpv: buf<int> = new_buf(int, f.npar[h] + 1)
        let nh = 0
        let pp = f.pfirst[h]
        while pp >= 0:
            hpv[nh] = pp
            nh = nh + 1
            pp = f.nx[pp]
        let used: buf<int> = new_buf(int, nh + 1)
        for b in 0..nb:
            if inl[b] == 0:
                let j = f.bfirst[b]
                while j >= 0:
                    for q in 0..f.nval(j):
                        let v = f.val_at(j, q)
                        if v >= 0:
                            let y = f.follow(v)
                            for r in 0..nh:
                                if hpv[r] == y:
                                    used[r] = 1
                            for r in 0..nhi:
                                if hi[r] == y:
                                    ok = false
                    j = f.nx[j]
        for e in 0..f.ne:
            if f.eto[e] >= 0 && f.efrom[e] >= 0 && f.efrom[e] < nb && inl[f.efrom[e]] == 0:
                for q in 0..f.eargn[e]:
                    let y = f.follow(f.pool[f.eargs[e] + q])
                    for r in 0..nh:
                        if hpv[r] == y:
                            used[r] = 1
                    for r in 0..nhi:
                        if hi[r] == y:
                            ok = false
        if !ok:
            continue
        let xp: buf<int> = new_buf(int, nh + 1)
        let nxp = 0
        for r in 0..nh:
            if used[r] == 1:
                xp[nxp] = r
                nxp = nxp + 1
        /#/ the exit's own arguments, as the header passed them
        let nxa = f.eargn[ex]
        let xa: buf<int> = new_buf(int, nxa + 1)
        for q in 0..nxa:
            xa[q] = f.follow(f.pool[f.eargs[ex] + q])
        /#/ new parameters of the exit block for the header parameters used after the loop
        let xnew: buf<int> = new_buf(int, nxp + 1)
        for q in 0..nxp:
            xnew[q] = f.param(x, f.rep[hpv[xp[q]]], f.ty[hpv[xp[q]]])
        /#/ the jumps to the header
        let sites: buf<int> = new_buf(int, nlatch + 2)
        let ns = 0
        for e in 0..f.ne:
            if f.eto[e] == h && f.efrom[e] >= 0 && f.efrom[e] < nb && (inl[f.efrom[e]] == 1 || e == e0):
                sites[ns] = e
                ns = ns + 1
        for q in 0..ns:
            let e = sites[q]
            inv_site(f, f.blast[f.efrom[e]], e, hterm, &hpv, nh, &hi, nhi, x, &xa, nxa, &xp, nxp, in_t)
        /#/ the header now falls into the body
        let body = et
        if !in_t:
            body = ef
        unuse(f, hterm)
        cut_edge(f, ex)
        f.op[hterm] = int(Op.Br)
        f.aux[hterm] = body
        f.a[hterm] = -1
        f.b[hterm] = -1
        f.c[hterm] = -1
        /#/ after the loop, the header parameters are the exit block's
        for b in 0..nb:
            if inl[b] == 0:
                let j = f.bfirst[b]
                while j >= 0:
                    for q in 0..f.nval(j):
                        let v = f.val_at(j, q)
                        if v >= 0:
                            let y = f.follow(v)
                            for r in 0..nxp:
                                if hpv[xp[r]] == y:
                                    f.set_val_at(j, q, xnew[r])
                    j = f.nx[j]
        for e in 0..f.ne:
            if f.eto[e] >= 0 && f.efrom[e] >= 0 && f.efrom[e] < nb && inl[f.efrom[e]] == 0 && f.eto[e] != x:
                for q in 0..f.eargn[e]:
                    let y = f.follow(f.pool[f.eargs[e] + q])
                    for r in 0..nxp:
                        if hpv[xp[r]] == y:
                            f.pool[f.eargs[e] + q] = xnew[r]
        recount_uses(f)
        return true
    return false

/#/ ---- block order -------------------------------------------------------------

/#/ An order of the blocks, in `ord` (all `nb` blocks): reverse post-order; with `rotate`, a loop's
/#/ header moved after its last block (the test is at the bottom, entered by one jump); and the blocks
/#/ that end in `unreachable` (the failed checks) at the end so the likely way is the fall-through.
fn block_order(f: &Fun, ord: &buf<int>, rotate: bool) => void:
    let nb = f.nb
    let rpo: buf<int> = new_buf(int, nb + 1)
    let idom: buf<int> = new_buf(int, nb + 1)
    let pc: buf<int> = new_buf(int, nb + 2)
    let pl: buf<int> = new_buf(int, f.ne + 1)
    let np = dominators(f, &rpo, &idom, &pc, &pl)
    let seen: buf<int> = new_buf(int, nb + 1)
    let hot: buf<int> = new_buf(int, nb + 1)
    let nh = 0
    for k in 0..np:
        let b = rpo[k]
        seen[b] = 1
        let t = f.blast[b]
        if k > 0 && t >= 0 && f.op[t] == int(Op.Unreachable):
            continue
        hot[nh] = b
        nh = nh + 1
    /#/ loops, outermost first (a header comes before the blocks it dominates in reverse post-order)
    let inl: buf<int> = new_buf(int, nb + 1)
    let work: buf<int> = new_buf(int, nb + 1)
    let rot: buf<int> = new_buf(int, nb + 1)
    for k in 1..np:
        let h = rpo[k]
        if rot[h] == 1 || !rotate:
            continue
        let t = f.blast[h]
        if t < 0 || f.op[t] != int(Op.CondBr):
            continue
        let nw = 0
        for q in 0..nb:
            inl[q] = 0
        inl[h] = 1
        for q in pc[h]..pc[h + 1]:
            let l = pl[q]
            let x = l
            while x != h && x != 0 && idom[x] >= 0 && idom[x] != x:
                x = idom[x]
            if x == h && inl[l] == 0:
                inl[l] = 1
                work[nw] = l
                nw = nw + 1
        if nw == 0:
            continue
        while nw > 0:
            nw = nw - 1
            let b = work[nw]
            for q in pc[b]..pc[b + 1]:
                let l = pl[q]
                if inl[l] == 0 && idom[l] >= 0:
                    inl[l] = 1
                    work[nw] = l
                    nw = nw + 1
        /#/ the last block of the loop in the order, and where the header is
        let last = -1
        let at = -1
        for q in 0..nh:
            if hot[q] == h:
                at = q
            if inl[hot[q]] == 1:
                last = q
        if at < 0 || last <= at:
            continue
        for q in at..last:
            hot[q] = hot[q + 1]
        hot[last] = h
        rot[h] = 1
    let n = 0
    for q in 0..nh:
        ord[n] = hot[q]
        n = n + 1
    for k in 1..np:
        let b = rpo[k]
        let t = f.blast[b]
        if t >= 0 && f.op[t] == int(Op.Unreachable):
            ord[n] = b
            n = n + 1
    for b in 0..nb:
        if seen[b] == 0:
            ord[n] = b
            n = n + 1

/#/ An `extract` of an aggregate that is now known to be built by `insert`s (a parameter that turned
/#/ out to be one value all along) becomes the value that was inserted.
fn fold_extracts(f: &Fun) => bool:
    let changed = false
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let nxt = f.nx[i]
            if f.op[i] == int(Op.Extract) && f.fwd[i] < 0:
                let g = f.follow(f.a[i])
                while f.op[g] == int(Op.Insert) && f.aux[g] != f.aux[i]:
                    g = f.follow(f.a[g])
                if f.op[g] == int(Op.Insert) && f.rep[f.follow(f.b[g])] == f.rep[i]:
                    let v = f.follow(f.b[g])
                    f.uses[v] = f.uses[v] + f.uses[i]
                    f.fwd[i] = v
                    unuse(f, i)
                    unlink(f, i)
                    changed = true
            i = nxt
    return changed

/#/ ---- aggregate loads -------------------------------------------------------

/#/ Puts the just-made `x` (at the end of its block) right before `i`.
fn link_before(f: &Fun, x: int, i: int) => void:
    unlink(f, x)
    let p = f.pv[i]
    f.blk[x] = f.blk[i]
    f.pv[x] = p
    f.nx[x] = i
    f.pv[i] = x
    if p >= 0:
        f.nx[p] = x
    else:
        f.bfirst[f.blk[i]] = x

/#/ A `load` of an aggregate that is only ever taken apart by `extract`s becomes a `load` of each
/#/ element (at the same place, so memory is read when it was); the copy to the frame goes.
fn split_loads(f: &Fun, rs: &Reps) => bool:
    let bad: buf<int> = new_buf(int, f.ni + 1)
    let base: buf<int> = new_buf(int, f.ni + 1)
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            for k in 0..f.nval(i):
                let v = f.val_at(i, k)
                if v >= 0:
                    let x = f.follow(v)
                    if f.op[x] == int(Op.Load) && f.rep[x] >= rp_first_agg() && !(f.op[i] == int(Op.Extract) && k == 0):
                        bad[x] = 1
            i = f.nx[i]
    for e in 0..f.ne:
        if f.eto[e] >= 0:
            for k in 0..f.eargn[e]:
                bad[f.follow(f.pool[f.eargs[e] + k])] = 1
    let any = false
    let el: buf<int> = new_buf(int, 16)
    let nel = 0
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let r = f.rep[i]
            if f.op[i] == int(Op.Load) && f.fwd[i] < 0 && r >= rp_first_agg() && bad[i] == 0:
                let n = rs.elems(r)
                let ok = n > 0
                for k in 0..n:
                    if rs.elem(r, k) >= rp_first_agg() || rs.elem(r, k) == int(Rp.Void):
                        ok = false
                if ok:
                    if nel + n > len(el):
                        el = buf_resize(el, (nel + n) * 2)
                    base[i] = nel + 1
                    f.cur = b
                    let p = f.follow(f.a[i])
                    for k in 0..n:
                        let a = p
                        let off = elem_off(rs, r, k)
                        if off != 0:
                            a = f.raw(int(Op.Field), int(Rp.Ptr), -1, p, -1, -1, off)
                            link_before(f, a, i)
                        let l = f.raw(int(Op.Load), rs.elem(r, k), -1, a, -1, -1, 0)
                        link_before(f, l, i)
                        el[nel + k] = l
                    nel = nel + n
                    any = true
            i = f.nx[i]
    if !any:
        return false
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let nxt = f.nx[i]
            if f.op[i] == int(Op.Extract) && f.fwd[i] < 0:
                let g = f.follow(f.a[i])
                if base[g] > 0:
                    let l = el[base[g] - 1 + f.aux[i]]
                    f.uses[l] = f.uses[l] + f.uses[i]
                    f.fwd[i] = l
                    unuse(f, i)
                    unlink(f, i)
            i = nxt
    return true

/#/ A `store` of an aggregate built by `insert`s of every element becomes a `store` of each element.
fn split_stores(f: &Fun, rs: &Reps) => bool:
    let any = false
    let vals: buf<int> = new_buf(int, 16)
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let nxt = f.nx[i]
            if f.op[i] == int(Op.Store) && f.fwd[i] < 0:
                let v = f.follow(f.b[i])
                let r = f.rep[v]
                if r >= rp_first_agg() && f.op[v] == int(Op.Insert):
                    let n = rs.elems(r)
                    if n > len(vals):
                        vals = buf_resize(vals, n * 2)
                    for k in 0..n:
                        vals[k] = -1
                    let g = v
                    while f.op[g] == int(Op.Insert):
                        let k = f.aux[g]
                        if k >= 0 && k < n && vals[k] < 0:
                            vals[k] = f.follow(f.b[g])
                        g = f.follow(f.a[g])
                    let ok = n > 0
                    for k in 0..n:
                        if vals[k] < 0 || rs.elem(r, k) >= rp_first_agg() || rs.elem(r, k) == int(Rp.Void) || f.rep[vals[k]] != rs.elem(r, k):
                            ok = false
                    if ok:
                        f.cur = b
                        let p = f.follow(f.a[i])
                        for k in 0..n:
                            let a = p
                            let off = elem_off(rs, r, k)
                            if off != 0:
                                a = f.raw(int(Op.Field), int(Rp.Ptr), -1, p, -1, -1, off)
                                link_before(f, a, i)
                            let st = f.raw(int(Op.Store), int(Rp.Void), -1, a, vals[k], -1, 0)
                            link_before(f, st, i)
                        delete_inst(f, i)
                        any = true
            i = nxt
    return any

/#/ ---- trap blocks ------------------------------------------------------------

/#/ Is block `b` only a call that does not return, ended by `unreachable` (a failed check)?
fn is_trap(f: &Fun, b: int) => bool:
    if b == 0 || f.npar[b] != 0:
        return false
    let c = f.bfirst[b]
    if c < 0 || f.op[c] != int(Op.CCall):
        return false
    let u = f.nx[c]
    return u >= 0 && f.op[u] == int(Op.Unreachable) && f.nx[u] < 0

fn same_trap(f: &Fun, b: int, c: int) => bool:
    let x = f.bfirst[b]
    let y = f.bfirst[c]
    if f.aux[x] != f.aux[y] || f.nval(x) != f.nval(y) || f.rep[x] != f.rep[y]:
        return false
    for k in 0..f.nval(x):
        if f.follow(f.val_at(x, k)) != f.follow(f.val_at(y, k)):
            return false
    return true

/#/ The failed checks of a function that make the same call are one block.
fn merge_traps(f: &Fun) => bool:
    let changed = false
    let canon: buf<int> = new_buf(int, f.nb + 1)
    let nc = 0
    for b in 1..f.nb:
        if is_trap(f, b):
            let into = -1
            for q in 0..nc:
                if into < 0 && same_trap(f, b, canon[q]):
                    into = canon[q]
            if into < 0:
                canon[nc] = b
                nc = nc + 1
            else:
                for e in 0..f.ne:
                    if f.eto[e] == b:
                        f.eto[e] = into
                        changed = true
    return changed

fn optimize(f: &Fun) => void:
    let rs = new_reps()
    optimize_rs(f, &rs, false)

/#/ The passes that only reshape the control flow, run until none of them has more to do: jumps
/#/ threaded, branches decided, traps shared, blocks that nothing reaches dropped, blocks joined.
fn cfg_cleanup(f: &Fun) => bool:
    let any = false
    let again = true
    let n = 0
    while again && n < 8:
        again = false
        if thread_jumps(f):
            again = true
        if fold_branches(f):
            again = true
        if merge_traps(f):
            again = true
        if drop_unreachable(f):
            again = true
            simplify_params(f)
        if merge_blocks(f):
            again = true
        if again:
            any = true
        n = n + 1
    return any

/#/ The passes that look at what the instructions compute.
/#/ The variable part of the integer add `i` whose other operand is a constant (that one in `k[0]`), else -1.
fn add_const_part(f: &Fun, i: int, k: &buf<int>) => int:
    if f.op[i] != int(Op.Add) || f.a[i] < 0 || f.b[i] < 0:
        return -1
    let x = f.follow(f.a[i])
    let y = f.follow(f.b[i])
    if f.is_const(y) && !f.is_const(x):
        k[0] = f.cval(y)
        return x
    if f.is_const(x) && !f.is_const(y):
        k[0] = f.cval(x)
        return y
    return -1

/#/ `(x + c1) + c2` becomes `x + (c1 + c2)`, so that an address computed by chained adds of constants
/#/ is one offset. The inner add stays for its other users, or goes dead.
fn reassoc_adds(f: &Fun) => bool:
    let changed = false
    let k1: buf<int> = new_buf(int, 2)
    let k2: buf<int> = new_buf(int, 2)
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            if f.op[i] == int(Op.Add) && rp_is_int(f.rep[i]) && f.fwd[i] < 0:
                let x = add_const_part(f, i, &k1)
                if x >= 0 && f.op[x] == int(Op.Add) && f.rep[x] == f.rep[i]:
                    let v = add_const_part(f, x, &k2)
                    if v >= 0:
                        let c = f.cint(f.rep[i], wrap(f.rep[i], k1[0] + k2[0]))
                        f.a[i] = v
                        f.b[i] = c
                        changed = true
            i = f.nx[i]
    if changed:
        recount_uses(f)
    return changed

fn value_passes(f: &Fun, rs: &Reps, split: bool) => bool:
    let changed = false
    if reassoc_adds(f):
        changed = true
    if fold_extracts(f):
        changed = true
    if split && split_loads(f, rs):
        changed = true
    if split && split_stores(f, rs):
        changed = true
    if cse_branches(f):
        changed = true
    if range_checks(f):
        changed = true
    if hoist_invariants(f):
        changed = true
    if own_opt(f):
        changed = true
    if stack_alloc(f):
        changed = true
    if dead_code(f):
        changed = true
    if dead_params(f):
        changed = true
    return changed

fn optimize_rs(f: &Fun, rs: &Reps, split: bool) => void:
    fold_extracts(f)
    hoist_extracts(f)
    /#/ the control flow is put in order before each look at the values, so the passes that look at
    /#/ them are run again only when one of them changed something
    let round = 0
    let changed = true
    while changed && round < 3:
        cfg_cleanup(f)
        changed = value_passes(f, rs, split)
        round = round + 1
    if changed:
        cfg_cleanup(f)
        dead_code(f)
        dead_params(f)
    recount_uses(f)

use memcpy in libc of c

/#/ `n` ints from address `src` (element `s0` on) to address `dst` (element `d0` on), in one `memcpy`. The
/#/ addresses are those of buffers (`buf_ptr`) whose room the caller has seen to.
fn cp_ints(dst: int, d0: int, src: int, s0: int, n: int) => void:
    if n > 0:
        memcpy((dst + 8 * d0) as object, (src + 8 * s0) as object, 8 * n)

class Lib:
    fx: buf<int>
    fx_n: int
    op: buf<int>
    rep: buf<int>
    ty: buf<int>
    a: buf<int>
    b: buf<int>
    c: buf<int>
    aux: buf<int>
    nx: buf<int>
    pv: buf<int>
    uses: buf<int>
    ln: buf<int>
    fwd: buf<int>
    blk: buf<int>
    ni: int
    bfirst: buf<int>
    blast: buf<int>
    pfirst: buf<int>
    plast: buf<int>
    npar: buf<int>
    nb: int
    efrom: buf<int>
    eto: buf<int>
    eargs: buf<int>
    eargn: buf<int>
    ne: int
    pool: buf<int>
    np: int
    nm: buf<int>
    nmn: int
    /#/ the function table: where each function's rows are
    nf: int
    f_i0: buf<int>
    f_ni: buf<int>
    f_b0: buf<int>
    f_nb: buf<int>
    f_e0: buf<int>
    f_ne: buf<int>
    f_p0: buf<int>
    f_np: buf<int>
    f_n0: buf<int>
    f_nn: buf<int>
    f_ret: buf<int>
    /#/ the name number of the function (the callee number of a call), -1 if unknown
    f_id: buf<int>
    /#/ the effect summary and the order the passes visit it
    f_fx: buf<int>
    f_done: buf<int>
    /#/ the pointer parameters the function does not let escape (bit q), and bit 40: parameter 0 is
    /#/ released by the function and otherwise does not escape (a drop glue)
    f_nc: buf<int>

    fn grow_cols(self, extra_i: int, extra_b: int, extra_e: int, extra_p: int, extra_n: int) => void:
        if self.ni + extra_i > len(self.op):
            let cap = (self.ni + extra_i) * 4
            self.op = buf_resize(self.op, cap)
            self.rep = buf_resize(self.rep, cap)
            self.ty = buf_resize(self.ty, cap)
            self.a = buf_resize(self.a, cap)
            self.b = buf_resize(self.b, cap)
            self.c = buf_resize(self.c, cap)
            self.aux = buf_resize(self.aux, cap)
            self.nx = buf_resize(self.nx, cap)
            self.pv = buf_resize(self.pv, cap)
            self.uses = buf_resize(self.uses, cap)
            self.ln = buf_resize(self.ln, cap)
            self.fwd = buf_resize(self.fwd, cap)
            self.blk = buf_resize(self.blk, cap)
        if self.nb + extra_b > len(self.bfirst):
            let cap = (self.nb + extra_b) * 2
            self.bfirst = buf_resize(self.bfirst, cap)
            self.blast = buf_resize(self.blast, cap)
            self.pfirst = buf_resize(self.pfirst, cap)
            self.plast = buf_resize(self.plast, cap)
            self.npar = buf_resize(self.npar, cap)
        if self.ne + extra_e > len(self.eto):
            let cap = (self.ne + extra_e) * 2
            self.efrom = buf_resize(self.efrom, cap)
            self.eto = buf_resize(self.eto, cap)
            self.eargs = buf_resize(self.eargs, cap)
            self.eargn = buf_resize(self.eargn, cap)
        if self.np + extra_p > len(self.pool):
            self.pool = buf_resize(self.pool, (self.np + extra_p) * 2)
        if self.nmn + extra_n > len(self.nm):
            self.nm = buf_resize(self.nm, (self.nmn + extra_n) * 2)

    /#/ Room for `n` instructions before any function is kept (an estimate from the size of the program), so
    /#/ the columns are not grown and copied again and again as the functions come in.
    fn reserve(self, n: int) => void:
        if self.ni > 0 || len(self.op) >= n:
            return
        self.op = new_buf(int, n)
        self.rep = new_buf(int, n)
        self.ty = new_buf(int, n)
        self.a = new_buf(int, n)
        self.b = new_buf(int, n)
        self.c = new_buf(int, n)
        self.aux = new_buf(int, n)
        self.nx = new_buf(int, n)
        self.pv = new_buf(int, n)
        self.uses = new_buf(int, n)
        self.ln = new_buf(int, n)
        self.fwd = new_buf(int, n)
        self.blk = new_buf(int, n)
        self.pool = new_buf(int, n * 5)

    fn grow_table(self) => void:
        if self.nf >= len(self.f_i0):
            let cap = (self.nf + 1) * 2
            self.f_i0 = buf_resize(self.f_i0, cap)
            self.f_ni = buf_resize(self.f_ni, cap)
            self.f_b0 = buf_resize(self.f_b0, cap)
            self.f_nb = buf_resize(self.f_nb, cap)
            self.f_e0 = buf_resize(self.f_e0, cap)
            self.f_ne = buf_resize(self.f_ne, cap)
            self.f_p0 = buf_resize(self.f_p0, cap)
            self.f_np = buf_resize(self.f_np, cap)
            self.f_n0 = buf_resize(self.f_n0, cap)
            self.f_nn = buf_resize(self.f_nn, cap)
            self.f_ret = buf_resize(self.f_ret, cap)
            self.f_id = buf_resize(self.f_id, cap)
            self.f_fx = buf_resize(self.f_fx, cap)
            self.f_done = buf_resize(self.f_done, cap)
            self.f_nc = buf_resize(self.f_nc, cap)

    /#/ Stores the columns of `f` as function number `at`, a new one when `at` is the count
    /#/ of functions. `id` is its name number. Returns the number.
    fn save(self, f: &Fun, at: int, id: int) => int:
        let n = at
        /#/ a function saved again that is not bigger than before goes over its old rows (an optimized
        /#/ function is smaller), so the store does not keep both
        let inplace = at < self.nf && f.ni <= self.f_ni[at] && f.nb <= self.f_nb[at] && f.ne <= self.f_ne[at] && f.np <= self.f_np[at] && len(f.nm) <= self.f_nn[at]
        if !inplace:
            self.grow_cols(f.ni, f.nb, f.ne, f.np, len(f.nm))
        if at >= self.nf:
            self.grow_table()
            n = self.nf
            self.nf = self.nf + 1
            self.f_fx[n] = 0
            self.f_done[n] = 0
            self.f_nc[n] = 0
        if !inplace:
            self.f_i0[n] = self.ni
            self.f_b0[n] = self.nb
            self.f_e0[n] = self.ne
            self.f_p0[n] = self.np
            self.f_n0[n] = self.nmn
        self.f_ni[n] = f.ni
        self.f_nb[n] = f.nb
        self.f_ne[n] = f.ne
        self.f_np[n] = f.np
        self.f_nn[n] = len(f.nm)
        self.f_ret[n] = f.ret
        self.f_id[n] = id
        let i0 = self.f_i0[n]
        let b0 = self.f_b0[n]
        let e0 = self.f_e0[n]
        let p0 = self.f_p0[n]
        let n0 = self.f_n0[n]
        cp_ints(int(buf_ptr(self.op)), i0, int(buf_ptr(f.op)), 0, f.ni)
        cp_ints(int(buf_ptr(self.rep)), i0, int(buf_ptr(f.rep)), 0, f.ni)
        cp_ints(int(buf_ptr(self.ty)), i0, int(buf_ptr(f.ty)), 0, f.ni)
        cp_ints(int(buf_ptr(self.a)), i0, int(buf_ptr(f.a)), 0, f.ni)
        cp_ints(int(buf_ptr(self.b)), i0, int(buf_ptr(f.b)), 0, f.ni)
        cp_ints(int(buf_ptr(self.c)), i0, int(buf_ptr(f.c)), 0, f.ni)
        cp_ints(int(buf_ptr(self.aux)), i0, int(buf_ptr(f.aux)), 0, f.ni)
        cp_ints(int(buf_ptr(self.nx)), i0, int(buf_ptr(f.nx)), 0, f.ni)
        cp_ints(int(buf_ptr(self.pv)), i0, int(buf_ptr(f.pv)), 0, f.ni)
        cp_ints(int(buf_ptr(self.uses)), i0, int(buf_ptr(f.uses)), 0, f.ni)
        cp_ints(int(buf_ptr(self.ln)), i0, int(buf_ptr(f.ln)), 0, f.ni)
        cp_ints(int(buf_ptr(self.fwd)), i0, int(buf_ptr(f.fwd)), 0, f.ni)
        cp_ints(int(buf_ptr(self.blk)), i0, int(buf_ptr(f.blk)), 0, f.ni)
        cp_ints(int(buf_ptr(self.bfirst)), b0, int(buf_ptr(f.bfirst)), 0, f.nb)
        cp_ints(int(buf_ptr(self.blast)), b0, int(buf_ptr(f.blast)), 0, f.nb)
        cp_ints(int(buf_ptr(self.pfirst)), b0, int(buf_ptr(f.pfirst)), 0, f.nb)
        cp_ints(int(buf_ptr(self.plast)), b0, int(buf_ptr(f.plast)), 0, f.nb)
        cp_ints(int(buf_ptr(self.npar)), b0, int(buf_ptr(f.npar)), 0, f.nb)
        cp_ints(int(buf_ptr(self.efrom)), e0, int(buf_ptr(f.efrom)), 0, f.ne)
        cp_ints(int(buf_ptr(self.eto)), e0, int(buf_ptr(f.eto)), 0, f.ne)
        cp_ints(int(buf_ptr(self.eargs)), e0, int(buf_ptr(f.eargs)), 0, f.ne)
        cp_ints(int(buf_ptr(self.eargn)), e0, int(buf_ptr(f.eargn)), 0, f.ne)
        cp_ints(int(buf_ptr(self.pool)), p0, int(buf_ptr(f.pool)), 0, f.np)
        cp_ints(int(buf_ptr(self.nm)), n0, int(buf_ptr(f.nm)), 0, len(f.nm))
        if !inplace:
            self.ni = self.ni + f.ni
            self.nb = self.nb + f.nb
            self.ne = self.ne + f.ne
            self.np = self.np + f.np
            self.nmn = self.nmn + len(f.nm)
        return n

    /#/ Puts function `n` into `f`.
    fn restore(self, n: int, f: &Fun) => void:
        let name = new_txt()
        for k in 0..self.f_nn[n]:
            name.put_byte(self.nm[self.f_n0[n] + k])
        f.reset(&name, self.f_ret[n])
        f.ensure(self.f_ni[n], self.f_nb[n], self.f_ne[n], self.f_np[n])
        let i0 = self.f_i0[n]
        let ni = self.f_ni[n]
        cp_ints(int(buf_ptr(f.op)), 0, int(buf_ptr(self.op)), i0, ni)
        cp_ints(int(buf_ptr(f.rep)), 0, int(buf_ptr(self.rep)), i0, ni)
        cp_ints(int(buf_ptr(f.ty)), 0, int(buf_ptr(self.ty)), i0, ni)
        cp_ints(int(buf_ptr(f.a)), 0, int(buf_ptr(self.a)), i0, ni)
        cp_ints(int(buf_ptr(f.b)), 0, int(buf_ptr(self.b)), i0, ni)
        cp_ints(int(buf_ptr(f.c)), 0, int(buf_ptr(self.c)), i0, ni)
        cp_ints(int(buf_ptr(f.aux)), 0, int(buf_ptr(self.aux)), i0, ni)
        cp_ints(int(buf_ptr(f.nx)), 0, int(buf_ptr(self.nx)), i0, ni)
        cp_ints(int(buf_ptr(f.pv)), 0, int(buf_ptr(self.pv)), i0, ni)
        cp_ints(int(buf_ptr(f.uses)), 0, int(buf_ptr(self.uses)), i0, ni)
        cp_ints(int(buf_ptr(f.ln)), 0, int(buf_ptr(self.ln)), i0, ni)
        cp_ints(int(buf_ptr(f.fwd)), 0, int(buf_ptr(self.fwd)), i0, ni)
        cp_ints(int(buf_ptr(f.blk)), 0, int(buf_ptr(self.blk)), i0, ni)
        let b0 = self.f_b0[n]
        let nb = self.f_nb[n]
        cp_ints(int(buf_ptr(f.bfirst)), 0, int(buf_ptr(self.bfirst)), b0, nb)
        cp_ints(int(buf_ptr(f.blast)), 0, int(buf_ptr(self.blast)), b0, nb)
        cp_ints(int(buf_ptr(f.pfirst)), 0, int(buf_ptr(self.pfirst)), b0, nb)
        cp_ints(int(buf_ptr(f.plast)), 0, int(buf_ptr(self.plast)), b0, nb)
        cp_ints(int(buf_ptr(f.npar)), 0, int(buf_ptr(self.npar)), b0, nb)
        let e0 = self.f_e0[n]
        let ne = self.f_ne[n]
        cp_ints(int(buf_ptr(f.efrom)), 0, int(buf_ptr(self.efrom)), e0, ne)
        cp_ints(int(buf_ptr(f.eto)), 0, int(buf_ptr(self.eto)), e0, ne)
        cp_ints(int(buf_ptr(f.eargs)), 0, int(buf_ptr(self.eargs)), e0, ne)
        cp_ints(int(buf_ptr(f.eargn)), 0, int(buf_ptr(self.eargn)), e0, ne)
        cp_ints(int(buf_ptr(f.pool)), 0, int(buf_ptr(self.pool)), self.f_p0[n], self.f_np[n])
        f.set_counts(self.f_ni[n], self.f_nb[n], self.f_ne[n], self.f_np[n])
        f.reset_vn()
        f.set_attrs(0)

    /#/ The function whose name number is `id`, -1 when the module does not define it.
    fn find(self, id: int) => int:
        if id < 0:
            return -1
        /#/ the functions made since the last look are entered in `fx` (name number to function + 1)
        while self.fx_n < self.nf:
            let k = self.f_id[self.fx_n]
            if k >= 0:
                if k >= len(self.fx):
                    self.fx = buf_resize(self.fx, (k + 1) * 2)
                if self.fx[k] == 0:
                    self.fx[k] = self.fx_n + 1
            self.fx_n = self.fx_n + 1
        if id < len(self.fx) && self.fx[id] > 0:
            return self.fx[id] - 1
        return -1

fn new_lib() => Lib:
    return Lib { fx: new_buf(int, 16), fx_n: 0, op: new_buf(int, 65536), rep: new_buf(int, 65536), ty: new_buf(int, 65536), a: new_buf(int, 65536), b: new_buf(int, 65536), c: new_buf(int, 65536), aux: new_buf(int, 65536), nx: new_buf(int, 65536), pv: new_buf(int, 65536), uses: new_buf(int, 65536), ln: new_buf(int, 65536), fwd: new_buf(int, 65536), blk: new_buf(int, 65536), ni: 0, bfirst: new_buf(int, 16), blast: new_buf(int, 16), pfirst: new_buf(int, 16), plast: new_buf(int, 16), npar: new_buf(int, 16), nb: 0, efrom: new_buf(int, 16), eto: new_buf(int, 16), eargs: new_buf(int, 16), eargn: new_buf(int, 16), ne: 0, pool: new_buf(int, 65536), np: 0, nm: new_buf(int, 65536), nmn: 0, nf: 0, f_i0: new_buf(int, 8), f_ni: new_buf(int, 8), f_b0: new_buf(int, 8), f_nb: new_buf(int, 8), f_e0: new_buf(int, 8), f_ne: new_buf(int, 8), f_p0: new_buf(int, 8), f_np: new_buf(int, 8), f_n0: new_buf(int, 8), f_nn: new_buf(int, 8), f_ret: new_buf(int, 8), f_id: new_buf(int, 8), f_fx: new_buf(int, 8), f_done: new_buf(int, 8), f_nc: new_buf(int, 8) }


fn fx_reads() => int:
    return 1

fn fx_writes() => int:
    return 2

fn fx_allocs() => int:
    return 4

fn fx_unknown() => int:
    return 8

fn fx_noreturn() => int:
    return 16

fn fx_loops() => int:
    return 32

/#/ Is the memory `p` points into one of the function's own slots?
fn is_local(f: &Fun, p: int) => bool:
    let x = f.follow(p)
    while f.op[x] == int(Op.Field) || f.op[x] == int(Op.Index):
        x = f.follow(f.a[x])
    return f.op[x] == int(Op.Slot)

/#/ Does a path of edges lead from a block back to itself?
fn has_cycle(f: &Fun) => bool:
    let state: buf<int> = new_buf(int, f.nb + 1)
    let stack: buf<int> = new_buf(int, f.nb + 1)
    let next: buf<int> = new_buf(int, f.nb + 1)
    let sp = 1
    stack[0] = 0
    state[0] = 1
    next[0] = 0
    while sp > 0:
        let b = stack[sp - 1]
        if next[sp - 1] < f.nsucc(b):
            let e = f.succ_edge(b, next[sp - 1])
            next[sp - 1] = next[sp - 1] + 1
            let to = f.eto[e]
            if to >= 0:
                if state[to] == 1:
                    return true
                if state[to] == 0:
                    state[to] = 1
                    stack[sp] = to
                    next[sp] = 0
                    sp = sp + 1
        else:
            state[b] = 2
            sp = sp - 1
    return false

/#/ The effects of `f`, a function of the module `lib`; a callee that is not summarized yet
/#/ (recursion) or not in the module counts as anything.
fn summarize(f: &Fun, lib: &Lib) => int:
    let fx = 0
    let returns = false
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let o = f.op[i]
            if o == int(Op.Load):
                if !is_local(f, f.a[i]):
                    fx = fx | fx_reads()
            elif o == int(Op.Store):
                if !is_local(f, f.a[i]):
                    fx = fx | fx_writes()
            elif o == int(Op.Alloc):
                fx = fx | fx_allocs()
            elif o == int(Op.Clone):
                fx = fx | fx_reads() | fx_allocs()
            elif o == int(Op.Free) || o == int(Op.Drop):
                fx = fx | fx_writes()
            elif o == int(Op.VLoop):
                fx = fx | fx_reads() | fx_writes()
            elif o == int(Op.CCall) || o == int(Op.CallI):
                fx = fx | fx_reads() | fx_writes() | fx_allocs() | fx_unknown() | fx_loops()
            elif o == int(Op.Call):
                let n = lib.find(f.aux[i])
                if n >= 0 && lib.f_done[n] == 1:
                    fx = fx | (lib.f_fx[n] & 47)
                else:
                    fx = fx | fx_reads() | fx_writes() | fx_allocs() | fx_unknown() | fx_loops()
            elif o == int(Op.Ret):
                returns = true
            i = f.nx[i]
    if !returns:
        fx = fx | fx_noreturn()
    if has_cycle(f):
        fx = fx | fx_loops()
    return fx

/#/ A call whose value nobody uses, of a function that only reads, always returns and ends,
/#/ is not made.
fn dead_calls(f: &Fun, lib: &Lib) => bool:
    let changed = false
    for b in 0..f.nb:
        let i = f.blast[b]
        while i >= 0:
            let p = f.pv[i]
            if f.op[i] == int(Op.Call) && f.uses[i] == 0 && f.fwd[i] < 0:
                let n = lib.find(f.aux[i])
                if n >= 0 && lib.f_done[n] == 1:
                    if (lib.f_fx[n] & (fx_writes() | fx_allocs() | fx_unknown() | fx_noreturn() | fx_loops())) == 0:
                        delete_inst(f, i)
                        changed = true
            i = p
    return changed

/#/ The functions in an order where callees come first (a cycle is cut where it is found).
fn call_order(lib: &Lib) => buf<int>:
    let seen: buf<int> = new_buf(int, lib.nf + 1)
    let out: buf<int> = new_buf(int, lib.nf + 1)
    let stack: buf<int> = new_buf(int, lib.nf + 1)
    let pos: buf<int> = new_buf(int, lib.nf + 1)
    let on = 0
    for root in 0..lib.nf:
        if seen[root] == 0:
            seen[root] = 1
            stack[0] = root
            pos[0] = lib.f_i0[root]
            let sp = 1
            while sp > 0:
                let n = stack[sp - 1]
                let end = lib.f_i0[n] + lib.f_ni[n]
                let descended = false
                while pos[sp - 1] < end && !descended:
                    let k = pos[sp - 1]
                    pos[sp - 1] = k + 1
                    if lib.op[k] == int(Op.Call) || lib.op[k] == int(Op.Drop):
                        let c = lib.find(lib.aux[k])
                        if c >= 0 && seen[c] == 0:
                            seen[c] = 1
                            stack[sp] = c
                            pos[sp] = lib.f_i0[c]
                            sp = sp + 1
                            descended = true
                if !descended:
                    out[on] = n
                    on = on + 1
                    sp = sp - 1
    return out

/#/ ---- inlining ------------------------------------------------------------

/#/ How many instructions function `n` of the module has in its blocks.
fn live_count(lib: &Lib, n: int) => int:
    let k = 0
    let i0 = lib.f_i0[n]
    for b in 0..lib.f_nb[n]:
        let i = lib.bfirst[lib.f_b0[n] + b]
        while i >= 0:
            k = k + 1
            i = lib.nx[i0 + i]
    return k

/#/ Does a path of edges lead from block `b` back to `b`?
fn in_loop(f: &Fun, b: int) => bool:
    let seen: buf<int> = new_buf(int, f.nb + 1)
    let stack: buf<int> = new_buf(int, f.nb + 1)
    let sp = 1
    stack[0] = b
    while sp > 0:
        sp = sp - 1
        let x = stack[sp]
        for k in 0..f.nsucc(x):
            let to = f.eto[f.succ_edge(x, k)]
            if to == b:
                return true
            if to >= 0 && seen[to] == 0:
                seen[to] = 1
                stack[sp] = to
                sp = sp + 1
    return false

/#/ How many instructions a body may have to be inlined outside a loop (beyond the call's own
/#/ argument moves): the copy then costs about what the call did. Inside a loop the call is paid
/#/ many times, so a body up to `loop_inline` instructions is copied.
let plain_inline = 4
let loop_inline = 40

/#/ Is the call `c` of `f` to one that may be inlined: a finished function of the module, small,
/#/ other than `f`, taking as many arguments as the call passes?
fn inlinable(f: &Fun, lib: &Lib, c: int, cur: int) => int:
    if f.op[c] != int(Op.Call) || f.fwd[c] >= 0:
        return -1
    let n = lib.find(f.aux[c])
    if n < 0 || lib.f_done[n] == 0 || f.aux[c] == cur:
        return -1
    if lib.f_nb[n] == 0 || lib.npar[lib.f_b0[n]] != f.b[c] || lib.f_ret[n] != f.rep[c]:
        return -1
    if live_count(lib, n) > 12:
        return -1
    /#/ a function that calls itself would only unroll
    let i0 = lib.f_i0[n]
    for k in 0..lib.f_ni[n]:
        if lib.op[i0 + k] == int(Op.Call) && lib.aux[i0 + k] == lib.f_id[n] && lib.blk[i0 + k] >= 0:
            return -1
    return n

/#/ Replaces the call `c` (in block `B`) by the body of function `n`: the block is split at the
/#/ call, the callee's blocks are copied in with their numbers shifted, its entry parameters are
/#/ the call's arguments and each `ret` jumps to the rest of the block, passing the result.
fn inline_call(f: &Fun, lib: &Lib, c: int, n: int) => void:
    let bb = f.blk[c]
    let nargs = f.b[c]
    let args: buf<int> = new_buf(int, nargs + 1)
    for k in 0..nargs:
        args[k] = f.follow(f.val_at(c, k))
    /#/ split: what follows the call goes to a new block
    let after = f.new_block()
    let t = f.nx[c]
    if t >= 0:
        f.pv[t] = -1
        f.bfirst[after] = t
        f.blast[after] = f.blast[bb]
        f.nx[c] = -1
        f.blast[bb] = c
        let i = t
        while i >= 0:
            f.blk[i] = after
            i = f.nx[i]
    for e in 0..f.ne:
        if f.efrom[e] == bb:
            f.efrom[e] = after
    unlink(f, c)
    let res = -1
    if f.rep[c] != int(Rp.Void):
        res = f.param(after, f.rep[c], f.ty[c])
        f.uses[res] = f.uses[c]
        f.fwd[c] = res
    unuse(f, c)
    /#/ copy
    let bi = f.ni
    let bblk = f.nb
    let be = f.ne
    let bp = f.np
    let ni = lib.f_ni[n]
    let nb = lib.f_nb[n]
    let ne = lib.f_ne[n]
    let np = lib.f_np[n]
    f.ensure(bi + ni, bblk + nb, be + ne + nb + 2, bp + np + nb + 2)
    let i0 = lib.f_i0[n]
    for k in 0..ni:
        let d = bi + k
        f.op[d] = lib.op[i0 + k]
        f.rep[d] = lib.rep[i0 + k]
        f.ty[d] = lib.ty[i0 + k]
        f.a[d] = lib.a[i0 + k]
        f.b[d] = lib.b[i0 + k]
        f.c[d] = lib.c[i0 + k]
        f.aux[d] = lib.aux[i0 + k]
        f.nx[d] = shift(lib.nx[i0 + k], bi)
        f.pv[d] = shift(lib.pv[i0 + k], bi)
        f.uses[d] = lib.uses[i0 + k]
        f.ln[d] = f.ln[c]
        f.fwd[d] = shift(lib.fwd[i0 + k], bi)
        f.blk[d] = shift(lib.blk[i0 + k], bblk)
    let b0 = lib.f_b0[n]
    for k in 0..nb:
        f.bfirst[bblk + k] = shift(lib.bfirst[b0 + k], bi)
        f.blast[bblk + k] = shift(lib.blast[b0 + k], bi)
        f.pfirst[bblk + k] = shift(lib.pfirst[b0 + k], bi)
        f.plast[bblk + k] = shift(lib.plast[b0 + k], bi)
        f.npar[bblk + k] = lib.npar[b0 + k]
    let e0 = lib.f_e0[n]
    for k in 0..ne:
        f.efrom[be + k] = shift(lib.efrom[e0 + k], bblk)
        f.eto[be + k] = shift(lib.eto[e0 + k], bblk)
        f.eargs[be + k] = lib.eargs[e0 + k] + bp
        f.eargn[be + k] = lib.eargn[e0 + k]
    let p0 = lib.f_p0[n]
    for k in 0..np:
        f.pool[bp + k] = lib.pool[p0 + k]
    f.set_counts(bi + ni, bblk + nb, be + ne, bp + np)
    /#/ what the copied instructions refer to moves with them
    for k in 0..ni:
        let d = bi + k
        let o = f.op[d]
        if o == int(Op.Call) || o == int(Op.CCall) || o == int(Op.CallI) || o == int(Op.VLoop):
            f.a[d] = f.a[d] + bp
        if o == int(Op.Br):
            f.aux[d] = f.aux[d] + be
        if o == int(Op.CondBr):
            f.b[d] = f.b[d] + be
            f.c[d] = f.c[d] + be
        if o == int(Op.Switch):
            f.c[d] = f.c[d] + be
            f.aux[d] = f.aux[d] + bp
            for q in 0..f.b[d]:
                f.pool[f.aux[d] + q * 2 + 1] = f.pool[f.aux[d] + q * 2 + 1] + be
        if f.blk[d] >= 0 || o == int(Op.Param):
            for q in 0..f.nval(d):
                f.set_val_at(d, q, shift(f.val_at(d, q), bi))
    for e in 0..ne:
        for q in 0..f.eargn[be + e]:
            let at = f.eargs[be + e] + q
            f.pool[at] = shift(f.pool[at], bi)
    /#/ the entry's parameters are the arguments
    let p = f.pfirst[bblk]
    let q = 0
    while p >= 0:
        let x = args[q]
        f.fwd[p] = x
        f.uses[x] = f.uses[x] + f.uses[p]
        p = f.nx[p]
        q = q + 1
    f.pfirst[bblk] = -1
    f.plast[bblk] = -1
    f.npar[bblk] = 0
    f.set_block(bb)
    f.br(bblk)
    /#/ each return jumps to the rest, with the value
    for k in 0..nb:
        let r = f.blast[bblk + k]
        if r >= 0 && f.op[r] == int(Op.Ret):
            f.set_block(bblk + k)
            if f.a[r] >= 0:
                let v = f.follow(f.a[r])
                f.arg(v)
                let e = f.mk_edge(after)
                f.uses[v] = f.uses[v] - 1
                f.a[r] = -1
                f.aux[r] = e
            else:
                f.aux[r] = f.mk_edge(after)
            f.op[r] = int(Op.Br)
            f.rep[r] = int(Rp.Void)
            f.b[r] = -1
            f.c[r] = -1

fn shift(v: int, by: int) => int:
    if v < 0:
        return v
    return v + by

/#/ Inlines the calls of `f` the policy accepts; returns whether it did any.
fn inline_calls(f: &Fun, lib: &Lib, cur: int) => bool:
    let any = false
    let budget = 16
    let again = true
    while again && budget > 0 && f.ni < 3000:
        again = false
        for b in 0..f.nb:
            let i = f.bfirst[b]
            while i >= 0 && !again:
                let n = inlinable(f, lib, i, cur)
                if n >= 0:
                    inline_call(f, lib, i, n)
                    again = true
                    any = true
                    budget = budget - 1
                i = f.nx[i]
            if again:
                break
    return any

/#/ Expands the self-calls of `f` (function `n` of `lib`) by one level: each is replaced by a copy of the
/#/ body as it is now, so half as many calls are made. Only for a small body, and only when the copies
/#/ stay small. Returns whether it did.
fn self_inline(f: &Fun, lib: &Lib, n: int) => bool:
    let id = lib.f_id[n]
    let calls = 0
    let live = 0
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            live = live + 1
            if f.op[i] == int(Op.Call) && f.aux[i] == id && f.fwd[i] < 0:
                calls = calls + 1
            i = f.nx[i]
    if calls == 0 || calls > 2 || live > 40 || live * (calls + 1) > 120:
        return false
    lib.save(f, n, id)
    if lib.f_nb[n] == 0:
        return false
    let did = false
    let again = true
    let left = calls
    while again && left > 0:
        again = false
        for b in 0..f.nb:
            let i = f.bfirst[b]
            while i >= 0 && !again:
                if f.op[i] == int(Op.Call) && f.aux[i] == id && f.fwd[i] < 0 && lib.npar[lib.f_b0[n]] == f.b[i] && lib.f_ret[n] == f.rep[i]:
                    inline_call(f, lib, i, n)
                    again = true
                    did = true
                    left = left - 1
                i = f.nx[i]
            if again:
                break
    return did

/#/ ---- escape analysis -----------------------------------------------------

/#/ Is `x` (an address) the base of a use that cannot let it outlive the function's frame: a load or store
/#/ through it, an address derived from it, a comparison, a call whose callee keeps no pointer in
/#/ parameter `q`? `release` allows the `free` of the root `c` itself and, when `glue` is set, its `drop`
/#/ by a drop glue that only releases it.
fn escape_use_ok(f: &Fun, lib: &Lib, i: int, q: int, x: int, c: int, release: bool) => bool:
    let o = f.op[i]
    if o == int(Op.Load) || o == int(Op.Field) || o == int(Op.Index) || o == int(Op.Store):
        return q == 0
    if o == int(Op.Cmp):
        return true
    if o == int(Op.Free):
        return release && x == c && q == 0
    if o == int(Op.Drop):
        if !release || x != c || q != 0:
            return false
        let n = lib.find(f.aux[i])
        return n >= 0 && lib.f_done[n] == 1 && ((lib.f_nc[n] >> 40) & 1) == 1
    if o == int(Op.Call):
        let n = lib.find(f.aux[i])
        if n < 0 || lib.f_done[n] == 0 || q >= 40:
            return false
        if lib.f_nb[n] == 0 || lib.npar[lib.f_b0[n]] != f.b[i]:
            return false
        return ((lib.f_nc[n] >> q) & 1) == 1
    return false

/#/ `base[x]` is the root a value derives from (`x` itself for a root), -1 for any other value. Sets `bad[c]`
/#/ for the roots with a use that may keep the pointer: an edge argument, a returned or stored pointer,
/#/ a call that may keep it, anything else the list in `escape_use_ok` does not name.
fn escape_scan(f: &Fun, lib: &Lib, base: &buf<int>, bad: &buf<int>, release: bool) => void:
    let grown = true
    while grown:
        grown = false
        for b in 0..f.nb:
            let i = f.bfirst[b]
            while i >= 0:
                if (f.op[i] == int(Op.Field) || f.op[i] == int(Op.Index)) && f.fwd[i] < 0 && base[i] < 0:
                    let r = base[f.follow(f.a[i])]
                    if r >= 0:
                        base[i] = r
                        grown = true
                i = f.nx[i]
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            if !(f.op[i] == int(Op.Alloc) && base[i] == i):
                for q in 0..f.nval(i):
                    let v = f.val_at(i, q)
                    if v >= 0:
                        let x = f.follow(v)
                        let c = base[x]
                        if c >= 0 && !escape_use_ok(f, lib, i, q, x, c, release):
                            bad[c] = 1
            i = f.nx[i]
    for e in 0..f.ne:
        if f.eto[e] >= 0:
            for k in 0..f.eargn[e]:
                let c = base[f.follow(f.pool[f.eargs[e] + k])]
                if c >= 0:
                    bad[c] = 1

/#/ The pointer parameters of `f` it lets escape not at all (bit q set), and bit 40: parameter 0 is
/#/ only released (the shape of a drop glue).
fn param_summary(f: &Fun, lib: &Lib) => int:
    if f.nb == 0:
        return 0
    let nptr = 0
    let pp = f.pfirst[0]
    while pp >= 0:
        if f.rep[pp] == int(Rp.Ptr):
            nptr = nptr + 1
        pp = f.nx[pp]
    if nptr == 0:
        return 0
    let base: buf<int> = new_buf(int, f.ni + 1)
    let bad: buf<int> = new_buf(int, f.ni + 1)
    for k in 0..f.ni:
        base[k] = -1
    let p = f.pfirst[0]
    let q = 0
    let first = -1
    while p >= 0:
        if f.rep[p] == int(Rp.Ptr) && q < 40 && f.fwd[p] < 0:
            base[p] = p
            if q == 0:
                first = p
        p = f.nx[p]
        q = q + 1
    escape_scan(f, lib, &base, &bad, false)
    let m = 0
    let p2 = f.pfirst[0]
    let q2 = 0
    while p2 >= 0:
        if q2 < 40 && base[p2] == p2 && bad[p2] == 0:
            m = m | (1 << q2)
        p2 = f.nx[p2]
        q2 = q2 + 1
    if first >= 0 && bad[first] == 1:
        let base2: buf<int> = new_buf(int, f.ni + 1)
        let bad2: buf<int> = new_buf(int, f.ni + 1)
        for k in 0..f.ni:
            base2[k] = -1
        base2[first] = first
        escape_scan(f, lib, &base2, &bad2, true)
        if bad2[first] == 0:
            m = m | (1 << 40)
    return m

/#/ An `alloc` whose pointer does not escape (see `escape_scan`) lives in the frame: it becomes a `slot` and
/#/ its `free`s go. A `drop` of it by a glue that only releases it is made a call and inlined first, so
/#/ the glue's `free` goes too. Any block of the function may hold the alloc and the release.
fn escape_alloc(f: &Fun, lib: &Lib) => bool:
    let any = false
    let budget = 8
    let again = true
    while again:
        again = false
        let cands = 0
        for b in 0..f.nb:
            let i = f.bfirst[b]
            while i >= 0:
                if f.op[i] == int(Op.Alloc) && f.fwd[i] < 0 && f.ty[i] > 0 && f.ty[i] <= 512:
                    cands = cands + 1
                i = f.nx[i]
        if cands == 0:
            return any
        let base: buf<int> = new_buf(int, f.ni + 1)
        let bad: buf<int> = new_buf(int, f.ni + 1)
        let total = 0
        for k in 0..f.ni:
            base[k] = -1
        for b in 0..f.nb:
            let i = f.bfirst[b]
            while i >= 0:
                if f.op[i] == int(Op.Alloc) && f.fwd[i] < 0 && f.ty[i] > 0 && f.ty[i] <= 512 && total + f.ty[i] <= 4096:
                    base[i] = i
                    total = total + f.ty[i]
                i = f.nx[i]
        escape_scan(f, lib, &base, &bad, true)
        if budget > 0:
            for b in 0..f.nb:
                let i = f.bfirst[b]
                while i >= 0 && !again:
                    if f.op[i] == int(Op.Drop) && f.fwd[i] < 0:
                        let x = f.follow(f.a[i])
                        let n = lib.find(f.aux[i])
                        if base[x] == x && bad[x] == 0 && n >= 0 && live_count(lib, n) <= 80:
                            let start = f.np
                            f.pool_put(x)
                            f.op[i] = int(Op.Call)
                            f.a[i] = start
                            f.b[i] = 1
                            f.c[i] = -1
                            inline_call(f, lib, i, n)
                            budget = budget - 1
                            again = true
                    i = f.nx[i]
        if !again:
            /#/ a drop that could not be inlined keeps its alloc on the heap
            for b in 0..f.nb:
                let i = f.bfirst[b]
                while i >= 0:
                    if f.op[i] == int(Op.Drop) && base[f.follow(f.a[i])] >= 0:
                        bad[base[f.follow(f.a[i])]] = 1
                    i = f.nx[i]
            for c in 0..f.ni:
                if base[c] == c && bad[c] == 0 && f.op[c] == int(Op.Alloc):
                    for b in 0..f.nb:
                        let i = f.bfirst[b]
                        while i >= 0:
                            let nxt = f.nx[i]
                            if f.op[i] == int(Op.Free) && f.follow(f.a[i]) == c:
                                delete_inst(f, i)
                            i = nxt
                    f.op[c] = int(Op.Slot)
                    any = true
    return any

/#/ ---- recursion ---------------------------------------------------------------

/#/ Does the call `c` pass what function `f` takes (as many values, of the same shapes), and return what it returns?
fn tre_call_fits(f: &Fun, c: int) => bool:
    if f.rep[c] != f.ret || f.b[c] != f.npar[0]:
        return false
    let p = f.pfirst[0]
    let k = 0
    while p >= 0:
        if f.rep[f.follow(f.val_at(c, k))] != f.rep[p]:
            return false
        p = f.nx[p]
        k = k + 1
    return true

/#/ Is everything from `c` (exclusive) up to `r` (exclusive) free of effects?
fn tre_pure_between(f: &Fun, c: int, r: int) => bool:
    let x = f.nx[c]
    while x >= 0 && x != r:
        if !pure_op(f.op[x]):
            return false
        x = f.nx[x]
    return x == r

/#/ Is `x` available before `c`: a constant, a parameter of the function, or earlier in the block of `c`?
fn tre_before(f: &Fun, x: int, c: int) => bool:
    if f.is_const(x) || (f.op[x] == int(Op.Param) && f.blk[x] == 0):
        return true
    if f.blk[x] != f.blk[c] || f.op[x] == int(Op.Param):
        return false
    let q = f.pv[c]
    while q >= 0:
        if q == x:
            return true
        q = f.pv[q]
    return false

/#/ A function that returns the result of calling itself, or that result plus something computed before the
/#/ call (`fib(n - 1) + fib(n - 2)` is the first call's value plus the second's), is a loop: the parameters
/#/ become the parameters of a new loop header, and so does an accumulator `acc` that the "something" is added
/#/ to; every other return gives `acc` plus its value. Sums wrap, so the order does not matter.
fn tail_recursion(f: &Fun, self_id: int) => bool:
    if f.nb == 0 || f.ret != int(Rp.I64) || f.ni > 4000:
        return false
    let kind: buf<int> = new_buf(int, f.nb + 1)
    let callv: buf<int> = new_buf(int, f.nb + 1)
    let xv: buf<int> = new_buf(int, f.nb + 1)
    let sites = 0
    let adds = 0
    for b in 0..f.nb:
        let r = f.blast[b]
        if r >= 0 && f.op[r] == int(Op.Ret) && f.a[r] >= 0:
            let v = f.follow(f.a[r])
            if f.op[v] == int(Op.Call) && f.aux[v] == self_id && f.uses[v] == 1 && f.blk[v] == b && tre_call_fits(f, v) && tre_pure_between(f, v, r):
                kind[b] = 1
                callv[b] = v
                sites = sites + 1
            elif f.op[v] == int(Op.Add) && f.rep[v] == int(Rp.I64) && f.uses[v] == 1 && f.blk[v] == b:
                for side in 0..2:
                    if kind[b] == 0:
                        let w = f.follow(f.a[v])
                        let x = f.follow(f.b[v])
                        if side == 1:
                            w = f.follow(f.b[v])
                            x = f.follow(f.a[v])
                        if f.op[w] == int(Op.Call) && f.aux[w] == self_id && f.uses[w] == 1 && f.blk[w] == b && w != x && tre_call_fits(f, w) && tre_before(f, x, w) && tre_pure_between(f, w, r):
                            kind[b] = 2
                            callv[b] = w
                            xv[b] = x
                            sites = sites + 1
                            adds = adds + 1
    if sites == 0:
        return false
    let np = f.npar[0]
    let old: buf<int> = new_buf(int, np + 1)
    let nw: buf<int> = new_buf(int, np + 1)
    let h = f.new_block()
    let p = f.pfirst[0]
    let k = 0
    while p >= 0:
        old[k] = p
        nw[k] = f.param(h, f.rep[p], f.ty[p])
        p = f.nx[p]
        k = k + 1
    let acc = f.param(h, int(Rp.I64), -1)
    /#/ the body moves to the header
    f.bfirst[h] = f.bfirst[0]
    f.blast[h] = f.blast[0]
    f.bfirst[0] = -1
    f.blast[0] = -1
    let i = f.bfirst[h]
    while i >= 0:
        f.blk[i] = h
        i = f.nx[i]
    for e in 0..f.ne:
        if f.efrom[e] == 0:
            f.efrom[e] = h
    kind[h] = kind[0]
    callv[h] = callv[0]
    xv[h] = xv[0]
    kind[0] = 0
    /#/ and uses the header's parameters
    for b in 1..f.nb:
        let j = f.bfirst[b]
        while j >= 0:
            for q in 0..f.nval(j):
                let v = f.val_at(j, q)
                if v >= 0:
                    let x = f.follow(v)
                    for t in 0..np:
                        if x == old[t]:
                            f.set_val_at(j, q, nw[t])
            j = f.nx[j]
    for e in 0..f.ne:
        if f.eto[e] >= 0:
            for q in 0..f.eargn[e]:
                let x = f.follow(f.pool[f.eargs[e] + q])
                for t in 0..np:
                    if x == old[t]:
                        f.pool[f.eargs[e] + q] = nw[t]
    /#/ the entry jumps to the header with the arguments it was given and nothing summed
    f.cur = 0
    for t in 0..np:
        f.arg(old[t])
    f.arg(f.cint(int(Rp.I64), 0))
    f.br(h)
    /#/ the returns
    for b in 1..f.nb:
        let r = f.blast[b]
        if r >= 0 && f.op[r] == int(Op.Ret) && f.a[r] >= 0 && kind[b] == 0 && adds > 0:
            f.cur = b
            let v = f.follow(f.a[r])
            let s = f.raw(int(Op.Add), int(Rp.I64), -1, v, acc, -1, 0)
            link_before(f, s, r)
            f.a[r] = s
    for b in 1..f.nb:
        if kind[b] != 0:
            let r = f.blast[b]
            let c = callv[b]
            let nacc = acc
            f.cur = b
            if kind[b] == 2:
                let xs = xv[b]
                for t in 0..np:
                    if xs == old[t]:
                        xs = nw[t]
                nacc = f.raw(int(Op.Add), int(Rp.I64), -1, xs, acc, -1, 0)
                link_before(f, nacc, r)
            for t in 0..np:
                f.arg(f.val_at(c, t))
            f.arg(nacc)
            let e = f.mk_edge(h)
            let sum = f.follow(f.a[r])
            f.op[r] = int(Op.Br)
            f.rep[r] = int(Rp.Void)
            f.a[r] = -1
            f.b[r] = -1
            f.c[r] = -1
            f.aux[r] = e
            if sum != c:
                delete_inst(f, sum)
            delete_inst(f, c)
    recount_uses(f)
    return true

/#/ Optimizes every function of `lib`, callees first. `f` is the working function.
fn module_opt(lib: &Lib, f: &Fun, rs: &Reps) => void:
    let order = call_order(lib)
    for k in 0..lib.nf:
        let n = order[k]
        lib.restore(n, f)
        inline_calls(f, lib, lib.f_id[n])
        optimize_rs(f, rs, true)
        if dead_calls(f, lib):
            optimize_rs(f, rs, true)
        if tail_recursion(f, lib.f_id[n]):
            optimize_rs(f, rs, true)
        if escape_alloc(f, lib):
            optimize_rs(f, rs, true)
        if self_inline(f, lib, n):
            optimize_rs(f, rs, true)
        let vectorized = 0
        while vectorized < 4 && vectorize(f):
            vectorized = vectorized + 1
        if vectorized > 0:
            optimize_rs(f, rs, true)
        let inverted = 0
        while inverted < 8 && invert_loops(f):
            inverted = inverted + 1
        if inverted > 0:
            optimize_rs(f, rs, true)
        let id = lib.f_id[n]
        lib.save(f, n, id)
        lib.f_fx[n] = summarize(f, lib)
        lib.f_nc[n] = param_summary(f, lib)
        lib.f_done[n] = 1


fn cc_e() => int:
    return 4

fn cc_ne() => int:
    return 5

fn cc_b() => int:
    return 2

fn cc_ae() => int:
    return 3

fn cc_be() => int:
    return 6

fn cc_a() => int:
    return 7

fn cc_np() => int:
    return 11

fn cc_l() => int:
    return 12

fn cc_ge() => int:
    return 13

fn cc_le() => int:
    return 14

fn cc_g() => int:
    return 15

/#/ Relocation types of the System V x86-64 ABI.
fn r_pc32() => int:
    return 2

fn r_plt32() => int:
    return 4

/#/ R_X86_64_32: the address itself, in 32 bits (sandbox code: an offset in the linear memory)
fn r_abs32() => int:
    return 10

/#/ Where the code at old position `p` is once the jumps are shortened: `st` are the starts of the
/#/ `n` jumps, and `pref[k]` the bytes saved by the jumps before the `k`th.
fn new_pos(st: &buf<int>, pref: &buf<int>, n: int, p: int) => int:
    let lo = 0
    let hi = n
    while lo < hi:
        let mid = (lo + hi) // 2
        if st[mid] < p:
            lo = mid + 1
        else:
            hi = mid
    return p - pref[lo]

/#/ Functions start at a multiple of this many bytes: 1 (no padding), or 16 with `--align`, which
/#/ `tea` asks for in a release build.
let fn_align = 1

fn set_fn_align() => void:
    fn_align = 16

class Asm:
    c: Txt
    /#/ labels of the function being assembled: absolute positions in `c`, -1 while unbound
    lab: buf<int>
    nlab: int
    fx_at: buf<int>
    fx_lab: buf<int>
    fx_kind: buf<int>
    nfx: int
    /#/ where the function being assembled starts, and the first of its relocations
    fs: int
    rl0: int
    /#/ relocations of the whole object
    rl_at: buf<int>
    rl_sym: buf<int>
    rl_ty: buf<int>
    rl_add: buf<int>
    nrl: int
    /#/ the last register move and the last 8-byte store, while nothing has been emitted since:
    /#/ where each ends and what it moved (a store: base, displacement, register)
    lm_end: int
    lm_d: int
    lm_s: int
    ls_end: int
    ls_base: int
    ls_disp: int
    ls_reg: int
    /#/ sandbox code: a memory operand (but for `lea`, and rbp/rsp as the base: the host stack) is
    /#/ addressed through `gs` in 32 bits, and a reference to rodata or data is an absolute 32-bit number
    sbx: bool
    /#/ with `sbx`: a memory operand is not given the `gs` prefixes; its address is computed into r13 as a
    /#/ 32-bit number (`lea r13d, [..]`) and used as `[r15 + r13]`, r15 being the start of the linear memory
    bm: bool
    /#/ a mandatory prefix (66, F2, F3) for the next memory operand, which puts it in the right place; -1 for none
    pfx: int

    fn dump(self, t: &Txt) => void:
        t.put_all(&self.c)

    fn byte(self, x: int) => void:
        self.c.put_byte(x & 255)

    fn le32(self, v: int) => void:
        for k in 0..4:
            self.c.put_byte((v >> (8 * k)) & 255)

    fn le64(self, v: int) => void:
        for k in 0..8:
            self.c.put_byte((v >> (8 * k)) & 255)

    fn pos(self) => int:
        return self.c.n

    /#/ ---- labels ------------------------------------------------------------

    fn begin_fun(self) => void:
        while self.c.n % fn_align != 0:
            self.c.put_byte(204)
        self.nlab = 0
        self.nfx = 0
        self.fs = self.c.n
        self.rl0 = self.nrl

    fn new_label(self) => int:
        if self.nlab >= len(self.lab):
            self.lab = buf_resize(self.lab, (self.nlab + 1) * 2)
        self.lab[self.nlab] = 0 - 1
        self.nlab = self.nlab + 1
        return self.nlab - 1

    /#/ A label at the current position that does not break the peephole state: for line marks.
    fn mark(self) => int:
        let l = self.new_label()
        self.lab[l] = self.c.n
        return l

    fn bind(self, l: int) => void:
        self.lab[l] = self.c.n
        self.lm_end = 0 - 1
        self.ls_end = 0 - 1

    /#/ A 32-bit offset to label `l`, from the end of the field; `kind` is 0 for a `jmp` (one opcode
    /#/ byte before the field) and 1 for a `jcc` (two).
    fn rel_to(self, l: int, kind: int) => void:
        if self.nfx >= len(self.fx_at):
            self.fx_at = buf_resize(self.fx_at, (self.nfx + 1) * 2)
            self.fx_lab = buf_resize(self.fx_lab, (self.nfx + 1) * 2)
            self.fx_kind = buf_resize(self.fx_kind, (self.nfx + 1) * 2)
        self.fx_at[self.nfx] = self.c.n
        self.fx_lab[self.nfx] = l
        self.fx_kind[self.nfx] = kind
        self.nfx = self.nfx + 1
        self.le32(0)

    /#/ Resolves the jumps of the function just assembled: each is the short form when its target
    /#/ is within reach (and gone when it targets the next instruction), the rest are patched.
    /#/ False if a label was never bound.
    fn end_fun(self) => bool:
        let n = self.nfx
        for k in 0..n:
            if self.lab[self.fx_lab[k]] < 0:
                return false
        let st = new_buf(int, n + 1)
        let sz = new_buf(int, n + 1)
        let pref = new_buf(int, n + 2)
        for k in 0..n:
            st[k] = self.fx_at[k] - 1 - self.fx_kind[k]
            sz[k] = 5 + self.fx_kind[k]
        let changed = true
        while changed:
            changed = false
            let sum = 0
            for k in 0..n:
                pref[k] = sum
                sum = sum + (5 + self.fx_kind[k]) - sz[k]
            pref[n] = sum
            for k in 0..n:
                if sz[k] > 2:
                    let to = self.lab[self.fx_lab[k]]
                    if self.fx_kind[k] == 0 && to == self.fx_at[k] + 4:
                        sz[k] = 0
                        changed = true
                    else:
                        let d = new_pos(&st, &pref, n, to) - (st[k] - pref[k] + 2)
                        if d >= 0 - 128 && d < 128:
                            sz[k] = 2
                            changed = true
        let sum = 0
        for k in 0..n:
            pref[k] = sum
            sum = sum + (5 + self.fx_kind[k]) - sz[k]
        pref[n] = sum
        let out = new_txt()
        let at = self.fs
        for k in 0..n:
            for q in at..st[k]:
                out.put_byte(self.c.b[q])
            at = self.fx_at[k] + 4
            let to = new_pos(&st, &pref, n, self.lab[self.fx_lab[k]])
            let here = st[k] - pref[k]
            if sz[k] == 2:
                if self.fx_kind[k] == 0:
                    out.put_byte(235)
                else:
                    out.put_byte(self.c.b[self.fx_at[k] - 1] - 16)
                out.put_byte((to - (here + 2)) & 255)
            elif sz[k] > 2:
                for q in st[k]..self.fx_at[k]:
                    out.put_byte(self.c.b[q])
                let d = to - (here + sz[k])
                for q in 0..4:
                    out.put_byte((d >> (8 * q)) & 255)
        for q in at..self.c.n:
            out.put_byte(self.c.b[q])
        for r in self.rl0..self.nrl:
            self.rl_at[r] = new_pos(&st, &pref, n, self.rl_at[r])
        /#/ the labels of the function stay valid for whoever asks where one is (`lab[l]`)
        for l in 0..self.nlab:
            if self.lab[l] >= 0:
                self.lab[l] = new_pos(&st, &pref, n, self.lab[l])
        self.c.n = self.fs
        self.c.put_all(&out)
        return true

    fn reloc(self, sym: int, ty: int, addend: int) => void:
        if self.nrl >= len(self.rl_at):
            let cap = (self.nrl + 1) * 2
            self.rl_at = buf_resize(self.rl_at, cap)
            self.rl_sym = buf_resize(self.rl_sym, cap)
            self.rl_ty = buf_resize(self.rl_ty, cap)
            self.rl_add = buf_resize(self.rl_add, cap)
        self.rl_at[self.nrl] = self.c.n
        self.rl_sym[self.nrl] = sym
        self.rl_ty[self.nrl] = ty
        self.rl_add[self.nrl] = addend
        self.nrl = self.nrl + 1
        self.le32(0)

    /#/ ---- encoding ----------------------------------------------------------

    /#/ A REX prefix when one is needed (or `force`d, to reach sil/dil as byte registers).
    fn rex(self, w: int, reg: int, base: int, force: bool) => void:
        let v = 64 | (w << 3) | ((reg >> 3) << 2) | (base >> 3)
        if v != 64 || force:
            self.byte(v)

    /#/ `opc` (one or two bytes, the second -1 when absent) with a register and a register.
    fn rr(self, w: int, opc: int, opc2: int, reg: int, rmr: int, force: bool) => void:
        self.rex(w, reg, rmr, force)
        self.byte(opc)
        if opc2 >= 0:
            self.byte(opc2)
        self.byte(192 | ((reg & 7) << 3) | (rmr & 7))

    /#/ `opc` with a register and the memory operand `[base + disp]`.
    fn rmem(self, w: int, opc: int, opc2: int, reg: int, base: int, disp: int, force: bool) => void:
        if self.bm && opc != 141 && base != 4 && base != 5:
            /#/ the address as a 32-bit number in r13, then the access relative to r15
            let held = self.pfx
            self.pfx = 0 - 1
            self.rmem(0, 141, 0 - 1, 13, base, disp, false)
            self.pfx = held
            self.rmem_idx(w, opc, opc2, reg, 15, 13, 1, 0, force)
            return
        if self.pfx >= 0:
            self.byte(self.pfx)
            self.pfx = 0 - 1
        if self.sbx && !self.bm && opc != 141 && base != 4 && base != 5:
            self.byte(103)
            self.byte(101)
        self.rex(w, reg, base, force)
        self.byte(opc)
        if opc2 >= 0:
            self.byte(opc2)
        if disp == 0 && (base & 7) != 5:
            self.byte(((reg & 7) << 3) | (base & 7))
            self.sib(base)
        elif disp >= 0 - 128 && disp < 128:
            self.byte(64 | ((reg & 7) << 3) | (base & 7))
            self.sib(base)
            self.byte(disp)
        else:
            self.byte(128 | ((reg & 7) << 3) | (base & 7))
            self.sib(base)
            self.le32(disp)

    /#/ `opc` with a register and the memory operand `[base + idx * scale + disp]`.
    fn rmem_idx(self, w: int, opc: int, opc2: int, reg: int, base: int, idx: int, scale: int, disp: int, force: bool) => void:
        if self.bm && opc != 141 && base != 4 && base != 5 && !(base == 15 && idx == 13):
            let held = self.pfx
            self.pfx = 0 - 1
            self.rmem_idx(0, 141, 0 - 1, 13, base, idx, scale, disp, false)
            self.pfx = held
            self.rmem_idx(w, opc, opc2, reg, 15, 13, 1, 0, force)
            return
        if self.pfx >= 0:
            self.byte(self.pfx)
            self.pfx = 0 - 1
        let ss = 0
        if scale == 2:
            ss = 1
        elif scale == 4:
            ss = 2
        elif scale == 8:
            ss = 3
        let v = 64 | (w << 3) | ((reg >> 3) << 2) | ((idx >> 3) << 1) | (base >> 3)
        if self.sbx && !self.bm && opc != 141 && base != 4 && base != 5:
            self.byte(103)
            self.byte(101)
        if v != 64 || force:
            self.byte(v)
        self.byte(opc)
        if opc2 >= 0:
            self.byte(opc2)
        let md = 2
        if disp == 0 && (base & 7) != 5:
            md = 0
        elif disp >= 0 - 128 && disp < 128:
            md = 1
        self.byte((md << 6) | ((reg & 7) << 3) | 4)
        self.byte((ss << 6) | ((idx & 7) << 3) | (base & 7))
        if md == 1:
            self.byte(disp)
        elif md == 2:
            self.le32(disp)

    /#/ dst = the `n` bytes at [base + idx * scale + disp], zero-extended.
    fn load_idx(self, dst: int, base: int, idx: int, scale: int, disp: int, n: int) => void:
        if n == 1:
            self.rmem_idx(0, 15, 182, dst, base, idx, scale, disp, false)
        elif n == 2:
            self.rmem_idx(0, 15, 183, dst, base, idx, scale, disp, false)
        elif n == 4:
            self.rmem_idx(0, 139, 0 - 1, dst, base, idx, scale, disp, false)
        else:
            self.rmem_idx(1, 139, 0 - 1, dst, base, idx, scale, disp, false)

    /#/ The low `n` bytes of src to [base + idx * scale + disp].
    fn store_idx(self, base: int, idx: int, scale: int, disp: int, src: int, n: int) => void:
        if n == 1:
            self.rmem_idx(0, 136, 0 - 1, src, base, idx, scale, disp, true)
        elif n == 2:
            self.pfx = 102
            self.rmem_idx(0, 137, 0 - 1, src, base, idx, scale, disp, false)
        elif n == 4:
            self.rmem_idx(0, 137, 0 - 1, src, base, idx, scale, disp, false)
        else:
            self.rmem_idx(1, 137, 0 - 1, src, base, idx, scale, disp, false)

    /#/ rsp and r12 as a base need the byte that says "no index".
    fn sib(self, base: int) => void:
        if (base & 7) == 4:
            self.byte(36)

    /#/ dst = base + idx * scale (scale 1, 2, 4 or 8); idx is not rsp.
    fn lea_idx(self, dst: int, base: int, idx: int, scale: int) => void:
        let ss = 0
        if scale == 2:
            ss = 1
        elif scale == 4:
            ss = 2
        elif scale == 8:
            ss = 3
        self.byte(72 | ((dst >> 3) << 2) | ((idx >> 3) << 1) | (base >> 3))
        self.byte(141)
        if (base & 7) == 5:
            self.byte(68 | ((dst & 7) << 3))
            self.byte((ss << 6) | ((idx & 7) << 3) | (base & 7))
            self.byte(0)
        else:
            self.byte(4 | ((dst & 7) << 3))
            self.byte((ss << 6) | ((idx & 7) << 3) | (base & 7))

    /#/ dst = src * v
    fn imul_rri(self, dst: int, src: int, v: int) => void:
        self.rex(1, dst, src, false)
        if v >= 0 - 128 && v < 128:
            self.byte(107)
            self.byte(192 | ((dst & 7) << 3) | (src & 7))
            self.byte(v)
        else:
            self.byte(105)
            self.byte(192 | ((dst & 7) << 3) | (src & 7))
            self.le32(v)

    /#/ ---- moves -------------------------------------------------------------

    fn mov_rr(self, dst: int, src: int) => void:
        /#/ a move onto itself, or back what the move right before made, is nothing
        if dst == src:
            return
        if self.lm_end == self.c.n && self.lm_d == src && self.lm_s == dst:
            return
        self.rr(1, 139, 0 - 1, dst, src, false)
        self.lm_end = self.c.n
        self.lm_d = dst
        self.lm_s = src

    fn mov_ri(self, dst: int, v: int) => void:
        if v == 0:
            /#/ xor changes the flags: no code loads a constant between a compare and its branch
            if dst >= 8:
                self.byte(69)
            self.byte(49)
            self.byte(192 | ((dst & 7) << 3) | (dst & 7))
        elif v >= 0 && v < 4294967296:
            self.rex(0, 0, dst, false)
            self.byte(184 + (dst & 7))
            self.le32(v)
        elif v >= 0 - 2147483648 && v < 0:
            self.rex(1, 0, dst, false)
            self.byte(199)
            self.byte(192 | (dst & 7))
            self.le32(v)
        else:
            self.rex(1, 0, dst, false)
            self.byte(184 + (dst & 7))
            self.le64(v)

    /#/ dst = the `n` bytes at [base + disp], zero-extended.
    fn load(self, dst: int, base: int, disp: int, n: int) => void:
        if n == 1:
            self.rmem(0, 15, 182, dst, base, disp, false)
        elif n == 2:
            self.rmem(0, 15, 183, dst, base, disp, false)
        elif n == 4:
            self.rmem(0, 139, 0 - 1, dst, base, disp, false)
        else:
            if self.ls_end == self.c.n && self.ls_base == base && self.ls_disp == disp:
                /#/ what was just stored is still in its register
                self.mov_rr(dst, self.ls_reg)
                return
            self.rmem(1, 139, 0 - 1, dst, base, disp, false)

    /#/ The low `n` bytes of src to [base + disp].
    fn store(self, base: int, disp: int, src: int, n: int) => void:
        if n == 1:
            self.rmem(0, 136, 0 - 1, src, base, disp, true)
        elif n == 2:
            self.pfx = 102
            self.rmem(0, 137, 0 - 1, src, base, disp, false)
        elif n == 4:
            self.rmem(0, 137, 0 - 1, src, base, disp, false)
        else:
            self.rmem(1, 137, 0 - 1, src, base, disp, false)
            self.ls_end = self.c.n
            self.ls_base = base
            self.ls_disp = disp
            self.ls_reg = src

    fn lea(self, dst: int, base: int, disp: int) => void:
        self.rmem(1, 141, 0 - 1, dst, base, disp, false)

    /#/ dst = the address of rodata offset `off` (the symbol `rosym` is the section).
    fn lea_rip(self, dst: int, rosym: int, off: int) => void:
        if self.sbx:
            self.rex(0, 0, dst, false)
            self.byte(184 + (dst & 7))
            self.reloc(rosym, r_abs32(), off)
            return
        self.rex(1, dst, 0, false)
        self.byte(141)
        self.byte(5 | ((dst & 7) << 3))
        self.reloc(rosym, r_pc32(), off - 4)

    /#/ dst = src extended from its low `n` bytes.
    fn extend(self, dst: int, src: int, n: int, signed: bool) => void:
        if n == 8:
            if dst != src:
                self.mov_rr(dst, src)
        elif n == 4:
            if signed:
                self.rr(1, 99, 0 - 1, dst, src, false)
            else:
                self.rr(0, 139, 0 - 1, dst, src, false)
        elif n == 2:
            if signed:
                self.rr(1, 15, 191, dst, src, false)
            else:
                self.rr(0, 15, 183, dst, src, false)
        else:
            if signed:
                self.rr(1, 15, 190, dst, src, true)
            else:
                self.rr(0, 15, 182, dst, src, true)

    /#/ ---- integer arithmetic ------------------------------------------------

    fn add_rr(self, dst: int, src: int) => void:
        self.rr(1, 3, 0 - 1, dst, src, false)

    fn sub_rr(self, dst: int, src: int) => void:
        self.rr(1, 43, 0 - 1, dst, src, false)

    fn and_rr(self, dst: int, src: int) => void:
        self.rr(1, 35, 0 - 1, dst, src, false)

    fn or_rr(self, dst: int, src: int) => void:
        self.rr(1, 11, 0 - 1, dst, src, false)

    fn xor_rr(self, dst: int, src: int) => void:
        self.rr(1, 51, 0 - 1, dst, src, false)

    fn cmp_rr(self, a: int, b: int) => void:
        self.rr(1, 59, 0 - 1, a, b, false)

    fn test_rr(self, a: int, b: int) => void:
        self.rr(1, 133, 0 - 1, b, a, false)

    fn imul_rr(self, dst: int, src: int) => void:
        self.rr(1, 15, 175, dst, src, false)

    /#/ `ext` (add 0, sub 5, cmp 7) of a register and an immediate, in the short form when it fits
    fn alu_ri(self, ext: int, r: int, v: int) => void:
        self.rex(1, 0, r, false)
        if v >= 0 - 128 && v < 128:
            self.byte(131)
            self.byte(192 | (ext << 3) | (r & 7))
            self.byte(v)
        else:
            self.byte(129)
            self.byte(192 | (ext << 3) | (r & 7))
            self.le32(v)

    /#/ reg += imm (sub with `sub_ri`)
    fn add_ri(self, r: int, v: int) => void:
        self.alu_ri(0, r, v)

    fn sub_ri(self, r: int, v: int) => void:
        self.alu_ri(5, r, v)

    fn and_ri(self, r: int, v: int) => void:
        self.alu_ri(4, r, v)

    fn or_ri(self, r: int, v: int) => void:
        self.alu_ri(1, r, v)

    fn xor_ri(self, r: int, v: int) => void:
        self.alu_ri(6, r, v)

    fn cmp_ri(self, r: int, v: int) => void:
        if v == 0:
            self.test_rr(r, r)
        else:
            self.alu_ri(7, r, v)

    /#/ the group-3 instructions: not 2, neg 3, div 6, idiv 7
    fn grp3(self, ext: int, r: int) => void:
        self.rex(1, 0, r, false)
        self.byte(247)
        self.byte(192 | (ext << 3) | (r & 7))

    fn neg(self, r: int) => void:
        self.grp3(3, r)

    fn not_(self, r: int) => void:
        self.grp3(2, r)

    fn div(self, r: int) => void:
        self.grp3(6, r)

    fn idiv(self, r: int) => void:
        self.grp3(7, r)

    fn cqo(self) => void:
        self.byte(72)
        self.byte(153)

    /#/ r shifted by cl: shl 4, shr 5, sar 7
    fn shift_cl(self, ext: int, r: int) => void:
        self.rex(1, 0, r, false)
        self.byte(211)
        self.byte(192 | (ext << 3) | (r & 7))

    /#/ r shifted by the immediate (shr 5)
    fn shift_i(self, ext: int, r: int, n: int) => void:
        self.rex(1, 0, r, false)
        self.byte(193)
        self.byte(192 | (ext << 3) | (r & 7))
        self.byte(n)

    /#/ al-style: the byte register `r` = condition `cc`, then zero-extended
    fn setcc(self, cc: int, r: int) => void:
        self.rex(0, 0, r, true)
        self.byte(15)
        self.byte(144 + cc)
        self.byte(192 | (r & 7))
        self.extend(r, r, 1, false)

    /#/ ---- control flow ------------------------------------------------------

    fn jmp(self, l: int) => void:
        self.byte(233)
        self.rel_to(l, 0)

    fn jcc(self, cc: int, l: int) => void:
        self.byte(15)
        self.byte(128 + cc)
        self.rel_to(l, 1)

    fn call_sym(self, sym: int) => void:
        self.byte(232)
        self.reloc(sym, r_plt32(), 0 - 4)

    fn call_reg(self, r: int) => void:
        self.rex(0, 0, r, false)
        self.byte(255)
        self.byte(192 | (2 << 3) | (r & 7))

    fn push(self, r: int) => void:
        self.rex(0, 0, r, false)
        self.byte(80 + (r & 7))

    fn pop(self, r: int) => void:
        self.rex(0, 0, r, false)
        self.byte(88 + (r & 7))

    fn leave(self) => void:
        self.byte(201)

    fn ret(self) => void:
        self.byte(195)

    fn ud2(self) => void:
        self.byte(15)
        self.byte(11)

    /#/ ---- scalar floating point (values travel through the general registers) ----

    /#/ xmm = the bits in r (a double, or a float in the low 32 bits)
    fn movq_x(self, x: int, r: int, single: bool) => void:
        self.byte(102)
        if single:
            self.rr(0, 15, 110, x, r, false)
        else:
            self.rr(1, 15, 110, x, r, false)

    /#/ r = the bits of xmm
    fn movq_r(self, r: int, x: int, single: bool) => void:
        self.byte(102)
        if single:
            self.rr(0, 15, 126, x, r, false)
        else:
            self.rr(1, 15, 126, x, r, false)

    /#/ xmm `x` = the double or float at `sym` + the addend (set later by the caller through the relocation
    /#/ this makes, the last one): for a constant kept after the code of the function
    fn load_x_sym(self, x: int, single: bool, sym: int) => void:
        if single:
            self.byte(243)
        else:
            self.byte(242)
        self.rex(0, x, 0, false)
        self.byte(15)
        self.byte(16)
        self.byte(5 | ((x & 7) << 3))
        self.reloc(sym, r_pc32(), 0)

    /#/ xmm `x` = the 16 bytes at [base + idx * scale + disp] (unaligned)
    fn vload(self, x: int, base: int, idx: int, scale: int, disp: int) => void:
        self.rmem_idx(0, 15, 16, x, base, idx, scale, disp, false)

    /#/ [base + idx * scale + disp] = the 16 bytes of xmm `x`
    fn vstore(self, base: int, idx: int, scale: int, x: int, disp: int) => void:
        self.rmem_idx(0, 15, 17, x, base, idx, scale, disp, false)

    /#/ A packed instruction `0F opc` on two xmm registers, with the prefix 66 when `pfx` is set.
    fn vec_op(self, pfx: bool, opc: int, dst: int, src: int) => void:
        if pfx:
            self.byte(102)
        self.rr(0, 15, opc, dst, src, false)

    /#/ xmm `x` = its low 8 bytes twice
    fn splat_q(self, x: int) => void:
        self.vec_op(true, 108, x, x)

    /#/ xmm dst = xmm src (all 128 bits)
    fn movaps(self, dst: int, src: int) => void:
        self.rr(0, 15, 40, dst, src, false)

    /#/ xmm dst = dst xor xmm src
    fn xorps(self, dst: int, src: int) => void:
        self.rr(0, 15, 87, dst, src, false)

    /#/ xmm = the float or double at [base + disp]
    fn load_x(self, x: int, base: int, disp: int, single: bool) => void:
        if single:
            self.pfx = 243
        else:
            self.pfx = 242
        self.rmem(0, 15, 16, x, base, disp, false)

    /#/ [base + disp] = the float or double in xmm
    fn store_x(self, base: int, disp: int, x: int, single: bool) => void:
        if single:
            self.pfx = 243
        else:
            self.pfx = 242
        self.rmem(0, 15, 17, x, base, disp, false)

    fn load_x_idx(self, x: int, base: int, idx: int, scale: int, disp: int, single: bool) => void:
        if single:
            self.pfx = 243
        else:
            self.pfx = 242
        self.rmem_idx(0, 15, 16, x, base, idx, scale, disp, false)

    fn store_x_idx(self, base: int, idx: int, scale: int, disp: int, x: int, single: bool) => void:
        if single:
            self.pfx = 243
        else:
            self.pfx = 242
        self.rmem_idx(0, 15, 17, x, base, idx, scale, disp, false)

    /#/ the arithmetic ops: add 88, mul 89, sub 92, div 94 on xmm registers
    fn sse(self, op: int, single: bool, dst: int, src: int) => void:
        if single:
            self.byte(243)
        else:
            self.byte(242)
        self.rr(0, 15, op, dst, src, false)

    /#/ ucomisd / ucomiss
    fn ucomi(self, single: bool, a: int, b: int) => void:
        if !single:
            self.byte(102)
        self.rr(0, 15, 46, a, b, false)

    /#/ xmm = (double or float) of the signed 64-bit integer in r
    fn cvt_si2f(self, x: int, r: int, single: bool) => void:
        if single:
            self.byte(243)
        else:
            self.byte(242)
        self.rr(1, 15, 42, x, r, false)

    /#/ r = the 64-bit integer of the double or float in xmm, truncated
    fn cvt_f2si(self, r: int, x: int, single: bool) => void:
        if single:
            self.byte(243)
        else:
            self.byte(242)
        self.rr(1, 15, 44, r, x, false)

    /#/ double <-> float
    fn cvt_ff(self, dst: int, src: int, to_single: bool) => void:
        if to_single:
            self.byte(242)
        else:
            self.byte(243)
        self.rr(0, 15, 90, dst, src, false)

fn new_asm() => Asm:
    return Asm { c: new_txt(), lab: new_buf(int, 64), nlab: 0, fx_at: new_buf(int, 64), fx_lab: new_buf(int, 64), fx_kind: new_buf(int, 64), nfx: 0, fs: 0, rl0: 0, rl_at: new_buf(int, 64), rl_sym: new_buf(int, 64), rl_ty: new_buf(int, 64), rl_add: new_buf(int, 64), nrl: 0, lm_end: -1, lm_d: 0, lm_s: 0, ls_end: -1, ls_base: 0, ls_disp: 0, ls_reg: 0, sbx: false, bm: false, pfx: 0 - 1 }


class Obj:
    ro: Txt
    /#/ the string table: names, each ended by a NUL, after a NUL
    names: Txt
    s_name: buf<int>
    s_def: buf<int>
    s_size: buf<int>
    /#/ the section a symbol is defined in: 1 `.text`, 8 `.data`
    s_sec: buf<int>
    /#/ the initialized data
    data: Txt
    ns: int
    /#/ open-addressing index of the symbols by name: symbol number + 1, 0 for a free place (a power of two long)
    hx: buf<int>
    /#/ the line table (see `lines_dump`) for the linker, in a section `.cf_lines`; empty for none
    dbg: Txt

    /#/ The symbol (object number) named like `w`, made when new.
    fn sym(self, w: &Txt) => int:
        let mask = len(self.hx) - 1
        let h = 0 - 3750763034362895579
        for q in 0..w.n:
            h = (h ^ int(w.b[q])) * 1099511628211
        let slot = (h >> 7) & mask
        while self.hx[slot] != 0:
            let k = self.hx[slot] - 1
            let at = self.s_name[k]
            if at + w.n < self.names.n:
                let q = 0
                while q < w.n && self.names.b[at + q] == w.b[q]:
                    q = q + 1
                if q == w.n && self.names.b[at + w.n] == 0:
                    return k + 2
            slot = (slot + 1) & mask
        if self.ns >= len(self.s_name):
            let cap = (self.ns + 1) * 2
            self.s_name = buf_resize(self.s_name, cap)
            self.s_def = buf_resize(self.s_def, cap)
            self.s_size = buf_resize(self.s_size, cap)
            self.s_sec = buf_resize(self.s_sec, cap)
        self.s_name[self.ns] = self.names.n
        self.s_def[self.ns] = 0 - 1
        self.s_size[self.ns] = 0
        self.s_sec[self.ns] = 1
        self.names.put_all(w)
        self.names.put_byte(0)
        self.hx[slot] = self.ns + 1
        self.ns = self.ns + 1
        if self.ns * 2 > len(self.hx):
            self.regrow()
        return self.ns + 1

    /#/ The index again, twice as long.
    fn regrow(self) => void:
        self.hx = new_buf(int, len(self.hx) * 2)
        let mask = len(self.hx) - 1
        for k in 0..self.ns:
            let h = 0 - 3750763034362895579
            let at = self.s_name[k]
            while self.names.b[at] != 0:
                h = (h ^ int(self.names.b[at])) * 1099511628211
                at = at + 1
            let slot = (h >> 7) & mask
            while self.hx[slot] != 0:
                slot = (slot + 1) & mask
            self.hx[slot] = k + 1

    fn dump_ro(self, t: &Txt) => void:
        t.put_all(&self.ro)

    fn dump_data(self, t: &Txt) => void:
        t.put_all(&self.data)

    fn dump_str(self, t: &Txt) => void:
        t.put_all(&self.names)

    fn define(self, sym: int, at: int, size: int) => void:
        self.s_def[sym - 2] = at
        self.s_size[sym - 2] = size

    /#/ Makes `size` zero bytes of `.data` the object `sym`.
    fn define_data(self, sym: int, size: int) => void:
        while self.data.n % 8 != 0:
            self.data.put_byte(0)
        self.s_def[sym - 2] = self.data.n
        self.s_size[sym - 2] = size
        self.s_sec[sym - 2] = 8
        for k in 0..size:
            self.data.put_byte(0)

    /#/ Adds `bytes` (and a NUL) to `.rodata`; the offset they start at.
    fn rodata(self, bytes: &Txt) => int:
        let at = self.ro.n
        self.ro.put_all(bytes)
        self.ro.put_byte(0)
        return at

fn new_obj() => Obj:
    let nm = new_txt()
    nm.put_byte(0)
    let o = Obj { ro: new_txt(), names: nm, s_name: new_buf(int, 16), s_def: new_buf(int, 16), s_size: new_buf(int, 16), s_sec: new_buf(int, 16), data: new_txt(), ns: 0, hx: new_buf(int, 256), dbg: new_txt() }
    /#/ the zero block that stands in for `undef` aggregates
    for k in 0..256:
        o.ro.put_byte(0)
    return o

fn w16(t: &Txt, v: int) => void:
    for k in 0..2:
        t.put_byte((v >> (8 * k)) & 255)

fn w32(t: &Txt, v: int) => void:
    for k in 0..4:
        t.put_byte((v >> (8 * k)) & 255)

fn w64(t: &Txt, v: int) => void:
    for k in 0..8:
        t.put_byte((v >> (8 * k)) & 255)

fn pad_to(t: &Txt, align: int) => void:
    while t.n % align != 0:
        t.put_byte(0)

/#/ One section header.
fn shdr(t: &Txt, name: int, ty: int, flags: int, off: int, size: int, link: int, info: int, align: int, ent: int) => void:
    w32(t, name)
    w32(t, ty)
    w64(t, flags)
    w64(t, 0)
    w64(t, off)
    w64(t, size)
    w32(t, link)
    w32(t, info)
    w64(t, align)
    w64(t, ent)

/#/ The object file.
fn write_elf(o: &Obj, a: &Asm) => Txt:
    let out = new_txt()
    /#/ section names
    let sh = new_txt()
    sh.put_byte(0)
    let n_text = sh.n
    sh.put(".text")
    sh.put_byte(0)
    let n_ro = sh.n
    sh.put(".rodata")
    sh.put_byte(0)
    let n_rela = sh.n
    sh.put(".rela.text")
    sh.put_byte(0)
    let n_note = sh.n
    sh.put(".note.GNU-stack")
    sh.put_byte(0)
    let n_sym = sh.n
    sh.put(".symtab")
    sh.put_byte(0)
    let n_str = sh.n
    sh.put(".strtab")
    sh.put_byte(0)
    let n_shs = sh.n
    sh.put(".shstrtab")
    sh.put_byte(0)
    let n_data = sh.n
    sh.put(".data")
    sh.put_byte(0)
    /#/ the functions: the defined `.text` symbols, in the order they were assembled
    let fn_sym: buf<int> = new_buf(int, o.ns + 1)
    let fn_of: buf<int> = new_buf(int, o.ns + 1)
    let nf = 0
    for k in 0..o.ns:
        fn_of[k] = 0 - 1
        if o.s_def[k] >= 0 && o.s_sec[k] == 1:
            fn_sym[nf] = k
            fn_of[k] = nf
            nf = nf + 1
    /#/ in address order (the symbols were made in the order the names came up)
    let gap = nf // 2
    while gap > 0:
        for i in gap..nf:
            let x = fn_sym[i]
            let j = i
            while j >= gap && o.s_def[fn_sym[j - gap]] > o.s_def[x]:
                fn_sym[j] = fn_sym[j - gap]
                j = j - gap
            fn_sym[j] = x
        gap = gap // 2
    for j in 0..nf:
        fn_of[fn_sym[j]] = j
    if 9 + 2 * nf > 65000:
        say(f"elf: {nf} functions in one object are too many\n")
        return new_txt()
    let fn_tn: buf<int> = new_buf(int, nf + 1)
    let fn_rn: buf<int> = new_buf(int, nf + 1)
    for j in 0..nf:
        let at = o.s_name[fn_sym[j]]
        fn_tn[j] = sh.n
        sh.put(".text.")
        while o.names.b[at] != 0:
            sh.put_byte(o.names.b[at])
            at = at + 1
        sh.put_byte(0)
        at = o.s_name[fn_sym[j]]
        fn_rn[j] = sh.n
        sh.put(".rela.text.")
        while o.names.b[at] != 0:
            sh.put_byte(o.names.b[at])
            at = at + 1
        sh.put_byte(0)
    let n_dbg = sh.n
    let ndbg = 0
    if o.dbg.n > 0:
        sh.put(".cf_lines")
        sh.put_byte(0)
        ndbg = 1
    /#/ relocations and symbols
    /#/ the relocations of each function, offsets from its start; they were recorded in code order
    let rela = new_txt()
    let fn_ra: buf<int> = new_buf(int, nf + 1)
    let fn_rz: buf<int> = new_buf(int, nf + 1)
    let cur = 0
    for k in 0..a.nrl:
        let at = a.rl_at[k]
        while cur < nf && at >= o.s_def[fn_sym[cur]] + o.s_size[fn_sym[cur]]:
            cur = cur + 1
        if cur >= nf || at < o.s_def[fn_sym[cur]]:
            say(f"elf: a relocation at {at} is in no function\n")
            return new_txt()
        if fn_rz[cur] == 0:
            fn_ra[cur] = rela.n
        w64(&rela, at - o.s_def[fn_sym[cur]])
        w64(&rela, (a.rl_sym[k] << 32) | a.rl_ty[k])
        w64(&rela, a.rl_add[k])
        fn_rz[cur] = fn_rz[cur] + 24
    let syms = new_txt()
    for k in 0..24:
        syms.put_byte(0)
    w32(&syms, 0)
    syms.put_byte(3)
    syms.put_byte(0)
    w16(&syms, 2)
    w64(&syms, 0)
    w64(&syms, 0)
    for k in 0..o.ns:
        w32(&syms, o.s_name[k])
        if o.s_def[k] >= 0:
            if o.s_sec[k] == 8:
                syms.put_byte(17)
            else:
                syms.put_byte(18)
            syms.put_byte(0)
            if fn_of[k] >= 0:
                w16(&syms, 9 + 2 * fn_of[k])
                w64(&syms, 0)
            else:
                w16(&syms, o.s_sec[k])
                w64(&syms, o.s_def[k])
            w64(&syms, o.s_size[k])
        else:
            syms.put_byte(16)
            syms.put_byte(0)
            w16(&syms, 0)
            w64(&syms, 0)
            w64(&syms, 0)
    /#/ layout
    for k in 0..64:
        out.put_byte(0)
    let off_text = out.n
    let fn_off: buf<int> = new_buf(int, nf + 1)
    for j in 0..nf:
        pad_to(&out, 16)
        fn_off[j] = out.n
        for q in 0..o.s_size[fn_sym[j]]:
            out.put_byte(a.c.b[o.s_def[fn_sym[j]] + q])
    pad_to(&out, 16)
    let off_ro = out.n
    o.dump_ro(&out)
    pad_to(&out, 8)
    let off_data = out.n
    o.dump_data(&out)
    pad_to(&out, 8)
    let off_rela = out.n
    out.put_all(&rela)
    let off_dbg = out.n
    out.put_all(&o.dbg)
    let off_sym = out.n
    out.put_all(&syms)
    let off_str = out.n
    o.dump_str(&out)
    let off_shs = out.n
    out.put_all(&sh)
    pad_to(&out, 8)
    let off_sh = out.n
    shdr(&out, 0, 0, 0, 0, 0, 0, 0, 0, 0)
    shdr(&out, n_text, 1, 6, off_text, 0, 0, 0, fn_align, 0)
    shdr(&out, n_ro, 1, 2, off_ro, o.ro.n, 0, 0, 16, 0)
    shdr(&out, n_rela, 4, 64, off_rela, 0, 5, 1, 8, 24)
    shdr(&out, n_note, 1, 0, off_shs, 0, 0, 0, 1, 0)
    shdr(&out, n_sym, 2, 0, off_sym, syms.n, 6, 2, 8, 24)
    shdr(&out, n_str, 3, 0, off_str, o.names.n, 0, 0, 1, 0)
    shdr(&out, n_shs, 3, 0, off_shs, sh.n, 0, 0, 1, 0)
    shdr(&out, n_data, 1, 3, off_data, o.data.n, 0, 0, 8, 0)
    for j in 0..nf:
        shdr(&out, fn_tn[j], 1, 6, fn_off[j], o.s_size[fn_sym[j]], 0, 0, fn_align, 0)
        shdr(&out, fn_rn[j], 4, 64, off_rela + fn_ra[j], fn_rz[j], 5, 9 + 2 * j, 8, 24)
    if ndbg == 1:
        shdr(&out, n_dbg, 1, 0, off_dbg, o.dbg.n, 0, 0, 1, 0)
    /#/ the file header, over the zeros at the start
    let h = new_txt()
    h.put_byte(127)
    h.put("ELF")
    h.put_byte(2)
    h.put_byte(1)
    h.put_byte(1)
    for k in 0..9:
        h.put_byte(0)
    w16(&h, 1)
    w16(&h, 62)
    w32(&h, 1)
    w64(&h, 0)
    w64(&h, 0)
    w64(&h, off_sh)
    w32(&h, 0)
    w16(&h, 64)
    w16(&h, 0)
    w16(&h, 0)
    w16(&h, 64)
    w16(&h, 9 + 2 * nf + ndbg)
    w16(&h, 7)
    for k in 0..64:
        out.b[k] = h.b[k]
    return out

/#/ Descriptions of types for the debug table (`-O0 -g`), one line each in the table the linker makes
/#/ DWARF of (see `ld/src/dwarf.cf`):
/#/
/#/     T id i size signed        an integer (an enum without payloads too)
/#/     T id f size               a float
/#/     T id b                    a bool
/#/     T id s                    a string (a pointer to its text)
/#/     T id p target             a pointer to the type `target` (-1: to nothing)
/#/     T id S name size n field:type:offset ...      a struct
/#/     T id o size               bytes of no known shape
/#/
/#/ The type of a variable is the one `dbg_type` returns: a class variable holds a pointer, so its type
/#/ is the pointer to the struct (id 1000000 + the class's type).
/#/ The storage of every type, computed in one place. See STORAGE.md for the table this
/#/ implements; every function here is that table, row by row.
/#/ The declaration pass: every function, method, field, variant and alias of a module gets
/#/ its type before any body is checked, so bodies may use names declared later. The type is
/#/ stored in `ty` of the symbol's row in the globals table.
/#/ Reads types in the scope of a module: the names that module sees, aliases and type
/#/ parameters included, with their types in `ty`.
/#/ From the tokens of a TypeRef to a type id, and back to text for messages and tests.
/#/ The type table of the type checker.
/#/
/#/ A type is a row of four `buf<int>` columns and has an id. Types are hash-consed, so two
/#/ types are the same type exactly when their ids are equal. Operands:
/#/
/#/   Error                         the type of an expression that is already reported wrong
/#/   Void, Bool, Str, Object
/#/   Int     a=bytes  b=1 signed    Float  a=bytes
/#/   Buf     a=element (-1: the raw C pointer `buf`)     Slice  a=element
/#/   Array   a=element  b=length
/#/   Ref     a=target  b=1 for `&mut`
/#/   Tuple   a=first argument  b=count
/#/   Fn      a=first argument  b=count (parameters)  c=return type
/#/   Named   a=symbol row of the class or enum  b=first argument  c=count (type arguments)
/#/   Param   a=the type parameter's number
/#/
/#/ Argument lists (tuple elements, parameters, type arguments) live in one pool.
/#/ Semantic analysis: name resolution and declaration checks over the parser's tree.
/#/
/#/ Two steps. `declare_module` adds a module's top-level names to the globals table; `check`
/#/ then walks one module with its own scope table (builtins, own and imported names, then
/#/ locals) and reports undefined and duplicate names, unknown types, call arity, struct
/#/ literal fields, loop and return placement, and functions that can fall off their end.
/#/ Types of expressions are not computed here; that is the type checker's job.
/#/ Diagnostics of the semantic analyzer. Error codes follow the Rust compiler's where
/#/ one exists (E101 undefined type, E103 arity, E106 field, E200 undefined name, E201
/#/ duplicate, E600 missing return); the rest have no Rust counterpart yet.

enum Sc:
    UndefinedName
    DuplicateName
    UndefinedType
    ArityMismatch
    UnknownField
    MissingField
    MissingReturn
    BreakOutsideLoop
    ContinueOutsideLoop
    ReturnOutsideFn
    ReturnValueInVoid
    MissingReturnValue
    UnknownModule
    UnknownImport
    UnknownParent
    NotAClass
    CaptureViolation
    UnusedVariable
    DuplicateMain
    UnknownMethod
    UnknownCSymbol

/#/ Rust's code for each diagnostic, for messages.
fn sc_number(code: int) => int:
    if code == int(Sc.UndefinedName):
        return 200
    if code == int(Sc.DuplicateName):
        return 201
    if code == int(Sc.UndefinedType):
        return 101
    if code == int(Sc.ArityMismatch):
        return 103
    if code == int(Sc.UnknownField) || code == int(Sc.MissingField):
        return 106
    if code == int(Sc.MissingReturn) || code == int(Sc.CaptureViolation):
        return 600
    if code == int(Sc.BreakOutsideLoop) || code == int(Sc.ContinueOutsideLoop):
        return 111
    if code == int(Sc.DuplicateMain):
        return 1
    if code == int(Sc.UnknownMethod):
        return 107
    return 700 + code

/#/ Only an unused variable is a warning.
fn sc_is_warning(code: int) => bool:
    return code == int(Sc.UnusedVariable)

class Diags:
    tok: buf<int>
    code: buf<int>
    n: int

    fn add(self, tok: int, code: int) => void:
        if self.n >= len(self.tok):
            self.tok = buf_resize(self.tok, (self.n + 1) * 2)
            self.code = buf_resize(self.code, (self.n + 1) * 2)
        self.tok[self.n] = tok
        self.code[self.n] = code
        self.n = self.n + 1

    fn errors(self) => int:
        let c = 0
        for i in 0..self.n:
            if !sc_is_warning(self.code[i]):
                c = c + 1
        return c

    fn warnings(self) => int:
        return self.n - self.errors()

    fn count(self, code: int) => int:
        let c = 0
        for i in 0..self.n:
            if self.code[i] == code:
                c = c + 1
        return c

fn new_diags() => Diags:
    return Diags { tok: new_buf(int, 8), code: new_buf(int, 8), n: 0 }

/#/ Symbol table of the semantic analyzer: names with a kind, kept as bytes in one pool so
/#/ a name read from one module's source can be compared with one read from another.
/#/
/#/ One table serves two purposes. The *globals* table holds every module's top-level
/#/ names; the checker builds a *scope* table per module (builtins, own and imported
/#/ names) and pushes and pops locals on it, so a lookup is one scan from the top.
/#/ Coffee parser, written in Coffee: tokens in, node table out. See `ast.cf` for the
/#/ shape of the table. Parsing never aborts: a malformed construct becomes an Error
/#/ node, is recorded in the error table and parsing resumes at the next statement.
/#/ Coffee lexer, written in Coffee.
/#/
/#/ `lex` turns source text into a `Tokens` table. Lexemes are never copied:
/#/ a token is a kind plus the byte range [start, end) of the source it came
/#/ from, and a 1-based line/column. Layout follows Python: NEWLINE, INDENT and
/#/ DEDENT tokens are synthesised from indentation, and newlines inside
/#/ brackets or after a trailing binary operator do not end a statement.
/#/ Malformed input never aborts; it becomes an `Error` token.
/#/ Token kinds of the Coffee lexer.
/#/
/#/ Kinds are stored as plain ints (`int(Tk.Ident)`) so a token stream is a
/#/ handful of `buf<int>` columns. The keyword block is contiguous and ordered
/#/ like `KEYWORDS`; the binary-operator block (Plus..Ge) is contiguous too.
enum Tk:
    Eof
    Error
    Newline
    Indent
    Dedent
    Ident
    Int
    Float
    Str
    FStr
    Char
    Listener
    KwFn
    KwC
    KwClass
    KwType
    KwPacked
    KwEnum
    KwOf
    KwIf
    KwElif
    KwElse
    KwWhile
    KwFor
    KwIn
    KwMatch
    KwLet
    KwMv
    KwClone
    KwCopy
    KwRm
    KwClean
    KwRaise
    KwReturn
    KwBreak
    KwContinue
    KwUse
    KwAs
    KwTrue
    KwFalse
    KwInt
    KwFloat
    KwBool
    KwString
    KwStr
    KwVoid
    Plus
    Minus
    Star
    Slash
    Percent
    SlashSlash
    Amp
    Pipe
    Caret
    Shl
    Shr
    AmpAmp
    PipePipe
    EqEq
    NotEq
    Lt
    Le
    Gt
    Ge
    Bang
    Tilde
    Assign
    Arrow
    ColonColon
    DotDot
    Dot
    Comma
    Colon
    LParen
    RParen
    LBracket
    RBracket
    LBrace
    RBrace
    Semi
    PlusEq
    MinusEq
    StarEq
    SlashEq
    PercentEq
    SlashSlashEq


class Tokens:
    kind: buf<int>
    start: buf<int>
    end: buf<int>
    line: buf<int>
    col: buf<int>
    count: int

    fn push(self, kind: int, start: int, end: int, line: int, col: int) => void:
        let at = self.count
        if at >= len(self.kind):
            let cap = (at + 1) * 2
            self.kind = buf_resize(self.kind, cap)
            self.start = buf_resize(self.start, cap)
            self.end = buf_resize(self.end, cap)
            self.line = buf_resize(self.line, cap)
            self.col = buf_resize(self.col, cap)
        self.kind[at] = kind
        self.start[at] = start
        self.end[at] = end
        self.line[at] = line
        self.col[at] = col
        self.count = at + 1

    fn last_kind(self) => int:
        if self.count == 0:
            return -1
        return self.kind[self.count - 1]

    fn kind_at(self, i: int) => int:
        if i < 0 || i >= self.count:
            return -1
        return self.kind[i]

fn new_tokens() => Tokens:
    return Tokens { kind: new_buf(int, 64), start: new_buf(int, 64), end: new_buf(int, 64), line: new_buf(int, 64), col: new_buf(int, 64), count: 0 }

/#/ ---- character classes -------------------------------------------------

fn byte(src: &str, i: int) => int:
    if i < 0 || i >= len(src):
        return 0
    return int(src[i])

/#/ The length of the source being lexed. Indexing a `str` costs a walk to its NUL (the bounds
/#/ check), so `lex_into` copies the source into a `buf<int>` of bytes and the scanners read that.
let lexed_len = 0

/#/ Byte `i` of the source being lexed; 0 outside it.
fn sbyte(src: &buf<int>, i: int) => int:
    if i < 0 || i >= lexed_len:
        return 0
    return src[i]

fn is_digit(c: int) => bool:
    return c >= '0' && c <= '9'

fn is_hex(c: int) => bool:
    return is_digit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')

fn is_alpha(c: int) => bool:
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'

fn is_ident(c: int) => bool:
    return is_alpha(c) || is_digit(c)

/#/ ---- keywords ----------------------------------------------------------

/#/ The keywords, separated by spaces, in the order of the `Kw` token kinds from `KwFn` on.
fn keyword_table() => str:
    return "fn c class type packed enum of if elif else while for in match let mv clone copy rm clean raise return break continue use as true false int float bool string str void"

/#/ The keyword text with, after it, their number and the (start, length) of each.
fn keyword_index(text: &buf<int>, tn: int) => buf<int>:
    let nk = 0
    for p in 0..tn:
        if text[p] == ' ':
            nk = nk + 1
    nk = nk + 1
    let out: buf<int> = new_buf(int, tn + 2 + 2 * nk)
    for p in 0..tn:
        out[p] = text[p]
    out[tn] = nk
    let idx = 0
    let p = 0
    while p < tn:
        let q = p
        while q < tn && text[q] != ' ':
            q = q + 1
        out[tn + 1 + 2 * idx] = p
        out[tn + 2 + 2 * idx] = q - p
        idx = idx + 1
        p = q + 1
    return out

fn keyword_scan(src: &buf<int>, s: int, e: int, table: &buf<int>, tn: int) => int:
    let n = e - s
    /#/ the longest keyword is `continue`; no keyword starts with any other letter than these
    if n > 8:
        return -1
    let c0 = sbyte(src, s)
    if c0 < 'a' || c0 > 'w' || c0 == 'd' || c0 == 'g' || c0 == 'h' || c0 == 'j' || c0 == 'k' || c0 == 'n' || c0 == 'q':
        return -1
    /#/ `table` holds the text, then the number of keywords and a (start, length) pair for each
    let nk = table[tn]
    let idx = 0
    while idx < nk:
        let p = table[tn + 1 + 2 * idx]
        if table[tn + 2 + 2 * idx] == n && table[p] == c0:
            let same = true
            for k in 1..n:
                if sbyte(src, s + k) != table[p + k]:
                    same = false
                    break
            if same:
                return idx
        idx = idx + 1
    return -1

/#/ Token kind of the word at [s, e): a keyword kind or Ident.
fn word_kind(src: &buf<int>, s: int, e: int, table: &buf<int>, tn: int) => int:
    let idx = keyword_scan(src, s, e, table, tn)
    if idx < 0:
        return int(Tk.Ident)
    return int(Tk.KwFn) + idx

/#/ ---- operators ---------------------------------------------------------

/#/ Kind of the two-byte operator (a, b), or -1.
fn op2_kind(a: int, b: int) => int:
    if a == '/' && b == '/':
        return int(Tk.SlashSlash)
    if b == '=':
        if a == '+':
            return int(Tk.PlusEq)
        if a == '-':
            return int(Tk.MinusEq)
        if a == '*':
            return int(Tk.StarEq)
        if a == '/':
            return int(Tk.SlashEq)
        if a == '%':
            return int(Tk.PercentEq)
    if a == '<' && b == '<':
        return int(Tk.Shl)
    if a == '>' && b == '>':
        return int(Tk.Shr)
    if a == '&' && b == '&':
        return int(Tk.AmpAmp)
    if a == '|' && b == '|':
        return int(Tk.PipePipe)
    if a == '=' && b == '=':
        return int(Tk.EqEq)
    if a == '!' && b == '=':
        return int(Tk.NotEq)
    if a == '<' && b == '=':
        return int(Tk.Le)
    if a == '>' && b == '=':
        return int(Tk.Ge)
    if a == '=' && b == '>':
        return int(Tk.Arrow)
    if a == ':' && b == ':':
        return int(Tk.ColonColon)
    if a == '.' && b == '.':
        return int(Tk.DotDot)
    return -1

/#/ Kind of the one-byte operator or delimiter c, or -1.
fn op1_kind(c: int) => int:
    if c == '+':
        return int(Tk.Plus)
    if c == '-':
        return int(Tk.Minus)
    if c == '*':
        return int(Tk.Star)
    if c == '/':
        return int(Tk.Slash)
    if c == '%':
        return int(Tk.Percent)
    if c == '&':
        return int(Tk.Amp)
    if c == '|':
        return int(Tk.Pipe)
    if c == '^':
        return int(Tk.Caret)
    if c == '<':
        return int(Tk.Lt)
    if c == '>':
        return int(Tk.Gt)
    if c == '!':
        return int(Tk.Bang)
    if c == '~':
        return int(Tk.Tilde)
    if c == '=':
        return int(Tk.Assign)
    if c == '.':
        return int(Tk.Dot)
    if c == ',':
        return int(Tk.Comma)
    if c == ';':
        return int(Tk.Semi)
    if c == ':':
        return int(Tk.Colon)
    if c == '(':
        return int(Tk.LParen)
    if c == ')':
        return int(Tk.RParen)
    if c == '[':
        return int(Tk.LBracket)
    if c == ']':
        return int(Tk.RBracket)
    if c == '{':
        return int(Tk.LBrace)
    if c == '}':
        return int(Tk.RBrace)
    return -1

/#/ A statement continues on the next line after these (Plus..Ge and `=`).
fn continues_line(kind: int) => bool:
    return (kind >= int(Tk.Plus) && kind <= int(Tk.Ge)) || kind == int(Tk.Assign) || (kind >= int(Tk.PlusEq) && kind <= int(Tk.SlashSlashEq))

/#/ True when the stream ends in the type suffix `int(4)+` / `float(8)-`,
/#/ whose trailing sign is part of the type and does not continue the line.
fn ends_in_size_suffix(t: &Tokens) => bool:
    let n = t.count
    if n < 5:
        return false
    let k = t.kind[n - 1]
    if k != int(Tk.Plus) && k != int(Tk.Minus):
        return false
    if t.kind[n - 2] != int(Tk.RParen) || t.kind[n - 3] != int(Tk.Int) || t.kind[n - 4] != int(Tk.LParen):
        return false
    return t.kind[n - 5] == int(Tk.KwInt) || t.kind[n - 5] == int(Tk.KwFloat)

/#/ True when the stream ends in `>` or `>>` that closes a `<` earlier on the same
/#/ line (`buf<int>`), which is a type, not a trailing comparison.
fn ends_in_type_args(t: &Tokens) => bool:
    let n = t.count
    if n < 2:
        return false
    let k = t.kind[n - 1]
    if k != int(Tk.Gt) && k != int(Tk.Shr):
        return false
    let i = n - 2
    while i >= 0:
        let q = t.kind[i]
        if q == int(Tk.Newline) || q == int(Tk.Indent) || q == int(Tk.Dedent):
            return false
        if q == int(Tk.Lt):
            return true
        i = i - 1
    return false

/#/ ---- literals ----------------------------------------------------------

/#/ End (exclusive) of the digits/underscores run starting at i that satisfy
/#/ the radix: 2, 8, 10 or 16.
fn scan_digits(src: &buf<int>, i: int, radix: int) => int:
    let j = i
    while true:
        let c = sbyte(src, j)
        let ok = c == '_'
        if radix == 16:
            ok = ok || is_hex(c)
        elif radix == 2:
            ok = ok || c == '0' || c == '1'
        elif radix == 8:
            ok = ok || (c >= '0' && c <= '7')
        else:
            ok = ok || is_digit(c)
        if !ok:
            break
        j = j + 1
    return j

fn skip_ident(src: &buf<int>, i: int) => int:
    let j = i
    while is_ident(sbyte(src, j)):
        j = j + 1
    return j

/#/ Scans a number starting at i. Returns the end, negated when malformed.
/#/ Whether it is a float is a separate question: `number_is_float`.
fn scan_number(src: &buf<int>, i: int) => int:
    let c0 = sbyte(src, i)
    let c1 = sbyte(src, i + 1)
    let j = i
    if c0 == '0' && (c1 == 'x' || c1 == 'X' || c1 == 'b' || c1 == 'B' || c1 == 'o' || c1 == 'O'):
        let radix = 16
        if c1 == 'b' || c1 == 'B':
            radix = 2
        elif c1 == 'o' || c1 == 'O':
            radix = 8
        j = scan_digits(src, i + 2, radix)
        if j == i + 2 || is_ident(sbyte(src, j)):
            return 0 - (skip_ident(src, j) + 1)
        return j
    j = scan_digits(src, i, 10)
    if sbyte(src, j) == '.' && is_digit(sbyte(src, j + 1)):
        j = scan_digits(src, j + 1, 10)
    let e = sbyte(src, j)
    if e == 'e' || e == 'E':
        let k = j + 1
        let sg = sbyte(src, k)
        if sg == '+' || sg == '-':
            k = k + 1
        if is_digit(sbyte(src, k)):
            j = scan_digits(src, k, 10)
    if is_ident(sbyte(src, j)):
        return 0 - (skip_ident(src, j) + 1)
    return j

fn number_is_float(src: &buf<int>, s: int, e: int) => bool:
    if sbyte(src, s) == '0':
        let c1 = sbyte(src, s + 1)
        if c1 == 'x' || c1 == 'X' || c1 == 'b' || c1 == 'B' || c1 == 'o' || c1 == 'O':
            return false
    for k in s..e:
        let c = sbyte(src, k)
        if c == '.' || c == 'e' || c == 'E':
            return true
    return false

/#/ Validates the escape whose backslash is at i; returns its length or 0.
fn escape_len(src: &buf<int>, i: int) => int:
    let c = sbyte(src, i + 1)
    if c == 'n' || c == 't' || c == 'r' || c == '\\' || c == '"' || c == '\'' || c == '0':
        return 2
    if c == 'x' && is_hex(sbyte(src, i + 2)) && is_hex(sbyte(src, i + 3)):
        return 4
    return 0

/#/ Scans a string whose opening quote is at i. Returns the end past the
/#/ closing quote, negated when the string is unterminated or has a bad escape.
fn scan_string(src: &buf<int>, i: int) => int:
    let n = lexed_len
    let j = i + 1
    let bad = false
    while j < n:
        let c = sbyte(src, j)
        if c == '"':
            if bad:
                return 0 - (j + 1)
            return j + 1
        if c == '\n':
            return 0 - j
        if c == '\\':
            let l = escape_len(src, j)
            if l == 0:
                bad = true
                j = j + 1
            else:
                j = j + l
        else:
            j = j + 1
    return 0 - n

/#/ Can `b` begin the expression of an f-string `{...}`?
fn fpart_starts(b: int) => bool:
    return (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || b == '_' || (b >= '0' && b <= '9') || b == '(' || b == '-' || b == '!' || b == '[' || b == '"'

/#/ Scans an f-string whose opening quote is at i: like `scan_string`, but a string inside `{...}`
/#/ is part of the expression, and `{{` is a brace of the text.
fn scan_fstring(src: &buf<int>, i: int) => int:
    let n = lexed_len
    let j = i + 1
    let bad = false
    let depth = 0
    while j < n:
        let c = sbyte(src, j)
        if c == '"' && depth == 0:
            if bad:
                return 0 - (j + 1)
            return j + 1
        if c == '"':
            let e = scan_string(src, j)
            if e < 0:
                return e
            j = e
            continue
        if c == '\n':
            return 0 - j
        if c == '\\':
            let l = escape_len(src, j)
            if l == 0:
                bad = true
                j = j + 1
            else:
                j = j + l
        elif c == '{':
            if depth == 0 && sbyte(src, j + 1) == '{':
                j = j + 2
            else:
                if depth > 0 || fpart_starts(sbyte(src, j + 1)):
                    depth = depth + 1
                j = j + 1
        elif c == '}':
            if depth > 0:
                depth = depth - 1
            j = j + 1
        else:
            j = j + 1
    return 0 - n

/#/ Scans a char literal whose opening quote is at i; negated when malformed.
fn scan_char(src: &buf<int>, i: int) => int:
    let c = sbyte(src, i + 1)
    if c == '\\':
        let l = escape_len(src, i + 1)
        if l != 0 && sbyte(src, i + 1 + l) == '\'':
            return i + l + 2
    elif c != 0 && c != '\'' && c != '\n' && sbyte(src, i + 2) == '\'':
        return i + 3
    let j = i + 1
    while j < lexed_len && sbyte(src, j) != '\'' && sbyte(src, j) != '\n':
        j = j + 1
    if sbyte(src, j) == '\'':
        j = j + 1
    return 0 - j

/#/ ---- comments ----------------------------------------------------------

/#/ End of the `/#/ ...` line comment at i (the newline is not consumed).
fn skip_line_comment(src: &buf<int>, i: int) => int:
    let j = i
    while j < lexed_len && sbyte(src, j) != '\n':
        j = j + 1
    return j

/#/ End of the `/#* ... *#/` comment at i; negated when it never closes.
fn skip_block_comment(src: &buf<int>, i: int) => int:
    let n = lexed_len
    let j = i + 3
    while j < n:
        if sbyte(src, j) == '*' && sbyte(src, j + 1) == '#' && sbyte(src, j + 2) == '/':
            return j + 3
        j = j + 1
    return 0 - n

fn starts_line_comment(src: &buf<int>, i: int) => bool:
    return sbyte(src, i) == '/' && sbyte(src, i + 1) == '#' && sbyte(src, i + 2) == '/'

fn starts_block_comment(src: &buf<int>, i: int) => bool:
    return sbyte(src, i) == '/' && sbyte(src, i + 1) == '#' && sbyte(src, i + 2) == '*'

fn count_newlines(src: &buf<int>, a: int, b: int) => int:
    let k = 0
    for i in a..b:
        if sbyte(src, i) == '\n':
            k = k + 1
    return k

/#/ Offset just past the last newline in [a, b), or -1 if there is none.
fn after_last_newline(src: &buf<int>, a: int, b: int) => int:
    let r = -1
    for i in a..b:
        if sbyte(src, i) == '\n':
            r = i + 1
    return r

/#/ ---- the lexer ---------------------------------------------------------

/#/ The bytes of `s` as a buffer (one extra zero slot at the end).
fn bytes_of_str(s: &str) => buf<int>:
    let size = len(s)
    let b: buf<int> = new_buf(int, size + 1)
    for q in 0..size:
        b[q] = int(s[q])
    return b

fn lex(src: &str) => Tokens:
    let b = bytes_of_str(src)
    return lex_bytes(&b, len(src))

/#/ The tokens of the `size` bytes in `src`.
fn lex_bytes(src: &buf<int>, size: int) => Tokens:
    let t = new_tokens()
    lex_into(src, size, 0, size, &t, true, 1, 0)
    return t

/#/ Appends the tokens of `src[from, n)` to `t`, ending with an Eof. `at_bol` says the range
/#/ starts a line (indentation counts); `line` and `line_start` place it in the file. An
/#/ f-string's `{expression}` is lexed this way, after the main stream.
fn lex_into(src: &buf<int>, size: int, from: int, n: int, t: &Tokens, at_bol0: bool, line0: int, line_start0: int) => void:
    lexed_len = size
    let kt = keyword_table()
    let kn = len(kt)
    let kws0 = bytes_of_str(&kt)
    let kws = keyword_index(&kws0, kn)
    let stack = new_buf(int, 128)
    let sp = 1
    let depth = 0
    let line = line0
    let line_start = line_start0
    let at_bol = at_bol0
    let i = from
    while i < n:
        if at_bol:
            /#/ Measure indentation; blank and comment-only lines are ignored.
            let ind = 0
            let j = i
            while sbyte(src, j) == ' ' || sbyte(src, j) == '\t':
                if sbyte(src, j) == '\t':
                    t.push(int(Tk.Error), j, j + 1, line, j - line_start + 1)
                    ind = ind + 4
                else:
                    ind = ind + 1
                j = j + 1
            let c = sbyte(src, j)
            if j >= n:
                i = j
            elif c == '\n' || c == '\r':
                if c == '\r':
                    j = j + 1
                i = j
                if sbyte(src, i) == '\n':
                    i = i + 1
                    line = line + 1
                    line_start = i
            elif starts_line_comment(src, j):
                i = skip_line_comment(src, j)
            else:
                i = j
                at_bol = false
                let top = stack[sp - 1]
                if ind > top:
                    if sp >= len(stack):
                        t.push(int(Tk.Error), j, j, line, j - line_start + 1)
                    else:
                        stack[sp] = ind
                        sp = sp + 1
                        t.push(int(Tk.Indent), j, j, line, j - line_start + 1)
                elif ind < top:
                    while sp > 1 && ind < stack[sp - 1]:
                        sp = sp - 1
                        t.push(int(Tk.Dedent), j, j, line, j - line_start + 1)
                    if ind != stack[sp - 1]:
                        t.push(int(Tk.Error), j, j, line, j - line_start + 1)
        else:
            let c = sbyte(src, i)
            let col = i - line_start + 1
            if c == ' ' || c == '\t' || c == '\r':
                i = i + 1
            elif c == '\n':
                let last = t.last_kind()
                let ends = last != int(Tk.Newline) && last != int(Tk.Indent) && last != int(Tk.Dedent) && last >= 0
                let cont = continues_line(last) && !ends_in_size_suffix(t) && !ends_in_type_args(t)
                if depth == 0 && ends && !cont:
                    t.push(int(Tk.Newline), i, i + 1, line, col)
                i = i + 1
                line = line + 1
                line_start = i
                at_bol = depth == 0 && !cont
            elif starts_line_comment(src, i):
                i = skip_line_comment(src, i)
            elif starts_block_comment(src, i):
                let e = skip_block_comment(src, i)
                if e < 0:
                    e = 0 - e
                    t.push(int(Tk.Error), i, e, line, col)
                let nl = after_last_newline(src, i, e)
                if nl >= 0:
                    line = line + count_newlines(src, i, e)
                    line_start = nl
                i = e
            elif is_digit(c):
                let e = scan_number(src, i)
                if e < 0:
                    e = 0 - e - 1
                    t.push(int(Tk.Error), i, e, line, col)
                elif number_is_float(src, i, e):
                    t.push(int(Tk.Float), i, e, line, col)
                else:
                    t.push(int(Tk.Int), i, e, line, col)
                i = e
            elif c == 'f' && sbyte(src, i + 1) == '"':
                let e = scan_fstring(src, i + 1)
                if e < 0:
                    e = 0 - e
                    t.push(int(Tk.Error), i, e, line, col)
                else:
                    t.push(int(Tk.FStr), i, e, line, col)
                i = e
            elif is_alpha(c):
                let e = i + 1
                while is_ident(sbyte(src, e)):
                    e = e + 1
                t.push(word_kind(src, i, e, &kws, kn), i, e, line, col)
                i = e
            elif c == '"':
                let e = scan_string(src, i)
                if e < 0:
                    e = 0 - e
                    t.push(int(Tk.Error), i, e, line, col)
                else:
                    t.push(int(Tk.Str), i, e, line, col)
                i = e
            elif c == '\'':
                let e = scan_char(src, i)
                if e < 0:
                    e = 0 - e
                    t.push(int(Tk.Error), i, e, line, col)
                else:
                    t.push(int(Tk.Char), i, e, line, col)
                i = e
            elif c == '#':
                let e = i + 1
                while is_ident(sbyte(src, e)):
                    e = e + 1
                if e == i + 1:
                    t.push(int(Tk.Error), i, e, line, col)
                else:
                    t.push(int(Tk.Listener), i, e, line, col)
                i = e
            else:
                let k2 = op2_kind(c, sbyte(src, i + 1))
                if k2 == int(Tk.SlashSlash) && sbyte(src, i + 2) == '=':
                    t.push(int(Tk.SlashSlashEq), i, i + 3, line, col)
                    i = i + 3
                elif k2 >= 0:
                    t.push(k2, i, i + 2, line, col)
                    i = i + 2
                else:
                    let k1 = op1_kind(c)
                    if k1 < 0:
                        /#/ one Error per stray character, not per UTF-8 byte
                        let e = i + 1
                        while sbyte(src, e) >= 128 && sbyte(src, e) < 192:
                            e = e + 1
                        t.push(int(Tk.Error), i, e, line, col)
                        i = e - 1
                    else:
                        if k1 == int(Tk.LParen) || k1 == int(Tk.LBracket) || k1 == int(Tk.LBrace):
                            depth = depth + 1
                        elif k1 == int(Tk.RParen) || k1 == int(Tk.RBracket) || k1 == int(Tk.RBrace):
                            if depth == 0:
                                k1 = int(Tk.Error)
                            else:
                                depth = depth - 1
                        t.push(k1, i, i + 1, line, col)
                    i = i + 1
    let col = i - line_start + 1
    if depth > 0:
        t.push(int(Tk.Error), n, n, line, col)
    let last = t.last_kind()
    if last >= 0 && last != int(Tk.Newline) && last != int(Tk.Indent) && last != int(Tk.Dedent):
        t.push(int(Tk.Newline), n, n, line, col)
    while sp > 1:
        sp = sp - 1
        t.push(int(Tk.Dedent), n, n, line, col)
    t.push(int(Tk.Eof), n, n, line, col)

/#/ Node kinds and the node table of the Coffee parser.
/#/
/#/ The tree is a table, not a pointer graph: node `n` is row `n` of seven `buf<int>`
/#/ columns. `tok`..`end` is the token range the node covers, `a`/`b`/`c`/`d` are
/#/ kind-specific payloads (node ids, token ids or flags; -1 means absent), and
/#/ `child`/`next` thread a node's children as a singly linked list.
/#/
/#/   Program   child=items
/#/   Use       a=module token  b=alias token  c=1 when `of c`  child=Name symbols (Star for `*`)
/#/   Fn        a=name token  b=return TypeRef  c=body Block  d=1 for `c fn`  child=TypeParam/Param/Listener
/#/   Param     tok=name  a=TypeRef            SelfParam  tok=`self`
/#/   TypeParam tok=name                       Listener   tok=`#name`
/#/   Class     a=name token  b=parent token  c=1 when packed  child=TypeParam/Field/Fn
/#/   Field     tok=name  a=TypeRef  b=bit-width token
/#/   Enum      a=name token  child=Variant     Variant  tok=name  child=VField (a=TypeRef b=name token)
/#/   TypeRef   the tokens tok..end spell the type
/#/   Block     child=statements
/#/   Let       a=name token  b=TypeRef  c=init expr
/#/   Assign    a=target  b=value          Return/Raise/Rm/Clean/ExprStmt  a=expr (Rm and Clean: more targets are the children)
/#/   If        a=cond  b=then Block  c=else Block or If (an `elif`)
/#/   While     a=cond  b=Block            For  a=variable token  b=iterable  c=Block
/#/   Match     a=scrutinee  child=Arm     Arm  a=pattern  b=body Block
/#/   TypeAlias a=name token  b=TypeRef (`type Handle: object`)
/#/   Mv        a=source Name  b=destination token  c=1 for `clone a b` (`mv a b`)
/#/   Break, Continue
/#/   FStr     tok=literal  child=FPart, one per `{expr}` in order
/#/   FPart    a=expr  b=byte of `{`  c=byte of `}`  d=byte of the `:` that starts a format spec, or -1
/#/            (the expression's tokens follow the main stream; see `fspec_of` for the spec)
/#/   Int, Float, Str, Char   tok=literal      Bool  tok=true/false      Name  tok=identifier
/#/   Binary    a=left  b=right  c=operator token kind  d=operator token
/#/   Unary     a=operand  c=operator token kind  d=1 for `&mut`
/#/   Call      a=callee  child=arguments        Index  a=object  b=index
/#/   Cast      a=expr  b=TypeRef (`x as T`)
/#/   Member    a=object  tok=field name token  d=1 for `Type::name`   Range  a=from  b=to
/#/   StructLit a=type name expr  child=FieldInit (tok=name  a=value)
/#/   Array, Tuple   child=elements
/#/   Error     tok=where it went wrong  a=error code (Ec)
enum Nk:
    Program
    Use
    Fn
    Param
    SelfParam
    TypeParam
    Listener
    Class
    Field
    Enum
    Variant
    VField
    TypeRef
    Block
    Let
    Assign
    Return
    Raise
    Rm
    Clean
    ExprStmt
    If
    While
    For
    Match
    Arm
    Break
    Continue
    Int
    Float
    Str
    FStr
    Char
    Bool
    Name
    Star
    Binary
    Unary
    Call
    Index
    Member
    Range
    StructLit
    FieldInit
    Array
    Tuple
    Cast
    Mv
    TypeAlias
    Error
    FPart

/#/ Parse error codes, the `a` payload of an Error node and the code in the error table.
enum Ec:
    ExpectedExpr
    ExpectedName
    ExpectedType
    ExpectedColon
    ExpectedNewline
    ExpectedIndent
    ExpectedClose
    ExpectedArrow
    ExpectedIn
    ExpectedAssign
    ExpectedItem
    ExpectedStatement
    UnexpectedToken
    TooDeep
    BadPattern


/#/ The format spec of an f-string part, `{x:spec}`: `[[fill]align][0][width][.precision][type]`.
/#/ `fill` is a space or one of `0 - * _ . # = + | ~ x`; `align` is `<`, `>` or `^`; `type` is
/#/ `x X b o` for an int or `f` for a float. `ok` is false when the text is none of that.
class FSpec:
    ok: bool
    present: bool
    fill: int
    /#/ 0 none given, 1 `<`, 2 `>`, 3 `^`
    align: int
    zero: bool
    width: int
    /#/ -1 when there is none
    prec: int
    /#/ the type letter, 0 when there is none
    kind: int

fn fspec_align(c: int) => int:
    if c == '<':
        return 1
    if c == '>':
        return 2
    if c == '^':
        return 3
    return 0

fn fspec_fill(c: int) => bool:
    return c == ' ' || c == '0' || c == '-' || c == '*' || c == '_' || c == '.' || c == '#' || c == '=' || c == '+' || c == '|' || c == '~' || c == 'x'

/#/ The spec of f-string part `part`.
fn fspec_of(a: &Ast, part: int) => FSpec:
    let sp = FSpec { ok: true, present: false, fill: 32, align: 0, zero: false, width: 0, prec: -1, kind: 0 }
    if a.pd[part] < 0:
        return sp
    sp.present = true
    let i = a.pd[part] + 1
    let hi = a.pc[part]
    if i + 1 < hi && fspec_align(a.byte_at(i + 1)) != 0:
        if !fspec_fill(a.byte_at(i)):
            sp.ok = false
            return sp
        sp.fill = a.byte_at(i)
        sp.align = fspec_align(a.byte_at(i + 1))
        i = i + 2
    elif i < hi && fspec_align(a.byte_at(i)) != 0:
        sp.align = fspec_align(a.byte_at(i))
        i = i + 1
    if i < hi && a.byte_at(i) == '0':
        sp.zero = true
        i = i + 1
    while i < hi && a.byte_at(i) >= '0' && a.byte_at(i) <= '9':
        sp.width = sp.width * 10 + a.byte_at(i) - '0'
        if sp.width > 1000:
            sp.ok = false
            return sp
        i = i + 1
    if i < hi && a.byte_at(i) == '.':
        i = i + 1
        sp.prec = 0
        let any = false
        while i < hi && a.byte_at(i) >= '0' && a.byte_at(i) <= '9':
            sp.prec = sp.prec * 10 + a.byte_at(i) - '0'
            any = true
            i = i + 1
        if !any || sp.prec > 30:
            sp.ok = false
            return sp
    if i < hi:
        sp.kind = a.byte_at(i)
        i = i + 1
    if i != hi:
        sp.ok = false
    if sp.kind != 0 && sp.kind != 'x' && sp.kind != 'X' && sp.kind != 'b' && sp.kind != 'o' && sp.kind != 'f':
        sp.ok = false
    return sp

/#/ The `:` of the part whose expression starts at byte `from` and whose `}` is at `close`: the first
/#/ one outside brackets and strings; -1 when the part has no spec.
fn fpart_colon(a: &Ast, from: int, close: int) => int:
    let depth = 0
    let i = from
    while i < close:
        let c = a.byte_at(i)
        if c == '"':
            i = i + 1
            while i < close && a.byte_at(i) != '"':
                if a.byte_at(i) == '\\':
                    i = i + 1
                i = i + 1
        elif c == '(' || c == '[' || c == '{':
            depth = depth + 1
        elif c == ')' || c == ']' || c == '}':
            depth = depth - 1
        elif c == ':' && depth == 0:
            return i
        i = i + 1
    return -1

/#/ The `}` that closes the `{` before `from`, balancing brackets; -1 when there is none before `e`.
fn fpart_close(a: &Ast, from: int, e: int) => int:
    let depth = 0
    let i = from
    while i < e:
        let c = a.byte_at(i)
        if c == '"':
            /#/ a string inside the expression
            i = i + 1
            while i < e && a.byte_at(i) != '"':
                if a.byte_at(i) == '\\':
                    i = i + 1
                i = i + 1
        elif c == '{' || c == '(' || c == '[':
            depth = depth + 1
        elif c == '}' || c == ')' || c == ']':
            if depth == 0:
                if c == '}':
                    return i
                return -1
            depth = depth - 1
        i = i + 1
    return -1

/#/ Nesting beyond this many expressions/blocks is an error, not a stack overflow.
fn max_depth() => int:
    return 200

/#/ Binary operator precedence, 1 (`||`) to 10 (`*`); 0 when `kind` is not binary.
fn bin_prec(kind: int) => int:
    if kind == int(Tk.PipePipe):
        return 1
    if kind == int(Tk.AmpAmp):
        return 2
    if kind == int(Tk.EqEq) || kind == int(Tk.NotEq):
        return 3
    if kind == int(Tk.Lt) || kind == int(Tk.Le) || kind == int(Tk.Gt) || kind == int(Tk.Ge):
        return 4
    if kind == int(Tk.Pipe):
        return 5
    if kind == int(Tk.Caret):
        return 6
    if kind == int(Tk.Amp):
        return 7
    if kind == int(Tk.Shl) || kind == int(Tk.Shr):
        return 8
    if kind == int(Tk.Plus) || kind == int(Tk.Minus):
        return 9
    if kind == int(Tk.Star) || kind == int(Tk.Slash) || kind == int(Tk.SlashSlash) || kind == int(Tk.Percent):
        return 10
    return 0

class Ast:
    /#/ the source bytes and their count (a `str` index walks to the NUL for its bounds check)
    bytes: buf<int>
    size: int
    toks: Tokens
    kind: buf<int>
    tok: buf<int>
    end: buf<int>
    pa: buf<int>
    pb: buf<int>
    pc: buf<int>
    pd: buf<int>
    child: buf<int>
    next: buf<int>
    count: int
    root: int
    pos: int
    half: int
    depth: int
    err_tok: buf<int>
    err_code: buf<int>
    err_count: int

    /#/ ---- table ---------------------------------------------------------

    fn add(self, kind: int, tok: int) => int:
        let i = self.count
        if i >= len(self.kind):
            let cap = (i + 1) * 2
            self.kind = buf_resize(self.kind, cap)
            self.tok = buf_resize(self.tok, cap)
            self.end = buf_resize(self.end, cap)
            self.pa = buf_resize(self.pa, cap)
            self.pb = buf_resize(self.pb, cap)
            self.pc = buf_resize(self.pc, cap)
            self.pd = buf_resize(self.pd, cap)
            self.child = buf_resize(self.child, cap)
            self.next = buf_resize(self.next, cap)
        self.kind[i] = kind
        self.tok[i] = tok
        self.end[i] = tok
        self.pa[i] = -1
        self.pb[i] = -1
        self.pc[i] = -1
        self.pd[i] = -1
        self.child[i] = -1
        self.next[i] = -1
        self.count = i + 1
        return i

    /#/ Closes node n at the current position and returns it.
    fn fin(self, n: int) => int:
        self.end[n] = self.pos
        return n

    fn record(self, tok: int, code: int) => void:
        let i = self.err_count
        /#/ too deep ends the parse: everything after it is fallout of the unwinding
        if i > 0 && self.err_code[i - 1] == int(Ec.TooDeep):
            return
        if code == int(Ec.TooDeep):
            self.pos = self.toks.count - 1
        if i >= len(self.err_tok):
            self.err_tok = buf_resize(self.err_tok, (i + 1) * 2)
            self.err_code = buf_resize(self.err_code, (i + 1) * 2)
        self.err_tok[i] = tok
        self.err_code[i] = code
        self.err_count = i + 1

    /#/ ---- token cursor --------------------------------------------------

    fn peek(self) => int:
        return self.toks.kind[self.pos]

    fn peek_at(self, ahead: int) => int:
        let i = self.pos + ahead
        if i >= self.toks.count:
            return int(Tk.Eof)
        return self.toks.kind[i]

    fn bump(self) => void:
        if self.toks.kind[self.pos] != int(Tk.Eof):
            self.pos = self.pos + 1

    fn at(self, kind: int) => bool:
        return self.toks.kind[self.pos] == kind

    fn eat(self, kind: int) => bool:
        if self.toks.kind[self.pos] == kind:
            self.bump()
            return true
        return false

    fn byte_at(self, i: int) => int:
        if i < 0 || i >= self.size:
            return 0
        return self.bytes[i]

    /#/ The identifier token at `tok` spells `word`.
    fn is_word(self, tok: int, word: &str) => bool:
        if self.toks.kind[tok] != int(Tk.Ident):
            return false
        let s = self.toks.start[tok]
        let e = self.toks.end[tok]
        if e - s != len(word):
            return false
        for k in 0..len(word):
            if self.byte_at(s + k) != byte(word, k):
                return false
        return true

    /#/ ---- errors --------------------------------------------------------

    /#/ Records an error at the current token and returns an Error node.
    fn fail(self, code: int) => int:
        self.record(self.pos, code)
        let n = self.add(int(Nk.Error), self.pos)
        self.pa[n] = code
        return n

    /#/ Skips to just past the end of the current statement, keeping Indent/Dedent
    /#/ balanced: a Dedent that closes the enclosing block is left for the caller.
    fn sync(self) => void:
        let nest = 0
        while true:
            let k = self.peek()
            if k == int(Tk.Eof):
                return
            if k == int(Tk.Newline) && nest == 0:
                self.bump()
                return
            if k == int(Tk.Indent):
                nest = nest + 1
            elif k == int(Tk.Dedent):
                if nest == 0:
                    return
                nest = nest - 1
            self.bump()

    /#/ Ends a simple statement: a Newline, or the Dedent/Eof that also ends the line.
    fn end_stmt(self) => void:
        let k = self.peek()
        /#/ an expression that ended in an indented block (an anonymous fn) has no newline
        if self.pos > 0 && self.toks.kind[self.pos - 1] == int(Tk.Dedent):
            return
        if k == int(Tk.Newline):
            self.bump()
        elif k != int(Tk.Dedent) && k != int(Tk.Eof):
            self.record(self.pos, int(Ec.ExpectedNewline))
            self.sync()

    /#/ ---- types ---------------------------------------------------------

    /#/ Consumes the `>` that closes a type argument list; `>>` closes two lists.
    fn close_angle(self) => bool:
        let k = self.peek()
        if k == int(Tk.Gt):
            self.bump()
            return true
        if k == int(Tk.Shr):
            if self.half == 0:
                self.half = 1
            else:
                self.half = 0
                self.bump()
            return true
        return false

    /#/ Parses the tokens of a type; the result is a TypeRef over their range.
    fn parse_type(self) => int:
        let n = self.add(int(Nk.TypeRef), self.pos)
        self.type_tokens()
        return self.fin(n)

    fn type_tokens(self) => void:
        self.depth = self.depth + 1
        if self.depth > max_depth():
            self.record(self.pos, int(Ec.TooDeep))
            self.depth = self.depth - 1
            return
        let k = self.peek()
        if k == int(Tk.Amp):
            self.bump()
            if self.peek() == int(Tk.Ident) && self.is_word(self.pos, "mut"):
                self.bump()
            self.type_tokens()
        elif k == int(Tk.LBracket):
            self.bump()
            self.type_tokens()
            if self.eat(int(Tk.Semi)):
                let size = self.peek()
                if size == int(Tk.Int) || size == int(Tk.Ident):
                    self.bump()
                else:
                    self.record(self.pos, int(Ec.ExpectedExpr))
            if !self.eat(int(Tk.RBracket)):
                self.record(self.pos, int(Ec.ExpectedClose))
        elif k == int(Tk.LParen):
            self.bump()
            while self.peek() != int(Tk.RParen) && self.peek() != int(Tk.Eof) && self.peek() != int(Tk.Newline):
                let before = self.pos
                self.type_tokens()
                if !self.eat(int(Tk.Comma)):
                    break
                if self.pos == before:
                    break
            if !self.eat(int(Tk.RParen)):
                self.record(self.pos, int(Ec.ExpectedClose))
        elif k == int(Tk.KwFn):
            self.bump()
            if self.eat(int(Tk.LParen)):
                while self.peek() != int(Tk.RParen) && self.peek() != int(Tk.Eof) && self.peek() != int(Tk.Newline):
                    let before = self.pos
                    self.type_tokens()
                    if !self.eat(int(Tk.Comma)):
                        break
                    if self.pos == before:
                        break
                if !self.eat(int(Tk.RParen)):
                    self.record(self.pos, int(Ec.ExpectedClose))
            else:
                self.record(self.pos, int(Ec.ExpectedClose))
            if self.eat(int(Tk.Arrow)):
                self.type_tokens()
        elif k == int(Tk.KwInt) || k == int(Tk.KwFloat):
            self.bump()
            /#/ `int(4)+` is a sized type: `(`, a byte count, `)`, and an optional sign
            if self.peek() == int(Tk.LParen) && self.peek_at(1) == int(Tk.Int) && self.peek_at(2) == int(Tk.RParen):
                self.bump()
                self.bump()
                self.bump()
                if self.peek() == int(Tk.Plus) || self.peek() == int(Tk.Minus):
                    self.bump()
        elif k == int(Tk.KwBool) || k == int(Tk.KwStr) || k == int(Tk.KwString) || k == int(Tk.KwVoid):
            self.bump()
        elif k == int(Tk.Ident):
            self.bump()
            if self.peek() == int(Tk.Lt):
                self.bump()
                while true:
                    self.type_tokens()
                    if !self.eat(int(Tk.Comma)):
                        break
                if !self.close_angle():
                    self.record(self.pos, int(Ec.ExpectedClose))
        else:
            self.record(self.pos, int(Ec.ExpectedType))
        self.depth = self.depth - 1

    /#/ ---- expressions ---------------------------------------------------

    fn parse_expr(self) => int:
        self.depth = self.depth + 1
        if self.depth > max_depth():
            let e = self.fail(int(Ec.TooDeep))
            self.depth = self.depth - 1
            return e
        let start = self.pos
        let left = -1
        if !self.at(int(Tk.DotDot)):
            left = self.parse_binary(1)
        if self.at(int(Tk.DotDot)):
            let r = self.add(int(Nk.Range), start)
            self.bump()
            self.pa[r] = left
            let k = self.peek()
            /#/ `a[lo..]` has no upper bound
            if k != int(Tk.RBracket) && k != int(Tk.Newline) && k != int(Tk.Colon) && k != int(Tk.RParen) && k != int(Tk.Comma) && k != int(Tk.Eof):
                self.pb[r] = self.parse_binary(1)
            left = self.fin(r)
        self.depth = self.depth - 1
        return left

    fn parse_binary(self, min_prec: int) => int:
        let start = self.pos
        let left = self.parse_unary()
        while true:
            let op = self.peek()
            let prec = bin_prec(op)
            if prec == 0 || prec < min_prec:
                break
            let n = self.add(int(Nk.Binary), start)
            let op_tok = self.pos
            self.bump()
            let right = self.parse_binary(prec + 1)
            self.pa[n] = left
            self.pb[n] = right
            self.pc[n] = op
            self.pd[n] = op_tok
            left = self.fin(n)
        return left

    fn parse_unary(self) => int:
        let k = self.peek()
        let is_prefix = k == int(Tk.Minus) || k == int(Tk.Bang) || k == int(Tk.Tilde) || k == int(Tk.Star) || k == int(Tk.Amp) || k == int(Tk.KwMv) || k == int(Tk.KwClone) || k == int(Tk.KwCopy)
        if !is_prefix:
            return self.parse_postfix()
        self.depth = self.depth + 1
        if self.depth > max_depth():
            let e = self.fail(int(Ec.TooDeep))
            self.depth = self.depth - 1
            return e
        let n = self.add(int(Nk.Unary), self.pos)
        self.pc[n] = k
        self.bump()
        if k == int(Tk.Amp) && self.peek() == int(Tk.Ident) && self.is_word(self.pos, "mut"):
            self.bump()
            self.pd[n] = 1
        self.pa[n] = self.parse_unary()
        self.depth = self.depth - 1
        return self.fin(n)

    /#/ Is the text of token `tok` the word `w`?
    fn word_is(self, tok: int, w: &str) => bool:
        let st = self.toks.start[tok]
        if self.toks.end[tok] - st != len(w):
            return false
        for k in 0..len(w):
            if self.byte_at(st + k) != byte(w, k):
                return false
        return true

    /#/ Do the next tokens spell a sized type (`int(4)+`, `float(4)`) followed by a comma?
    fn sized_elem_ahead(self) => bool:
        let k = self.peek()
        if k != int(Tk.KwInt) && k != int(Tk.KwFloat):
            return false
        if self.peek_at(1) != int(Tk.LParen) || self.peek_at(2) != int(Tk.Int) || self.peek_at(3) != int(Tk.RParen):
            return false
        let after = self.peek_at(4)
        if after == int(Tk.Plus) || after == int(Tk.Minus):
            after = self.peek_at(5)
        return after == int(Tk.Comma)

    fn parse_postfix(self) => int:
        let start = self.pos
        let left = self.parse_primary()
        while true:
            let k = self.peek()
            if k == int(Tk.LParen):
                let n = self.add(int(Nk.Call), start)
                self.bump()
                self.pa[n] = left
                if self.sized_elem_ahead() && self.kind[left] == int(Nk.Name) && self.word_is(self.tok[left], "new_buf"):
                    /#/ `new_buf(int(1)-, n)`, `new_buf(float(4), n)`: the element type is spelled as a type here, not as a cast
                    let first = self.parse_type()
                    self.child[n] = first
                    if self.eat(int(Tk.Comma)):
                        self.next[first] = self.parse_list(int(Tk.RParen))
                    elif !self.eat(int(Tk.RParen)):
                        self.record(self.pos, int(Ec.ExpectedClose))
                else:
                    self.child[n] = self.parse_list(int(Tk.RParen))
                left = self.fin(n)
            elif k == int(Tk.LBracket):
                let n = self.add(int(Nk.Index), start)
                self.bump()
                self.pa[n] = left
                self.pb[n] = self.parse_expr()
                if !self.eat(int(Tk.RBracket)):
                    self.record(self.pos, int(Ec.ExpectedClose))
                left = self.fin(n)
            elif k == int(Tk.KwAs):
                let n = self.add(int(Nk.Cast), start)
                self.bump()
                self.pa[n] = left
                self.pb[n] = self.parse_type()
                left = self.fin(n)
            elif k == int(Tk.Dot) || k == int(Tk.ColonColon):
                let n = self.add(int(Nk.Member), start)
                if k == int(Tk.ColonColon):
                    self.pd[n] = 1
                self.bump()
                self.pa[n] = left
                if self.at(int(Tk.Ident)):
                    self.tok[n] = self.pos
                    self.bump()
                else:
                    self.record(self.pos, int(Ec.ExpectedName))
                left = self.fin(n)
            elif k == int(Tk.LBrace) && self.kind[left] == int(Nk.Name):
                left = self.parse_struct_lit(left, start)
            else:
                break
        return left

    /#/ `Name { field: value, ... }`, the `{` still ahead.
    fn parse_struct_lit(self, name: int, start: int) => int:
        let n = self.add(int(Nk.StructLit), start)
        self.bump()
        self.pa[n] = name
        let first = -1
        let last = -1
        while self.peek() != int(Tk.RBrace) && self.peek() != int(Tk.Eof):
            let f = self.add(int(Nk.FieldInit), self.pos)
            if self.at(int(Tk.Ident)):
                self.tok[f] = self.pos
                self.bump()
            else:
                self.record(self.pos, int(Ec.ExpectedName))
            if self.eat(int(Tk.Colon)):
                self.pa[f] = self.parse_expr()
            else:
                self.record(self.pos, int(Ec.ExpectedColon))
            self.fin(f)
            if first < 0:
                first = f
            else:
                self.next[last] = f
            last = f
            if !self.eat(int(Tk.Comma)):
                break
        if !self.eat(int(Tk.RBrace)):
            self.record(self.pos, int(Ec.ExpectedClose))
        self.child[n] = first
        return self.fin(n)

    /#/ Comma-separated expressions up to and including `close`; the first one is returned.
    fn parse_list(self, close: int) => int:
        let first = -1
        let last = -1
        while self.peek() != close && self.peek() != int(Tk.Eof):
            let before = self.pos
            let e = self.parse_expr()
            if first < 0:
                first = e
            else:
                self.next[last] = e
            last = e
            if !self.eat(int(Tk.Comma)):
                break
            if self.pos == before:
                break
        if !self.eat(close):
            self.record(self.pos, int(Ec.ExpectedClose))
        return first

    fn parse_primary(self) => int:
        let k = self.peek()
        if k == int(Tk.Int):
            return self.leaf(int(Nk.Int))
        if k == int(Tk.Float):
            return self.leaf(int(Nk.Float))
        if k == int(Tk.Str):
            return self.leaf(int(Nk.Str))
        if k == int(Tk.FStr):
            return self.parse_fstr()
        if k == int(Tk.Char):
            return self.leaf(int(Nk.Char))
        if k == int(Tk.KwTrue) || k == int(Tk.KwFalse):
            return self.leaf(int(Nk.Bool))
        /#/ `int(x)`, `str(x)` ... are casts spelled as calls on a type keyword
        if k == int(Tk.Ident) || k == int(Tk.KwInt) || k == int(Tk.KwFloat) || k == int(Tk.KwBool) || k == int(Tk.KwStr) || k == int(Tk.KwString):
            return self.leaf(int(Nk.Name))
        if k == int(Tk.LParen):
            let start = self.pos
            self.bump()
            let first = self.parse_expr()
            if !self.at(int(Tk.Comma)):
                if !self.eat(int(Tk.RParen)):
                    self.record(self.pos, int(Ec.ExpectedClose))
                /#/ plain grouping: the parenthesised expression itself
                return first
            let n = self.add(int(Nk.Tuple), start)
            self.child[n] = first
            let last = first
            while self.eat(int(Tk.Comma)):
                if self.at(int(Tk.RParen)):
                    break
                let e = self.parse_expr()
                self.next[last] = e
                last = e
            if !self.eat(int(Tk.RParen)):
                self.record(self.pos, int(Ec.ExpectedClose))
            return self.fin(n)
        if k == int(Tk.LBracket):
            let n = self.add(int(Nk.Array), self.pos)
            self.bump()
            self.child[n] = self.parse_list(int(Tk.RBracket))
            return self.fin(n)
        if k == int(Tk.KwFn):
            return self.parse_fn(0)
        return self.fail(int(Ec.ExpectedExpr))

    /#/ `f"text {expr} text"`: each `{expr}` is lexed after the main token stream and parsed
    /#/ from there; a `{` not followed by an expression is part of the text.
    fn parse_fstr(self) => int:
        let tk = self.pos
        let n = self.add(int(Nk.FStr), tk)
        self.bump()
        let resume = self.pos
        let i = self.toks.start[tk] + 2
        let e = self.toks.end[tk] - 1
        let first = -1
        let last = -1
        while i < e:
            let c = self.byte_at(i)
            if c == '\\':
                i = i + 2
            elif c == '{' && i + 1 < e && self.byte_at(i + 1) == '{':
                i = i + 2
            elif c == '{' && i + 1 < e && fpart_starts(self.byte_at(i + 1)):
                let j = fpart_close(&self, i + 1, e)
                if j < 0:
                    self.record(tk, int(Ec.ExpectedClose))
                    break
                let part = self.add(int(Nk.FPart), tk)
                let from = self.toks.count
                let colon = fpart_colon(&self, i + 1, j)
                let upto = j
                if colon >= 0:
                    upto = colon
                lex_into(&self.bytes, self.size, i + 1, upto, &self.toks, false, self.toks.line[tk], self.toks.start[tk] - self.toks.col[tk] + 1)
                self.demote_c_from(from)
                self.pos = from
                self.pa[part] = self.parse_expr()
                if !self.at(int(Tk.Newline)) && !self.at(int(Tk.Eof)):
                    self.record(self.pos, int(Ec.UnexpectedToken))
                self.pos = resume
                self.pb[part] = i
                self.pc[part] = j
                self.pd[part] = colon
                self.fin(part)
                if first < 0:
                    first = part
                else:
                    self.next[last] = part
                last = part
                i = j + 1
            else:
                i = i + 1
        self.child[n] = first
        return self.fin(n)

    fn leaf(self, kind: int) => int:
        let n = self.add(kind, self.pos)
        self.bump()
        return self.fin(n)

    /#/ ---- statements ----------------------------------------------------

    /#/ `:` then an indented block, or a single statement on the same line.
    fn parse_block(self) => int:
        let n = self.add(int(Nk.Block), self.pos)
        self.depth = self.depth + 1
        if self.depth > max_depth():
            self.record(self.pos, int(Ec.TooDeep))
            self.depth = self.depth - 1
            self.sync()
            return self.fin(n)
        if !self.eat(int(Tk.Colon)):
            self.record(self.pos, int(Ec.ExpectedColon))
        let first = -1
        let last = -1
        if self.at(int(Tk.Newline)):
            self.bump()
            if !self.eat(int(Tk.Indent)):
                self.record(self.pos, int(Ec.ExpectedIndent))
            else:
                while self.peek() != int(Tk.Dedent) && self.peek() != int(Tk.Eof):
                    let before = self.pos
                    let st = self.parse_stmt()
                    if first < 0:
                        first = st
                    else:
                        self.next[last] = st
                    last = st
                    if self.pos == before:
                        self.bump()
                self.eat(int(Tk.Dedent))
        else:
            first = self.parse_stmt()
        self.child[n] = first
        self.depth = self.depth - 1
        return self.fin(n)

    fn parse_stmt(self) => int:
        let k = self.peek()
        let start = self.pos
        if k == int(Tk.KwLet):
            return self.parse_let()
        if k == int(Tk.KwReturn) || k == int(Tk.KwRaise) || k == int(Tk.KwRm) || k == int(Tk.KwClean):
            let kind = int(Nk.Return)
            if k == int(Tk.KwRaise):
                kind = int(Nk.Raise)
            elif k == int(Tk.KwRm):
                kind = int(Nk.Rm)
            elif k == int(Tk.KwClean):
                kind = int(Nk.Clean)
            let n = self.add(kind, start)
            self.bump()
            let nk = self.peek()
            if nk != int(Tk.Newline) && nk != int(Tk.Dedent) && nk != int(Tk.Eof):
                self.pa[n] = self.parse_expr()
                /#/ `rm a, b, c` drops several: the extra targets are the children
                if (kind == int(Nk.Rm) || kind == int(Nk.Clean)) && self.at(int(Tk.Comma)):
                    let last = -1
                    while self.eat(int(Tk.Comma)):
                        let e = self.parse_expr()
                        if last < 0:
                            self.child[n] = e
                        else:
                            self.next[last] = e
                        last = e
            self.end_stmt()
            return self.fin(n)
        /#/ `mv a b` moves a into the new name b; `mv a` inside an expression is unary
        if (k == int(Tk.KwMv) || k == int(Tk.KwClone)) && self.peek_at(1) == int(Tk.Ident) && self.peek_at(2) == int(Tk.Ident):
            let n = self.add(int(Nk.Mv), start)
            if k == int(Tk.KwClone):
                self.pc[n] = 1
            self.bump()
            self.pa[n] = self.leaf(int(Nk.Name))
            self.pb[n] = self.pos
            self.bump()
            self.end_stmt()
            return self.fin(n)
        if k == int(Tk.KwBreak) || k == int(Tk.KwContinue):
            let kind = int(Nk.Break)
            if k == int(Tk.KwContinue):
                kind = int(Nk.Continue)
            let n = self.add(kind, start)
            self.bump()
            self.end_stmt()
            return self.fin(n)
        if k == int(Tk.KwIf):
            return self.parse_if()
        if k == int(Tk.KwWhile):
            let n = self.add(int(Nk.While), start)
            self.bump()
            self.pa[n] = self.parse_expr()
            self.pb[n] = self.parse_block()
            return self.fin(n)
        if k == int(Tk.KwFor):
            return self.parse_for()
        if k == int(Tk.KwMatch):
            return self.parse_match()
        if k == int(Tk.KwFn) || k == int(Tk.KwClass) || k == int(Tk.KwEnum) || k == int(Tk.KwPacked):
            if k == int(Tk.KwFn) && self.peek_at(1) == int(Tk.LParen):
                return self.parse_expr_stmt()
            return self.parse_item()
        return self.parse_expr_stmt()

    /#/ An expression statement, or an assignment when `=` follows the target.
    fn parse_expr_stmt(self) => int:
        let start = self.pos
        let e = self.parse_expr()
        if self.at(int(Tk.Assign)):
            let n = self.add(int(Nk.Assign), start)
            self.bump()
            self.pa[n] = e
            self.pb[n] = self.parse_expr()
            self.end_stmt()
            return self.fin(n)
        let ck = self.peek()
        if ck >= int(Tk.PlusEq) && ck <= int(Tk.SlashSlashEq):
            return self.parse_compound(start, e, ck)
        let n = self.add(int(Nk.ExprStmt), start)
        self.pa[n] = e
        self.end_stmt()
        return self.fin(n)

    /#/ `t op= v` is `t = t op v`: the target is parsed a second time so the tree has no shared node.
    fn parse_compound(self, start: int, target: int, ck: int) => int:
        let op_tok = self.pos
        let n = self.add(int(Nk.Assign), start)
        self.pos = start
        let again = self.parse_expr()
        self.pos = op_tok
        self.bump()
        let b = self.add(int(Nk.Binary), start)
        let right = self.parse_expr()
        self.pa[b] = again
        self.pb[b] = right
        /#/ Plus..SlashSlash and PlusEq..SlashSlashEq are in the same order
        self.pc[b] = int(Tk.Plus) + (ck - int(Tk.PlusEq))
        self.pd[b] = op_tok
        self.fin(b)
        self.pa[n] = target
        self.pb[n] = b
        self.end_stmt()
        return self.fin(n)

    fn parse_let(self) => int:
        let n = self.add(int(Nk.Let), self.pos)
        self.bump()
        if self.at(int(Tk.Ident)):
            self.pa[n] = self.pos
            self.bump()
        else:
            self.record(self.pos, int(Ec.ExpectedName))
        if self.eat(int(Tk.Colon)):
            self.pb[n] = self.parse_type()
        if self.eat(int(Tk.Assign)):
            self.pc[n] = self.parse_expr()
        self.end_stmt()
        return self.fin(n)

    /#/ `if` or `elif` at the cursor; an `elif` chain nests in the else slot.
    fn parse_if(self) => int:
        let n = self.add(int(Nk.If), self.pos)
        self.bump()
        self.pa[n] = self.parse_expr()
        self.pb[n] = self.parse_block()
        if self.at(int(Tk.KwElif)):
            self.pc[n] = self.parse_if()
        elif self.at(int(Tk.KwElse)):
            self.bump()
            if self.at(int(Tk.KwIf)):
                self.pc[n] = self.parse_if()
            else:
                self.pc[n] = self.parse_block()
        return self.fin(n)

    fn parse_for(self) => int:
        let n = self.add(int(Nk.For), self.pos)
        self.bump()
        if self.at(int(Tk.Ident)):
            self.pa[n] = self.pos
            self.bump()
        else:
            self.record(self.pos, int(Ec.ExpectedName))
        if !self.eat(int(Tk.KwIn)):
            self.record(self.pos, int(Ec.ExpectedIn))
        self.pb[n] = self.parse_expr()
        self.pc[n] = self.parse_block()
        return self.fin(n)

    fn parse_match(self) => int:
        let n = self.add(int(Nk.Match), self.pos)
        self.bump()
        self.pa[n] = self.parse_expr()
        if !self.eat(int(Tk.Colon)):
            self.record(self.pos, int(Ec.ExpectedColon))
        let first = -1
        let last = -1
        if !self.eat(int(Tk.Newline)):
            self.record(self.pos, int(Ec.ExpectedNewline))
        if !self.eat(int(Tk.Indent)):
            self.record(self.pos, int(Ec.ExpectedIndent))
        else:
            while self.peek() != int(Tk.Dedent) && self.peek() != int(Tk.Eof):
                let before = self.pos
                let arm = self.parse_arm()
                if first < 0:
                    first = arm
                else:
                    self.next[last] = arm
                last = arm
                if self.pos == before:
                    self.bump()
            self.eat(int(Tk.Dedent))
        self.child[n] = first
        return self.fin(n)

    /#/ `pattern => statement`, or `pattern =>` followed by an indented block.
    fn parse_arm(self) => int:
        let n = self.add(int(Nk.Arm), self.pos)
        self.pa[n] = self.parse_expr()
        /#/ `pattern if cond => body`
        if self.eat(int(Tk.KwIf)):
            self.pc[n] = self.parse_expr()
        if !self.eat(int(Tk.Arrow)):
            self.record(self.pos, int(Ec.ExpectedArrow))
            self.sync()
            return self.fin(n)
        let body = self.add(int(Nk.Block), self.pos)
        if self.at(int(Tk.Newline)):
            self.bump()
            if !self.eat(int(Tk.Indent)):
                self.record(self.pos, int(Ec.ExpectedIndent))
            else:
                let first = -1
                let last = -1
                while self.peek() != int(Tk.Dedent) && self.peek() != int(Tk.Eof):
                    let before = self.pos
                    let st = self.parse_stmt()
                    if first < 0:
                        first = st
                    else:
                        self.next[last] = st
                    last = st
                    if self.pos == before:
                        self.bump()
                self.eat(int(Tk.Dedent))
                self.child[body] = first
        else:
            self.child[body] = self.parse_stmt()
        self.pb[n] = self.fin(body)
        return self.fin(n)

    /#/ ---- items ---------------------------------------------------------

    fn parse_item(self) => int:
        let k = self.peek()
        if k == int(Tk.KwUse):
            return self.parse_use()
        if k == int(Tk.KwFn):
            return self.parse_fn(0)
        if k == int(Tk.KwC) && self.peek_at(1) == int(Tk.KwFn):
            self.bump()
            return self.parse_fn(1)
        if k == int(Tk.KwClass) || k == int(Tk.KwPacked):
            return self.parse_class()
        if k == int(Tk.KwEnum):
            return self.parse_enum()
        if k == int(Tk.KwType):
            return self.parse_type_alias()
        if k == int(Tk.KwLet):
            return self.parse_let()
        /#/ anything else at top level is a statement such as `main(entry())`
        let before = self.pos
        let n = self.parse_stmt()
        if self.pos == before:
            self.record(self.pos, int(Ec.ExpectedItem))
            self.bump()
        return n

    /#/ `type Name: type`
    fn parse_type_alias(self) => int:
        let n = self.add(int(Nk.TypeAlias), self.pos)
        self.bump()
        if self.at(int(Tk.Ident)):
            self.pa[n] = self.pos
            self.bump()
        else:
            self.record(self.pos, int(Ec.ExpectedName))
        if self.eat(int(Tk.Colon)):
            self.pb[n] = self.parse_type()
        else:
            self.record(self.pos, int(Ec.ExpectedColon))
        self.end_stmt()
        return self.fin(n)

    /#/ `use m`, `use m as a`, `use f, g in m [as a] [of c]`, `use * in m`.
    fn parse_use(self) => int:
        let n = self.add(int(Nk.Use), self.pos)
        self.bump()
        let first = -1
        let last = -1
        let names = 0
        /#/ `use in lib of c` names nothing
        while !self.at(int(Tk.KwIn)):
            let sym = -1
            if self.at(int(Tk.Star)):
                sym = self.leaf(int(Nk.Star))
            elif self.at(int(Tk.Ident)):
                sym = self.leaf(int(Nk.Name))
            else:
                self.record(self.pos, int(Ec.ExpectedName))
                break
            names = names + 1
            /#/ `use f as g in m`
            if self.at(int(Tk.KwAs)):
                self.bump()
                if self.at(int(Tk.Ident)):
                    self.pb[n] = self.pos
                    self.bump()
                else:
                    self.record(self.pos, int(Ec.ExpectedName))
            if first < 0:
                first = sym
            else:
                self.next[last] = sym
            last = sym
            if !self.eat(int(Tk.Comma)):
                break
        if self.eat(int(Tk.KwIn)):
            if self.at(int(Tk.Ident)):
                self.pa[n] = self.pos
                self.bump()
            else:
                self.record(self.pos, int(Ec.ExpectedName))
            self.child[n] = first
        elif first >= 0:
            /#/ no `in`: the single name is the module itself
            if names > 1 || self.kind[first] == int(Nk.Star):
                self.record(self.pos, int(Ec.ExpectedIn))
            self.pa[n] = self.tok[first]
        if self.eat(int(Tk.KwAs)):
            if self.at(int(Tk.Ident)):
                self.pb[n] = self.pos
                self.bump()
            else:
                self.record(self.pos, int(Ec.ExpectedName))
        if self.at(int(Tk.KwOf)):
            self.bump()
            if self.eat(int(Tk.KwC)):
                self.pc[n] = 1
            else:
                self.record(self.pos, int(Ec.ExpectedName))
        self.end_stmt()
        return self.fin(n)

    /#/ `<T, U>` after a name: TypeParam nodes appended to the list ending at `last`.
    /#/ Returns the new list tail; `first` is updated through the node's child slot.
    fn parse_type_params(self, owner: int, last: int) => int:
        self.bump()
        while self.at(int(Tk.Ident)):
            let tp = self.add(int(Nk.TypeParam), self.pos)
            self.bump()
            self.fin(tp)
            if self.child[owner] < 0:
                self.child[owner] = tp
            else:
                self.next[last] = tp
            last = tp
            if !self.eat(int(Tk.Comma)):
                break
        if !self.close_angle():
            self.record(self.pos, int(Ec.ExpectedClose))
        return last

    /#/ `fn name<T>(params) #listener => ret:` body. `c fn` has consumed its `c`.
    fn parse_fn(self, is_c: int) => int:
        let n = self.add(int(Nk.Fn), self.pos)
        self.bump()
        self.pd[n] = is_c
        if self.at(int(Tk.Ident)):
            self.pa[n] = self.pos
            self.bump()
        elif self.peek() != int(Tk.LParen):
            /#/ no name, and not an anonymous `fn(...)`: a keyword where the name goes (`fn class()`) is
            /#/ skipped, so the rest parses as the head
            self.record(self.pos, int(Ec.ExpectedName))
            if self.peek() != int(Tk.Newline) && self.peek() != int(Tk.Eof):
                self.bump()
        let last = -1
        if self.at(int(Tk.Lt)):
            last = self.parse_type_params(n, last)
        if !self.eat(int(Tk.LParen)):
            self.record(self.pos, int(Ec.ExpectedClose))
        while self.peek() != int(Tk.RParen) && self.peek() != int(Tk.Eof) && self.peek() != int(Tk.Newline):
            let p = -1
            if self.at(int(Tk.Ident)) && self.is_word(self.pos, "self"):
                p = self.leaf(int(Nk.SelfParam))
            elif self.at(int(Tk.Ident)):
                p = self.add(int(Nk.Param), self.pos)
                self.bump()
                if self.eat(int(Tk.Colon)):
                    self.pa[p] = self.parse_type()
                else:
                    self.record(self.pos, int(Ec.ExpectedColon))
                self.fin(p)
            else:
                self.record(self.pos, int(Ec.ExpectedName))
                break
            if self.child[n] < 0:
                self.child[n] = p
            else:
                self.next[last] = p
            last = p
            if !self.eat(int(Tk.Comma)):
                break
        if !self.eat(int(Tk.RParen)):
            self.record(self.pos, int(Ec.ExpectedClose))
        if self.at(int(Tk.Listener)):
            let l = self.leaf(int(Nk.Listener))
            if self.child[n] < 0:
                self.child[n] = l
            else:
                self.next[last] = l
            last = l
        if self.eat(int(Tk.Arrow)):
            self.pb[n] = self.parse_type()
        /#/ `c fn f() => T:` with nothing under it only declares the C export
        if is_c == 1 && self.at(int(Tk.Colon)) && self.peek_at(1) == int(Tk.Newline) && self.peek_at(2) != int(Tk.Indent):
            self.bump()
            self.bump()
            self.pc[n] = self.fin(self.add(int(Nk.Block), self.pos))
        else:
            self.pc[n] = self.parse_block()
        return self.fin(n)

    /#/ `[packed] class Name<T> [of Parent]:` then fields and methods.
    fn parse_class(self) => int:
        let n = self.add(int(Nk.Class), self.pos)
        if self.eat(int(Tk.KwPacked)):
            self.pc[n] = 1
        if !self.eat(int(Tk.KwClass)):
            self.record(self.pos, int(Ec.ExpectedItem))
        if self.at(int(Tk.Ident)):
            self.pa[n] = self.pos
            self.bump()
        else:
            self.record(self.pos, int(Ec.ExpectedName))
        let last = -1
        if self.at(int(Tk.Lt)):
            last = self.parse_type_params(n, last)
        if self.eat(int(Tk.KwOf)):
            if self.at(int(Tk.Ident)):
                self.pb[n] = self.pos
                self.bump()
            else:
                self.record(self.pos, int(Ec.ExpectedName))
        if !self.eat(int(Tk.Colon)):
            self.record(self.pos, int(Ec.ExpectedColon))
        if !self.eat(int(Tk.Newline)):
            self.record(self.pos, int(Ec.ExpectedNewline))
        /#/ a class may have no members at all
        if !self.eat(int(Tk.Indent)):
            return self.fin(n)
        while self.peek() != int(Tk.Dedent) && self.peek() != int(Tk.Eof):
            let before = self.pos
            let m = -1
            if self.at(int(Tk.KwFn)):
                m = self.parse_fn(0)
            elif self.at(int(Tk.Ident)):
                m = self.add(int(Nk.Field), self.pos)
                self.bump()
                if self.eat(int(Tk.Colon)):
                    self.pa[m] = self.parse_type()
                else:
                    self.record(self.pos, int(Ec.ExpectedColon))
                /#/ packed classes: `field: int:3` is a 3-bit field
                if self.at(int(Tk.Colon)):
                    self.bump()
                    if self.at(int(Tk.Int)):
                        self.pb[m] = self.pos
                        self.bump()
                    else:
                        self.record(self.pos, int(Ec.ExpectedExpr))
                self.fin(m)
                self.end_stmt()
            else:
                self.record(self.pos, int(Ec.ExpectedItem))
                self.sync()
            if m >= 0:
                if self.child[n] < 0:
                    self.child[n] = m
                else:
                    self.next[last] = m
                last = m
            if self.pos == before:
                self.bump()
        self.eat(int(Tk.Dedent))
        return self.fin(n)

    /#/ `enum Name:` then variants: `A`, `B(type)`, `C(x: type, y: type)`.
    fn parse_enum(self) => int:
        let n = self.add(int(Nk.Enum), self.pos)
        self.bump()
        if self.at(int(Tk.Ident)):
            self.pa[n] = self.pos
            self.bump()
        else:
            self.record(self.pos, int(Ec.ExpectedName))
        if !self.eat(int(Tk.Colon)):
            self.record(self.pos, int(Ec.ExpectedColon))
        if !self.eat(int(Tk.Newline)):
            self.record(self.pos, int(Ec.ExpectedNewline))
        if !self.eat(int(Tk.Indent)):
            self.record(self.pos, int(Ec.ExpectedIndent))
            return self.fin(n)
        let first = -1
        let last = -1
        while self.peek() != int(Tk.Dedent) && self.peek() != int(Tk.Eof):
            let before = self.pos
            if self.at(int(Tk.Ident)):
                let v = self.add(int(Nk.Variant), self.pos)
                self.bump()
                if self.eat(int(Tk.LParen)):
                    let ff = -1
                    let fl = -1
                    while self.peek() != int(Tk.RParen) && self.peek() != int(Tk.Eof) && self.peek() != int(Tk.Newline):
                        let f = self.add(int(Nk.VField), self.pos)
                        if self.at(int(Tk.Ident)) && self.peek_at(1) == int(Tk.Colon):
                            self.pb[f] = self.pos
                            self.bump()
                            self.bump()
                        self.pa[f] = self.parse_type()
                        self.fin(f)
                        if ff < 0:
                            ff = f
                        else:
                            self.next[fl] = f
                        fl = f
                        if !self.eat(int(Tk.Comma)):
                            break
                    if !self.eat(int(Tk.RParen)):
                        self.record(self.pos, int(Ec.ExpectedClose))
                    self.child[v] = ff
                self.fin(v)
                self.end_stmt()
                if first < 0:
                    first = v
                else:
                    self.next[last] = v
                last = v
            else:
                self.record(self.pos, int(Ec.ExpectedName))
                self.sync()
            if self.pos == before:
                self.bump()
        self.eat(int(Tk.Dedent))
        self.child[n] = first
        return self.fin(n)

    /#/ `c` is a keyword only in `c fn` and after `of` (`use f in lib of c`); elsewhere
    /#/ it is an ordinary name.
    fn demote_c(self) => void:
        self.demote_c_from(0)

    fn demote_c_from(self, first: int) => void:
        for i in first..self.toks.count:
            if self.toks.kind[i] == int(Tk.KwC):
                let after_of = i > 0 && self.toks.kind[i - 1] == int(Tk.KwOf)
                let before_fn = i + 1 < self.toks.count && self.toks.kind[i + 1] == int(Tk.KwFn)
                if !after_of && !before_fn:
                    self.toks.kind[i] = int(Tk.Ident)

    fn parse_program(self) => void:
        self.demote_c()
        let n = self.add(int(Nk.Program), 0)
        let first = -1
        let last = -1
        while self.peek() != int(Tk.Eof):
            let before = self.pos
            if self.peek() == int(Tk.Dedent) || self.peek() == int(Tk.Indent):
                self.record(self.pos, int(Ec.UnexpectedToken))
                self.bump()
            else:
                let item = self.parse_item()
                if first < 0:
                    first = item
                else:
                    self.next[last] = item
                last = item
            if self.pos == before:
                self.bump()
        self.child[n] = first
        self.root = self.fin(n)

fn new_ast(bytes: buf<int>, size: int, toks: Tokens) => Ast:
    return Ast { bytes: bytes, size: size, toks: toks, kind: new_buf(int, 64), tok: new_buf(int, 64), end: new_buf(int, 64), pa: new_buf(int, 64), pb: new_buf(int, 64), pc: new_buf(int, 64), pd: new_buf(int, 64), child: new_buf(int, 64), next: new_buf(int, 64), count: 0, root: -1, pos: 0, half: 0, depth: 0, err_tok: new_buf(int, 8), err_code: new_buf(int, 8), err_count: 0 }

/#/ Lexes and parses `src`; the result owns the source and the tokens.
/#/ Moves the classes declared inside function bodies to the end of the program's items: a class
/#/ is a module-level thing for every later stage.
fn hoist_classes(a: &Ast) => void:
    let last = a.child[a.root]
    if last < 0:
        return
    while a.next[last] >= 0:
        last = a.next[last]
    for b in 0..a.count:
        if a.kind[b] != int(Nk.Block):
            continue
        let prev = -1
        let c = a.child[b]
        while c >= 0:
            let nx = a.next[c]
            if a.kind[c] == int(Nk.Class):
                if prev < 0:
                    a.child[b] = nx
                else:
                    a.next[prev] = nx
                a.next[c] = -1
                a.next[last] = c
                last = c
            else:
                prev = c
            c = nx

/#/ Like `parse`, but the classes declared in bodies stay where they are.
fn parse_flat(src: str) => Ast:
    return parse_bytes_flat(bytes_of_str(&src), len(src))

/#/ `parse_flat` of the `size` bytes in `bytes`.
fn parse_bytes_flat(bytes: buf<int>, size: int) => Ast:
    let toks = lex_bytes(&bytes, size)
    let ast = new_ast(bytes, size, toks)
    ast.parse_program()
    return ast

/#/ `parse` of the `size` bytes in `bytes`.
fn parse_bytes(bytes: buf<int>, size: int) => Ast:
    let ast = parse_bytes_flat(bytes, size)
    hoist_classes(&ast)
    return ast

fn parse(src: str) => Ast:
    let ast = parse_flat(src)
    hoist_classes(&ast)
    return ast


/#/ What a name stands for.
enum Sk:
    Fn
    Class
    Enum
    Local
    Param
    Extern
    Builtin
    Module
    TypeParam
    Global
    Field
    Import
    Parent
    Alias
    Method
    Variant

/#/ Rows with the same hash modulo this are chained, newest first (`head`, `link`; row + 1, 0 for none).
let buckets = 4096

/#/ A name is hashed before its bytes are compared. Kept small so it cannot overflow.
fn hash_step(h: int, b: int) => int:
    return (h * 31 + b + 1) % 1000003

class Syms:
    hash: buf<int>
    off: buf<int>
    size: buf<int>
    kind: buf<int>
    info: buf<int>
    mod: buf<int>
    used: buf<int>
    tok: buf<int>
    ty: buf<int>
    link: buf<int>
    head: buf<int>
    /#/ the index of member rows by owner (see `member_head`)
    mh: buf<int>
    mx: buf<int>
    mn: int
    gen: int
    mg: int
    n: int
    pool: buf<int>
    pool_n: int

    fn grow(self) => void:
        if self.n < len(self.hash):
            return
        let cap = (self.n + 1) * 2
        self.hash = buf_resize(self.hash, cap)
        self.off = buf_resize(self.off, cap)
        self.size = buf_resize(self.size, cap)
        self.kind = buf_resize(self.kind, cap)
        self.info = buf_resize(self.info, cap)
        self.mod = buf_resize(self.mod, cap)
        self.used = buf_resize(self.used, cap)
        self.tok = buf_resize(self.tok, cap)
        self.ty = buf_resize(self.ty, cap)
        self.link = buf_resize(self.link, cap)

    fn put_byte(self, b: int) => void:
        if self.pool_n >= len(self.pool):
            self.pool = buf_resize(self.pool, (self.pool_n + 1) * 2)
        self.pool[self.pool_n] = b
        self.pool_n = self.pool_n + 1

    /#/ Appends a row whose name bytes are already in the pool from `start`.
    fn push_row(self, start: int, h: int, kind: int, info: int, mod: int, tok: int) => int:
        self.grow()
        let i = self.n
        self.hash[i] = h
        self.off[i] = start
        self.size[i] = self.pool_n - start
        self.kind[i] = kind
        self.info[i] = info
        self.mod[i] = mod
        self.used[i] = 0
        self.tok[i] = tok
        self.ty[i] = -1
        let b = h % buckets
        self.link[i] = self.head[b]
        self.head[b] = i + 1
        self.n = i + 1
        return i

    /#/ Adds the name spelled by bytes [s, e) of `a`'s source.
    fn add_span(self, a: &Ast, s: int, e: int, kind: int, info: int, mod: int, tok: int) => int:
        let start = self.pool_n
        let h = 0
        for k in s..e:
            let b = a.byte_at(k)
            self.put_byte(b)
            h = hash_step(h, b)
        return self.push_row(start, h, kind, info, mod, tok)

    fn add_tok(self, a: &Ast, tok: int, kind: int, info: int, mod: int) => int:
        return self.add_span(a, a.toks.start[tok], a.toks.end[tok], kind, info, mod, tok)

    fn add_text(self, s: &str, kind: int, info: int, mod: int) => int:
        let start = self.pool_n
        let h = 0
        for k in 0..len(s):
            let b = byte(s, k)
            self.put_byte(b)
            h = hash_step(h, b)
        return self.push_row(start, h, kind, info, mod, -1)

    /#/ Copies row `i` of `o`, with its kind, info and module.
    fn copy_row(self, o: &Syms, i: int) => int:
        let start = self.pool_n
        for k in 0..o.size[i]:
            self.put_byte(o.pool[o.off[i] + k])
        let r = self.push_row(start, o.hash[i], o.kind[i], o.info[i], o.mod[i], o.tok[i])
        self.ty[r] = o.ty[i]
        return r

    /#/ Row `i` is named by bytes [s, e) of `a`'s source.
    fn same_span(self, i: int, a: &Ast, s: int, e: int, h: int) => bool:
        if self.hash[i] != h || self.size[i] != e - s:
            return false
        for k in 0..self.size[i]:
            if self.pool[self.off[i] + k] != a.byte_at(s + k):
                return false
        return true

    fn span_hash(self, a: &Ast, s: int, e: int) => int:
        let h = 0
        for k in s..e:
            h = hash_step(h, a.byte_at(k))
        return h

    /#/ The newest row at or above `lo` named like [s, e); -1 when there is none.
    fn find_span(self, a: &Ast, s: int, e: int, lo: int) => int:
        let h = self.span_hash(a, s, e)
        let i = self.head[h % buckets] - 1
        while i >= lo:
            if self.same_span(i, a, s, e, h):
                return i
            i = self.link[i] - 1
        return -1

    fn find_tok(self, a: &Ast, tok: int, lo: int) => int:
        return self.find_span(a, a.toks.start[tok], a.toks.end[tok], lo)

    /#/ The newest row of module `mod` named like `tok` and not a field; -1 when none.
    fn find_in_module(self, a: &Ast, tok: int, mod: int) => int:
        let s = a.toks.start[tok]
        let e = a.toks.end[tok]
        let h = self.span_hash(a, s, e)
        let i = self.head[h % buckets] - 1
        while i >= 0:
            if self.mod[i] == mod && self.kind[i] != int(Sk.Field) && self.kind[i] != int(Sk.Module) && self.kind[i] != int(Sk.Import) && self.kind[i] != int(Sk.Parent) && self.kind[i] != int(Sk.Method) && self.kind[i] != int(Sk.Variant) && self.same_span(i, a, s, e, h):
                return i
            i = self.link[i] - 1
        return -1

    /#/ The module row named like `tok`; -1 when none.
    fn find_module(self, a: &Ast, tok: int) => int:
        let s = a.toks.start[tok]
        let e = a.toks.end[tok]
        let h = self.span_hash(a, s, e)
        let i = 0
        while i < self.n:
            if self.kind[i] == int(Sk.Module) && self.same_span(i, a, s, e, h):
                return i
            i = i + 1
        return -1

    /#/ The module row named like row `i` (an Import row); -1 when there is none.
    fn find_module_row(self, i: int) => int:
        let k = 0
        while k < self.n:
            if self.kind[k] == int(Sk.Module) && self.hash[k] == self.hash[i] && self.size[k] == self.size[i]:
                let same = true
                for b in 0..self.size[k]:
                    if self.pool[self.off[k] + b] != self.pool[self.off[i] + b]:
                        same = false
                if same:
                    return k
            k = k + 1
        return -1

    /#/ The Class row named like row `i` (a Parent row); -1 when there is none.
    fn find_class_row(self, i: int) => int:
        let k = 0
        while k < self.n:
            if self.kind[k] == int(Sk.Class) && self.hash[k] == self.hash[i] && self.size[k] == self.size[i]:
                let same = true
                for b in 0..self.size[k]:
                    if self.pool[self.off[k] + b] != self.pool[self.off[i] + b]:
                        same = false
                if same:
                    return k
            k = k + 1
        return -1

    /#/ Drops every row from `mark` up.
    /#/ The newest member row (field, method, variant or parent) of `owner` as row + 1; 0 when none.
    /#/ `member_next` goes on to the one before. The index takes in the rows added since its last use.
    fn member_head(self, owner: int) => int:
        if self.mg != self.gen:
            self.mg = self.gen
            self.mn = 0
            for k in 0..len(self.mh):
                self.mh[k] = 0
        if len(self.mh) < self.n + 1:
            self.mh = buf_resize(self.mh, (self.n + 1) * 2)
        if len(self.mx) < self.n + 1:
            self.mx = buf_resize(self.mx, (self.n + 1) * 2)
        while self.mn < self.n:
            let k = self.kind[self.mn]
            if k == int(Sk.Field) || k == int(Sk.Method) || k == int(Sk.Variant) || k == int(Sk.Parent):
                let o = self.info[self.mn]
                if o >= 0 && o < len(self.mh):
                    self.mx[self.mn] = self.mh[o]
                    self.mh[o] = self.mn + 1
            self.mn = self.mn + 1
        if owner < 0 || owner >= len(self.mh):
            return 0
        return self.mh[owner]

    fn member_next(self, row: int) => int:
        return self.mx[row]

    fn truncate(self, mark: int) => void:
        if mark < self.n:
            self.gen = self.gen + 1
            let k = self.n - 1
            while k >= mark:
                self.head[self.hash[k] % buckets] = self.link[k]
                k = k - 1
            self.pool_n = self.off[mark]
            self.n = mark

    /#/ First byte of row `i`'s name, 0 for an empty one.
    fn first_byte(self, i: int) => int:
        if self.size[i] == 0:
            return 0
        return self.pool[self.off[i]]

fn new_syms() => Syms:
    return Syms { hash: new_buf(int, 64), off: new_buf(int, 64), size: new_buf(int, 64), kind: new_buf(int, 64), info: new_buf(int, 64), mod: new_buf(int, 64), used: new_buf(int, 64), tok: new_buf(int, 64), ty: new_buf(int, 64), link: new_buf(int, 64), head: new_buf(int, buckets), mh: new_buf(int, 64), mx: new_buf(int, 64), mn: 0, gen: 0, mg: 0, n: 0, pool: new_buf(int, 256), pool_n: 0 }

