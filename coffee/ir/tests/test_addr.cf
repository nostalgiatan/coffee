/#/ Loads and stores through an element or a field: the address modes, for every element size.
use * in say

class P:
    a: int
    b: int(4)+
    c: int(1)+
    d: int

fn check(what: int, got: int, want: int) => int:
    if got != want:
        say(f"MISS #{what}: got {got}, want {want}\n")
        return 1
    return 0

fn main() => int:
    let m = 0
    let n = 40
    let b1: buf<int(1)+> = new_buf(i8, n)
    let b2: buf<int(2)+> = new_buf(i16, n)
    let b4: buf<int(4)+> = new_buf(i32, n)
    let b8: buf<int> = new_buf(int, n)
    for i in 0..n:
        b1[i] = (i * 3) as int(1)+
        b2[i] = (i * 300) as int(2)+
        b4[i] = (i * 70000) as int(4)+
        b8[i] = i * 5000000000
    let s1 = 0
    let s2 = 0
    let s4 = 0
    let s8 = 0
    for i in 0..n:
        s1 += int(b1[i])
        s2 += int(b2[i])
        s4 += int(b4[i])
        s8 += b8[i]
    /#/ the sums of the arithmetic series, with the bytes and halves that wrap
    m += check(1, s8, 5000000000 * 780)
    m += check(2, s4, 70000 * 780)
    m += check(3, s2, 300 * 780)
    m += check(4, s1, 3 * 780)
    /#/ a high index and a computed one
    let k = 37
    m += check(5, b8[k], 37 * 5000000000)
    m += check(6, b8[k - 1] + b8[k + 2], 36 * 5000000000 + 39 * 5000000000)
    m += check(7, b4[k % 7 + 30], (k % 7 + 30) * 70000)
    /#/ fields of a class
    let p = P { a: 11, b: 22, c: 33, d: 44 }
    p.a = p.a + 1
    p.b = p.b * 2
    p.c = p.c + 3
    p.d = p.d + p.a
    m += check(8, p.a, 12)
    m += check(9, p.b, 44)
    m += check(10, p.c, 36)
    m += check(11, p.d, 56)
    /#/ the same element read twice, and an element used as an index
    let idx: buf<int> = new_buf(int, 4)
    idx[0] = 3
    idx[1] = 2
    idx[2] = 1
    idx[3] = 0
    let t = 0
    for i in 0..4:
        t += b8[idx[i]] * (i + 1)
    m += check(12, t, (3 * 1 + 2 * 2 + 1 * 3 + 0 * 4) * 5000000000)
    return m
