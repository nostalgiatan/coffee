use * in say
use * in drive

/#/ the bytes of the code the assembler made, as a list of numbers
fn code_is(a: &Asm, want: buf<int>) => int:
    if a.pos() != len(want):
        say(f"FAIL: {a.pos()} bytes, want {len(want)}\n")
        return 1
    for k in 0..len(want):
        if a.c.b[k] != want[k]:
            let got = a.c.b[k]
            say(f"FAIL: byte {k} is {got}, want {want[k]}\n")
            return 1
    return 0

fn main() => int:
    let m = 0
    /#/ encodings
    let a = new_asm()
    a.mov_rr(0, 1)
    let w: buf<int> = new_buf(int, 3)
    w[0] = 72
    w[1] = 139
    w[2] = 193
    m = m + code_is(&a, w)
    let b = new_asm()
    b.ret()
    let w2: buf<int> = new_buf(int, 1)
    w2[0] = 195
    m = m + code_is(&b, w2)
    /#/ arithmetic, branches, loops
    m = m + expect_mc("fn main() => int:\n    let a = 7\n    let b = 5\n    return a * b - a // b + a % b\n", 36)
    m = m + expect_mc("fn main() => int:\n    let s = 0\n    for i in 0..10:\n        if i % 2 == 0:\n            s = s + i\n    return s\n", 20)
    m = m + expect_mc("fn main() => int:\n    let n = 0\n    while n < 100:\n        n = n + 7\n    return n\n", 105)
    /#/ bitwise and shifts, negative numbers
    m = m + expect_mc("fn main() => int:\n    let x = 0 - 8\n    return ((x >> 1) & 255) + (3 << 4) + (6 ^ 3) + (5 | 8)\n", 62)
    /#/ calls, recursion
    m = m + expect_mc("fn fib(n: int) => int:\n    if n < 2:\n        return n\n    return fib(n - 1) + fib(n - 2)\n\nfn main() => int:\n    return fib(10)\n", 55)
    /#/ more arguments than registers
    m = m + expect_mc("fn f(a: int, b: int, c: int, d: int, e: int, g: int, h: int, i: int) => int:\n    return a + 2 * b + 3 * c + 4 * d + 5 * e + 6 * g + 7 * h + 8 * i\n\nfn main() => int:\n    return f(1, 1, 1, 1, 1, 1, 1, 1) % 100\n", 36)
    /#/ floats
    m = m + expect_mc("fn main() => int:\n    let x = 1.5\n    let y = x * 4.0 + 0.5\n    return int(y)\n", 6)
    /#/ classes, buffers, arrays, strings
    m = m + expect_mc("class P:\n    x: int\n    y: int\n\n    fn sum(self) => int:\n        return self.x + self.y\n\nfn main() => int:\n    let p = P { x: 3, y: 4 }\n    return p.sum()\n", 7)
    m = m + expect_mc("fn main() => int:\n    let b: buf<int> = new_buf(int, 6)\n    for i in 0..6:\n        b[i] = i * i\n    return b[5] + b[2] + len(b)\n", 35)
    m = m + expect_mc("fn main() => int:\n    let a = [4, 5, 6]\n    let s = 0\n    for i in 0..len(a):\n        s = s + a[i]\n    return s\n", 15)
    m = m + expect_mc("fn main() => int:\n    return len(\"hello\")\n", 5)
    /#/ match, a chain of tests
    m = m + expect_mc("fn main() => int:\n    let v = 3\n    match v:\n        1 => return 10\n        3 => return 30\n        _ => return 0\n    return 1\n", 30)
    /#/ an index out of range stops the program
    m = m + expect_mc_early("fn main() => int:\n    let b: buf<int> = new_buf(int, 3)\n    let i = 3\n    return b[i] + 7\n", 1)
    /#/ immediate operands and fused compare-and-branch, with negative and wide constants
    m = m + expect_mc("fn main() => int:\n    let x = 5 - 8\n    if x < 0 - 3:\n        return 11\n    elif x >= 0 - 4:\n        return x + 20\n    return 0\n", 17)
    m = m + expect_mc("fn main() => int:\n    let big = 5000000000\n    let v = big + 7\n    if v > 5000000000:\n        return int(v - 5000000000)\n    return 0\n", 7)
    m = m + expect_mc("fn main() => int:\n    let c = 0\n    for i in 0..50:\n        if i % 3 == 0 || i > 40:\n            c = c + 1\n        else:\n            c = c + 2\n    return c\n", 77)
    /#/ temporaries of the right side of || and && are released on the path that made them
    m = m + expect_mc("fn f(n: int) => str:\n    return \"x\" + \"y\"\n\nfn main() => int:\n    let c = 0\n    for i in 0..10:\n        if f(i) != \"xy\" || f(i + 1) == \"xy\":\n            c = c + 1\n        if f(i) == \"xy\" && f(i) != \"zz\":\n            c = c + 10\n        if f(i) == \"no\" && f(i) != \"zz\":\n            c = c + 100\n    return c\n", 110)
    /#/ the same expression and the same condition seen again in a dominated block
    m = m + expect_mc("fn main() => int:\n    let b: buf<int> = new_buf(int, 8)\n    for i in 0..8:\n        b[i] = i * 3\n    let s = 0\n    for i in 0..8:\n        s = s + b[i] + b[i] * (i + 1) + (i + 1) * b[i]\n    return s % 256\n", 68)
    m = m + expect_mc("fn g(x: int) => int:\n    let r = 0\n    if x > 3:\n        r = r + 1\n        if x > 3:\n            r = r + 10\n        else:\n            r = r + 100\n    else:\n        if x > 3:\n            r = r + 1000\n        else:\n            r = r + 5\n    return r\n\nfn main() => int:\n    return g(1) + g(9)\n", 16)
    return m
