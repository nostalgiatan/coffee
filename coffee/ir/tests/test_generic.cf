use * in drive

fn main() => int:
    let m = 0
    /#/ a generic function at two types
    m = m + expect_exit("fn id<T>(x: T) => T:\n    return x\n\nfn main() => int:\n    let f = id(2.5)\n    let k = id(40)\n    if f > 2.0:\n        return k + 2\n    return 0\n", 42)
    /#/ the argument is an owner: it moves in and out
    m = m + expect_exit("fn id<T>(x: T) => T:\n    return x\n\nfn main() => int:\n    let s = id(\"ab\" + \"cd\")\n    return len(s)\n", 4)
    /#/ a generic class with a field of the parameter type
    m = m + expect_exit("class Box<T>:\n    v: T\n\n    fn get(self) => T:\n        return self.v\n\n    fn put(self, x: T) => void:\n        self.v = x\n\nfn main() => int:\n    let b: Box<int> = Box { v: 3 }\n    b.put(b.get() + 4)\n    return b.get()\n", 7)
    /#/ the same class at an owning type: the glue frees what it holds
    m = m + expect_exit("class Box<T>:\n    v: T\n\n    fn get(self) => &T:\n        return &self.v\n\nfn main() => int:\n    let b: Box<str> = Box { v: \"x\" + \"yz\" }\n    let c: Box<int> = Box { v: 1 }\n    return len(b.get()) + c.v\n", 4)
    /#/ a generic function that builds a generic class
    m = m + expect_exit("class Pair<A, B>:\n    a: A\n    b: B\n\nfn make<A, B>(x: A, y: B) => Pair<A, B>:\n    return Pair { a: x, b: y }\n\nfn main() => int:\n    let p = make(5, 6)\n    return p.a * 10 + p.b\n", 56)
    return m
