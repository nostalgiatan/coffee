use * in drive
use putchar in libc of c

fn main() => int:
    let m = 0
    /#/ a reference to a local: the variable lives in a slot
    m = m + expect_exit("fn bump(x: &mut int) => void:\n    *x = *x + 5\n\nfn main() => int:\n    let v = 10\n    bump(&mut v)\n    bump(&mut v)\n    return v\n", 20)
    m = m + expect_exit("fn peek(x: &int) => int:\n    return *x * 2\n\nfn main() => int:\n    let v = 4\n    let r = peek(&v)\n    v = 1\n    return r + peek(&v)\n", 10)
    /#/ classes: literal, fields, methods, static functions
    m = m + expect_exit("class P:\n    x: int\n    y: int\n\n    fn sum(self) => int:\n        return self.x + self.y\n\n    fn bump(self, d: int) => void:\n        self.x = self.x + d\n\nfn main() => int:\n    let p = P { x: 3, y: 4 }\n    p.bump(10)\n    return p.sum() + p.y\n", 21)
    m = m + expect_exit("class A:\n    n: int\n\n    fn make(k: int) => A:\n        return A { n: k }\n\nfn main() => int:\n    let a = A::make(9)\n    return a.n\n", 9)
    /#/ a field of another size, after a smaller one
    m = m + expect_exit("class Q:\n    a: int(1)+\n    b: int\n    c: int(2)+\n\nfn main() => int:\n    let q = Q { a: 1, b: 30, c: 5 }\n    return int(q.a) + q.b + int(q.c)\n", 36)
    /#/ buf<int>: indexing, len, writing, passing by reference
    m = m + expect_exit("fn fill(b: &mut buf<int>) => void:\n    for i in 0..len(b):\n        b[i] = i * i\n\nfn main() => int:\n    let b: buf<int> = new_buf(int, 6)\n    fill(&mut b)\n    return b[5] + b[2] + len(b)\n", 35)
    /#/ arrays
    m = m + expect_exit("fn main() => int:\n    let a = [4, 5, 6]\n    let s = 0\n    for i in 0..len(a):\n        s = s + a[i]\n    a[1] = 10\n    return s + a[1]\n", 25)
    /#/ an index out of range stops the program with exit code 1
    m = m + expect_exit_early("fn main() => int:\n    let b: buf<int> = new_buf(int, 3)\n    let i = 3\n    return b[i] + 7\n", 1)
    m = m + expect_exit_early("fn main() => int:\n    let a = [1, 2]\n    let i = 0 - 1\n    return a[i]\n", 1)
    /#/ the length of a string
    m = m + expect_exit("fn main() => int:\n    return len(\"hello\")\n", 5)
    /#/ a child class: the parent's fields come first
    m = m + expect_exit("class A:\n    p: int\n\nclass B of A:\n    q: int\n\n    fn both(self) => int:\n        return self.p * 10 + self.q\n\nfn main() => int:\n    let b = B { p: 4, q: 2 }\n    return b.both()\n", 42)
    return m
