/#/ The check of sandbox code (src/sbxcheck.cf) on byte sequences written out by hand: what it
/#/ refuses and what it takes. A sequence is the decimal bytes separated by spaces.
use * in say
use * in txt
use * in sbxcheck
use fflush in libc of c

fn expect(what: int, got: int, want: int) => int:
    if got != want:
        say(f"MISS #{what}: got {got}, want {want}\n")
        fflush(0)
        return 1
    return 0

fn bytes_of(s: str) => Txt:
    let out = new_txt()
    let cur = 0
    let have = false
    for i in 0..len(s) + 1:
        if i == len(s) || s[i] == 32:
            if have:
                out.put_byte(cur)
            cur = 0
            have = false
        else:
            cur = cur * 10 + (int(s[i]) - 48)
            have = true
    return out

/#/ -1 when the bytes pass, else the offset refused.
fn check(s: str) => int:
    let t = bytes_of(s)
    return sbx_verify(&t, t.n, -1)

fn main() => int:
    let m = 0
    /#/ taken: a function frame, a gs access, an rbp access, arithmetic, jumps inside
    m = m + expect(1, check("85 72 139 236 72 131 236 16 72 139 229 93 195"), -1)
    m = m + expect(2, check("103 101 72 139 8 195"), -1)
    m = m + expect(3, check("72 139 69 248 72 137 69 240 195"), -1)
    m = m + expect(4, check("72 137 69 16 195"), -1)
    m = m + expect(5, check("72 3 193 72 43 193 235 1 195 195"), -1)
    m = m + expect(6, check("72 59 193 15 132 1 0 0 0 195 195"), -1)
    /#/ refused: system call, interrupt, set the segment base, indirect jump and call
    m = m + expect(7, check("195 15 5"), 1)
    m = m + expect(8, check("205 128"), 0)
    m = m + expect(9, check("243 72 15 174 192"), 0)
    m = m + expect(10, check("255 224"), 0)
    m = m + expect(11, check("255 208"), 0)
    /#/ refused: memory not through gs, on its own or with one prefix; other segments
    m = m + expect(12, check("72 137 8 195"), 0)
    m = m + expect(13, check("103 72 139 8"), 0)
    m = m + expect(14, check("101 72 139 8"), 0)
    m = m + expect(15, check("100 72 139 8"), 0)
    /#/ refused: the saved rbp and the return address, far offsets, rsp as a base
    m = m + expect(16, check("72 139 69 0"), 0)
    m = m + expect(17, check("72 137 69 8"), 0)
    m = m + expect(18, check("72 139 133 0 128 0 0"), 0)
    m = m + expect(19, check("72 139 4 36"), 0)
    /#/ refused: rsp or rbp written other than as a frame is
    m = m + expect(20, check("92 195"), 0)
    m = m + expect(21, check("72 137 196"), 0)
    m = m + expect(22, check("72 137 197"), 0)
    m = m + expect(23, check("72 129 236 1 0 1 0"), 0)
    /#/ refused: a jump into the middle of an instruction, out of the code, a prefix the instruction does not take
    m = m + expect(24, check("235 2 184 0 0 0 0 195"), 0)
    m = m + expect(25, check("233 100 0 0 0"), 0)
    m = m + expect(26, check("102 129 192 1 0 195"), 0)
    /#/ a call to the entry given is taken, any other target outside the code is not
    let t = bytes_of("232 11 0 0 0 195")
    m = m + expect(27, sbx_verify(&t, t.n, 16), -1)
    m = m + expect(28, sbx_verify(&t, t.n, 17), 0)
    /#/ the last instruction must not fall off the end
    m = m + expect(30, check("72 3 193"), 0)
    m = m + expect(31, check("72 3 193 195 72 3 193"), 4)
    /#/ cut short
    m = m + expect(29, check("72 139"), 0)
    /#/ the base-register form: an address is made in r13 as a 32-bit number and used as [r15 + r13]
    sbx_set_base(true)
    m = m + expect(40, check("68 141 104 8 75 139 4 47 195"), -1)
    m = m + expect(41, check("68 141 104 8 75 137 4 47 195"), -1)
    m = m + expect(42, check("73 3 197 195"), -1)
    m = m + expect(43, check("72 139 69 248 195"), -1)
    /#/ refused: another index or base, writes to r13 or r15, a 64-bit lea into r13, the gs prefixes
    m = m + expect(44, check("73 139 4 15 195"), 0)
    m = m + expect(45, check("76 139 232 195"), 0)
    m = m + expect(46, check("76 139 248 195"), 0)
    m = m + expect(47, check("76 141 104 8 195"), 0)
    m = m + expect(48, check("69 51 237 195"), 0)
    m = m + expect(49, check("103 101 72 139 8 195"), 0)
    /#/ [r15 + r13] is refused when the code is not of that form
    sbx_set_base(false)
    m = m + expect(50, check("75 139 4 47 195"), 0)
    m = m + expect(51, check("68 141 104 8 195"), -1)
    return m
