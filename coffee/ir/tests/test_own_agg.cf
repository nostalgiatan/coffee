use * in drive

fn main() => int:
    let m = 0
    /#/ an array of strings in a class: dropped element by element
    m = m + expect_exit("class H:\n    xs: [str; 2]\n\nfn main() => int:\n    let h = H { xs: [\"a\", \"bc\"] }\n    return len(h.xs[1])\n", 2)
    /#/ a local array of strings
    m = m + expect_exit("fn main() => int:\n    let xs = [\"ab\", \"cde\"]\n    return len(xs[0]) + len(xs[1])\n", 5)
    /#/ cloning a class with an array of strings
    m = m + expect_exit("class H:\n    xs: [str; 2]\n\nfn main() => int:\n    let a = H { xs: [\"a\", \"bc\"] }\n    let b = clone a\n    return len(a.xs[1]) + len(b.xs[1])\n", 4)
    /#/ cloning a local array of strings
    m = m + expect_exit("fn main() => int:\n    let a = [\"a\", \"bcd\"]\n    let b = clone a\n    return len(a[1]) + len(b[1])\n", 6)
    /#/ tuples that own a string: dropped, cloned, returned, held by a class
    m = m + expect_exit("fn main() => int:\n    let t: (str, int) = (\"ab\", 5)\n    return 3\n", 3)
    m = m + expect_exit("fn main() => int:\n    let t: (str, int) = (\"abc\", 5)\n    let u: (str, int) = clone t\n    return 4\n", 4)
    m = m + expect_exit("fn pair(s: str) => (str, int):\n    return (s, 4)\n\nfn main() => int:\n    let p = pair(\"xy\")\n    return 6\n", 6)
    m = m + expect_exit("class T:\n    p: (str, int)\n\nfn main() => int:\n    let a = T { p: (\"hi\", 1) }\n    let b = clone a\n    return 3\n", 3)
    m = m + expect_exit("fn main() => int:\n    let t: (str, str) = (\"a\", \"b\")\n    let u: (str, str) = t\n    return 2\n", 2)
    /#/ an array lent as a slice
    m = m + expect_exit("fn sum(xs: [int]) => int:\n    let s = 0\n    for i in 0..len(xs):\n        s = s + xs[i]\n    return s\n\nfn main() => int:\n    let a = [1, 2, 3]\n    return sum(a)\n", 6)
    m = m + expect_exit("fn first(xs: [str]) => int:\n    return len(xs[0])\n\nfn main() => int:\n    let a = [\"abc\", \"d\"]\n    return first(a)\n", 3)
    return m
