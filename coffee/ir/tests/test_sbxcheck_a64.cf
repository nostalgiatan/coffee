/#/ The check of aarch64 sandbox code (src/sbxcheck_a64.cf) on words made by LLVM's assembler: the frame,
/#/ accesses through x28 and x29, arithmetic and floating point it takes, and the loads, stores, writes of x28..x30 and sp,
/#/ branches and system instructions it refuses.
use * in say
use * in txt
use * in sbxcheck_a64
use fflush in libc of c

fn expect(what: int, got: int, want: int) => int:
    if got != want:
        say(f"MISS #{what}: got {got}, want {want}\n")
        fflush(0)
        return 1
    return 0

/#/ -1 when the words pass, else the offset refused.
fn check(w: &buf<int>, n: int) => int:
    let t = new_txt()
    for k in 0..n:
        t.put_byte(w[k] & 255)
        t.put_byte((w[k] >> 8) & 255)
        t.put_byte((w[k] >> 16) & 255)
        t.put_byte((w[k] >> 24) & 255)
    return sbx_verify_a64(&t, t.n, -1)

