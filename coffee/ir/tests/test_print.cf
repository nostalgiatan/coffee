use * in print
use putchar in libc of c

fn main() => int:
    let m = 0
    let rs = new_reps()
    let i64 = int(Rp.I64)
    let f = new_fun("add_one", i64)
    let b0 = f.new_block()
    f.set_block(b0)
    let x = f.param(b0, i64, -1)
    let y = f.bin(int(Op.Add), x, f.cint(i64, 1))
    f.ret_v(y)
    let o = new_txt()
    put_fun(&o, &f, &rs)
    if !o.is("fn add_one(%0: i64) -> i64:\nconsts:\n  %1 = const i64 1\nbb0:\n  %2 = add i64 %0, %1\n  ret %2\n"):
        m = m + 1
        for k in 0..o.n:
            putchar(o.b[k])
    /#/ a loop with a block parameter, a branch and a call
    let g = new_fun("count", i64)
    let e = g.new_block()
    let head = g.new_block()
    let body = g.new_block()
    let done = g.new_block()
    g.set_block(e)
    let n = g.param(e, i64, -1)
    g.arg(g.cint(i64, 0))
    g.br(head)
    g.set_block(head)
    let i = g.param(head, i64, -1)
    let c = g.cmp(int(Pr.SLt), i, n)
    g.arg(i)
    let t = g.mk_edge(body)
    let fl = g.mk_edge(done)
    g.condbr(c, t, fl)
    g.set_block(body)
    g.arg(i)
    let r = g.call(i64, -1, 4)
    g.arg(g.bin(int(Op.Add), r, g.cint(i64, 1)))
    g.br(head)
    g.set_block(done)
    g.ret_v(i)
    let p = new_txt()
    put_fun(&p, &g, &rs)
    let want = "fn count(%0: i64) -> i64:\nconsts:\n  %1 = const i64 0\n  %7 = const i64 1\nbb0:\n  br bb1(%1)\nbb1(%3: i64):\n  %4 = cmp.slt i8 %3, %0\n  condbr %4, bb2(%3), bb3()\nbb2:\n  %6 = call i64 @4(%3)\n  %8 = add i64 %6, %7\n  br bb1(%8)\nbb3:\n  ret %3\n"
    if !p.is(&want):
        m = m + 1
        for k in 0..p.n:
            putchar(p.b[k])
    return m
