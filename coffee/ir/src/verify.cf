/#/ The checker of the IR. It runs after the builder and after every pass in tests, so a
/#/ mistake in one is found where it was made. It checks the shape (one terminator, last),
/#/ the edges (target, number and type of arguments), the types the operation needs, and that
/#/ every use is dominated by its definition.
use * in print

enum Ve:
    NoTerminator
    MidTerminator
    EdgeTarget
    EdgeArity
    EdgeType
    OpType
    NotDominated
    RetType

class VDiags:
    code: buf<int>
    inst: buf<int>
    blk: buf<int>
    n: int

    fn add(self, code: int, inst: int, blk: int) => void:
        if self.n >= len(self.code):
            let cap = (self.n + 1) * 2
            self.code = buf_resize(self.code, cap)
            self.inst = buf_resize(self.inst, cap)
            self.blk = buf_resize(self.blk, cap)
        self.code[self.n] = code
        self.inst[self.n] = inst
        self.blk[self.n] = blk
        self.n = self.n + 1

    fn count(self, code: int) => int:
        let c = 0
        for i in 0..self.n:
            if self.code[i] == code:
                c = c + 1
        return c

fn new_vdiags() => VDiags:
    return VDiags { code: new_buf(int, 8), inst: new_buf(int, 8), blk: new_buf(int, 8), n: 0 }

/#/ Are the operand and result representations what operation `i` needs?
fn types_ok(f: &Fun, i: int) => bool:
    let o = f.op[i]
    let r = f.rep[i]
    if o == int(Op.Add) || o == int(Op.Sub) || o == int(Op.Mul) || o == int(Op.SDiv) || o == int(Op.UDiv) || o == int(Op.SRem) || o == int(Op.URem) || o == int(Op.And) || o == int(Op.Or) || o == int(Op.Xor) || o == int(Op.Shl) || o == int(Op.AShr) || o == int(Op.LShr) || o == int(Op.SMulHi):
        return rp_is_int(r) && f.rep[f.follow(f.a[i])] == r && f.rep[f.follow(f.b[i])] == r
    if o == int(Op.Neg) || o == int(Op.Not):
        return rp_is_int(r) && f.rep[f.follow(f.a[i])] == r
    if o == int(Op.FAdd) || o == int(Op.FSub) || o == int(Op.FMul) || o == int(Op.FDiv) || o == int(Op.FRem):
        return rp_is_float(r) && f.rep[f.follow(f.a[i])] == r && f.rep[f.follow(f.b[i])] == r
    if o == int(Op.FNeg):
        return rp_is_float(r) && f.rep[f.follow(f.a[i])] == r
    if o == int(Op.Cmp):
        let x = f.rep[f.follow(f.a[i])]
        return r == int(Rp.I8) && x == f.rep[f.follow(f.b[i])] && (rp_is_int(x) || x == int(Rp.Ptr))
    if o == int(Op.FCmp):
        let x = f.rep[f.follow(f.a[i])]
        return r == int(Rp.I8) && rp_is_float(x) && x == f.rep[f.follow(f.b[i])]
    if o == int(Op.Trunc):
        let x = f.rep[f.follow(f.a[i])]
        return rp_is_int(x) && rp_is_int(r) && rp_bits(x) > rp_bits(r)
    if o == int(Op.SExt) || o == int(Op.ZExt):
        let x = f.rep[f.follow(f.a[i])]
        return rp_is_int(x) && rp_is_int(r) && rp_bits(x) < rp_bits(r)
    /#/ an address is a pointer, or the integer of `peek8` and `poke64` (the memory of the runtime)
    if o == int(Op.Load):
        let ar = f.rep[f.follow(f.a[i])]
        return (ar == int(Rp.Ptr) || ar == int(Rp.I64)) && r != int(Rp.Void)
    if o == int(Op.Store):
        let ar = f.rep[f.follow(f.a[i])]
        return (ar == int(Rp.Ptr) || ar == int(Rp.I64)) && f.rep[f.follow(f.b[i])] != int(Rp.Void)
    if o == int(Op.Field):
        return f.rep[f.follow(f.a[i])] == int(Rp.Ptr) && r == int(Rp.Ptr)
    if o == int(Op.Index):
        return f.rep[f.follow(f.a[i])] == int(Rp.Ptr) && rp_is_int(f.rep[f.follow(f.b[i])]) && r == int(Rp.Ptr)
    if o == int(Op.CondBr):
        return f.rep[f.follow(f.a[i])] == int(Rp.I8)
    if o == int(Op.Switch):
        return rp_is_int(f.rep[f.follow(f.a[i])])
    if o == int(Op.Extract) || o == int(Op.Insert):
        return f.rep[f.follow(f.a[i])] >= rp_first_agg()
    return true

fn dominates(idom: &buf<int>, a: int, b: int) => bool:
    let x = b
    while x >= 0:
        if x == a:
            return true
        if idom[x] == x:
            return false
        x = idom[x]
    return false

/#/ Checks function `f`; the findings are in the result.
fn verify(f: &Fun) => VDiags:
    let d = new_vdiags()
    let nb = f.nb
    /#/ position of each instruction in its block (parameters come before everything)
    let pos: buf<int> = new_buf(int, f.ni + 1)
    for b in 0..nb:
        let k = 0
        let i = f.bfirst[b]
        while i >= 0:
            pos[i] = k
            k = k + 1
            if f.tab.has(f.op[i], f_term()) && f.nx[i] >= 0:
                d.add(int(Ve.MidTerminator), i, b)
            if !types_ok(f, i):
                d.add(int(Ve.OpType), i, b)
            i = f.nx[i]
        if !f.terminated(b):
            d.add(int(Ve.NoTerminator), -1, b)
        else:
            let t = f.blast[b]
            if f.op[t] == int(Op.Ret):
                if f.ret == int(Rp.Void):
                    if f.a[t] >= 0:
                        d.add(int(Ve.RetType), t, b)
                elif f.a[t] < 0 || f.rep[f.follow(f.a[t])] != f.ret:
                    d.add(int(Ve.RetType), t, b)
            for s in 0..f.nsucc(b):
                let e = f.succ_edge(b, s)
                let to = f.eto[e]
                if to < 0 || to >= nb:
                    d.add(int(Ve.EdgeTarget), t, b)
                elif f.eargn[e] != f.npar[to]:
                    d.add(int(Ve.EdgeArity), t, b)
                else:
                    for ea in 0..f.eargn[e]:
                        if f.rep[f.follow(f.pool[f.eargs[e] + ea])] != f.rep[f.param_at(to, ea)]:
                            d.add(int(Ve.EdgeType), t, b)
    if nb == 0:
        return d
    /#/ blocks reachable from the entry, in reverse post-order
    let visited: buf<int> = new_buf(int, nb)
    let ci: buf<int> = new_buf(int, nb)
    let stack: buf<int> = new_buf(int, nb)
    let post: buf<int> = new_buf(int, nb)
    let sp = 1
    let np = 0
    stack[0] = 0
    visited[0] = 1
    while sp > 0:
        let b = stack[sp - 1]
        if f.terminated(b) && ci[b] < f.nsucc(b):
            let t = f.eto[f.succ_edge(b, ci[b])]
            ci[b] = ci[b] + 1
            if t >= 0 && t < nb && visited[t] == 0:
                visited[t] = 1
                stack[sp] = t
                sp = sp + 1
        else:
            post[np] = b
            np = np + 1
            sp = sp - 1
    let rpo: buf<int> = new_buf(int, nb)
    let num: buf<int> = new_buf(int, nb)
    for k in 0..np:
        rpo[k] = post[np - 1 - k]
        num[rpo[k]] = k
    /#/ the predecessors of each block among the reachable ones, in reverse post-order
    let pstart: buf<int> = new_buf(int, nb + 1)
    for k in 0..np:
        let pb = rpo[k]
        if f.terminated(pb):
            for s in 0..f.nsucc(pb):
                let t = f.eto[f.succ_edge(pb, s)]
                if t >= 0 && t < nb:
                    pstart[t + 1] = pstart[t + 1] + 1
    for b in 0..nb:
        pstart[b + 1] = pstart[b + 1] + pstart[b]
    let plist: buf<int> = new_buf(int, pstart[nb] + 1)
    let pfill: buf<int> = new_buf(int, nb + 1)
    for k in 0..np:
        let pb = rpo[k]
        if f.terminated(pb):
            for s in 0..f.nsucc(pb):
                let t = f.eto[f.succ_edge(pb, s)]
                if t >= 0 && t < nb:
                    plist[pstart[t] + pfill[t]] = pb
                    pfill[t] = pfill[t] + 1
    /#/ immediate dominators (Cooper, Harvey, Kennedy)
    let idom: buf<int> = new_buf(int, nb)
    for b in 0..nb:
        idom[b] = -1
    idom[0] = 0
    let changed = true
    while changed:
        changed = false
        for k in 1..np:
            let b = rpo[k]
            let nd = -1
            for pi in pstart[b]..pstart[b + 1]:
                let pb = plist[pi]
                if idom[pb] >= 0:
                    if nd < 0:
                        nd = pb
                    else:
                        let x = pb
                        let y = nd
                        while x != y:
                            while num[x] > num[y]:
                                x = idom[x]
                            while num[y] > num[x]:
                                y = idom[y]
                        nd = x
            if nd != idom[b]:
                idom[b] = nd
                changed = true
    /#/ every use must be dominated by its definition
    for k in 0..np:
        let b = rpo[k]
        let i = f.bfirst[b]
        while i >= 0:
            let nu = f.nval(i)
            for u in 0..nu:
                check_use(f, &d, &idom, &pos, f.val_at(i, u), i, b)
            if i == f.blast[b]:
                for s in 0..f.nsucc(b):
                    let e = f.succ_edge(b, s)
                    for a in 0..f.eargn[e]:
                        check_use(f, &d, &idom, &pos, f.pool[f.eargs[e] + a], i, b)
            i = f.nx[i]
    return d

fn check_use(f: &Fun, d: &VDiags, idom: &buf<int>, pos: &buf<int>, v: int, user: int, ub: int) => void:
    if v < 0:
        return
    let def = f.follow(v)
    let db = f.blk[def]
    if db < 0:
        return
    if db == ub:
        if f.op[def] == int(Op.Param):
            return
        if pos[def] >= pos[user]:
            d.add(int(Ve.NotDominated), user, ub)
        return
    if !dominates(idom, db, ub):
        d.add(int(Ve.NotDominated), user, ub)
