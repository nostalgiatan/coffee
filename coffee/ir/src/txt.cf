/#/ Text built a byte at a time: the buffer the printer and the emitter write to.
use * in op
use write, open, close in libc of c

class Txt:
    b: buf<int>
    n: int

    fn put_byte(self, c: int) => void:
        if self.n >= len(self.b):
            self.b = buf_resize(self.b, (self.n + 1) * 2)
        self.b[self.n] = c
        self.n = self.n + 1

    fn put(self, s: &str) => void:
        for i in 0..len(s):
            self.put_byte(ch(s, i))

    fn clear(self) => void:
        self.n = 0

    fn put_all(self, w: &Txt) => void:
        for i in 0..w.n:
            self.put_byte(w.b[i])

    fn put_int(self, v: int) => void:
        if v < 0 - 9223372036854775807:
            /#/ the smallest int has no negation
            self.put_byte('-')
            self.put_int(922337203685477580)
            self.put_byte('8')
        elif v < 0:
            self.put_byte('-')
            self.put_int(0 - v)
        elif v < 10:
            self.put_byte('0' + v)
        else:
            self.put_int(v // 10)
            self.put_byte('0' + v % 10)

    /#/ Is the text the same as `o`?
    fn same(self, o: &Txt) => bool:
        if self.n != o.n:
            return false
        for i in 0..self.n:
            if self.b[i] != o.b[i]:
                return false
        return true

    /#/ Does the text equal `want`?
    fn is(self, want: &str) => bool:
        if self.n != len(want):
            return false
        for i in 0..self.n:
            if self.b[i] != ch(want, i):
                return false
        return true

fn new_txt() => Txt:
    return Txt { b: new_buf(int, 256), n: 0 }


/#/ Writes `s` to standard output, at once (no buffering).
fn say(s: str) => void:
    write(1, s as object, len(s))

/#/ Writes the byte `c` to standard output.
fn say_byte(c: int) => void:
    let b: buf<i8> = new_buf(i8, 1)
    b[0] = i8(c)
    write(1, buf_ptr(b), 1)

/#/ Writes the bytes of `t` to the file `path`.
fn save_bytes(path: str, t: &Txt) => void:
    let fd = open(path, 577, 420 as object)
    if fd < 0:
        return
    let chunk: buf<i8> = new_buf(i8, t.n + 1)
    for k in 0..t.n:
        chunk[k] = i8(t.b[k])
    let done = 0
    while done < t.n:
        let w = write(fd, (int(buf_ptr(chunk)) + done) as object, t.n - done)
        if w <= 0:
            break
        done = done + w
    close(fd)
