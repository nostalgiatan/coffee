/#/ Code the sandbox verifiers must refuse, one line each, the same list for both targets: the rule it breaks (see
/#/ src/sbxrules.cf), the target (x for x86-64, a for aarch64), the mode (x86-64: b for base mode, g for the `gs`
/#/ form; aarch64: w for one word placed in the body of a frame, r for the words as they are), the offset of the
/#/ refusal, and the code: decimal bytes for x86-64, decimal words for aarch64.
fn sbx_cases() => str:
    let c = ""
    c = c + "decode x g 1 195 15 5\n"
    c = c + "decode x g 0 205 128\n"
    c = c + "decode x g 0 243 72 15 174 192\n"
    c = c + "decode x g 0 255 224\n"
