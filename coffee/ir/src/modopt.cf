/#/ The passes that look at the whole module: a summary of the effects of each function,
/#/ calls that need not be made, and the attributes the summary proves. They work on the IR in
/#/ the `Lib`; nothing here reads or writes LLVM text.
/#/
/#/ Effect bits of a function: it reads memory it does not own (1), writes memory (2),
/#/ allocates (4), calls C or something unknown (8), never returns (16), may not terminate (32).
use * in lib

fn fx_reads() => int:
    return 1

fn fx_writes() => int:
    return 2

fn fx_allocs() => int:
    return 4

fn fx_unknown() => int:
    return 8

fn fx_noreturn() => int:
    return 16

fn fx_loops() => int:
    return 32

/#/ Is the memory `p` points into one of the function's own slots?
fn is_local(f: &Fun, p: int) => bool:
    let x = f.follow(p)
    while f.op[x] == int(Op.Field) || f.op[x] == int(Op.Index):
        x = f.follow(f.a[x])
    return f.op[x] == int(Op.Slot)

/#/ Does a path of edges lead from a block back to itself?
fn has_cycle(f: &Fun) => bool:
    let state: buf<int> = new_buf(int, f.nb + 1)
    let stack: buf<int> = new_buf(int, f.nb + 1)
    let next: buf<int> = new_buf(int, f.nb + 1)
    let sp = 1
    stack[0] = 0
    state[0] = 1
    next[0] = 0
    while sp > 0:
        let b = stack[sp - 1]
        if next[sp - 1] < f.nsucc(b):
            let e = f.succ_edge(b, next[sp - 1])
            next[sp - 1] = next[sp - 1] + 1
            let to = f.eto[e]
            if to >= 0:
                if state[to] == 1:
                    return true
                if state[to] == 0:
                    state[to] = 1
                    stack[sp] = to
                    next[sp] = 0
                    sp = sp + 1
        else:
            state[b] = 2
            sp = sp - 1
    return false

/#/ The effects of `f`, a function of the module `lib`; a callee that is not summarized yet
/#/ (recursion) or not in the module counts as anything.
fn summarize(f: &Fun, lib: &Lib) => int:
    let fx = 0
    let returns = false
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let o = f.op[i]
            if o == int(Op.Load):
                if !is_local(f, f.a[i]):
                    fx = fx | fx_reads()
            elif o == int(Op.Store):
                if !is_local(f, f.a[i]):
                    fx = fx | fx_writes()
            elif o == int(Op.Alloc):
                fx = fx | fx_allocs()
            elif o == int(Op.Clone):
                fx = fx | fx_reads() | fx_allocs()
            elif o == int(Op.Free) || o == int(Op.Drop):
                fx = fx | fx_writes()
            elif o == int(Op.VLoop):
                fx = fx | fx_reads() | fx_writes()
            elif o == int(Op.CCall) || o == int(Op.CallI):
                fx = fx | fx_reads() | fx_writes() | fx_allocs() | fx_unknown() | fx_loops()
            elif o == int(Op.Call):
                let n = lib.find(f.aux[i])
                if n >= 0 && lib.f_done[n] == 1:
                    fx = fx | (lib.f_fx[n] & 47)
                else:
                    fx = fx | fx_reads() | fx_writes() | fx_allocs() | fx_unknown() | fx_loops()
            elif o == int(Op.Ret):
                returns = true
            i = f.nx[i]
    if !returns:
        fx = fx | fx_noreturn()
    if has_cycle(f):
        fx = fx | fx_loops()
    return fx

/#/ A call whose value nobody uses, of a function that only reads, always returns and ends,
/#/ is not made.
fn dead_calls(f: &Fun, lib: &Lib) => bool:
    let changed = false
    for b in 0..f.nb:
        let i = f.blast[b]
        while i >= 0:
            let p = f.pv[i]
            if f.op[i] == int(Op.Call) && f.uses[i] == 0 && f.fwd[i] < 0:
                let n = lib.find(f.aux[i])
                if n >= 0 && lib.f_done[n] == 1:
                    if (lib.f_fx[n] & (fx_writes() | fx_allocs() | fx_unknown() | fx_noreturn() | fx_loops())) == 0:
                        delete_inst(f, i)
                        changed = true
            i = p
    return changed

/#/ The functions in an order where callees come first (a cycle is cut where it is found).
fn call_order(lib: &Lib) => buf<int>:
    let seen: buf<int> = new_buf(int, lib.nf + 1)
    let out: buf<int> = new_buf(int, lib.nf + 1)
    let stack: buf<int> = new_buf(int, lib.nf + 1)
    let pos: buf<int> = new_buf(int, lib.nf + 1)
    let on = 0
    for root in 0..lib.nf:
        if seen[root] == 0:
            seen[root] = 1
            stack[0] = root
            pos[0] = lib.f_i0[root]
            let sp = 1
            while sp > 0:
                let n = stack[sp - 1]
                let end = lib.f_i0[n] + lib.f_ni[n]
                let descended = false
                while pos[sp - 1] < end && !descended:
                    let k = pos[sp - 1]
                    pos[sp - 1] = k + 1
                    if lib.op[k] == int(Op.Call) || lib.op[k] == int(Op.Drop):
                        let c = lib.find(lib.aux[k])
                        if c >= 0 && seen[c] == 0:
                            seen[c] = 1
                            stack[sp] = c
                            pos[sp] = lib.f_i0[c]
                            sp = sp + 1
                            descended = true
                if !descended:
                    out[on] = n
                    on = on + 1
                    sp = sp - 1
    return out

/#/ ---- inlining ------------------------------------------------------------

/#/ How many instructions function `n` of the module has in its blocks.
fn live_count(lib: &Lib, n: int) => int:
    let k = 0
    let i0 = lib.f_i0[n]
    for b in 0..lib.f_nb[n]:
        let i = lib.bfirst[lib.f_b0[n] + b]
        while i >= 0:
            k = k + 1
            i = lib.nx[i0 + i]
    return k

/#/ Does a path of edges lead from block `b` back to `b`?
fn in_loop(f: &Fun, b: int) => bool:
    let seen: buf<int> = new_buf(int, f.nb + 1)
    let stack: buf<int> = new_buf(int, f.nb + 1)
    let sp = 1
    stack[0] = b
    while sp > 0:
        sp = sp - 1
        let x = stack[sp]
        for k in 0..f.nsucc(x):
            let to = f.eto[f.succ_edge(x, k)]
            if to == b:
                return true
            if to >= 0 && seen[to] == 0:
                seen[to] = 1
                stack[sp] = to
                sp = sp + 1
    return false

/#/ How many instructions a body may have to be inlined outside a loop (beyond the call's own
/#/ argument moves): the copy then costs about what the call did. Inside a loop the call is paid
/#/ many times, so a body up to `loop_inline` instructions is copied.
let plain_inline = 4
let loop_inline = 40

/#/ Is the call `c` of `f` to one that may be inlined: a finished function of the module, small,
/#/ other than `f`, taking as many arguments as the call passes?
fn inlinable(f: &Fun, lib: &Lib, c: int, cur: int) => int:
    if f.op[c] != int(Op.Call) || f.fwd[c] >= 0:
        return -1
    let n = lib.find(f.aux[c])
    if n < 0 || lib.f_done[n] == 0 || f.aux[c] == cur:
        return -1
    if lib.f_nb[n] == 0 || lib.npar[lib.f_b0[n]] != f.b[c] || lib.f_ret[n] != f.rep[c]:
        return -1
    if live_count(lib, n) > 12:
        return -1
    /#/ a function that calls itself would only unroll
    let i0 = lib.f_i0[n]
    for k in 0..lib.f_ni[n]:
        if lib.op[i0 + k] == int(Op.Call) && lib.aux[i0 + k] == lib.f_id[n] && lib.blk[i0 + k] >= 0:
            return -1
    return n

/#/ Replaces the call `c` (in block `B`) by the body of function `n`: the block is split at the
/#/ call, the callee's blocks are copied in with their numbers shifted, its entry parameters are
/#/ the call's arguments and each `ret` jumps to the rest of the block, passing the result.
fn inline_call(f: &Fun, lib: &Lib, c: int, n: int) => void:
    let bb = f.blk[c]
    let nargs = f.b[c]
    let args: buf<int> = new_buf(int, nargs + 1)
    for k in 0..nargs:
        args[k] = f.follow(f.val_at(c, k))
    /#/ split: what follows the call goes to a new block
    let after = f.new_block()
    let t = f.nx[c]
    if t >= 0:
        f.pv[t] = -1
        f.bfirst[after] = t
        f.blast[after] = f.blast[bb]
        f.nx[c] = -1
        f.blast[bb] = c
        let i = t
        while i >= 0:
            f.blk[i] = after
            i = f.nx[i]
    for e in 0..f.ne:
        if f.efrom[e] == bb:
            f.efrom[e] = after
    unlink(f, c)
    let res = -1
    if f.rep[c] != int(Rp.Void):
        res = f.param(after, f.rep[c], f.ty[c])
        f.uses[res] = f.uses[c]
        f.fwd[c] = res
    unuse(f, c)
    /#/ copy
    let bi = f.ni
    let bblk = f.nb
    let be = f.ne
    let bp = f.np
    let ni = lib.f_ni[n]
    let nb = lib.f_nb[n]
    let ne = lib.f_ne[n]
    let np = lib.f_np[n]
    f.ensure(bi + ni, bblk + nb, be + ne + nb + 2, bp + np + nb + 2)
    let i0 = lib.f_i0[n]
    for k in 0..ni:
        let d = bi + k
        f.op[d] = lib.op[i0 + k]
        f.rep[d] = lib.rep[i0 + k]
        f.ty[d] = lib.ty[i0 + k]
        f.a[d] = lib.a[i0 + k]
        f.b[d] = lib.b[i0 + k]
        f.c[d] = lib.c[i0 + k]
        f.aux[d] = lib.aux[i0 + k]
        f.nx[d] = shift(lib.nx[i0 + k], bi)
        f.pv[d] = shift(lib.pv[i0 + k], bi)
        f.uses[d] = lib.uses[i0 + k]
        f.ln[d] = f.ln[c]
        f.fwd[d] = shift(lib.fwd[i0 + k], bi)
        f.blk[d] = shift(lib.blk[i0 + k], bblk)
    let b0 = lib.f_b0[n]
    for k in 0..nb:
        f.bfirst[bblk + k] = shift(lib.bfirst[b0 + k], bi)
        f.blast[bblk + k] = shift(lib.blast[b0 + k], bi)
        f.pfirst[bblk + k] = shift(lib.pfirst[b0 + k], bi)
        f.plast[bblk + k] = shift(lib.plast[b0 + k], bi)
        f.npar[bblk + k] = lib.npar[b0 + k]
    let e0 = lib.f_e0[n]
    for k in 0..ne:
        f.efrom[be + k] = shift(lib.efrom[e0 + k], bblk)
        f.eto[be + k] = shift(lib.eto[e0 + k], bblk)
        f.eargs[be + k] = lib.eargs[e0 + k] + bp
        f.eargn[be + k] = lib.eargn[e0 + k]
    let p0 = lib.f_p0[n]
    for k in 0..np:
        f.pool[bp + k] = lib.pool[p0 + k]
    f.set_counts(bi + ni, bblk + nb, be + ne, bp + np)
    /#/ what the copied instructions refer to moves with them
    for k in 0..ni:
        let d = bi + k
        let o = f.op[d]
        if o == int(Op.Call) || o == int(Op.CCall) || o == int(Op.CallI) || o == int(Op.VLoop):
            f.a[d] = f.a[d] + bp
        if o == int(Op.Br):
            f.aux[d] = f.aux[d] + be
        if o == int(Op.CondBr):
            f.b[d] = f.b[d] + be
            f.c[d] = f.c[d] + be
        if o == int(Op.Switch):
            f.c[d] = f.c[d] + be
            f.aux[d] = f.aux[d] + bp
            for q in 0..f.b[d]:
                f.pool[f.aux[d] + q * 2 + 1] = f.pool[f.aux[d] + q * 2 + 1] + be
        if f.blk[d] >= 0 || o == int(Op.Param):
            for q in 0..f.nval(d):
                f.set_val_at(d, q, shift(f.val_at(d, q), bi))
    for e in 0..ne:
        for q in 0..f.eargn[be + e]:
            let at = f.eargs[be + e] + q
            f.pool[at] = shift(f.pool[at], bi)
    /#/ the entry's parameters are the arguments
    let p = f.pfirst[bblk]
    let q = 0
    while p >= 0:
        let x = args[q]
        f.fwd[p] = x
        f.uses[x] = f.uses[x] + f.uses[p]
        p = f.nx[p]
        q = q + 1
    f.pfirst[bblk] = -1
    f.plast[bblk] = -1
    f.npar[bblk] = 0
    f.set_block(bb)
    f.br(bblk)
    /#/ each return jumps to the rest, with the value
    for k in 0..nb:
        let r = f.blast[bblk + k]
        if r >= 0 && f.op[r] == int(Op.Ret):
            f.set_block(bblk + k)
            if f.a[r] >= 0:
                let v = f.follow(f.a[r])
                f.arg(v)
                let e = f.mk_edge(after)
                f.uses[v] = f.uses[v] - 1
                f.a[r] = -1
                f.aux[r] = e
            else:
                f.aux[r] = f.mk_edge(after)
            f.op[r] = int(Op.Br)
            f.rep[r] = int(Rp.Void)
            f.b[r] = -1
            f.c[r] = -1

fn shift(v: int, by: int) => int:
    if v < 0:
        return v
    return v + by

/#/ Inlines the calls of `f` the policy accepts; returns whether it did any.
fn inline_calls(f: &Fun, lib: &Lib, cur: int) => bool:
    let any = false
    let budget = 16
    let again = true
    while again && budget > 0 && f.ni < 3000:
        again = false
        for b in 0..f.nb:
            let i = f.bfirst[b]
            while i >= 0 && !again:
                let n = inlinable(f, lib, i, cur)
                if n >= 0:
                    inline_call(f, lib, i, n)
                    again = true
                    any = true
                    budget = budget - 1
                i = f.nx[i]
            if again:
                break
    return any

/#/ Expands the self-calls of `f` (function `n` of `lib`) by one level: each is replaced by a copy of the
/#/ body as it is now, so half as many calls are made. Only for a small body, and only when the copies
/#/ stay small. Returns whether it did.
fn self_inline(f: &Fun, lib: &Lib, n: int) => bool:
    let id = lib.f_id[n]
    let calls = 0
    let live = 0
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            live = live + 1
            if f.op[i] == int(Op.Call) && f.aux[i] == id && f.fwd[i] < 0:
                calls = calls + 1
            i = f.nx[i]
    if calls == 0 || calls > 2 || live > 40 || live * (calls + 1) > 120:
        return false
    lib.save(f, n, id)
    if lib.f_nb[n] == 0:
        return false
    let did = false
    let again = true
    let left = calls
    while again && left > 0:
        again = false
        for b in 0..f.nb:
            let i = f.bfirst[b]
            while i >= 0 && !again:
                if f.op[i] == int(Op.Call) && f.aux[i] == id && f.fwd[i] < 0 && lib.npar[lib.f_b0[n]] == f.b[i] && lib.f_ret[n] == f.rep[i]:
                    inline_call(f, lib, i, n)
                    again = true
                    did = true
                    left = left - 1
                i = f.nx[i]
            if again:
                break
    return did

/#/ ---- escape analysis -----------------------------------------------------

/#/ Is `x` (an address) the base of a use that cannot let it outlive the function's frame: a load or store
/#/ through it, an address derived from it, a comparison, a call whose callee keeps no pointer in
/#/ parameter `q`? `release` allows the `free` of the root `c` itself and, when `glue` is set, its `drop`
/#/ by a drop glue that only releases it.
fn escape_use_ok(f: &Fun, lib: &Lib, i: int, q: int, x: int, c: int, release: bool) => bool:
    let o = f.op[i]
    if o == int(Op.Load) || o == int(Op.Field) || o == int(Op.Index) || o == int(Op.Store):
        return q == 0
    if o == int(Op.Cmp):
        return true
    if o == int(Op.Free):
        return release && x == c && q == 0
    if o == int(Op.Drop):
        if !release || x != c || q != 0:
            return false
        let n = lib.find(f.aux[i])
        return n >= 0 && lib.f_done[n] == 1 && ((lib.f_nc[n] >> 40) & 1) == 1
    if o == int(Op.Call):
        let n = lib.find(f.aux[i])
        if n < 0 || lib.f_done[n] == 0 || q >= 40:
            return false
        if lib.f_nb[n] == 0 || lib.npar[lib.f_b0[n]] != f.b[i]:
            return false
        return ((lib.f_nc[n] >> q) & 1) == 1
    return false

/#/ `base[x]` is the root a value derives from (`x` itself for a root), -1 for any other value. Sets `bad[c]`
/#/ for the roots with a use that may keep the pointer: an edge argument, a returned or stored pointer,
/#/ a call that may keep it, anything else the list in `escape_use_ok` does not name.
fn escape_scan(f: &Fun, lib: &Lib, base: &buf<int>, bad: &buf<int>, release: bool) => void:
    let grown = true
    while grown:
        grown = false
        for b in 0..f.nb:
            let i = f.bfirst[b]
            while i >= 0:
                if (f.op[i] == int(Op.Field) || f.op[i] == int(Op.Index)) && f.fwd[i] < 0 && base[i] < 0:
                    let r = base[f.follow(f.a[i])]
                    if r >= 0:
                        base[i] = r
                        grown = true
                i = f.nx[i]
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            if !(f.op[i] == int(Op.Alloc) && base[i] == i):
                for q in 0..f.nval(i):
                    let v = f.val_at(i, q)
                    if v >= 0:
                        let x = f.follow(v)
                        let c = base[x]
                        if c >= 0 && !escape_use_ok(f, lib, i, q, x, c, release):
                            bad[c] = 1
            i = f.nx[i]
    for e in 0..f.ne:
        if f.eto[e] >= 0:
            for k in 0..f.eargn[e]:
                let c = base[f.follow(f.pool[f.eargs[e] + k])]
                if c >= 0:
                    bad[c] = 1

/#/ The pointer parameters of `f` it lets escape not at all (bit q set), and bit 40: parameter 0 is
/#/ only released (the shape of a drop glue).
fn param_summary(f: &Fun, lib: &Lib) => int:
    if f.nb == 0:
        return 0
    let nptr = 0
    let pp = f.pfirst[0]
    while pp >= 0:
        if f.rep[pp] == int(Rp.Ptr):
            nptr = nptr + 1
        pp = f.nx[pp]
    if nptr == 0:
        return 0
    let base: buf<int> = new_buf(int, f.ni + 1)
    let bad: buf<int> = new_buf(int, f.ni + 1)
    for k in 0..f.ni:
        base[k] = -1
    let p = f.pfirst[0]
    let q = 0
    let first = -1
    while p >= 0:
        if f.rep[p] == int(Rp.Ptr) && q < 40 && f.fwd[p] < 0:
            base[p] = p
            if q == 0:
                first = p
        p = f.nx[p]
        q = q + 1
    escape_scan(f, lib, &base, &bad, false)
    let m = 0
    let p2 = f.pfirst[0]
    let q2 = 0
    while p2 >= 0:
        if q2 < 40 && base[p2] == p2 && bad[p2] == 0:
            m = m | (1 << q2)
        p2 = f.nx[p2]
        q2 = q2 + 1
    if first >= 0 && bad[first] == 1:
        let base2: buf<int> = new_buf(int, f.ni + 1)
        let bad2: buf<int> = new_buf(int, f.ni + 1)
        for k in 0..f.ni:
            base2[k] = -1
        base2[first] = first
        escape_scan(f, lib, &base2, &bad2, true)
        if bad2[first] == 0:
            m = m | (1 << 40)
    return m

/#/ An `alloc` whose pointer does not escape (see `escape_scan`) lives in the frame: it becomes a `slot` and
/#/ its `free`s go. A `drop` of it by a glue that only releases it is made a call and inlined first, so
/#/ the glue's `free` goes too. Any block of the function may hold the alloc and the release.
fn escape_alloc(f: &Fun, lib: &Lib) => bool:
    let any = false
    let budget = 8
    let again = true
    while again:
        again = false
        let cands = 0
        for b in 0..f.nb:
            let i = f.bfirst[b]
            while i >= 0:
                if f.op[i] == int(Op.Alloc) && f.fwd[i] < 0 && f.ty[i] > 0 && f.ty[i] <= 512:
                    cands = cands + 1
                i = f.nx[i]
        if cands == 0:
            return any
        let base: buf<int> = new_buf(int, f.ni + 1)
        let bad: buf<int> = new_buf(int, f.ni + 1)
        let total = 0
        for k in 0..f.ni:
            base[k] = -1
        for b in 0..f.nb:
            let i = f.bfirst[b]
            while i >= 0:
                if f.op[i] == int(Op.Alloc) && f.fwd[i] < 0 && f.ty[i] > 0 && f.ty[i] <= 512 && total + f.ty[i] <= 4096:
                    base[i] = i
                    total = total + f.ty[i]
                i = f.nx[i]
        escape_scan(f, lib, &base, &bad, true)
        if budget > 0:
            for b in 0..f.nb:
                let i = f.bfirst[b]
                while i >= 0 && !again:
                    if f.op[i] == int(Op.Drop) && f.fwd[i] < 0:
                        let x = f.follow(f.a[i])
                        let n = lib.find(f.aux[i])
                        if base[x] == x && bad[x] == 0 && n >= 0 && live_count(lib, n) <= 80:
                            let start = f.np
                            f.pool_put(x)
                            f.op[i] = int(Op.Call)
                            f.a[i] = start
                            f.b[i] = 1
                            f.c[i] = -1
                            inline_call(f, lib, i, n)
                            budget = budget - 1
                            again = true
                    i = f.nx[i]
        if !again:
            /#/ a drop that could not be inlined keeps its alloc on the heap
            for b in 0..f.nb:
                let i = f.bfirst[b]
                while i >= 0:
                    if f.op[i] == int(Op.Drop) && base[f.follow(f.a[i])] >= 0:
                        bad[base[f.follow(f.a[i])]] = 1
                    i = f.nx[i]
            for c in 0..f.ni:
                if base[c] == c && bad[c] == 0 && f.op[c] == int(Op.Alloc):
                    for b in 0..f.nb:
                        let i = f.bfirst[b]
                        while i >= 0:
                            let nxt = f.nx[i]
                            if f.op[i] == int(Op.Free) && f.follow(f.a[i]) == c:
                                delete_inst(f, i)
                            i = nxt
                    f.op[c] = int(Op.Slot)
                    any = true
    return any

/#/ ---- recursion ---------------------------------------------------------------

/#/ Does the call `c` pass what function `f` takes (as many values, of the same shapes), and return what it returns?
fn tre_call_fits(f: &Fun, c: int) => bool:
    if f.rep[c] != f.ret || f.b[c] != f.npar[0]:
        return false
    let p = f.pfirst[0]
    let k = 0
    while p >= 0:
        if f.rep[f.follow(f.val_at(c, k))] != f.rep[p]:
            return false
        p = f.nx[p]
        k = k + 1
    return true

/#/ Is everything from `c` (exclusive) up to `r` (exclusive) free of effects?
fn tre_pure_between(f: &Fun, c: int, r: int) => bool:
    let x = f.nx[c]
    while x >= 0 && x != r:
        if !pure_op(f.op[x]):
            return false
        x = f.nx[x]
    return x == r

/#/ Is `x` available before `c`: a constant, a parameter of the function, or earlier in the block of `c`?
fn tre_before(f: &Fun, x: int, c: int) => bool:
    if f.is_const(x) || (f.op[x] == int(Op.Param) && f.blk[x] == 0):
        return true
    if f.blk[x] != f.blk[c] || f.op[x] == int(Op.Param):
        return false
    let q = f.pv[c]
    while q >= 0:
        if q == x:
            return true
        q = f.pv[q]
    return false

/#/ A function that returns the result of calling itself, or that result plus something computed before the
/#/ call (`fib(n - 1) + fib(n - 2)` is the first call's value plus the second's), is a loop: the parameters
/#/ become the parameters of a new loop header, and so does an accumulator `acc` that the "something" is added
/#/ to; every other return gives `acc` plus its value. Sums wrap, so the order does not matter.
fn tail_recursion(f: &Fun, self_id: int) => bool:
    if f.nb == 0 || f.ret != int(Rp.I64) || f.ni > 4000:
        return false
    let kind: buf<int> = new_buf(int, f.nb + 1)
    let callv: buf<int> = new_buf(int, f.nb + 1)
    let xv: buf<int> = new_buf(int, f.nb + 1)
    let sites = 0
    let adds = 0
    for b in 0..f.nb:
        let r = f.blast[b]
        if r >= 0 && f.op[r] == int(Op.Ret) && f.a[r] >= 0:
            let v = f.follow(f.a[r])
            if f.op[v] == int(Op.Call) && f.aux[v] == self_id && f.uses[v] == 1 && f.blk[v] == b && tre_call_fits(f, v) && tre_pure_between(f, v, r):
                kind[b] = 1
                callv[b] = v
                sites = sites + 1
            elif f.op[v] == int(Op.Add) && f.rep[v] == int(Rp.I64) && f.uses[v] == 1 && f.blk[v] == b:
                for side in 0..2:
                    if kind[b] == 0:
                        let w = f.follow(f.a[v])
                        let x = f.follow(f.b[v])
                        if side == 1:
                            w = f.follow(f.b[v])
                            x = f.follow(f.a[v])
                        if f.op[w] == int(Op.Call) && f.aux[w] == self_id && f.uses[w] == 1 && f.blk[w] == b && w != x && tre_call_fits(f, w) && tre_before(f, x, w) && tre_pure_between(f, w, r):
                            kind[b] = 2
                            callv[b] = w
                            xv[b] = x
                            sites = sites + 1
                            adds = adds + 1
    if sites == 0:
        return false
    let np = f.npar[0]
    let old: buf<int> = new_buf(int, np + 1)
    let nw: buf<int> = new_buf(int, np + 1)
    let h = f.new_block()
    let p = f.pfirst[0]
    let k = 0
    while p >= 0:
        old[k] = p
        nw[k] = f.param(h, f.rep[p], f.ty[p])
        p = f.nx[p]
        k = k + 1
    let acc = f.param(h, int(Rp.I64), -1)
    /#/ the body moves to the header
    f.bfirst[h] = f.bfirst[0]
    f.blast[h] = f.blast[0]
    f.bfirst[0] = -1
    f.blast[0] = -1
    let i = f.bfirst[h]
    while i >= 0:
        f.blk[i] = h
        i = f.nx[i]
    for e in 0..f.ne:
        if f.efrom[e] == 0:
            f.efrom[e] = h
    kind[h] = kind[0]
    callv[h] = callv[0]
    xv[h] = xv[0]
    kind[0] = 0
    /#/ and uses the header's parameters
    for b in 1..f.nb:
        let j = f.bfirst[b]
        while j >= 0:
            for q in 0..f.nval(j):
                let v = f.val_at(j, q)
                if v >= 0:
                    let x = f.follow(v)
                    for t in 0..np:
                        if x == old[t]:
                            f.set_val_at(j, q, nw[t])
            j = f.nx[j]
    for e in 0..f.ne:
        if f.eto[e] >= 0:
            for q in 0..f.eargn[e]:
                let x = f.follow(f.pool[f.eargs[e] + q])
                for t in 0..np:
                    if x == old[t]:
                        f.pool[f.eargs[e] + q] = nw[t]
    /#/ the entry jumps to the header with the arguments it was given and nothing summed
    f.cur = 0
    for t in 0..np:
        f.arg(old[t])
    f.arg(f.cint(int(Rp.I64), 0))
    f.br(h)
    /#/ the returns
    for b in 1..f.nb:
        let r = f.blast[b]
        if r >= 0 && f.op[r] == int(Op.Ret) && f.a[r] >= 0 && kind[b] == 0 && adds > 0:
            f.cur = b
            let v = f.follow(f.a[r])
            let s = f.raw(int(Op.Add), int(Rp.I64), -1, v, acc, -1, 0)
            link_before(f, s, r)
            f.a[r] = s
    for b in 1..f.nb:
        if kind[b] != 0:
            let r = f.blast[b]
            let c = callv[b]
            let nacc = acc
            f.cur = b
            if kind[b] == 2:
                let xs = xv[b]
                for t in 0..np:
                    if xs == old[t]:
                        xs = nw[t]
                nacc = f.raw(int(Op.Add), int(Rp.I64), -1, xs, acc, -1, 0)
                link_before(f, nacc, r)
            for t in 0..np:
                f.arg(f.val_at(c, t))
            f.arg(nacc)
            let e = f.mk_edge(h)
            let sum = f.follow(f.a[r])
            f.op[r] = int(Op.Br)
            f.rep[r] = int(Rp.Void)
            f.a[r] = -1
            f.b[r] = -1
            f.c[r] = -1
            f.aux[r] = e
            if sum != c:
                delete_inst(f, sum)
            delete_inst(f, c)
    recount_uses(f)
    return true

/#/ Optimizes every function of `lib`, callees first. `f` is the working function.
fn module_opt(lib: &Lib, f: &Fun, rs: &Reps) => void:
    let order = call_order(lib)
    for k in 0..lib.nf:
        let n = order[k]
        lib.restore(n, f)
        inline_calls(f, lib, lib.f_id[n])
        optimize_rs(f, rs, true)
        if dead_calls(f, lib):
            optimize_rs(f, rs, true)
        if tail_recursion(f, lib.f_id[n]):
            optimize_rs(f, rs, true)
        if escape_alloc(f, lib):
            optimize_rs(f, rs, true)
        if self_inline(f, lib, n):
            optimize_rs(f, rs, true)
        let vectorized = 0
        while vectorized < 4 && vectorize(f):
            vectorized = vectorized + 1
        if vectorized > 0:
            optimize_rs(f, rs, true)
        let inverted = 0
        while inverted < 8 && invert_loops(f):
            inverted = inverted + 1
        if inverted > 0:
            optimize_rs(f, rs, true)
        let id = lib.f_id[n]
        lib.save(f, n, id)
        lib.f_fx[n] = summarize(f, lib)
        lib.f_nc[n] = param_summary(f, lib)
        lib.f_done[n] = 1
