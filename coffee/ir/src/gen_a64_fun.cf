/#/ aarch64: one function (prologue, blocks, epilogue), and the object file.
use * in gen
use * in asm
use * in asm_a64
use * in target_a64
use * in gen_x86_regs
use * in gen_x86_call
use * in gen_x86_isel
use * in gen_a64_regs
use * in gen_a64_call
use * in gen_a64_isel
use * in gen_dbg
use * in elf
use * in dbgtype

/#/ Frees the frame and returns.
fn ga_epilogue(g: &Gen) => void:
    a64_load_fp_lr(&g.a)
    a64_addsub_ri(&g.a, false, 31, 31, g.frame)
    a64_ret(&g.a)

/#/ Generates function `f`; returns false if something could not be translated.
fn ga_gen_fun(g: &Gen, f: &Fun, rs: &Reps, sy: &Names) => bool:
    g.err = 0
    g.rbase = 0
    if f.ret >= rp_first_agg():
        g.rbase = 8
    g.a.begin_fun()
    let nm = new_txt()
    for k in 0..len(f.nm):
        nm.put_byte(f.nm[k])
    g.fsym = g.o.sym(&nm)
    if len(g.emit) < f.nb + 1:
        g.ord = new_buf(int, f.nb + 1)
        g.emit = new_buf(int, f.nb + 1)
    block_order(f, &g.emit, true)
    g_count_uses(g, f)
    ga_layout(g, f, rs)
    let start = g.a.pos()
    for b in 0..f.nb:
        g.a.new_label()
    /#/ x29 = sp = the bottom of the frame, where the caller's x29 and x30 are saved
    a64_addsub_ri(&g.a, true, 31, 31, g.frame)
    a64_save_fp_lr(&g.a)
    a64_mov_rr(&g.a, ta_fp(), 31)
    if g.rbase > 0:
        a64_st(&g.a, ta_fp(), 16, ta_sret(), 8)
    /#/ the parameters of the entry block
    let ci = 0
    let cx = 0
    let cs = 0
    let p = f.pfirst[0]
    while p >= 0:
        let r = f.rep[p]
        if r >= rp_first_agg() || g_is_int_class(g, r):
            if ci < ta_nint_args():
                if r >= rp_first_agg():
                    ga_copy_mem(g, ta_fp(), g.voff[p], ta_int_arg(ci), 0, rsize(rs, r))
                else:
                    ga_st(g, p, ta_int_arg(ci))
                ci = ci + 1
            else:
                a64_ld(&g.a, ta_a0(), ta_fp(), g.frame + 8 * cs, 8)
                if r >= rp_first_agg():
                    ga_copy_mem(g, ta_fp(), g.voff[p], ta_a0(), 0, rsize(rs, r))
                else:
                    ga_st(g, p, ta_a0())
                cs = cs + 1
        else:
            if cx < ta_nfloat_args():
                a64_fmov_from(&g.a, 9, cx, r == int(Rp.F32))
                ga_st(g, p, 9)
                cx = cx + 1
            else:
                a64_ld(&g.a, 9, ta_fp(), g.frame + 8 * cs, 8)
                ga_st(g, p, 9)
                cs = cs + 1
        p = f.nx[p]
    g.mk_n = 0
    let last_ln = 0
    for oi in 0..f.nb:
        let b = g.emit[oi]
        g.a.bind(b)
        let i = f.bfirst[b]
        while i >= 0:
            if f.ln[i] > 0 && f.ln[i] != last_ln:
                last_ln = f.ln[i]
                if g.mk_n >= len(g.mk_l):
                    g.mk_l = buf_resize(g.mk_l, (g.mk_n + 1) * 2)
                    g.mk_ln = buf_resize(g.mk_ln, (g.mk_n + 1) * 2)
                let ml = g.a.mark()
                g.mk_l[g.mk_n] = ml
                g.mk_ln[g.mk_n] = last_ln
                g.mk_n = g.mk_n + 1
            let nxt = 0 - 1
            if f.nx[i] < 0 && oi + 1 < f.nb:
                nxt = g.emit[oi + 1]
            ga_gen_inst(g, f, rs, sy, i, nxt)
            i = f.nx[i]
    let ok = a64_end_fun(&g.a)
    let w = new_txt()
    for k in 0..len(f.nm):
        w.put_byte(f.nm[k])
    let sym = g.o.sym(&w)
    g.o.define(sym, start, g.a.pos() - start)
    if ok && g.err == 0 && g.mk_n > 0:
        if g.lf_n >= len(g.lf_sym):
            g.lf_sym = buf_resize(g.lf_sym, (g.lf_n + 1) * 2)
            g.lf_start = buf_resize(g.lf_start, (g.lf_n + 1) * 2)
            g.lf_m0 = buf_resize(g.lf_m0, (g.lf_n + 1) * 2)
        g.lf_sym[g.lf_n] = sym
        g.lf_start[g.lf_n] = start
        g.lf_m0[g.lf_n] = g.lm_n
        g.lf_n = g.lf_n + 1
        for k in 0..g.mk_n:
            if g.lm_n >= len(g.lm_at):
                g.lm_at = buf_resize(g.lm_at, (g.lm_n + 1) * 2)
                g.lm_ln = buf_resize(g.lm_ln, (g.lm_n + 1) * 2)
            g.lm_at[g.lm_n] = g.a.lab[g.mk_l[k]]
            g.lm_ln[g.lm_n] = g.mk_ln[k]
            g.lm_n = g.lm_n + 1
    return ok && g.err == 0

/#/ The object file of aarch64 code: the ELF writer's, with the machine number of aarch64 (183).
fn ga_elf(g: &Gen) => Txt:
    let t = g_elf(g)
    if t.n > 19:
        t.b[18] = 183
        t.b[19] = 0
    return t
