/#/ Test support: source text through our front end, IR and machine code, linked by clang, and run.
use * in lower
use * in fmtrt
use system, fflush, access in libc of c

/#/ Says which node the lowering could not handle: its kind, line, and the text of its token.
fn report_unsupported(a: &Ast, n: int) => void:
    let tk = a.tok[n]
    say(f"unsupported: node kind {a.kind[n]} at line {a.toks.line[tk]}, near '")
    let k = 0
    for i in a.toks.start[tk]..a.toks.end[tk]:
        if k < 40:
            say_byte(a.byte_at(i))
        k = k + 1
    say("'\n")
    fflush(0)

/#/ The machine-code object of `src` through our front end and IR, the optimizer on or off;
/#/ empty when it did not lower.
fn build_src(src: str, opt: int) => Txt:
    return build_obj(src, opt, "")

/#/ Like `build_src`, with the text of the program's own `.cfc` files (empty for none).
fn build_obj(src: str, opt: int, cfc: str) => Txt:
    return build_bytes(bytes_of_str(&src), len(src), opt, cfc)

/#/ Like `build_obj`, for the program text in `text`.
fn build_txt(text: &Txt, opt: int, cfc: str) => Txt:
    return build_bytes(copy_bytes(&text.b, text.n), text.n, opt, cfc)

/#/ The first `size` bytes of `b`, in a buffer of their own.
fn copy_bytes(b: &buf<int>, size: int) => buf<int>:
    let r: buf<int> = new_buf(int, size + 1)
    for q in 0..size:
        r[q] = b[q]
    return r

/#/ Like `build_obj`, for the `size` bytes in `bytes`.
fn build_bytes(bytes: buf<int>, size: int, opt: int, cfc: str) => Txt:
    if prints_numbers(copy_bytes(&bytes, size), size, &cfc):
        let text = fmt_rt_text()
        let rt = bytes_of_str(&text)
        let rn = len(text)
        let both: buf<int> = new_buf(int, size + rn + 2)
        for q in 0..size:
            both[q] = bytes[q]
        both[size] = 10
        for q in 0..rn:
            both[size + 1 + q] = rt[q]
        return build_text(both, size + rn + 1, opt, cfc)
    return build_text(bytes, size, opt, cfc)

fn build_text(bytes: buf<int>, size: int, opt: int, cfc: str) => Txt:
    let t = new_tys()
    let g = new_globals()
    let lw = module_of(bytes, size, opt, cfc, &t, &g)
    if lw.bad > 0:
        return new_txt()
    lw.generate()
    lw.emit_glue(&t, &g)
    if lw.ver_err > 0:
        say(f"verifier: {lw.ver_err} functions with findings\n")
        fflush(0)
        return new_txt()
    if lw.mc_err > 0:
        say(f"machine code: {lw.mc_err} functions could not be translated\n")
        fflush(0)
        return new_txt()
    return lw.object()

/#/ Does an f-string of `src` print an int or a float? Then the program needs the runtime that
/#/ makes their text (`fmt_rt_text`). A program the front end refuses needs nothing: it is not built.
fn prints_numbers(bytes: buf<int>, size: int, cfc: &str) => bool:
    let a = parse_bytes(bytes, size)
    if a.err_count > 0:
        return false
    let any = false
    for n in 0..a.count:
        if a.kind[n] == int(Nk.FStr):
            any = true
        /#/ a program that has the runtime itself (the runtime's own tests) is left as it is
        if a.kind[n] == int(Nk.Fn) && a.pa[n] >= 0 && tok_is(&a, a.pa[n], "__cf_fmt_int"):
            return false
    if !any:
        return false
    let t = new_tys()
    let g = new_globals()
    if len(cfc) > 0:
        declare_user_cfc(&t, &g, cfc + "", "user.cfc")
    let m = declare_module(&g, &a, "t")
    let sc = check(&a, &g, m)
    declare_types(&t, &g, &a, m)
    let ty = check_types(&t, &g, &a, m)
    if sc.diags.errors() > 0 || ty.diags.n > 0:
        return false
    for n in 0..a.count:
        if a.kind[n] == int(Nk.FPart):
            let x = ty.node[a.pa[n]]
            while t.kind[x] == int(Ty.Ref):
                x = t.a[x]
            if t.kind[x] == int(Ty.Int) || t.kind[x] == int(Ty.Float) || a.pd[n] >= 0:
                return true
    return false

/#/ The number of the first parse error: 1 for a character or `//` comment, 3 for a missing
/#/ colon or indent, 110 for `copy`, else 2.
fn parse_number(a: &Ast) => int:
    let t = a.err_tok[0]
    if a.toks.kind[t] == int(Tk.Error) || a.toks.kind[t] == int(Tk.SlashSlash):
        return 1
    for back in 0..3:
        if t - back >= 0 && a.toks.kind[t - back] == int(Tk.KwCopy):
            return 110
    let c = a.err_code[0]
    if c == int(Ec.ExpectedColon) || c == int(Ec.ExpectedIndent):
        return 3
    return 2

/#/ What the front end says about `src`: -1 for nothing, 0 for a parse error, else the number of the
/#/ first scope, type or ownership finding.
fn first_error(src: str) => int:
    let t = new_tys()
    let g = new_globals()
    let a = parse(src)
    if a.err_count > 0:
        return parse_number(&a)
    let m = declare_module(&g, &a, "t")
    let sc = check(&a, &g, m)
    for k in 0..sc.diags.n:
        if !sc_is_warning(sc.diags.code[k]):
            return sc_number(sc.diags.code[k])
    declare_types(&t, &g, &a, m)
    let ty = check_types(&t, &g, &a, m)
    if ty.diags.n > 0:
        return te_number(ty.diags.code[0])
    let fl = check_own(&t, &g, &a, &ty)
    if fl.diags.n > 0:
        return oe_number(fl.diags.code[0])
    return 0 - 1

/#/ A program through the front end: its tree and types, ready to be lowered; `ok` is false when
/#/ the front end refused it (it has said why).
class Prep:
    a: Ast
    ty: Typer
    ok: bool

/#/ Runs the front end over the `size` bytes in `bytes`.
fn prepare(bytes: buf<int>, size: int, cfc: str, t: &Tys, g: &Syms) => Prep:
    return prepare_ast(parse_bytes(bytes, size), cfc, t, g)

/#/ `prepare` for a tree that is already parsed (the caller may have blanked function bodies it
/#/ does not need checked: a function with no body is a declaration).
fn prepare_ast(a: Ast, cfc: str, t: &Tys, g: &Syms) => Prep:
    if len(cfc) > 0:
        declare_user_cfc(t, g, cfc, "user.cfc")
    let m = declare_module(g, &a, "t")
    let sc = check(&a, g, m)
    declare_types(t, g, &a, m)
    let ty = check_types(t, g, &a, m)
    let fl = check_own(t, g, &a, &ty)
    let ok = true
    if sc.diags.errors() > 0 || ty.diags.n > 0 || a.err_count > 0 || fl.diags.n > 0:
        say(f"front end: {sc.diags.errors()} scope errors, {ty.diags.n} type findings, {fl.diags.n} ownership findings, {a.err_count} parse errors\n")
        for k in 0..a.err_count:
            if k < 20:
                say(f"  parse error {a.err_code[k]} at line {a.toks.line[a.err_tok[k]]}\n")
        for k in 0..sc.diags.n:
            if k < 20 && !sc_is_warning(sc.diags.code[k]):
                say(f"  scope error E{sc_number(sc.diags.code[k])} at line {a.toks.line[sc.diags.tok[k]]}\n")
        for k in 0..ty.diags.n:
            if k < 20:
                say(f"  type finding E{te_number(ty.diags.code[k])} at line {a.toks.line[ty.diags.tok[k]]}\n")
        for k in 0..fl.diags.n:
            if k < 20:
                say(f"  ownership finding E{oe_number(fl.diags.code[k])} at line {a.toks.line[fl.diags.tok[k]]}\n")
        fflush(0)
        ok = false
    return Prep { a: a, ty: ty, ok: ok }

/#/ The functions of a prepared program lowered and optimized, not yet generated. With `only` >= 0
/#/ just the top-level items whose `unit[node]` is `only` are lowered (the rest are called by name from
/#/ other objects), and the names the compiler makes end in `tag`.
fn lower_prepared(p: &Prep, t: &Tys, g: &Syms, opt: int, only: int, unit: &buf<int>, tag: &str, ext: &buf<int>) => Lower:
    let lw = new_lower()
    lw.opt = opt
    lw.tag.put(tag)
    let body = new_txt()
    let it = p.a.child[p.a.root]
    while it >= 0:
        /#/ small functions of other files are lowered too (`ext[node]` is 1), for the optimizer to
        /#/ inline; they are not generated here, their own file has them
        let other = only >= 0 && unit[it] != only
        if p.a.kind[it] == int(Nk.Fn) && type_param_count(&p.a, it) == 0:
            if !other || ext[it] == 1:
                lw.ext_mode = other
                lw.function(t, g, &p.ty, &p.a, it, -1)
                if lw.bad > 0:
                    report_unsupported(&p.a, lw.bad_node)
                    return lw
                lw.keep_current()
                lw.ext_mode = false
        elif p.a.kind[it] == int(Nk.Class) && type_param_count(&p.a, it) == 0:
            let row = g.find_in_module(&p.a, p.a.pa[it], p.ty.cur)
            let c = p.a.child[it]
            while c >= 0:
                if p.a.kind[c] == int(Nk.Fn) && (!other || ext[c] == 1):
                    lw.ext_mode = other
                    lw.function(t, g, &p.ty, &p.a, c, row)
                    if lw.bad > 0:
                        report_unsupported(&p.a, lw.bad_node)
                        return lw
                    lw.keep_current()
                    lw.ext_mode = false
                c = p.a.next[c]
        it = p.a.next[it]
    lw.run_instances(t, g, &p.ty, &p.a, &body)
    if lw.bad > 0:
        report_unsupported(&p.a, lw.bad_node)
        return lw
    lw.optimize_module()
    return lw

/#/ The module of `src` lowered and optimized, not yet generated; `bad` is set when the front
/#/ end or the lowering refused it.
fn module_of(bytes: buf<int>, size: int, opt: int, cfc: str, t: &Tys, g: &Syms) => Lower:
    let p = prepare(bytes, size, cfc, t, g)
    if !p.ok:
        let lw = new_lower()
        lw.bad = 1
        return lw
    let none: buf<int> = new_buf(int, 1)
    let lw = lower_prepared(&p, t, g, opt, -1, &none, "", &none)
    let has_main = false
    let it = p.a.child[p.a.root]
    while it >= 0:
        if p.a.kind[it] == int(Nk.Fn) && p.a.pa[it] >= 0 && tok_is(&p.a, p.a.pa[it], "main"):
            has_main = true
        it = p.a.next[it]
    if lw.bad == 0 && !has_main:
        lw.declare_globals(t, g, &p.ty, &p.a)
    return lw

/#/ Compiles `src` through our front end and IR, with clang as the linker, and runs it: the exit
/#/ code, or -2 when something did not compile.
fn run_src(src: str, leaks: bool) => int:
    let o = build_src(src, 1)
    if o.n == 0:
        return -2
    return run_object(&o, leaks)

/#/ The number of instructions in the function `name` of the module of `src`.
fn lowered_lines(src: str, opt: int, name: str) => int:
    let t = new_tys()
    let g = new_globals()
    let lw = module_of(bytes_of_str(&src), len(src), opt, "", &t, &g)
    let w = new_txt()
    w.put(&name)
    let k = lw.lib.find(lw.names.find(&w))
    if k < 0:
        return -1
    let f = new_fun("", 0)
    lw.lib.restore(k, &f)
    let n = 0
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            n = n + 1
            i = f.nx[i]
    return n

/#/ The calls to the function `name` in the module of `src`, in all its functions.
fn calls_of(src: str, opt: int, name: str) => int:
    let t = new_tys()
    let g = new_globals()
    let lw = module_of(bytes_of_str(&src), len(src), opt, "", &t, &g)
    let w = new_txt()
    w.put(&name)
    let id = lw.names.find(&w)
    let f = new_fun("", 0)
    let n = 0
    for k in 0..lw.lib.nf:
        lw.lib.restore(k, &f)
        for b in 0..f.nb:
            let i = f.bfirst[b]
            while i >= 0:
                if f.op[i] == int(Op.Call) && f.aux[i] == id:
                    n = n + 1
                i = f.nx[i]
    return n

/#/ The effect summary of the function `name` in the module of `src`, -1 when it is not there.
fn effects_of(src: str, opt: int, name: str) => int:
    let t = new_tys()
    let g = new_globals()
    let lw = module_of(bytes_of_str(&src), len(src), opt, "", &t, &g)
    let w = new_txt()
    w.put(&name)
    let k = lw.lib.find(lw.names.find(&w))
    if k < 0:
        return -1
    return lw.lib.f_fx[k]

/#/ An object file, linked by clang with the address sanitizer, run.
fn run_object(o: &Txt, leaks: bool) => int:
    save_bytes("ir_lower_test.o", o)
    if system("clang -w -fsanitize=address -o ./ir_lower_test ir_lower_test.o -lm") != 0:
        return -1
    let cmd = "ASAN_OPTIONS=exitcode=99:detect_leaks=1 ./ir_lower_test 2>ir_lower_err"
    if !leaks:
        cmd = "ASAN_OPTIONS=exitcode=99:detect_leaks=0 ./ir_lower_test 2>ir_lower_err"
    let st = system(cmd)
    return (st >> 8) & 255

fn expect_exit(src: str, want: int) => int:
    return expect_with(src, want, true)

/#/ Like `expect_exit` for programs that stop early (a failed bounds check) and so leave
/#/ their memory behind.
fn expect_exit_early(src: str, want: int) => int:
    return expect_with(src, want, false)

fn expect_with(src: str, want: int, leaks: bool) => int:
    let dup = clone src
    let r = run_src(src, leaks)
    if r != want:
        say(f"FAIL: got {r}, want {want}\n{dup}\n")
        fflush(0)
        return 1
    return 0

/#/ Like `expect_exit`.
fn expect_mc(src: str, want: int) => int:
    return expect_mc_with(src, want, true)

/#/ Like `expect_exit_early`.
fn expect_mc_early(src: str, want: int) => int:
    return expect_mc_with(src, want, false)

fn expect_mc_with(src: str, want: int, leaks: bool) => int:
    let dup = clone src
    let o = build_src(src, 1)
    if o.n == 0:
        say(f"FAIL: no object for\n{dup}\n")
        fflush(0)
        return 1
    let r = run_object(&o, leaks)
    if r != want:
        say(f"FAIL (machine code): got {r}, want {want}\n{dup}\n")
        fflush(0)
        return 1
    return 0
