/#/ Test support: source text through our front end, IR and clang, and run.
use * in lower
use fopen, fputc, fclose, system, putchar, printf, fflush, access in libc of c

/#/ Says which node the lowering could not handle: its kind, line, and the text of its token.
fn report_unsupported(a: &Ast, n: int) => void:
    let tk = a.tok[n]
    printf("unsupported: node kind %d at line %d, near '", a.kind[n], a.toks.line[tk])
    let k = 0
    for i in a.toks.start[tk]..a.toks.end[tk]:
        if k < 40:
            putchar(a.byte_at(i))
        k = k + 1
    printf("'\n")
    fflush(0)

/#/ `src` through our front end and IR as LLVM text, the optimizer on or off; empty when it
/#/ did not lower.
fn build_src(src: str, opt: int) => Txt:
    return build_with_cfc(src, opt, "")

/#/ Like `build_src`, with the text of the program's own `.cfc` files (empty for none).
fn build_with_cfc(src: str, opt: int, cfc: str) => Txt:
    return build_gen(src, opt, cfc, 0)

/#/ Like `build_with_cfc`, but the machine-code backend: the bytes of an ELF object file.
fn build_obj(src: str, opt: int, cfc: str) => Txt:
    return build_gen(src, opt, cfc, 1)

fn build_gen(src: str, opt: int, cfc: str, backend: int) => Txt:
    let t = new_tys()
    let g = new_globals()
    if len(cfc) > 0:
        declare_user_cfc(&t, &g, cfc, "user.cfc")
    let a = parse(src)
    let m = declare_module(&g, &a, "t")
    declare_types(&t, &g, &a, m)
    let ty = check_types(&t, &g, &a, m)
    if ty.diags.n > 0 || a.err_count > 0:
        printf("front end: %d type findings, %d parse errors\n", ty.diags.n, a.err_count)
        for k in 0..a.err_count:
            if k < 20:
                printf("  parse error %d at line %d\n", a.err_code[k], a.toks.line[a.err_tok[k]])
        for k in 0..ty.diags.n:
            if k < 20:
                printf("  type finding E%d at line %d\n", te_number(ty.diags.code[k]), a.toks.line[ty.diags.tok[k]])
        fflush(0)
        return new_txt()
    let lw = new_lower()
    lw.opt = opt
    lw.backend = backend
    let o = new_txt()
    emit_prelude(&o)
    let body = new_txt()
    let it = a.child[a.root]
    while it >= 0:
        if a.kind[it] == int(Nk.Fn) && type_param_count(&a, it) == 0:
            lw.function(&t, &g, &ty, &a, it, -1)
            if lw.bad > 0:
                report_unsupported(&a, lw.bad_node)
                return new_txt()
            lw.keep_current()
        elif a.kind[it] == int(Nk.Class) && type_param_count(&a, it) == 0:
            let row = g.find_in_module(&a, a.pa[it], ty.cur)
            let c = a.child[it]
            while c >= 0:
                if a.kind[c] == int(Nk.Fn):
                    lw.function(&t, &g, &ty, &a, c, row)
                    if lw.bad > 0:
                        report_unsupported(&a, lw.bad_node)
                        return new_txt()
                    lw.keep_current()
                c = a.next[c]
        it = a.next[it]
    lw.run_instances(&t, &g, &ty, &a, &body)
    if lw.bad > 0:
        report_unsupported(&a, lw.bad_node)
        return new_txt()
    lw.finish(&body)
    if backend == 1:
        lw.emit_glue(&body, &t, &g)
        if lw.mc_err > 0:
            printf("machine code: %d functions could not be translated\n", lw.mc_err)
            return new_txt()
        return lw.object()
    o.put_all(&lw.globals)
    lw.emit_decls(&o, &t, &g)
    lw.emit_glue(&body, &t, &g)
    o.put_all(&body)
    return o

/#/ Compiles `src` through our front end and IR, with clang, and runs it: the exit code,
/#/ or -2 when something did not compile.
fn run_src(src: str, leaks: bool) => int:
    /#/ with the file /tmp/coffee_use_obj present the programs go through the machine-code backend
    let backend = 0
    if access("/tmp/coffee_use_obj", 0) == 0:
        backend = 1
    let o = build_gen(src, 1, "", backend)
    if o.n == 0:
        return -2
    if backend == 1:
        return run_object(&o, leaks)
    return compile_and_run(&o, leaks)

/#/ The number of lines of the LLVM text of `src`.
fn lowered_lines(src: str, opt: int) => int:
    let o = build_src(src, opt)
    let n = 0
    for i in 0..o.n:
        if o.b[i] == 10:
            n = n + 1
    return n

/#/ Did the verifier mark a function in the text?
fn has_verifier_mark(m: &Txt) => bool:
    let w = "; verifier"
    for i in 0..m.n:
        let k = 0
        while k < len(w) && i + k < m.n && m.b[i + k] == int(w[k]):
            k = k + 1
        if k == len(w):
            return true
    return false

/#/ An object file, linked by clang, run.
fn run_object(o: &Txt, leaks: bool) => int:
    let fp = fopen("/tmp/ir_lower_test.o", "w")
    for k in 0..o.n:
        fputc(o.b[k], fp)
    fclose(fp)
    if system("clang -w -fsanitize=address -o /tmp/ir_lower_test /tmp/ir_lower_test.o -lm") != 0:
        return -1
    let cmd = "ASAN_OPTIONS=exitcode=99:detect_leaks=1 /tmp/ir_lower_test 2>/tmp/ir_lower_err"
    if !leaks:
        cmd = "ASAN_OPTIONS=exitcode=99:detect_leaks=0 /tmp/ir_lower_test 2>/tmp/ir_lower_err"
    let st = system(cmd)
    return (st >> 8) & 255

fn compile_and_run(m: &Txt, leaks: bool) => int:
    if has_verifier_mark(m):
        printf("the verifier found a problem\n")
        return -4
    let fp = fopen("/tmp/ir_lower_test.ll", "w")
    for k in 0..m.n:
        fputc(m.b[k], fp)
    fclose(fp)
    if system("clang -w -fsanitize=address -o /tmp/ir_lower_test /tmp/ir_lower_test.ll") != 0:
        return -1
    let cmd = "ASAN_OPTIONS=exitcode=99:detect_leaks=1 /tmp/ir_lower_test 2>/tmp/ir_lower_err"
    if !leaks:
        cmd = "ASAN_OPTIONS=exitcode=99:detect_leaks=0 /tmp/ir_lower_test 2>/tmp/ir_lower_err"
    let st = system(cmd)
    return (st >> 8) & 255

fn expect_exit(src: str, want: int) => int:
    return expect_with(src, want, true)

/#/ Like `expect_exit` for programs that stop early (a failed bounds check) and so leave
/#/ their memory behind.
fn expect_exit_early(src: str, want: int) => int:
    return expect_with(src, want, false)

fn expect_with(src: str, want: int, leaks: bool) => int:
    let dup = clone src
    let r = run_src(src, leaks)
    if r != want:
        printf("FAIL: got %d, want %d\n%s\n", r, want, dup)
        fflush(0)
        return 1
    return 0

/#/ Like `expect_exit`, through the machine-code backend whatever the flag file says.
fn expect_mc(src: str, want: int) => int:
    let dup = clone src
    let o = build_gen(src, 1, "", 1)
    if o.n == 0:
        printf("FAIL: no object for\n%s\n", dup)
        fflush(0)
        return 1
    let r = run_object(&o, true)
    if r != want:
        printf("FAIL (machine code): got %d, want %d\n%s\n", r, want, dup)
        fflush(0)
        return 1
    return 0
