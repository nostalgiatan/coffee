/#/ Test support: source text through our front end, IR and machine code, linked by clang, and run.
use * in lower
use fopen, fputc, fclose, system, putchar, printf, fflush, access in libc of c

/#/ Says which node the lowering could not handle: its kind, line, and the text of its token.
fn report_unsupported(a: &Ast, n: int) => void:
    let tk = a.tok[n]
    printf("unsupported: node kind %d at line %d, near '", a.kind[n], a.toks.line[tk])
    let k = 0
    for i in a.toks.start[tk]..a.toks.end[tk]:
        if k < 40:
            putchar(a.byte_at(i))
        k = k + 1
    printf("'\n")
    fflush(0)

/#/ The machine-code object of `src` through our front end and IR, the optimizer on or off;
/#/ empty when it did not lower.
fn build_src(src: str, opt: int) => Txt:
    return build_obj(src, opt, "")

/#/ Like `build_src`, with the text of the program's own `.cfc` files (empty for none).
fn build_obj(src: str, opt: int, cfc: str) => Txt:
    let t = new_tys()
    let g = new_globals()
    let lw = module_of(src, opt, cfc, &t, &g)
    if lw.bad > 0:
        return new_txt()
    lw.generate()
    lw.emit_glue(&t, &g)
    if lw.ver_err > 0:
        printf("verifier: %d functions with findings\n", lw.ver_err)
        return new_txt()
    if lw.mc_err > 0:
        printf("machine code: %d functions could not be translated\n", lw.mc_err)
        return new_txt()
    return lw.object()

/#/ What the front end says about `src`: -1 for nothing, 0 for a parse error, else the number of the
/#/ first scope, type or ownership finding.
fn first_error(src: str) => int:
    let t = new_tys()
    let g = new_globals()
    let a = parse(src)
    if a.err_count > 0:
        return 0
    let m = declare_module(&g, &a, "t")
    let sc = check(&a, &g, m)
    for k in 0..sc.diags.n:
        if !sc_is_warning(sc.diags.code[k]):
            return sc_number(sc.diags.code[k])
    declare_types(&t, &g, &a, m)
    let ty = check_types(&t, &g, &a, m)
    if ty.diags.n > 0:
        return te_number(ty.diags.code[0])
    let fl = check_own(&t, &g, &a, &ty)
    if fl.diags.n > 0:
        return oe_number(fl.diags.code[0])
    return 0 - 1

/#/ The module of `src` lowered and optimized, not yet generated; `bad` is set when the front
/#/ end or the lowering refused it.
fn module_of(src: str, opt: int, cfc: str, t: &Tys, g: &Syms) => Lower:
    let lw = new_lower()
    lw.opt = opt
    if len(cfc) > 0:
        declare_user_cfc(t, g, cfc, "user.cfc")
    let a = parse(src)
    let m = declare_module(g, &a, "t")
    let sc = check(&a, g, m)
    declare_types(t, g, &a, m)
    let ty = check_types(t, g, &a, m)
    let fl = check_own(t, g, &a, &ty)
    if sc.diags.errors() > 0 || ty.diags.n > 0 || a.err_count > 0 || fl.diags.n > 0:
        printf("front end: %d scope errors, %d type findings, %d ownership findings, %d parse errors\n", sc.diags.errors(), ty.diags.n, fl.diags.n, a.err_count)
        for k in 0..a.err_count:
            if k < 20:
                printf("  parse error %d at line %d\n", a.err_code[k], a.toks.line[a.err_tok[k]])
        for k in 0..sc.diags.n:
            if k < 20 && !sc_is_warning(sc.diags.code[k]):
                printf("  scope error E%d at line %d\n", sc_number(sc.diags.code[k]), a.toks.line[sc.diags.tok[k]])
        for k in 0..ty.diags.n:
            if k < 20:
                printf("  type finding E%d at line %d\n", te_number(ty.diags.code[k]), a.toks.line[ty.diags.tok[k]])
        for k in 0..fl.diags.n:
            if k < 20:
                printf("  ownership finding E%d at line %d\n", oe_number(fl.diags.code[k]), a.toks.line[fl.diags.tok[k]])
        fflush(0)
        lw.bad = 1
        return lw
    let body = new_txt()
    let it = a.child[a.root]
    while it >= 0:
        if a.kind[it] == int(Nk.Fn) && type_param_count(&a, it) == 0:
            lw.function(t, g, &ty, &a, it, -1)
            if lw.bad > 0:
                report_unsupported(&a, lw.bad_node)
                return lw
            lw.keep_current()
        elif a.kind[it] == int(Nk.Class) && type_param_count(&a, it) == 0:
            let row = g.find_in_module(&a, a.pa[it], ty.cur)
            let c = a.child[it]
            while c >= 0:
                if a.kind[c] == int(Nk.Fn):
                    lw.function(t, g, &ty, &a, c, row)
                    if lw.bad > 0:
                        report_unsupported(&a, lw.bad_node)
                        return lw
                    lw.keep_current()
                c = a.next[c]
        it = a.next[it]
    lw.run_instances(t, g, &ty, &a, &body)
    if lw.bad > 0:
        report_unsupported(&a, lw.bad_node)
        return lw
    lw.optimize_module()
    return lw

/#/ Compiles `src` through our front end and IR, with clang as the linker, and runs it: the exit
/#/ code, or -2 when something did not compile.
fn run_src(src: str, leaks: bool) => int:
    let o = build_src(src, 1)
    if o.n == 0:
        return -2
    return run_object(&o, leaks)

/#/ The number of instructions in the function `name` of the module of `src`.
fn lowered_lines(src: str, opt: int, name: str) => int:
    let t = new_tys()
    let g = new_globals()
    let lw = module_of(src, opt, "", &t, &g)
    let w = new_txt()
    w.put(&name)
    let k = lw.lib.find(lw.names.find(&w))
    if k < 0:
        return -1
    let f = new_fun("", 0)
    lw.lib.restore(k, &f)
    let n = 0
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            n = n + 1
            i = f.nx[i]
    return n

/#/ The calls to the function `name` in the module of `src`, in all its functions.
fn calls_of(src: str, opt: int, name: str) => int:
    let t = new_tys()
    let g = new_globals()
    let lw = module_of(src, opt, "", &t, &g)
    let w = new_txt()
    w.put(&name)
    let id = lw.names.find(&w)
    let f = new_fun("", 0)
    let n = 0
    for k in 0..lw.lib.nf:
        lw.lib.restore(k, &f)
        for b in 0..f.nb:
            let i = f.bfirst[b]
            while i >= 0:
                if f.op[i] == int(Op.Call) && f.aux[i] == id:
                    n = n + 1
                i = f.nx[i]
    return n

/#/ The effect summary of the function `name` in the module of `src`, -1 when it is not there.
fn effects_of(src: str, opt: int, name: str) => int:
    let t = new_tys()
    let g = new_globals()
    let lw = module_of(src, opt, "", &t, &g)
    let w = new_txt()
    w.put(&name)
    let k = lw.lib.find(lw.names.find(&w))
    if k < 0:
        return -1
    return lw.lib.f_fx[k]

/#/ An object file, linked by clang with the address sanitizer, run.
fn run_object(o: &Txt, leaks: bool) => int:
    let fp = fopen("ir_lower_test.o", "w")
    for k in 0..o.n:
        fputc(o.b[k], fp)
    fclose(fp)
    if system("clang -w -fsanitize=address -o ./ir_lower_test ir_lower_test.o -lm") != 0:
        return -1
    let cmd = "ASAN_OPTIONS=exitcode=99:detect_leaks=1 ./ir_lower_test 2>ir_lower_err"
    if !leaks:
        cmd = "ASAN_OPTIONS=exitcode=99:detect_leaks=0 ./ir_lower_test 2>ir_lower_err"
    let st = system(cmd)
    return (st >> 8) & 255

fn expect_exit(src: str, want: int) => int:
    return expect_with(src, want, true)

/#/ Like `expect_exit` for programs that stop early (a failed bounds check) and so leave
/#/ their memory behind.
fn expect_exit_early(src: str, want: int) => int:
    return expect_with(src, want, false)

fn expect_with(src: str, want: int, leaks: bool) => int:
    let dup = clone src
    let r = run_src(src, leaks)
    if r != want:
        printf("FAIL: got %d, want %d\n%s\n", r, want, dup)
        fflush(0)
        return 1
    return 0

/#/ Like `expect_exit`.
fn expect_mc(src: str, want: int) => int:
    let dup = clone src
    let o = build_src(src, 1)
    if o.n == 0:
        printf("FAIL: no object for\n%s\n", dup)
        fflush(0)
        return 1
    let r = run_object(&o, true)
    if r != want:
        printf("FAIL (machine code): got %d, want %d\n%s\n", r, want, dup)
        fflush(0)
        return 1
    return 0
