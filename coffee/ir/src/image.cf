/#/ The flat image: what the generator made, laid out as it will sit in memory and with every
/#/ relocation applied, for a loader that has no linker. Code, `.rodata`, `.data` and one stub per
/#/ external function follow each other in one block, so every reference is a 32-bit distance
/#/ from the place that makes it and the image works at any address. Each stub is a jump
/#/ through an 8-byte slot, which the loader fills in with the address of the function.
use * in lower

class Image:
    b: Txt
    text_n: int
    ro_at: int
    data_at: int
    stub_at: int
    /#/ where the code and the stubs end (a page boundary), where the rodata ends, where the slots of the stubs are, the size of the image
    rx_end: int
    ro_end: int
    slot_at: int
    total: int
    /#/ the names, and the symbols defined in the image: name offset, place in the image
    names: Txt
    sym_name: buf<int>
    sym_at: buf<int>
    nsym: int
    /#/ the external functions: name offset, the offset of the slot to fill
    imp_name: buf<int>
    imp_slot: buf<int>
    nimp: int
    /#/ 0 when the image is whole, else a relocation that could not be applied
    err: int
    /#/ sandbox image: `b` is the code alone and `lin` the start of the linear memory, from `lin_at`
    /#/ (rodata, then data); the guard, the shadow stack and the heap follow, up to `limit`
    lin: Txt
    lin_at: int
    data_lin: int
    ss_base: int
    ss_top: int
    limit: int
    /#/ sandbox image: where the host's exit stub goes (the loader writes it), at the end of the code
    exit_at: int
    hc_at: int
    /#/ where `cf_syscall` starts in a sandbox image (-1 when it has none)
    sys_at: int

    /#/ The place in the image of the symbol spelled `w`, -1 when it is not defined.
    fn find(self, w: &Txt) => int:
        for k in 0..self.nsym:
            let at = self.sym_name[k]
            let q = 0
            while q < w.n && self.names.b[at + q] == w.b[q]:
                q = q + 1
            if q == w.n && self.names.b[at + w.n] == 0:
                return self.sym_at[k]
        return -1

    /#/ The index of the external function spelled `w`, -1 when the image does not call it.
    fn import_of(self, w: &Txt) => int:
        for k in 0..self.nimp:
            let at = self.imp_name[k]
            let q = 0
            while q < w.n && self.names.b[at + q] == w.b[q]:
                q = q + 1
            if q == w.n && self.names.b[at + w.n] == 0:
                return k
        return -1

/#/ Does the name that starts at `at` in `names` spell `w`?
fn name_is(names: &Txt, at: int, w: &str) => bool:
    for q in 0..len(w):
        if names.b[at + q] != ch(w, q):
            return false
    return names.b[at + len(w)] == 0

fn image_round(v: int, a: int) => int:
    return (v + a - 1) // a * a

/#/ The image of the code in `a` and the objects of `o`.
fn make_image(o: &Obj, a: &Asm) => Image:
    let im = Image { b: new_txt(), text_n: a.c.n, ro_at: 0, data_at: 0, stub_at: 0, rx_end: 0, ro_end: 0, slot_at: 0, total: 0, names: new_txt(), sym_name: new_buf(int, o.ns + 1), sym_at: new_buf(int, o.ns + 1), nsym: 0, imp_name: new_buf(int, o.ns + 1), imp_slot: new_buf(int, o.ns + 1), nimp: 0, err: 0, lin: new_txt(), lin_at: 0, data_lin: 0, ss_base: 0, ss_top: 0, limit: 0, exit_at: 0, hc_at: 0, sys_at: -1 }
    im.names.put_all(&o.names)
    /#/ the layout, every part on pages of its own so that the loader can give each its rights: the code,
    /#/ the stubs of the external functions and `cf_syscall` (read, execute); the rodata (read); the
    /#/ data and the slots the stubs jump through (read, write)
    let sys_sym = -1
    let nimp = 0
    for k in 0..o.ns:
        if o.s_def[k] < 0 && name_is(&o.names, o.s_name[k], "cf_syscall"):
            sys_sym = k
        elif o.s_def[k] < 0:
            nimp = nimp + 1
    im.stub_at = image_round(a.c.n, 16)
    /#/ x86: `jmp [rip+disp]` and two bytes of padding; aarch64: adrp, ldr, br and a nop
    let ssz = 8
    if target_arch == arch_aarch64():
        ssz = 16
    let sysn = len(tg_syscall_stub())
    let stubs_end = im.stub_at + ssz * nimp
    let sys_at = image_round(stubs_end, 16)
    let code_end = stubs_end
    if sys_sym >= 0:
        code_end = sys_at + sysn
    im.rx_end = image_round(code_end, 4096)
    im.ro_at = im.rx_end
    im.ro_end = im.ro_at + image_round(o.ro.n, 4096)
    im.data_at = im.ro_end
    im.slot_at = image_round(im.data_at + o.data.n, 8)
    im.total = im.slot_at + 8 * nimp
    let stub_of: buf<int> = new_buf(int, o.ns + 1)
    for k in 0..o.ns:
        stub_of[k] = -1
        if o.s_def[k] < 0 && k == sys_sym:
            stub_of[k] = sys_at
        elif o.s_def[k] < 0:
            stub_of[k] = im.stub_at + ssz * im.nimp
            im.imp_name[im.nimp] = o.s_name[k]
            im.imp_slot[im.nimp] = im.slot_at + 8 * im.nimp
            im.nimp = im.nimp + 1
        elif o.s_sec[k] == 8:
            im.sym_name[im.nsym] = o.s_name[k]
            im.sym_at[im.nsym] = im.data_at + o.s_def[k]
            im.nsym = im.nsym + 1
        else:
            im.sym_name[im.nsym] = o.s_name[k]
            im.sym_at[im.nsym] = o.s_def[k]
            im.nsym = im.nsym + 1
    im.b.put_all(&a.c)
    while im.b.n < im.stub_at:
        im.b.put_byte(0)
    for k in 0..im.nimp:
        let at = im.stub_at + ssz * k
        if target_arch == arch_aarch64():
            /#/ adrp x16,slot; ldr x16,[x16,#lo12]; br x16; nop
            let slot = im.imp_slot[k]
            let pg = (slot >> 12) - (at >> 12)
            w32(&im.b, 2415919120 | ((pg & 3) << 29) | (((pg >> 2) & 524287) << 5))
            w32(&im.b, 4181721088 | (((slot & 4095) // 8) << 10) | (16 << 5) | 16)
            w32(&im.b, 3592356352)
            w32(&im.b, 3573751839)
        else:
            /#/ jmp [rip+disp] to the slot, two bytes of padding
            im.b.put_byte(255)
            im.b.put_byte(37)
            w32(&im.b, im.imp_slot[k] - (at + 6))
            im.b.put_byte(204)
            im.b.put_byte(204)
    if sys_sym >= 0:
        while im.b.n < sys_at:
            im.b.put_byte(0)
        let code = tg_syscall_stub()
        for q in 0..sysn:
            im.b.put_byte(code[q])
    while im.b.n < im.ro_at:
        im.b.put_byte(0)
    im.b.put_all(&o.ro)
    while im.b.n < im.data_at:
        im.b.put_byte(0)
    im.b.put_all(&o.data)
    while im.b.n < im.total:
        im.b.put_byte(0)
    for r in 0..a.nrl:
        let at = a.rl_at[r]
        let sym = a.rl_sym[r]
        let target = 0 - 1
        if sym == 1:
            target = im.ro_at
        elif sym >= 2 && sym - 2 < o.ns:
            let sk = sym - 2
            if o.s_def[sk] < 0:
                target = stub_of[sk]
            elif o.s_sec[sk] == 8:
                target = im.data_at + o.s_def[sk]
            else:
                target = o.s_def[sk]
        if target < 0 || at < 0 || at + 4 > a.c.n:
            im.err = 1
            return im
        let d = target + a.rl_add[r] - at
        if target_arch == arch_aarch64():
            if !apply_a64(&im.b, at, a.rl_ty[r], target + a.rl_add[r]):
                im.err = 1
                return im
            continue
        for q in 0..4:
            im.b.b[at + q] = (d >> (8 * q)) & 255
    return im

/#/ The instruction at `at` with the relocation `ty` for the address `to` (offsets in the image, whose
/#/ base is page aligned) applied; false for a kind that is not known.
fn apply_a64(b: &Txt, at: int, ty: int, to: int) => bool:
    let w = b.b[at] | (b.b[at + 1] << 8) | (b.b[at + 2] << 16) | (b.b[at + 3] << 24)
    if ty == 283 || ty == 282:
        w = w | (((to - at) >> 2) & 67108863)
    elif ty == 275:
        let pg = (to >> 12) - (at >> 12)
        w = w | ((pg & 3) << 29) | (((pg >> 2) & 524287) << 5)
    elif ty == 277:
        w = w | ((to & 4095) << 10)
    else:
        return false
    for q in 0..4:
        b.b[at + q] = (w >> (8 * q)) & 255
    return true

/#/ The image of the module in `lw`, once its functions are generated. Like `object`, it adds the
/#/ strings and globals to the generator, so only one of the two can be asked for.
fn image_of(lw: &Lower) => Image:
    g_add_rodata(&lw.mc, &lw.sbytes)
    for k in 0..lw.gl_n:
        let w = new_txt()
        lw.names.put(&w, lw.gl_name[k])
        g_add_global(&lw.mc, &w, lw.gl_size[k])
    return make_image(&lw.mc.o, &lw.mc.a)

/#/ ---- sandbox ----------------------------------------------------------------

/#/ The linear memory of sandbox code: 64 KB nobody may touch (so a null pointer traps), rodata, data,
/#/ a guard, the shadow stack, then the heap.
fn sbx_lin_at() => int:
    return 65536

fn sbx_guard() => int:
    return 65536

fn sbx_stack_size() => int:
    return 1048576

fn sbx_heap_size() => int:
    return 67108864

/#/ The first 16 bytes of the linear memory from `sbx_lin_at`: the next free byte of the heap and the end of it.
fn sbx_header() => int:
    return 16

/#/ The size of an import entry (and of the stubs of `read` and `write`) of sandbox code: the code that jumps through the
/#/ slot in its second half, which the loader fills. 16 bytes, 32 on riscv64 (the jump takes three words).
fn sbx_entry_stride() => int:
    if target_arch == arch_riscv64():
        return 32
    return 16

/#/ The bytes ff 25 02 00 00 00 of `jmp [rip+2]`.
fn host_entry_x86(q: int) => int:
    if q == 0:
        return 255
    if q == 1:
        return 37
    if q == 2:
        return 2
    return 0

/#/ The image of sandbox code (generated with `Asm.sbx` set): the code, and the linear memory it
/#/ starts with. References to rodata and data are numbers in the linear memory (absolute 32-bit
/#/ relocations); calls are relative. A call of anything not in the module, and the address of a
/#/ function, are refused (`err` 2 and 3): there is nothing for them to go through yet.
fn make_image_sbx(o: &Obj, a: &Asm) => Image:
    let im = Image { b: new_txt(), text_n: a.c.n, ro_at: 0, data_at: 0, stub_at: 0, rx_end: 0, ro_end: 0, slot_at: 0, total: 0, names: new_txt(), sym_name: new_buf(int, o.ns + 1), sym_at: new_buf(int, o.ns + 1), nsym: 0, imp_name: new_buf(int, o.ns + 1), imp_slot: new_buf(int, o.ns + 1), nimp: 0, err: 0, lin: new_txt(), lin_at: sbx_lin_at(), data_lin: 0, ss_base: 0, ss_top: 0, limit: 0, exit_at: 0, hc_at: 0, sys_at: -1 }
    im.names.put_all(&o.names)
    let ro_lin = sbx_lin_at() + sbx_header()
    im.data_lin = image_round(ro_lin + o.ro.n, 16)
    let end_lin = im.data_lin + o.data.n
    im.ss_base = image_round(end_lin, 4096) + sbx_guard()
    im.ss_top = im.ss_base + sbx_stack_size()
    im.limit = im.ss_top + sbx_heap_size()
    /#/ `cf_syscall` is code of the image: `exit` goes to the host, every other call fails
    let sys_sym = -1
    for k in 0..o.ns:
        if o.s_def[k] < 0 && name_is(&o.names, o.s_name[k], "cf_syscall"):
            sys_sym = k
        elif o.s_def[k] < 0:
            im.imp_name[im.nimp] = o.s_name[k]
            im.imp_slot[im.nimp] = -1
            im.nimp = im.nimp + 1
        else:
            im.sym_name[im.nsym] = o.s_name[k]
            if o.s_sec[k] == 8:
                im.sym_at[im.nsym] = im.data_lin + o.s_def[k]
            else:
                im.sym_at[im.nsym] = o.s_def[k]
            im.nsym = im.nsym + 1
    im.b.put_all(&a.c)
    let sys_at = -1
    if sys_sym >= 0 && target_arch == arch_aarch64():
        sys_at = sbx_sys_a64(&im)
    elif sys_sym >= 0 && target_arch == arch_riscv64():
        sys_at = sbx_sys_rv(&im)
    elif sys_sym >= 0:
        while im.b.n % 16 != 0:
            im.b.put_byte(0)
        sys_at = im.b.n
        let sa = new_asm()
        /#/ the heap word accesses go through gs like the code's own
        sa.acc.sbx = true
        sa.acc.bm = a.acc.bm
        sa.begin_fun()
        let ex = sa.new_label()
        let mm = sa.new_label()
        let nomem = sa.new_label()
        let wr = sa.new_label()
        let rd = sa.new_label()
        sa.cmp_ri(7, 60)
        sa.jcc(cc_e(), ex)
        sa.cmp_ri(7, 231)
        sa.jcc(cc_e(), ex)
        sa.cmp_ri(7, 9)
        sa.jcc(cc_e(), mm)
        sa.cmp_ri(7, 1)
        sa.jcc(cc_e(), wr)
        sa.cmp_ri(7, 0)
        sa.jcc(cc_e(), rd)
        sa.mov_ri(0, 0 - 38)
        sa.ret()
        /#/ mmap(0, len, ..): the next len bytes of the heap, rounded up to a page, or ENOMEM
        sa.bind(mm)
        sa.mov_ri(1, sbx_lin_at())
        sa.load(0, 1, 0, 8)
        sa.load(7, 1, 8, 8)
        sa.add_ri(2, 4095)
        sa.and_ri(2, 0 - 4096)
        sa.mov_rr(6, 0)
        sa.cmp_rr(2, 7)
        sa.jcc(cc_a(), nomem)
        sa.add_rr(0, 2)
        sa.cmp_rr(0, 7)
        sa.jcc(cc_a(), nomem)
        sa.store(1, 0, 0, 8)
        sa.mov_rr(0, 6)
        sa.ret()
        sa.bind(nomem)
        sa.mov_ri(0, 0 - 12)
        sa.ret()
        /#/ read and write go to the host: two stubs `jmp [rip+2]` with a slot each, which the loader fills
        for t in 0..2:
            if t == 0:
                sa.bind(wr)
            else:
                sa.bind(rd)
            sa.byte(255)
            sa.byte(37)
            sa.byte(2)
            sa.byte(0)
            sa.byte(0)
            sa.byte(0)
            sa.byte(204)
            sa.byte(204)
            for q in 0..8:
                sa.byte(0)
        sa.bind(ex)
        sa.mov_rr(0, 6)
        sa.end_fun()
        let from = sa.fs
        while im.b.n % 16 != 0:
            im.b.put_byte(0)
        sys_at = im.b.n
        for q in from..sa.c.n:
            im.b.put_byte(sa.c.b[q])
        im.sys_at = sys_at
        /#/ the slot of the first stub, where the assembler left the label (it shortens jumps)
        im.hc_at = sys_at + sa.lab[wr] - from + 8
        /#/ jmp to the exit stub, which sits 16 bytes on
        let after = im.b.n + 5
        let to = image_round(after, 16)
        im.b.put_byte(233)
        w32(&im.b, to - after)
        im.exit_at = to
        while im.b.n < to + 64:
            im.b.put_byte(0)
    /#/ an entry of 16 bytes for each import the loader may offer as a host function: an indirect jump through
    /#/ the slot in its last 8 bytes, which the loader fills with the trampoline of the function
    let ent_of: buf<int> = new_buf(int, o.ns + 1)
    let ni = 0
    for k in 0..o.ns:
        ent_of[k] = 0 - 1
        if o.s_def[k] < 0 && k != sys_sym:
            if ni == 0:
                while im.b.n % 16 != 0:
                    im.b.put_byte(0)
            ent_of[k] = im.b.n
            if target_arch == arch_riscv64():
                /#/ auipc t6, 0; ld t6, 16(t6); jalr x0, 0(t6); ebreak, then the slot
                w32(&im.b, (31 << 7) | 23)
                w32(&im.b, (16 << 20) | (31 << 15) | (3 << 12) | (31 << 7) | 3)
                w32(&im.b, (31 << 15) | 103)
                w32(&im.b, 1048691)
            elif target_arch == arch_aarch64():
                w32(&im.b, 1476395088)
                w32(&im.b, 3592356352)
            else:
                for q in 0..6:
                    im.b.put_byte(host_entry_x86(q))
                im.b.put_byte(204)
                im.b.put_byte(204)
            for q in 0..(sbx_entry_stride() // 2):
                im.b.put_byte(0)
            ni = ni + 1
    for k in 0..im.nimp:
        im.imp_slot[k] = 0 - 1
    for k in 0..o.ns:
        if ent_of[k] >= 0:
            for q in 0..im.nimp:
                if im.imp_name[q] == o.s_name[k]:
                    im.imp_slot[q] = ent_of[k] + sbx_entry_stride() // 2
    for q in 0..sbx_header():
        im.lin.put_byte(0)
    im.lin.put_all(&o.ro)
    while im.lin.n < im.data_lin - sbx_lin_at():
        im.lin.put_byte(0)
    im.lin.put_all(&o.data)
    for r in 0..a.nrl:
        let at = a.rl_at[r]
        let sym = a.rl_sym[r]
        let ty = a.rl_ty[r]
        if at < 0 || at + 4 > a.c.n:
            im.err = 1
            return im
        let d = 0
        if ty == r_abs32() || ty == 264 || ty == 266 || ty == 26 || ty == 27:
            let target = 0 - 1
            if sym == 1:
                target = ro_lin
            elif sym >= 2 && sym - 2 < o.ns:
                let sk = sym - 2
                if o.s_def[sk] >= 0 && o.s_sec[sk] == 8:
                    target = im.data_lin + o.s_def[sk]
                elif o.s_def[sk] >= 0:
                    im.err = 3
                    return im
            if target < 0:
                im.err = 2
                return im
            d = target + a.rl_add[r]
            if ty == 26 || ty == 27:
                /#/ lui / addi of riscv64: the offset in the 20 bits of the lui, the low 12 of the addi
                let w = im.b.b[at] | (im.b.b[at + 1] << 8) | (im.b.b[at + 2] << 16) | (im.b.b[at + 3] << 24)
                if ty == 26:
                    w = w | ((((d + 2048) >> 12) & 1048575) << 12)
                else:
                    w = w | ((d & 4095) << 20)
                for q in 0..4:
                    im.b.b[at + q] = (w >> (8 * q)) & 255
                continue
            if ty == 264 || ty == 266:
                /#/ movz / movk of aarch64: 16 bits of the offset in bits 5 to 20
                let w = im.b.b[at] | (im.b.b[at + 1] << 8) | (im.b.b[at + 2] << 16) | (im.b.b[at + 3] << 24)
                if ty == 266:
                    d = d >> 16
                w = w | ((d & 65535) << 5)
                for q in 0..4:
                    im.b.b[at + q] = (w >> (8 * q)) & 255
                continue
        else:
            if sym < 2 || sym - 2 >= o.ns:
                im.err = 1
                return im
            let tk = sym - 2
            if o.s_def[tk] < 0 && tk == sys_sym:
                d = sys_at + a.rl_add[r] - at
            elif o.s_def[tk] < 0 && ent_of[tk] >= 0:
                d = ent_of[tk] + a.rl_add[r] - at
            elif o.s_def[tk] < 0 || o.s_sec[tk] != 1:
                im.err = 2
                return im
            else:
                d = o.s_def[tk] + a.rl_add[r] - at
            if target_arch == arch_riscv64():
                /#/ auipc / jalr of a call: the distance from the auipc
                if ty != 19 || at + 8 > a.c.n:
                    im.err = 1
                    return im
                let w1 = im.b.b[at] | (im.b.b[at + 1] << 8) | (im.b.b[at + 2] << 16) | (im.b.b[at + 3] << 24)
                let w2 = im.b.b[at + 4] | (im.b.b[at + 5] << 8) | (im.b.b[at + 6] << 16) | (im.b.b[at + 7] << 24)
                w1 = w1 | ((((d + 2048) >> 12) & 1048575) << 12)
                w2 = w2 | ((d & 4095) << 20)
                for q in 0..4:
                    im.b.b[at + q] = (w1 >> (8 * q)) & 255
                    im.b.b[at + 4 + q] = (w2 >> (8 * q)) & 255
                continue
            if target_arch == arch_aarch64():
                if ty != 283 && ty != 282:
                    im.err = 1
                    return im
                if !apply_a64(&im.b, at, ty, at + d):
                    im.err = 1
                    return im
                continue
        for q in 0..4:
            im.b.b[at + q] = (d >> (8 * q)) & 255
    return im

/#/ The system function of aarch64 sandbox code, appended to the image (`im.b`); returns where it starts and sets
/#/ `im.sys_at`, `im.hc_at` and `im.exit_at`. It is called as `cf_syscall(n, a, b, c, ..)` (n in x0, the arguments in
/#/ x1 to x6) and does what the sandbox may: `exit` and `exit_group` go to the exit stub, `mmap` takes the next bytes
/#/ of the heap, `write` and `read` jump through slots the loader fills with the host stubs; the rest fail (ENOSYS).
/#/ The code is the loader's, not the sandbox's: it is not verified.
fn sbx_sys_a64(im: &Image) => int:
    while im.b.n % 16 != 0:
        im.b.put_byte(0)
    let sys_at = im.b.n
    let sa = new_asm()
    sa.acc.sbx = false
    let ex = sa.new_label()
    let mm = sa.new_label()
    let nomem = sa.new_label()
    let wr = sa.new_label()
    let rd = sa.new_label()
    for k in 0..4:
        let nr = 0
        let lab = ex
        if k == 0:
            nr = 93
        elif k == 1:
            nr = 94
        elif k == 2:
            nr = 222
            lab = mm
        elif k == 3:
            nr = 64
            lab = wr
        a64_cmp_ri(&sa, 0, nr)
        a64_bcc(&sa, ac_eq(), lab)
    a64_cmp_ri(&sa, 0, 63)
    a64_bcc(&sa, ac_eq(), rd)
    a64_mov_ri(&sa, 0, 0 - 38)
    a64_ret(&sa)
    /#/ mmap(0, len, ..): the next len bytes of the heap, rounded up to a page, or ENOMEM; the header is at x28 + sbx_lin_at()
    sa.bind(mm)
    a64_mov_ri(&sa, 9, sbx_lin_at())
    a64_add_rr(&sa, 9, 9, 28)
    a64_ld(&sa, 10, 9, 0, 8)
    a64_ld(&sa, 11, 9, 8, 8)
    a64_addsub_ri(&sa, false, 2, 2, 4095)
    a64_mov_ri(&sa, 12, 0 - 4096)
    a64_and_rr(&sa, 2, 2, 12)
    a64_mov_rr(&sa, 13, 10)
    a64_cmp_rr(&sa, 2, 11)
    a64_bcc(&sa, ac_hi(), nomem)
    a64_add_rr(&sa, 10, 10, 2)
    a64_cmp_rr(&sa, 10, 11)
    a64_bcc(&sa, ac_hi(), nomem)
    a64_st(&sa, 9, 0, 10, 8)
    a64_mov_rr(&sa, 0, 13)
    a64_ret(&sa)
    sa.bind(nomem)
    a64_mov_ri(&sa, 0, 0 - 12)
    a64_ret(&sa)
    /#/ read and write: `ldr x16, [pc, 8]; br x16` and the slot
    for t in 0..2:
        if t == 0:
            sa.bind(wr)
        else:
            sa.bind(rd)
        a64_w(&sa, 1476395088)
        a64_w(&sa, 3592356352 | (16 << 5))
        a64_w(&sa, 0)
        a64_w(&sa, 0)
    sa.bind(ex)
    a64_mov_rr(&sa, 0, 1)
    if !a64_end_fun(&sa):
        im.err = 1
        return sys_at
    im.b.put_all(&sa.c)
    im.sys_at = sys_at
    im.hc_at = sys_at + sa.lab[wr] + 8
    /#/ the exit stub follows at once: the code above falls into it
    im.exit_at = im.b.n
    while im.b.n < im.exit_at + 128:
        im.b.put_byte(0)
    return sys_at

/#/ The system function of riscv64 sandbox code, the counterpart of `sbx_sys_a64`: called as `cf_syscall(n, a, b, c, ..)`
/#/ (n in a0, the arguments in a1 to a6), it sends `exit` and `exit_group` to the exit stub, `mmap` takes the next bytes of the
/#/ heap (the header is at s10 + `sbx_lin_at()`), `write` and `read` jump through slots the loader fills with the host stubs;
/#/ the rest fail (ENOSYS). The code is the loader's, not the sandbox's: it is not verified.
fn sbx_sys_rv(im: &Image) => int:
    while im.b.n % 16 != 0:
        im.b.put_byte(0)
    let sys_at = im.b.n
    let sa = new_asm()
    sa.acc.sbx = false
    sa.begin_fun()
    let ex = sa.new_label()
    let mm = sa.new_label()
    let nomem = sa.new_label()
    let wr = sa.new_label()
    let rd = sa.new_label()
    for k in 0..4:
        let nr = 0
        let lab = ex
        if k == 0:
            nr = 93
        elif k == 1:
            nr = 94
        elif k == 2:
            nr = 222
            lab = mm
        elif k == 3:
            nr = 64
            lab = wr
        rv_li(&sa, 5, nr)
        rv_bcc(&sa, 0, 10, 5, lab)
    rv_li(&sa, 5, 63)
    rv_bcc(&sa, 0, 10, 5, rd)
    rv_li(&sa, 10, 0 - 38)
    rv_ret(&sa)
    /#/ mmap(0, len, ..): the next len bytes of the heap, rounded up to a page, or ENOMEM
    sa.bind(mm)
    rv_li(&sa, 5, sbx_lin_at())
    rv_add(&sa, 5, 5, rv_sbx_base())
    rv_ld(&sa, 6, 5, 0, 8)
    rv_ld(&sa, 7, 5, 8, 8)
    rv_li(&sa, 28, 4095)
    rv_add(&sa, 12, 12, 28)
    rv_li(&sa, 28, 0 - 4096)
    rv_and(&sa, 12, 12, 28)
    rv_mov_rr(&sa, 29, 6)
    rv_bcc(&sa, 6, 7, 12, nomem)
    rv_add(&sa, 6, 6, 12)
    rv_bcc(&sa, 6, 7, 6, nomem)
    rv_st(&sa, 5, 0, 6, 8)
    rv_mov_rr(&sa, 10, 29)
    rv_ret(&sa)
    sa.bind(nomem)
    rv_li(&sa, 10, 0 - 12)
    rv_ret(&sa)
    /#/ read and write: `auipc t6, 0; ld t6, 16(t6); jalr x0, 0(t6)`, a trap word, the slot (8-aligned) and padding
    for t in 0..2:
        while sa.c.n % 8 != 0:
            rv_brk(&sa)
        if t == 0:
            sa.bind(wr)
        else:
            sa.bind(rd)
        rv_w(&sa, (31 << 7) | 23)
        rv_w(&sa, (16 << 20) | (31 << 15) | (3 << 12) | (31 << 7) | 3)
        rv_w(&sa, (31 << 15) | 103)
        rv_brk(&sa)
        for q in 0..16:
            sa.c.put_byte(0)
    sa.bind(ex)
    rv_mov_rr(&sa, 10, 11)
    if !rv_end_fun(&sa):
        im.err = 1
        return sys_at
    im.b.put_all(&sa.c)
    im.sys_at = sys_at
    im.hc_at = sys_at + sa.lab[wr] + 16
    /#/ the exit stub follows at once: the code above falls into it
    im.exit_at = im.b.n
    while im.b.n < im.exit_at + 128:
        im.b.put_byte(0)
    return sys_at

/#/ The sandbox image of the module in `lw`, whose code was generated with `Asm.sbx` set.
fn image_sbx_of(lw: &Lower) => Image:
    g_add_rodata(&lw.mc, &lw.sbytes)
    for k in 0..lw.gl_n:
        let w = new_txt()
        lw.names.put(&w, lw.gl_name[k])
        g_add_global(&lw.mc, &w, lw.gl_size[k])
    return make_image_sbx(&lw.mc.o, &lw.mc.a)
