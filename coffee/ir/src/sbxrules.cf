/#/ The rules the two sandbox verifiers (sbxcheck.cf for x86-64, sbxcheck_a64.cf for aarch64) enforce, as data.
/#/ Each verifier has its own reasons for refusing an instruction (a number of its decoder); a table per target maps
/#/ them to the rules here, so a refusal is reported in the same words on both, and the cases of
/#/ tests/sbx_cases.cf can say which rule each must trip. The rules:
/#/
/#/   decode      the instruction is not one the code generator makes (system calls, indirect branches, atomics,
/#/               unknown or cut-off encodings): nothing can be said about what it does
/#/   unguarded   a memory access that is not in a form that stays in the linear memory or on the stack of the code
/#/   frame       an access on the stack of the code outside its frame (the saved registers, far away)
/#/   protected   a write to the base register, the frame pointer, the stack pointer or the link register other than
/#/               the ones a frame makes
/#/   branch      a jump or call whose target is not an instruction of the code; or the code runs on past its end
/#/   adjacent    (x86-64 base mode) an access [r15 + s] whose address was not made by the 32-bit `lea` right before it

fn sbr_decode() => int:
    return 1

fn sbr_unguarded() => int:
    return 2

fn sbr_frame() => int:
    return 3

fn sbr_protected() => int:
    return 4

fn sbr_branch() => int:
    return 5

fn sbr_adjacent() => int:
    return 6

/#/ How many rules there are (numbered from 1).
fn sbr_count() => int:
    return 6

fn sbr_name(r: int) => str:
    if r == 1:
        return "decode"
    if r == 2:
        return "unguarded"
    if r == 3:
        return "frame"
    if r == 4:
        return "protected"
    if r == 5:
        return "branch"
    if r == 6:
        return "adjacent"
    return "?"

/#/ Does the verifier of the target (0 x86-64, 1 aarch64) have rule `r`?
fn sbr_applies(arch: int, r: int) => bool:
    return r != sbr_adjacent() || arch == 0

/#/ The rule of the last refusal, set by the verifier that made it.
let sbx_rule = 0

/#/ The entries of the imports that a call may go to besides `entry`: `lo` up to `hi`, one every 16 bytes
/#/ (the image makes them, see make_image_sbx); empty when `hi` is `lo`.
let sbx_imp_lo = 0
let sbx_imp_hi = 0

fn sbx_set_imports(lo: int, hi: int) => void:
    sbx_imp_lo = lo
    sbx_imp_hi = hi

/#/ May a call go to `t` without it being the start of an instruction of the code: `entry`, or an import entry?
fn sbx_call_entry(t: int, entry: int) => bool:
    if t == entry:
        return true
    return t >= sbx_imp_lo && t < sbx_imp_hi && (t - sbx_imp_lo) % 16 == 0

/#/ The rule of x86-64 reason `why` (the numbers of `dec_no` in sbxcheck.cf), indexed by the reason.
fn sbr_of_x86(why: int) => int:
    let t = [0, 1, 1, 1, 1, 1, 1, 1, 1, 2, 3, 4, 4, 4, 2, 4]
    return t[why]

/#/ The rule of aarch64 reason `why` (the numbers of `a64k_no` in sbxcheck_a64.cf).
fn sbr_of_a64(why: int) => int:
    let t = [0, 1, 1, 2, 1, 3, 3, 4, 2, 4, 3, 4, 1, 1, 1, 5, 5]
    return t[why]
