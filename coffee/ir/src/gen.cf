/#/ From the IR of a function to x86-64, the plainest way: every value has a place in the frame,
/#/ an instruction loads its operands into registers, computes and stores the result. No register
/#/ allocation yet; the point is a correct code generator that stands on its own.
/#/
/#/ Scalars may live in the callee-saved registers rbx, r12 to r15 instead of the frame: a linear
/#/ scan over live ranges (from a dataflow over the blocks) gives the busiest values a register for
/#/ their whole range; the rest stay in the frame. Nothing is saved around calls, the callee keeps them.
/#/
/#/ Frame (rbp-relative): [rbp-8] the pointer a function returning an aggregate was given, then one
/#/ 8-byte-aligned place per value (the memory layout for an aggregate, 8 bytes for a scalar, whose
/#/ upper bytes are not meaningful), the `slot` areas, and a scratch area for edge copies.
/#/
/#/ Calls follow the System V convention for scalars (integers and pointers in rdi, rsi, rdx, rcx,
/#/ r8, r9, floats in xmm0 to xmm7, the rest on the stack). An aggregate is passed as a pointer to
/#/ its place in the caller's frame and returned through a pointer in the first integer register.
use * in elf

fn int_reg(k: int) => int:
    if k == 0:
        return 7
    if k == 1:
        return 6
    if k == 2:
        return 2
    if k == 3:
        return 1
    if k == 4:
        return 8
    return 9

/#/ Bytes of a value of representation `r` in memory.
fn rsize(rs: &Reps, r: int) => int:
    if r == int(Rp.Void):
        return 0
    if r == int(Rp.I8):
        return 1
    if r == int(Rp.I16):
        return 2
    if r == int(Rp.I32) || r == int(Rp.F32):
        return 4
    if r < rp_first_agg():
        return 8
    let off = 0
    let al = 1
    for i in 0..rs.elems(r):
        let e = rs.elem(r, i)
        let ea = ralign(rs, e)
        off = (off + ea - 1) // ea * ea + rsize(rs, e)
        if ea > al:
            al = ea
    return (off + al - 1) // al * al

fn ralign(rs: &Reps, r: int) => int:
    if r < rp_first_agg():
        let s = rsize(rs, r)
        if s == 0:
            return 1
        return s
    let al = 1
    for i in 0..rs.elems(r):
        let ea = ralign(rs, rs.elem(r, i))
        if ea > al:
            al = ea
    return al

/#/ Offset of element `idx` of aggregate `r`.
fn elem_off(rs: &Reps, r: int, idx: int) => int:
    let off = 0
    for i in 0..idx + 1:
        let e = rs.elem(r, i)
        let ea = ralign(rs, e)
        off = (off + ea - 1) // ea * ea
        if i < idx:
            off = off + rsize(rs, e)
    return off

fn round8(n: int) => int:
    return (n + 7) // 8 * 8

class Gen:
    a: Asm
    o: Obj
    /#/ the place of each value, as the distance below rbp; for a `slot` its area
    voff: buf<int>
    tmp: int
    frame: int
    err: int
    av: buf<int>
    nav: int
    /#/ where the string literals are in .rodata, by number
    sbase: int
    soff: buf<int>
    nstr: int
    /#/ the register a value lives in, -1 for the frame; the registers used (saved in the prologue)
    home: buf<int>
    did: buf<int>
    nsaved: int
    saved: buf<int>
    /#/ the edges leaving a block
    ed: buf<int>
    ned: int
    ra_lo: buf<int>
    ra_hi: buf<int>
    ra_wt: buf<int>
    ra_use: buf<int>
    ra_def: buf<int>
    ra_words: int

    fn add_str(self, off: int) => void:
        if self.nstr >= len(self.soff):
            self.soff = buf_resize(self.soff, (self.nstr + 1) * 2)
        self.soff[self.nstr] = off
        self.nstr = self.nstr + 1

    fn add_rodata(self, t: &Txt) => void:
        self.o.ro.put_all(t)

    /#/ Makes `name` an object of `size` zero bytes in `.data`.
    fn add_global(self, name: &Txt, size: int) => void:
        self.o.define_data(self.o.sym(name), size)

    fn elf(self) => Txt:
        return write_elf(&self.o, &self.a)

    fn bad(self) => void:
        self.err = self.err + 1

    fn push_arg(self, v: int) => void:
        if self.nav >= len(self.av):
            self.av = buf_resize(self.av, (self.nav + 1) * 2)
        self.av[self.nav] = v
        self.nav = self.nav + 1

    /#/ ---- values ------------------------------------------------------------

    /#/ The value an operand stands for, through forwarding and `own.move`.
    fn res(self, f: &Fun, v: int) => int:
        let x = f.follow(v)
        while f.op[x] == int(Op.OwnMove):
            x = f.follow(f.a[x])
        return x

    /#/ reg = the value (a scalar, 8 bytes; narrower ones have meaningful low bytes only)
    fn ld(self, reg: int, f: &Fun, v: int) => void:
        let x = self.res(f, v)
        let k = f.op[x]
        if k == int(Op.Const):
            let r = f.rep[x]
            if r == int(Rp.F32):
                self.a.mov_ri(reg, f.aux[x] & 4294967295)
            else:
                self.a.mov_ri(reg, f.aux[x])
        elif k == int(Op.Undef):
            self.a.mov_ri(reg, 0)
        elif k == int(Op.StrLit):
            self.a.lea_rip(reg, 1, self.sbase + self.so(f.aux[x]))
        elif k == int(Op.Slot):
            self.a.lea(reg, 5, 0 - self.voff[x])
        elif self.home[x] >= 0:
            if self.home[x] != reg:
                self.a.mov_rr(reg, self.home[x])
        else:
            self.a.load(reg, 5, 0 - self.voff[x], 8)

    fn so(self, id: int) => int:
        return self.soff[id]

    /#/ The register that holds `v`: its own when it has one, else `scratch`, loaded with it.
    fn src(self, f: &Fun, v: int, scratch: int) => int:
        let h = self.home[self.res(f, v)]
        if h >= 0:
            return h
        self.ld(scratch, f, v)
        return scratch

    /#/ The register of `v` when it has one, else -1.
    fn home_of(self, f: &Fun, v: int) => int:
        return self.home[self.res(f, v)]

    /#/ reg = the value extended from its width
    fn ld_ext(self, reg: int, f: &Fun, v: int, signed: bool) => void:
        self.ld(reg, f, v)
        let x = self.res(f, v)
        let r = f.rep[x]
        if r == int(Rp.I8) || r == int(Rp.I16) || r == int(Rp.I32):
            self.a.extend(reg, reg, rsize_scalar(r), signed)

    /#/ mov [rbp - place of i], reg
    fn st(self, i: int, reg: int) => void:
        if self.home[i] >= 0:
            if self.home[i] != reg:
                self.a.mov_rr(self.home[i], reg)
        else:
            self.a.store(5, 0 - self.voff[i], reg, 8)

    /#/ For an aggregate value: the base register and displacement of its bytes.
    fn ab_reg(self, f: &Fun, v: int) => int:
        let x = self.res(f, v)
        if f.op[x] == int(Op.Undef):
            self.a.lea_rip(6, 1, 0)
            return 6
        return 5

    fn ab_disp(self, f: &Fun, v: int) => int:
        let x = self.res(f, v)
        if f.op[x] == int(Op.Undef):
            return 0
        return 0 - self.voff[x]

    /#/ n bytes from [sb + sd] to [db + dd], through rax.
    fn copy_mem(self, db: int, dd: int, sb: int, sd: int, n: int) => void:
        let k = 0
        while k + 8 <= n:
            self.a.load(0, sb, sd + k, 8)
            self.a.store(db, dd + k, 0, 8)
            k = k + 8
        if k + 4 <= n:
            self.a.load(0, sb, sd + k, 4)
            self.a.store(db, dd + k, 0, 4)
            k = k + 4
        if k + 2 <= n:
            self.a.load(0, sb, sd + k, 2)
            self.a.store(db, dd + k, 0, 2)
            k = k + 2
        if k < n:
            self.a.load(0, sb, sd + k, 1)
            self.a.store(db, dd + k, 0, 1)

    /#/ Value `v` to [db + dd], in full: a scalar as 8 bytes, an aggregate as its layout.
    fn val_to(self, f: &Fun, rs: &Reps, db: int, dd: int, v: int) => void:
        let x = self.res(f, v)
        let r = f.rep[x]
        if r >= rp_first_agg():
            let sb = self.ab_reg(f, x)
            self.copy_mem(db, dd, sb, self.ab_disp(f, x), rsize(rs, r))
        else:
            self.ld(0, f, x)
            self.a.store(db, dd, 0, 8)

    /#/ ---- registers -----------------------------------------------------------

    fn restore_saved(self) => void:
        for k in 0..self.nsaved:
            self.a.load(self.saved[k], 5, 0 - 16 - 8 * k, 8)

    /#/ Can value `v` live in a register? Scalars made by instructions or block parameters.
    fn wants_reg(self, f: &Fun, v: int) => bool:
        if f.fwd[v] >= 0:
            return false
        let r = f.rep[v]
        if r == int(Rp.Void) || r >= rp_first_agg():
            return false
        let op = f.op[v]
        return !(op == int(Op.Slot) || op == int(Op.Const) || op == int(Op.StrLit) || op == int(Op.Undef) || op == int(Op.OwnMove))

    /#/ The edges leaving block `b`, in `ed`.
    fn term_edges(self, f: &Fun, b: int) => void:
        self.ned = 0
        let t = f.blast[b]
        if t < 0:
            return
        let op = f.op[t]
        if op == int(Op.Br):
            self.add_edge(f.aux[t])
        elif op == int(Op.CondBr):
            self.add_edge(f.b[t])
            self.add_edge(f.c[t])
        elif op == int(Op.Switch):
            for k in 0..f.b[t]:
                self.add_edge(f.pool[f.aux[t] + k * 2 + 1])
            self.add_edge(f.c[t])

    fn add_edge(self, e: int) => void:
        if self.ned >= len(self.ed):
            self.ed = buf_resize(self.ed, (self.ned + 1) * 2)
        self.ed[self.ned] = e
        self.ned = self.ned + 1

    /#/ Chooses a register for the values that deserve one: `home` of every value (-1 for the frame).
    /#/ Live ranges are single intervals of the block order, made from the liveness of every block.
    fn alloc_regs(self, f: &Fun, rs: &Reps) => void:
        let n = f.ni
        if len(self.home) < n + 1:
            self.home = new_buf(int, n + 1)
            self.did = new_buf(int, n + 1)
        for v in 0..n:
            self.home[v] = -1
            self.did[v] = -1
        self.nsaved = 0
        /#/ dense numbers, positions: uses at even numbers, definitions after them
        let nd = 0
        for b in 0..f.nb:
            let p = f.pfirst[b]
            while p >= 0:
                if self.wants_reg(f, p):
                    self.did[p] = nd
                    nd = nd + 1
                p = f.nx[p]
            let i = f.bfirst[b]
            while i >= 0:
                if self.wants_reg(f, i):
                    self.did[i] = nd
                    nd = nd + 1
                i = f.nx[i]
        if nd == 0:
            return
        let words = (nd + 31) // 32
        if f.nb * words > 4000000:
            return
        let dv: buf<int> = new_buf(int, nd + 1)
        self.ra_lo = new_buf(int, nd + 1)
        self.ra_hi = new_buf(int, nd + 1)
        self.ra_wt = new_buf(int, nd + 1)
        self.ra_words = words
        self.ra_use = new_buf(int, f.nb * words + 1)
        self.ra_def = new_buf(int, f.nb * words + 1)
        let bs: buf<int> = new_buf(int, f.nb + 1)
        let be: buf<int> = new_buf(int, f.nb + 1)
        let depth: buf<int> = new_buf(int, f.nb + 1)
        for d in 0..nd:
            self.ra_lo[d] = 1000000000
            self.ra_hi[d] = -1
        /#/ loop depth: a back edge (to a block not after its source) wraps the blocks between
        for b in 0..f.nb:
            self.term_edges(f, b)
            for k in 0..self.ned:
                let t = f.eto[self.ed[k]]
                if t >= 0 && t <= b:
                    for q in t..b + 1:
                        depth[q] = depth[q] + 1
        let pos = 0
        for b in 0..f.nb:
            bs[b] = pos + 1
            let p = f.pfirst[b]
            let w = 1
            for q in 0..depth[b]:
                if w < 4096:
                    w = w * 8
            while p >= 0:
                let d = self.did[p]
                if d >= 0:
                    dv[d] = p
                    self.ra_lo[d] = pos + 1
                    self.ra_hi[d] = pos + 1
                    self.ra_wt[d] = self.ra_wt[d] + w
                p = f.nx[p]
            pos = pos + 2
            let i = f.bfirst[b]
            be[b] = bs[b]
            while i >= 0:
                be[b] = pos
                let d = self.did[i]
                if d >= 0:
                    dv[d] = i
                    self.ra_lo[d] = pos + 1
                    self.ra_hi[d] = pos + 1
                    self.ra_wt[d] = self.ra_wt[d] + w
                i = f.nx[i]
                pos = pos + 2
        let live_in: buf<int> = new_buf(int, f.nb * words + 1)
        let live_out: buf<int> = new_buf(int, f.nb * words + 1)
        for b in 0..f.nb:
            let w = 1
            for q in 0..depth[b]:
                if w < 4096:
                    w = w * 8
            let p = f.pfirst[b]
            while p >= 0:
                if self.did[p] >= 0:
                    let d = self.did[p]
                    self.ra_def[b * words + (d >> 5)] = self.ra_def[b * words + (d >> 5)] | (1 << (d & 31))
                p = f.nx[p]
            let i = f.bfirst[b]
            let ip = bs[b] + 1
            while i >= 0:
                for k in 0..f.nval(i):
                    self.note_use(f, f.val_at(i, k), b, ip, w)
                let d = self.did[i]
                if d >= 0:
                    self.ra_def[b * words + (d >> 5)] = self.ra_def[b * words + (d >> 5)] | (1 << (d & 31))
                i = f.nx[i]
                ip = ip + 2
            self.term_edges(f, b)
            for k in 0..self.ned:
                let e = self.ed[k]
                for j in 0..f.eargn[e]:
                    self.note_use(f, f.pool[f.eargs[e] + j], b, be[b], w)
        /#/ liveness, backwards until nothing changes
        let changed = true
        while changed:
            changed = false
            let b = f.nb - 1
            while b >= 0:
                self.term_edges(f, b)
                for k in 0..self.ned:
                    let t = f.eto[self.ed[k]]
                    if t >= 0:
                        for x in 0..words:
                            live_out[b * words + x] = live_out[b * words + x] | live_in[t * words + x]
                for x in 0..words:
                    let nv = self.ra_use[b * words + x] | (live_out[b * words + x] & (self.ra_def[b * words + x] ^ 4294967295))
                    if nv != live_in[b * words + x]:
                        live_in[b * words + x] = nv
                        changed = true
                b = b - 1
        /#/ ranges cover the blocks a value is live into or out of
        for b in 0..f.nb:
            for x in 0..words:
                let wi = live_in[b * words + x]
                let wo = live_out[b * words + x]
                if wi != 0 || wo != 0:
                    for k in 0..32:
                        let d = x * 32 + k
                        if d < nd:
                            if ((wi >> k) & 1) == 1:
                                if bs[b] < self.ra_lo[d]:
                                    self.ra_lo[d] = bs[b]
                                if bs[b] > self.ra_hi[d]:
                                    self.ra_hi[d] = bs[b]
                            if ((wo >> k) & 1) == 1:
                                if be[b] + 1 > self.ra_hi[d]:
                                    self.ra_hi[d] = be[b] + 1
                                if be[b] + 1 < self.ra_lo[d]:
                                    self.ra_lo[d] = be[b] + 1
        /#/ linear scan, by start
        let top = pos + 4
        let first: buf<int> = new_buf(int, top + 1)
        let link: buf<int> = new_buf(int, nd + 1)
        for q in 0..top + 1:
            first[q] = -1
        let sd = nd - 1
        while sd >= 0:
            link[sd] = first[self.ra_lo[sd]]
            first[self.ra_lo[sd]] = sd
            sd = sd - 1
        let regs: buf<int> = new_buf(int, 5)
        regs[0] = 3
        regs[1] = 12
        regs[2] = 13
        regs[3] = 14
        regs[4] = 15
        let occ: buf<int> = new_buf(int, 5)
        for r in 0..5:
            occ[r] = -1
        let used: buf<int> = new_buf(int, 5)
        for q in 0..top + 1:
            let cd = first[q]
            while cd >= 0:
                let d = cd
                let nxt = link[d]
                for r in 0..5:
                    if occ[r] >= 0 && self.ra_hi[occ[r]] < self.ra_lo[d]:
                        occ[r] = -1
                let fr = -1
                for r in 0..5:
                    if occ[r] < 0 && fr < 0:
                        fr = r
                if fr >= 0:
                    occ[fr] = d
                    self.home[dv[d]] = regs[fr]
                    used[fr] = 1
                else:
                    /#/ the least wanted of the live ones and this one goes to the frame
                    let worst = -1
                    for r in 0..5:
                        if worst < 0 || self.ra_wt[occ[r]] < self.ra_wt[occ[worst]]:
                            worst = r
                    if self.ra_wt[occ[worst]] < self.ra_wt[d]:
                        self.home[dv[occ[worst]]] = -1
                        self.home[dv[d]] = regs[worst]
                        occ[worst] = d
                cd = nxt
        if len(self.saved) < 5:
            self.saved = new_buf(int, 8)
        for r in 0..5:
            if used[r] == 1:
                self.saved[self.nsaved] = regs[r]
                self.nsaved = self.nsaved + 1

    fn note_use(self, f: &Fun, v: int, b: int, p: int, w: int) => void:
        if v < 0:
            return
        let x = self.res(f, v)
        let d = self.did[x]
        if d < 0:
            return
        self.ra_wt[d] = self.ra_wt[d] + w
        if p < self.ra_lo[d]:
            self.ra_lo[d] = p
        if p > self.ra_hi[d]:
            self.ra_hi[d] = p
        let words = self.ra_words
        if ((self.ra_def[b * words + (d >> 5)] >> (d & 31)) & 1) == 0:
            self.ra_use[b * words + (d >> 5)] = self.ra_use[b * words + (d >> 5)] | (1 << (d & 31))

    /#/ ---- frame -------------------------------------------------------------

    fn place_size(self, rs: &Reps, r: int) => int:
        let s = round8(rsize(rs, r))
        if s < 8:
            return 8
        return s

    /#/ Gives every value its place; the size of the frame.
    fn layout(self, f: &Fun, rs: &Reps) => void:
        if len(self.voff) < f.ni + 1:
            self.voff = new_buf(int, f.ni + 1)
        let cur = 8 + 8 * self.nsaved
        let tmp = 0
        for b in 0..f.nb:
            let p = f.pfirst[b]
            while p >= 0:
                if self.home[p] < 0:
                    cur = cur + self.place_size(rs, f.rep[p])
                    self.voff[p] = cur
                p = f.nx[p]
            let i = f.bfirst[b]
            while i >= 0:
                let op = f.op[i]
                if op == int(Op.Slot):
                    cur = cur + round8(f.ty[i])
                    if f.ty[i] < 1:
                        cur = cur + 8
                    self.voff[i] = cur
                elif f.rep[i] != int(Rp.Void) && op != int(Op.OwnMove) && self.home[i] < 0:
                    cur = cur + self.place_size(rs, f.rep[i])
                    self.voff[i] = cur
                i = f.nx[i]
        for e in 0..f.ne:
            if f.eto[e] >= 0:
                let sum = 0
                for k in 0..f.eargn[e]:
                    sum = sum + self.place_size(rs, f.rep[self.res(f, f.pool[f.eargs[e] + k])])
                if sum > tmp:
                    tmp = sum
        cur = cur + tmp
        self.tmp = cur
        self.frame = (cur + 15) // 16 * 16

    /#/ ---- edges -------------------------------------------------------------

    /#/ Copies what edge `e` passes into the parameters of the block it enters; through a scratch
    /#/ area when an argument is itself a parameter of that block (the copies are simultaneous).
    fn edge_copy(self, f: &Fun, rs: &Reps, e: int) => void:
        let to = f.eto[e]
        let n = f.eargn[e]
        if n == 0:
            return
        let hazard = false
        let pj = f.pfirst[to]
        for k in 0..n:
            let x = self.res(f, f.pool[f.eargs[e] + k])
            if f.op[x] == int(Op.Param) && f.blk[x] == to:
                hazard = true
            /#/ a parameter already written must not be what a later argument reads
            if self.home[x] >= 0:
                let q = f.pfirst[to]
                for j in 0..k:
                    if self.home[q] == self.home[x]:
                        hazard = true
                    q = f.nx[q]
        if !hazard:
            let p = f.pfirst[to]
            for k in 0..n:
                if self.home[p] >= 0:
                    self.ld(self.home[p], f, f.pool[f.eargs[e] + k])
                else:
                    self.val_to(f, rs, 5, 0 - self.voff[p], f.pool[f.eargs[e] + k])
                p = f.nx[p]
            return
        let at = 0
        for k in 0..n:
            let v = f.pool[f.eargs[e] + k]
            self.val_to(f, rs, 5, 0 - self.tmp + at, v)
            at = at + self.place_size(rs, f.rep[self.res(f, v)])
        let p = f.pfirst[to]
        at = 0
        for k in 0..n:
            let sz = self.place_size(rs, f.rep[p])
            if self.home[p] >= 0:
                self.a.load(self.home[p], 5, 0 - self.tmp + at, 8)
            else:
                self.copy_mem(5, 0 - self.voff[p], 5, 0 - self.tmp + at, sz)
            at = at + sz
            p = f.nx[p]

    /#/ ---- calls -------------------------------------------------------------

    fn is_int_class(self, r: int) => bool:
        return r != int(Rp.F32) && r != int(Rp.F64)

    /#/ The call to the symbol `sym` (or the address in r11 when `sym` < 0) with the values queued
    /#/ in `av`; the result of instruction `i` is stored.
    fn do_call(self, f: &Fun, rs: &Reps, i: int, sym: int, variadic: bool) => void:
        let ret = f.rep[i]
        let sret = ret >= rp_first_agg()
        /#/ which arguments go on the stack
        let ni = 0
        let nx = 0
        if sret:
            ni = 1
        let on_stack = 0
        for k in 0..self.nav:
            let r = f.rep[self.res(f, self.av[k])]
            if r >= rp_first_agg() || self.is_int_class(r):
                if ni < 6:
                    ni = ni + 1
                else:
                    on_stack = on_stack + 1
            elif nx < 8:
                nx = nx + 1
            else:
                on_stack = on_stack + 1
        if on_stack % 2 == 1:
            self.a.sub_ri(4, 8)
        /#/ the stack arguments, last first
        let k = self.nav - 1
        while k >= 0:
            let r = f.rep[self.res(f, self.av[k])]
            let reg_ok = false
            /#/ recompute whether this one fits in a register: count the ones before it
            let ci = 0
            if sret:
                ci = 1
            let cx = 0
            for j in 0..k:
                let rj = f.rep[self.res(f, self.av[j])]
                if rj >= rp_first_agg() || self.is_int_class(rj):
                    ci = ci + 1
                else:
                    cx = cx + 1
            if r >= rp_first_agg() || self.is_int_class(r):
                reg_ok = ci < 6
            else:
                reg_ok = cx < 8
            if !reg_ok:
                if r >= rp_first_agg():
                    let x = self.res(f, self.av[k])
                    if f.op[x] == int(Op.Undef):
                        self.a.lea_rip(0, 1, 0)
                    else:
                        self.a.lea(0, 5, 0 - self.voff[x])
                else:
                    self.ld(0, f, self.av[k])
                self.a.push(0)
            k = k - 1
        if sret:
            self.a.lea(7, 5, 0 - self.voff[i])
        let ci = 0
        if sret:
            ci = 1
        let cx = 0
        for an in 0..self.nav:
            let v = self.av[an]
            let x = self.res(f, v)
            let r = f.rep[x]
            if r >= rp_first_agg():
                if ci < 6:
                    if f.op[x] == int(Op.Undef):
                        self.a.lea_rip(int_reg(ci), 1, 0)
                    else:
                        self.a.lea(int_reg(ci), 5, 0 - self.voff[x])
                ci = ci + 1
            elif self.is_int_class(r):
                if ci < 6:
                    self.ld(int_reg(ci), f, v)
                ci = ci + 1
            else:
                if cx < 8:
                    self.ld(0, f, v)
                    self.a.movq_x(cx, 0, r == int(Rp.F32))
                cx = cx + 1
        if variadic:
            self.a.mov_ri(0, nx)
        if sym < 0:
            self.a.call_reg(11)
        else:
            self.a.call_sym(sym)
        let pop = on_stack
        if on_stack % 2 == 1:
            pop = pop + 1
        if pop > 0:
            self.a.add_ri(4, pop * 8)
        if ret == int(Rp.Void) || sret:
            return
        if self.is_int_class(ret):
            self.st(i, 0)
        else:
            self.a.movq_r(0, 0, ret == int(Rp.F32))
            self.st(i, 0)

    /#/ The symbol of the function the name number `id` of `sy` stands for.
    fn callee(self, sy: &Names, id: int) => int:
        let w = new_txt()
        sy.put(&w, id)
        return self.o.sym(&w)

    /#/ ---- instructions ------------------------------------------------------

    fn cc_of(self, p: int) => int:
        if p == int(Pr.Eq):
            return cc_e()
        if p == int(Pr.Ne):
            return cc_ne()
        if p == int(Pr.SLt):
            return cc_l()
        if p == int(Pr.SLe):
            return cc_le()
        if p == int(Pr.SGt):
            return cc_g()
        if p == int(Pr.SGe):
            return cc_ge()
        if p == int(Pr.ULt):
            return cc_b()
        if p == int(Pr.ULe):
            return cc_be()
        if p == int(Pr.UGt):
            return cc_a()
        return cc_ae()

    fn is_signed_pred(self, p: int) => bool:
        return p == int(Pr.SLt) || p == int(Pr.SLe) || p == int(Pr.SGt) || p == int(Pr.SGe)

    /#/ Is the compare `i` used only by the branch right after it? Then the flags carry it.
    fn fused(self, f: &Fun, i: int) => bool:
        let n = f.nx[i]
        if n < 0 || f.op[n] != int(Op.CondBr) || f.uses[i] != 1:
            return false
        return self.res(f, f.a[n]) == i

    /#/ Is `v` a 64-bit constant that fits the sign-extended 32-bit immediate of an instruction?
    fn small_imm(self, f: &Fun, v: int) => bool:
        let x = self.res(f, v)
        if f.op[x] != int(Op.Const):
            return false
        let r = f.rep[x]
        if r != int(Rp.I64) && r != int(Rp.Ptr):
            return false
        return f.aux[x] >= 0 - 2147483648 && f.aux[x] <= 2147483647

    /#/ Sets the flags for the integer compare `i`.
    fn cmp_flags(self, f: &Fun, i: int) => void:
        let signed = self.is_signed_pred(f.aux[i])
        let wr = f.rep[self.res(f, f.a[i])]
        if wr == int(Rp.I64) || wr == int(Rp.Ptr):
            /#/ a whole register: compare it where it lives
            let la = self.src(f, f.a[i], 0)
            if self.small_imm(f, f.b[i]):
                self.a.cmp_ri(la, f.aux[self.res(f, f.b[i])])
            else:
                self.a.cmp_rr(la, self.src(f, f.b[i], 1))
            return
        self.ld_ext(0, f, f.a[i], signed)
        if self.small_imm(f, f.b[i]):
            self.a.cmp_ri(0, f.aux[self.res(f, f.b[i])])
            return
        self.ld_ext(1, f, f.b[i], signed)
        self.a.cmp_rr(0, 1)

    /#/ Division or remainder of the 64-bit value `i`'s first operand by the constant `d` >= 2,
    /#/ without a divide instruction; false if `op` and `d` have no such form here.
    fn div_const(self, f: &Fun, i: int, op: int, d: int) => bool:
        let signed = op == int(Op.SDiv) || op == int(Op.SRem)
        let rem = op == int(Op.SRem) || op == int(Op.URem)
        let pow2 = (d & (d - 1)) == 0
        let k = 0
        while (1 << k) < d:
            k = k + 1
        if !signed:
            if !pow2:
                return false
            self.ld(0, f, f.a[i])
            if rem:
                self.a.and_ri(0, d - 1)
            else:
                self.a.shift_i(5, 0, k)
            self.st(i, 0)
            return true
        self.ld(1, f, f.a[i])
        if pow2:
            /#/ x + (d - 1 when x is negative), then shifted
            self.a.mov_rr(0, 1)
            self.a.shift_i(7, 0, 63)
            self.a.shift_i(5, 0, 64 - k)
            self.a.add_rr(0, 1)
            if rem:
                self.a.shift_i(7, 0, k)
                self.a.shift_i(4, 0, k)
                self.a.sub_rr(1, 0)
                self.st(i, 1)
            else:
                self.a.shift_i(7, 0, k)
                self.st(i, 0)
            return true
        /#/ q = (mulh(m, x) + x >> (l - 1)) - (x >> 63), with m = 1 + floor(2^(63 + l) / d)
        self.a.mov_ri(0, magic_mult(d, k))
        self.a.grp3(5, 1)
        self.a.add_rr(2, 1)
        self.a.shift_i(7, 2, k - 1)
        self.a.mov_rr(0, 1)
        self.a.shift_i(7, 0, 63)
        self.a.sub_rr(2, 0)
        if rem:
            self.a.imul_rri(2, 2, d)
            self.a.sub_rr(1, 2)
            self.st(i, 1)
        else:
            self.st(i, 2)
        return true

    fn gen_inst(self, f: &Fun, rs: &Reps, sy: &Names, i: int, next: int) => void:
        let op = f.op[i]
        let r = f.rep[i]
        if op == int(Op.Param) || op == int(Op.Slot) || op == int(Op.OwnMove) || op == int(Op.Const) || op == int(Op.StrLit) || op == int(Op.Undef):
            return
        if op == int(Op.Add) || op == int(Op.Sub) || op == int(Op.Mul) || op == int(Op.And) || op == int(Op.Or) || op == int(Op.Xor):
            let d = self.home[i]
            if d >= 0:
                /#/ the result has a register: work in it, with the operands where they live
                let a = f.a[i]
                let b = f.b[i]
                if self.home_of(f, b) == d && op != int(Op.Sub):
                    a = f.b[i]
                    b = f.a[i]
                if self.home_of(f, b) != d:
                    if self.small_imm(f, b):
                        let v = f.aux[self.res(f, b)]
                        if op == int(Op.Mul):
                            if v > 0 && (v & (v - 1)) == 0:
                                self.ld(d, f, a)
                                let sh = 0
                                while (1 << sh) < v:
                                    sh = sh + 1
                                self.a.shift_i(4, d, sh)
                            else:
                                self.a.imul_rri(d, self.src(f, a, 0), v)
                            return
                        if op == int(Op.Add) && self.home_of(f, a) >= 0:
                            self.a.lea(d, self.home_of(f, a), v)
                            return
                        self.ld(d, f, a)
                        if op == int(Op.Add):
                            self.a.add_ri(d, v)
                        elif op == int(Op.Sub):
                            self.a.sub_ri(d, v)
                        elif op == int(Op.And):
                            self.a.and_ri(d, v)
                        elif op == int(Op.Or):
                            self.a.or_ri(d, v)
                        else:
                            self.a.xor_ri(d, v)
                        return
                    self.ld(d, f, a)
                    let rb = self.src(f, b, 1)
                    if op == int(Op.Add):
                        self.a.add_rr(d, rb)
                    elif op == int(Op.Sub):
                        self.a.sub_rr(d, rb)
                    elif op == int(Op.Mul):
                        self.a.imul_rr(d, rb)
                    elif op == int(Op.And):
                        self.a.and_rr(d, rb)
                    elif op == int(Op.Or):
                        self.a.or_rr(d, rb)
                    else:
                        self.a.xor_rr(d, rb)
                    return
            self.ld(0, f, f.a[i])
            if (op == int(Op.Add) || op == int(Op.Sub)) && self.small_imm(f, f.b[i]):
                if op == int(Op.Add):
                    self.a.add_ri(0, f.aux[self.res(f, f.b[i])])
                else:
                    self.a.sub_ri(0, f.aux[self.res(f, f.b[i])])
                self.st(i, 0)
                return
            self.ld(1, f, f.b[i])
            if op == int(Op.Add):
                self.a.add_rr(0, 1)
            elif op == int(Op.Sub):
                self.a.sub_rr(0, 1)
            elif op == int(Op.Mul):
                self.a.imul_rr(0, 1)
            elif op == int(Op.And):
                self.a.and_rr(0, 1)
            elif op == int(Op.Or):
                self.a.or_rr(0, 1)
            else:
                self.a.xor_rr(0, 1)
            self.st(i, 0)
            return
        if op == int(Op.SDiv) || op == int(Op.SRem) || op == int(Op.UDiv) || op == int(Op.URem):
            let signed = op == int(Op.SDiv) || op == int(Op.SRem)
            if r == int(Rp.I64) && self.small_imm(f, f.b[i]) && f.aux[self.res(f, f.b[i])] >= 2:
                if self.div_const(f, i, op, f.aux[self.res(f, f.b[i])]):
                    return
            self.ld_ext(0, f, f.a[i], signed)
            self.ld_ext(1, f, f.b[i], signed)
            if signed:
                self.a.cqo()
                self.a.idiv(1)
            else:
                self.a.mov_ri(2, 0)
                self.a.div(1)
            if op == int(Op.SDiv) || op == int(Op.UDiv):
                self.st(i, 0)
            else:
                self.st(i, 2)
            return
        if op == int(Op.Shl) || op == int(Op.AShr) || op == int(Op.LShr):
            self.ld_ext(0, f, f.a[i], op == int(Op.AShr))
            self.ld(1, f, f.b[i])
            if op == int(Op.Shl):
                self.a.shift_cl(4, 0)
            elif op == int(Op.LShr):
                self.a.shift_cl(5, 0)
            else:
                self.a.shift_cl(7, 0)
            self.st(i, 0)
            return
        if op == int(Op.FnAddr):
            self.a.lea_rip(0, self.callee(sy, f.aux[i]), 0)
            self.st(i, 0)
            return
        if op == int(Op.Neg) || op == int(Op.Not):
            self.ld(0, f, f.a[i])
            if op == int(Op.Neg):
                self.a.neg(0)
            else:
                self.a.not_(0)
            self.st(i, 0)
            return
        if op == int(Op.FNeg):
            self.ld(0, f, f.a[i])
            if r == int(Rp.F32):
                self.a.mov_ri(1, 2147483648)
            else:
                self.a.mov_ri(1, 0 - 9223372036854775807 - 1)
            self.a.xor_rr(0, 1)
            self.st(i, 0)
            return
        if op == int(Op.FAdd) || op == int(Op.FSub) || op == int(Op.FMul) || op == int(Op.FDiv):
            let single = r == int(Rp.F32)
            self.ld(0, f, f.a[i])
            self.a.movq_x(0, 0, single)
            self.ld(0, f, f.b[i])
            self.a.movq_x(1, 0, single)
            let code = 88
            if op == int(Op.FMul):
                code = 89
            elif op == int(Op.FSub):
                code = 92
            elif op == int(Op.FDiv):
                code = 94
            self.a.sse(code, single, 0, 1)
            self.a.movq_r(0, 0, single)
            self.st(i, 0)
            return
        if op == int(Op.FRem):
            let single = r == int(Rp.F32)
            self.ld(0, f, f.a[i])
            self.a.movq_x(0, 0, single)
            self.ld(0, f, f.b[i])
            self.a.movq_x(1, 0, single)
            let nm = new_txt()
            if single:
                nm.put("fmodf")
            else:
                nm.put("fmod")
            self.a.call_sym(self.o.sym(&nm))
            self.a.movq_r(0, 0, single)
            self.st(i, 0)
            return
        if op == int(Op.Cmp):
            if self.fused(f, i):
                return
            self.cmp_flags(f, i)
            self.a.setcc(self.cc_of(f.aux[i]), 0)
            self.st(i, 0)
            return
        if op == int(Op.FCmp):
            let p = f.aux[i]
            let single = f.rep[self.res(f, f.a[i])] == int(Rp.F32)
            self.ld(0, f, f.a[i])
            self.a.movq_x(0, 0, single)
            self.ld(0, f, f.b[i])
            self.a.movq_x(1, 0, single)
            if p == int(Pr.OLt) || p == int(Pr.OLe):
                self.a.ucomi(single, 1, 0)
                if p == int(Pr.OLt):
                    self.a.setcc(cc_a(), 0)
                else:
                    self.a.setcc(cc_ae(), 0)
            elif p == int(Pr.OGt) || p == int(Pr.OGe):
                self.a.ucomi(single, 0, 1)
                if p == int(Pr.OGt):
                    self.a.setcc(cc_a(), 0)
                else:
                    self.a.setcc(cc_ae(), 0)
            else:
                self.a.ucomi(single, 0, 1)
                if p == int(Pr.OEq):
                    self.a.setcc(cc_e(), 0)
                    self.a.setcc(cc_np(), 1)
                else:
                    self.a.setcc(cc_ne(), 0)
                    self.a.setcc(cc_np(), 1)
                self.a.and_rr(0, 1)
            self.st(i, 0)
            return
        if op == int(Op.Trunc) || op == int(Op.Bitcast) || op == int(Op.PtrToInt) || op == int(Op.IntToPtr):
            self.ld(0, f, f.a[i])
            self.st(i, 0)
            return
        if op == int(Op.SExt) || op == int(Op.ZExt):
            self.ld_ext(0, f, f.a[i], op == int(Op.SExt))
            self.st(i, 0)
            return
        if op == int(Op.SiToFp) || op == int(Op.UiToFp):
            let single = r == int(Rp.F32)
            let signed = op == int(Op.SiToFp)
            self.ld_ext(0, f, f.a[i], signed)
            if signed || f.rep[self.res(f, f.a[i])] != int(Rp.I64):
                self.a.cvt_si2f(0, 0, single)
            else:
                let pos = self.a.new_label()
                let done = self.a.new_label()
                self.a.test_rr(0, 0)
                self.a.jcc(9, pos)
                self.a.mov_rr(1, 0)
                self.a.shift_i(5, 0, 1)
                self.a.mov_ri(2, 1)
                self.a.and_rr(1, 2)
                self.a.or_rr(0, 1)
                self.a.cvt_si2f(0, 0, single)
                self.a.sse(88, single, 0, 0)
                self.a.jmp(done)
                self.a.bind(pos)
                self.a.cvt_si2f(0, 0, single)
                self.a.bind(done)
            self.a.movq_r(0, 0, single)
            self.st(i, 0)
            return
        if op == int(Op.FpToSi) || op == int(Op.FpToUi):
            let single = f.rep[self.res(f, f.a[i])] == int(Rp.F32)
            self.ld(0, f, f.a[i])
            self.a.movq_x(0, 0, single)
            if op == int(Op.FpToUi) && r == int(Rp.I64):
                let small = self.a.new_label()
                let done = self.a.new_label()
                if single:
                    self.a.mov_ri(1, 1593835520)
                else:
                    self.a.mov_ri(1, 4890909195324358656)
                self.a.movq_x(1, 1, single)
                self.a.ucomi(single, 0, 1)
                self.a.jcc(cc_b(), small)
                self.a.sse(92, single, 0, 1)
                self.a.cvt_f2si(0, 0, single)
                self.a.mov_ri(1, 0 - 9223372036854775807 - 1)
                self.a.xor_rr(0, 1)
                self.a.jmp(done)
                self.a.bind(small)
                self.a.cvt_f2si(0, 0, single)
                self.a.bind(done)
            else:
                self.a.cvt_f2si(0, 0, single)
            self.st(i, 0)
            return
        if op == int(Op.FpExt) || op == int(Op.FpTrunc):
            let to_single = op == int(Op.FpTrunc)
            self.ld(0, f, f.a[i])
            self.a.movq_x(0, 0, !to_single)
            self.a.cvt_ff(0, 0, to_single)
            self.a.movq_r(0, 0, to_single)
            self.st(i, 0)
            return
        if op == int(Op.Field):
            let d = self.home[i]
            if d < 0:
                d = 0
            let rb = self.src(f, f.a[i], 0)
            if f.aux[i] == 0 && rb == d:
                self.st(i, d)
                return
            self.a.lea(d, rb, f.aux[i])
            self.st(i, d)
            return
        if op == int(Op.Index):
            let d = self.home[i]
            if d < 0:
                d = 0
            let ra = self.src(f, f.a[i], 0)
            let rb = self.src(f, f.b[i], 1)
            let sz = f.aux[i]
            if sz == 1 || sz == 2 || sz == 4 || sz == 8:
                self.a.lea_idx(d, ra, rb, sz)
            else:
                self.a.imul_rri(1, rb, sz)
                self.a.lea_idx(d, ra, 1, 1)
            self.st(i, d)
            return
        if op == int(Op.Extract):
            let ar = f.rep[self.res(f, f.a[i])]
            let eo = elem_off(rs, ar, f.aux[i])
            let sb = self.ab_reg(f, f.a[i])
            let sd = self.ab_disp(f, f.a[i]) + eo
            if r >= rp_first_agg():
                self.copy_mem(5, 0 - self.voff[i], sb, sd, rsize(rs, r))
            else:
                self.a.load(0, sb, sd, rsize(rs, r))
                self.st(i, 0)
            return
        if op == int(Op.Insert):
            let eo = elem_off(rs, r, f.aux[i])
            let sb = self.ab_reg(f, f.a[i])
            self.copy_mem(5, 0 - self.voff[i], sb, self.ab_disp(f, f.a[i]), rsize(rs, r))
            let er = f.rep[self.res(f, f.b[i])]
            if er >= rp_first_agg():
                let eb = self.ab_reg(f, f.b[i])
                self.copy_mem(5, 0 - self.voff[i] + eo, eb, self.ab_disp(f, f.b[i]), rsize(rs, er))
            else:
                self.ld(0, f, f.b[i])
                self.a.store(5, 0 - self.voff[i] + eo, 0, rsize(rs, er))
            return
        if op == int(Op.Load):
            if r >= rp_first_agg():
                self.ld(6, f, f.a[i])
                self.copy_mem(5, 0 - self.voff[i], 6, 0, rsize(rs, r))
            else:
                let d = self.home[i]
                if d < 0:
                    d = 0
                self.a.load(d, self.src(f, f.a[i], 6), 0, rsize(rs, r))
                self.st(i, d)
            return
        if op == int(Op.Store):
            let vr = f.rep[self.res(f, f.b[i])]
            if vr >= rp_first_agg():
                self.ld(7, f, f.a[i])
                let sb = self.ab_reg(f, f.b[i])
                self.copy_mem(7, 0, sb, self.ab_disp(f, f.b[i]), rsize(rs, vr))
            else:
                let rv = self.src(f, f.b[i], 0)
                self.a.store(self.src(f, f.a[i], 1), 0, rv, rsize(rs, vr))
            return
        if op == int(Op.Alloc):
            self.a.mov_ri(7, f.ty[i])
            let nm = new_txt()
            nm.put("malloc")
            self.a.call_sym(self.o.sym(&nm))
            self.st(i, 0)
            return
        if op == int(Op.Free):
            self.ld(7, f, f.a[i])
            let nm = new_txt()
            nm.put("free")
            self.a.call_sym(self.o.sym(&nm))
            return
        if op == int(Op.Drop) || op == int(Op.Clone):
            self.nav = 0
            self.push_arg(f.a[i])
            self.do_call(f, rs, i, self.callee(sy, f.aux[i]), false)
            return
        if op == int(Op.Call) || op == int(Op.CCall) || op == int(Op.CallI):
            self.nav = 0
            for k in 0..f.b[i]:
                self.push_arg(f.pool[f.a[i] + k])
            if op == int(Op.CallI):
                self.ld(11, f, f.c[i])
                self.do_call(f, rs, i, 0 - 1, false)
            else:
                self.do_call(f, rs, i, self.callee(sy, f.aux[i]), op == int(Op.CCall) && f.c[i] != 0)
            return
        if op == int(Op.Br):
            let e = f.aux[i]
            self.edge_copy(f, rs, e)
            if f.eto[e] != next:
                self.a.jmp(f.eto[e])
            return
        if op == int(Op.CondBr):
            let e1 = f.b[i]
            let e2 = f.c[i]
            let c = self.res(f, f.a[i])
            let cc = cc_ne()
            if f.op[c] == int(Op.Cmp) && self.fused(f, c):
                self.cmp_flags(f, c)
                cc = self.cc_of(f.aux[c])
            else:
                self.ld_ext(0, f, f.a[i], false)
                self.a.extend(0, 0, 1, false)
                self.a.test_rr(0, 0)
            if f.eargn[e1] == 0 && f.eargn[e2] == 0:
                /#/ no moves on either edge: one conditional jump, the other way falls through
                if f.eto[e2] == next:
                    self.a.jcc(cc, f.eto[e1])
                elif f.eto[e1] == next:
                    self.a.jcc(cc ^ 1, f.eto[e2])
                else:
                    self.a.jcc(cc, f.eto[e1])
                    self.a.jmp(f.eto[e2])
                return
            if f.eargn[e2] == 0 && f.eto[e2] == next:
                /#/ the false edge falls through: test the other way round
                let te = e1
                e1 = e2
                e2 = te
                cc = cc ^ 1
            let yes = self.a.new_label()
            self.a.jcc(cc, yes)
            self.edge_copy(f, rs, e2)
            self.a.jmp(f.eto[e2])
            self.a.bind(yes)
            self.edge_copy(f, rs, e1)
            if f.eto[e1] != next:
                self.a.jmp(f.eto[e1])
            return
        if op == int(Op.Switch):
            self.ld_ext(0, f, f.a[i], true)
            for k in 0..f.b[i]:
                let skip = self.a.new_label()
                let e = f.pool[f.aux[i] + k * 2 + 1]
                self.a.mov_ri(1, f.pool[f.aux[i] + k * 2])
                self.a.cmp_rr(0, 1)
                self.a.jcc(cc_ne(), skip)
                self.edge_copy(f, rs, e)
                self.a.jmp(f.eto[e])
                self.a.bind(skip)
            self.edge_copy(f, rs, f.c[i])
            self.a.jmp(f.eto[f.c[i]])
            return
        if op == int(Op.Ret):
            if f.a[i] >= 0:
                let vr = f.rep[self.res(f, f.a[i])]
                if vr >= rp_first_agg():
                    self.a.load(7, 5, 0 - 8, 8)
                    let sb = self.ab_reg(f, f.a[i])
                    self.copy_mem(7, 0, sb, self.ab_disp(f, f.a[i]), rsize(rs, vr))
                elif self.is_int_class(vr):
                    self.ld(0, f, f.a[i])
                else:
                    self.ld(0, f, f.a[i])
                    self.a.movq_x(0, 0, vr == int(Rp.F32))
            self.restore_saved()
            self.a.leave()
            self.a.ret()
            return
        if op == int(Op.Unreachable):
            self.a.ud2()
            return
        self.bad()

    /#/ ---- functions ---------------------------------------------------------

    /#/ Generates function `f`; returns false if something could not be translated.
    fn gen_fun(self, f: &Fun, rs: &Reps, sy: &Names) => bool:
        self.err = 0
        self.a.begin_fun()
        self.alloc_regs(f, rs)
        self.layout(f, rs)
        let start = self.a.pos()
        for b in 0..f.nb:
            self.a.new_label()
        self.a.push(5)
        self.a.mov_rr(5, 4)
        self.a.sub_ri(4, self.frame)
        for k in 0..self.nsaved:
            self.a.store(5, 0 - 16 - 8 * k, self.saved[k], 8)
        /#/ the parameters of the entry block
        let ci = 0
        let cx = 0
        let cs = 0
        if f.ret >= rp_first_agg():
            self.a.store(5, 0 - 8, 7, 8)
            ci = 1
        let p = f.pfirst[0]
        while p >= 0:
            let r = f.rep[p]
            if r >= rp_first_agg() || self.is_int_class(r):
                if ci < 6:
                    if r >= rp_first_agg():
                        self.copy_mem(5, 0 - self.voff[p], int_reg(ci), 0, rsize(rs, r))
                    else:
                        self.st(p, int_reg(ci))
                else:
                    self.a.load(0, 5, 16 + 8 * cs, 8)
                    if r >= rp_first_agg():
                        self.a.mov_rr(6, 0)
                        self.copy_mem(5, 0 - self.voff[p], 6, 0, rsize(rs, r))
                    else:
                        self.st(p, 0)
                    cs = cs + 1
                ci = ci + 1
            else:
                if cx < 8:
                    self.a.movq_r(0, cx, r == int(Rp.F32))
                    self.st(p, 0)
                else:
                    self.a.load(0, 5, 16 + 8 * cs, 8)
                    self.st(p, 0)
                    cs = cs + 1
                cx = cx + 1
            p = f.nx[p]
        for b in 0..f.nb:
            self.a.bind(b)
            let i = f.bfirst[b]
            while i >= 0:
                let nxt = -1
                if f.nx[i] < 0:
                    nxt = b + 1
                self.gen_inst(f, rs, sy, i, nxt)
                i = f.nx[i]
        let ok = self.a.end_fun()
        let w = new_txt()
        for k in 0..len(f.nm):
            w.put_byte(f.nm[k])
        let sym = self.o.sym(&w)
        self.o.define(sym, start, self.a.pos() - start)
        return ok && self.err == 0

fn new_gen() => Gen:
    return Gen { a: new_asm(), o: new_obj(), voff: new_buf(int, 64), tmp: 0, frame: 0, err: 0, av: new_buf(int, 16), nav: 0, sbase: 256, soff: new_buf(int, 16), nstr: 0, home: new_buf(int, 64), did: new_buf(int, 64), nsaved: 0, saved: new_buf(int, 8), ed: new_buf(int, 16), ned: 0, ra_lo: new_buf(int, 1), ra_hi: new_buf(int, 1), ra_wt: new_buf(int, 1), ra_use: new_buf(int, 1), ra_def: new_buf(int, 1), ra_words: 0 }

/#/ The multiplier that divides by `d` (not a power of two; `l` is the log2 of `d` rounded up):
/#/ 1 + floor(2^(63 + l) / d), taken as a 64-bit pattern, by long division one bit at a time.
fn magic_mult(d: int, l: int) => int:
    let q = 0
    let r = 0
    let bit = 63 + l
    while bit >= 0:
        r = r * 2
        if bit == 63 + l:
            r = r + 1
        if r >= d:
            r = r - d
            if bit < 64:
                q = q | (1 << bit)
        bit = bit - 1
    return q + 1

fn rsize_scalar(r: int) => int:
    if r == int(Rp.I8):
        return 1
    if r == int(Rp.I16):
        return 2
    if r == int(Rp.I32) || r == int(Rp.F32):
        return 4
    return 8
