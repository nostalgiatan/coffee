/#/ From the IR of a function to x86-64, the plainest way: every value has a place in the frame,
/#/ an instruction loads its operands into registers, computes and stores the result. No register
/#/ allocation yet; the point is a correct code generator that stands on its own.
/#/
/#/ Scalars may live in the callee-saved registers rbx, r12 to r15 instead of the frame: a linear
/#/ scan over live ranges (from a dataflow over the blocks) gives the busiest values a register for
/#/ their whole range; the rest stay in the frame. Nothing is saved around calls, the callee keeps them.
/#/
/#/ Frame (rbp-relative): [rbp-8] the pointer a function returning an aggregate was given, then one
/#/ 8-byte-aligned place per value (the memory layout for an aggregate, 8 bytes for a scalar, whose
/#/ upper bytes are not meaningful), the `slot` areas, and a scratch area for edge copies.
/#/
/#/ Calls follow the System V convention for scalars (integers and pointers in rdi, rsi, rdx, rcx,
/#/ r8, r9, floats in xmm0 to xmm7, the rest on the stack). An aggregate is passed as a pointer to
/#/ its place in the caller's frame and returned through a pointer in the first integer register.
use * in elf

fn int_reg(k: int) => int:
    if k == 0:
        return 7
    if k == 1:
        return 6
    if k == 2:
        return 2
    if k == 3:
        return 1
    if k == 4:
        return 8
    return 9

fn round8(n: int) => int:
    return (n + 7) // 8 * 8

class Gen:
    a: Asm
    o: Obj
    /#/ the place of each value, as the distance below rbp; for a `slot` its area
    voff: buf<int>
    /#/ sandbox code: 1 for a value whose bytes are in the shadow frame (r14 + offset), not the host frame
    sh: buf<int>
    sframe: int
    tmp: int
    frame: int
    err: int
    av: buf<int>
    nav: int
    /#/ where the string literals are in .rodata, by number
    sbase: int
    soff: buf<int>
    nstr: int
    /#/ the register a value lives in, -1 for the frame; the registers used (saved in the prologue)
    home: buf<int>
    xhome: buf<int>
    /#/ the order the blocks of the function are emitted in
    ord: buf<int>
    emit: buf<int>
    xsg: buf<int>
    did: buf<int>
    nsaved: int
    saved: buf<int>
    /#/ the edges leaving a block
    ed: buf<int>
    ned: int
    ra_lo: buf<int>
    ra_hi: buf<int>
    ra_wt: buf<int>
    /#/ the uses that are not of a value defined in the same block: value and block, `nuq` of them
    uq_d: buf<int>
    uq_b: buf<int>
    nuq: int
    /#/ per dense value: the block it is defined in, and whether its definition was passed in the scan of the uses
    ra_dblk: buf<int>
    ra_dset: buf<int>
    /#/ the positions of the instructions that call something, in order
    ra_cp: buf<int>
    ra_ncp: int
    /#/ per call position: the caller-saved registers (bit 0 r10, 1 r8, 2 r9, 3 r11, 4 rdi) the callee may write
    ra_cm: buf<int>
    /#/ the name id of the function being generated (-1: none), and per name id of a function of this
    /#/ object already generated, 8 + the registers it and everything it calls may write
    cur: int
    msk: buf<int>
    fmask: int
    /#/ how many times each value is used, counted again for the function being generated
    nuse: buf<int>
    /#/ the address a load or store was folded into: base, index (-1 if none), scale, displacement
    am_base: int
    am_idx: int
    am_scale: int
    am_disp: int
    /#/ the shared exit of a function that saves registers: its label, and whether a return jumps there
    epi: int
    epi_jump: bool
    /#/ float constants kept in an xmm register from the entry on (they are used in loops)
    hc: buf<int>
    nhc: int
    /#/ the source lines of the code: the offset in the text of the object where the code of a line
    /#/ starts, and the line (of the flattened text); `mk_*` are those of the function being made
    lm_at: buf<int>
    lm_ln: buf<int>
    lm_n: int
    mk_l: buf<int>
    mk_ln: buf<int>
    mk_n: int
    /#/ the functions with line marks: symbol, start in the text, first mark
    lf_sym: buf<int>
    lf_start: buf<int>
    lf_m0: buf<int>
    lf_n: int

    fn add_str(self, off: int) => void:
        if self.nstr >= len(self.soff):
            self.soff = buf_resize(self.soff, (self.nstr + 1) * 2)
        self.soff[self.nstr] = off
        self.nstr = self.nstr + 1

    fn add_rodata(self, t: &Txt) => void:
        self.o.ro.put_all(t)

    /#/ Makes `name` an object of `size` zero bytes in `.data`.
    fn add_global(self, name: &Txt, size: int) => void:
        self.o.define_data(self.o.sym(name), size)

    fn elf(self) => Txt:
        return write_elf(&self.o, &self.a)

    fn bad(self) => void:
        self.err = self.err + 1

    fn push_arg(self, v: int) => void:
        if self.nav >= len(self.av):
            self.av = buf_resize(self.av, (self.nav + 1) * 2)
        self.av[self.nav] = v
        self.nav = self.nav + 1

    /#/ ---- values ------------------------------------------------------------

    /#/ The value an operand stands for, through forwarding and `own.move`.
    fn res(self, f: &Fun, v: int) => int:
        let x = f.follow(v)
        while f.op[x] == int(Op.OwnMove):
            x = f.follow(f.a[x])
        return x

    /#/ reg = the value (a scalar, 8 bytes; narrower ones have meaningful low bytes only)
    fn ld(self, reg: int, f: &Fun, v: int) => void:
        let x = self.res(f, v)
        let k = f.op[x]
        if k == int(Op.Const):
            let r = f.rep[x]
            if r == int(Rp.F32):
                self.a.mov_ri(reg, f.aux[x] & 4294967295)
            else:
                self.a.mov_ri(reg, f.aux[x])
        elif k == int(Op.Undef):
            self.a.mov_ri(reg, 0)
        elif k == int(Op.StrLit):
            self.a.lea_rip(reg, 1, self.sbase + self.so(f.aux[x]))
        elif k == int(Op.Slot):
            self.a.lea(reg, self.vb(x), 0 - self.voff[x])
        elif self.home[x] >= 0:
            if self.home[x] != reg:
                self.a.mov_rr(reg, self.home[x])
        elif self.xhome[x] >= 0:
            self.a.movq_r(reg, self.xhome[x], self.xsg[x] == 1)
        else:
            self.a.load(reg, 5, 0 - self.voff[x], 8)

    fn so(self, id: int) => int:
        return self.soff[id]

    /#/ The base register of the bytes of value `x`: rbp, or r14 for the shadow frame of sandbox code.
    fn vb(self, x: int) => int:
        if self.a.sbx && self.sh[x] == 1:
            return 14
        return 5

    /#/ The register that holds `v`: its own when it has one, else `scratch`, loaded with it.
    fn src(self, f: &Fun, v: int, scratch: int) => int:
        let h = self.home[self.res(f, v)]
        if h >= 0:
            return h
        self.ld(scratch, f, v)
        return scratch

    /#/ The register of `v` when it has one, else -1.
    fn home_of(self, f: &Fun, v: int) => int:
        return self.home[self.res(f, v)]

    /#/ reg = the value extended from its width
    fn ld_ext(self, reg: int, f: &Fun, v: int, signed: bool) => void:
        self.ld(reg, f, v)
        let x = self.res(f, v)
        let r = f.rep[x]
        if f.op[x] == int(Op.Cmp):
            /#/ the result of a compare is 0 or 1 in a whole register already
            return
        if r == int(Rp.I8) || r == int(Rp.I16) || r == int(Rp.I32):
            self.a.extend(reg, reg, rsize_scalar(r), signed)

    /#/ mov [rbp - place of i], reg
    fn st(self, i: int, reg: int) => void:
        if self.home[i] >= 0:
            if self.home[i] != reg:
                self.a.mov_rr(self.home[i], reg)
        elif self.xhome[i] >= 0:
            self.a.movq_x(self.xhome[i], reg, self.xsg[i] == 1)
        else:
            self.a.store(5, 0 - self.voff[i], reg, 8)

    /#/ The xmm register of float `v`: its own when it has one, else `scratch`, loaded with it.
    fn xsrc(self, f: &Fun, v: int, scratch: int) => int:
        let x = self.res(f, v)
        if self.xhome[x] >= 0:
            return self.xhome[x]
        self.ld(0, f, x)
        self.a.movq_x(scratch, 0, f.rep[x] == int(Rp.F32))
        return scratch

    /#/ Where instruction `i` (a float) makes its result: its xmm register, else xmm0.
    fn xdst(self, i: int) => int:
        if self.xhome[i] >= 0:
            return self.xhome[i]
        return 0

    /#/ The result of instruction `i` is in xmm `x`: kept there, or stored.
    fn xfin(self, f: &Fun, i: int, x: int) => void:
        if self.xhome[i] >= 0:
            if self.xhome[i] != x:
                self.a.movaps(self.xhome[i], x)
        else:
            self.a.movq_r(0, x, f.rep[i] == int(Rp.F32))
            self.st(i, 0)

    /#/ For an aggregate value: the base register and displacement of its bytes.
    fn ab_reg(self, f: &Fun, v: int) => int:
        let x = self.res(f, v)
        if f.op[x] == int(Op.Undef):
            self.a.lea_rip(6, 1, 0)
            return 6
        return self.vb(x)

    fn ab_disp(self, f: &Fun, v: int) => int:
        let x = self.res(f, v)
        if f.op[x] == int(Op.Undef):
            return 0
        return 0 - self.voff[x]

    /#/ n bytes from [sb + sd] to [db + dd], through rax.
    fn copy_mem(self, db: int, dd: int, sb: int, sd: int, n: int) => void:
        let k = 0
        while k + 8 <= n:
            self.a.load(0, sb, sd + k, 8)
            self.a.store(db, dd + k, 0, 8)
            k = k + 8
        if k + 4 <= n:
            self.a.load(0, sb, sd + k, 4)
            self.a.store(db, dd + k, 0, 4)
            k = k + 4
        if k + 2 <= n:
            self.a.load(0, sb, sd + k, 2)
            self.a.store(db, dd + k, 0, 2)
            k = k + 2
        if k < n:
            self.a.load(0, sb, sd + k, 1)
            self.a.store(db, dd + k, 0, 1)

    /#/ Value `v` to [db + dd], in full: a scalar as 8 bytes, an aggregate as its layout.
    fn val_to(self, f: &Fun, rs: &Reps, db: int, dd: int, v: int) => void:
        let x = self.res(f, v)
        let r = f.rep[x]
        if r >= rp_first_agg():
            let sb = self.ab_reg(f, x)
            self.copy_mem(db, dd, sb, self.ab_disp(f, x), rsize(rs, r))
        elif self.home[x] >= 0:
            self.a.store(db, dd, self.home[x], 8)
        else:
            self.ld(0, f, x)
            self.a.store(db, dd, 0, 8)

    /#/ ---- registers -----------------------------------------------------------

    /#/ The saved registers come back by pop, from below the frame's locals.
    fn epilogue(self) => void:
        if self.sframe > 0:
            self.a.add_ri(14, self.sframe)
        if self.nsaved > 0:
            if self.frame > 8 + 8 * self.nsaved:
                self.a.lea(4, 5, 0 - 8 - 8 * self.nsaved)
            let k = self.nsaved - 1
            while k >= 0:
                self.a.pop(self.saved[k])
                k = k - 1
        self.a.leave()
        self.a.ret()

    /#/ Can value `v` live in a register? Scalars made by instructions or block parameters.
    fn wants_reg(self, f: &Fun, v: int) => bool:
        if f.fwd[v] >= 0:
            return false
        let r = f.rep[v]
        if r == int(Rp.Void) || r >= rp_first_agg():
            return false
        let op = f.op[v]
        return !(op == int(Op.Slot) || op == int(Op.Const) || op == int(Op.StrLit) || op == int(Op.Undef) || op == int(Op.OwnMove))

    /#/ Does instruction `i` make a call (so that the registers a callee may write are lost)?
    fn is_clobber(self, f: &Fun, i: int) => bool:
        let op = f.op[i]
        if self.uses_rdi(f, i):
            return true
        return op == int(Op.Call) || op == int(Op.CCall) || op == int(Op.CallI) || op == int(Op.Drop) || op == int(Op.Clone) || op == int(Op.Alloc) || op == int(Op.Free) || op == int(Op.FRem)

    /#/ Does instruction `i` use rdi as a scratch register (the aggregate store and return)?
    fn uses_rdi(self, f: &Fun, i: int) => bool:
        let op = f.op[i]
        if op == int(Op.Store) && f.rep[self.res(f, f.b[i])] >= rp_first_agg():
            return true
        return op == int(Op.Ret) && f.a[i] >= 0 && f.rep[self.res(f, f.a[i])] >= rp_first_agg()

    /#/ The caller-saved registers that the call `i` may write: all of them unless it is a call of a
    /#/ function of this object that was generated before (then what that one writes), and r8 and r9
    /#/ when its arguments go through them.
    fn site_mask(self, f: &Fun, i: int) => int:
        if self.uses_rdi(f, i):
            return 16
        if f.op[i] != int(Op.Call):
            return 31
        let id = f.aux[i]
        let m = 31
        if id >= 0 && id < len(self.msk) && self.msk[id] > 0:
            m = self.msk[id] - 8
        if f.b[i] >= 5:
            m = m | 2
        if f.b[i] >= 6:
            m = m | 4
        if f.rep[i] >= rp_first_agg():
            m = m | 2
        if f.b[i] >= 1 || f.rep[i] >= rp_first_agg():
            m = m | 16
        return m

    /#/ The registers written by the calls strictly between positions `lo` and `hi`.
    fn cm_in(self, lo: int, hi: int) => int:
        let a = 0
        let b = self.ra_ncp
        while a < b:
            let mid = (a + b) // 2
            if self.ra_cp[mid] > lo:
                b = mid
            else:
                a = mid + 1
        let m = 0
        while a < self.ra_ncp && self.ra_cp[a] < hi:
            m = m | self.ra_cm[a]
            a = a + 1
        return m

    /#/ May a value that lives across calls writing `cm` and (`restr`) is a parameter or an argument
    /#/ take register number `r` of the pool?
    fn reg_ok(self, r: int, cm: int, restr: bool) => bool:
        if self.a.sbx && r == 8:
            return false
        if r >= 5:
            return true
        if ((cm >> r) & 1) == 1:
            return false
        return r == 0 || !restr

    /#/ Is there a call strictly between positions `lo` and `hi`?
    fn crosses(self, lo: int, hi: int) => bool:
        let a = 0
        let b = self.ra_ncp
        while a < b:
            let mid = (a + b) // 2
            if self.ra_cp[mid] > lo:
                b = mid
            else:
                a = mid + 1
        return a < self.ra_ncp && self.ra_cp[a] < hi

    /#/ Counts the uses of every value of `f`, through forwarding and `own.move`.
    fn count_uses(self, f: &Fun) => void:
        if len(self.nuse) < f.ni + 1:
            self.nuse = new_buf(int, f.ni + 1)
        for v in 0..f.ni + 1:
            self.nuse[v] = 0
        for b in 0..f.nb:
            let i = f.bfirst[b]
            while i >= 0:
                for k in 0..f.nval(i):
                    let v = f.val_at(i, k)
                    if v >= 0:
                        let x = self.res(f, v)
                        self.nuse[x] = self.nuse[x] + 1
                i = f.nx[i]
        for e in 0..f.ne:
            if f.eto[e] >= 0:
                for k in 0..f.eargn[e]:
                    let x = self.res(f, f.pool[f.eargs[e] + k])
                    self.nuse[x] = self.nuse[x] + 1

    /#/ Is `x`, an `index` or a `field`, only the address of the scalar `load` or `store` right
    /#/ after it? Then the access uses the address mode and `x` makes no code of its own.
    fn folds(self, f: &Fun, x: int) => bool:
        let op = f.op[x]
        if op != int(Op.Index) && op != int(Op.Field):
            return false
        if self.nuse[x] != 1 || f.fwd[x] >= 0:
            return false
        if op == int(Op.Index):
            let sz = f.aux[x]
            if sz != 1 && sz != 2 && sz != 4 && sz != 8:
                return false
        let u = f.nx[x]
        if u < 0:
            return false
        if f.op[u] == int(Op.Load):
            return self.res(f, f.a[u]) == x && f.rep[u] < rp_first_agg()
        if f.op[u] == int(Op.Store):
            let v = self.res(f, f.b[u])
            return self.res(f, f.a[u]) == x && v != x && f.rep[v] < rp_first_agg()
        return false

    /#/ The address of the folded `x` as base, index, scale and displacement in `am_*`; what is not
    /#/ in a register of its own is loaded into `s1` (the base) and `s2` (the index).
    fn addr_of(self, f: &Fun, x: int, s1: int, s2: int) => void:
        self.am_base = self.src(f, f.a[x], s1)
        if f.op[x] == int(Op.Index) && self.near_const(f, f.b[x]):
            self.am_idx = -1
            self.am_scale = 1
            self.am_disp = f.aux[self.res(f, f.b[x])] * f.aux[x]
        elif f.op[x] == int(Op.Index):
            self.am_idx = self.src(f, f.b[x], s2)
            self.am_scale = f.aux[x]
            self.am_disp = 0
        else:
            self.am_idx = -1
            self.am_scale = 1
            self.am_disp = f.aux[x]

    /#/ Does a call stand at position `p`?
    fn at_call(self, p: int) => bool:
        let a = 0
        let b = self.ra_ncp
        while a < b:
            let mid = (a + b) // 2
            if self.ra_cp[mid] >= p:
                b = mid
            else:
                a = mid + 1
        return a < self.ra_ncp && self.ra_cp[a] == p

    /#/ The edges leaving block `b`, in `ed`.
    fn term_edges(self, f: &Fun, b: int) => void:
        self.ned = 0
        let t = f.blast[b]
        if t < 0:
            return
        let op = f.op[t]
        if op == int(Op.Br):
            self.add_edge(f.aux[t])
        elif op == int(Op.CondBr):
            self.add_edge(f.b[t])
            self.add_edge(f.c[t])
        elif op == int(Op.Switch):
            for k in 0..f.b[t]:
                self.add_edge(f.pool[f.aux[t] + k * 2 + 1])
            self.add_edge(f.c[t])

    fn add_edge(self, e: int) => void:
        if self.ned >= len(self.ed):
            self.ed = buf_resize(self.ed, (self.ned + 1) * 2)
        self.ed[self.ned] = e
        self.ned = self.ned + 1

    /#/ Chooses a register for the values that deserve one: `home` of every value (-1 for the frame).
    /#/ Live ranges are single intervals of the block order, made from the liveness of every block.
    fn alloc_regs(self, f: &Fun, rs: &Reps) => void:
        let n = f.ni
        if len(self.home) < n + 1:
            self.home = new_buf(int, n + 1)
            self.xhome = new_buf(int, n + 1)
            self.xsg = new_buf(int, n + 1)
            self.did = new_buf(int, n + 1)
        for v in 0..n:
            self.home[v] = -1
            self.xhome[v] = -1
            self.xsg[v] = 0
            self.did[v] = -1
        self.nsaved = 0
        self.ra_ncp = 0
        self.fmask = 31
        let bs: buf<int> = new_buf(int, f.nb + 1)
        let be: buf<int> = new_buf(int, f.nb + 1)
        let depth: buf<int> = new_buf(int, f.nb + 1)
        /#/ loop depth: a back edge (to a block not after its source in the order of the code) wraps the
        /#/ blocks between
        let at: buf<int> = new_buf(int, f.nb + 1)
        for oi in 0..f.nb:
            at[self.ord[oi]] = oi
        for b in 0..f.nb:
            self.term_edges(f, b)
            for k in 0..self.ned:
                let t = f.eto[self.ed[k]]
                if t >= 0 && at[t] <= at[b]:
                    for q in at[t]..at[b] + 1:
                        depth[self.ord[q]] = depth[self.ord[q]] + 1
        /#/ dense numbers, positions: uses at even numbers, definitions after them
        let nd = 0
        for b in 0..f.nb:
            let p = f.pfirst[b]
            while p >= 0:
                if self.wants_reg(f, p):
                    self.did[p] = nd
                    nd = nd + 1
                p = f.nx[p]
            let i = f.bfirst[b]
            while i >= 0:
                if self.wants_reg(f, i):
                    self.did[i] = nd
                    nd = nd + 1
                i = f.nx[i]
        self.nhc = 0
        /#/ a float constant used inside a loop is loaded once, at the entry (when the entry is no loop)
        let entry_ok = self.ord[0] == 0
        for b in 0..f.nb:
            self.term_edges(f, b)
            for k in 0..self.ned:
                if f.eto[self.ed[k]] == 0:
                    entry_ok = false
        if entry_ok:
            for b in 0..f.nb:
                if depth[b] == 0:
                    continue
                let i = f.bfirst[b]
                while i >= 0:
                    for k in 0..f.nval(i):
                        nd = self.hoist_const(f, f.val_at(i, k), nd)
                    i = f.nx[i]
                self.term_edges(f, b)
                for k in 0..self.ned:
                    let e = self.ed[k]
                    for j in 0..f.eargn[e]:
                        nd = self.hoist_const(f, f.pool[f.eargs[e] + j], nd)
        if nd == 0:
            return
        let dv: buf<int> = new_buf(int, nd + 1)
        self.ra_lo = new_buf(int, nd + 1)
        self.ra_hi = new_buf(int, nd + 1)
        self.ra_wt = new_buf(int, nd + 1)
        self.ra_dblk = new_buf(int, nd + 1)
        self.ra_dset = new_buf(int, nd + 1)
        self.nuq = 0
        for d in 0..nd:
            self.ra_lo[d] = 1000000000
            self.ra_hi[d] = -1
        self.fmask = 0
        let pos = 0
        for oi in 0..f.nb:
            let b = self.ord[oi]
            bs[b] = pos + 1
            let p = f.pfirst[b]
            let w = 1
            for q in 0..depth[b]:
                if w < 4096:
                    w = w * 8
            while p >= 0:
                let d = self.did[p]
                if d >= 0:
                    dv[d] = p
                    self.ra_dblk[d] = b
                    self.ra_lo[d] = pos + 1
                    self.ra_hi[d] = pos + 1
                    self.ra_wt[d] = self.ra_wt[d] + w
                p = f.nx[p]
            pos = pos + 2
            let i = f.bfirst[b]
            be[b] = bs[b]
            while i >= 0:
                be[b] = pos
                if self.is_clobber(f, i):
                    if self.ra_ncp >= len(self.ra_cp):
                        self.ra_cp = buf_resize(self.ra_cp, (self.ra_ncp + 1) * 2)
                    if self.ra_ncp >= len(self.ra_cm):
                        self.ra_cm = buf_resize(self.ra_cm, (self.ra_ncp + 1) * 2)
                    self.ra_cp[self.ra_ncp] = pos
                    self.ra_cm[self.ra_ncp] = self.site_mask(f, i)
                    self.fmask = self.fmask | self.ra_cm[self.ra_ncp]
                    self.ra_ncp = self.ra_ncp + 1
                let d = self.did[i]
                if d >= 0:
                    dv[d] = i
                    self.ra_dblk[d] = b
                    self.ra_lo[d] = pos + 1
                    self.ra_hi[d] = pos + 1
                    self.ra_wt[d] = self.ra_wt[d] + w
                i = f.nx[i]
                pos = pos + 2
        for k in 0..self.nhc:
            let c = self.hc[k]
            let d = self.did[c]
            dv[d] = c
            self.ra_dblk[d] = 0
            self.ra_lo[d] = bs[0]
            self.ra_hi[d] = bs[0]
            self.ra_dset[d] = 1
        /#/ the uses: those of a value not defined (yet) in the block they are in make it live into the block
        for b in 0..f.nb:
            let w = 1
            for q in 0..depth[b]:
                if w < 4096:
                    w = w * 8
            let p = f.pfirst[b]
            while p >= 0:
                if self.did[p] >= 0:
                    self.ra_dset[self.did[p]] = 1
                p = f.nx[p]
            let i = f.bfirst[b]
            let ip = bs[b] + 1
            while i >= 0:
                for k in 0..f.nval(i):
                    self.note_use(f, f.val_at(i, k), b, ip, w)
                let d = self.did[i]
                if d >= 0:
                    self.ra_dset[d] = 1
                i = f.nx[i]
                ip = ip + 2
            self.term_edges(f, b)
            for k in 0..self.ned:
                let e = self.ed[k]
                for j in 0..f.eargn[e]:
                    self.note_use(f, f.pool[f.eargs[e] + j], b, be[b], w)
        /#/ liveness: from each such use walk back over the predecessors up to the block of the definition;
        /#/ the blocks walked are the ones the value is live into, their predecessors the ones it is live
        /#/ out of. The ranges cover those. `lvs`/`lve` bound each value's blocks in `lvb`.
        let pc: buf<int> = new_buf(int, f.nb + 2)
        for b in 0..f.nb:
            self.term_edges(f, b)
            for k in 0..self.ned:
                let t = f.eto[self.ed[k]]
                if t >= 0:
                    pc[t + 1] = pc[t + 1] + 1
        for b in 0..f.nb:
            pc[b + 1] = pc[b + 1] + pc[b]
        let pred: buf<int> = new_buf(int, pc[f.nb] + 1)
        let pfill: buf<int> = new_buf(int, f.nb + 1)
        for b in 0..f.nb:
            self.term_edges(f, b)
            for k in 0..self.ned:
                let t = f.eto[self.ed[k]]
                if t >= 0:
                    pred[pc[t] + pfill[t]] = b
                    pfill[t] = pfill[t] + 1
        /#/ the uses by value
        let uc: buf<int> = new_buf(int, nd + 2)
        for q in 0..self.nuq:
            uc[self.uq_d[q] + 1] = uc[self.uq_d[q] + 1] + 1
        for d in 0..nd:
            uc[d + 1] = uc[d + 1] + uc[d]
        let ub: buf<int> = new_buf(int, self.nuq + 1)
        let ufill: buf<int> = new_buf(int, nd + 1)
        for q in 0..self.nuq:
            let d = self.uq_d[q]
            ub[uc[d] + ufill[d]] = self.uq_b[q]
            ufill[d] = ufill[d] + 1
        let inm: buf<int> = new_buf(int, f.nb + 1)
        let stack: buf<int> = new_buf(int, f.nb + 1)
        let lvb: buf<int> = new_buf(int, 64)
        let nlv = 0
        let lvs: buf<int> = new_buf(int, nd + 1)
        let lve: buf<int> = new_buf(int, nd + 1)
        for d in 0..nd:
            lvs[d] = nlv
            let stamp = d + 1
            let db = self.ra_dblk[d]
            for q in uc[d]..uc[d + 1]:
                let u = ub[q]
                if inm[u] == stamp || u == db:
                    continue
                let sp = 0
                stack[0] = u
                sp = 1
                inm[u] = stamp
                while sp > 0:
                    sp = sp - 1
                    let x = stack[sp]
                    if nlv >= len(lvb):
                        lvb = buf_resize(lvb, (nlv + 1) * 2)
                    lvb[nlv] = x
                    nlv = nlv + 1
                    if bs[x] < self.ra_lo[d]:
                        self.ra_lo[d] = bs[x]
                    if bs[x] > self.ra_hi[d]:
                        self.ra_hi[d] = bs[x]
                    for r in pc[x]..pc[x + 1]:
                        let pb = pred[r]
                        if be[pb] + 1 > self.ra_hi[d]:
                            self.ra_hi[d] = be[pb] + 1
                        if be[pb] + 1 < self.ra_lo[d]:
                            self.ra_lo[d] = be[pb] + 1
                        if pb != db && inm[pb] != stamp:
                            inm[pb] = stamp
                            stack[sp] = pb
                            sp = sp + 1
            lve[d] = nlv
        /#/ coalescing: a value computed in block `b` and passed on a back edge to the parameter `p` may
        /#/ take p's register when p is not read after it (in `b`, or in what follows `b`) and the value
        /#/ does not leave `b`; their ranges overlap only because p stays alive on its other paths
        let coal: buf<int> = new_buf(int, nd + 1)
        for d in 0..nd:
            coal[d] = -1
        for b in 0..f.nb:
            self.term_edges(f, b)
            for k in 0..self.ned:
                let e = self.ed[k]
                let t = f.eto[e]
                if t < 0 || at[t] > at[b]:
                    continue
                let pp = f.pfirst[t]
                for j in 0..f.eargn[e]:
                    let x = self.res(f, f.pool[f.eargs[e] + j])
                    let dx = self.did[x]
                    let dp = self.did[pp]
                    if dx >= 0 && dp >= 0 && f.op[x] != int(Op.Param) && f.blk[x] == b && coal[dx] < 0:
                        let ok = !self.live_out_of(f, b, dx, &lvb, &lvs, &lve)
                        if self.live_out_of(f, b, dp, &lvb, &lvs, &lve):
                            ok = false
                        let i = f.nx[x]
                        while ok && i >= 0:
                            for q in 0..f.nval(i):
                                if f.val_at(i, q) >= 0 && self.res(f, f.val_at(i, q)) == pp:
                                    ok = false
                            i = f.nx[i]
                        for k2 in 0..self.ned:
                            let e2 = self.ed[k2]
                            for j2 in 0..f.eargn[e2]:
                                if self.res(f, f.pool[f.eargs[e2] + j2]) == pp:
                                    ok = false
                        if ok:
                            coal[dx] = dp
                    pp = f.nx[pp]
        /#/ what a register is worth to a value: its uses (weighted by loop depth) per position of its range
        let dn: buf<int> = new_buf(int, nd + 1)
        for d in 0..nd:
            dn[d] = self.ra_wt[d] * 1024 // (self.ra_hi[d] - self.ra_lo[d] + 2)
        /#/ linear scan, by start
        let top = pos + 4
        let first: buf<int> = new_buf(int, top + 1)
        let link: buf<int> = new_buf(int, nd + 1)
        for q in 0..top + 1:
            first[q] = -1
        let sd = nd - 1
        while sd >= 0:
            link[sd] = first[self.ra_lo[sd]]
            first[self.ra_lo[sd]] = sd
            sd = sd - 1
        /#/ the caller-saved registers first (r10, then r8 and r9, the registers of the fifth and sixth
        /#/ argument), then the saved ones
        let regs: buf<int> = new_buf(int, 10)
        regs[0] = 10
        regs[1] = 8
        regs[2] = 9
        regs[3] = 11
        regs[4] = 7
        regs[5] = 3
        regs[6] = 12
        regs[7] = 13
        regs[8] = 14
        regs[9] = 15
        let ent: buf<int> = new_buf(int, nd + 1)
        let ep = f.pfirst[0]
        while ep >= 0:
            if self.did[ep] >= 0:
                ent[self.did[ep]] = 1
            ep = f.nx[ep]
        for k in 0..self.nhc:
            ent[self.did[self.hc[k]]] = 1
        let occ: buf<int> = new_buf(int, 10)
        for r in 0..10:
            occ[r] = -1
        let used: buf<int> = new_buf(int, 10)
        /#/ the xmm registers 2 to 15 for floats that are not alive across a call (all are caller-saved);
        /#/ the arguments are loaded into xmm0 to xmm7, so a parameter or an argument stays in 8 to 15
        let occx: buf<int> = new_buf(int, 16)
        for r in 0..16:
            occx[r] = -1
        for q in 0..top + 1:
            let cd = first[q]
            while cd >= 0:
                let d = cd
                let nxt = link[d]
                let fr_x = -1
                let rd = f.rep[dv[d]]
                if (rd == int(Rp.F32) || rd == int(Rp.F64)) && !self.crosses(self.ra_lo[d], self.ra_hi[d]):
                    let lowx = 2
                    if ent[d] == 1 || self.at_call(self.ra_hi[d]):
                        lowx = 8
                    for r in 2..16:
                        if occx[r] >= 0 && self.ra_hi[occx[r]] < self.ra_lo[d]:
                            occx[r] = -1
                    for r in lowx..16:
                        if occx[r] < 0 && fr_x < 0:
                            fr_x = r
                    if fr_x >= 0:
                        occx[fr_x] = d
                        self.xhome[dv[d]] = fr_x
                        if rd == int(Rp.F32):
                            self.xsg[dv[d]] = 1
                        cd = nxt
                        continue
                /#/ which of the caller-saved registers `d` may take: not one that a call it is alive
                /#/ across may write; only r10 when it is an argument of the call it ends at or a
                /#/ parameter of the function (loading the arguments or the parameters would overwrite it)
                let cm = self.cm_in(self.ra_lo[d], self.ra_hi[d])
                let restr = ent[d] == 1 || self.at_call(self.ra_hi[d])
                for r in 0..10:
                    if occ[r] >= 0 && self.ra_hi[occ[r]] < self.ra_lo[d]:
                        occ[r] = -1
                let fr = -1
                /#/ the hint: the register of the first operand when it ends where `d` begins
                let hint = self.hint_reg(f, dv[d])
                let shared = -1
                if coal[d] >= 0 && self.home[dv[coal[d]]] >= 0 && self.ra_lo[coal[d]] < self.ra_lo[d]:
                    for r in 0..10:
                        if regs[r] == self.home[dv[coal[d]]] && occ[r] == coal[d] && self.reg_ok(r, cm, restr):
                            shared = r
                if shared >= 0:
                    fr = shared
                if hint >= 0 && fr < 0:
                    for r in 0..10:
                        if regs[r] == hint && occ[r] < 0 && self.reg_ok(r, cm, restr):
                            fr = r
                for r in 0..10:
                    if occ[r] < 0 && fr < 0 && self.reg_ok(r, cm, restr):
                        fr = r
                if fr >= 0:
                    if shared < 0 || self.ra_hi[d] > self.ra_hi[occ[fr]]:
                        occ[fr] = d
                    self.home[dv[d]] = regs[fr]
                    used[fr] = 1
                else:
                    /#/ the least wanted of the live ones and this one goes to the frame
                    let worst = -1
                    for r in 0..10:
                        if self.reg_ok(r, cm, restr):
                            if worst < 0 || dn[occ[r]] < dn[occ[worst]]:
                                worst = r
                    if dn[occ[worst]] < dn[d]:
                        self.home[dv[occ[worst]]] = -1
                        self.home[dv[d]] = regs[worst]
                        occ[worst] = d
                cd = nxt
        /#/ the check: nothing in a caller-saved register is alive across a call, and r8 and r9
        /#/ hold neither a parameter nor an argument of the call that ends the value
        for d in 0..nd:
            let h = self.home[dv[d]]
            if h == 7 || h == 8 || h == 9 || h == 10 || h == 11:
                let bit = 0
                if h == 8:
                    bit = 1
                elif h == 9:
                    bit = 2
                elif h == 11:
                    bit = 3
                elif h == 7:
                    bit = 4
                if ((self.cm_in(self.ra_lo[d], self.ra_hi[d]) >> bit) & 1) == 1:
                    self.err = 1
                if h != 10 && (ent[d] == 1 || self.at_call(self.ra_hi[d])):
                    self.err = 1
        for d in 0..nd:
            let xh = self.xhome[dv[d]]
            if xh >= 0:
                if self.crosses(self.ra_lo[d], self.ra_hi[d]) || xh < 2:
                    self.err = 1
                if xh < 8 && (ent[d] == 1 || self.at_call(self.ra_hi[d])):
                    self.err = 1
        /#/ what this function may write: the registers of its calls, and its own caller-saved homes
        for r in 0..5:
            if used[r] == 1:
                self.fmask = self.fmask | (1 << r)
        if len(self.saved) < 6:
            self.saved = new_buf(int, 8)
        for r in 0..10:
            if used[r] == 1 && r >= 5:
                self.saved[self.nsaved] = regs[r]
                self.nsaved = self.nsaved + 1

    /#/ For an instruction that computes into its first operand's register (two-address): the
    /#/ register that operand has, else -1.
    fn hint_reg(self, f: &Fun, v: int) => int:
        let op = f.op[v]
        if op == int(Op.Add) || op == int(Op.Sub) || op == int(Op.Mul) || op == int(Op.And) || op == int(Op.Or) || op == int(Op.Xor) || op == int(Op.Shl) || op == int(Op.AShr) || op == int(Op.LShr) || op == int(Op.Neg) || op == int(Op.Not):
            if f.a[v] >= 0:
                return self.home[self.res(f, f.a[v])]
            return -1
        if op == int(Op.Trunc) || op == int(Op.Bitcast) || op == int(Op.PtrToInt) || op == int(Op.IntToPtr) || op == int(Op.SExt) || op == int(Op.ZExt):
            if f.a[v] >= 0:
                return self.home[self.res(f, f.a[v])]
        return -1

    /#/ Give the float constant `v` a number as a value to keep in a register, once; returns the new count.
    fn hoist_const(self, f: &Fun, v: int, nd: int) => int:
        if v < 0:
            return nd
        let x = self.res(f, v)
        if f.op[x] != int(Op.Const) || self.did[x] >= 0:
            return nd
        if f.rep[x] != int(Rp.F64) && f.rep[x] != int(Rp.F32):
            return nd
        if self.nhc >= len(self.hc):
            self.hc = buf_resize(self.hc, (self.nhc + 1) * 2)
        self.hc[self.nhc] = x
        self.nhc = self.nhc + 1
        self.did[x] = nd
        return nd + 1

    fn note_use(self, f: &Fun, v: int, b: int, p: int, w: int) => void:
        if v < 0:
            return
        let x = self.res(f, v)
        let d = self.did[x]
        if d < 0:
            return
        self.ra_wt[d] = self.ra_wt[d] + w
        if p < self.ra_lo[d]:
            self.ra_lo[d] = p
        if p > self.ra_hi[d]:
            self.ra_hi[d] = p
        if self.ra_dset[d] == 1 && self.ra_dblk[d] == b:
            return
        if self.nuq >= len(self.uq_d):
            self.uq_d = buf_resize(self.uq_d, (self.nuq + 1) * 2)
            self.uq_b = buf_resize(self.uq_b, (self.nuq + 1) * 2)
        self.uq_d[self.nuq] = d
        self.uq_b[self.nuq] = b
        self.nuq = self.nuq + 1

    /#/ Is value `d` live out of block `b`: live into one of its successors?
    fn live_out_of(self, f: &Fun, b: int, d: int, lvb: &buf<int>, lvs: &buf<int>, lve: &buf<int>) => bool:
        self.term_edges(f, b)
        for k in 0..self.ned:
            let t = f.eto[self.ed[k]]
            if t >= 0:
                for q in lvs[d]..lve[d]:
                    if lvb[q] == t:
                        return true
        return false

    /#/ ---- frame -------------------------------------------------------------

    fn place_size(self, rs: &Reps, r: int) => int:
        let s = round8(rsize(rs, r))
        if s < 8:
            return 8
        return s

    /#/ Gives every value its place; the size of the frame.
    fn layout(self, f: &Fun, rs: &Reps) => void:
        if len(self.voff) < f.ni + 1:
            self.voff = new_buf(int, f.ni + 1)
            self.sh = new_buf(int, f.ni + 1)
        for v in 0..f.ni:
            self.sh[v] = 0
        let sbx = self.a.sbx
        /#/ sandbox code keeps aggregates and the slots whose address is taken in the shadow frame, in
        /#/ the linear memory: a pointer to them is an offset like any other, and the host stack holds
        /#/ only what the code cannot name (return addresses, saved registers, spilled scalars)
        let scur = 0
        let cur = 8 + 8 * self.nsaved
        let tmp = 0
        for b in 0..f.nb:
            let p = f.pfirst[b]
            while p >= 0:
                if self.home[p] < 0 && self.xhome[p] < 0:
                    if sbx && f.rep[p] >= rp_first_agg():
                        self.voff[p] = 0 - scur
                        self.sh[p] = 1
                        scur = scur + self.place_size(rs, f.rep[p])
                    else:
                        cur = cur + self.place_size(rs, f.rep[p])
                        self.voff[p] = cur
                p = f.nx[p]
            let i = f.bfirst[b]
            while i >= 0:
                let op = f.op[i]
                if op == int(Op.Slot):
                    let sz = round8(f.ty[i])
                    if f.ty[i] < 1:
                        sz = sz + 8
                    if sbx:
                        self.voff[i] = 0 - scur
                        self.sh[i] = 1
                        scur = scur + sz
                    else:
                        cur = cur + sz
                        self.voff[i] = cur
                elif f.rep[i] != int(Rp.Void) && op != int(Op.OwnMove) && self.home[i] < 0 && self.xhome[i] < 0:
                    if sbx && f.rep[i] >= rp_first_agg():
                        self.voff[i] = 0 - scur
                        self.sh[i] = 1
                        scur = scur + self.place_size(rs, f.rep[i])
                    else:
                        cur = cur + self.place_size(rs, f.rep[i])
                        self.voff[i] = cur
                i = f.nx[i]
        for e in 0..f.ne:
            if f.eto[e] >= 0:
                let sum = 0
                for k in 0..f.eargn[e]:
                    sum = sum + self.place_size(rs, f.rep[self.res(f, f.pool[f.eargs[e] + k])])
                if sum > tmp:
                    tmp = sum
        cur = cur + tmp
        self.tmp = cur
        self.frame = (cur + 15) // 16 * 16
        self.sframe = (scur + 15) // 16 * 16
        /#/ a frame larger than the guard below the shadow stack could be stepped over
        if self.sframe > 32768:
            self.err = 1

    /#/ ---- edges -------------------------------------------------------------

    /#/ Copies what edge `e` passes into the parameters of the block it enters; through a scratch
    /#/ area when an argument is itself a parameter of that block (the copies are simultaneous).
    fn edge_copy(self, f: &Fun, rs: &Reps, e: int) => void:
        let to = f.eto[e]
        let n = f.eargn[e]
        if n == 0:
            return
        let hazard = false
        let pj = f.pfirst[to]
        for k in 0..n:
            let x = self.res(f, f.pool[f.eargs[e] + k])
            if f.op[x] == int(Op.Param) && f.blk[x] == to:
                hazard = true
            /#/ a parameter already written must not be what a later argument reads
            let hx = self.hid(x)
            if hx >= 0:
                let q = f.pfirst[to]
                for j in 0..k:
                    if self.hid(q) == hx:
                        hazard = true
                    q = f.nx[q]
        if !hazard:
            let p = f.pfirst[to]
            for k in 0..n:
                if self.home[p] >= 0:
                    self.ld(self.home[p], f, f.pool[f.eargs[e] + k])
                elif self.xhome[p] >= 0:
                    let ax = self.res(f, f.pool[f.eargs[e] + k])
                    if self.xhome[ax] >= 0:
                        if self.xhome[ax] != self.xhome[p]:
                            self.a.movaps(self.xhome[p], self.xhome[ax])
                    else:
                        self.ld(0, f, ax)
                        self.st(p, 0)
                else:
                    self.val_to(f, rs, self.vb(p), 0 - self.voff[p], f.pool[f.eargs[e] + k])
                p = f.nx[p]
            return
        /#/ every parameter in a register: the copies as a sequence of moves, each after the ones that read
        /#/ its register; a cycle goes through rcx (general) or xmm0 (floats)
        let allreg = true
        let pp = f.pfirst[to]
        for k in 0..n:
            if self.home[pp] < 0 && self.xhome[pp] < 0:
                allreg = false
            pp = f.nx[pp]
        if allreg:
            self.edge_moves(f, e)
            return
        let at = 0
        for k in 0..n:
            let v = f.pool[f.eargs[e] + k]
            self.val_to(f, rs, 5, 0 - self.tmp + at, v)
            at = at + self.place_size(rs, f.rep[self.res(f, v)])
        let p = f.pfirst[to]
        at = 0
        for k in 0..n:
            let sz = self.place_size(rs, f.rep[p])
            if self.home[p] >= 0:
                self.a.load(self.home[p], 5, 0 - self.tmp + at, 8)
            elif self.xhome[p] >= 0:
                self.a.load(0, 5, 0 - self.tmp + at, 8)
                self.st(p, 0)
            else:
                self.copy_mem(self.vb(p), 0 - self.voff[p], 5, 0 - self.tmp + at, sz)
            at = at + sz
            p = f.nx[p]

    /#/ The register a move reads, as `hid` numbers it; -1 when it reads a constant, an address or the frame.
    fn move_src(self, f: &Fun, x: int) => int:
        let k = f.op[x]
        if k == int(Op.Const) || k == int(Op.Undef) || k == int(Op.StrLit) || k == int(Op.Slot):
            return -1
        return self.hid(x)

    /#/ The simultaneous copies of edge `e` into the parameters (all in registers) as moves in an order
    /#/ where no move overwrites what a later one reads; a cycle is broken through a scratch register.
    fn edge_moves(self, f: &Fun, e: int) => void:
        let to = f.eto[e]
        let n = f.eargn[e]
        let pd: buf<int> = new_buf(int, n + 1)
        let pa: buf<int> = new_buf(int, n + 1)
        let ps: buf<int> = new_buf(int, n + 1)
        let done: buf<int> = new_buf(int, n + 1)
        let p = f.pfirst[to]
        for k in 0..n:
            pd[k] = p
            pa[k] = self.res(f, f.pool[f.eargs[e] + k])
            ps[k] = self.move_src(f, pa[k])
            p = f.nx[p]
        let left = n
        while left > 0:
            let progress = false
            for k in 0..n:
                if done[k] == 0:
                    let d = self.hid(pd[k])
                    let blocked = false
                    for j in 0..n:
                        if j != k && done[j] == 0 && ps[j] == d:
                            blocked = true
                    if !blocked:
                        self.emit_move(f, pd[k], pa[k], ps[k])
                        done[k] = 1
                        left = left - 1
                        progress = true
            if !progress:
                /#/ a cycle: some pending move reads a register that another pending move writes
                let s = -1
                for k in 0..n:
                    if done[k] == 0 && s < 0:
                        let d = self.hid(pd[k])
                        for j in 0..n:
                            if j != k && done[j] == 0 && ps[j] == d && s < 0:
                                s = d
                if s < 32:
                    self.a.mov_rr(1, s)
                else:
                    self.a.movaps(0, s - 32)
                for j in 0..n:
                    if done[j] == 0 && ps[j] == s:
                        if s < 32:
                            ps[j] = -2
                        else:
                            ps[j] = -3

    /#/ One move: parameter `p` from the value `ax` (which sits in the register numbered `src`, or -2 / -3
    /#/ when that was copied to rcx / xmm0).
    fn emit_move(self, f: &Fun, p: int, ax: int, src: int) => void:
        if self.home[p] >= 0:
            if src == -2:
                self.a.mov_rr(self.home[p], 1)
            elif src == -3:
                self.a.movq_r(self.home[p], 0, self.xsg[ax] == 1)
            else:
                self.ld(self.home[p], f, ax)
        else:
            if src == -3:
                self.a.movaps(self.xhome[p], 0)
            elif src == -2:
                self.st(p, 1)
            elif self.xhome[ax] >= 0 && src >= 32:
                if self.xhome[ax] != self.xhome[p]:
                    self.a.movaps(self.xhome[p], self.xhome[ax])
            else:
                self.ld(0, f, ax)
                self.st(p, 0)

    /#/ A number for the register of `x`, general ones as they are and xmm ones from 32; -1 in the frame.
    fn hid(self, x: int) => int:
        if self.home[x] >= 0:
            return self.home[x]
        if self.xhome[x] >= 0:
            return 32 + self.xhome[x]
        return -1

    /#/ ---- calls -------------------------------------------------------------

    fn is_int_class(self, r: int) => bool:
        return r != int(Rp.F32) && r != int(Rp.F64)

    /#/ The call to the symbol `sym` (or the address in r11 when `sym` < 0) with the values queued
    /#/ in `av`; the result of instruction `i` is stored.
    fn do_call(self, f: &Fun, rs: &Reps, i: int, sym: int, variadic: bool) => void:
        let ret = f.rep[i]
        let sret = ret >= rp_first_agg()
        /#/ which arguments go on the stack
        let ni = 0
        let nx = 0
        if sret:
            ni = 1
        let on_stack = 0
        for k in 0..self.nav:
            let r = f.rep[self.res(f, self.av[k])]
            if r >= rp_first_agg() || self.is_int_class(r):
                if ni < 6:
                    ni = ni + 1
                else:
                    on_stack = on_stack + 1
            elif nx < 8:
                nx = nx + 1
            else:
                on_stack = on_stack + 1
        if on_stack % 2 == 1:
            self.a.sub_ri(4, 8)
        /#/ the stack arguments, last first
        let k = self.nav - 1
        while k >= 0:
            let r = f.rep[self.res(f, self.av[k])]
            let reg_ok = false
            /#/ recompute whether this one fits in a register: count the ones before it
            let ci = 0
            if sret:
                ci = 1
            let cx = 0
            for j in 0..k:
                let rj = f.rep[self.res(f, self.av[j])]
                if rj >= rp_first_agg() || self.is_int_class(rj):
                    ci = ci + 1
                else:
                    cx = cx + 1
            if r >= rp_first_agg() || self.is_int_class(r):
                reg_ok = ci < 6
            else:
                reg_ok = cx < 8
            if !reg_ok:
                if r >= rp_first_agg():
                    let x = self.res(f, self.av[k])
                    if f.op[x] == int(Op.Undef):
                        self.a.lea_rip(0, 1, 0)
                    else:
                        self.a.lea(0, self.vb(x), 0 - self.voff[x])
                else:
                    self.ld(0, f, self.av[k])
                self.a.push(0)
            k = k - 1
        if sret:
            self.a.lea(7, self.vb(i), 0 - self.voff[i])
        let ci = 0
        if sret:
            ci = 1
        let cx = 0
        for an in 0..self.nav:
            let v = self.av[an]
            let x = self.res(f, v)
            let r = f.rep[x]
            if r >= rp_first_agg():
                if ci < 6:
                    if f.op[x] == int(Op.Undef):
                        self.a.lea_rip(int_reg(ci), 1, 0)
                    else:
                        self.a.lea(int_reg(ci), self.vb(x), 0 - self.voff[x])
                ci = ci + 1
            elif self.is_int_class(r):
                if ci < 6:
                    self.ld(int_reg(ci), f, v)
                ci = ci + 1
            else:
                if cx < 8:
                    if self.xhome[x] >= 0:
                        self.a.movaps(cx, self.xhome[x])
                    else:
                        self.ld(0, f, v)
                        self.a.movq_x(cx, 0, r == int(Rp.F32))
                cx = cx + 1
        if variadic:
            self.a.mov_ri(0, nx)
        if sym < 0:
            self.a.call_reg(11)
        else:
            self.a.call_sym(sym)
        let pop = on_stack
        if on_stack % 2 == 1:
            pop = pop + 1
        if pop > 0:
            self.a.add_ri(4, pop * 8)
        if ret == int(Rp.Void) || sret || f.uses[i] == 0:
            return
        if self.is_int_class(ret):
            self.st(i, 0)
        else:
            self.xfin(f, i, 0)

    /#/ The symbol of the function the name number `id` of `sy` stands for.
    fn callee(self, sy: &Names, id: int) => int:
        let w = new_txt()
        sy.put(&w, id)
        return self.o.sym(&w)

    /#/ ---- instructions ------------------------------------------------------

    fn cc_of(self, p: int) => int:
        if p == int(Pr.Eq):
            return cc_e()
        if p == int(Pr.Ne):
            return cc_ne()
        if p == int(Pr.SLt):
            return cc_l()
        if p == int(Pr.SLe):
            return cc_le()
        if p == int(Pr.SGt):
            return cc_g()
        if p == int(Pr.SGe):
            return cc_ge()
        if p == int(Pr.ULt):
            return cc_b()
        if p == int(Pr.ULe):
            return cc_be()
        if p == int(Pr.UGt):
            return cc_a()
        return cc_ae()

    fn is_signed_pred(self, p: int) => bool:
        return p == int(Pr.SLt) || p == int(Pr.SLe) || p == int(Pr.SGt) || p == int(Pr.SGe)

    /#/ Is the compare `i` used only by the branch right after it? Then the flags carry it.
    fn fused(self, f: &Fun, i: int) => bool:
        let n = f.nx[i]
        if n < 0 || f.op[n] != int(Op.CondBr) || f.uses[i] != 1:
            return false
        return self.res(f, f.a[n]) == i

    /#/ Is the float compare `i` one the flags carry in a single condition (not == or !=)?
    fn fflag_ok(self, f: &Fun, i: int) => bool:
        let p = f.aux[i]
        return p == int(Pr.OLt) || p == int(Pr.OLe) || p == int(Pr.OGt) || p == int(Pr.OGe)

    /#/ Compare the operands of the float compare `i` and return the condition that holds when it is true.
    /#/ An unordered result sets CF, so `a` and `ae` are false for it, as the compare requires.
    fn fcmp_flags(self, f: &Fun, i: int) => int:
        let p = f.aux[i]
        let single = f.rep[self.res(f, f.a[i])] == int(Rp.F32)
        let xa = self.xsrc(f, f.a[i], 0)
        let xb = self.xsrc(f, f.b[i], 1)
        if p == int(Pr.OLt) || p == int(Pr.OLe):
            self.a.ucomi(single, xb, xa)
        else:
            self.a.ucomi(single, xa, xb)
        if p == int(Pr.OLt) || p == int(Pr.OGt):
            return cc_a()
        return cc_ae()

    /#/ Is `v` a constant small enough that, times an element size of at most 8, it is a displacement?
    fn near_const(self, f: &Fun, v: int) => bool:
        let x = self.res(f, v)
        if f.op[x] != int(Op.Const):
            return false
        let r = f.rep[x]
        if r != int(Rp.I64) && r != int(Rp.Ptr):
            return false
        return f.aux[x] >= 0 - 100000000 && f.aux[x] <= 100000000

    /#/ Is `v` a 64-bit constant that fits the sign-extended 32-bit immediate of an instruction?
    fn small_imm(self, f: &Fun, v: int) => bool:
        let x = self.res(f, v)
        if f.op[x] != int(Op.Const):
            return false
        let r = f.rep[x]
        if r != int(Rp.I64) && r != int(Rp.Ptr):
            return false
        return f.aux[x] >= 0 - 2147483648 && f.aux[x] <= 2147483647

    /#/ Sets the flags for the integer compare `i`.
    fn cmp_flags(self, f: &Fun, i: int) => void:
        let signed = self.is_signed_pred(f.aux[i])
        let wr = f.rep[self.res(f, f.a[i])]
        if wr == int(Rp.I64) || wr == int(Rp.Ptr):
            /#/ a whole register: compare it where it lives
            let la = self.src(f, f.a[i], 0)
            if self.small_imm(f, f.b[i]):
                self.a.cmp_ri(la, f.aux[self.res(f, f.b[i])])
            else:
                self.a.cmp_rr(la, self.src(f, f.b[i], 1))
            return
        self.ld_ext(0, f, f.a[i], signed)
        if self.small_imm(f, f.b[i]):
            self.a.cmp_ri(0, f.aux[self.res(f, f.b[i])])
            return
        self.ld_ext(1, f, f.b[i], signed)
        self.a.cmp_rr(0, 1)

    /#/ Division or remainder of the 64-bit value `i`'s first operand by the constant `d` >= 2,
    /#/ without a divide instruction; false if `op` and `d` have no such form here.
    fn div_const(self, f: &Fun, i: int, op: int, d: int) => bool:
        let signed = op == int(Op.SDiv) || op == int(Op.SRem)
        let rem = op == int(Op.SRem) || op == int(Op.URem)
        let pow2 = (d & (d - 1)) == 0
        let k = 0
        while (1 << k) < d:
            k = k + 1
        if !signed:
            if !pow2:
                return false
            self.ld(0, f, f.a[i])
            if rem:
                self.a.and_ri(0, d - 1)
            else:
                self.a.shift_i(5, 0, k)
            self.st(i, 0)
            return true
        self.ld(1, f, f.a[i])
        if pow2:
            /#/ x + (d - 1 when x is negative), then shifted
            self.a.mov_rr(0, 1)
            self.a.shift_i(7, 0, 63)
            self.a.shift_i(5, 0, 64 - k)
            self.a.add_rr(0, 1)
            if rem:
                self.a.shift_i(7, 0, k)
                self.a.shift_i(4, 0, k)
                self.a.sub_rr(1, 0)
                self.st(i, 1)
            else:
                self.a.shift_i(7, 0, k)
                self.st(i, 0)
            return true
        /#/ q = (mulh(m, x) + x >> (l - 1)) - (x >> 63), with m = 1 + floor(2^(63 + l) / d)
        self.a.mov_ri(0, magic_mult(d, k))
        self.a.grp3(5, 1)
        self.a.add_rr(2, 1)
        self.a.shift_i(7, 2, k - 1)
        self.a.mov_rr(0, 1)
        self.a.shift_i(7, 0, 63)
        self.a.sub_rr(2, 0)
        if rem:
            self.a.imul_rri(2, 2, d)
            self.a.sub_rr(1, 2)
            self.st(i, 1)
        else:
            self.st(i, 2)
        return true

    fn gen_inst(self, f: &Fun, rs: &Reps, sy: &Names, i: int, next: int) => void:
        let op = f.op[i]
        let r = f.rep[i]
        if op == int(Op.Param) || op == int(Op.Slot) || op == int(Op.OwnMove) || op == int(Op.Const) || op == int(Op.StrLit) || op == int(Op.Undef):
            return
        if op == int(Op.Add) || op == int(Op.Sub) || op == int(Op.Mul) || op == int(Op.And) || op == int(Op.Or) || op == int(Op.Xor):
            let d = self.home[i]
            if d >= 0:
                /#/ the result has a register: work in it, with the operands where they live
                let a = f.a[i]
                let b = f.b[i]
                if self.home_of(f, b) == d && op != int(Op.Sub):
                    a = f.b[i]
                    b = f.a[i]
                if self.home_of(f, b) != d:
                    if self.small_imm(f, b):
                        let v = f.aux[self.res(f, b)]
                        if op == int(Op.Mul):
                            if v > 0 && (v & (v - 1)) == 0:
                                self.ld(d, f, a)
                                let sh = 0
                                while (1 << sh) < v:
                                    sh = sh + 1
                                self.a.shift_i(4, d, sh)
                            else:
                                self.a.imul_rri(d, self.src(f, a, 0), v)
                            return
                        if op == int(Op.Add) && self.home_of(f, a) >= 0:
                            self.a.lea(d, self.home_of(f, a), v)
                            return
                        self.ld(d, f, a)
                        if op == int(Op.Add):
                            self.a.add_ri(d, v)
                        elif op == int(Op.Sub):
                            self.a.sub_ri(d, v)
                        elif op == int(Op.And):
                            self.a.and_ri(d, v)
                        elif op == int(Op.Or):
                            self.a.or_ri(d, v)
                        else:
                            self.a.xor_ri(d, v)
                        return
                    if op == int(Op.Add) && self.home_of(f, a) >= 0 && self.home_of(f, a) != d && self.home_of(f, b) >= 0:
                        /#/ both operands live on: one lea instead of a copy and an add
                        self.a.lea_idx(d, self.home_of(f, a), self.home_of(f, b), 1)
                        return
                    self.ld(d, f, a)
                    let rb = self.src(f, b, 1)
                    if op == int(Op.Add):
                        self.a.add_rr(d, rb)
                    elif op == int(Op.Sub):
                        self.a.sub_rr(d, rb)
                    elif op == int(Op.Mul):
                        self.a.imul_rr(d, rb)
                    elif op == int(Op.And):
                        self.a.and_rr(d, rb)
                    elif op == int(Op.Or):
                        self.a.or_rr(d, rb)
                    else:
                        self.a.xor_rr(d, rb)
                    return
            self.ld(0, f, f.a[i])
            if (op == int(Op.Add) || op == int(Op.Sub)) && self.small_imm(f, f.b[i]):
                if op == int(Op.Add):
                    self.a.add_ri(0, f.aux[self.res(f, f.b[i])])
                else:
                    self.a.sub_ri(0, f.aux[self.res(f, f.b[i])])
                self.st(i, 0)
                return
            self.ld(1, f, f.b[i])
            if op == int(Op.Add):
                self.a.add_rr(0, 1)
            elif op == int(Op.Sub):
                self.a.sub_rr(0, 1)
            elif op == int(Op.Mul):
                self.a.imul_rr(0, 1)
            elif op == int(Op.And):
                self.a.and_rr(0, 1)
            elif op == int(Op.Or):
                self.a.or_rr(0, 1)
            else:
                self.a.xor_rr(0, 1)
            self.st(i, 0)
            return
        if op == int(Op.SDiv) || op == int(Op.SRem) || op == int(Op.UDiv) || op == int(Op.URem):
            let signed = op == int(Op.SDiv) || op == int(Op.SRem)
            if r == int(Rp.I64) && self.small_imm(f, f.b[i]) && f.aux[self.res(f, f.b[i])] >= 2:
                if self.div_const(f, i, op, f.aux[self.res(f, f.b[i])]):
                    return
            self.ld_ext(0, f, f.a[i], signed)
            self.ld_ext(1, f, f.b[i], signed)
            if signed:
                self.a.cqo()
                self.a.idiv(1)
            else:
                self.a.mov_ri(2, 0)
                self.a.div(1)
            if op == int(Op.SDiv) || op == int(Op.UDiv):
                self.st(i, 0)
            else:
                self.st(i, 2)
            return
        if op == int(Op.Shl) || op == int(Op.AShr) || op == int(Op.LShr):
            self.ld_ext(0, f, f.a[i], op == int(Op.AShr))
            self.ld(1, f, f.b[i])
            if op == int(Op.Shl):
                self.a.shift_cl(4, 0)
            elif op == int(Op.LShr):
                self.a.shift_cl(5, 0)
            else:
                self.a.shift_cl(7, 0)
            self.st(i, 0)
            return
        if op == int(Op.FnAddr):
            self.a.lea_rip(0, self.callee(sy, f.aux[i]), 0)
            self.st(i, 0)
            return
        if op == int(Op.Neg) || op == int(Op.Not):
            self.ld(0, f, f.a[i])
            if op == int(Op.Neg):
                self.a.neg(0)
            else:
                self.a.not_(0)
            self.st(i, 0)
            return
        if op == int(Op.FNeg):
            let single = r == int(Rp.F32)
            let xa = self.xsrc(f, f.a[i], 0)
            let xd = self.xdst(i)
            if single:
                self.a.mov_ri(1, 2147483648)
            else:
                self.a.mov_ri(1, 0 - 9223372036854775807 - 1)
            self.a.movq_x(1, 1, false)
            if xd != xa:
                self.a.movaps(xd, xa)
            self.a.xorps(xd, 1)
            self.xfin(f, i, xd)
            return
        if op == int(Op.FAdd) || op == int(Op.FSub) || op == int(Op.FMul) || op == int(Op.FDiv):
            let single = r == int(Rp.F32)
            let code = 88
            if op == int(Op.FMul):
                code = 89
            elif op == int(Op.FSub):
                code = 92
            elif op == int(Op.FDiv):
                code = 94
            let xa = self.xsrc(f, f.a[i], 0)
            let xb = self.xsrc(f, f.b[i], 1)
            let xd = self.xdst(i)
            if xd == xa:
                self.a.sse(code, single, xd, xb)
            elif xd == xb && (op == int(Op.FAdd) || op == int(Op.FMul)):
                self.a.sse(code, single, xd, xa)
            elif xd != xb:
                self.a.movaps(xd, xa)
                self.a.sse(code, single, xd, xb)
            else:
                self.a.movaps(0, xa)
                self.a.sse(code, single, 0, xb)
                self.a.movaps(xd, 0)
            self.xfin(f, i, xd)
            return
        if op == int(Op.FRem):
            let single = r == int(Rp.F32)
            let xa = self.xsrc(f, f.a[i], 0)
            if xa != 0:
                self.a.movaps(0, xa)
            let xb = self.xsrc(f, f.b[i], 1)
            if xb != 1:
                self.a.movaps(1, xb)
            let nm = new_txt()
            if single:
                nm.put("fmodf")
            else:
                nm.put("fmod")
            self.a.call_sym(self.o.sym(&nm))
            self.xfin(f, i, 0)
            return
        if op == int(Op.Cmp):
            if self.fused(f, i):
                return
            self.cmp_flags(f, i)
            if self.home[i] >= 0:
                self.a.setcc(self.cc_of(f.aux[i]), self.home[i])
            else:
                self.a.setcc(self.cc_of(f.aux[i]), 0)
                self.st(i, 0)
            return
        if op == int(Op.FCmp):
            let p = f.aux[i]
            if self.fflag_ok(f, i) && self.fused(f, i):
                return
            let single = f.rep[self.res(f, f.a[i])] == int(Rp.F32)
            let xa = self.xsrc(f, f.a[i], 0)
            let xb = self.xsrc(f, f.b[i], 1)
            if p == int(Pr.OLt) || p == int(Pr.OLe):
                self.a.ucomi(single, xb, xa)
                if p == int(Pr.OLt):
                    self.a.setcc(cc_a(), 0)
                else:
                    self.a.setcc(cc_ae(), 0)
            elif p == int(Pr.OGt) || p == int(Pr.OGe):
                self.a.ucomi(single, xa, xb)
                if p == int(Pr.OGt):
                    self.a.setcc(cc_a(), 0)
                else:
                    self.a.setcc(cc_ae(), 0)
            else:
                self.a.ucomi(single, xa, xb)
                if p == int(Pr.OEq):
                    self.a.setcc(cc_e(), 0)
                    self.a.setcc(cc_np(), 1)
                else:
                    self.a.setcc(cc_ne(), 0)
                    self.a.setcc(cc_np(), 1)
                self.a.and_rr(0, 1)
            self.st(i, 0)
            return
        if op == int(Op.Trunc) || op == int(Op.Bitcast) || op == int(Op.PtrToInt) || op == int(Op.IntToPtr):
            if self.home[i] >= 0:
                self.ld(self.home[i], f, f.a[i])
                return
            self.ld(0, f, f.a[i])
            self.st(i, 0)
            return
        if op == int(Op.SExt) || op == int(Op.ZExt):
            if self.home[i] >= 0:
                self.ld_ext(self.home[i], f, f.a[i], op == int(Op.SExt))
                return
            self.ld_ext(0, f, f.a[i], op == int(Op.SExt))
            self.st(i, 0)
            return
        if op == int(Op.SiToFp) || op == int(Op.UiToFp):
            let single = r == int(Rp.F32)
            let signed = op == int(Op.SiToFp)
            let xd = self.xdst(i)
            self.ld_ext(0, f, f.a[i], signed)
            if signed || f.rep[self.res(f, f.a[i])] != int(Rp.I64):
                self.a.cvt_si2f(xd, 0, single)
            else:
                let pos = self.a.new_label()
                let done = self.a.new_label()
                self.a.test_rr(0, 0)
                self.a.jcc(9, pos)
                self.a.mov_rr(1, 0)
                self.a.shift_i(5, 0, 1)
                self.a.mov_ri(2, 1)
                self.a.and_rr(1, 2)
                self.a.or_rr(0, 1)
                self.a.cvt_si2f(xd, 0, single)
                self.a.sse(88, single, xd, xd)
                self.a.jmp(done)
                self.a.bind(pos)
                self.a.cvt_si2f(xd, 0, single)
                self.a.bind(done)
            self.xfin(f, i, xd)
            return
        if op == int(Op.FpToSi) || op == int(Op.FpToUi):
            let single = f.rep[self.res(f, f.a[i])] == int(Rp.F32)
            let xa = self.xsrc(f, f.a[i], 0)
            if op == int(Op.FpToUi) && r == int(Rp.I64):
                let small = self.a.new_label()
                let done = self.a.new_label()
                if xa != 0:
                    self.a.movaps(0, xa)
                if single:
                    self.a.mov_ri(1, 1593835520)
                else:
                    self.a.mov_ri(1, 4890909195324358656)
                self.a.movq_x(1, 1, single)
                self.a.ucomi(single, 0, 1)
                self.a.jcc(cc_b(), small)
                self.a.sse(92, single, 0, 1)
                self.a.cvt_f2si(0, 0, single)
                self.a.mov_ri(1, 0 - 9223372036854775807 - 1)
                self.a.xor_rr(0, 1)
                self.a.jmp(done)
                self.a.bind(small)
                self.a.cvt_f2si(0, 0, single)
                self.a.bind(done)
            else:
                self.a.cvt_f2si(0, xa, single)
            self.st(i, 0)
            return
        if op == int(Op.FpExt) || op == int(Op.FpTrunc):
            let to_single = op == int(Op.FpTrunc)
            let xa = self.xsrc(f, f.a[i], 0)
            let xd = self.xdst(i)
            self.a.cvt_ff(xd, xa, to_single)
            self.xfin(f, i, xd)
            return
        if (op == int(Op.Field) || op == int(Op.Index)) && self.folds(f, i):
            return
        if op == int(Op.Field):
            let d = self.home[i]
            if d < 0:
                d = 0
            let rb = self.src(f, f.a[i], 0)
            if f.aux[i] == 0 && rb == d:
                self.st(i, d)
                return
            self.a.lea(d, rb, f.aux[i])
            self.st(i, d)
            return
        if op == int(Op.Index):
            let d = self.home[i]
            if d < 0:
                d = 0
            let sz = f.aux[i]
            let ba = self.res(f, f.a[i])
            if f.op[ba] == int(Op.StrLit) && (sz == 1 || sz == 2 || sz == 4 || sz == 8) && self.near_const(f, f.b[i]):
                /#/ a place in the text of a literal: one rip-relative lea
                self.a.lea_rip(d, 1, self.sbase + self.so(f.aux[ba]) + f.aux[self.res(f, f.b[i])] * sz)
                self.st(i, d)
                return
            let ra = self.src(f, f.a[i], 0)
            let rb = 1
            if !((sz == 1 || sz == 2 || sz == 4 || sz == 8) && self.near_const(f, f.b[i])):
                rb = self.src(f, f.b[i], 1)
            if (sz == 1 || sz == 2 || sz == 4 || sz == 8) && self.near_const(f, f.b[i]):
                let dp = f.aux[self.res(f, f.b[i])] * sz
                if !(dp == 0 && ra == d):
                    self.a.lea(d, ra, dp)
            elif sz == 1 || sz == 2 || sz == 4 || sz == 8:
                self.a.lea_idx(d, ra, rb, sz)
            else:
                self.a.imul_rri(1, rb, sz)
                self.a.lea_idx(d, ra, 1, 1)
            self.st(i, d)
            return
        if op == int(Op.Extract):
            let ar = f.rep[self.res(f, f.a[i])]
            let eo = elem_off(rs, ar, f.aux[i])
            let sb = self.ab_reg(f, f.a[i])
            let sd = self.ab_disp(f, f.a[i]) + eo
            if r >= rp_first_agg():
                self.copy_mem(self.vb(i), 0 - self.voff[i], sb, sd, rsize(rs, r))
            elif self.xhome[i] >= 0:
                self.a.load_x(self.xhome[i], sb, sd, r == int(Rp.F32))
            else:
                let d = self.home[i]
                if d < 0:
                    d = 0
                self.a.load(d, sb, sd, rsize(rs, r))
                self.st(i, d)
            return
        if op == int(Op.Insert):
            let eo = elem_off(rs, r, f.aux[i])
            let sb = self.ab_reg(f, f.a[i])
            self.copy_mem(self.vb(i), 0 - self.voff[i], sb, self.ab_disp(f, f.a[i]), rsize(rs, r))
            let er = f.rep[self.res(f, f.b[i])]
            if er >= rp_first_agg():
                let eb = self.ab_reg(f, f.b[i])
                self.copy_mem(self.vb(i), 0 - self.voff[i] + eo, eb, self.ab_disp(f, f.b[i]), rsize(rs, er))
            else:
                self.ld(0, f, f.b[i])
                self.a.store(self.vb(i), 0 - self.voff[i] + eo, 0, rsize(rs, er))
            return
        if op == int(Op.Load):
            if r >= rp_first_agg():
                self.ld(6, f, f.a[i])
                self.copy_mem(self.vb(i), 0 - self.voff[i], 6, 0, rsize(rs, r))
            elif self.xhome[i] >= 0:
                let xd = self.xhome[i]
                let sg = r == int(Rp.F32)
                let x = self.res(f, f.a[i])
                if self.folds(f, x):
                    self.addr_of(f, x, 6, 1)
                    if self.am_idx >= 0:
                        self.a.load_x_idx(xd, self.am_base, self.am_idx, self.am_scale, 0, sg)
                    else:
                        self.a.load_x(xd, self.am_base, self.am_disp, sg)
                else:
                    self.a.load_x(xd, self.src(f, f.a[i], 6), 0, sg)
            else:
                let d = self.home[i]
                if d < 0:
                    d = 0
                let x = self.res(f, f.a[i])
                if self.folds(f, x):
                    self.addr_of(f, x, 6, 1)
                    if self.am_idx >= 0:
                        self.a.load_idx(d, self.am_base, self.am_idx, self.am_scale, 0, rsize(rs, r))
                    else:
                        self.a.load(d, self.am_base, self.am_disp, rsize(rs, r))
                else:
                    self.a.load(d, self.src(f, f.a[i], 6), 0, rsize(rs, r))
                self.st(i, d)
            return
        if op == int(Op.Store):
            let vr = f.rep[self.res(f, f.b[i])]
            if vr >= rp_first_agg():
                self.ld(7, f, f.a[i])
                let sb = self.ab_reg(f, f.b[i])
                self.copy_mem(7, 0, sb, self.ab_disp(f, f.b[i]), rsize(rs, vr))
            elif self.xhome[self.res(f, f.b[i])] >= 0:
                let xv = self.xhome[self.res(f, f.b[i])]
                let sg = vr == int(Rp.F32)
                let x = self.res(f, f.a[i])
                if self.folds(f, x):
                    self.addr_of(f, x, 1, 6)
                    if self.am_idx >= 0:
                        self.a.store_x_idx(self.am_base, self.am_idx, self.am_scale, 0, xv, sg)
                    else:
                        self.a.store_x(self.am_base, self.am_disp, xv, sg)
                else:
                    self.a.store_x(self.src(f, f.a[i], 1), 0, xv, sg)
            else:
                let rv = self.src(f, f.b[i], 0)
                let x = self.res(f, f.a[i])
                if self.folds(f, x):
                    self.addr_of(f, x, 1, 6)
                    if self.am_idx >= 0:
                        self.a.store_idx(self.am_base, self.am_idx, self.am_scale, 0, rv, rsize(rs, vr))
                    else:
                        self.a.store(self.am_base, self.am_disp, rv, rsize(rs, vr))
                else:
                    self.a.store(self.src(f, f.a[i], 1), 0, rv, rsize(rs, vr))
            return
        if op == int(Op.Alloc):
            self.a.mov_ri(7, f.ty[i])
            let nm = new_txt()
            nm.put("malloc")
            self.a.call_sym(self.o.sym(&nm))
            self.st(i, 0)
            return
        if op == int(Op.Free):
            self.ld(7, f, f.a[i])
            let nm = new_txt()
            nm.put("free")
            self.a.call_sym(self.o.sym(&nm))
            return
        if op == int(Op.Drop) || op == int(Op.Clone):
            self.nav = 0
            self.push_arg(f.a[i])
            self.do_call(f, rs, i, self.callee(sy, f.aux[i]), false)
            return
        if op == int(Op.Call) || op == int(Op.CCall) || op == int(Op.CallI):
            self.nav = 0
            for k in 0..f.b[i]:
                self.push_arg(f.pool[f.a[i] + k])
            if op == int(Op.CallI) && self.a.sbx:
                /#/ a function value would have to be a checked table index
                self.bad()
                return
            if op == int(Op.CallI):
                self.ld(11, f, f.c[i])
                self.do_call(f, rs, i, 0 - 1, false)
            else:
                self.do_call(f, rs, i, self.callee(sy, f.aux[i]), op == int(Op.CCall) && f.c[i] != 0)
            return
        if op == int(Op.Br):
            let e = f.aux[i]
            self.edge_copy(f, rs, e)
            if f.eto[e] != next:
                self.a.jmp(f.eto[e])
            return
        if op == int(Op.CondBr):
            let e1 = f.b[i]
            let e2 = f.c[i]
            let c = self.res(f, f.a[i])
            let cc = cc_ne()
            if f.op[c] == int(Op.Cmp) && self.fused(f, c):
                self.cmp_flags(f, c)
                cc = self.cc_of(f.aux[c])
            elif f.op[c] == int(Op.FCmp) && self.fflag_ok(f, c) && self.fused(f, c):
                cc = self.fcmp_flags(f, c)
            else:
                self.ld_ext(0, f, f.a[i], false)
                self.a.extend(0, 0, 1, false)
                self.a.test_rr(0, 0)
            if f.eargn[e1] == 0 && f.eargn[e2] == 0:
                /#/ no moves on either edge: one conditional jump, the other way falls through
                if f.eto[e2] == next:
                    self.a.jcc(cc, f.eto[e1])
                elif f.eto[e1] == next:
                    self.a.jcc(cc ^ 1, f.eto[e2])
                else:
                    self.a.jcc(cc, f.eto[e1])
                    self.a.jmp(f.eto[e2])
                return
            if f.eargn[e1] == 0:
                /#/ the true edge needs no moves: jump straight to its block
                self.a.jcc(cc, f.eto[e1])
                self.edge_copy(f, rs, e2)
                if f.eto[e2] != next:
                    self.a.jmp(f.eto[e2])
                return
            if f.eargn[e2] == 0:
                self.a.jcc(cc ^ 1, f.eto[e2])
                self.edge_copy(f, rs, e1)
                if f.eto[e1] != next:
                    self.a.jmp(f.eto[e1])
                return
            let yes = self.a.new_label()
            self.a.jcc(cc, yes)
            self.edge_copy(f, rs, e2)
            self.a.jmp(f.eto[e2])
            self.a.bind(yes)
            self.edge_copy(f, rs, e1)
            if f.eto[e1] != next:
                self.a.jmp(f.eto[e1])
            return
        if op == int(Op.Switch):
            self.ld_ext(0, f, f.a[i], true)
            for k in 0..f.b[i]:
                let skip = self.a.new_label()
                let e = f.pool[f.aux[i] + k * 2 + 1]
                self.a.mov_ri(1, f.pool[f.aux[i] + k * 2])
                self.a.cmp_rr(0, 1)
                self.a.jcc(cc_ne(), skip)
                self.edge_copy(f, rs, e)
                self.a.jmp(f.eto[e])
                self.a.bind(skip)
            self.edge_copy(f, rs, f.c[i])
            self.a.jmp(f.eto[f.c[i]])
            return
        if op == int(Op.Ret):
            if f.a[i] >= 0:
                let vr = f.rep[self.res(f, f.a[i])]
                if vr >= rp_first_agg():
                    self.a.load(7, 5, 0 - 8, 8)
                    let sb = self.ab_reg(f, f.a[i])
                    self.copy_mem(7, 0, sb, self.ab_disp(f, f.a[i]), rsize(rs, vr))
                elif self.is_int_class(vr):
                    self.ld(0, f, f.a[i])
                else:
                    let rx = self.res(f, f.a[i])
                    if self.xhome[rx] >= 0:
                        self.a.movaps(0, self.xhome[rx])
                    else:
                        self.ld(0, f, f.a[i])
                        self.a.movq_x(0, 0, vr == int(Rp.F32))
            if self.epi_jump:
                self.a.jmp(self.epi)
            else:
                self.epilogue()
            return
        if op == int(Op.Unreachable):
            self.a.ud2()
            return
        self.bad()

    /#/ ---- functions ---------------------------------------------------------

    /#/ Generates function `f`; returns false if something could not be translated.
    fn gen_fun(self, f: &Fun, rs: &Reps, sy: &Names) => bool:
        self.err = 0
        self.a.begin_fun()
        if len(self.ord) < f.nb + 1:
            self.ord = new_buf(int, f.nb + 1)
            self.emit = new_buf(int, f.nb + 1)
        /#/ the registers are given along the plain order (a header before its loop), the code is
        /#/ written in the rotated one
        block_order(f, &self.ord, false)
        block_order(f, &self.emit, true)
        self.alloc_regs(f, rs)
        self.count_uses(f)
        self.layout(f, rs)
        let start = self.a.pos()
        for b in 0..f.nb:
            self.a.new_label()
        self.a.push(5)
        self.a.mov_rr(5, 4)
        /#/ [rbp-8] is the place of the pointer for a returned aggregate (rdi); the saved registers
        /#/ follow, then the locals
        self.a.push(7)
        for k in 0..self.nsaved:
            self.a.push(self.saved[k])
        if self.frame > 8 + 8 * self.nsaved:
            self.a.sub_ri(4, self.frame - 8 - 8 * self.nsaved)
        if self.sframe > 0:
            self.a.sub_ri(14, self.sframe)
        let nret = 0
        for b in 0..f.nb:
            if f.blast[b] >= 0 && f.op[f.blast[b]] == int(Op.Ret):
                nret = nret + 1
        self.epi_jump = self.nsaved > 0 && nret > 1
        self.epi = self.a.new_label()
        /#/ the parameters of the entry block
        let ci = 0
        let cx = 0
        let cs = 0
        if f.ret >= rp_first_agg():
            ci = 1
        let p = f.pfirst[0]
        while p >= 0:
            let r = f.rep[p]
            if r >= rp_first_agg() || self.is_int_class(r):
                if ci < 6:
                    if r >= rp_first_agg():
                        self.copy_mem(self.vb(p), 0 - self.voff[p], int_reg(ci), 0, rsize(rs, r))
                    else:
                        self.st(p, int_reg(ci))
                else:
                    self.a.load(0, 5, 16 + 8 * cs, 8)
                    if r >= rp_first_agg():
                        self.a.mov_rr(6, 0)
                        self.copy_mem(self.vb(p), 0 - self.voff[p], 6, 0, rsize(rs, r))
                    else:
                        self.st(p, 0)
                    cs = cs + 1
                ci = ci + 1
            else:
                if cx < 8:
                    if self.xhome[p] >= 0:
                        self.a.movaps(self.xhome[p], cx)
                    else:
                        self.a.movq_r(0, cx, r == int(Rp.F32))
                        self.st(p, 0)
                else:
                    self.a.load(0, 5, 16 + 8 * cs, 8)
                    self.st(p, 0)
                    cs = cs + 1
                cx = cx + 1
            p = f.nx[p]
        for k in 0..self.nhc:
            let c = self.hc[k]
            if self.xhome[c] >= 0:
                self.ld(0, f, c)
                self.a.movq_x(self.xhome[c], 0, f.rep[c] == int(Rp.F32))
        self.mk_n = 0
        let last_ln = 0
        for oi in 0..f.nb:
            let b = self.emit[oi]
            self.a.bind(b)
            let i = f.bfirst[b]
            while i >= 0:
                if f.ln[i] > 0 && f.ln[i] != last_ln:
                    last_ln = f.ln[i]
                    if self.mk_n >= len(self.mk_l):
                        self.mk_l = buf_resize(self.mk_l, (self.mk_n + 1) * 2)
                        self.mk_ln = buf_resize(self.mk_ln, (self.mk_n + 1) * 2)
                    let ml = self.a.mark()
                    self.mk_l[self.mk_n] = ml
                    self.mk_ln[self.mk_n] = last_ln
                    self.mk_n = self.mk_n + 1
                let nxt = -1
                if f.nx[i] < 0 && oi + 1 < f.nb:
                    nxt = self.emit[oi + 1]
                self.gen_inst(f, rs, sy, i, nxt)
                i = f.nx[i]
        if self.epi_jump:
            self.a.bind(self.epi)
            self.epilogue()
        let ok = self.a.end_fun()
        let w = new_txt()
        for k in 0..len(f.nm):
            w.put_byte(f.nm[k])
        let sym = self.o.sym(&w)
        self.o.define(sym, start, self.a.pos() - start)
        if ok && self.err == 0 && self.mk_n > 0:
            if self.lf_n >= len(self.lf_sym):
                self.lf_sym = buf_resize(self.lf_sym, (self.lf_n + 1) * 2)
                self.lf_start = buf_resize(self.lf_start, (self.lf_n + 1) * 2)
                self.lf_m0 = buf_resize(self.lf_m0, (self.lf_n + 1) * 2)
            self.lf_sym[self.lf_n] = sym
            self.lf_start[self.lf_n] = start
            self.lf_m0[self.lf_n] = self.lm_n
            self.lf_n = self.lf_n + 1
            for k in 0..self.mk_n:
                if self.lm_n >= len(self.lm_at):
                    self.lm_at = buf_resize(self.lm_at, (self.lm_n + 1) * 2)
                    self.lm_ln = buf_resize(self.lm_ln, (self.lm_n + 1) * 2)
                self.lm_at[self.lm_n] = self.a.lab[self.mk_l[k]]
                self.lm_ln[self.lm_n] = self.mk_ln[k]
                self.lm_n = self.lm_n + 1
        if self.cur >= 0 && ok && self.err == 0:
            if self.cur >= len(self.msk):
                let old = len(self.msk)
                self.msk = buf_resize(self.msk, (self.cur + 1) * 2)
                for q in old..len(self.msk):
                    self.msk[q] = 0
            self.msk[self.cur] = 8 + self.fmask
        return ok && self.err == 0

/#/ The line marks as text: `F name` for each function, then `L offset line` for each place where
/#/ the code of another line starts (the offset from the start of the function, the line of the
/#/ flattened text).
fn lines_dump(g: &Gen, out: &Txt) => void:
    for k in 0..g.lf_n:
        out.put("F ")
        let s = g.lf_sym[k] - 2
        for q in g.o.s_name[s]..g.o.s_name[s] + 4096:
            if g.o.names.b[q] == 0:
                break
            out.put_byte(g.o.names.b[q])
        out.put_byte(10)
        let hi = g.lm_n
        if k + 1 < g.lf_n:
            hi = g.lf_m0[k + 1]
        for m in g.lf_m0[k]..hi:
            /#/ a later mark at the same offset replaces an earlier one
            if m + 1 < hi && g.lm_at[m + 1] == g.lm_at[m]:
                continue
            out.put("L ")
            out.put_int(g.lm_at[m] - g.lf_start[k])
            out.put_byte(32)
            out.put_int(g.lm_ln[m])
            out.put_byte(10)

fn new_gen() => Gen:
    return Gen { a: new_asm(), o: new_obj(), voff: new_buf(int, 64), sh: new_buf(int, 64), sframe: 0, tmp: 0, frame: 0, err: 0, av: new_buf(int, 16), nav: 0, sbase: 256, soff: new_buf(int, 16), nstr: 0, home: new_buf(int, 64), xhome: new_buf(int, 64), ord: new_buf(int, 16), emit: new_buf(int, 16), xsg: new_buf(int, 64), did: new_buf(int, 64), nsaved: 0, saved: new_buf(int, 8), ed: new_buf(int, 16), ned: 0, ra_lo: new_buf(int, 1), ra_hi: new_buf(int, 1), ra_wt: new_buf(int, 1), uq_d: new_buf(int, 16), uq_b: new_buf(int, 16), nuq: 0, ra_dblk: new_buf(int, 1), ra_dset: new_buf(int, 1), ra_cp: new_buf(int, 16), ra_ncp: 0, ra_cm: new_buf(int, 16), cur: -1, msk: new_buf(int, 16), fmask: 0, nuse: new_buf(int, 64), am_base: 0, am_idx: -1, am_scale: 1, am_disp: 0, epi: 0, epi_jump: false, hc: new_buf(int, 16), nhc: 0, lm_at: new_buf(int, 64), lm_ln: new_buf(int, 64), lm_n: 0, mk_l: new_buf(int, 64), mk_ln: new_buf(int, 64), mk_n: 0, lf_sym: new_buf(int, 64), lf_start: new_buf(int, 64), lf_m0: new_buf(int, 64), lf_n: 0 }

/#/ The multiplier that divides by `d` (not a power of two; `l` is the log2 of `d` rounded up):
/#/ 1 + floor(2^(63 + l) / d), taken as a 64-bit pattern, by long division one bit at a time.
fn magic_mult(d: int, l: int) => int:
    let q = 0
    let r = 0
    let bit = 63 + l
    while bit >= 0:
        r = r * 2
        if bit == 63 + l:
            r = r + 1
        if r >= d:
            r = r - d
            if bit < 64:
                q = q | (1 << bit)
        bit = bit - 1
    return q + 1

fn rsize_scalar(r: int) => int:
    if r == int(Rp.I8):
        return 1
    if r == int(Rp.I16):
        return 2
    if r == int(Rp.I32) || r == int(Rp.F32):
        return 4
    return 8
