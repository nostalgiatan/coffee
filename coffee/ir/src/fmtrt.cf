    out = out + "                if last > 0:\n"
    out = out + "                    sticky = true\n"
    out = out + "                last = __cf_bn_divsmall(&n, p)\n"
    out = out + "                half = p // 2\n"
    out = out + "                left -= step\n"
    out = out + "            let up = false\n"
    out = out + "            if last > half:\n"
    out = out + "                up = true\n"
    out = out + "            elif last == half:\n"
    out = out + "                up = sticky || n[0] % 2 == 1\n"
    out = out + "            if up:\n"
    out = out + "                let one: buf<int> = new_buf(int, 48)\n"
    out = out + "                __cf_bn_set(&one, 1)\n"
    out = out + "                __cf_bn_add(&n, &one)\n"
    out = out + "    let digits: buf<int> = new_buf(int, 400)\n"
    out = out + "    let cnt = 0\n"
    out = out + "    while !__cf_bn_is_zero(&n):\n"
    out = out + "        digits[cnt] = __cf_bn_divsmall(&n, 10)\n"
    out = out + "        cnt += 1\n"
    out = out + "    while cnt < prec + 1:\n"
    out = out + "        digits[cnt] = 0\n"
    out = out + "        cnt += 1\n"
    out = out + "    let out = sign\n"
    out = out + "    let i = cnt - 1\n"
    out = out + "    while i >= 0:\n"
    out = out + "        out = out + __cf_ch(48 + digits[i])\n"
    out = out + "        if i == prec && prec > 0:\n"
    out = out + "            out = out + \".\"\n"
    out = out + "        i -= 1\n"
    out = out + "    return out\n"
    return out
