    out = out + "    if c == 46:\n"
    out = out + "        return \".\"\n"
    out = out + "    if c == 35:\n"
    out = out + "        return \"#\"\n"
    out = out + "    if c == 61:\n"
    out = out + "        return \"=\"\n"
    out = out + "    if c == 43:\n"
    out = out + "        return \"+\"\n"
    out = out + "    if c == 124:\n"
    out = out + "        return \"|\"\n"
    out = out + "    if c == 126:\n"
    out = out + "        return \"~\"\n"
    out = out + "    if c == 120:\n"
    out = out + "        return \"x\"\n"
    out = out + "    return \" \"\n"
    out = out + "fn __cf_pad(s: &str, width: int, align: int, fill: int) => str:\n"
    out = out + "    let n = len(s)\n"
    out = out + "    let total = width - n\n"
    out = out + "    if total < 0:\n"
    out = out + "        total = 0\n"
    out = out + "    let left = 0\n"
    out = out + "    if align == 2:\n"
    out = out + "        left = total\n"
    out = out + "    elif align == 3:\n"
    out = out + "        left = total // 2\n"
    out = out + "    let f = __cf_fillc(fill)\n"
    out = out + "    let out = \"\"\n"
    out = out + "    for i in 0..left:\n"
    out = out + "        out = out + f\n"
    out = out + "    out = out + s\n"
    out = out + "    for i in 0..total - left:\n"
    out = out + "        out = out + f\n"
    out = out + "    return out\n"
    out = out + "fn __cf_pad_zero(s: &str, width: int) => str:\n"
    out = out + "    let n = len(s)\n"
    out = out + "    let out = \"\"\n"
    out = out + "    let start = 0\n"
    out = out + "    if n > 0 && (s[0] == 45 || s[0] == 43):\n"
    out = out + "        out = __cf_ch(s[0])\n"
    out = out + "        start = 1\n"
    out = out + "    for i in 0..width - n:\n"
    out = out + "        out = out + \"0\"\n"
    out = out + "    for i in start..n:\n"
    out = out + "        out = out + __cf_ch(s[i])\n"
    out = out + "    return out\n"
    out = out + "fn __cf_dig(d: int, upper: bool) => str:\n"
    out = out + "    if d < 10:\n"
    out = out + "        return __cf_ch(48 + d)\n"
    out = out + "    if d == 10:\n"
    out = out + "        if upper:\n"
