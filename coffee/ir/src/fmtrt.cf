    out = out + "fn __cf_fmt_radix(v: int, radix: int, upper: int) => str:\n"
    out = out + "    if v == 0:\n"
    out = out + "        return \"0\"\n"
    out = out + "    let out = \"\"\n"
    out = out + "    if v < 0 - 9223372036854775807:\n"
    out = out + "        out = \"-\"\n"
    out = out + "        let zeros = 63\n"
    out = out + "        if radix == 8:\n"
    out = out + "            zeros = 21\n"
    out = out + "        if radix == 16:\n"
    out = out + "            out = \"-8\"\n"
    out = out + "            zeros = 15\n"
    out = out + "        else:\n"
    out = out + "            out = out + \"1\"\n"
    out = out + "        for i in 0..zeros:\n"
    out = out + "            out = out + \"0\"\n"
    out = out + "        return out\n"
    out = out + "    let digits: buf<int> = new_buf(int, 72)\n"
    out = out + "    let n = 0\n"
    out = out + "    let w = v\n"
    out = out + "    if w < 0:\n"
    out = out + "        w = 0 - w\n"
    out = out + "        out = \"-\"\n"
    out = out + "    while w > 0:\n"
    out = out + "        digits[n] = w % radix\n"
    out = out + "        w = w // radix\n"
    out = out + "        n += 1\n"
    out = out + "    let i = n - 1\n"
    out = out + "    while i >= 0:\n"
    out = out + "        out = out + __cf_dig(digits[i], upper != 0)\n"
    out = out + "        i -= 1\n"
    out = out + "    return out\n"
    out = out + "fn __cf_bn_divsmall(a: &buf<int>, d: int) => int:\n"
    out = out + "    let rem = 0\n"
    out = out + "    let i = 47\n"
    out = out + "    while i >= 0:\n"
    out = out + "        let t = rem * 268435456 + a[i]\n"
    out = out + "        a[i] = t // d\n"
    out = out + "        rem = t % d\n"
    out = out + "        i -= 1\n"
    out = out + "    return rem\n"
    out = out + "fn __cf_bn_is_zero(a: &buf<int>) => bool:\n"
    out = out + "    for i in 0..48:\n"
    out = out + "        if a[i] != 0:\n"
    out = out + "            return false\n"
    out = out + "    return true\n"
    out = out + "fn __cf_fmt_fixed(x: float, prec: int) => str:\n"
    out = out + "    if !(x == x):\n"
    out = out + "        return \"nan\"\n"
    out = out + "    let sign = \"\"\n"
    out = out + "    let m = x\n"
    out = out + "    if x < 0.0:\n"
    out = out + "        sign = \"-\"\n"
    out = out + "        m = 0.0 - x\n"
    out = out + "    if !((m - m) == (m - m)):\n"
    out = out + "        return sign + \"inf\"\n"
    out = out + "    let n: buf<int> = new_buf(int, 48)\n"
    out = out + "    if m != 0.0:\n"
    out = out + "        let e = 0\n"
    out = out + "        while m >= 9007199254740992.0:\n"
    out = out + "            m = m / 2.0\n"
    out = out + "            e += 1\n"
    out = out + "        while m < 1048576.0:\n"
    out = out + "            m = m * 4294967296.0\n"
    out = out + "            e -= 32\n"
    out = out + "        while m < 4503599627370496.0:\n"
    out = out + "            m = m * 2.0\n"
    out = out + "            e -= 1\n"
    out = out + "        let f = int(m)\n"
    out = out + "        while e < 0 - 1074:\n"
    out = out + "            f = f // 2\n"
    out = out + "            e += 1\n"
    out = out + "        __cf_bn_set(&n, f, 48)\n"
    out = out + "        for i in 0..prec:\n"
