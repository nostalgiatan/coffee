/#/ An x86-64 ELF relocatable object: one `.text.<name>` section per function with its own
/#/ `.rela.text.<name>` (so a linker can drop the functions nothing reaches), `.rodata`, the
/#/ symbols, and an empty `.note.GNU-stack` (so the linker keeps the stack non-executable).
/#/ Section 1 `.text` and section 3 `.rela.text` stay in their places, empty.
/#/
/#/ Symbol numbers in the object: 0 is null, 1 the `.rodata` section, then the symbols of `Obj`
/#/ in the order they were made (`2 + k`). All of them are global; the locals before them are the
/#/ two above.
use * in asm

class Obj:
    ro: Txt
    /#/ the string table: names, each ended by a NUL, after a NUL
    names: Txt
    s_name: buf<int>
    s_def: buf<int>
    s_size: buf<int>
    /#/ the section a symbol is defined in: 1 `.text`, 8 `.data`
    s_sec: buf<int>
    /#/ the initialized data
    data: Txt
    ns: int
    /#/ open-addressing index of the symbols by name: symbol number + 1, 0 for a free place (a power of two long)
    hx: buf<int>

    /#/ The symbol (object number) named like `w`, made when new.
    fn sym(self, w: &Txt) => int:
        let mask = len(self.hx) - 1
        let h = 0 - 3750763034362895579
        for q in 0..w.n:
            h = (h ^ int(w.b[q])) * 1099511628211
        let slot = (h >> 7) & mask
        while self.hx[slot] != 0:
            let k = self.hx[slot] - 1
            let at = self.s_name[k]
            if at + w.n < self.names.n:
                let q = 0
                while q < w.n && self.names.b[at + q] == w.b[q]:
                    q = q + 1
                if q == w.n && self.names.b[at + w.n] == 0:
                    return k + 2
            slot = (slot + 1) & mask
        if self.ns >= len(self.s_name):
            let cap = (self.ns + 1) * 2
            self.s_name = buf_resize(self.s_name, cap)
            self.s_def = buf_resize(self.s_def, cap)
            self.s_size = buf_resize(self.s_size, cap)
            self.s_sec = buf_resize(self.s_sec, cap)
        self.s_name[self.ns] = self.names.n
        self.s_def[self.ns] = 0 - 1
        self.s_size[self.ns] = 0
        self.s_sec[self.ns] = 1
        self.names.put_all(w)
        self.names.put_byte(0)
        self.hx[slot] = self.ns + 1
        self.ns = self.ns + 1
        if self.ns * 2 > len(self.hx):
            self.regrow()
        return self.ns + 1

    /#/ The index again, twice as long.
    fn regrow(self) => void:
        self.hx = new_buf(int, len(self.hx) * 2)
        let mask = len(self.hx) - 1
        for k in 0..self.ns:
            let h = 0 - 3750763034362895579
            let at = self.s_name[k]
            while self.names.b[at] != 0:
                h = (h ^ int(self.names.b[at])) * 1099511628211
                at = at + 1
            let slot = (h >> 7) & mask
            while self.hx[slot] != 0:
                slot = (slot + 1) & mask
            self.hx[slot] = k + 1

    fn dump_ro(self, t: &Txt) => void:
        t.put_all(&self.ro)

    fn dump_data(self, t: &Txt) => void:
        t.put_all(&self.data)

    fn dump_str(self, t: &Txt) => void:
        t.put_all(&self.names)

    fn define(self, sym: int, at: int, size: int) => void:
        self.s_def[sym - 2] = at
        self.s_size[sym - 2] = size

    /#/ Makes `size` zero bytes of `.data` the object `sym`.
    fn define_data(self, sym: int, size: int) => void:
        while self.data.n % 8 != 0:
            self.data.put_byte(0)
        self.s_def[sym - 2] = self.data.n
        self.s_size[sym - 2] = size
        self.s_sec[sym - 2] = 8
        for k in 0..size:
            self.data.put_byte(0)

    /#/ Adds `bytes` (and a NUL) to `.rodata`; the offset they start at.
    fn rodata(self, bytes: &Txt) => int:
        let at = self.ro.n
        self.ro.put_all(bytes)
        self.ro.put_byte(0)
        return at

fn new_obj() => Obj:
    let nm = new_txt()
    nm.put_byte(0)
    let o = Obj { ro: new_txt(), names: nm, s_name: new_buf(int, 16), s_def: new_buf(int, 16), s_size: new_buf(int, 16), s_sec: new_buf(int, 16), data: new_txt(), ns: 0, hx: new_buf(int, 256) }
    /#/ the zero block that stands in for `undef` aggregates
    for k in 0..256:
        o.ro.put_byte(0)
    return o

fn w16(t: &Txt, v: int) => void:
    for k in 0..2:
        t.put_byte((v >> (8 * k)) & 255)

fn w32(t: &Txt, v: int) => void:
    for k in 0..4:
        t.put_byte((v >> (8 * k)) & 255)

fn w64(t: &Txt, v: int) => void:
    for k in 0..8:
        t.put_byte((v >> (8 * k)) & 255)

fn pad_to(t: &Txt, align: int) => void:
    while t.n % align != 0:
        t.put_byte(0)

/#/ One section header.
fn shdr(t: &Txt, name: int, ty: int, flags: int, off: int, size: int, link: int, info: int, align: int, ent: int) => void:
    w32(t, name)
    w32(t, ty)
    w64(t, flags)
    w64(t, 0)
    w64(t, off)
    w64(t, size)
    w32(t, link)
    w32(t, info)
    w64(t, align)
    w64(t, ent)

/#/ The object file.
fn write_elf(o: &Obj, a: &Asm) => Txt:
    let out = new_txt()
    /#/ section names
    let sh = new_txt()
    sh.put_byte(0)
    let n_text = sh.n
    sh.put(".text")
    sh.put_byte(0)
    let n_ro = sh.n
    sh.put(".rodata")
    sh.put_byte(0)
    let n_rela = sh.n
    sh.put(".rela.text")
    sh.put_byte(0)
    let n_note = sh.n
    sh.put(".note.GNU-stack")
    sh.put_byte(0)
    let n_sym = sh.n
    sh.put(".symtab")
    sh.put_byte(0)
    let n_str = sh.n
    sh.put(".strtab")
    sh.put_byte(0)
    let n_shs = sh.n
    sh.put(".shstrtab")
    sh.put_byte(0)
    let n_data = sh.n
    sh.put(".data")
    sh.put_byte(0)
    /#/ the functions: the defined `.text` symbols, in the order they were assembled
    let fn_sym: buf<int> = new_buf(int, o.ns + 1)
    let fn_of: buf<int> = new_buf(int, o.ns + 1)
    let nf = 0
    for k in 0..o.ns:
        fn_of[k] = 0 - 1
        if o.s_def[k] >= 0 && o.s_sec[k] == 1:
            fn_sym[nf] = k
            fn_of[k] = nf
            nf = nf + 1
    /#/ in address order (the symbols were made in the order the names came up)
    let gap = nf // 2
    while gap > 0:
        for i in gap..nf:
            let x = fn_sym[i]
            let j = i
            while j >= gap && o.s_def[fn_sym[j - gap]] > o.s_def[x]:
                fn_sym[j] = fn_sym[j - gap]
                j = j - gap
            fn_sym[j] = x
        gap = gap // 2
    for j in 0..nf:
        fn_of[fn_sym[j]] = j
    if 9 + 2 * nf > 65000:
        say(f"elf: {nf} functions in one object are too many\n")
        return new_txt()
    let fn_tn: buf<int> = new_buf(int, nf + 1)
    let fn_rn: buf<int> = new_buf(int, nf + 1)
    for j in 0..nf:
        let at = o.s_name[fn_sym[j]]
        fn_tn[j] = sh.n
        sh.put(".text.")
        while o.names.b[at] != 0:
            sh.put_byte(o.names.b[at])
            at = at + 1
        sh.put_byte(0)
        at = o.s_name[fn_sym[j]]
        fn_rn[j] = sh.n
        sh.put(".rela.text.")
        while o.names.b[at] != 0:
            sh.put_byte(o.names.b[at])
            at = at + 1
        sh.put_byte(0)
    /#/ relocations and symbols
    /#/ the relocations of each function, offsets from its start; they were recorded in code order
    let rela = new_txt()
    let fn_ra: buf<int> = new_buf(int, nf + 1)
    let fn_rz: buf<int> = new_buf(int, nf + 1)
    let cur = 0
    for k in 0..a.nrl:
        let at = a.rl_at[k]
        while cur < nf && at >= o.s_def[fn_sym[cur]] + o.s_size[fn_sym[cur]]:
            cur = cur + 1
        if cur >= nf || at < o.s_def[fn_sym[cur]]:
            say(f"elf: a relocation at {at} is in no function\n")
            return new_txt()
        if fn_rz[cur] == 0:
            fn_ra[cur] = rela.n
        w64(&rela, at - o.s_def[fn_sym[cur]])
        w64(&rela, (a.rl_sym[k] << 32) | a.rl_ty[k])
        w64(&rela, a.rl_add[k])
        fn_rz[cur] = fn_rz[cur] + 24
    let syms = new_txt()
    for k in 0..24:
        syms.put_byte(0)
    w32(&syms, 0)
    syms.put_byte(3)
    syms.put_byte(0)
    w16(&syms, 2)
    w64(&syms, 0)
    w64(&syms, 0)
    for k in 0..o.ns:
        w32(&syms, o.s_name[k])
        if o.s_def[k] >= 0:
            if o.s_sec[k] == 8:
                syms.put_byte(17)
            else:
                syms.put_byte(18)
            syms.put_byte(0)
            if fn_of[k] >= 0:
                w16(&syms, 9 + 2 * fn_of[k])
                w64(&syms, 0)
            else:
                w16(&syms, o.s_sec[k])
                w64(&syms, o.s_def[k])
            w64(&syms, o.s_size[k])
        else:
            syms.put_byte(16)
            syms.put_byte(0)
            w16(&syms, 0)
            w64(&syms, 0)
            w64(&syms, 0)
    /#/ layout
    for k in 0..64:
        out.put_byte(0)
    let off_text = out.n
    let fn_off: buf<int> = new_buf(int, nf + 1)
    for j in 0..nf:
        pad_to(&out, 16)
        fn_off[j] = out.n
        for q in 0..o.s_size[fn_sym[j]]:
            out.put_byte(a.c.b[o.s_def[fn_sym[j]] + q])
    pad_to(&out, 16)
    let off_ro = out.n
    o.dump_ro(&out)
    pad_to(&out, 8)
    let off_data = out.n
    o.dump_data(&out)
    pad_to(&out, 8)
    let off_rela = out.n
    out.put_all(&rela)
    let off_sym = out.n
    out.put_all(&syms)
    let off_str = out.n
    o.dump_str(&out)
    let off_shs = out.n
    out.put_all(&sh)
    pad_to(&out, 8)
    let off_sh = out.n
    shdr(&out, 0, 0, 0, 0, 0, 0, 0, 0, 0)
    shdr(&out, n_text, 1, 6, off_text, 0, 0, 0, fn_align, 0)
    shdr(&out, n_ro, 1, 2, off_ro, o.ro.n, 0, 0, 16, 0)
    shdr(&out, n_rela, 4, 64, off_rela, 0, 5, 1, 8, 24)
    shdr(&out, n_note, 1, 0, off_shs, 0, 0, 0, 1, 0)
    shdr(&out, n_sym, 2, 0, off_sym, syms.n, 6, 2, 8, 24)
    shdr(&out, n_str, 3, 0, off_str, o.names.n, 0, 0, 1, 0)
    shdr(&out, n_shs, 3, 0, off_shs, sh.n, 0, 0, 1, 0)
    shdr(&out, n_data, 1, 3, off_data, o.data.n, 0, 0, 8, 0)
    for j in 0..nf:
        shdr(&out, fn_tn[j], 1, 6, fn_off[j], o.s_size[fn_sym[j]], 0, 0, fn_align, 0)
        shdr(&out, fn_rn[j], 4, 64, off_rela + fn_ra[j], fn_rz[j], 5, 9 + 2 * j, 8, 24)
    /#/ the file header, over the zeros at the start
    let h = new_txt()
    h.put_byte(127)
    h.put("ELF")
    h.put_byte(2)
    h.put_byte(1)
    h.put_byte(1)
    for k in 0..9:
        h.put_byte(0)
    w16(&h, 1)
    w16(&h, 62)
    w32(&h, 1)
    w64(&h, 0)
    w64(&h, 0)
    w64(&h, off_sh)
    w32(&h, 0)
    w16(&h, 64)
    w16(&h, 0)
    w16(&h, 0)
    w16(&h, 64)
    w16(&h, 9 + 2 * nf)
    w16(&h, 7)
    for k in 0..64:
        out.b[k] = h.b[k]
    return out
