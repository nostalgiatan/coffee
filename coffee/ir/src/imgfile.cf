/#/ An image on disk (`.cim`): the flat image of a module as `image_of` or `image_sbx_of` made it, so
/#/ a later run is a read and a `mmap` instead of reading the `.cir`, optimizing and generating. The
/#/ file holds the key it was made for (the hash of the `.cir`, the mode), the places a loader needs, the
/#/ code and the linear memory, and a hash of all of that. A file that does not match its key or
/#/ itself is not used; a file that does match is still only as safe as the disk it came from, so the
/#/ sandbox checks the code of an image again whatever its source.
use * in image

/#/ FNV-1a, 64 bits, of the bytes of `t` after the state `h`.
fn fnv64(t: &Txt, h0: int) => int:
    let h = h0
    for i in 0..t.n:
        h = (h ^ int(t.b[i])) * 1099511628211
    return h

fn fnv64_start() => int:
    return 0 - 3750763034362895579

/#/ The key of a `.cir` for a mode (0 native, 1 sandbox, 2 sandbox in the base-register form): its content, and the mode.
fn cim_key(cir: &Txt, mode: int) => int:
    return fnv64(cir, fnv64_start() ^ (mode + 1))

fn blank_image() => Image:
    return Image { b: new_txt(), text_n: 0, ro_at: 0, data_at: 0, stub_at: 0, rx_end: 0, ro_end: 0, slot_at: 0, total: 0, names: new_txt(), sym_name: new_buf(int, 1), sym_at: new_buf(int, 1), nsym: 0, imp_name: new_buf(int, 1), imp_slot: new_buf(int, 1), nimp: 0, err: 0, lin: new_txt(), lin_at: 0, data_lin: 0, ss_base: 0, ss_top: 0, limit: 0, exit_at: 0, hc_at: 0, sys_at: -1 }

/#/ The file for `im` (whose `main` is at `main_at`, -1 when it has none) made for `key`. After the
/#/ four letters come 23 words: the key, `main_at`, `text_n`, `exit_at`, `hc_at`, `sys_at`, `lin_at`,
/#/ `data_lin`, `ss_base`, `ss_top`, `limit`, `ro_at`, `data_at`, `stub_at`, `rx_end`, `ro_end`,
/#/ `slot_at`, `total`, then the counts of symbols, imports, name bytes, code bytes and memory bytes;
/#/ then the names, a (name, place) pair per symbol and per import, the code and the memory.
fn write_cim(im: &Image, main_at: int, key: int) => Txt:
    let out = new_txt()
    out.put("CIM2")
    w64(&out, key)
    w64(&out, main_at)
    w64(&out, im.text_n)
    w64(&out, im.exit_at)
    w64(&out, im.hc_at)
    w64(&out, im.sys_at)
    w64(&out, im.lin_at)
    w64(&out, im.data_lin)
    w64(&out, im.ss_base)
    w64(&out, im.ss_top)
    w64(&out, im.limit)
    w64(&out, im.ro_at)
    w64(&out, im.data_at)
    w64(&out, im.stub_at)
    w64(&out, im.rx_end)
    w64(&out, im.ro_end)
    w64(&out, im.slot_at)
    w64(&out, im.total)
    w64(&out, im.nsym)
    w64(&out, im.nimp)
    w64(&out, im.names.n)
    w64(&out, im.b.n)
    w64(&out, im.lin.n)
    out.put_all(&im.names)
    for k in 0..im.nsym:
        w64(&out, im.sym_name[k])
        w64(&out, im.sym_at[k])
    for k in 0..im.nimp:
        w64(&out, im.imp_name[k])
        w64(&out, im.imp_slot[k])
    out.put_all(&im.b)
    out.put_all(&im.lin)
    w64(&out, fnv64(&out, fnv64_start()))
    return out

fn cim_word(t: &Txt, at: int) => int:
    let v = 0
    for q in 0..8:
        v = v | (int(t.b[at + q]) << (8 * q))
    return v

/#/ The `i`-th word after the four letters.
fn cim_head(t: &Txt, i: int) => int:
    return cim_word(t, 4 + i * 8)

/#/ Fills `im` from the file `t` when it was made for `key` and is whole: the place of `main` (-1 when
/#/ the module has none); else -2.
fn read_cim(t: &Txt, key: int, im: &Image) => int:
    let head = 4 + 23 * 8
    if t.n < head + 8:
        return 0 - 2
    if t.b[0] != 67 || t.b[1] != 73 || t.b[2] != 77 || t.b[3] != 50:
        return 0 - 2
    if cim_head(t, 0) != key:
        return 0 - 2
    let nsym = cim_head(t, 18)
    let nimp = cim_head(t, 19)
    let nn = cim_head(t, 20)
    let nb = cim_head(t, 21)
    let nl = cim_head(t, 22)
    if nsym < 0 || nimp < 0 || nn < 0 || nb < 0 || nl < 0 || nsym > t.n || nimp > t.n || nn > t.n || nb > t.n || nl > t.n:
        return 0 - 2
    if head + nn + 16 * nsym + 16 * nimp + nb + nl + 8 != t.n:
        return 0 - 2
    let body = new_txt()
    for i in 0..t.n - 8:
        body.put_byte(int(t.b[i]))
    if fnv64(&body, fnv64_start()) != cim_word(t, t.n - 8):
        return 0 - 2
    im.text_n = cim_head(t, 2)
    im.exit_at = cim_head(t, 3)
    im.hc_at = cim_head(t, 4)
    im.sys_at = cim_head(t, 5)
    im.lin_at = cim_head(t, 6)
    im.data_lin = cim_head(t, 7)
    im.ss_base = cim_head(t, 8)
    im.ss_top = cim_head(t, 9)
    im.limit = cim_head(t, 10)
    im.ro_at = cim_head(t, 11)
    im.data_at = cim_head(t, 12)
    im.stub_at = cim_head(t, 13)
    im.rx_end = cim_head(t, 14)
    im.ro_end = cim_head(t, 15)
    im.slot_at = cim_head(t, 16)
    im.total = cim_head(t, 17)
    let p = head
    for i in 0..nn:
        im.names.put_byte(int(t.b[p + i]))
    p = p + nn
    im.sym_name = new_buf(int, nsym + 1)
    im.sym_at = new_buf(int, nsym + 1)
    im.nsym = nsym
    for k in 0..nsym:
        im.sym_name[k] = cim_word(t, p)
        im.sym_at[k] = cim_word(t, p + 8)
        p = p + 16
    im.imp_name = new_buf(int, nimp + 1)
    im.imp_slot = new_buf(int, nimp + 1)
    im.nimp = nimp
    for k in 0..nimp:
        im.imp_name[k] = cim_word(t, p)
        im.imp_slot[k] = cim_word(t, p + 8)
        p = p + 16
    for i in 0..nb:
        im.b.put_byte(int(t.b[p + i]))
    p = p + nb
    for i in 0..nl:
        im.lin.put_byte(int(t.b[p + i]))
    if im.text_n < 0 || im.text_n > nb:
        return 0 - 2
    return cim_head(t, 1)
