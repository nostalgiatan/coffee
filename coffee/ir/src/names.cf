/#/ Names of functions, by number: the table the lowering and the backend share.
use * in verify

/#/ Names of functions, by number.
class Names:
    b: buf<int>
    n: int
    off: buf<int>
    cnt: int
    /#/ chains of names by the hash of their text: heads (name + 1), next, hash of each
    nh: buf<int>
    nn: buf<int>
    hs: buf<int>

    fn add(self, name: &str) => int:
        if self.cnt + 1 >= len(self.off):
            self.off = buf_resize(self.off, (self.cnt + 2) * 2)
        self.off[self.cnt] = self.n
        for i in 0..len(name):
            if self.n >= len(self.b):
                self.b = buf_resize(self.b, (self.n + 1) * 2)
            self.b[self.n] = ch(name, i)
            self.n = self.n + 1
        self.off[self.cnt + 1] = self.n
        self.cnt = self.cnt + 1
        self.reg()
        return self.cnt - 1

    /#/ Enters the name just added (the last one) in the chains.
    fn reg(self) => void:
        let id = self.cnt - 1
        if id >= len(self.nn):
            self.nn = buf_resize(self.nn, (id + 1) * 2)
            self.hs = buf_resize(self.hs, (id + 1) * 2)
        let h = 1469598103934665603
        for k in self.off[id]..self.off[id + 1]:
            h = (h ^ self.b[k]) * 1099511628211
        h = h & 4611686018427387903
        self.hs[id] = h
        if self.cnt * 2 > len(self.nh):
            let cap = len(self.nh) * 2
            self.nh = new_buf(int, cap)
            for j in 0..id:
                self.nn[j] = self.nh[self.hs[j] % cap]
                self.nh[self.hs[j] % cap] = j + 1
        self.nn[id] = self.nh[h % len(self.nh)]
        self.nh[h % len(self.nh)] = id + 1

    fn put(self, o: &Txt, id: int) => void:
        for k in self.off[id]..self.off[id + 1]:
            o.put_byte(self.b[k])

    /#/ Adds the name spelled by `w` without looking for it first.
    fn add_bytes(self, w: &Txt) => int:
        if self.cnt + 1 >= len(self.off):
            self.off = buf_resize(self.off, (self.cnt + 2) * 2)
        self.off[self.cnt] = self.n
        for k in 0..w.n:
            if self.n >= len(self.b):
                self.b = buf_resize(self.b, (self.n + 1) * 2)
            self.b[self.n] = w.b[k]
            self.n = self.n + 1
        self.off[self.cnt + 1] = self.n
        self.cnt = self.cnt + 1
        self.reg()
        return self.cnt - 1

    /#/ The number of the name spelled by `w`; -1 when there is none.
    fn find(self, w: &Txt) => int:
        let h = 1469598103934665603
        for k in 0..w.n:
            h = (h ^ w.b[k]) * 1099511628211
        h = h & 4611686018427387903
        let id = self.nh[h % len(self.nh)] - 1
        while id >= 0:
            if self.hs[id] == h && self.off[id + 1] - self.off[id] == w.n:
                let same = true
                for k in 0..w.n:
                    if self.b[self.off[id] + k] != w.b[k]:
                        same = false
                        break
                if same:
                    return id
            id = self.nn[id] - 1
        return -1

    /#/ The number of the name spelled by `w`; added when new.
    fn intern(self, w: &Txt) => int:
        let found = self.find(w)
        if found >= 0:
            return found
        if self.cnt + 1 >= len(self.off):
            self.off = buf_resize(self.off, (self.cnt + 2) * 2)
        self.off[self.cnt] = self.n
        for k in 0..w.n:
            if self.n >= len(self.b):
                self.b = buf_resize(self.b, (self.n + 1) * 2)
            self.b[self.n] = w.b[k]
            self.n = self.n + 1
        self.off[self.cnt + 1] = self.n
        self.cnt = self.cnt + 1
        self.reg()
        return self.cnt - 1

fn new_names() => Names:
    return Names { b: new_buf(int, 64), n: 0, off: new_buf(int, 16), cnt: 0, nh: new_buf(int, 64), nn: new_buf(int, 16), hs: new_buf(int, 16) }
