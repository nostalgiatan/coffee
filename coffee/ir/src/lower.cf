/#/ Lowering: the typed tree of a function to IR, in SSA, in one pass.
/#/
/#/ Variables are not slots: each assignment names a new value, and a read looks the value up
/#/ where the variable was last written, adding block parameters where paths join (Braun et
/#/ al., "Simple and Efficient Construction of SSA Form"). A block is *sealed* when all the
/#/ edges into it exist; a read in an unsealed block makes a parameter that is filled in when
/#/ the block is sealed. Edges are made without arguments and get them as parameters appear
/#/ (`edge_push`); `simplify_params` removes the parameters that were one value all along.
/#/
/#/ What is lowered: scalars (`int`, `bool`, `float`, strings as pointers), locals, `if`/`elif`/
/#/ `else`, `while`, `for` over a range, `break`/`continue`/`return`, calls of plain functions
/#/ and C functions. Anything else sets `bad` and the function is not emitted.
use * in gen
use * in own

/#/ The IR representation of a type; -1 when it has none yet.
fn rep_of(t: &Tys, g: &Syms, x: int) => int:
    let k = t.kind[x]
    if k == int(Ty.Void):
        return int(Rp.Void)
    if k == int(Ty.Bool):
        return int(Rp.I8)
    if k == int(Ty.Int):
        if t.a[x] == 1:
            return int(Rp.I8)
        if t.a[x] == 2:
            return int(Rp.I16)
        if t.a[x] == 4:
            return int(Rp.I32)
        if t.a[x] == 8:
            return int(Rp.I64)
        return -1
    if k == int(Ty.Float):
        if t.a[x] == 4:
            return int(Rp.F32)
        if t.a[x] == 8:
            return int(Rp.F64)
        return -1
    if k == int(Ty.Str) || k == int(Ty.Object) || k == int(Ty.Ref) || k == int(Ty.Fn):
        return int(Rp.Ptr)
    if k == int(Ty.Buf) && t.a[x] < 0:
        return int(Rp.Ptr)
    if k == int(Ty.Array):
        return int(Rp.Ptr)
    if k == int(Ty.Named):
        if g.kind[t.a[x]] == int(Sk.Class):
            return int(Rp.Ptr)
        if g.kind[t.a[x]] == int(Sk.Enum):
            if has_payload(t, g, t.a[x]):
                return int(Rp.Ptr)
            return int(Rp.I64)
    return -1

/#/ Is `x` an integer type that is signed?
fn is_signed(t: &Tys, x: int) => bool:
    return t.kind[x] == int(Ty.Int) && t.b[x] == 1

fn bytes_of_rep(r: int) => int:
    if r == int(Rp.I8):
        return 1
    if r == int(Rp.I16):
        return 2
    if r == int(Rp.I32) || r == int(Rp.F32):
        return 4
    return 8

/#/ The bits of the float literal at `tok`, as a double or (`single`) as a float; -1 when
/#/ the literal is not one this can convert exactly (more than 15 digits, a huge exponent).
fn float_bits(a: &Ast, tok: int, single: bool) => int:
    let s = a.toks.start[tok]
    let e = a.toks.end[tok]
    let m = 0
    let digits = 0
    let scale = 0
    let seen_dot = false
    let k = s
    while k < e:
        let c = a.byte_at(k)
        if c >= '0' && c <= '9':
            m = m * 10 + (c - '0')
            digits = digits + 1
            if seen_dot:
                scale = scale - 1
        elif c == '.':
            seen_dot = true
        elif c == 'e' || c == 'E':
            break
        elif c != '_':
            return -1
        k = k + 1
    if k < e:
        k = k + 1
        let neg = false
        if k < e && (a.byte_at(k) == '-' || a.byte_at(k) == '+'):
            neg = a.byte_at(k) == '-'
            k = k + 1
        let x = 0
        while k < e:
            x = x * 10 + (a.byte_at(k) - '0')
            k = k + 1
        if neg:
            x = 0 - x
        scale = scale + x
    while scale < 0 && m > 0 && m % 10 == 0:
        m = m // 10
        scale = scale + 1
    if digits > 18 || m > 9007199254740992 || scale > 22 || scale < -22:
        return -1
    if m == 0:
        return 0
    let v = float(m)
    let p = 1.0
    let q = scale
    if q < 0:
        q = 0 - q
    for i in 0..q:
        p = p * 10.0
    if scale < 0:
        v = v / p
    else:
        v = v * p
    let ex = 0
    while v >= 2.0:
        v = v / 2.0
        ex = ex + 1
    while v < 1.0:
        v = v * 2.0
        ex = ex - 1
    if single:
        let frac = int((v - 1.0) * 8388608.0 + 0.5)
        if frac >= 8388608:
            frac = 0
            ex = ex + 1
        if ex < -126 || ex > 127:
            return -1
        return ((ex + 127) << 23) | frac
    if ex < -1022 || ex > 1023:
        return -1
    let frac = int((v - 1.0) * 4503599627370496.0)
    return ((ex + 1023) << 52) | frac

/#/ Does a value of type `x` own something that has to be released?
fn needs_drop(t: &Tys, g: &Syms, x: int) => bool:
    let k = t.kind[x]
    if k == int(Ty.Str) || k == int(Ty.Array):
        return true
    if k == int(Ty.Buf):
        return t.a[x] >= 0
    if k == int(Ty.Tuple):
        for i in 0..t.count_of(x):
            if needs_drop(t, g, t.arg(x, i)):
                return true
        return false
    if k == int(Ty.Named):
        if g.kind[t.a[x]] == int(Sk.Enum):
            return has_payload(t, g, t.a[x])
        return g.kind[t.a[x]] == int(Sk.Class)
    return false

/#/ Is `x` a class none of whose fields owns anything? Its drop is then only the free.
fn class_plain(t: &Tys, g: &Syms, x: int) => bool:
    if g.kind[t.a[x]] != int(Sk.Class):
        return false
    let cur = t.a[x]
    let n = 0
    while cur >= 0 && n < 8:
        for i in 0..g.n:
            if g.info[i] == cur && g.kind[i] == int(Sk.Field) && g.ty[i] >= 0:
                if needs_drop(t, g, subst_env(t, g.ty[i], x)):
                    return false
        n = n + 1
        let next = -1
        for i in 0..g.n:
            if g.info[i] == cur && g.kind[i] == int(Sk.Parent):
                next = g.find_class_row(i)
        cur = next
    return true

/#/ Is a value of type `x` moved, not copied, when it is used as a value? (Arrays are
/#/ copied: a copy is a new block.)
fn is_moved(t: &Tys, g: &Syms, x: int) => bool:
    return needs_drop(t, g, x) && t.kind[x] != int(Ty.Array)

/#/ The value of a hexadecimal digit, -1 for any other byte.
fn hex_val(c: int) => int:
    if c >= '0' && c <= '9':
        return c - '0'
    if c >= 'a' && c <= 'f':
        return c - 'a' + 10
    if c >= 'A' && c <= 'F':
        return c - 'A' + 10
    return 0 - 1

class Lower:
    f: Fun
    rs: Reps
    names: Names
    nstr: int
    /#/ C functions called: name, signature type, variadic
    cd_name: buf<int>
    cd_sig: buf<int>
    cd_var: buf<int>
    cd_n: int
    /#/ variables
    sc: Syms
    v_rep: buf<int>
    v_ty: buf<int>
    nv: int
    /#/ the value of a variable at the end of a block, by (variable, block)
    dk: buf<int>
    dv: buf<int>
    dn: int
    /#/ blocks: sealed, the parameters waiting for their arguments, the edges that reach it
    sealed: buf<int>
    inc_head: buf<int>
    inc_var: buf<int>
    inc_par: buf<int>
    inc_next: buf<int>
    inc_n: int
    pe_head: buf<int>
    pe_next: buf<int>
    /#/ loops: where `continue` and `break` go
    lc: buf<int>
    lb: buf<int>
    nloops: int
    /#/ variables that live in a slot: its value, or -1; the names `&` is applied to
    v_slot: buf<int>
    /#/ the variable holding 1 while a variable still owns its value, or -1
    v_flag: buf<int>
    /#/ owned temporaries that were only borrowed: released at the end of the statement
    tmp_v: buf<int>
    tmp_ty: buf<int>
    tmp_n: int
    no_own: int
    /#/ the owning variables in scope, innermost last
    own_st: buf<int>
    own_n: int
    /#/ the scope depth each loop was entered at
    ld: buf<int>
    /#/ drop and clone functions still to be generated: type, kind (0 drop, 1 clone)
    glue_ty: buf<int>
    glue_kind: buf<int>
    glue_n: int
    glue_done: int
    /#/ the fields of a class in layout order: type and offset
    lay_ty: buf<int>
    lay_off: buf<int>
    lay_n: int
    addr: Names
    scanned: int
    /#/ the type of the field or element the last lookup found
    fty: int
    /#/ names of what generated code calls
    rt_exit: int
    rt_calloc: int
    rt_strlen: int
    rt_malloc: int
    rt_free: int
    rt_strdup: int
    rt_memcpy: int
    rt_strcmp: int
    rt_write: int
    /#/ while the later alternative of an or-pattern binds: the scope row where its names start
    or_mark: int
    /#/ 0: the function is emitted as lowered; above: the optimizer runs first
    opt: int
    /#/ 0: LLVM text, 1: x86-64 machine code in an object file
    mc: Gen
    sbytes: Txt
    mc_err: int
    ver_err: int
    /#/ the functions lowered so far, kept as IR until `finish`
    lib: Lib
    /#/ the name number of the function in `f`
    cur_id: int
    /#/ the type arguments the function being lowered is instantiated with, as `Name<A, B>`; -1 if none
    penv: int
    /#/ scratch: what `unify` found for each type parameter
    ue: buf<int>
    /#/ instances asked for and not lowered yet: function node, arguments, class row
    iq_node: buf<int>
    iq_env: buf<int>
    iq_cls: buf<int>
    /#/ the name an instance is lowered under, -1 for the one its node spells
    iq_nm: buf<int>
    iq_n: int
    iq_done: int
    /#/ the name of the listener of the function being lowered, -1 for none
    lis: int
    /#/ the functions declared in the body being lowered: name token, node, and the name they get
    nf_tok: buf<int>
    nf_node: buf<int>
    nf_id: buf<int>
    nf_n: int
    /#/ the name the function being lowered is given, -1 for the one its node spells
    pnm: int
    /#/ the block whose last expression is the value returned, the `match` whose arms' blocks are
    /#/ such blocks, and the expression statement to lower as a `return`; -1 for none
    tailb: int
    tailm: int
    retx: int
    /#/ the module-level `let`s: the symbol name and the size in bytes
    gl_name: buf<int>
    gl_size: buf<int>
    gl_n: int
    /#/ the return type of the function
    ret_ty: int
    bad: int
    bad_node: int

    /#/ The type of node `n`, with the type parameters of the instance being lowered replaced.
    fn nd(self, t: &Tys, ty: &Typer, n: int) => int:
        return subst_env(t, ty.node[n], self.penv)

    /#/ `base` with `__N` for the instance arguments `env`.
    fn inst_name(self, base: &Txt, env: int) => int:
        let w = new_txt()
        w.put_all(base)
        w.put("__")
        w.put_int(env)
        return self.names.intern(&w)

    /#/ Asks for the function node `node` (of class row `cls`, -1 for a free function) to be
    /#/ lowered with the arguments `env`.
    fn want_instance(self, node: int, env: int, cls: int) => void:
        for i in 0..self.iq_n:
            if self.iq_node[i] == node && self.iq_env[i] == env && self.iq_cls[i] == cls:
                return
        if self.iq_n >= len(self.iq_node):
            let cap = (self.iq_n + 1) * 2
            self.iq_node = buf_resize(self.iq_node, cap)
            self.iq_env = buf_resize(self.iq_env, cap)
            self.iq_cls = buf_resize(self.iq_cls, cap)
            self.iq_nm = buf_resize(self.iq_nm, cap)
        self.iq_node[self.iq_n] = node
        self.iq_env[self.iq_n] = env
        self.iq_cls[self.iq_n] = cls
        self.iq_nm[self.iq_n] = -1
        self.iq_n = self.iq_n + 1

    /#/ Asks for the function node `node`, declared inside a body, to be lowered as name `nm`.
    fn want_named(self, node: int, nm: int) => void:
        self.want_instance(node, -1, -1)
        self.iq_nm[self.iq_n - 1] = nm

    /#/ Lowers the instances asked for, and those they ask for in turn; their text goes to `o`.
    fn run_instances(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, o: &Txt) => void:
        while self.iq_done < self.iq_n:
            let i = self.iq_done
            self.iq_done = i + 1
            self.penv = self.iq_env[i]
            self.pnm = self.iq_nm[i]
            self.function(t, g, ty, a, self.iq_node[i], self.iq_cls[i])
            self.penv = -1
            self.pnm = -1
            if self.bad > 0:
                return
            self.keep_current()

    /#/ The function node of the top-level function named by token `tok` of `a`, -1 if none.
    fn fn_node_of(self, a: &Ast, tok: int) => int:
        let it = a.child[a.root]
        while it >= 0:
            if a.kind[it] == int(Nk.Fn) && a.pa[it] == tok:
                return it
            it = a.next[it]
        return -1

    /#/ The method node named like token `tok` in the class node of class row `row`, -1 if none.
    fn method_node_of(self, g: &Syms, a: &Ast, row: int, tok: int) => int:
        let it = a.child[a.root]
        while it >= 0:
            if a.kind[it] == int(Nk.Class) && a.pa[it] >= 0 && g.tok[row] == a.pa[it]:
                let m = a.child[it]
                while m >= 0:
                    if a.kind[m] == int(Nk.Fn) && a.pa[m] >= 0 && same_text(a, a.pa[m], tok):
                        return m
                    m = a.next[m]
            it = a.next[it]
        return -1

    /#/ Binds the type parameters in `p` (a type of a generic signature) to what they stand for
    /#/ in `x`, into `env`.
    fn unify(self, t: &Tys, p: int, x: int) => void:
        if p < 0 || x < 0:
            return
        let k = t.kind[p]
        if k == int(Ty.Param):
            if t.a[p] < len(self.ue) && self.ue[t.a[p]] < 0:
                self.ue[t.a[p]] = x
            return
        if t.kind[x] != k:
            return
        if k == int(Ty.Ref) || k == int(Ty.Slice) || k == int(Ty.Array) || (k == int(Ty.Buf) && t.a[p] >= 0 && t.a[x] >= 0):
            self.unify(t, t.a[p], t.a[x])
            return
        if k == int(Ty.Tuple) || k == int(Ty.Fn) || k == int(Ty.Named):
            if t.count_of(p) != t.count_of(x):
                return
            for i in 0..t.count_of(p):
                self.unify(t, t.arg(p, i), t.arg(x, i))

    fn unsupported(self, n: int) => void:
        if self.bad == 0:
            self.bad_node = n
        self.bad = self.bad + 1

    /#/ ---- blocks and edges ----------------------------------------------------

    fn new_block(self) => int:
        let b = self.f.new_block()
        if b >= len(self.sealed):
            let cap = (b + 1) * 2
            self.sealed = buf_resize(self.sealed, cap)
            self.inc_head = buf_resize(self.inc_head, cap)
            self.pe_head = buf_resize(self.pe_head, cap)
        self.sealed[b] = 0
        self.inc_head[b] = -1
        self.pe_head[b] = -1
        return b

    /#/ Remembers that edge `e` reaches `target`.
    fn note_edge(self, e: int, target: int) => void:
        if e >= len(self.pe_next):
            self.pe_next = buf_resize(self.pe_next, (e + 1) * 2)
        self.pe_next[e] = self.pe_head[target]
        self.pe_head[target] = e

    /#/ Ends the current block with a jump.
    fn jump(self, target: int) => void:
        if self.f.terminated(self.f.cur):
            return
        let t = self.f.br(target)
        self.note_edge(self.f.aux[t], target)

    fn branch(self, cond: int, yes: int, no: int) => void:
        if self.f.terminated(self.f.cur):
            return
        let e1 = self.f.mk_edge(yes)
        let e2 = self.f.mk_edge(no)
        self.note_edge(e1, yes)
        self.note_edge(e2, no)
        self.f.condbr(cond, e1, e2)

    /#/ Moves on to a block nothing reaches: the code after a `return` or `break`.
    fn dead_block(self) => void:
        let b = self.new_block()
        self.sealed[b] = 1
        self.f.set_block(b)

    /#/ ---- variables -----------------------------------------------------------

    fn d_find(self, v: int, b: int) => int:
        let key = v * 4194304 + b + 1
        let m = len(self.dk) - 1
        let h = (key * 40503) & m
        while self.dk[h] != 0:
            if self.dk[h] == key:
                return self.dv[h]
            h = (h + 1) & m
        return -1

    fn d_set(self, v: int, b: int, val: int) => void:
        if (self.dn + 1) * 2 > len(self.dk):
            let cap = len(self.dk) * 2
            let nk: buf<int> = new_buf(int, cap)
            let nv: buf<int> = new_buf(int, cap)
            for i in 0..cap:
                nk[i] = 0
            for i in 0..len(self.dk):
                let key = self.dk[i]
                if key != 0:
                    let h = (key * 40503) & (cap - 1)
                    while nk[h] != 0:
                        h = (h + 1) & (cap - 1)
                    nk[h] = key
                    nv[h] = self.dv[i]
            self.dk = nk
            self.dv = nv
        let key = v * 4194304 + b + 1
        self.d_put(key, val)

    fn d_put(self, key: int, val: int) => void:
        let m = len(self.dk) - 1
        let h = (key * 40503) & m
        while self.dk[h] != 0 && self.dk[h] != key:
            h = (h + 1) & m
        if self.dk[h] == 0:
            self.dn = self.dn + 1
        self.dk[h] = key
        self.dv[h] = val

    fn write_var(self, v: int, b: int, val: int) => void:
        self.d_set(v, b, val)

    fn read_var(self, v: int, b: int) => int:
        let x = self.d_find(v, b)
        if x >= 0:
            return self.f.follow(x)
        return self.read_rec(v, b)

    fn read_rec(self, v: int, b: int) => int:
        let rep = self.v_rep[v]
        if self.sealed[b] == 0:
            let p = self.f.param(b, rep, -1)
            if self.inc_n >= len(self.inc_var):
                let cap = (self.inc_n + 1) * 2
                self.inc_var = buf_resize(self.inc_var, cap)
                self.inc_par = buf_resize(self.inc_par, cap)
                self.inc_next = buf_resize(self.inc_next, cap)
            /#/ kept in creation order: a list with a tail would do; the lists are short
            self.inc_var[self.inc_n] = v
            self.inc_par[self.inc_n] = p
            self.inc_next[self.inc_n] = -1
            let last = self.inc_head[b]
            if last < 0:
                self.inc_head[b] = self.inc_n
            else:
                while self.inc_next[last] >= 0:
                    last = self.inc_next[last]
                self.inc_next[last] = self.inc_n
            self.inc_n = self.inc_n + 1
            self.write_var(v, b, p)
            return p
        let n = 0
        let only = -1
        let e = self.pe_head[b]
        while e >= 0:
            if self.f.eto[e] == b:
                n = n + 1
                only = e
            e = self.pe_next[e]
        let val = -1
        if n == 0:
            val = self.f.undef(rep)
        elif n == 1:
            val = self.read_var(v, self.f.efrom[only])
        else:
            let p = self.f.param(b, rep, -1)
            self.write_var(v, b, p)
            self.fill(v, b)
            val = p
        self.write_var(v, b, val)
        return val

    /#/ Passes the value of `v` along every edge into `b`, for the parameter just made.
    fn fill(self, v: int, b: int) => void:
        /#/ the edges in the order they were made
        let es: buf<int> = new_buf(int, 8)
        let n = 0
        let e = self.pe_head[b]
        while e >= 0:
            if self.f.eto[e] == b:
                if n >= len(es):
                    es = buf_resize(es, n * 2)
                es[n] = e
                n = n + 1
            e = self.pe_next[e]
        let k = n - 1
        while k >= 0:
            let x = self.read_var(v, self.f.efrom[es[k]])
            edge_push(&self.f, es[k], x)
            k = k - 1

    /#/ All the edges into `b` exist now.
    fn seal(self, b: int) => void:
        let i = self.inc_head[b]
        while i >= 0:
            self.fill(self.inc_var[i], b)
            i = self.inc_next[i]
        self.inc_head[b] = -1
        self.sealed[b] = 1

    fn new_var(self, a: &Ast, tok: int, rep: int, ty: int) => int:
        if self.nv >= len(self.v_rep):
            self.v_rep = buf_resize(self.v_rep, (self.nv + 1) * 2)
            self.v_ty = buf_resize(self.v_ty, (self.nv + 1) * 2)
            self.v_slot = buf_resize(self.v_slot, (self.nv + 1) * 2)
            self.v_flag = buf_resize(self.v_flag, (self.nv + 1) * 2)
        let id = self.nv
        self.v_rep[id] = rep
        self.v_ty[id] = ty
        self.v_slot[id] = -1
        self.v_flag[id] = -1
        self.nv = id + 1
        if tok >= 0:
            self.sc.add_tok(a, tok, int(Sk.Local), id, 0)
        return id

    /#/ ---- conversions ---------------------------------------------------------

    /#/ `x`, of type `from`, as a value of type `to`.
    fn coerce(self, t: &Tys, g: &Syms, x: int, from: int, to: int) => int:
        if t.kind[to] == int(Ty.Slice) && t.kind[from] == int(Ty.Array):
            /#/ an array lent as a slice: its address and its length
            let sl = self.f.insert(self.f.undef(self.rep(t, g, to)), x, 0)
            return self.f.insert(sl, self.f.cint(int(Rp.I64), t.b[from]), 1)
        return self.coerce_rep(t, x, from, self.rep(t, g, to), to)

    fn coerce_rep(self, t: &Tys, x: int, from: int, tr: int, to: int) => int:
        let fr = self.f.rep[x]
        if fr == tr || tr < 0:
            return x
        let ti = rp_is_int(tr)
        let fi = rp_is_int(fr)
        if t.kind[to] == int(Ty.Bool):
            if fi:
                return self.f.cmp(int(Pr.Ne), x, self.f.cint(fr, 0))
            if rp_is_float(fr):
                return self.f.fcmp(int(Pr.ONe), x, self.f.cfloat(fr, 0))
            return x
        if fi && ti:
            if rp_bits(tr) > rp_bits(fr):
                if is_signed(t, from):
                    return self.f.conv(int(Op.SExt), tr, x)
                return self.f.conv(int(Op.ZExt), tr, x)
            return self.f.conv(int(Op.Trunc), tr, x)
        if fi && rp_is_float(tr):
            if is_signed(t, from):
                return self.f.conv(int(Op.SiToFp), tr, x)
            return self.f.conv(int(Op.UiToFp), tr, x)
        if rp_is_float(fr) && ti:
            if is_signed(t, to):
                return self.f.conv(int(Op.FpToSi), tr, x)
            return self.f.conv(int(Op.FpToUi), tr, x)
        if rp_is_float(fr) && rp_is_float(tr):
            if rp_bits(tr) > rp_bits(fr):
                return self.f.conv(int(Op.FpExt), tr, x)
            return self.f.conv(int(Op.FpTrunc), tr, x)
        if fr == int(Rp.Ptr) && ti:
            return self.f.conv(int(Op.PtrToInt), tr, x)
        if fi && tr == int(Rp.Ptr):
            return self.f.conv(int(Op.IntToPtr), tr, x)
        return x

    /#/ ---- expressions ---------------------------------------------------------

    /#/ The bytes of string literal token `tok`, escapes resolved.
    fn str_text(self, a: &Ast, tok: int) => Txt:
        return self.str_range(a, a.toks.start[tok] + 1, a.toks.end[tok] - 1)

    /#/ The bytes `s`..`e` of the source read as the inside of a string literal.
    fn str_range(self, a: &Ast, s: int, e: int) => Txt:
        let body = new_txt()
        let k = s
        while k < e:
            let c = a.byte_at(k)
            if c == '\\' && k + 1 < e:
                k = k + 1
                let d = a.byte_at(k)
                if d == 'n':
                    c = 10
                elif d == 't':
                    c = 9
                elif d == 'r':
                    c = 13
                elif d == '0':
                    c = 0
                elif d == 'x' && k + 2 < e && hex_val(a.byte_at(k + 1)) >= 0 && hex_val(a.byte_at(k + 2)) >= 0:
                    c = hex_val(a.byte_at(k + 1)) * 16 + hex_val(a.byte_at(k + 2))
                    k = k + 2
                else:
                    c = d
            body.put_byte(c)
            k = k + 1
        return body

    /#/ Appends the bytes of string literal `tok` to `o`.
    fn put_text(self, o: &Txt, a: &Ast, tok: int) => void:
        let body = self.str_text(a, tok)
        o.put_all(&body)

    fn text_global(self, body: &Txt) => int:
        let id = self.nstr
        self.nstr = id + 1
        self.mc.add_str(self.sbytes.n)
        self.sbytes.put_all(body)
        self.sbytes.put_byte(0)
        return id

    fn str_lit(self, a: &Ast, tok: int) => int:
        let body = self.str_text(a, tok)
        return self.text_global(&body)

    fn binary(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let op = op_of(a.pc[n])
        let l = a.pa[n]
        let r = a.pb[n]
        if op == int(Bop.And) || op == int(Bop.Or):
            return self.logic(t, g, ty, a, n, op == int(Bop.And))
        let lt = self.nd(t, ty, l)
        let rt = self.nd(t, ty, r)
        if t.kind[self.strip_refs(t, lt)] == int(Ty.Str) && t.kind[self.strip_refs(t, rt)] == int(Ty.Str):
            return self.str_op(t, g, ty, a, n, op)
        if self.rep(t, g, lt) < 0 || self.rep(t, g, rt) < 0 || t.kind[lt] == int(Ty.Str) || t.kind[rt] == int(Ty.Str):
            self.unsupported(n)
            return self.f.undef(int(Rp.I8))
        let x = self.ex(t, g, ty, a, l)
        let y = self.ex(t, g, ty, a, r)
        if op >= int(Bop.Eq) && op <= int(Bop.Ge):
            return self.compare(t, g, op, x, y, lt, rt)
        let res = self.nd(t, ty, n)
        let rr = self.rep(t, g, res)
        if rr < 0 || t.kind[res] == int(Ty.Object):
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let is_flt = rp_is_float(rr)
        if op == int(Bop.Shl) || op == int(Bop.Shr):
            let amount = self.coerce(t, g, y, rt, res)
            let v = self.coerce(t, g, x, lt, res)
            if op == int(Bop.Shl):
                return self.f.bin(int(Op.Shl), v, amount)
            if is_signed(t, res):
                return self.f.bin(int(Op.AShr), v, amount)
            return self.f.bin(int(Op.LShr), v, amount)
        let v = self.coerce(t, g, x, lt, res)
        let w = self.coerce(t, g, y, rt, res)
        let sg = is_signed(t, res)
        if op == int(Bop.Add):
            if is_flt:
                return self.f.bin(int(Op.FAdd), v, w)
            return self.f.bin(int(Op.Add), v, w)
        if op == int(Bop.Sub):
            if is_flt:
                return self.f.bin(int(Op.FSub), v, w)
            return self.f.bin(int(Op.Sub), v, w)
        if op == int(Bop.Mul):
            if is_flt:
                return self.f.bin(int(Op.FMul), v, w)
            return self.f.bin(int(Op.Mul), v, w)
        if op == int(Bop.Div):
            return self.f.bin(int(Op.FDiv), v, w)
        if op == int(Bop.IDiv):
            if sg:
                return self.f.bin(int(Op.SDiv), v, w)
            return self.f.bin(int(Op.UDiv), v, w)
        if op == int(Bop.Rem):
            if is_flt:
                return self.f.bin(int(Op.FRem), v, w)
            if sg:
                return self.f.bin(int(Op.SRem), v, w)
            return self.f.bin(int(Op.URem), v, w)
        if op == int(Bop.BitAnd):
            return self.f.bin(int(Op.And), v, w)
        if op == int(Bop.BitOr):
            return self.f.bin(int(Op.Or), v, w)
        return self.f.bin(int(Op.Xor), v, w)

    /#/ A comparison of two values of types `lt` and `rt`, as a `bool`.
    /#/ `a + b` of strings makes a new string; `==` and `!=` compare the text.
    fn str_op(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int, op: int) => int:
        let x = self.exb(t, g, ty, a, a.pa[n])
        let y = self.exb(t, g, ty, a, a.pb[n])
        if op == int(Bop.Eq) || op == int(Bop.Ne):
            self.f.arg(x)
            self.f.arg(y)
            let c = self.f.ccall(int(Rp.I32), 2, self.rt_strcmp, 0)
            let p = int(Pr.Eq)
            if op == int(Bop.Ne):
                p = int(Pr.Ne)
            return self.f.cmp(p, c, self.f.cint(int(Rp.I32), 0))
        if op != int(Bop.Add):
            self.unsupported(n)
            return self.f.undef(int(Rp.Ptr))
        return self.str_cat(x, y)

    /#/ A new string: the text of `x` and then the text of `y`.
    fn str_cat(self, x: int, y: int) => int:
        self.f.arg(x)
        let lx = self.f.ccall(int(Rp.I64), 1, self.rt_strlen, 0)
        self.f.arg(y)
        let ly = self.f.ccall(int(Rp.I64), 1, self.rt_strlen, 0)
        let total = self.f.bin(int(Op.Add), self.f.bin(int(Op.Add), lx, ly), self.f.cint(int(Rp.I64), 1))
        self.f.arg(total)
        let p = self.f.ccall(int(Rp.Ptr), 1, self.rt_malloc, 0)
        self.f.arg(p)
        self.f.arg(x)
        self.f.arg(lx)
        self.f.ccall(int(Rp.Ptr), 3, self.rt_memcpy, 0)
        self.f.arg(self.f.index(p, lx, 1))
        self.f.arg(y)
        self.f.arg(self.f.bin(int(Op.Add), ly, self.f.cint(int(Rp.I64), 1)))
        self.f.ccall(int(Rp.Ptr), 3, self.rt_memcpy, 0)
        return p

    /#/ `f"text {expr} text"`: the text pieces and the expressions, each as text, joined. A string
    /#/ expression is only read; an int or float is printed (`%lld`, `%g`) into a fresh buffer.
    fn fstr(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let tk = a.tok[n]
        let from = a.toks.start[tk] + 2
        let e = a.toks.end[tk] - 1
        let empty = new_txt()
        let acc = self.f.strlit(self.text_global(&empty))
        let owned = false
        let p = a.child[n]
        while p >= 0:
            if a.pb[p] > from:
                let body = self.str_range(a, from, a.pb[p])
                let nx = self.str_cat(acc, self.f.strlit(self.text_global(&body)))
                if owned:
                    self.f.free(acc)
                acc = nx
                owned = true
            let x = a.pa[p]
            let xt = self.strip_refs(t, self.nd(t, ty, x))
            let fresh = -1
            let v = -1
            if t.kind[xt] == int(Ty.Str):
                v = self.exb(t, g, ty, a, x)
            elif t.kind[xt] == int(Ty.Bool):
                let names = new_txt()
                names.put("false")
                names.put_byte(0)
                names.put("true")
                let base = self.f.strlit(self.text_global(&names))
                let flag = self.f.conv(int(Op.ZExt), int(Rp.I64), self.ex(t, g, ty, a, x))
                v = self.f.index(base, self.f.bin(int(Op.Mul), flag, self.f.cint(int(Rp.I64), 6)), 1)
            elif t.kind[xt] == int(Ty.Int) || t.kind[xt] == int(Ty.Float):
                let fmt = new_txt()
                let num = self.ex(t, g, ty, a, x)
                if t.kind[xt] == int(Ty.Int):
                    fmt.put("%lld")
                    num = self.coerce(t, g, num, self.nd(t, ty, x), t.int_ty(8, true))
                else:
                    fmt.put("%g")
                    num = self.coerce(t, g, num, self.nd(t, ty, x), t.float_ty(8))
                self.f.arg(self.f.cint(int(Rp.I64), 40))
                fresh = self.f.ccall(int(Rp.Ptr), 1, self.rt_malloc, 0)
                self.f.arg(fresh)
                self.f.arg(self.f.cint(int(Rp.I64), 40))
                self.f.arg(self.f.strlit(self.text_global(&fmt)))
                self.f.arg(num)
                let sn = new_txt()
                sn.put("snprintf")
                self.f.ccall(int(Rp.I32), 3, self.names.intern(&sn), 1)
                v = fresh
            else:
                self.unsupported(n)
                return acc
            let nx = self.str_cat(acc, v)
            if owned:
                self.f.free(acc)
            acc = nx
            owned = true
            if fresh >= 0:
                self.f.free(fresh)
            from = a.pc[p] + 1
            p = a.next[p]
        if e > from:
            let body = self.str_range(a, from, e)
            let nx = self.str_cat(acc, self.f.strlit(self.text_global(&body)))
            if owned:
                self.f.free(acc)
            acc = nx
            owned = true
        if !owned:
            acc = self.str_cat(acc, self.f.strlit(self.text_global(&empty)))
        return acc

    fn compare(self, t: &Tys, g: &Syms, op: int, x: int, y: int, lt: int, rt: int) => int:
        let fx = self.f.rep[x]
        let fy = self.f.rep[y]
        let wide = lt
        if rp_is_float(fy) && !rp_is_float(fx):
            wide = rt
        elif bytes_of_rep(fy) > bytes_of_rep(fx) && rp_is_float(fx) == rp_is_float(fy):
            wide = rt
        let v = self.coerce(t, g, x, lt, wide)
        let w = self.coerce(t, g, y, rt, wide)
        let wr = self.rep(t, g, wide)
        if rp_is_float(wr):
            let p = int(Pr.OEq)
            if op == int(Bop.Ne):
                p = int(Pr.ONe)
            elif op == int(Bop.Lt):
                p = int(Pr.OLt)
            elif op == int(Bop.Le):
                p = int(Pr.OLe)
            elif op == int(Bop.Gt):
                p = int(Pr.OGt)
            elif op == int(Bop.Ge):
                p = int(Pr.OGe)
            return self.f.fcmp(p, v, w)
        let sg = is_signed(t, wide)
        let p = int(Pr.Eq)
        if op == int(Bop.Ne):
            p = int(Pr.Ne)
        elif op == int(Bop.Lt):
            p = int(Pr.SLt)
            if !sg:
                p = int(Pr.ULt)
        elif op == int(Bop.Le):
            p = int(Pr.SLe)
            if !sg:
                p = int(Pr.ULe)
        elif op == int(Bop.Gt):
            p = int(Pr.SGt)
            if !sg:
                p = int(Pr.UGt)
        elif op == int(Bop.Ge):
            p = int(Pr.SGe)
            if !sg:
                p = int(Pr.UGe)
        return self.f.cmp(p, v, w)

    /#/ `l && r` and `l || r`: the right side runs only when the left does not decide. The
    /#/ result is a variable written on both paths and read where they meet.
    fn logic(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int, is_and: bool) => int:
        let res = self.new_var(a, -1, int(Rp.I8), -1)
        let l = self.ex(t, g, ty, a, a.pa[n])
        let rhs = self.new_block()
        let join = self.new_block()
        self.write_var(res, self.f.cur, self.f.cint(int(Rp.I8), 0))
        if !is_and:
            self.write_var(res, self.f.cur, self.f.cint(int(Rp.I8), 1))
        if is_and:
            self.branch(l, rhs, join)
        else:
            self.branch(l, join, rhs)
        self.seal(rhs)
        self.f.set_block(rhs)
        let r = self.ex(t, g, ty, a, a.pb[n])
        self.write_var(res, self.f.cur, r)
        self.jump(join)
        self.seal(join)
        self.f.set_block(join)
        return self.read_var(res, join)

    /#/ The slot of the function declared in this body that token `tok` names, -1 if none.
    fn nested_find(self, a: &Ast, tok: int) => int:
        let i = self.nf_n
        while i > 0:
            i = i - 1
            if same_text(a, self.nf_tok[i], tok):
                return i
        return -1

    /#/ Declares the function node `n` in this body; it is lowered as `outer__name`.
    fn nested_declare(self, a: &Ast, n: int) => void:
        let w = new_txt()
        self.names.put(&w, self.cur_id)
        w.put("__")
        for q in a.toks.start[a.pa[n]]..a.toks.end[a.pa[n]]:
            w.put_byte(a.byte_at(q))
        let id = self.names.intern(&w)
        if self.nf_n >= len(self.nf_tok):
            let cap = (self.nf_n + 1) * 2
            self.nf_tok = buf_resize(self.nf_tok, cap)
            self.nf_node = buf_resize(self.nf_node, cap)
            self.nf_id = buf_resize(self.nf_id, cap)
        self.nf_tok[self.nf_n] = a.pa[n]
        self.nf_node[self.nf_n] = n
        self.nf_id[self.nf_n] = id
        self.nf_n = self.nf_n + 1
        self.want_named(n, id)

    /#/ Lets a function declared in a body call itself by its name.
    fn nested_declare_self(self, a: &Ast, n: int) => void:
        if a.pa[n] < 0:
            return
        self.nf_tok[0] = a.pa[n]
        self.nf_node[0] = n
        self.nf_id[0] = self.pnm
        self.nf_n = 1

    /#/ The row of the module-level `let` that token `tok` names, -1 if none.
    fn global_row(self, g: &Syms, ty: &Typer, a: &Ast, tok: int) => int:
        let r = g.find_in_module(a, tok, ty.cur)
        if r >= 0 && g.kind[r] == int(Sk.Global):
            return r
        return -1

    /#/ The symbol of the module-level `let` named by token `tok`.
    fn global_sym(self, a: &Ast, tok: int) => int:
        let w = new_txt()
        w.put("coffee_g_")
        for q in a.toks.start[tok]..a.toks.end[tok]:
            w.put_byte(a.byte_at(q))
        return self.names.intern(&w)

    /#/ Makes the module-level `let`s exist and gives them their values; this opens `main`.
    fn init_globals(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast) => void:
        let it = a.child[a.root]
        while it >= 0:
            if a.kind[it] == int(Nk.Let) && a.pa[it] >= 0:
                let vt = self.nd(t, ty, it)
                let vr = self.rep(t, g, vt)
                if vr < 0 || vr == int(Rp.Void) || vr >= rp_first_agg() || needs_drop(t, g, vt) || a.pc[it] < 0:
                    self.unsupported(it)
                    return
                let id = self.global_sym(a, a.pa[it])
                if self.gl_n >= len(self.gl_name):
                    let cap = (self.gl_n + 1) * 2
                    self.gl_name = buf_resize(self.gl_name, cap)
                    self.gl_size = buf_resize(self.gl_size, cap)
                self.gl_name[self.gl_n] = id
                self.gl_size[self.gl_n] = rsize(&self.rs, vr)
                self.gl_n = self.gl_n + 1
                let val = self.sink(t, g, ty, a, a.pc[it], vt)
                self.f.store(self.f.fnaddr(id), val)
            it = a.next[it]

    /#/ The address of the anonymous function `n`; it is lowered as `outer__fnN`.
    fn anon_fn(self, a: &Ast, n: int) => int:
        let w = new_txt()
        self.names.put(&w, self.cur_id)
        w.put("__fn")
        w.put_int(n)
        let id = self.names.intern(&w)
        self.want_named(n, id)
        return self.f.fnaddr(id)

    /#/ A call through the variable `lv` that holds a function.
    fn call_indirect(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int, lv: int) => int:
        let sig = self.v_ty[lv]
        let rr = self.rep(t, g, t.c[sig])
        if rr < 0:
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let fv = self.var_read(lv)
        let vals: buf<int> = new_buf(int, 8)
        let i = 0
        let c = a.child[n]
        while c >= 0:
            if i >= len(vals):
                vals = buf_resize(vals, i * 2)
            let at = self.nd(t, ty, c)
            let v = self.ex(t, g, ty, a, c)
            if i < t.count_of(sig):
                v = self.coerce(t, g, v, at, t.arg(sig, i))
                if t.kind[t.arg(sig, i)] != int(Ty.Ref) && !(t.kind[t.arg(sig, i)] == int(Ty.Slice) && t.kind[at] == int(Ty.Array)):
                    v = self.consume(t, g, a, c, v, at)
            vals[i] = v
            i = i + 1
            c = a.next[c]
        for j in 0..i:
            self.f.arg(vals[j])
        return self.f.calli(rr, -1, fv)

    /#/ A call of the function declared in this body at slot `slot`.
    fn call_nested(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int, slot: int) => int:
        let sig = ty.rd.fn_sig(t, a, self.nf_node[slot], -1)
        let rr = self.rep(t, g, t.c[sig])
        if rr < 0:
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let vals: buf<int> = new_buf(int, 8)
        let i = 0
        let c = a.child[n]
        while c >= 0:
            if i >= len(vals):
                vals = buf_resize(vals, i * 2)
            let at = self.nd(t, ty, c)
            let v = self.ex(t, g, ty, a, c)
            if i < t.count_of(sig):
                v = self.coerce(t, g, v, at, t.arg(sig, i))
                if t.kind[t.arg(sig, i)] != int(Ty.Ref) && !(t.kind[t.arg(sig, i)] == int(Ty.Slice) && t.kind[at] == int(Ty.Array)):
                    v = self.consume(t, g, a, c, v, at)
            vals[i] = v
            i = i + 1
            c = a.next[c]
        for j in 0..i:
            self.f.arg(vals[j])
        return self.f.call(rr, -1, self.nf_id[slot])

    fn call(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let callee = a.pa[n]
        let res = self.nd(t, ty, n)
        if callee >= 0 && a.kind[callee] == int(Nk.Member):
            if self.enum_row(ty, a, a.pa[callee]) >= 0:
                return self.variant(t, g, ty, a, callee, n)
            return self.member_call(t, g, ty, a, n)
        if callee < 0 || a.kind[callee] != int(Nk.Name):
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let lv = self.lookup(a, a.tok[callee])
        if lv >= 0 && t.kind[self.v_ty[lv]] == int(Ty.Fn):
            return self.call_indirect(t, g, ty, a, n, lv)
        let nfi = self.nested_find(a, a.tok[callee])
        if nfi >= 0:
            return self.call_nested(t, g, ty, a, n, nfi)
        let r = ty.lookup(a, a.tok[callee])
        if r < 0:
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let k = ty.rd.sc.loc.kind[r]
        if k == int(Sk.Builtin):
            if tok_is(a, a.tok[callee], "len"):
                return self.len_call(t, g, ty, a, n)
            if tok_is(a, a.tok[callee], "new_buf"):
                return self.new_buf_call(t, g, ty, a, n)
            if tok_is(a, a.tok[callee], "buf_resize"):
                return self.buf_resize_call(t, g, ty, a, n)
            return self.cast_call(t, g, ty, a, n)
        if k != int(Sk.Fn) && k != int(Sk.Extern):
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let sig = ty.rd.sc.loc.ty[r]
        if sig < 0 || t.kind[sig] != int(Ty.Fn):
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let variadic = 0
        if k == int(Sk.Extern) && ty.rd.sc.loc.info[r] == 1:
            variadic = 1
        let inst_env = -1
        let fnode = -1
        if k == int(Sk.Fn):
            fnode = self.fn_node_of(a, ty.rd.sc.loc.tok[r])
            if fnode >= 0 && type_param_count(a, fnode) > 0:
                inst_env = self.infer_env(t, ty, a, n, sig, type_param_count(a, fnode))
                if inst_env < 0:
                    self.unsupported(n)
                    return self.f.undef(int(Rp.I64))
                sig = subst_env(t, sig, inst_env)
        let fixed = t.count_of(sig)
        if variadic == 1:
            fixed = fixed - 1
        let ret = t.c[sig]
        let rr = self.rep(t, g, ret)
        if rr < 0:
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let vals: buf<int> = new_buf(int, 8)
        let i = 0
        let c = a.child[n]
        while c >= 0:
            if i >= len(vals):
                vals = buf_resize(vals, i * 2)
            let at = self.nd(t, ty, c)
            let v = -1
            if k == int(Sk.Extern):
                v = self.exb(t, g, ty, a, c)
            else:
                v = self.ex(t, g, ty, a, c)
            if i < fixed:
                v = self.coerce(t, g, v, at, t.arg(sig, i))
                if t.kind[t.arg(sig, i)] != int(Ty.Ref) && !(t.kind[t.arg(sig, i)] == int(Ty.Slice) && t.kind[at] == int(Ty.Array)) && k != int(Sk.Extern):
                    v = self.consume(t, g, a, c, v, at)
            vals[i] = v
            i = i + 1
            c = a.next[c]
        for j in 0..i:
            self.f.arg(vals[j])
        let name = new_txt()
        for q in a.toks.start[a.tok[callee]]..a.toks.end[a.tok[callee]]:
            name.put_byte(a.byte_at(q))
        let id = self.names.intern(&name)
        if inst_env >= 0:
            id = self.inst_name(&name, inst_env)
            self.want_instance(fnode, inst_env, -1)
        if k == int(Sk.Extern):
            self.note_c(id, sig, variadic)
            return self.f.ccall(rr, fixed, id, variadic)
        return self.f.call(rr, -1, id)

    /#/ The arguments the type parameters of the generic function called by `n` (of signature
    /#/ `sig`) stand for, as `Name<A, B>`; -1 when a parameter is not fixed by the call.
    fn infer_env(self, t: &Tys, ty: &Typer, a: &Ast, n: int, sig: int, count: int) => int:
        for i in 0..16:
            self.ue[i] = -1
        let c = a.child[n]
        let i = 0
        while c >= 0 && i < t.count_of(sig):
            self.unify(t, t.arg(sig, i), self.nd(t, ty, c))
            i = i + 1
            c = a.next[c]
        self.unify(t, t.c[sig], self.nd(t, ty, n))
        for k in 0..count:
            if self.ue[k] < 0:
                return -1
        let start = t.args_n
        for k in 0..count:
            t.push_arg(self.ue[k])
        return t.intern(int(Ty.Named), 0, 0, count, start)

    fn note_c(self, id: int, sig: int, variadic: int) => void:
        if id == self.rt_exit || id == self.rt_calloc || id == self.rt_strlen || id == self.rt_malloc || id == self.rt_free || id == self.rt_strdup || id == self.rt_memcpy || id == self.rt_strcmp || id == self.rt_write:
            return
        for i in 0..self.cd_n:
            if self.cd_name[i] == id:
                return
        if self.cd_n >= len(self.cd_name):
            let cap = (self.cd_n + 1) * 2
            self.cd_name = buf_resize(self.cd_name, cap)
            self.cd_sig = buf_resize(self.cd_sig, cap)
            self.cd_var = buf_resize(self.cd_var, cap)
        self.cd_name[self.cd_n] = id
        self.cd_sig[self.cd_n] = sig
        self.cd_var[self.cd_n] = variadic
        self.cd_n = self.cd_n + 1

    /#/ `int(x)`, `float(x)`, `bool(x)`, `u8(x)`: the sized casts.
    fn cast_call(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let first = a.child[n]
        let res = self.nd(t, ty, n)
        if first < 0 || a.next[first] >= 0 || self.rep(t, g, res) < 0 || self.rep(t, g, self.nd(t, ty, first)) < 0 || t.kind[res] == int(Ty.Str):
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let x = self.ex(t, g, ty, a, first)
        return self.coerce(t, g, x, self.nd(t, ty, first), res)

    fn ex(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let k = a.kind[n]
        let x = self.nd(t, ty, n)
        let r = self.rep(t, g, x)
        if k == int(Nk.Int) && t.kind[x] == int(Ty.Object):
            /#/ `0` as an `object`: the null pointer
            return self.f.cint(int(Rp.Ptr), 0)
        if k == int(Nk.Int) || k == int(Nk.Char):
            if r < 0 || r == int(Rp.Ptr):
                self.unsupported(n)
                return self.f.undef(int(Rp.I64))
            if k == int(Nk.Char):
                return self.f.cint(r, char_value(a, a.tok[n]))
            return self.f.cint(r, lit_digits(a, a.tok[n]))
        if k == int(Nk.Float):
            if r != int(Rp.F64) && r != int(Rp.F32):
                self.unsupported(n)
                return self.f.undef(int(Rp.F64))
            let bits = float_bits(a, a.tok[n], r == int(Rp.F32))
            if bits < 0:
                self.unsupported(n)
                return self.f.undef(r)
            return self.f.cfloat(r, bits)
        if k == int(Nk.Bool):
            let v = 0
            if a.byte_at(a.toks.start[a.tok[n]]) == 't':
                v = 1
            return self.f.cint(int(Rp.I8), v)
        if k == int(Nk.Str):
            let lit = self.f.strlit(self.str_lit(a, a.tok[n]))
            if t.kind[x] == int(Ty.Str):
                self.f.arg(lit)
                return self.f.ccall(int(Rp.Ptr), 1, self.rt_strdup, 0)
            return lit
        if k == int(Nk.Fn) && a.pa[n] < 0:
            return self.anon_fn(a, n)
        if k == int(Nk.FStr):
            return self.fstr(t, g, ty, a, n)
        if k == int(Nk.Name):
            let v = self.lookup(a, a.tok[n])
            if v < 0:
                if self.global_row(g, ty, a, a.tok[n]) >= 0 && r >= 0 && r < rp_first_agg():
                    return self.f.load(r, -1, self.f.fnaddr(self.global_sym(a, a.tok[n])))
                self.unsupported(n)
                return self.f.undef(int(Rp.I64))
            return self.var_read(v)
        if k == int(Nk.Binary):
            return self.binary(t, g, ty, a, n)
        if k == int(Nk.Unary):
            return self.unary(t, g, ty, a, n)
        if k == int(Nk.Call):
            return self.call(t, g, ty, a, n)
        if k == int(Nk.Cast):
            let v = self.ex(t, g, ty, a, a.pa[n])
            if self.rep(t, g, self.nd(t, ty, a.pa[n])) < 0 || r < 0:
                self.unsupported(n)
                return v
            return self.coerce(t, g, v, self.nd(t, ty, a.pa[n]), x)
        if k == int(Nk.Member):
            return self.member(t, g, ty, a, n)
        if k == int(Nk.Index):
            if t.kind[self.strip_refs(t, self.nd(t, ty, a.pa[n]))] == int(Ty.Str):
                return self.str_byte(t, g, ty, a, n)
            let p = self.element_addr(t, g, ty, a, n)
            return self.f.load(self.rep(t, g, self.fty), -1, p)
        if k == int(Nk.StructLit):
            return self.struct_lit(t, g, ty, a, n)
        if k == int(Nk.Tuple):
            return self.tuple_lit(t, g, ty, a, n)
        if k == int(Nk.Array):
            return self.array_lit(t, g, ty, a, n)
        self.unsupported(n)
        return self.f.undef(int(Rp.I64))

    fn lookup(self, a: &Ast, tok: int) => int:
        let r = self.sc.find_tok(a, tok, 0)
        if r >= 0 && self.sc.kind[r] == int(Sk.Local):
            return self.sc.info[r]
        return -1

    fn unary(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let k = a.pc[n]
        let o = a.pa[n]
        let x = self.nd(t, ty, o)
        if k == int(Tk.Amp):
            return self.borrow(t, g, ty, a, n)
        if k == int(Tk.KwClone) || k == int(Tk.KwMv):
            let res = self.nd(t, ty, n)
            if self.rep(t, g, res) < 0:
                self.unsupported(n)
                return self.f.undef(int(Rp.I64))
            let v = self.ex(t, g, ty, a, o)
            if k == int(Tk.KwClone):
                if needs_drop(t, g, res):
                    return self.clone_value(t, g, v, res)
                return v
            return self.consume(t, g, a, o, v, res)
        if k == int(Tk.Star):
            if t.kind[x] != int(Ty.Ref):
                self.unsupported(n)
                return self.f.undef(int(Rp.I64))
            let target = t.a[x]
            let p = self.ex(t, g, ty, a, o)
            if is_handle(t, g, target):
                return p
            let r = self.rep(t, g, target)
            if r < 0:
                self.unsupported(n)
                return p
            return self.f.load(r, -1, p)
        if self.rep(t, g, x) < 0 || t.kind[x] == int(Ty.Ref):
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let v = self.ex(t, g, ty, a, o)
        if k == int(Tk.Minus):
            let res = self.nd(t, ty, n)
            v = self.coerce(t, g, v, x, res)
            if t.kind[res] == int(Ty.Float):
                return self.f.raw(int(Op.FNeg), self.f.rep[v], -1, v, -1, -1, 0)
            return self.f.neg(v)
        if k == int(Tk.Bang):
            return self.f.bin(int(Op.Xor), v, self.f.cint(int(Rp.I8), 1))
        if k == int(Tk.Tilde):
            return self.f.bnot(v)
        self.unsupported(n)
        return v

    /#/ `&x` and `&mut x`: the handle itself for a handle type, else the address of the slot.
    fn borrow(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let o = a.pa[n]
        let x = self.nd(t, ty, o)
        if is_handle(t, g, x):
            return self.exb(t, g, ty, a, o)
        if a.kind[o] == int(Nk.Name):
            let v = self.lookup(a, a.tok[o])
            if v >= 0 && self.v_slot[v] >= 0:
                return self.v_slot[v]
        if a.kind[o] == int(Nk.Member) && t.kind[self.strip_refs(t, self.nd(t, ty, a.pa[o]))] == int(Ty.Named) && self.rep(t, g, x) >= 0:
            return self.field_addr(t, g, ty, a, o)
        if a.kind[o] == int(Nk.Index) && self.rep(t, g, x) >= 0:
            return self.element_addr(t, g, ty, a, o)
        self.unsupported(n)
        return self.f.undef(int(Rp.Ptr))

    /#/ ---- statements ----------------------------------------------------------

    fn block(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, b: int) => void:
        let mark = self.sc.n
        let own_mark = self.own_n
        let c = a.child[b]
        let is_tail = b == self.tailb
        while c >= 0:
            if is_tail && a.next[c] < 0:
                if a.kind[c] == int(Nk.ExprStmt) && a.pa[c] >= 0 && t.kind[self.ret_ty] != int(Ty.Void) && t.kind[self.nd(t, ty, a.pa[c])] != int(Ty.Void):
                    self.retx = c
                elif a.kind[c] == int(Nk.Match):
                    self.tailm = c
            self.stmt(t, g, ty, a, c)
            c = a.next[c]
        if !self.f.terminated(self.f.cur):
            self.drop_scope(t, g, a, own_mark)
        self.own_n = own_mark
        self.sc.truncate(mark)

    fn stmt(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        self.stmt_inner(t, g, ty, a, n)
        self.flush_temps(t, g)

    fn stmt_inner(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        let k = a.kind[n]
        if k == int(Nk.ExprStmt) && self.retx == n:
            k = int(Nk.Return)
            self.retx = -1
        if k == int(Nk.Let):
            let vt = self.nd(t, ty, n)
            let vr = self.rep(t, g, vt)
            if vr < 0 || vr == int(Rp.Void):
                self.unsupported(n)
                return
            let val = -1
            if a.pc[n] >= 0:
                val = self.sink(t, g, ty, a, a.pc[n], vt)
            else:
                val = self.f.undef(vr)
            self.bind_var(t, g, a, a.pa[n], vt, val)
        elif k == int(Nk.Assign):
            self.assign(t, g, ty, a, n)
        elif k == int(Nk.ExprStmt):
            let e = a.pa[n]
            let v = self.ex(t, g, ty, a, e)
            let et = self.nd(t, ty, e)
            if needs_drop(t, g, et) && (a.kind[e] == int(Nk.Call) || a.kind[e] == int(Nk.StructLit) || a.kind[e] == int(Nk.Unary)):
                self.drop_value(t, g, v, et)
        elif k == int(Nk.Return):
            if a.pa[n] >= 0 && t.kind[self.ret_ty] != int(Ty.Void):
                let v = self.sink(t, g, ty, a, a.pa[n], self.ret_ty)
                self.flush_temps(t, g)
                self.drop_scope(t, g, a, 0)
                self.f.ret_v(v)
            else:
                if a.pa[n] >= 0:
                    self.ex(t, g, ty, a, a.pa[n])
                self.drop_scope(t, g, a, 0)
                self.f.ret_void()
            self.dead_block()
        elif k == int(Nk.Raise):
            self.raise_stmt(t, g, ty, a, n)
        elif k == int(Nk.Match):
            self.match_stmt(t, g, ty, a, n)
        elif k == int(Nk.Rm):
            self.rm_stmt(t, g, ty, a, a.pa[n])
            let extra = a.child[n]
            while extra >= 0:
                self.rm_stmt(t, g, ty, a, extra)
                extra = a.next[extra]
        elif k == int(Nk.Mv):
            self.mv_stmt(t, g, ty, a, n)
        elif k == int(Nk.If):
            self.if_stmt(t, g, ty, a, n)
        elif k == int(Nk.While):
            self.while_stmt(t, g, ty, a, n)
        elif k == int(Nk.For):
            self.for_stmt(t, g, ty, a, n)
        elif k == int(Nk.Break) || k == int(Nk.Continue):
            if self.nloops == 0:
                self.unsupported(n)
                return
            self.drop_scope(t, g, a, self.ld[self.nloops - 1])
            if k == int(Nk.Break):
                self.jump(self.lb[self.nloops - 1])
            else:
                self.jump(self.lc[self.nloops - 1])
            self.dead_block()
        elif k == int(Nk.Fn) && a.pa[n] >= 0:
            self.nested_declare(a, n)
        elif k == int(Nk.Class) && type_param_count(a, n) == 0:
            let row = g.find_in_module(a, a.pa[n], ty.cur)
            if row < 0:
                self.unsupported(n)
                return
            let m = a.child[n]
            while m >= 0:
                if a.kind[m] == int(Nk.Fn):
                    self.want_instance(m, -1, row)
                m = a.next[m]
        else:
            self.unsupported(n)

    fn assign(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        let target = a.pa[n]
        let tk = a.kind[target]
        if tk == int(Nk.Name):
            let v = self.lookup(a, a.tok[target])
            if v < 0 && self.global_row(g, ty, a, a.tok[target]) >= 0:
                let gt = self.nd(t, ty, target)
                if self.rep(t, g, gt) < 0 || self.rep(t, g, gt) >= rp_first_agg():
                    self.unsupported(n)
                    return
                let gv = self.sink(t, g, ty, a, a.pb[n], gt)
                self.f.store(self.f.fnaddr(self.global_sym(a, a.tok[target])), gv)
                return
            if v < 0:
                self.unsupported(n)
                return
            let val = self.sink(t, g, ty, a, a.pb[n], self.v_ty[v])
            /#/ what the variable owned is released once the new value is known
            self.drop_var(t, g, a, v)
            self.var_write(v, val)
            if self.v_flag[v] >= 0:
                self.write_var(self.v_flag[v], self.f.cur, self.f.cint(int(Rp.I8), 1))
        elif tk == int(Nk.Member) || tk == int(Nk.Index) || (tk == int(Nk.Unary) && a.pc[target] == int(Tk.Star)):
            let tt = self.nd(t, ty, target)
            if self.rep(t, g, tt) < 0:
                self.unsupported(n)
                return
            let val = self.sink(t, g, ty, a, a.pb[n], tt)
            let p = -1
            if tk == int(Nk.Member):
                p = self.field_addr(t, g, ty, a, target)
            elif tk == int(Nk.Index):
                p = self.element_addr(t, g, ty, a, target)
            else:
                p = self.ex(t, g, ty, a, a.pa[target])
            if needs_drop(t, g, tt):
                self.drop_value(t, g, self.f.load(self.rep(t, g, tt), -1, p), tt)
            self.f.store(p, val)
        else:
            self.unsupported(n)

    /#/ The value of `n` for a place that wants type `to` and takes ownership of it.
    fn sink(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int, to: int) => int:
        let from = self.nd(t, ty, n)
        let v = self.coerce(t, g, self.ex(t, g, ty, a, n), from, to)
        if t.kind[to] == int(Ty.Slice) && t.kind[from] == int(Ty.Array):
            /#/ lent, not copied: the array stays with its owner
            return v
        return self.consume(t, g, a, n, v, from)

    fn rm_stmt(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, e: int) => void:
        if e < 0:
            return
        if a.kind[e] != int(Nk.Name):
            self.unsupported(e)
            return
        let v = self.lookup(a, a.tok[e])
        if v < 0:
            self.unsupported(e)
            return
        self.drop_var(t, g, a, v)

    /#/ `mv a b` and `clone a b`: a new variable `b` made from `a`.
    fn mv_stmt(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        let src = a.pa[n]
        let x = self.nd(t, ty, n)
        if src < 0 || a.kind[src] != int(Nk.Name) || self.rep(t, g, x) < 0 || a.pb[n] < 0:
            self.unsupported(n)
            return
        let v = self.ex(t, g, ty, a, src)
        if a.pc[n] == 1:
            v = self.clone_value(t, g, v, x)
        else:
            v = self.consume(t, g, a, src, v, x)
        self.bind_var(t, g, a, a.pb[n], x, v)

    fn if_stmt(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        let c = self.ex(t, g, ty, a, a.pa[n])
        self.flush_temps(t, g)
        let yes = self.new_block()
        let no = self.new_block()
        let join = self.new_block()
        self.branch(c, yes, no)
        self.seal(yes)
        self.seal(no)
        self.f.set_block(yes)
        self.block(t, g, ty, a, a.pb[n])
        self.jump(join)
        self.f.set_block(no)
        let e = a.pc[n]
        if e >= 0:
            if a.kind[e] == int(Nk.If):
                self.if_stmt(t, g, ty, a, e)
            else:
                self.block(t, g, ty, a, e)
        self.jump(join)
        self.seal(join)
        self.f.set_block(join)

    fn push_loop(self, cont: int, brk: int) => void:
        if self.nloops >= len(self.lc):
            self.lc = buf_resize(self.lc, (self.nloops + 1) * 2)
            self.lb = buf_resize(self.lb, (self.nloops + 1) * 2)
            self.ld = buf_resize(self.ld, (self.nloops + 1) * 2)
        self.ld[self.nloops] = self.own_n
        self.lc[self.nloops] = cont
        self.lb[self.nloops] = brk
        self.nloops = self.nloops + 1

    fn while_stmt(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        let head = self.new_block()
        let body = self.new_block()
        let exit = self.new_block()
        self.jump(head)
        self.f.set_block(head)
        let c = self.ex(t, g, ty, a, a.pa[n])
        self.flush_temps(t, g)
        self.branch(c, body, exit)
        self.seal(body)
        self.f.set_block(body)
        self.push_loop(head, exit)
        self.block(t, g, ty, a, a.pb[n])
        self.nloops = self.nloops - 1
        self.jump(head)
        self.seal(head)
        self.seal(exit)
        self.f.set_block(exit)

    /#/ `for i in a..b`: a counter that runs from `a` to `b - 1`; `i` is its value each time.
    fn for_stmt(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        let it = a.pb[n]
        if a.pa[n] < 0:
            self.unsupported(n)
            return
        let vt = self.nd(t, ty, n)
        let vr = self.rep(t, g, vt)
        if vr < 0 || vr == int(Rp.Void):
            self.unsupported(n)
            return
        let lo = -1
        let hi = -1
        let data = -1
        let cr = vr
        let ct = vt
        /#/ `range(a, b)` and `range(b)` are the same as `a..b`
        let rlo = -1
        let rhi = -1
        let is_range = false
        if a.kind[it] == int(Nk.Range):
            rlo = a.pa[it]
            rhi = a.pb[it]
            is_range = true
        elif a.kind[it] == int(Nk.Call) && a.pa[it] >= 0 && a.kind[a.pa[it]] == int(Nk.Name) && tok_is(a, a.tok[a.pa[it]], "range"):
            let c0 = a.child[it]
            if c0 >= 0 && a.next[c0] >= 0 && a.next[a.next[c0]] < 0:
                rlo = c0
                rhi = a.next[c0]
                is_range = true
            elif c0 >= 0 && a.next[c0] < 0:
                rhi = c0
                is_range = true
        if is_range:
            if !rp_is_int(vr):
                self.unsupported(n)
                return
            if rlo >= 0:
                lo = self.coerce(t, g, self.ex(t, g, ty, a, rlo), self.nd(t, ty, rlo), vt)
            else:
                lo = self.f.cint(vr, 0)
            hi = self.coerce(t, g, self.ex(t, g, ty, a, rhi), self.nd(t, ty, rhi), vt)
        elif t.kind[self.strip_refs(t, self.nd(t, ty, it))] == int(Ty.Tuple):
            self.for_tuple(t, g, ty, a, n, vt, vr)
            return
        else:
            /#/ the elements of an array, buffer or slice, taken one by one (copies only)
            let ot = self.strip_refs(t, self.nd(t, ty, it))
            let k = t.kind[ot]
            if !(k == int(Ty.Array) || (k == int(Ty.Buf) && t.a[ot] >= 0) || k == int(Ty.Slice)) || needs_drop(t, g, vt):
                self.unsupported(n)
                return
            cr = int(Rp.I64)
            ct = t.int_ty(8, true)
            lo = self.f.cint(cr, 0)
            if k == int(Ty.Array):
                data = self.exb(t, g, ty, a, it)
                hi = self.f.cint(cr, t.b[ot])
            else:
                let agg = self.agg_of(t, g, ty, a, it)
                data = self.f.extract(int(Rp.Ptr), agg, 0)
                hi = self.f.extract(cr, agg, 1)
        let counter = self.new_var(a, -1, cr, ct)
        self.write_var(counter, self.f.cur, lo)
        let head = self.new_block()
        let body = self.new_block()
        let latch = self.new_block()
        let exit = self.new_block()
        self.jump(head)
        self.f.set_block(head)
        let i = self.read_var(counter, head)
        let lt = int(Pr.SLt)
        if !is_signed(t, ct):
            lt = int(Pr.ULt)
        self.branch(self.f.cmp(lt, i, hi), body, exit)
        self.seal(body)
        self.f.set_block(body)
        let mark = self.sc.n
        let cv = self.read_var(counter, body)
        if data >= 0:
            cv = self.f.load(vr, -1, self.f.index(data, cv, st_size(t, g, vt)))
        self.bind_var(t, g, a, a.pa[n], vt, cv)
        self.push_loop(latch, exit)
        self.block(t, g, ty, a, a.pc[n])
        self.nloops = self.nloops - 1
        self.sc.truncate(mark)
        self.jump(latch)
        self.seal(latch)
        self.f.set_block(latch)
        let cur = self.read_var(counter, latch)
        self.write_var(counter, latch, self.f.bin(int(Op.Add), cur, self.f.cint(cr, 1)))
        self.jump(head)
        self.seal(head)
        self.seal(exit)
        self.f.set_block(exit)

    /#/ `for x in tuple`: the body once per element, in order.
    fn for_tuple(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int, vt: int, vr: int) => void:
        let it = a.pb[n]
        let tt = self.strip_refs(t, self.nd(t, ty, it))
        if needs_drop(t, g, vt):
            self.unsupported(n)
            return
        for i in 0..t.count_of(tt):
            if self.rep(t, g, t.arg(tt, i)) != vr:
                self.unsupported(n)
                return
        let agg = self.agg_of(t, g, ty, a, it)
        let exit = self.new_block()
        for i in 0..t.count_of(tt):
            let nxt = self.new_block()
            let mark = self.sc.n
            self.bind_var(t, g, a, a.pa[n], vt, self.f.extract(vr, agg, i))
            self.push_loop(nxt, exit)
            self.block(t, g, ty, a, a.pc[n])
            self.nloops = self.nloops - 1
            self.sc.truncate(mark)
            self.jump(nxt)
            self.seal(nxt)
            self.f.set_block(nxt)
        self.jump(exit)
        self.seal(exit)
        self.f.set_block(exit)

    /#/ ---- raise ---------------------------------------------------------------

    /#/ The row of the builtin class `Error`, -1 when there is none.
    fn error_row(self, g: &Syms) => int:
        for i in 0..g.n:
            if g.kind[i] == int(Sk.Class) && g.mod[i] == -1 && g.size[i] == 5 && g.pool[g.off[i]] == 'E' && g.pool[g.off[i] + 4] == 'r':
                return g.info[i]
        return -1

    /#/ The class row the name `o` stands for, -1 when it is no class.
    fn class_row(self, ty: &Typer, a: &Ast, o: int) => int:
        if o < 0 || a.kind[o] != int(Nk.Name):
            return -1
        let r = ty.lookup(a, a.tok[o])
        if r < 0 || ty.rd.sc.loc.kind[r] != int(Sk.Class):
            return -1
        return ty.rd.sc.loc.info[r]

    /#/ `raise`: in a function with a listener, the listener is called with an `Error` and its
    /#/ result is what the function returns; otherwise the error is printed and the process ends.
    fn raise_stmt(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        let e = a.pa[n]
        let er = self.error_row(g)
        if e < 0 || er < 0:
            self.unsupported(n)
            return
        let ety = t.named(er)
        let cr = -1
        if a.kind[e] == int(Nk.Call):
            cr = self.class_row(ty, a, a.pa[e])
        let first = -1
        let second = -1
        if cr >= 0:
            first = a.child[e]
            if first >= 0:
                second = a.next[first]
        if self.lis >= 0:
            let ep = -1
            if cr >= 0:
                ep = self.f.alloc(st_block(t, g, ety))
                let code = self.f.cint(int(Rp.I64), 0 - 1)
                if first >= 0 && t.kind[self.nd(t, ty, first)] == int(Ty.Int):
                    code = self.coerce(t, g, self.ex(t, g, ty, a, first), self.nd(t, ty, first), t.int_ty(8, true))
                let note = self.f.cint(int(Rp.Ptr), 0)
                if second >= 0 && t.kind[self.strip_refs(t, self.nd(t, ty, second))] == int(Ty.Str):
                    let nt = self.nd(t, ty, second)
                    let v = self.ex(t, g, ty, a, second)
                    if t.kind[nt] == int(Ty.Str):
                        note = self.consume(t, g, a, second, v, nt)
                    else:
                        self.f.arg(v)
                        note = self.f.ccall(int(Rp.Ptr), 1, self.rt_strdup, 0)
                self.f.store(self.f.field(ep, 0), code)
                self.f.store(self.f.field(ep, 8), note)
                self.f.store(self.f.field(ep, 16), self.f.cint(int(Rp.Ptr), 0))
            else:
                ep = self.sink(t, g, ty, a, e, self.nd(t, ty, e))
            self.flush_temps(t, g)
            self.drop_scope(t, g, a, 0)
            self.f.arg(ep)
            let rr = self.rep(t, g, self.ret_ty)
            if t.kind[self.ret_ty] == int(Ty.Void):
                self.f.call(int(Rp.Void), -1, self.lis)
                self.f.ret_void()
            else:
                self.f.ret_v(self.f.call(rr, -1, self.lis))
            self.dead_block()
            return
        let msg = new_txt()
        msg.put("[E")
        let name = self.nd(t, ty, e)
        if cr >= 0:
            if first >= 0 && a.kind[first] == int(Nk.Int):
                msg.put_int(lit_digits(a, a.tok[first]))
            else:
                msg.put("-1")
            msg.put("]: ")
            for q in a.toks.start[a.tok[a.pa[e]]]..a.toks.end[a.tok[a.pa[e]]]:
                msg.put_byte(a.byte_at(q))
            msg.put_byte(10)
            if second >= 0 && a.kind[second] == int(Nk.Str):
                msg.put("note: ")
                self.put_text(&msg, a, a.tok[second])
                msg.put_byte(10)
            let c = first
            while c >= 0:
                self.exb(t, g, ty, a, c)
                c = a.next[c]
        else:
            msg.put("-1]: ")
            let st = self.strip_refs(t, name)
            if t.kind[st] == int(Ty.Named):
                let row = t.a[st]
                for q in g.off[row]..g.off[row] + g.size[row]:
                    msg.put_byte(g.pool[q])
            msg.put_byte(10)
            let v = self.ex(t, g, ty, a, e)
            if needs_drop(t, g, name) && (a.kind[e] == int(Nk.StructLit) || a.kind[e] == int(Nk.Call)):
                self.drop_value(t, g, v, name)
        self.flush_temps(t, g)
        self.drop_scope(t, g, a, 0)
        self.f.arg(self.f.cint(int(Rp.I32), 2))
        self.f.arg(self.f.strlit(self.text_global(&msg)))
        self.f.arg(self.f.cint(int(Rp.I64), msg.n))
        self.f.ccall(int(Rp.I64), 3, self.rt_write, 0)
        self.trap()
        self.dead_block()

    /#/ ---- enums and match -----------------------------------------------------

    /#/ The enum row `o` (a Name) names, or -1.
    fn enum_row(self, ty: &Typer, a: &Ast, o: int) => int:
        if o < 0 || a.kind[o] != int(Nk.Name):
            return -1
        let r = ty.lookup(a, a.tok[o])
        if r < 0 || ty.rd.sc.loc.kind[r] != int(Sk.Enum):
            return -1
        return ty.rd.sc.loc.info[r]

    /#/ Position of variant row `v` among the variants of its enum.
    fn variant_index(self, g: &Syms, v: int) => int:
        let k = 0
        for i in 0..v:
            if g.info[i] == g.info[v] && g.kind[i] == int(Sk.Variant):
                k = k + 1
        return k

    /#/ The payload of variant row `v` of enum type `x`: types in `lay_ty`, offsets in `lay_off`
    /#/ (after the 8-byte tag).
    fn payload_layout(self, t: &Tys, g: &Syms, x: int, v: int) => void:
        self.lay_n = 0
        let sig = g.ty[v]
        if sig < 0 || t.kind[sig] != int(Ty.Fn):
            return
        let off = 8
        for i in 0..t.count_of(sig):
            let ft = subst_env(t, t.arg(sig, i), x)
            off = align_up(off, st_align(t, g, ft))
            if self.lay_n >= len(self.lay_ty):
                self.lay_ty = buf_resize(self.lay_ty, (self.lay_n + 1) * 2)
                self.lay_off = buf_resize(self.lay_off, (self.lay_n + 1) * 2)
            self.lay_ty[self.lay_n] = ft
            self.lay_off[self.lay_n] = off
            self.lay_n = self.lay_n + 1
            off = off + st_size(t, g, ft)

    /#/ `Enum::Variant` and `Enum::Variant(args)`; `callee` is the Member node, `n` the whole.
    fn variant(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, callee: int, n: int) => int:
        let x = self.nd(t, ty, n)
        let er = self.enum_row(ty, a, a.pa[callee])
        let v = -1
        if er >= 0:
            v = member_of(g, a, er, a.tok[callee], int(Sk.Variant))
        if v < 0 || t.kind[x] != int(Ty.Named):
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let tag = self.variant_index(g, v)
        if !has_payload(t, g, er):
            return self.f.cint(int(Rp.I64), tag)
        let p = self.f.alloc(st_block(t, g, x))
        self.f.store(self.f.field(p, 0), self.f.cint(int(Rp.I64), tag))
        if n != callee:
            self.payload_layout(t, g, x, v)
            let offs: buf<int> = new_buf(int, self.lay_n + 1)
            let tys: buf<int> = new_buf(int, self.lay_n + 1)
            let cnt = self.lay_n
            for i in 0..cnt:
                offs[i] = self.lay_off[i]
                tys[i] = self.lay_ty[i]
            let c = a.child[n]
            let i = 0
            while c >= 0 && i < cnt:
                let val = self.sink(t, g, ty, a, c, tys[i])
                self.f.store(self.f.field(p, offs[i]), val)
                i = i + 1
                c = a.next[c]
        return p

    /#/ The number a literal pattern `p` stands for, with a leading minus; `ok` is 0 when it is not one.
    fn pattern_int(self, a: &Ast, p: int) => int:
        let k = a.kind[p]
        if k == int(Nk.Int):
            return lit_digits(a, a.tok[p])
        if k == int(Nk.Char):
            return char_value(a, a.tok[p])
        if k == int(Nk.Bool):
            if a.byte_at(a.toks.start[a.tok[p]]) == 't':
                return 1
            return 0
        if k == int(Nk.Unary) && a.pc[p] == int(Tk.Minus) && a.pa[p] >= 0 && a.kind[a.pa[p]] == int(Nk.Int):
            return 0 - lit_digits(a, a.tok[a.pa[p]])
        return 0

    fn is_int_pattern(self, a: &Ast, p: int) => bool:
        let k = a.kind[p]
        if k == int(Nk.Int) || k == int(Nk.Char) || k == int(Nk.Bool):
            return true
        return k == int(Nk.Unary) && a.pc[p] == int(Tk.Minus) && a.pa[p] >= 0 && a.kind[a.pa[p]] == int(Nk.Int)

    /#/ The payload patterns of variant `vr` in call pattern `p`, tested against the fields of `v`.
    fn pat_payload(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, p: int, v: int, x: int, vr: int, fail: int) => void:
        self.payload_layout(t, g, x, vr)
        let offs: buf<int> = new_buf(int, self.lay_n + 1)
        let tys: buf<int> = new_buf(int, self.lay_n + 1)
        let cnt = self.lay_n
        for i in 0..cnt:
            offs[i] = self.lay_off[i]
            tys[i] = self.lay_ty[i]
        let c = a.child[p]
        let i = 0
        while c >= 0 && i < cnt:
            let r = self.rep(t, g, tys[i])
            if r < 0:
                self.unsupported(c)
            else:
                self.pat_test(t, g, ty, a, c, self.f.load(r, -1, self.f.field(v, offs[i])), tys[i], fail)
            i = i + 1
            c = a.next[c]

    /#/ Goes on in a new block when value `v` of type `x` matches pattern `p`, else branches to
    /#/ `fail`. A name matches anything; a variant, a literal or a tuple of patterns is tested
    /#/ part by part, so a payload is read only after its tag matched.
    fn pat_test(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, p: int, v: int, x: int, fail: int) => void:
        let k = a.kind[p]
        if k == int(Nk.Name):
            return
        if k == int(Nk.Binary) && a.pc[p] == int(Tk.Pipe):
            /#/ `A | B`: B is tried when A fails
            let second = self.new_block()
            let join = self.new_block()
            self.pat_test(t, g, ty, a, a.pa[p], v, x, second)
            self.jump(join)
            self.seal(second)
            self.f.set_block(second)
            self.pat_test(t, g, ty, a, a.pb[p], v, x, fail)
            self.jump(join)
            self.seal(join)
            self.f.set_block(join)
            return
        if k == int(Nk.StructLit) && t.kind[x] == int(Ty.Named) && g.kind[t.a[x]] == int(Sk.Class):
            let fi = a.child[p]
            while fi >= 0:
                let off = self.find_field(t, g, a, x, a.tok[fi])
                let ft = self.fty
                if off < 0 || self.rep(t, g, ft) < 0:
                    self.unsupported(fi)
                    return
                self.pat_test(t, g, ty, a, a.pa[fi], self.f.load(self.rep(t, g, ft), -1, self.f.field(v, off)), ft, fail)
                fi = a.next[fi]
            return
        let en = -1
        if t.kind[x] == int(Ty.Named) && g.kind[t.a[x]] == int(Sk.Enum):
            en = t.a[x]
        let vr = -1
        if en >= 0 && k == int(Nk.Member):
            vr = member_of(g, a, en, a.tok[p], int(Sk.Variant))
        elif en >= 0 && k == int(Nk.Call) && a.pa[p] >= 0 && a.kind[a.pa[p]] == int(Nk.Member):
            vr = member_of(g, a, en, a.tok[a.pa[p]], int(Sk.Variant))
        if vr >= 0:
            let tag = v
            if has_payload(t, g, en):
                tag = self.f.load(int(Rp.I64), -1, self.f.field(v, 0))
            let cont = self.new_block()
            self.branch(self.f.cmp(int(Pr.Eq), tag, self.f.cint(int(Rp.I64), self.variant_index(g, vr))), cont, fail)
            self.seal(cont)
            self.f.set_block(cont)
            if k == int(Nk.Call):
                self.pat_payload(t, g, ty, a, p, v, x, vr, fail)
            return
        let r = self.rep(t, g, x)
        let cond = -1
        if en < 0 && r >= 0 && rp_is_int(r) && self.is_int_pattern(a, p):
            cond = self.f.cmp(int(Pr.Eq), v, self.f.cint(r, self.pattern_int(a, p)))
        elif k == int(Nk.Float) && (r == int(Rp.F64) || r == int(Rp.F32)):
            let bits = float_bits(a, a.tok[p], r == int(Rp.F32))
            if bits >= 0:
                cond = self.f.fcmp(int(Pr.OEq), v, self.f.cfloat(r, bits))
        elif k == int(Nk.Str) && t.kind[x] == int(Ty.Str):
            self.f.arg(v)
            self.f.arg(self.f.strlit(self.str_lit(a, a.tok[p])))
            cond = self.f.cmp(int(Pr.Eq), self.f.ccall(int(Rp.I32), 2, self.rt_strcmp, 0), self.f.cint(int(Rp.I32), 0))
        elif k == int(Nk.Tuple) && t.kind[x] == int(Ty.Tuple):
            let c = a.child[p]
            let i = 0
            while c >= 0 && i < t.count_of(x):
                let et = t.arg(x, i)
                self.pat_test(t, g, ty, a, c, self.f.extract(self.rep(t, g, et), v, i), et, fail)
                i = i + 1
                c = a.next[c]
            return
        if cond < 0:
            self.unsupported(p)
            return
        let cont = self.new_block()
        self.branch(cond, cont, fail)
        self.seal(cont)
        self.f.set_block(cont)

    /#/ Is `p` a name that binds the matched value (not `_`, not a constant)?
    fn is_binder(self, ty: &Typer, a: &Ast, p: int) => bool:
        if a.kind[p] != int(Nk.Name) || tok_is(a, a.tok[p], "_"):
            return false
        return self.lookup(a, a.tok[p]) >= 0 || ty.lookup(a, a.tok[p]) < 0

    /#/ Binds the names of pattern `p` in the arm. `v` is the matched value, `x` its type. A bound
    /#/ resource is a copy owned by the arm.
    fn pattern_bind(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, p: int, v: int, x: int) => void:
        let k = a.kind[p]
        if k == int(Nk.Name):
            if self.is_binder(ty, a, p):
                let val = v
                if needs_drop(t, g, x):
                    val = self.clone_value(t, g, v, x)
                self.bind_var(t, g, a, a.tok[p], x, val)
        elif k == int(Nk.Call) && t.kind[x] == int(Ty.Named) && g.kind[t.a[x]] == int(Sk.Enum):
            self.bind_variant(t, g, ty, a, p, v, x, t.a[x])
        elif k == int(Nk.StructLit) && t.kind[x] == int(Ty.Named) && g.kind[t.a[x]] == int(Sk.Class):
            let fi = a.child[p]
            while fi >= 0:
                let off = self.find_field(t, g, a, x, a.tok[fi])
                let ft = self.fty
                if off >= 0 && self.rep(t, g, ft) >= 0:
                    self.pattern_bind(t, g, ty, a, a.pa[fi], self.f.load(self.rep(t, g, ft), -1, self.f.field(v, off)), ft)
                fi = a.next[fi]
        elif k == int(Nk.Tuple) && t.kind[x] == int(Ty.Tuple):
            let c = a.child[p]
            let i = 0
            while c >= 0 && i < t.count_of(x):
                let et = t.arg(x, i)
                self.pattern_bind(t, g, ty, a, c, self.f.extract(self.rep(t, g, et), v, i), et)
                i = i + 1
                c = a.next[c]
        elif k == int(Nk.Binary) && a.pc[p] == int(Tk.Pipe):
            /#/ `A(n) | B(n)`: the first alternative that matches binds; the second writes the
            /#/ same variables, so the names are one variable on both paths
            let second = self.new_block()
            let join = self.new_block()
            let saved = self.or_mark
            let mark = self.sc.n
            self.pat_test(t, g, ty, a, a.pa[p], v, x, second)
            self.pattern_bind(t, g, ty, a, a.pa[p], v, x)
            self.jump(join)
            self.seal(second)
            self.f.set_block(second)
            self.or_mark = mark
            self.pattern_bind(t, g, ty, a, a.pb[p], v, x)
            self.or_mark = saved
            self.jump(join)
            self.seal(join)
            self.f.set_block(join)

    /#/ Binds the payload names of the variant pattern `p`.
    fn bind_variant(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, p: int, v: int, x: int, en: int) => void:
        let vr = member_of(g, a, en, a.tok[a.pa[p]], int(Sk.Variant))
        if vr < 0:
            return
        self.payload_layout(t, g, x, vr)
        let offs: buf<int> = new_buf(int, self.lay_n + 1)
        let tys: buf<int> = new_buf(int, self.lay_n + 1)
        let cnt = self.lay_n
        for i in 0..cnt:
            offs[i] = self.lay_off[i]
            tys[i] = self.lay_ty[i]
        let c = a.child[p]
        let i = 0
        while c >= 0 && i < cnt:
            let r = self.rep(t, g, tys[i])
            if r < 0:
                self.unsupported(c)
            else:
                self.pattern_bind(t, g, ty, a, c, self.f.load(r, -1, self.f.field(v, offs[i])), tys[i])
            i = i + 1
            c = a.next[c]

    /#/ `match`: the arms are tried in order; a name or `_` matches anything. A payload that is
    /#/ bound is a copy owned by the arm.
    fn match_stmt(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => void:
        let s = a.pa[n]
        let st = self.strip_refs(t, self.nd(t, ty, s))
        let sv = self.exb(t, g, ty, a, s)
        if t.kind[self.nd(t, ty, s)] == int(Ty.Ref) && !is_handle(t, g, st) && self.rep(t, g, st) >= 0:
            sv = self.f.load(self.rep(t, g, st), -1, sv)
        if self.rep(t, g, st) < 0:
            self.unsupported(n)
            return
        let join = self.new_block()
        let tail_arms = self.tailm == n
        self.tailm = -1
        let arm = a.child[n]
        while arm >= 0:
            let p = a.pa[arm]
            let next = self.new_block()
            self.pat_test(t, g, ty, a, p, sv, st, next)
            let own_mark = self.own_n
            let mark = self.sc.n
            self.pattern_bind(t, g, ty, a, p, sv, st)
            if a.pc[arm] >= 0:
                let ok = self.new_block()
                let gf = self.new_block()
                self.branch(self.ex(t, g, ty, a, a.pc[arm]), ok, gf)
                self.seal(ok)
                self.seal(gf)
                self.f.set_block(gf)
                self.drop_scope(t, g, a, own_mark)
                self.jump(next)
                self.f.set_block(ok)
            if tail_arms:
                self.tailb = a.pb[arm]
            self.block(t, g, ty, a, a.pb[arm])
            self.tailb = -1
            if !self.f.terminated(self.f.cur):
                self.drop_scope(t, g, a, own_mark)
            self.own_n = own_mark
            self.sc.truncate(mark)
            self.jump(join)
            self.seal(next)
            self.f.set_block(next)
            arm = a.next[arm]
        self.jump(join)
        self.seal(join)
        self.f.set_block(join)

    /#/ Drop glue of an enum with payloads: the fields of the live variant, then the block.
    fn glue_enum_drop(self, t: &Tys, g: &Syms, x: int, p0: int) => void:
        let en = t.a[x]
        /#/ the last field of a variant that is the enum itself is released by looping, not by
        /#/ a call: a long list does not use a stack frame per node
        let top = self.f.new_block()
        self.f.arg(p0)
        self.f.br(top)
        self.f.set_block(top)
        let cur = self.f.param(top, int(Rp.Ptr), -1)
        let tag = self.f.load(int(Rp.I64), -1, self.f.field(cur, 0))
        let end = self.f.new_block()
        let nv = 0
        let rows: buf<int> = new_buf(int, 8)
        let blocks: buf<int> = new_buf(int, 8)
        for i in 0..g.n:
            if g.info[i] == en && g.kind[i] == int(Sk.Variant):
                self.payload_layout(t, g, x, i)
                let owned = false
                for k in 0..self.lay_n:
                    if needs_drop(t, g, self.lay_ty[k]):
                        owned = true
                if owned:
                    if nv >= len(rows):
                        rows = buf_resize(rows, nv * 2)
                        blocks = buf_resize(blocks, nv * 2)
                    rows[nv] = i
                    blocks[nv] = self.f.new_block()
                    nv = nv + 1
        for k in 0..nv:
            self.f.sw_case(self.variant_index(g, rows[k]), self.f.mk_edge(blocks[k]))
        self.f.switch(tag, self.f.mk_edge(end))
        for k in 0..nv:
            self.f.set_block(blocks[k])
            self.payload_layout(t, g, x, rows[k])
            let tail = -1
            for q in 0..self.lay_n:
                if self.lay_ty[q] == x:
                    tail = q
            let nxt = -1
            if tail >= 0:
                nxt = self.f.load(int(Rp.Ptr), -1, self.f.field(cur, self.lay_off[tail]))
            for q in 0..self.lay_n:
                let ft = self.lay_ty[q]
                if q != tail && needs_drop(t, g, ft):
                    self.drop_value(t, g, self.f.load(self.rep(t, g, ft), -1, self.f.field(cur, self.lay_off[q])), ft)
            self.f.free(cur)
            if tail >= 0:
                self.f.arg(nxt)
                self.f.br(top)
            else:
                self.f.ret_void()
        self.f.set_block(end)
        self.f.free(cur)
        self.f.ret_void()

    /#/ Clone glue of an enum with payloads: the tag, and the fields of the live variant.
    fn glue_enum_clone(self, t: &Tys, g: &Syms, x: int, p: int) => void:
        let en = t.a[x]
        let q = self.f.alloc(st_block(t, g, x))
        let tag = self.f.load(int(Rp.I64), -1, self.f.field(p, 0))
        self.f.store(self.f.field(q, 0), tag)
        let end = self.f.new_block()
        let nv = 0
        let rows: buf<int> = new_buf(int, 8)
        let blocks: buf<int> = new_buf(int, 8)
        for i in 0..g.n:
            if g.info[i] == en && g.kind[i] == int(Sk.Variant):
                self.payload_layout(t, g, x, i)
                if self.lay_n > 0:
                    if nv >= len(rows):
                        rows = buf_resize(rows, nv * 2)
                        blocks = buf_resize(blocks, nv * 2)
                    rows[nv] = i
                    blocks[nv] = self.f.new_block()
                    nv = nv + 1
        for k in 0..nv:
            self.f.sw_case(self.variant_index(g, rows[k]), self.f.mk_edge(blocks[k]))
        self.f.switch(tag, self.f.mk_edge(end))
        for k in 0..nv:
            self.f.set_block(blocks[k])
            self.payload_layout(t, g, x, rows[k])
            for j in 0..self.lay_n:
                let ft = self.lay_ty[j]
                let v = self.f.load(self.rep(t, g, ft), -1, self.f.field(p, self.lay_off[j]))
                if needs_drop(t, g, ft):
                    v = self.clone_value(t, g, v, ft)
                self.f.store(self.f.field(q, self.lay_off[j]), v)
            self.f.br(end)
        self.f.set_block(end)
        self.f.ret_v(q)

    /#/ ---- representations, slots, places ---------------------------------------

    /#/ The representation of type `x`: a scalar, a pointer, or an aggregate (`buf<T>`, a
    /#/ slice, a tuple); -1 when it has none.
    fn rep(self, t: &Tys, g: &Syms, x: int) => int:
        let r = rep_of(t, g, x)
        if r >= 0:
            return r
        let k = t.kind[x]
        if (k == int(Ty.Buf) && t.a[x] >= 0) || k == int(Ty.Slice):
            let items: buf<int> = new_buf(int, 2)
            items[0] = int(Rp.Ptr)
            items[1] = int(Rp.I64)
            return self.rs.agg(&items, 2)
        if k == int(Ty.Tuple):
            let n = t.count_of(x)
            let items: buf<int> = new_buf(int, n + 1)
            for i in 0..n:
                let e = self.rep(t, g, t.arg(x, i))
                if e <= 0:
                    return -1
                items[i] = e
            return self.rs.agg(&items, n)
        return -1

    /#/ Every name `&` is applied to in the module: those variables live in a slot.
    fn scan_addr(self, a: &Ast) => void:
        if self.scanned == 1:
            return
        self.scanned = 1
        for i in 0..a.count:
            if a.kind[i] == int(Nk.Unary) && a.pc[i] == int(Tk.Amp) && a.pa[i] >= 0 && a.kind[a.pa[i]] == int(Nk.Name):
                let w = new_txt()
                for q in a.toks.start[a.tok[a.pa[i]]]..a.toks.end[a.tok[a.pa[i]]]:
                    w.put_byte(a.byte_at(q))
                self.addr.intern(&w)

    fn is_addr(self, a: &Ast, tok: int) => bool:
        let w = new_txt()
        for q in a.toks.start[tok]..a.toks.end[tok]:
            w.put_byte(a.byte_at(q))
        return self.addr.find(&w) >= 0

    /#/ A new variable named by `tok` holding `val`: in a slot when `&` is taken of it.
    fn bind_var(self, t: &Tys, g: &Syms, a: &Ast, tok: int, vt: int, val: int) => int:
        if self.or_mark >= 0:
            let row = self.sc.find_tok(a, tok, self.or_mark)
            if row >= 0 && self.sc.kind[row] == int(Sk.Local):
                let old = self.sc.info[row]
                self.var_write(old, val)
                if self.v_flag[old] >= 0:
                    self.write_var(self.v_flag[old], self.f.cur, self.f.cint(int(Rp.I8), 1))
                return old
        let vr = self.rep(t, g, vt)
        let v = self.new_var(a, tok, vr, vt)
        if tok >= 0 && !is_handle(t, g, vt) && self.is_addr(a, tok):
            let s = self.f.slot(st_size(t, g, vt))
            self.v_slot[v] = s
            self.f.store(s, val)
        else:
            self.write_var(v, self.f.cur, val)
        if self.no_own == 0:
            self.own_bind(t, g, a, v, vt)
        return v

    fn var_read(self, v: int) => int:
        if self.v_slot[v] >= 0:
            return self.f.load(self.v_rep[v], -1, self.v_slot[v])
        return self.read_var(v, self.f.cur)

    fn var_write(self, v: int, val: int) => void:
        if self.v_slot[v] >= 0:
            self.f.store(self.v_slot[v], val)
        else:
            self.write_var(v, self.f.cur, val)

    fn strip_refs(self, t: &Tys, x: int) => int:
        let c = x
        while t.kind[c] == int(Ty.Ref):
            c = t.a[c]
        return c

    /#/ The offset of field `tok` in class type `cls` (ancestors' fields come first); the field's
    /#/ type is left in `fty`. -1 when there is no such field.
    fn find_field(self, t: &Tys, g: &Syms, a: &Ast, cls: int, tok: int) => int:
        let chain: buf<int> = new_buf(int, 8)
        let n = 0
        let cur = t.a[cls]
        while cur >= 0 && n < 8:
            chain[n] = cur
            n = n + 1
            let next = -1
            for i in 0..g.n:
                if g.info[i] == cur && g.kind[i] == int(Sk.Parent):
                    next = g.find_class_row(i)
            cur = next
        return self.find_field_span(t, g, a, cls, chain, n, a.toks.start[tok], a.toks.end[tok])

    /#/ Like `find_field`, for the name spelled by the bytes `s`..`e` of the source.
    fn find_field_by(self, t: &Tys, g: &Syms, a: &Ast, cls: int, s: int, e: int) => int:
        let chain: buf<int> = new_buf(int, 8)
        let n = 0
        let cur = t.a[cls]
        while cur >= 0 && n < 8:
            chain[n] = cur
            n = n + 1
            let next = -1
            for i in 0..g.n:
                if g.info[i] == cur && g.kind[i] == int(Sk.Parent):
                    next = g.find_class_row(i)
            cur = next
        return self.find_field_span(t, g, a, cls, chain, n, s, e)

    /#/ The search of `find_field_by`, given the `n` classes of the chain, root first at `n - 1`.
    fn find_field_span(self, t: &Tys, g: &Syms, a: &Ast, cls: int, chain: buf<int>, n: int, s: int, e: int) => int:
        let h = g.span_hash(a, s, e)
        let off = 0
        let c = n - 1
        while c >= 0:
            for i in 0..g.n:
                if g.info[i] == chain[c] && g.kind[i] == int(Sk.Field) && g.ty[i] >= 0:
                    let ft = subst_env(t, g.ty[i], cls)
                    off = align_up(off, st_align(t, g, ft))
                    if g.same_span(i, a, s, e, h):
                        self.fty = ft
                        return off
                    off = off + st_size(t, g, ft)
            c = c - 1
        return -1

    /#/ The address of field `n` (a Member node) of a class value.
    fn field_addr(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let o = a.pa[n]
        let ot = self.strip_refs(t, self.nd(t, ty, o))
        if t.kind[ot] != int(Ty.Named) || g.kind[t.a[ot]] != int(Sk.Class):
            self.unsupported(n)
            return self.f.undef(int(Rp.Ptr))
        let off = self.find_field(t, g, a, ot, a.tok[n])
        if off < 0:
            self.unsupported(n)
            return self.f.undef(int(Rp.Ptr))
        return self.f.field(self.exb(t, g, ty, a, o), off)

    /#/ The value of an aggregate (`buf<T>`, slice, tuple) held by `o`, which may be a reference.
    fn agg_of(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, o: int) => int:
        let v = self.exb(t, g, ty, a, o)
        let ot = self.nd(t, ty, o)
        if t.kind[ot] == int(Ty.Ref):
            return self.f.load(self.rep(t, g, t.a[ot]), -1, v)
        return v

    fn trap(self) => void:
        self.f.arg(self.f.cint(int(Rp.I32), 1))
        self.f.ccall(int(Rp.Void), 1, self.rt_exit, 0)
        self.f.unreachable()

    /#/ The address of element `n` (an Index node), after a bounds check; the element type is
    /#/ left in `fty`.
    /#/ `s[i]` on a string: the byte, after a check against the length (as the Rust compiler does).
    fn str_byte(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let it = self.nd(t, ty, a.pb[n])
        let r = self.rep(t, g, self.nd(t, ty, n))
        if !t.is_int(it) || r < 0:
            self.unsupported(n)
            return self.f.undef(int(Rp.I8))
        let base = self.exb(t, g, ty, a, a.pa[n])
        let i = self.coerce(t, g, self.ex(t, g, ty, a, a.pb[n]), it, t.int_ty(8, true))
        self.f.arg(base)
        let count = self.f.ccall(int(Rp.I64), 1, self.rt_strlen, 0)
        let good = self.new_block()
        let bad = self.new_block()
        self.branch(self.f.cmp(int(Pr.ULt), i, count), good, bad)
        self.seal(good)
        self.seal(bad)
        self.f.set_block(bad)
        self.trap()
        self.f.set_block(good)
        return self.f.load(r, -1, self.f.index(base, i, 1))

    fn element_addr(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let o = a.pa[n]
        let ot = self.strip_refs(t, self.nd(t, ty, o))
        let k = t.kind[ot]
        if !((k == int(Ty.Buf) && t.a[ot] >= 0) || k == int(Ty.Slice) || k == int(Ty.Array)):
            self.unsupported(n)
            return self.f.undef(int(Rp.Ptr))
        let it = self.nd(t, ty, a.pb[n])
        if !t.is_int(it):
            self.unsupported(n)
            return self.f.undef(int(Rp.Ptr))
        let data = -1
        let count = -1
        if k == int(Ty.Array):
            data = self.ex(t, g, ty, a, o)
            count = self.f.cint(int(Rp.I64), t.b[ot])
        else:
            let agg = self.agg_of(t, g, ty, a, o)
            data = self.f.extract(int(Rp.Ptr), agg, 0)
            count = self.f.extract(int(Rp.I64), agg, 1)
        let i = self.coerce(t, g, self.ex(t, g, ty, a, a.pb[n]), it, t.int_ty(8, true))
        let good = self.new_block()
        let bad = self.new_block()
        self.branch(self.f.cmp(int(Pr.ULt), i, count), good, bad)
        self.seal(good)
        self.seal(bad)
        self.f.set_block(bad)
        self.trap()
        self.f.set_block(good)
        let elem = t.a[ot]
        self.fty = elem
        return self.f.index(data, i, st_size(t, g, elem))

    /#/ `Name { field: value, ... }`: a block of the class's size with every field stored.
    fn struct_lit(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let x = self.nd(t, ty, n)
        if t.kind[x] != int(Ty.Named) || g.kind[t.a[x]] != int(Sk.Class):
            self.unsupported(n)
            return self.f.undef(int(Rp.Ptr))
        let p = self.f.alloc(st_block(t, g, x))
        let fi = a.child[n]
        while fi >= 0:
            let off = self.find_field(t, g, a, x, a.tok[fi])
            if off < 0:
                self.unsupported(fi)
                return p
            let ft = self.fty
            let v = self.sink(t, g, ty, a, a.pa[fi], ft)
            self.f.store(self.f.field(p, off), v)
            fi = a.next[fi]
        return p

    fn tuple_lit(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let x = self.nd(t, ty, n)
        let r = self.rep(t, g, x)
        if r < 0 || t.kind[x] != int(Ty.Tuple):
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let agg = self.f.undef(r)
        let c = a.child[n]
        let i = 0
        while c >= 0:
            let v = self.sink(t, g, ty, a, c, t.arg(x, i))
            agg = self.f.insert(agg, v, i)
            i = i + 1
            c = a.next[c]
        return agg

    fn array_lit(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let x = self.nd(t, ty, n)
        if t.kind[x] != int(Ty.Array) || self.rep(t, g, t.a[x]) < 0:
            self.unsupported(n)
            return self.f.undef(int(Rp.Ptr))
        let size = st_size(t, g, t.a[x])
        let p = self.f.alloc(size * t.b[x])
        let c = a.child[n]
        let i = 0
        while c >= 0:
            let v = self.sink(t, g, ty, a, c, t.a[x])
            self.f.store(self.f.index(p, self.f.cint(int(Rp.I64), i), size), v)
            i = i + 1
            c = a.next[c]
        return p

    /#/ `a.b`: a field of a class, or an element of a tuple.
    fn member(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let o = a.pa[n]
        if self.enum_row(ty, a, o) >= 0:
            return self.variant(t, g, ty, a, n, n)
        let ot = self.strip_refs(t, self.nd(t, ty, o))
        let r = self.rep(t, g, self.nd(t, ty, n))
        if r < 0:
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        if t.kind[ot] == int(Ty.Tuple):
            let agg = self.agg_of(t, g, ty, a, o)
            return self.f.extract(r, agg, lit_digits(a, a.tok[n]))
        return self.f.load(r, -1, self.field_addr(t, g, ty, a, n))

    /#/ `len(x)` of a buffer, slice, array or string.
    fn len_call(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let o = a.child[n]
        let ot = self.strip_refs(t, self.nd(t, ty, o))
        let k = t.kind[ot]
        if k == int(Ty.Array):
            self.ex(t, g, ty, a, o)
            return self.f.cint(int(Rp.I64), t.b[ot])
        if (k == int(Ty.Buf) && t.a[ot] >= 0) || k == int(Ty.Slice):
            return self.f.extract(int(Rp.I64), self.agg_of(t, g, ty, a, o), 1)
        if k == int(Ty.Str):
            self.f.arg(self.exb(t, g, ty, a, o))
            return self.f.ccall(int(Rp.I64), 1, self.rt_strlen, 0)
        self.unsupported(n)
        return self.f.cint(int(Rp.I64), 0)

    /#/ `new_buf(T, n)`: `n` zeroed elements.
    fn new_buf_call(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let x = self.nd(t, ty, n)
        let r = self.rep(t, g, x)
        let c = a.next[a.child[n]]
        if r < 0 || t.kind[x] != int(Ty.Buf) || t.a[x] < 0 || c < 0 || self.rep(t, g, t.a[x]) < 0:
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let cnt = self.coerce(t, g, self.ex(t, g, ty, a, c), self.nd(t, ty, c), t.int_ty(8, true))
        self.f.arg(cnt)
        self.f.arg(self.f.cint(int(Rp.I64), st_size(t, g, t.a[x])))
        let p = self.f.ccall(int(Rp.Ptr), 2, self.rt_calloc, 0)
        let agg = self.f.insert(self.f.undef(r), p, 0)
        return self.f.insert(agg, cnt, 1)

    /#/ `buf_resize(b, n)`: a zeroed block of `n` elements with the first elements of `b` copied in.
    /#/ `b` is left as it is, so the assignment `b = buf_resize(b, n)` drops (frees) the old block.
    fn buf_resize_call(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let x = self.nd(t, ty, n)
        let r = self.rep(t, g, x)
        let old = a.child[n]
        let c = -1
        if old >= 0:
            c = a.next[old]
        if r < 0 || t.kind[x] != int(Ty.Buf) || t.a[x] < 0 || c < 0 || self.rep(t, g, t.a[x]) < 0:
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let size = st_size(t, g, t.a[x])
        let ov = self.ex(t, g, ty, a, old)
        let odata = self.f.extract(int(Rp.Ptr), ov, 0)
        let olen = self.f.extract(int(Rp.I64), ov, 1)
        let cnt = self.coerce(t, g, self.ex(t, g, ty, a, c), self.nd(t, ty, c), t.int_ty(8, true))
        self.f.arg(cnt)
        self.f.arg(self.f.cint(int(Rp.I64), size))
        let p = self.f.ccall(int(Rp.Ptr), 2, self.rt_calloc, 0)
        /#/ the elements kept: the shorter of the two lengths
        let lt = self.f.conv(int(Op.ZExt), int(Rp.I64), self.f.cmp(int(Pr.ULt), olen, cnt))
        let keep = self.f.bin(int(Op.Add), cnt, self.f.bin(int(Op.Mul), self.f.bin(int(Op.Sub), olen, cnt), lt))
        self.f.arg(p)
        self.f.arg(odata)
        self.f.arg(self.f.bin(int(Op.Mul), keep, self.f.cint(int(Rp.I64), size)))
        self.f.ccall(int(Rp.Ptr), 3, self.rt_memcpy, 0)
        let agg = self.f.insert(self.f.undef(r), p, 0)
        return self.f.insert(agg, cnt, 1)

    /#/ The mangled name of a method or static function `name` of the class `row`.
    fn method_name(self, g: &Syms, a: &Ast, row: int, tok: int) => int:
        let w = new_txt()
        for q in g.off[row]..g.off[row] + g.size[row]:
            w.put_byte(g.pool[q])
        w.put_byte('_')
        for q in a.toks.start[tok]..a.toks.end[tok]:
            w.put_byte(a.byte_at(q))
        return self.names.intern(&w)

    /#/ `obj.m(args)` and `Class::f(args)`.
    /#/ `obj.assign("field", v)`: stores `v` in the field of that name.
    fn assign_call(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let callee = a.pa[n]
        let o = a.pa[callee]
        let ot = self.strip_refs(t, self.nd(t, ty, o))
        let name = a.child[n]
        let val = -1
        if name >= 0:
            val = a.next[name]
        if t.kind[ot] != int(Ty.Named) || g.kind[t.a[ot]] != int(Sk.Class) || name < 0 || val < 0 || a.kind[name] != int(Nk.Str):
            self.unsupported(n)
            return self.f.undef(int(Rp.Void))
        let off = self.find_field_by(t, g, a, ot, a.toks.start[a.tok[name]] + 1, a.toks.end[a.tok[name]] - 1)
        let ft = self.fty
        if off < 0 || self.rep(t, g, ft) < 0 || needs_drop(t, g, ft):
            self.unsupported(n)
            return self.f.undef(int(Rp.Void))
        let recv = self.exb(t, g, ty, a, o)
        let v = self.sink(t, g, ty, a, val, ft)
        self.f.store(self.f.field(recv, off), v)
        return self.f.undef(int(Rp.Void))

    fn member_call(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        let callee = a.pa[n]
        let sig = self.nd(t, ty, callee)
        let o = a.pa[callee]
        if tok_is(a, a.tok[callee], "assign") && (sig < 0 || t.kind[sig] != int(Ty.Fn)):
            return self.assign_call(t, g, ty, a, n)
        if sig < 0 || t.kind[sig] != int(Ty.Fn) || o < 0:
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let row = -1
        let first = 0
        let recv = -1
        if a.pd[callee] == 1:
            let sr = ty.lookup(a, a.tok[o])
            if sr < 0 || ty.rd.sc.loc.kind[sr] != int(Sk.Class):
                self.unsupported(n)
                return self.f.undef(int(Rp.I64))
            row = ty.rd.sc.loc.info[sr]
        else:
            let ot = self.strip_refs(t, self.nd(t, ty, o))
            if t.kind[ot] != int(Ty.Named) || g.kind[t.a[ot]] != int(Sk.Class):
                self.unsupported(n)
                return self.f.undef(int(Rp.I64))
            row = t.a[ot]
            recv = self.exb(t, g, ty, a, o)
            first = 1
            sig = subst_env(t, sig, ot)
        let rr = self.rep(t, g, t.c[sig])
        if rr < 0:
            self.unsupported(n)
            return self.f.undef(int(Rp.I64))
        let vals: buf<int> = new_buf(int, 8)
        let i = 0
        if first == 1:
            vals[0] = recv
            i = 1
        let c = a.child[n]
        while c >= 0:
            if i >= len(vals):
                vals = buf_resize(vals, i * 2)
            let v = self.ex(t, g, ty, a, c)
            if i < t.count_of(sig):
                v = self.coerce(t, g, v, self.nd(t, ty, c), t.arg(sig, i))
                if t.kind[t.arg(sig, i)] != int(Ty.Ref):
                    v = self.consume(t, g, a, c, v, self.nd(t, ty, c))
            vals[i] = v
            i = i + 1
            c = a.next[c]
        for j in 0..i:
            self.f.arg(vals[j])
        let mid = self.method_name(g, a, row, a.tok[callee])
        if g.ty[row] > 0:
            if first == 0:
                self.unsupported(n)
                return self.f.undef(int(Rp.I64))
            let ot = self.strip_refs(t, self.nd(t, ty, o))
            let mn = self.method_node_of(g, a, row, a.tok[callee])
            if mn < 0:
                self.unsupported(n)
                return self.f.undef(int(Rp.I64))
            let base = new_txt()
            self.names.put(&base, mid)
            mid = self.inst_name(&base, ot)
            self.want_instance(mn, ot, row)
        return self.f.call(rr, -1, mid)

    /#/ ---- ownership -----------------------------------------------------------

    /#/ The value of `n` where it is only borrowed: a literal stays static, a temporary that
    /#/ owns something is released at the end of the statement.
    fn exb(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, n: int) => int:
        if a.kind[n] == int(Nk.Str):
            return self.f.strlit(self.str_lit(a, a.tok[n]))
        let v = self.ex(t, g, ty, a, n)
        let x = self.nd(t, ty, n)
        let k = a.kind[n]
        if needs_drop(t, g, x) && (k == int(Nk.Call) || k == int(Nk.StructLit) || k == int(Nk.Array) || k == int(Nk.Binary) || k == int(Nk.Unary)):
            if self.tmp_n >= len(self.tmp_v):
                self.tmp_v = buf_resize(self.tmp_v, (self.tmp_n + 1) * 2)
                self.tmp_ty = buf_resize(self.tmp_ty, (self.tmp_n + 1) * 2)
            self.tmp_v[self.tmp_n] = v
            self.tmp_ty[self.tmp_n] = x
            self.tmp_n = self.tmp_n + 1
        return v

    fn flush_temps(self, t: &Tys, g: &Syms) => void:
        if self.reachable():
            let i = self.tmp_n - 1
            while i >= 0:
                self.drop_value(t, g, self.tmp_v[i], self.tmp_ty[i])
                i = i - 1
        self.tmp_n = 0

    /#/ The name number of the glue function of type `x`: `drop.N` (kind 0) or `clone.N`
    /#/ (kind 1); it is generated when the module is finished.
    fn glue(self, x: int, kind: int) => int:
        let w = new_txt()
        if kind == 0:
            w.put("drop.")
        else:
            w.put("clone.")
        w.put_int(x)
        let id = self.names.intern(&w)
        for i in 0..self.glue_n:
            if self.glue_ty[i] == x && self.glue_kind[i] == kind:
                return id
        if self.glue_n >= len(self.glue_ty):
            self.glue_ty = buf_resize(self.glue_ty, (self.glue_n + 1) * 2)
            self.glue_kind = buf_resize(self.glue_kind, (self.glue_n + 1) * 2)
        self.glue_ty[self.glue_n] = x
        self.glue_kind[self.glue_n] = kind
        self.glue_n = self.glue_n + 1
        return id

    /#/ Releases the value `v` of type `x`.
    fn drop_value(self, t: &Tys, g: &Syms, v: int, x: int) => void:
        let k = t.kind[x]
        if k == int(Ty.Str):
            self.f.free(v)
        elif k == int(Ty.Buf):
            self.f.free(self.f.extract(int(Rp.Ptr), v, 0))
        elif k == int(Ty.Array) && !needs_drop(t, g, t.a[x]):
            self.f.free_n(v, st_size(t, g, t.a[x]) * t.b[x])
        elif k == int(Ty.Named) && class_plain(t, g, x):
            /#/ nothing inside to release: the drop is the free, no call
            self.f.free_n(v, st_block(t, g, x))
        elif k == int(Ty.Tuple):
            for i in 0..t.count_of(x):
                let et = t.arg(x, i)
                if needs_drop(t, g, et):
                    self.drop_value(t, g, self.f.extract(self.rep(t, g, et), v, i), et)
        else:
            self.f.drop_of(v, self.glue(x, 0))

    /#/ A deep copy of `v`, of type `x`.
    fn clone_value(self, t: &Tys, g: &Syms, v: int, x: int) => int:
        let k = t.kind[x]
        if k == int(Ty.Str):
            self.f.arg(v)
            return self.f.ccall(int(Rp.Ptr), 1, self.rt_strdup, 0)
        if k == int(Ty.Array) && !needs_drop(t, g, t.a[x]):
            let bytes = st_size(t, g, t.a[x]) * t.b[x]
            let p = self.f.alloc(bytes)
            self.f.arg(p)
            self.f.arg(v)
            self.f.arg(self.f.cint(int(Rp.I64), bytes))
            self.f.ccall(int(Rp.Ptr), 3, self.rt_memcpy, 0)
            return p
        if k == int(Ty.Named) || k == int(Ty.Array):
            return self.f.clone_of(v, self.glue(x, 1))
        if k == int(Ty.Tuple):
            let agg = v
            for i in 0..t.count_of(x):
                let et = t.arg(x, i)
                if needs_drop(t, g, et):
                    let e = self.f.extract(self.rep(t, g, et), v, i)
                    agg = self.f.insert(agg, self.clone_value(t, g, e, et), i)
            return agg
        self.f.arg(v)
        return v

    /#/ The variable `v` has just been made; if its type owns something it gets a flag.
    fn own_bind(self, t: &Tys, g: &Syms, a: &Ast, v: int, vt: int) => void:
        if !needs_drop(t, g, vt):
            return
        let fv = self.new_var(a, -1, int(Rp.I8), -1)
        self.write_var(fv, self.f.cur, self.f.cint(int(Rp.I8), 1))
        self.v_flag[v] = fv
        if self.own_n >= len(self.own_st):
            self.own_st = buf_resize(self.own_st, (self.own_n + 1) * 2)
        self.own_st[self.own_n] = v
        self.own_n = self.own_n + 1

    /#/ Can control reach the current block?
    fn reachable(self) => bool:
        let b = self.f.cur
        if b == 0:
            return true
        let e = self.pe_head[b]
        while e >= 0:
            if self.f.eto[e] == b:
                return true
            e = self.pe_next[e]
        return false

    /#/ Releases what `v` still owns; nothing when it was moved away.
    fn drop_var(self, t: &Tys, g: &Syms, a: &Ast, v: int) => void:
        let fv = self.v_flag[v]
        if fv < 0:
            return
        let fl = self.read_var(fv, self.f.cur)
        if self.f.is_const(fl):
            if self.f.cval(fl) != 0:
                self.drop_value(t, g, self.var_read(v), self.v_ty[v])
            self.write_var(fv, self.f.cur, self.f.cint(int(Rp.I8), 0))
            return
        let yes = self.new_block()
        let join = self.new_block()
        self.branch(fl, yes, join)
        self.seal(yes)
        self.f.set_block(yes)
        self.drop_value(t, g, self.var_read(v), self.v_ty[v])
        self.write_var(fv, yes, self.f.cint(int(Rp.I8), 0))
        self.jump(join)
        self.seal(join)
        self.f.set_block(join)

    /#/ Drops the owning variables declared since scope depth `mark`, innermost first.
    fn drop_scope(self, t: &Tys, g: &Syms, a: &Ast, mark: int) => void:
        if !self.reachable():
            return
        let i = self.own_n - 1
        while i >= mark:
            self.drop_var(t, g, a, self.own_st[i])
            i = i - 1

    /#/ `v` was used where a value of type `x` is wanted, by the expression `n`: a variable
    /#/ that is moved gives up what it owned; an array is copied.
    fn consume(self, t: &Tys, g: &Syms, a: &Ast, n: int, v: int, x: int) => int:
        if !needs_drop(t, g, x):
            return v
        let k = a.kind[n]
        if k == int(Nk.Name):
            let var = self.lookup(a, a.tok[n])
            if var >= 0 && self.v_flag[var] >= 0:
                if is_moved(t, g, x):
                    self.write_var(self.v_flag[var], self.f.cur, self.f.cint(int(Rp.I8), 0))
                    return v
                return self.clone_value(t, g, v, x)
            return v
        if (k == int(Nk.Member) || k == int(Nk.Index)) && t.kind[x] == int(Ty.Array):
            return self.clone_value(t, g, v, x)
        return v


    /#/ The fields of class type `x` in layout order, in `lay_ty` and `lay_off`.
    fn layout(self, t: &Tys, g: &Syms, x: int) => void:
        let chain: buf<int> = new_buf(int, 8)
        let n = 0
        let cur = t.a[x]
        while cur >= 0 && n < 8:
            chain[n] = cur
            n = n + 1
            let next = -1
            for i in 0..g.n:
                if g.info[i] == cur && g.kind[i] == int(Sk.Parent):
                    next = g.find_class_row(i)
            cur = next
        self.lay_n = 0
        let off = 0
        let c = n - 1
        while c >= 0:
            for i in 0..g.n:
                if g.info[i] == chain[c] && g.kind[i] == int(Sk.Field) && g.ty[i] >= 0:
                    let ft = subst_env(t, g.ty[i], x)
                    off = align_up(off, st_align(t, g, ft))
                    if self.lay_n >= len(self.lay_ty):
                        self.lay_ty = buf_resize(self.lay_ty, (self.lay_n + 1) * 2)
                        self.lay_off = buf_resize(self.lay_off, (self.lay_n + 1) * 2)
                    self.lay_ty[self.lay_n] = ft
                    self.lay_off[self.lay_n] = off
                    self.lay_n = self.lay_n + 1
                    off = off + st_size(t, g, ft)
            c = c - 1

    /#/ Generates the drop and clone functions asked for so far, as machine code.
    fn emit_glue(self, t: &Tys, g: &Syms) => void:
        while self.glue_done < self.glue_n:
            let x = self.glue_ty[self.glue_done]
            let kind = self.glue_kind[self.glue_done]
            self.glue_done = self.glue_done + 1
            let name = new_txt()
            if kind == 0:
                name.put("drop.")
            else:
                name.put("clone.")
            name.put_int(x)
            if kind == 0:
                self.f.reset(&name, int(Rp.Void))
            else:
                self.f.reset(&name, int(Rp.Ptr))
            self.sc.truncate(0)
            let b = self.f.new_block()
            self.f.set_block(b)
            let p = self.f.param(b, int(Rp.Ptr), -1)
            if t.kind[x] == int(Ty.Array):
                self.glue_array(t, g, x, p, kind)
            elif g.kind[t.a[x]] == int(Sk.Enum):
                if kind == 0:
                    self.glue_enum_drop(t, g, x, p)
                else:
                    self.glue_enum_clone(t, g, x, p)
            else:
                self.layout(t, g, x)
                if kind == 0 && self.glue_class_loop(t, g, x, p):
                    self.emit_current()
                    continue
                if kind == 0:
                    self.glue_drop_fields(t, g, p)
                    self.f.free_n(p, st_block(t, g, x))
                    self.f.ret_void()
                else:
                    let q = self.f.alloc(st_block(t, g, x))
                    self.glue_clone_fields(t, g, p, q)
                    self.f.ret_v(q)
            self.emit_current()

    /#/ Drop glue of a class whose last owned field is an enum that holds the class again
    /#/ (`next: Option` with `Some(L)`): the chain is released by looping. False, with nothing
    /#/ emitted, when the class has no such field.
    fn glue_class_loop(self, t: &Tys, g: &Syms, x: int, p0: int) => bool:
        let n = self.lay_n
        let ftys: buf<int> = new_buf(int, n + 1)
        let foffs: buf<int> = new_buf(int, n + 1)
        for i in 0..n:
            ftys[i] = self.lay_ty[i]
            foffs[i] = self.lay_off[i]
        let tail = -1
        let var = -1
        let vfield = -1
        for i in 0..n:
            let et = ftys[i]
            if t.kind[et] == int(Ty.Named) && g.kind[t.a[et]] == int(Sk.Enum) && has_payload(t, g, t.a[et]):
                for v in 0..g.n:
                    if g.info[v] == t.a[et] && g.kind[v] == int(Sk.Variant) && var < 0:
                        self.payload_layout(t, g, et, v)
                        for q in 0..self.lay_n:
                            if self.lay_ty[q] == x:
                                tail = i
                                var = v
                                vfield = q
        if tail < 0:
            return false
        let et = ftys[tail]
        let top = self.f.new_block()
        self.f.arg(p0)
        self.f.br(top)
        self.f.set_block(top)
        let cur = self.f.param(top, int(Rp.Ptr), -1)
        for i in 0..n:
            if i != tail && needs_drop(t, g, ftys[i]):
                self.drop_value(t, g, self.f.load(self.rep(t, g, ftys[i]), -1, self.f.field(cur, foffs[i])), ftys[i])
        let e = self.f.load(int(Rp.Ptr), -1, self.f.field(cur, foffs[tail]))
        self.f.free(cur)
        let tag = self.f.load(int(Rp.I64), -1, self.f.field(e, 0))
        let hit = self.f.new_block()
        let other = self.f.new_block()
        self.f.sw_case(self.variant_index(g, var), self.f.mk_edge(hit))
        self.f.switch(tag, self.f.mk_edge(other))
        self.f.set_block(other)
        self.drop_value(t, g, e, et)
        self.f.ret_void()
        self.f.set_block(hit)
        self.payload_layout(t, g, et, var)
        let nxt = self.f.load(int(Rp.Ptr), -1, self.f.field(e, self.lay_off[vfield]))
        for q in 0..self.lay_n:
            if q != vfield && needs_drop(t, g, self.lay_ty[q]):
                self.drop_value(t, g, self.f.load(self.rep(t, g, self.lay_ty[q]), -1, self.f.field(e, self.lay_off[q])), self.lay_ty[q])
        self.f.free(e)
        self.f.arg(nxt)
        self.f.br(top)
        return true

    /#/ Drop or clone glue of `[T; N]` with owning elements: each element, then the block.
    fn glue_array(self, t: &Tys, g: &Syms, x: int, p: int, kind: int) => void:
        let et = t.a[x]
        let size = st_size(t, g, et)
        let r = self.rep(t, g, et)
        if kind == 0:
            for i in 0..t.b[x]:
                let v = self.f.load(r, -1, self.f.index(p, self.f.cint(int(Rp.I64), i), size))
                self.drop_value(t, g, v, et)
            self.f.free_n(p, size * t.b[x])
            self.f.ret_void()
        else:
            let q = self.f.alloc(size * t.b[x])
            for i in 0..t.b[x]:
                let v = self.f.load(r, -1, self.f.index(p, self.f.cint(int(Rp.I64), i), size))
                if needs_drop(t, g, et):
                    v = self.clone_value(t, g, v, et)
                self.f.store(self.f.index(q, self.f.cint(int(Rp.I64), i), size), v)
            self.f.ret_v(q)

    fn glue_drop_fields(self, t: &Tys, g: &Syms, p: int) => void:
        for i in 0..self.lay_n:
            let ft = self.lay_ty[i]
            if needs_drop(t, g, ft):
                let v = self.f.load(self.rep(t, g, ft), -1, self.f.field(p, self.lay_off[i]))
                self.drop_value(t, g, v, ft)

    fn glue_clone_fields(self, t: &Tys, g: &Syms, p: int, q: int) => void:
        for i in 0..self.lay_n:
            let ft = self.lay_ty[i]
            let v = self.f.load(self.rep(t, g, ft), -1, self.f.field(p, self.lay_off[i]))
            if needs_drop(t, g, ft):
                v = self.clone_value(t, g, v, ft)
            self.f.store(self.f.field(q, self.lay_off[i]), v)

    /#/ ---- functions -----------------------------------------------------------

    /#/ Lowers the function node `fn_node` into `self.f`; `bad` says whether it could not.
    fn function(self, t: &Tys, g: &Syms, ty: &Typer, a: &Ast, fn_node: int, cls: int) => void:
        self.bad = 0
        self.scan_addr(a)
        let body = a.pc[fn_node]
        let class_ty = -1
        if cls >= 0:
            class_ty = t.named(cls)
            if self.penv >= 0 && g.ty[cls] > 0:
                class_ty = self.penv
        let sig0 = ty.rd.fn_sig(t, a, fn_node, class_ty)
        if cls >= 0 && g.ty[cls] > 0:
            /#/ the declared signature knows the type parameters of the class
            let mr = member_of(g, a, cls, a.pa[fn_node], int(Sk.Method))
            if mr >= 0 && g.ty[mr] >= 0:
                sig0 = g.ty[mr]
        let sig = subst_env(t, sig0, self.penv)
        let rr = self.rep(t, g, t.c[sig])
        let name = new_txt()
        if cls >= 0:
            for q in g.off[cls]..g.off[cls] + g.size[cls]:
                name.put_byte(g.pool[q])
            name.put_byte('_')
        if self.pnm >= 0:
            self.names.put(&name, self.pnm)
        else:
            for q in a.toks.start[a.pa[fn_node]]..a.toks.end[a.pa[fn_node]]:
                name.put_byte(a.byte_at(q))
            if self.penv >= 0:
                name.put("__")
                name.put_int(self.penv)
        self.f.reset(&name, rr)
        self.cur_id = self.names.intern(&name)
        self.nf_n = 0
        if self.pnm >= 0:
            self.nested_declare_self(a, fn_node)
        self.sc.truncate(0)
        self.dk = new_buf(int, 64)
        for i in 0..64:
            self.dk[i] = 0
        self.dv = new_buf(int, 64)
        self.dn = 0
        self.nv = 0
        self.inc_n = 0
        self.nloops = 0
        self.own_n = 0
        self.ret_ty = t.c[sig]
        self.lis = -1
        let lp = a.child[fn_node]
        while lp >= 0:
            if a.kind[lp] == int(Nk.Listener):
                let ln = new_txt()
                for q in a.toks.start[a.tok[lp]] + 1..a.toks.end[a.tok[lp]]:
                    ln.put_byte(a.byte_at(q))
                if !ln.same(&name):
                    self.lis = self.names.intern(&ln)
            lp = a.next[lp]
        if rr < 0 || body < 0:
            self.unsupported(fn_node)
            return
        let entry = self.new_block()
        self.sealed[entry] = 1
        self.f.set_block(entry)
        let p = a.child[fn_node]
        let i = 0
        while p >= 0:
            if a.kind[p] == int(Nk.TypeParam) && self.penv < 0:
                self.unsupported(p)
                return
            if a.kind[p] == int(Nk.Param) || a.kind[p] == int(Nk.SelfParam):
                let pt = t.arg(sig, i)
                let pr = self.rep(t, g, pt)
                if pr < 0 || pr == int(Rp.Void):
                    self.unsupported(p)
                    return
                /#/ `self` is borrowed from the caller
                if a.kind[p] == int(Nk.SelfParam):
                    self.no_own = 1
                self.bind_var(t, g, a, a.tok[p], pt, self.f.param(entry, pr, -1))
                self.no_own = 0
                i = i + 1
            p = a.next[p]
        if cls < 0 && self.pnm < 0 && self.penv < 0 && a.pa[fn_node] >= 0 && tok_is(a, a.pa[fn_node], "main"):
            self.init_globals(t, g, ty, a)
        self.tailb = -1
        if rr != int(Rp.Void):
            self.tailb = body
        self.tailm = -1
        self.retx = -1
        self.block(t, g, ty, a, body)
        self.tailb = -1
        if !self.f.terminated(self.f.cur):
            if rr == int(Rp.Void):
                self.drop_scope(t, g, a, 0)
                self.f.ret_void()
            else:
                self.f.unreachable()
        simplify_params(&self.f)

    /#/ Stores the function in `self.f` in the module; `finish` optimizes and emits them all.
    fn keep_current(self) => void:
        self.lib.save(&self.f, self.lib.nf, self.cur_id)

    /#/ Optimizes the functions kept, callees first.
    fn optimize_module(self) => void:
        if self.opt > 0:
            module_opt(&self.lib, &self.f)

    /#/ Generates machine code for the functions kept.
    fn generate(self) => void:
        for n in 0..self.lib.nf:
            self.lib.restore(n, &self.f)
            self.put_fun()

    /#/ The function in `self.f` as machine code; a verifier finding is counted.
    fn put_fun(self) => void:
        if verify(&self.f).n > 0:
            self.ver_err = self.ver_err + 1
        if !self.mc.gen_fun(&self.f, &self.rs, &self.names):
            self.mc_err = self.mc_err + 1

    /#/ The object file.
    fn object(self) => Txt:
        self.mc.add_rodata(&self.sbytes)
        for k in 0..self.gl_n:
            let w = new_txt()
            self.names.put(&w, self.gl_name[k])
            self.mc.add_global(&w, self.gl_size[k])
        return self.mc.elf()

    /#/ Optimizes the function in `self.f` and generates it.
    fn emit_current(self) => void:
        if self.opt > 0:
            optimize(&self.f)
        self.put_fun()

fn type_param_count(a: &Ast, f: int) => int:
    let k = 0
    let c = a.child[f]
    while c >= 0:
        if a.kind[c] == int(Nk.TypeParam):
            k = k + 1
        c = a.next[c]
    return k

/#/ Do tokens `x` and `y` of `a` spell the same name?
fn same_text(a: &Ast, x: int, y: int) => bool:
    let n = a.toks.end[x] - a.toks.start[x]
    if n != a.toks.end[y] - a.toks.start[y]:
        return false
    for k in 0..n:
        if a.byte_at(a.toks.start[x] + k) != a.byte_at(a.toks.start[y] + k):
            return false
    return true

fn new_lower() => Lower:
    let lw = make_lower()
    lw.rt_exit = lw.names.add("exit")
    lw.rt_calloc = lw.names.add("calloc")
    lw.rt_strlen = lw.names.add("strlen")
    lw.rt_malloc = lw.names.add("malloc")
    lw.rt_free = lw.names.add("free")
    lw.rt_strdup = lw.names.add("strdup")
    lw.rt_memcpy = lw.names.add("memcpy")
    lw.rt_strcmp = lw.names.add("strcmp")
    lw.rt_write = lw.names.add("write")
    return lw

fn make_lower() => Lower:
    return Lower { f: new_fun("", 0), rs: new_reps(), names: new_names(), nstr: 0, cd_name: new_buf(int, 8), cd_sig: new_buf(int, 8), cd_var: new_buf(int, 8), cd_n: 0, sc: new_syms(), v_rep: new_buf(int, 16), v_ty: new_buf(int, 16), v_slot: new_buf(int, 16), v_flag: new_buf(int, 16), tmp_v: new_buf(int, 8), tmp_ty: new_buf(int, 8), tmp_n: 0, no_own: 0, own_st: new_buf(int, 16), own_n: 0, ld: new_buf(int, 8), glue_ty: new_buf(int, 8), glue_kind: new_buf(int, 8), glue_n: 0, glue_done: 0, lay_ty: new_buf(int, 8), lay_off: new_buf(int, 8), lay_n: 0, addr: new_names(), scanned: 0, fty: 0, rt_exit: 0, rt_calloc: 0, rt_strlen: 0, rt_malloc: 0, rt_free: 0, rt_strdup: 0, rt_memcpy: 0, rt_strcmp: 0, rt_write: 0, or_mark: -1, opt: 1, mc: new_gen(), sbytes: new_txt(), mc_err: 0, ver_err: 0, lib: new_lib(), cur_id: -1, penv: -1, ue: new_buf(int, 16), iq_node: new_buf(int, 8), iq_env: new_buf(int, 8), iq_cls: new_buf(int, 8), iq_nm: new_buf(int, 8), nf_tok: new_buf(int, 8), nf_node: new_buf(int, 8), nf_id: new_buf(int, 8), nf_n: 0, pnm: -1, gl_name: new_buf(int, 8), gl_size: new_buf(int, 8), gl_n: 0, tailb: -1, tailm: -1, retx: -1, iq_n: 0, iq_done: 0, lis: -1, nv: 0, dk: new_buf(int, 64), dv: new_buf(int, 64), dn: 0, sealed: new_buf(int, 16), inc_head: new_buf(int, 16), inc_var: new_buf(int, 16), inc_par: new_buf(int, 16), inc_next: new_buf(int, 16), inc_n: 0, pe_head: new_buf(int, 16), pe_next: new_buf(int, 16), lc: new_buf(int, 8), lb: new_buf(int, 8), nloops: 0, ret_ty: 0, bad: 0, bad_node: -1 }
