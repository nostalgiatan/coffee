/#/ A RISC-V (RV64IMFD, no compressed instructions) assembler for the instructions the code generator uses: fixed
/#/ 4-byte words into the same `Asm` buffer the other assemblers write to (labels, jump fixups and relocation lists are
/#/ shared), as free functions `rv_*(a: &Asm, ...)`.
/#/
/#/ Registers are numbered as the hardware does: x0 (zero) to x31, float registers f0 to f31 by their number. Instructions
/#/ with an immediate that does not fit 12 bits build it in x31 (t6); the generator keeps nothing there across such an
/#/ instruction. A branch to a label is patched when the function ends (`rv_end_fun`); nothing is shortened.
use * in asm

/#/ Relocation types of the RISC-V ELF ABI.
fn r_rv_call_plt() => int:
    return 19

fn r_rv_hi20() => int:
    return 26

fn r_rv_lo12_i() => int:
    return 27

/#/ How far a conditional branch (reach +-4 KiB) and a jump (+-1 MiB) must be made to reach: 0 the plain forms, 1 each
/#/ conditional branch skips over a `jal`, 2 each branch or jump is `auipc` and `jalr` (+-2 GiB). A function that does not fit
/#/ is made again with the next form (`rv_range_miss` is set by `rv_end_fun`).
let rv_far: int = 0
let rv_range_miss: int = 0

/#/ Set when sandbox code (`Asm.acc.sbx`) needed a form the verifier does not take (a frame offset past 12 bits, a call with
/#/ arguments on the stack): the function is not made.
let rv_err: bool = false

/#/ Addresses of symbols are made pc-relative (cfjit's unsandboxed images sit at any address) instead of absolute below 2 GiB.
let rv_pcrel: bool = false

/#/ Sandbox code keeps the start of the linear memory in s10 and the shadow frame pointer in s11.
fn rv_sbx_base() => int:
    return 26

fn rv_sbx_sh() => int:
    return 27

fn rv_w(a: &Asm, w: int) => void:
    a.le32(w)

fn rv_set(a: &Asm, at: int, w: int) => void:
    for k in 0..4:
        a.c.b[at + k] = (w >> (8 * k)) & 255

fn rv_get(a: &Asm, at: int) => int:
    let w = 0
    for k in 0..4:
        w = w | (a.c.b[at + k] << (8 * k))
    return w

/#/ The word of each instruction format.
fn rv_enc_r(f7: int, f3: int, op: int, rd: int, rs1: int, rs2: int) => int:
    return (f7 << 25) | (rs2 << 20) | (rs1 << 15) | (f3 << 12) | (rd << 7) | op

fn rv_enc_i(f3: int, op: int, rd: int, rs1: int, imm: int) => int:
    return ((imm & 4095) << 20) | (rs1 << 15) | (f3 << 12) | (rd << 7) | op

fn rv_enc_s(f3: int, op: int, rs1: int, rs2: int, imm: int) => int:
    return (((imm >> 5) & 127) << 25) | (rs2 << 20) | (rs1 << 15) | (f3 << 12) | ((imm & 31) << 7) | op

fn rv_enc_b(f3: int, rs1: int, rs2: int, imm: int) => int:
    return (((imm >> 12) & 1) << 31) | (((imm >> 5) & 63) << 25) | (rs2 << 20) | (rs1 << 15) | (f3 << 12) | (((imm >> 1) & 15) << 8) | (((imm >> 11) & 1) << 7) | 99

fn rv_enc_u(op: int, rd: int, imm20: int) => int:
    return ((imm20 & 1048575) << 12) | (rd << 7) | op

fn rv_enc_j(rd: int, imm: int) => int:
    return (((imm >> 20) & 1) << 31) | (((imm >> 1) & 1023) << 21) | (((imm >> 11) & 1) << 20) | (((imm >> 12) & 255) << 12) | (rd << 7) | 111

/#/ ---- constants and arithmetic ---------------------------------------------

/#/ The low 12 bits of `v` as a signed number.
fn rv_lo12(v: int) => int:
    let l = v & 4095
    if l >= 2048:
        return l - 4096
    return l

/#/ rd = the 64-bit constant `v`: addi, lui and addiw, or the upper part shifted up and the low part added.
fn rv_li(a: &Asm, rd: int, v: int) => void:
    if v >= 0 - 2048 && v < 2048:
        rv_w(a, rv_enc_i(0, 19, rd, 0, v))
        return
    if v >= 0 - 2147483648 && v < 2147483648:
        let hi = ((v + 2048) >> 12) & 1048575
        rv_w(a, rv_enc_u(55, rd, hi))
        let lo = rv_lo12(v)
        if lo != 0:
            rv_w(a, rv_enc_i(0, 27, rd, rd, lo))
        return
    let lo = rv_lo12(v)
    let hi = (v - lo) >> 12
    let sh = 12
    /#/ trailing zeros of the upper part go into the shift
    while (hi & 1) == 0 && sh < 63:
        hi = hi >> 1
        sh = sh + 1
    rv_li(a, rd, hi)
    rv_w(a, rv_enc_i(1, 19, rd, rd, sh))
    if lo != 0:
        rv_w(a, rv_enc_i(0, 19, rd, rd, lo))

/#/ rd = rs.
fn rv_mov_rr(a: &Asm, rd: int, rs: int) => void:
    rv_w(a, rv_enc_i(0, 19, rd, rs, 0))

/#/ rd = rs + v; a value past 12 bits goes through x31.
fn rv_addi(a: &Asm, rd: int, rs: int, v: int) => void:
    if v >= 0 - 2048 && v < 2048:
        if v == 0 && rd == rs:
            return
        rv_w(a, rv_enc_i(0, 19, rd, rs, v))
        return
    rv_li(a, 31, v)
    rv_w(a, rv_enc_r(0, 0, 51, rd, rs, 31))

fn rv_add(a: &Asm, rd: int, rs1: int, rs2: int) => void:
    rv_w(a, rv_enc_r(0, 0, 51, rd, rs1, rs2))

fn rv_sub(a: &Asm, rd: int, rs1: int, rs2: int) => void:
    rv_w(a, rv_enc_r(32, 0, 51, rd, rs1, rs2))

fn rv_and(a: &Asm, rd: int, rs1: int, rs2: int) => void:
    rv_w(a, rv_enc_r(0, 7, 51, rd, rs1, rs2))

fn rv_or(a: &Asm, rd: int, rs1: int, rs2: int) => void:
    rv_w(a, rv_enc_r(0, 6, 51, rd, rs1, rs2))

fn rv_xor(a: &Asm, rd: int, rs1: int, rs2: int) => void:
    rv_w(a, rv_enc_r(0, 4, 51, rd, rs1, rs2))

fn rv_sll(a: &Asm, rd: int, rs1: int, rs2: int) => void:
    rv_w(a, rv_enc_r(0, 1, 51, rd, rs1, rs2))

fn rv_srl(a: &Asm, rd: int, rs1: int, rs2: int) => void:
    rv_w(a, rv_enc_r(0, 5, 51, rd, rs1, rs2))

fn rv_sra(a: &Asm, rd: int, rs1: int, rs2: int) => void:
    rv_w(a, rv_enc_r(32, 5, 51, rd, rs1, rs2))

fn rv_slt(a: &Asm, rd: int, rs1: int, rs2: int) => void:
    rv_w(a, rv_enc_r(0, 2, 51, rd, rs1, rs2))

fn rv_sltu(a: &Asm, rd: int, rs1: int, rs2: int) => void:
    rv_w(a, rv_enc_r(0, 3, 51, rd, rs1, rs2))

fn rv_mul(a: &Asm, rd: int, rs1: int, rs2: int) => void:
    rv_w(a, rv_enc_r(1, 0, 51, rd, rs1, rs2))

/#/ rd = the high 64 bits of the signed product, of the unsigned one
fn rv_mulh(a: &Asm, rd: int, rs1: int, rs2: int) => void:
    rv_w(a, rv_enc_r(1, 1, 51, rd, rs1, rs2))

fn rv_mulhu(a: &Asm, rd: int, rs1: int, rs2: int) => void:
    rv_w(a, rv_enc_r(1, 3, 51, rd, rs1, rs2))

fn rv_div(a: &Asm, rd: int, rs1: int, rs2: int) => void:
    rv_w(a, rv_enc_r(1, 4, 51, rd, rs1, rs2))

fn rv_divu(a: &Asm, rd: int, rs1: int, rs2: int) => void:
    rv_w(a, rv_enc_r(1, 5, 51, rd, rs1, rs2))

fn rv_rem(a: &Asm, rd: int, rs1: int, rs2: int) => void:
    rv_w(a, rv_enc_r(1, 6, 51, rd, rs1, rs2))

fn rv_remu(a: &Asm, rd: int, rs1: int, rs2: int) => void:
    rv_w(a, rv_enc_r(1, 7, 51, rd, rs1, rs2))

/#/ rd = rs1 op imm (12 bits): `f3` 2 slti, 3 sltiu, 4 xori, 6 ori, 7 andi.
fn rv_opi(a: &Asm, f3: int, rd: int, rs1: int, imm: int) => void:
    rv_w(a, rv_enc_i(f3, 19, rd, rs1, imm))

/#/ rd = rs shifted by the constant `n` (0 to 63): `kind` 0 left, 1 logical right, 2 arithmetic right.
fn rv_shift_i(a: &Asm, kind: int, rd: int, rs: int, n: int) => void:
    if kind == 0:
        rv_w(a, rv_enc_i(1, 19, rd, rs, n))
    elif kind == 1:
        rv_w(a, rv_enc_i(5, 19, rd, rs, n))
    else:
        rv_w(a, rv_enc_i(5, 19, rd, rs, 1024 | n))

fn rv_neg(a: &Asm, rd: int, rs: int) => void:
    rv_sub(a, rd, 0, rs)

fn rv_not(a: &Asm, rd: int, rs: int) => void:
    rv_opi(a, 4, rd, rs, 0 - 1)

/#/ rd = rs extended from its low `n` bytes (1, 2 or 4).
fn rv_extend(a: &Asm, rd: int, rs: int, n: int, signed: bool) => void:
    if (rv_ext & 2) != 0 && n < 4 && (signed || n == 2):
        if signed:
            rv_zbb_ext(a, n, rd, rs)
        else:
            rv_zbb_ext(a, 0, rd, rs)
    elif n == 1:
        if signed:
            rv_shift_i(a, 0, rd, rs, 56)
            rv_shift_i(a, 2, rd, rd, 56)
        else:
            rv_opi(a, 7, rd, rs, 255)
    elif n == 2:
        if signed:
            rv_shift_i(a, 0, rd, rs, 48)
            rv_shift_i(a, 2, rd, rd, 48)
        else:
            rv_shift_i(a, 0, rd, rs, 48)
            rv_shift_i(a, 1, rd, rd, 48)
    elif n == 4:
        if signed:
            rv_w(a, rv_enc_i(0, 27, rd, rs, 0))
        elif (rv_ext & 1) != 0:
            rv_zext_w(a, rd, rs)
        else:
            rv_shift_i(a, 0, rd, rs, 32)
            rv_shift_i(a, 1, rd, rd, 32)
    elif rd != rs:
        rv_mov_rr(a, rd, rs)

/#/ ---- memory ---------------------------------------------------------------

fn rv_log2(n: int) => int:
    if n == 1:
        return 0
    if n == 2:
        return 1
    if n == 4:
        return 2
    return 3

/#/ Sandbox code: x31 = s10 + the low 32 bits of base + disp, the address in the linear memory (the access that follows uses
/#/ 0(x31)). The five words (the first two when `disp` is 0, `addiw` or `li`/`addw` before them otherwise): the sum as a 32-bit
/#/ number, shifted up and down to clear the upper half, then added to the start of the memory. Whatever `base` holds, the address
/#/ lands in the 4 GB the code owns; the verifier wants the `srli`, `add` and the access one after the other.
fn rv_sbx_addr(a: &Asm, base: int, disp: int) => void:
    let s = base
    if disp != 0:
        if disp >= 0 - 2048 && disp < 2048:
            rv_w(a, rv_enc_i(0, 27, 31, base, disp))
        else:
            rv_li(a, 31, disp)
            rv_w(a, rv_enc_r(0, 0, 59, 31, base, 31))
        s = 31
    rv_w(a, rv_enc_i(1, 19, 31, s, 32))
    rv_w(a, rv_enc_i(5, 19, 31, 31, 32))
    rv_w(a, rv_enc_r(0, 0, 51, 31, 31, rv_sbx_base()))

/#/ rd += v in steps of at most 2032 (sandbox code moves the shadow frame pointer by immediates only).
fn rv_bump(a: &Asm, rd: int, v: int) => void:
    let left = v
    while left > 2032:
        rv_w(a, rv_enc_i(0, 19, rd, rd, 2032))
        left = left - 2032
    while left < 0 - 2032:
        rv_w(a, rv_enc_i(0, 19, rd, rd, 0 - 2032))
        left = left + 2032
    if left != 0:
        rv_w(a, rv_enc_i(0, 19, rd, rd, left))

/#/ A load into (or store of) the integer register `rt` of `n` bytes (1, 2, 4, 8) at [base + disp]. A load does not
/#/ extend: the upper bytes are zero. A displacement past 12 bits goes through x31.
fn rv_ldst(a: &Asm, load: bool, rt: int, base: int, disp: int, n: int) => void:
    let sz = rv_log2(n)
    let b = base
    let d = disp
    if a.acc.sbx:
        if a.acc.guarded(false, base == 8 || base == 2):
            rv_sbx_addr(a, base, disp)
            b = 31
            d = 0
        elif disp < 0 - 2048 || disp >= 2048:
            rv_err = true
    elif disp < 0 - 2048 || disp >= 2048:
        rv_li(a, 31, disp)
        rv_add(a, 31, base, 31)
        b = 31
        d = 0
    if load:
        let f3 = sz
        if sz < 3:
            f3 = 4 + sz
        rv_w(a, rv_enc_i(f3, 3, rt, b, d))
    else:
        rv_w(a, rv_enc_s(sz, 35, b, rt, d))

fn rv_ld(a: &Asm, rt: int, base: int, disp: int, n: int) => void:
    rv_ldst(a, true, rt, base, disp, n)

fn rv_st(a: &Asm, base: int, disp: int, rt: int, n: int) => void:
    rv_ldst(a, false, rt, base, disp, n)

/#/ rd = the address of the symbol `sym` plus `addend` (an absolute 32-bit address: the program is linked below 2 GiB): lui and addi.
fn rv_adr_sym(a: &Asm, rd: int, sym: int, addend: int) => void:
    if rv_pcrel:
        /#/ the loader of cfjit puts the image anywhere: auipc and addi, the distance filled in by `make_image` (kinds 23 and 24)
        a.reloc(sym, 23, addend)
        rv_set(a, a.c.n - 4, rv_enc_u(23, rd, 0))
        a.reloc(sym, 24, addend)
        rv_set(a, a.c.n - 4, rv_enc_i(0, 19, rd, rd, 0))
        return
    a.reloc(sym, r_rv_hi20(), addend)
    rv_set(a, a.c.n - 4, rv_enc_u(55, rd, 0))
    a.reloc(sym, r_rv_lo12_i(), addend)
    rv_set(a, a.c.n - 4, rv_enc_i(0, 19, rd, rd, 0))

/#/ ---- control flow -----------------------------------------------------------

fn rv_fix(a: &Asm, l: int, kind: int, w: int) => void:
    if a.nfx >= len(a.fx_at):
        a.fx_at = buf_resize(a.fx_at, (a.nfx + 1) * 2)
        a.fx_lab = buf_resize(a.fx_lab, (a.nfx + 1) * 2)
        a.fx_kind = buf_resize(a.fx_kind, (a.nfx + 1) * 2)
    a.fx_at[a.nfx] = a.c.n
    a.fx_lab[a.nfx] = l
    a.fx_kind[a.nfx] = kind
    a.nfx = a.nfx + 1
    rv_w(a, w)

/#/ jal x0, label (kind 0); in the widest form auipc x31 and jalr x0 (kind 2, two words).
fn rv_b(a: &Asm, l: int) => void:
    if rv_far >= 2:
        rv_fix(a, l, 2, rv_enc_u(23, 31, 0))
        rv_w(a, rv_enc_i(0, 103, 0, 31, 0))
        return
    rv_fix(a, l, 0, rv_enc_j(0, 0))

/#/ The funct3 of the branch on predicate `p`: 0 eq, 1 ne, 4 lt, 5 ge, 6 ltu, 7 geu (the others are these with the operands swapped).
fn rv_bcc(a: &Asm, f3: int, rs1: int, rs2: int, l: int) => void:
    if rv_far >= 1:
        /#/ the inverse condition over the jump
        let skip = 8
        if rv_far >= 2:
            skip = 12
        rv_w(a, rv_enc_b(f3 ^ 1, rs1, rs2, skip))
        rv_b(a, l)
        return
    rv_fix(a, l, 1, rv_enc_b(f3, rs1, rs2, 0))

/#/ call to a symbol: auipc ra and jalr ra, with one relocation for the pair.
fn rv_call_sym(a: &Asm, sym: int) => void:
    a.reloc(sym, r_rv_call_plt(), 0)
    rv_set(a, a.c.n - 4, rv_enc_u(23, 1, 0))
    rv_w(a, rv_enc_i(0, 103, 1, 1, 0))

/#/ jalr ra, 0(rs)
fn rv_callr(a: &Asm, rs: int) => void:
    rv_w(a, rv_enc_i(0, 103, 1, rs, 0))

fn rv_ret(a: &Asm) => void:
    rv_w(a, rv_enc_i(0, 103, 0, 1, 0))

fn rv_brk(a: &Asm) => void:
    rv_w(a, 1048691)

/#/ Patches the branches of the function just assembled. False if a label was never bound or a branch is out of reach (and
/#/ `rv_range_miss` says which form the function needs).
fn rv_end_fun(a: &Asm) => bool:
    for k in 0..a.nfx:
        let to = a.lab[a.fx_lab[k]]
        if to < 0:
            return false
        let at = a.fx_at[k]
        let d = to - at
        let w = rv_get(a, at)
        if a.fx_kind[k] == 0:
            if d < 0 - 1048576 || d >= 1048576:
                if rv_range_miss < 2:
                    rv_range_miss = 2
                return false
            rv_set(a, at, w | rv_enc_j(0, d))
        elif a.fx_kind[k] == 1:
            if d < 0 - 4096 || d >= 4096:
                if rv_range_miss < 1:
                    rv_range_miss = 1
                return false
            rv_set(a, at, w | rv_enc_b(0, 0, 0, d))
        else:
            /#/ auipc x31, hi; jalr x0, lo(x31): d is from the auipc
            let hi = ((d + 2048) >> 12) & 1048575
            rv_set(a, at, w | (hi << 12))
            rv_set(a, at + 4, rv_get(a, at + 4) | (rv_lo12(d) & 4095) << 20)
    return true

/#/ ---- floats -----------------------------------------------------------------

/#/ f = the bits of general register r (a double, or a float from the low 32 bits).
fn rv_fmv_to(a: &Asm, f: int, r: int, single: bool) => void:
    if single:
        rv_w(a, rv_enc_r(120, 0, 83, f, r, 0))
    else:
        rv_w(a, rv_enc_r(121, 0, 83, f, r, 0))

/#/ r = the bits of float register f (a float is sign-extended from its 32 bits).
fn rv_fmv_from(a: &Asm, r: int, f: int, single: bool) => void:
    if single:
        rv_w(a, rv_enc_r(112, 0, 83, r, f, 0))
    else:
        rv_w(a, rv_enc_r(113, 0, 83, r, f, 0))

/#/ fd = fa op fb; `op` 0 add, 1 sub, 2 mul, 3 div.
fn rv_farith(a: &Asm, op: int, single: bool, fd: int, fa: int, fb: int) => void:
    let f7 = 0
    if op == 1:
        f7 = 4
    elif op == 2:
        f7 = 8
    elif op == 3:
        f7 = 12
    if !single:
        f7 = f7 | 1
    rv_w(a, rv_enc_r(f7, 7, 83, fd, fa, fb))

fn rv_fneg(a: &Asm, single: bool, fd: int, fa: int) => void:
    let f7 = 17
    if single:
        f7 = 16
    rv_w(a, rv_enc_r(f7, 1, 83, fd, fa, fa))

/#/ r = 1 if the comparison holds, else 0 (false when either is NaN); `kind` 0 equal, 1 less than, 2 less or equal.
fn rv_fcmp(a: &Asm, kind: int, single: bool, r: int, fa: int, fb: int) => void:
    let f3 = 2
    if kind == 1:
        f3 = 1
    elif kind == 2:
        f3 = 0
    let f7 = 81
    if single:
        f7 = 80
    rv_w(a, rv_enc_r(f7, f3, 83, r, fa, fb))

/#/ fd = the float of the signed (or unsigned) 64-bit integer in r.
fn rv_cvt_i2f(a: &Asm, fd: int, r: int, single: bool, signed: bool) => void:
    let rs2 = 2
    if !signed:
        rs2 = 3
    let f7 = 105
    if single:
        f7 = 104
    rv_w(a, rv_enc_r(f7, 7, 83, fd, r, rs2))

/#/ r = the float in f truncated to a signed (or unsigned) 64-bit integer.
fn rv_cvt_f2i(a: &Asm, r: int, f: int, single: bool, signed: bool) => void:
    let rs2 = 2
    if !signed:
        rs2 = 3
    let f7 = 97
    if single:
        f7 = 96
    rv_w(a, rv_enc_r(f7, 1, 83, r, f, rs2))

/#/ fd = fa converted to the other width.
fn rv_fcvt(a: &Asm, fd: int, fa: int, to_single: bool) => void:
    if to_single:
        rv_w(a, rv_enc_r(32, 7, 83, fd, fa, 1))
    else:
        rv_w(a, rv_enc_r(33, 0, 83, fd, fa, 0))

/#/ fd = fa (the whole register)
fn rv_fmv_ff(a: &Asm, fd: int, fa: int) => void:
    rv_w(a, rv_enc_r(17, 0, 83, fd, fa, fa))

/#/ A load into (or store of) the float register `ft` of `n` bytes (4 or 8) at [base + disp].
fn rv_fldst(a: &Asm, load: bool, ft: int, base: int, disp: int, n: int) => void:
    let f3 = 2
    if n == 8:
        f3 = 3
    let b = base
    let d = disp
    if a.acc.sbx:
        if a.acc.guarded(false, base == 8 || base == 2):
            rv_sbx_addr(a, base, disp)
            b = 31
            d = 0
        elif disp < 0 - 2048 || disp >= 2048:
            rv_err = true
    elif disp < 0 - 2048 || disp >= 2048:
        rv_li(a, 31, disp)
        rv_add(a, 31, base, 31)
        b = 31
        d = 0
    if load:
        rv_w(a, rv_enc_i(f3, 7, ft, b, d))
    else:
        rv_w(a, rv_enc_s(f3, 39, b, ft, d))

/#/ ---- extensions ---------------------------------------------------------------

/#/ Which extensions beyond RV64GC the code may use (a bit set, from the target): 1 Zba, 2 Zbb, 4 V.
let rv_ext: int = 0

/#/ rd = (rs1 << n) + rs2 (Zba), n = 1 to 3.
fn rv_shadd(a: &Asm, n: int, rd: int, rs1: int, rs2: int) => void:
    rv_w(a, rv_enc_r(16, 2 * n, 51, rd, rs1, rs2))

/#/ rd = the low 32 bits of rs zero-extended (Zba add.uw with x0).
fn rv_zext_w(a: &Asm, rd: int, rs: int) => void:
    rv_w(a, rv_enc_r(4, 0, 59, rd, rs, 0))

/#/ Zbb: sign-extension of a byte (n = 1) or halfword (n = 2), zero-extension of a halfword (n = 0).
fn rv_zbb_ext(a: &Asm, n: int, rd: int, rs: int) => void:
    if n == 0:
        rv_w(a, rv_enc_r(4, 4, 59, rd, rs, 0))
    else:
        rv_w(a, rv_enc_i(1, 19, rd, rs, 1540 + n - 1))

/#/ Vector extension. `vsetvli rd, rs1, e<8 << (sew & 7)>, m<1 << (sew >> 3)>, tu, mu`: vl = min(rs1, VLMAX) (VLMAX with rs1 = x0).
fn rv_vsetvli(a: &Asm, rd: int, rs1: int, sew: int) => void:
    rv_w(a, ((((sew & 7) << 3) | (sew >> 3)) << 20) | (rs1 << 15) | (7 << 12) | (rd << 7) | 87)

/#/ vle / vse of the elements of size 1 << sew: vector register `v` from or to the memory at x`rs1`.
fn rv_vmem(a: &Asm, load: bool, sew: int, v: int, rs1: int) => void:
    let width = 0
    if sew == 1:
        width = 5
    elif sew == 2:
        width = 6
    elif sew == 3:
        width = 7
    let op = 39
    if load:
        op = 7
    rv_w(a, (1 << 25) | (rs1 << 15) | (width << 12) | (v << 7) | op)

/#/ An unmasked vector operation: `f6` and `f3` (0 integer, 1 float, 2 integer with the multiply group) as the manual gives them.
fn rv_vop(a: &Asm, f6: int, f3: int, vd: int, vs2: int, vs1: int) => void:
    rv_w(a, (f6 << 26) | (1 << 25) | (vs2 << 20) | (vs1 << 15) | (f3 << 12) | (vd << 7) | 87)

/#/ v[vd] = x[rs] in every element.
fn rv_vsplat(a: &Asm, vd: int, rs: int) => void:
    rv_vop(a, 23, 4, vd, 0, rs)

/#/ v[vd] = the 5-bit immediate in every element.
fn rv_vsplat_i(a: &Asm, vd: int, imm: int) => void:
    rv_vop(a, 23, 3, vd, 0, imm & 31)

/#/ Element 0 of v[vd] = x[rs]; x[rd] = element 0 of v[vs].
fn rv_vmv_sx(a: &Asm, vd: int, rs: int) => void:
    rv_vop(a, 16, 6, vd, 0, rs)

fn rv_vmv_xs(a: &Asm, rd: int, vs: int) => void:
    rv_vop(a, 16, 2, rd, vs, 0)
