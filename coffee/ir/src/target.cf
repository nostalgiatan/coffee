/#/ Which machine the code is made for. `--target=<arch>-<os>` names it; the default is the machine the
/#/ compiler runs on, x86-64 Linux, the only one there is so far. Everything that depends on the
/#/ target asks here: `gen_function` picks the code generator, and the pieces still to be made per
/#/ target (the runtime's system calls in `rt/src/min.cf`, the object and executable format in `elf.cf`
/#/ and `ld/`) are listed in docs/explanation/ir-lowering-design.md.
use * in txt
use * in gen
use * in fun
use * in names
use * in rep
use * in gen_x86_fun
use * in minrt
use * in elf

/#/ The architectures and systems a target name may use.
fn arch_x86_64() => int:
    return 0

fn arch_aarch64() => int:
    return 1

fn os_linux() => int:
    return 0

let target_arch = 0
let target_os = 0

/#/ Does the text begin with `p`?
fn has_prefix(t: &Txt, p: &str) => bool:
    if t.n < len(p):
        return false
    for i in 0..len(p):
        if t.b[i] != ch(p, i):
            return false
    return true

/#/ The names accepted by `--target=`, for the error message.
fn target_names() => str:
    return "x86_64-linux"

/#/ Chooses the target by its name; 0 when it was set, 1 when the name is unknown, 2 when it is known
/#/ but there is no code generator for it yet.
fn set_target(name: &Txt) => int:
    if name.is("x86_64-linux") || name.is("x86_64"):
        target_arch = arch_x86_64()
        target_os = os_linux()
        return 0
    if name.is("aarch64-linux") || name.is("aarch64"):
        /#/ chosen all the same, so that what depends on the target can be looked at; the driver stops
        target_arch = arch_aarch64()
        target_os = os_linux()
        return 2
    return 1

/#/ The code of function `f` for the target; false when it could not be made.
fn gen_function(g: &Gen, f: &Fun, rs: &Reps, sy: &Names) => bool:
    if target_arch == arch_x86_64():
        return g_gen_fun(g, f, rs, sy)
    return false

/#/ The C library a `--static` program gets for the target: `rt/src/min.cf`, which every system shares,
/#/ with the system's part (`rt/src/os_*.cf`) in two places: after min.cf's state variables and at the end.
fn min_rt_text() => str:
    if target_arch == arch_x86_64() && target_os == os_linux():
        return min_rt_common_a() + min_rt_os_linux_x86_64_a() + min_rt_common_b() + min_rt_os_linux_x86_64_b()
    return min_rt_common_a() + min_rt_os_linux_aarch64_a() + min_rt_common_b() + min_rt_os_linux_aarch64_b()

/#/ The machine code of `cf_syscall(n, a, b, c, d, e, f)` for the target: the C calling convention moved into
/#/ the registers of the system call instruction. The linker (`ld/`, its `syscall_stub`) supplies it to a
/#/ program; a library made with `--pic` has no linker step of ours, so its object carries it.
fn tg_syscall_stub() => buf<int>:
    if target_arch == arch_aarch64():
        let a64 = [232, 3, 0, 170, 224, 3, 1, 170, 225, 3, 2, 170, 226, 3, 3, 170, 227, 3, 4, 170, 228, 3, 5, 170, 229, 3, 6, 170, 1, 0, 0, 212, 192, 3, 95, 214]
        let out: buf<int> = new_buf(int, 36)
        for k in 0..36:
            out[k] = a64[k]
        return out
    let x86 = [72, 137, 248, 72, 137, 247, 72, 137, 214, 72, 137, 202, 77, 137, 194, 77, 137, 200, 76, 139, 76, 36, 8, 15, 5, 195]
    let out: buf<int> = new_buf(int, 26)
    for k in 0..26:
        out[k] = x86[k]
    return out

/#/ Is the name at `at` in `names` (NUL-ended) the text `w`?
fn tg_name_is(names: &Txt, at: int, w: &str) => bool:
    for q in 0..len(w):
        if names.b[at + q] != ch(w, q):
            return false
    return names.b[at + len(w)] == 0

/#/ The undefined symbol `cf_syscall` of the object `o`, -1 when it has none.
fn undef_syscall(o: &Obj) => int:
    for k in 0..o.ns:
        if o.s_def[k] < 0 && tg_name_is(&o.names, o.s_name[k], "cf_syscall"):
            return k
    return 0 - 1

/#/ With `--pic`: when the object calls `cf_syscall` and does not define it, defines it (hidden) from the
/#/ target's stub.
fn g_add_syscall_stub(g: &Gen) => void:
    if !elf_hide:
        return
    let found = undef_syscall(&g.o)
    if found < 0:
        return
    let code = tg_syscall_stub()
    g.a.begin_fun()
    let start = g.a.pos()
    for k in 0..len(code):
        g.a.byte(code[k])
    g.a.end_fun()
    g.o.define(found + 2, start, g.a.pos() - start)
