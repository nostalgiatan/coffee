/#/ Register allocation and frame services that do not depend on the instruction set: which values want a register, use counts, folding of addresses, the edges of a block, hints, and the frame size of a value. Shared by the x86-64 and aarch64 code generators (docs/explanation/cross-platform-framework.md, 4).
use * in gen
use * in asm
use * in target_x86

/#/ Can value `v` live in a register? Scalars made by instructions or block parameters.
fn g_wants_reg(g: &Gen, f: &Fun, v: int) => bool:
    if f.fwd[v] >= 0:
        return false
    let r = f.rep[v]
    if r == int(Rp.Void) || r >= rp_first_agg():
        return false
    let op = f.op[v]
    return !(op == int(Op.Slot) || op == int(Op.Const) || op == int(Op.StrLit) || op == int(Op.Undef) || op == int(Op.OwnMove))

/#/ Is there a call strictly between positions `lo` and `hi`?
fn g_crosses(g: &Gen, lo: int, hi: int) => bool:
    let a = 0
    let b = g.ra_ncp
    while a < b:
        let mid = (a + b) // 2
        if g.ra_cp[mid] > lo:
            b = mid
        else:
            a = mid + 1
    return a < g.ra_ncp && g.ra_cp[a] < hi

/#/ Counts the uses of every value of `f`, through forwarding and `own.move`.
fn g_count_uses(g: &Gen, f: &Fun) => void:
    if len(g.nuse) < f.ni + 1:
        g.nuse = new_buf(int, f.ni + 1)
    for v in 0..f.ni + 1:
        g.nuse[v] = 0
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            for k in 0..f.nval(i):
                let v = f.val_at(i, k)
                if v >= 0:
                    let x = g_res(g, f, v)
                    g.nuse[x] = g.nuse[x] + 1
            i = f.nx[i]
    for e in 0..f.ne:
        if f.eto[e] >= 0:
            for k in 0..f.eargn[e]:
                let x = g_res(g, f, f.pool[f.eargs[e] + k])
                g.nuse[x] = g.nuse[x] + 1

/#/ Is `x`, an `index` or a `field`, only the address of the scalar `load` or `store` right
/#/ after it? Then the access uses the address mode and `x` makes no code of its own.
fn g_folds(g: &Gen, f: &Fun, x: int) => bool:
    let op = f.op[x]
    if op != int(Op.Index) && op != int(Op.Field):
        return false
    if g.nuse[x] != 1 || f.fwd[x] >= 0:
        return false
    if op == int(Op.Index):
        let sz = f.aux[x]
        if sz != 1 && sz != 2 && sz != 4 && sz != 8:
            return false
    let u = f.nx[x]
    if u < 0:
        return false
    if f.op[u] == int(Op.Load):
        return g_res(g, f, f.a[u]) == x && f.rep[u] < rp_first_agg()
    if f.op[u] == int(Op.Store):
        let v = g_res(g, f, f.b[u])
        return g_res(g, f, f.a[u]) == x && v != x && f.rep[v] < rp_first_agg()
    return false

/#/ The address of the folded `x` as base, index, scale and displacement in `am_*`; what is not
/#/ in a register of its own is loaded into `s1` (the base) and `s2` (the index).
fn g_addr_of(g: &Gen, f: &Fun, x: int, s1: int, s2: int) => void:
    g.am_base = g_src(g, f, f.a[x], s1)
    if f.op[x] == int(Op.Index) && g_near_const(g, f, f.b[x]):
        g.am_idx = -1
        g.am_scale = 1
        g.am_disp = f.aux[g_res(g, f, f.b[x])] * f.aux[x]
    elif f.op[x] == int(Op.Index):
        g.am_idx = g_src(g, f, f.b[x], s2)
        g.am_scale = f.aux[x]
        g.am_disp = 0
    else:
        g.am_idx = -1
        g.am_scale = 1
        g.am_disp = f.aux[x]

/#/ The edges leaving block `b`, in `ed`.
fn g_term_edges(g: &Gen, f: &Fun, b: int) => void:
    g.ned = 0
    let t = f.blast[b]
    if t < 0:
        return
    let op = f.op[t]
    if op == int(Op.Br):
        g_add_edge(g, f.aux[t])
    elif op == int(Op.CondBr):
        g_add_edge(g, f.b[t])
        g_add_edge(g, f.c[t])

fn g_add_edge(g: &Gen, e: int) => void:
    if g.ned >= len(g.ed):
        g.ed = buf_resize(g.ed, (g.ned + 1) * 2)
    g.ed[g.ned] = e
    g.ned = g.ned + 1

/#/ For an instruction that computes into its first operand's register (two-address): the
/#/ register that operand has, else -1.
fn g_hint_reg(g: &Gen, f: &Fun, v: int) => int:
    let op = f.op[v]
    if op == int(Op.Add) || op == int(Op.Sub) || op == int(Op.Mul) || op == int(Op.And) || op == int(Op.Or) || op == int(Op.Xor) || op == int(Op.Shl) || op == int(Op.AShr) || op == int(Op.LShr) || op == int(Op.Neg) || op == int(Op.Not):
        if f.a[v] >= 0:
            return g.home[g_res(g, f, f.a[v])]
        return -1
    if op == int(Op.Trunc) || op == int(Op.Bitcast) || op == int(Op.PtrToInt) || op == int(Op.IntToPtr) || op == int(Op.SExt) || op == int(Op.ZExt):
        if f.a[v] >= 0:
            return g.home[g_res(g, f, f.a[v])]
    return -1

/#/ Give the float constant `v` a number as a value to keep in a register, once; returns the new count.
fn g_hoist_const(g: &Gen, f: &Fun, v: int, nd: int) => int:
    if v < 0:
        return nd
    let x = g_res(g, f, v)
    if f.op[x] != int(Op.Const) || g.did[x] >= 0:
        return nd
    if f.rep[x] != int(Rp.F64) && f.rep[x] != int(Rp.F32):
        return nd
    if g.nhc >= len(g.hc):
        g.hc = buf_resize(g.hc, (g.nhc + 1) * 2)
    g.hc[g.nhc] = x
    g.nhc = g.nhc + 1
    g.did[x] = nd
    return nd + 1

/#/ riscv64: integer constants that an instruction needs in a register (no immediate form) are kept in one too, when they are used in a loop.
let ra_int_consts = false

/#/ set while the function being allocated has a call inside a loop: kept registers would be saved and restored for every call
let ra_loop_calls = false

/#/ `v` is operand `k` of instruction `i`: hoist it if it is such a constant (see `ra_int_consts`); returns the new count.
fn g_hoist_use(g: &Gen, f: &Fun, i: int, k: int, nd: int) => int:
    let v = f.val_at(i, k)
    if !ra_int_consts || v < 0 || ra_loop_calls:
        return g_hoist_const(g, f, v, nd)
    let x = g_res(g, f, v)
    let r = f.rep[x]
    if f.op[x] != int(Op.Const) || r == int(Rp.F32) || r == int(Rp.F64) || r >= rp_first_agg() || f.aux[x] == 0 || g.did[x] >= 0:
        return g_hoist_const(g, f, v, nd)
    let op = f.op[i]
    let near = f.aux[x] >= 0 - 2048 && f.aux[x] < 2048
    let want = false
    if op == int(Op.Cmp) || op == int(Op.Mul) || op == int(Op.SDiv) || op == int(Op.UDiv) || op == int(Op.SRem) || op == int(Op.URem) || op == int(Op.Store):
        want = true
    elif op == int(Op.Add) || op == int(Op.Sub) || op == int(Op.And) || op == int(Op.Or) || op == int(Op.Xor):
        want = k == 0 || !near
    if !want:
        return nd
    if g.nhc >= len(g.hc):
        g.hc = buf_resize(g.hc, (g.nhc + 1) * 2)
    /#/ an equal constant already kept shares its register (and its dense value)
    for q in 0..g.nhc:
        let y = g.hc[q]
        if f.aux[y] == f.aux[x] && f.rep[y] != int(Rp.F32) && f.rep[y] != int(Rp.F64):
            g.hc[g.nhc] = x
            g.nhc = g.nhc + 1
            g.did[x] = g.did[y]
            return nd
    g.hc[g.nhc] = x
    g.nhc = g.nhc + 1
    g.did[x] = nd
    return nd + 1

fn g_note_use(g: &Gen, f: &Fun, v: int, b: int, p: int, w: int) => void:
    if v < 0:
        return
    let x = g_res(g, f, v)
    let d = g.did[x]
    if d < 0:
        return
    g.ra_wt[d] = g.ra_wt[d] + w
    if p < g.ra_lo[d]:
        g.ra_lo[d] = p
    if p > g.ra_hi[d]:
        g.ra_hi[d] = p
    if g.ra_dset[d] == 1 && g.ra_dblk[d] == b:
        return
    if g.nuq >= len(g.uq_d):
        g.uq_d = buf_resize(g.uq_d, (g.nuq + 1) * 2)
        g.uq_b = buf_resize(g.uq_b, (g.nuq + 1) * 2)
    g.uq_d[g.nuq] = d
    g.uq_b[g.nuq] = b
    g.nuq = g.nuq + 1

/#/ Is value `d` live out of block `b`: live into one of its successors?
fn g_live_out_of(g: &Gen, f: &Fun, b: int, d: int, lvb: &buf<int>, lvs: &buf<int>, lve: &buf<int>) => bool:
    g_term_edges(g, f, b)
    for k in 0..g.ned:
        let t = f.eto[g.ed[k]]
        if t >= 0:
            for q in lvs[d]..lve[d]:
                if lvb[q] == t:
                    return true
    return false

/#/ ---- frame -------------------------------------------------------------

fn g_place_size(g: &Gen, rs: &Reps, r: int) => int:
    let s = round8(rsize(rs, r))
    if s < 8:
        return 8
    return s

/#/ A number for the register of `x`, general ones as they are and xmm ones from 32; -1 in the frame.
fn g_hid(g: &Gen, x: int) => int:
    if g.home[x] >= 0:
        return g.home[x]
    if g.xhome[x] >= 0:
        return 32 + g.xhome[x]
    return -1

/#/ ---- calls -------------------------------------------------------------

/#/ Gives every value its place and sizes the frame. `hdr` is the bytes at the frame's start that are not the
/#/ registers kept (the frame record of a target that has one); with `down` an offset counts from the frame
/#/ pointer downwards and a place is reached after the size is added, otherwise it counts upwards. `frame_cap`
/#/ is the largest frame sandbox code may have (0: no limit). Sandbox code keeps aggregates and the slots whose
/#/ address is taken in the shadow frame, in the linear memory: a pointer to them is an offset like any other,
/#/ and the host stack holds only what the code cannot name (return addresses, saved registers, spilled scalars).
fn layout_frame(g: &Gen, f: &Fun, rs: &Reps, hdr: int, down: bool, frame_cap: int) => void:
    if len(g.voff) < f.ni + 1:
        g.voff = new_buf(int, f.ni + 1)
        g.sh = new_buf(int, f.ni + 1)
    for v in 0..f.ni:
        g.sh[v] = 0
    let sbx = g.a.acc.sbx
    let scur = 0
    let cur = hdr + g.rbase + 8 * g.nsaved
    let tmp = 0
    for b in 0..f.nb:
        let p = f.pfirst[b]
        while p >= 0:
            if g.home[p] < 0 && g.xhome[p] < 0:
                if sbx && f.rep[p] >= rp_first_agg():
                    scur = scur + g_place_size(g, rs, f.rep[p])
                    g.voff[p] = shadow_off(down, scur, g_place_size(g, rs, f.rep[p]))
                    g.sh[p] = 1
                else:
                    cur = layout_place(g, p, cur, g_place_size(g, rs, f.rep[p]), down)
            p = f.nx[p]
        let i = f.bfirst[b]
        while i >= 0:
            let op = f.op[i]
            if op == int(Op.Slot):
                let sz = round8(f.ty[i])
                if f.ty[i] < 1:
                    sz = sz + 8
                if sbx:
                    scur = scur + sz
                    g.voff[i] = shadow_off(down, scur, sz)
                    g.sh[i] = 1
                else:
                    cur = layout_place(g, i, cur, sz, down)
            elif f.rep[i] != int(Rp.Void) && op != int(Op.OwnMove) && g.home[i] < 0 && g.xhome[i] < 0:
                if sbx && f.rep[i] >= rp_first_agg():
                    scur = scur + g_place_size(g, rs, f.rep[i])
                    g.voff[i] = shadow_off(down, scur, g_place_size(g, rs, f.rep[i]))
                    g.sh[i] = 1
                else:
                    cur = layout_place(g, i, cur, g_place_size(g, rs, f.rep[i]), down)
            i = f.nx[i]
    for e in 0..f.ne:
        if f.eto[e] >= 0:
            let sum = 0
            for k in 0..f.eargn[e]:
                sum = sum + g_place_size(g, rs, f.rep[g_res(g, f, f.pool[f.eargs[e] + k])])
            if sum > tmp:
                tmp = sum
    if down:
        cur = cur + tmp
        g.tmp = cur
    else:
        g.tmp = cur
        cur = cur + tmp
    g.frame = (cur + 15) // 16 * 16
    g.sframe = (scur + 15) // 16 * 16
    if sbx && g.a.acc.bm:
        /#/ base mode: the shadow frame stands just below the frame pointer, in the bytes the frame of the host stack
        /#/ takes; the frame is at least as large, so a callee's shadow frame does not overlap this one
        g.a.acc.shd = 0 - g.sframe
        if g.frame < g.sframe:
            g.frame = g.sframe
    /#/ a frame larger than the guard below the shadow stack could be stepped over
    if g.sframe > 32768 || (sbx && frame_cap > 0 && g.frame > frame_cap):
        g.err = 1

/#/ The offset of a shadow place of `sz` bytes whose end is `scur` bytes into the shadow frame: from the
/#/ register that moves down (x86) the frame starts at -(its start); from the one that is bumped up
/#/ at entry (aarch64) the frame lies below it.
fn shadow_off(down: bool, scur: int, sz: int) => int:
    if down:
        return 0 - (scur - sz)
    return 0 - scur

/#/ Puts value `v` of `sz` bytes at `cur` (the offset after it when `down`); the new end of the frame.
fn layout_place(g: &Gen, v: int, cur: int, sz: int, down: bool) => int:
    if down:
        g.voff[v] = cur + sz
    else:
        g.voff[v] = cur
    return cur + sz

/#/ Do the copies of edge `e` into the parameters of the block it enters depend on each other: an argument is
/#/ itself a parameter of that block, or lives in the register of a parameter written before it?
fn edge_hazard(g: &Gen, f: &Fun, e: int) => bool:
    let to = f.eto[e]
    let n = f.eargn[e]
    let hazard = false
    for k in 0..n:
        let x = g_res(g, f, f.pool[f.eargs[e] + k])
        if f.op[x] == int(Op.Param) && f.blk[x] == to:
            hazard = true
        let hx = g_hid(g, x)
        if hx >= 0:
            let q = f.pfirst[to]
            for j in 0..k:
                if g_hid(g, q) == hx:
                    hazard = true
                q = f.nx[q]
    return hazard

/#/ The values with a live range (`0..nd`) in the order the scan visits them: by the start of the range, the
/#/ lower number first. `g.ptop` is the last position.
fn lscan_order(g: &Gen, nd: int) => buf<int>:
    let top = g.ptop + 4
    let first: buf<int> = new_buf(int, top + 1)
    let link: buf<int> = new_buf(int, nd + 1)
    for q in 0..top + 1:
        first[q] = 0 - 1
    let sd = nd - 1
    while sd >= 0:
        link[sd] = first[g.ra_lo[sd]]
        first[g.ra_lo[sd]] = sd
        sd = sd - 1
    let order: buf<int> = new_buf(int, nd + 1)
    let n = 0
    for q in 0..top + 1:
        let cd = first[q]
        while cd >= 0:
            order[n] = cd
            n = n + 1
            cd = link[cd]
    return order

/#/ Linear scan of the general registers, the part both targets share. `order` is `lscan_order`; `regs[0..npool]`
/#/ are the registers in the order they are tried; `allow[d]` has bit r set when value `d` may take `regs[r]`;
/#/ `skip[d]` is 1 for a value that does not take a general register (a float in a vector register). A value takes,
/#/ in this order: the register of the value it is coalesced with, the register `g_hint_reg` names, the first free
/#/ one; when none is free the least wanted of the live values and this one goes to the frame. Returns which
/#/ registers were used (1 per slot).
fn lscan_int(g: &Gen, f: &Fun, order: &buf<int>, nd: int, regs: &buf<int>, npool: int, allow: &buf<int>, skip: &buf<int>) => buf<int>:
    let occ: buf<int> = new_buf(int, npool)
    let used: buf<int> = new_buf(int, npool)
    for r in 0..npool:
        occ[r] = 0 - 1
    for k in 0..nd:
        let d = order[k]
        if skip[d] == 1:
            continue
        let v = g.dv[d]
        for r in 0..npool:
            if occ[r] >= 0 && g.ra_hi[occ[r]] < g.ra_lo[d]:
                occ[r] = 0 - 1
        let fr = 0 - 1
        let shared = 0 - 1
        if g.coal[d] >= 0 && g.home[g.dv[g.coal[d]]] >= 0 && g.ra_lo[g.coal[d]] < g.ra_lo[d]:
            for r in 0..npool:
                if regs[r] == g.home[g.dv[g.coal[d]]] && occ[r] == g.coal[d] && ((allow[d] >> r) & 1) == 1:
                    shared = r
        if shared >= 0:
            fr = shared
        let hint = g_hint_reg(g, f, v)
        if hint >= 0 && fr < 0:
            for r in 0..npool:
                if regs[r] == hint && occ[r] < 0 && ((allow[d] >> r) & 1) == 1:
                    fr = r
        for r in 0..npool:
            if occ[r] < 0 && fr < 0 && ((allow[d] >> r) & 1) == 1:
                fr = r
        if fr >= 0:
            if shared < 0 || g.ra_hi[d] > g.ra_hi[occ[fr]]:
                occ[fr] = d
            g.home[v] = regs[fr]
            used[fr] = 1
        else:
            let worst = 0 - 1
            for r in 0..npool:
                if ((allow[d] >> r) & 1) == 1:
                    if worst < 0 || g.dn[occ[r]] < g.dn[occ[worst]]:
                        worst = r
            if g.dn[occ[worst]] < g.dn[d]:
                g.home[g.dv[occ[worst]]] = 0 - 1
                g.home[v] = regs[worst]
                occ[worst] = d
    return used
