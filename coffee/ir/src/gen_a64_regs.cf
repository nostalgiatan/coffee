/#/ aarch64: the frame (every value lives in it, at an offset from x29), the loads and stores of
/#/ operands, memory copies and the copies on the edges between blocks.
/#/
/#/ Frame, x29-relative and upwards: [x29] the saved x29, [x29+8] the saved x30, [x29+16] the
/#/ pointer a function returning an aggregate was given (only then), then one 8-byte-aligned place
/#/ per value (the memory layout for an aggregate, 8 bytes for a scalar, whose upper bytes are not
/#/ meaningful), the `slot` areas, and a scratch area for edge copies. A float is kept as its bits in
/#/ such a place and moved to a float register for each operation. x9 to x11 hold operands, x12 and
/#/ x13 addresses (see target_a64.cf).
use * in gen
use * in asm
use * in asm_a64
use * in target_a64
use * in gen_x86_regs
use * in regalloc
use * in gen_x86_call
use * in gen_x86_isel
use * in gen_a64_call
use * in gen_a64_isel
use * in gen_a64_fun

/#/ The base register of the bytes of value `x`: x29, or x27 (the shadow frame in the linear memory) for the
/#/ aggregates and slots of sandbox code.
fn ga_sb(g: &Gen, x: int) => int:
    if g.a.acc.sbx && g.sh[x] == 1:
        return 27
    return ta_fp()

/#/ reg = the value (a scalar, 8 bytes; narrower ones have meaningful low bytes only)
fn ga_ld(g: &Gen, reg: int, f: &Fun, v: int) => void:
    let x = g_res(g, f, v)
    let k = f.op[x]
    if g.home[x] >= 0:
        if g.home[x] != reg:
            a64_mov_rr(&g.a, reg, g.home[x])
    elif g.xhome[x] >= 0:
        a64_fmov_from(&g.a, reg, g.xhome[x], f.rep[x] == int(Rp.F32))
    elif k == int(Op.Const):
        if f.rep[x] == int(Rp.F32):
            a64_mov_ri(&g.a, reg, f.aux[x] & 4294967295)
        else:
            a64_mov_ri(&g.a, reg, f.aux[x])
    elif k == int(Op.Undef):
        a64_mov_ri(&g.a, reg, 0)
    elif k == int(Op.StrLit):
        a64_adr_sym(&g.a, reg, 1, g.sbase + g_so(g, f.aux[x]))
    elif k == int(Op.Slot):
        a64_addsub_ri(&g.a, false, reg, ga_sb(g, x), g.voff[x])
    else:
        a64_ld(&g.a, reg, ga_sb(g, x), g.voff[x], 8)

/#/ reg = the value extended from its width
fn ga_ld_ext(g: &Gen, reg: int, f: &Fun, v: int, signed: bool) => void:
    ga_ld(g, reg, f, v)
    let x = g_res(g, f, v)
    let r = f.rep[x]
    if f.op[x] == int(Op.Cmp):
        return
    if r == int(Rp.I8) || r == int(Rp.I16) || r == int(Rp.I32):
        a64_extend(&g.a, reg, reg, rsize_scalar(r), signed)

/#/ The register that holds `v`: its own when it has one, else `scratch`, loaded with it.
fn ga_src(g: &Gen, f: &Fun, v: int, scratch: int) => int:
    let h = g.home[g_res(g, f, v)]
    if h >= 0:
        return h
    ga_ld(g, scratch, f, v)
    return scratch

/#/ The float register of float `v`: its own when it has one, else `scratch`, loaded with it.
fn ga_fsrc(g: &Gen, f: &Fun, v: int, scratch: int) => int:
    let x = g_res(g, f, v)
    if g.xhome[x] >= 0:
        return g.xhome[x]
    let single = f.rep[x] == int(Rp.F32)
    let k = f.op[x]
    if k == int(Op.Const) && f.aux[x] == 0:
        a64_fmov_to(&g.a, scratch, 31, single)
    elif k == int(Op.Const) || k == int(Op.Undef) || k == int(Op.StrLit) || k == int(Op.Slot) || g.home[x] >= 0:
        ga_ld(g, 9, f, x)
        a64_fmov_to(&g.a, scratch, 9, single)
    else:
        a64_fldst(&g.a, true, scratch, ga_sb(g, x), g.voff[x], rsize_scalar(f.rep[x]))
    return scratch

/#/ Where the float instruction `i` makes its result: its own register, else `scratch`.
fn ga_fdst(g: &Gen, i: int, scratch: int) => int:
    if g.xhome[i] >= 0:
        return g.xhome[i]
    return scratch

/#/ The result of float instruction `i` is in float register `v`: kept there, or stored.
fn ga_ffin(g: &Gen, f: &Fun, i: int, v: int) => void:
    if g.xhome[i] >= 0:
        if g.xhome[i] != v:
            a64_fmov_vv(&g.a, false, g.xhome[i], v)
    else:
        a64_fldst(&g.a, false, v, ga_sb(g, i), g.voff[i], rsize_scalar(f.rep[i]))

/#/ Float register `d` = the float value `v`.
fn ga_fmove(g: &Gen, f: &Fun, d: int, v: int) => void:
    let r = ga_fsrc(g, f, v, d)
    if r != d:
        a64_fmov_vv(&g.a, false, d, r)

/#/ Where instruction `i` makes its result: its own register, else `scratch`.
fn ga_dst(g: &Gen, i: int, scratch: int) => int:
    if g.home[i] >= 0:
        return g.home[i]
    return scratch

/#/ The result of instruction `i` is in `reg`: kept in its register or stored in its place.
fn ga_st(g: &Gen, i: int, reg: int) => void:
    if g.home[i] >= 0:
        if g.home[i] != reg:
            a64_mov_rr(&g.a, g.home[i], reg)
    elif g.xhome[i] >= 0:
        a64_fmov_to(&g.a, g.xhome[i], reg, g.xsg[i] == 1)
    else:
        a64_st(&g.a, ga_sb(g, i), g.voff[i], reg, 8)

/#/ For an aggregate value: the base register and displacement of its bytes (an undefined one
/#/ reads from the start of the read-only data).
fn ga_ab_reg(g: &Gen, f: &Fun, v: int) => int:
    let x = g_res(g, f, v)
    if f.op[x] == int(Op.Undef):
        a64_adr_sym(&g.a, ta_ind(), 1, 0)
        return ta_ind()
    return ga_sb(g, x)

fn ga_ab_disp(g: &Gen, f: &Fun, v: int) => int:
    let x = g_res(g, f, v)
    if f.op[x] == int(Op.Undef):
        return 0
    return g.voff[x]

/#/ n bytes from [sb + sd] to [db + dd], through x9.
fn ga_copy_mem(g: &Gen, db: int, dd: int, sb: int, sd: int, n: int) => void:
    let k = 0
    while k + 8 <= n:
        a64_ld(&g.a, 9, sb, sd + k, 8)
        a64_st(&g.a, db, dd + k, 9, 8)
        k = k + 8
    if k + 4 <= n:
        a64_ld(&g.a, 9, sb, sd + k, 4)
        a64_st(&g.a, db, dd + k, 9, 4)
        k = k + 4
    if k + 2 <= n:
        a64_ld(&g.a, 9, sb, sd + k, 2)
        a64_st(&g.a, db, dd + k, 9, 2)
        k = k + 2
    if k < n:
        a64_ld(&g.a, 9, sb, sd + k, 1)
        a64_st(&g.a, db, dd + k, 9, 1)

/#/ Value `v` to [db + dd], in full: a scalar as 8 bytes, an aggregate as its layout.
fn ga_val_to(g: &Gen, f: &Fun, rs: &Reps, db: int, dd: int, v: int) => void:
    let x = g_res(g, f, v)
    let r = f.rep[x]
    if r >= rp_first_agg():
        let sb = ga_ab_reg(g, f, x)
        ga_copy_mem(g, db, dd, sb, ga_ab_disp(g, f, x), rsize(rs, r))
    elif g.xhome[x] >= 0:
        a64_fldst(&g.a, false, g.xhome[x], db, dd, rsize_scalar(r))
    else:
        let rv = ga_src(g, f, x, 9)
        a64_st(&g.a, db, dd, rv, 8)

/#/ Gives every value its place; the size of the frame.
fn ga_layout(g: &Gen, f: &Fun, rs: &Reps) => void:
    layout_frame(g, f, rs, 16, false, 32000)

/#/ Copies what edge `e` passes into the parameters of the block it enters; through a scratch
/#/ area when the copies are not independent (an argument is itself a parameter of that block, or lives
/#/ in the register of a parameter written before it).
fn ga_edge_copy(g: &Gen, f: &Fun, rs: &Reps, e: int) => void:
    let to = f.eto[e]
    let n = f.eargn[e]
    if n == 0:
        return
    let hazard = edge_hazard(g, f, e)
    if !hazard:
        let p = f.pfirst[to]
        for k in 0..n:
            if g.home[p] >= 0:
                ga_ld(g, g.home[p], f, f.pool[f.eargs[e] + k])
            elif g.xhome[p] >= 0:
                ga_fmove(g, f, g.xhome[p], f.pool[f.eargs[e] + k])
            else:
                ga_val_to(g, f, rs, ga_sb(g, p), g.voff[p], f.pool[f.eargs[e] + k])
            p = f.nx[p]
        return
    let at = 0
    for k in 0..n:
        let v = f.pool[f.eargs[e] + k]
        ga_val_to(g, f, rs, ta_fp(), g.tmp + at, v)
        at = at + g_place_size(g, rs, f.rep[g_res(g, f, v)])
    let p = f.pfirst[to]
    at = 0
    for k in 0..n:
        let sz = g_place_size(g, rs, f.rep[p])
        if g.home[p] >= 0:
            a64_ld(&g.a, g.home[p], ta_fp(), g.tmp + at, 8)
        elif g.xhome[p] >= 0:
            a64_fldst(&g.a, true, g.xhome[p], ta_fp(), g.tmp + at, rsize_scalar(f.rep[p]))
        else:
            ga_copy_mem(g, ga_sb(g, p), g.voff[p], ta_fp(), g.tmp + at, sz)
        at = at + sz
        p = f.nx[p]

/#/ The register of pool slot `r`: the callee-saved x19 to x27. Every value lives in one for its
/#/ whole life, across calls too, since a callee keeps them; the function saves the ones it uses.
fn ga_pool_reg(r: int) => int:
    return ta_saved_first() + r

/#/ Gives the values that deserve one a register (`home`; -1 for the frame), by linear scan over
/#/ the live ranges of `g_live_ranges`, the least wanted value going to the frame when there are
/#/ no more registers. Floats go to v8..v15 (kept by a callee) when they live across a call, else to v16..v31.
fn ga_alloc_regs(g: &Gen, f: &Fun, rs: &Reps) => void:
    let nd = g_live_ranges(g, f, rs, false)
    g.nsaved = 0
    if nd == 0:
        return
    let npool = ta_nsaved_regs()
    if g.a.acc.sbx:
        /#/ x27 is the shadow frame pointer of sandbox code
        npool = npool - 1
    let order = lscan_order(g, nd)
    let regs: buf<int> = new_buf(int, npool)
    for r in 0..npool:
        regs[r] = ga_pool_reg(r)
    let skip: buf<int> = new_buf(int, nd + 1)
    let allow: buf<int> = new_buf(int, nd + 1)
    let occx: buf<int> = new_buf(int, 24)
    let xused: buf<int> = new_buf(int, 8)
    for r in 0..24:
        occx[r] = 0 - 1
    for k in 0..nd:
        let d = order[k]
        allow[d] = (1 << npool) - 1
        let v = g.dv[d]
        let rd = f.rep[v]
        if rd == int(Rp.F32) || rd == int(Rp.F64):
            skip[d] = 1
            /#/ v8..v15 (slots 0 to 7) are kept by a callee, v16..v31 (slots 8 to 23) are not: those take
            /#/ the values no call is made in the life of
            for r in 0..24:
                if occx[r] >= 0 && g.ra_hi[occx[r]] < g.ra_lo[d]:
                    occx[r] = 0 - 1
            let crossing = g_crosses(g, g.ra_lo[d], g.ra_hi[d])
            let lo = 0
            let hi = 8
            if !crossing:
                lo = 8
                hi = 24
            let fx = 0 - 1
            for r in lo..hi:
                if occx[r] < 0 && fx < 0:
                    fx = r
            if fx < 0 && !crossing:
                for r in 0..8:
                    if occx[r] < 0 && fx < 0:
                        fx = r
            if fx >= 0:
                occx[fx] = d
                g.xhome[v] = 8 + fx
                if fx >= 8:
                    g.xhome[v] = 16 + fx - 8
                if rd == int(Rp.F32):
                    g.xsg[v] = 1
                if fx < 8:
                    xused[fx] = 1
            else:
                let worst = 0 - 1
                for r in lo..hi:
                    if worst < 0 || g.dn[occx[r]] < g.dn[occx[worst]]:
                        worst = r
                if g.dn[occx[worst]] < g.dn[d]:
                    g.xhome[g.dv[occx[worst]]] = 0 - 1
                    g.xhome[v] = 8 + worst
                    if worst >= 8:
                        g.xhome[v] = 16 + worst - 8
                    if rd == int(Rp.F32):
                        g.xsg[v] = 1
                    occx[worst] = d
                    if worst < 8:
                        xused[worst] = 1
    let used = lscan_int(g, f, &order, nd, &regs, npool, &allow, &skip)
    if len(g.saved) < npool + 9:
        g.saved = new_buf(int, npool + 9)
    for r in 0..npool:
        if used[r] == 1:
            g.saved[g.nsaved] = ga_pool_reg(r)
            g.nsaved = g.nsaved + 1
    /#/ the float registers kept: v8 to v15, numbered from 32
    for r in 0..8:
        if xused[r] == 1:
            g.saved[g.nsaved] = 32 + 8 + r
            g.nsaved = g.nsaved + 1
