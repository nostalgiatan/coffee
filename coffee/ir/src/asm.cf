/#/ An x86-64 assembler for the instructions the code generator uses: byte by byte into a `Txt`,
/#/ jumps by label with the offsets patched when a function ends, calls and string addresses as
/#/ relocations for the object file.
/#/
/#/ Registers are numbered as the hardware does: rax 0, rcx 1, rdx 2, rbx 3, rsp 4, rbp 5, rsi 6,
/#/ rdi 7, r8 to r15 as 8 to 15; xmm registers by their own number. A memory operand is always
/#/ `[base + disp32]`, and the base is never rsp or r12 (those need an index byte).
/#/ (It imports `modopt` for the IR modules below it: a module cannot be imported by two routes.)
use * in modopt
use * in access
use * in target_x86

fn cc_e() => int:
    return 4

fn cc_ne() => int:
    return 5

fn cc_b() => int:
    return 2

fn cc_ae() => int:
    return 3

fn cc_be() => int:
    return 6

fn cc_a() => int:
    return 7

fn cc_np() => int:
    return 11

fn cc_l() => int:
    return 12

fn cc_ge() => int:
    return 13

fn cc_le() => int:
    return 14

fn cc_g() => int:
    return 15

/#/ Relocation types of the System V x86-64 ABI.
fn r_pc32() => int:
    return 2

fn r_plt32() => int:
    return 4

/#/ R_X86_64_32: the address itself, in 32 bits (sandbox code: an offset in the linear memory)
fn r_abs32() => int:
    return 10

/#/ Where the code at old position `p` is once the jumps are shortened: `st` are the starts of the
/#/ `n` jumps, and `pref[k]` the bytes saved by the jumps before the `k`th.
/#/ The number that stands for the shadow frame as a base register in base mode (no machine register has it).
fn sh_base() => int:
    return 16

fn new_pos(st: &buf<int>, pref: &buf<int>, n: int, p: int) => int:
    let lo = 0
    let hi = n
    while lo < hi:
        let mid = (lo + hi) // 2
        if st[mid] < p:
            lo = mid + 1
        else:
            hi = mid
    return p - pref[lo]

/#/ Functions start at a multiple of this many bytes: 1 (no padding), or 16 with `--align`, which
/#/ `tea` asks for in a release build.
let fn_align = 1

fn set_fn_align() => void:
    fn_align = 16

/#/ Functions start at a multiple of at least `n` bytes (a target with a wider instruction word).
fn fn_align_at_least(n: int) => void:
    if fn_align < n:
        fn_align = n

class Asm:
    c: Txt
    /#/ labels of the function being assembled: absolute positions in `c`, -1 while unbound
    lab: buf<int>
    nlab: int
    fx_at: buf<int>
    fx_lab: buf<int>
    fx_kind: buf<int>
    nfx: int
    /#/ where the function being assembled starts, and the first of its relocations
    fs: int
    rl0: int
    /#/ relocations of the whole object
    rl_at: buf<int>
    rl_sym: buf<int>
    rl_ty: buf<int>
    rl_add: buf<int>
    nrl: int
    /#/ the last register move and the last 8-byte store, while nothing has been emitted since:
    /#/ where each ends and what it moved (a store: base, displacement, register)
    lm_end: int
    lm_d: int
    lm_s: int
    ls_end: int
    ls_base: int
    ls_disp: int
    ls_reg: int
    /#/ how memory is reached in sandbox code (src/access.cf)
    acc: Access
    /#/ a mandatory prefix (66, F2, F3) for the next memory operand, which puts it in the right place; -1 for none
    pfx: int

    fn dump(self, t: &Txt) => void:
        t.put_all(&self.c)

    fn byte(self, x: int) => void:
        self.c.put_byte(x & 255)

    fn le32(self, v: int) => void:
        for k in 0..4:
            self.c.put_byte((v >> (8 * k)) & 255)

    fn le64(self, v: int) => void:
        for k in 0..8:
            self.c.put_byte((v >> (8 * k)) & 255)

    fn pos(self) => int:
        return self.c.n

    /#/ ---- labels ------------------------------------------------------------

    fn begin_fun(self) => void:
        while self.c.n % fn_align != 0:
            self.c.put_byte(204)
        self.nlab = 0
        self.nfx = 0
        self.fs = self.c.n
        self.rl0 = self.nrl

    fn new_label(self) => int:
        if self.nlab >= len(self.lab):
            self.lab = buf_resize(self.lab, (self.nlab + 1) * 2)
        self.lab[self.nlab] = 0 - 1
        self.nlab = self.nlab + 1
        return self.nlab - 1

    /#/ A label at the current position that does not break the peephole state: for line marks.
    fn mark(self) => int:
        let l = self.new_label()
        self.lab[l] = self.c.n
        return l

    fn bind(self, l: int) => void:
        self.lab[l] = self.c.n
        self.lm_end = 0 - 1
        self.ls_end = 0 - 1

    /#/ A 32-bit offset to label `l`, from the end of the field; `kind` is 0 for a `jmp` (one opcode
    /#/ byte before the field) and 1 for a `jcc` (two).
    fn rel_to(self, l: int, kind: int) => void:
        if self.nfx >= len(self.fx_at):
            self.fx_at = buf_resize(self.fx_at, (self.nfx + 1) * 2)
            self.fx_lab = buf_resize(self.fx_lab, (self.nfx + 1) * 2)
            self.fx_kind = buf_resize(self.fx_kind, (self.nfx + 1) * 2)
        self.fx_at[self.nfx] = self.c.n
        self.fx_lab[self.nfx] = l
        self.fx_kind[self.nfx] = kind
        self.nfx = self.nfx + 1
        self.le32(0)

    /#/ Resolves the jumps of the function just assembled: each is the short form when its target
    /#/ is within reach (and gone when it targets the next instruction), the rest are patched.
    /#/ False if a label was never bound.
    fn end_fun(self) => bool:
        if self.acc.bad > 0:
            self.acc.bad = 0
            return false
        let n = self.nfx
        for k in 0..n:
            if self.lab[self.fx_lab[k]] < 0:
                return false
        let st = new_buf(int, n + 1)
        let sz = new_buf(int, n + 1)
        let pref = new_buf(int, n + 2)
        for k in 0..n:
            st[k] = self.fx_at[k] - 1 - self.fx_kind[k]
            sz[k] = 5 + self.fx_kind[k]
        let changed = true
        while changed:
            changed = false
            let sum = 0
            for k in 0..n:
                pref[k] = sum
                sum = sum + (5 + self.fx_kind[k]) - sz[k]
            pref[n] = sum
            for k in 0..n:
                if sz[k] > 2:
                    let to = self.lab[self.fx_lab[k]]
                    if self.fx_kind[k] == 0 && to == self.fx_at[k] + 4:
                        sz[k] = 0
                        changed = true
                    else:
                        let d = new_pos(&st, &pref, n, to) - (st[k] - pref[k] + 2)
                        if d >= 0 - 128 && d < 128:
                            sz[k] = 2
                            changed = true
        let sum = 0
        for k in 0..n:
            pref[k] = sum
            sum = sum + (5 + self.fx_kind[k]) - sz[k]
        pref[n] = sum
        let out = new_txt()
        let at = self.fs
        for k in 0..n:
            for q in at..st[k]:
                out.put_byte(self.c.b[q])
            at = self.fx_at[k] + 4
            let to = new_pos(&st, &pref, n, self.lab[self.fx_lab[k]])
            let here = st[k] - pref[k]
            if sz[k] == 2:
                if self.fx_kind[k] == 0:
                    out.put_byte(235)
                else:
                    out.put_byte(self.c.b[self.fx_at[k] - 1] - 16)
                out.put_byte((to - (here + 2)) & 255)
            elif sz[k] > 2:
                for q in st[k]..self.fx_at[k]:
                    out.put_byte(self.c.b[q])
                let d = to - (here + sz[k])
                for q in 0..4:
                    out.put_byte((d >> (8 * q)) & 255)
        for q in at..self.c.n:
            out.put_byte(self.c.b[q])
        for r in self.rl0..self.nrl:
            self.rl_at[r] = new_pos(&st, &pref, n, self.rl_at[r])
        /#/ the labels of the function stay valid for whoever asks where one is (`lab[l]`)
        for l in 0..self.nlab:
            if self.lab[l] >= 0:
                self.lab[l] = new_pos(&st, &pref, n, self.lab[l])
        self.c.n = self.fs
        self.c.put_all(&out)
        return true

    fn reloc(self, sym: int, ty: int, addend: int) => void:
        if self.nrl >= len(self.rl_at):
            let cap = (self.nrl + 1) * 2
            self.rl_at = buf_resize(self.rl_at, cap)
            self.rl_sym = buf_resize(self.rl_sym, cap)
            self.rl_ty = buf_resize(self.rl_ty, cap)
            self.rl_add = buf_resize(self.rl_add, cap)
        self.rl_at[self.nrl] = self.c.n
        self.rl_sym[self.nrl] = sym
        self.rl_ty[self.nrl] = ty
        self.rl_add[self.nrl] = addend
        self.nrl = self.nrl + 1
        self.le32(0)

    /#/ ---- encoding ----------------------------------------------------------

    /#/ A REX prefix when one is needed (or `force`d, to reach sil/dil as byte registers).
    fn rex(self, w: int, reg: int, base: int, force: bool) => void:
        let v = 64 | (w << 3) | ((reg >> 3) << 2) | (base >> 3)
        if v != 64 || force:
            self.byte(v)

    /#/ `opc` (one or two bytes, the second -1 when absent) with a register and a register.
    fn rr(self, w: int, opc: int, opc2: int, reg: int, rmr: int, force: bool) => void:
        self.rex(w, reg, rmr, force)
        self.byte(opc)
        if opc2 >= 0:
            self.byte(opc2)
        self.byte(192 | ((reg & 7) << 3) | (rmr & 7))

    /#/ Is `base` the register of the host's stack frame (rsp, rbp)? An access through it is not the sandbox's:
    /#/ the code cannot get the address of the host stack, so it needs no guard.
    fn frame_base(self, base: int) => bool:
        return base == 4 || base == 5

    /#/ `lea reg, [rbp + idx * scale + disp]` as a 32-bit operation: a pointer into the shadow frame is a number below 2^32.
    fn enc_lea_sh(self, reg: int, idx: int, scale: int, disp: int) => void:
        if idx < 0:
            self.enc_mem(0, 141, 0 - 1, reg, 5, disp, false)
        else:
            self.enc_mem_idx(0, 141, 0 - 1, reg, 5, idx, scale, disp, false)

    /#/ The register that holds the address of a guarded access in base mode: the destination of a load, else one
    /#/ of rax, rcx, rdx the access does not use (the value of a store is in `reg`; of a float access, in an xmm
    /#/ register, which is not one of them); -1 when the three are taken.
    fn addr_scratch(self, opc: int, opc2: int, reg: int, base: int, idx: int) => int:
        let loadg = opc == 139 || opc == 99 || (opc == 15 && (opc2 == 182 || opc2 == 183 || opc2 == 190 || opc2 == 191))
        if loadg:
            return reg
        let xmm = opc == 15 && (opc2 == 16 || opc2 == 17 || opc2 == 110 || opc2 == 126 || opc2 == 214 || opc2 == 40 || opc2 == 41)
        return self.acc.pick(3, base, idx, reg, !xmm)

    /#/ A register to use for the address when `addr_scratch` found none free: one of rax, rcx, rdx that the access
    /#/ does not use, whose value is kept on the stack meanwhile; -1 when there is none.
    fn addr_spill(self, opc: int, opc2: int, reg: int, base: int, idx: int) => int:
        let xmm = opc == 15 && (opc2 == 16 || opc2 == 17 || opc2 == 110 || opc2 == 126 || opc2 == 214 || opc2 == 40 || opc2 == 41)
        return self.acc.pick_saved(3, base, idx, reg, !xmm)

    /#/ The guarded access of base mode: the address of `[lbase + idx * scale + disp]` as a 32-bit number in a
    /#/ register, then the access as [r15 + register] right after it.
    fn bm_access(self, w: int, opc: int, opc2: int, reg: int, lbase: int, idx: int, scale: int, disp: int, force: bool) => void:
        let sc = self.addr_scratch(opc, opc2, reg, lbase, idx)
        let spilled = false
        if sc < 0:
            sc = self.addr_spill(opc, opc2, reg, lbase, idx)
            if sc < 0:
                self.acc.fail()
                return
            spilled = true
            self.push(sc)
        let held = self.pfx
        self.pfx = 0 - 1
        self.mem(0, 141, 0 - 1, sc, lbase, idx, scale, disp, false)
        self.pfx = held
        self.mem(w, opc, opc2, reg, tg_sbx_base(), sc, 1, 0, force)
        if spilled:
            self.pop(sc)

    /#/ The one place a memory operand is made (design: docs/explanation/sandbox-design.md, "the memory-access
    /#/ funnel"): `opc` with a register and `[base + idx * scale + disp]`, `idx` -1 for none. `lea` (141) only
    /#/ computes and is never guarded. In sandbox code a guarded access is
    /#/   - `gs` mode (`sbx`): the operand with the prefixes 0x67 0x65, so the hardware takes the address as 32 bits
    /#/     and adds the start of the linear memory;
    /#/   - base mode (`bm`): the address as a 32-bit number in a register (`lea e<s>, [..]`, see `addr_scratch`) and the access
    /#/     as [r15 + s] right after it; the verifier takes no other form.
    fn mem(self, w: int, opc: int, opc2: int, reg: int, base: int, idx: int, scale: int, disp: int, force: bool) => void:
        if base == sh_base():
            /#/ the shadow frame of base mode: the low 32 bits of the frame pointer plus the offset are its address
            /#/ in the linear memory (the stack of the code is mapped to mirror the shadow stack)
            if opc == 141:
                self.enc_lea_sh(reg, idx, scale, disp + self.acc.shd)
                return
            self.bm_access(w, opc, opc2, reg, 5, idx, scale, disp + self.acc.shd, force)
            return
        let guarded = self.acc.guarded(opc == 141, self.frame_base(base))
        let gs = false
        if guarded && self.acc.bm && base != tg_sbx_base():
            self.bm_access(w, opc, opc2, reg, base, idx, scale, disp, force)
            return
        if guarded && self.acc.sbx && !self.acc.bm:
            gs = true
        if self.pfx >= 0:
            self.byte(self.pfx)
            self.pfx = 0 - 1
        if gs:
            self.byte(103)
            self.byte(101)
        if idx < 0:
            self.enc_mem(w, opc, opc2, reg, base, disp, force)
        else:
            self.enc_mem_idx(w, opc, opc2, reg, base, idx, scale, disp, force)

    /#/ `opc` with a register and the memory operand `[base + disp]`.
    fn rmem(self, w: int, opc: int, opc2: int, reg: int, base: int, disp: int, force: bool) => void:
        self.mem(w, opc, opc2, reg, base, 0 - 1, 1, disp, force)

    /#/ `opc` with a register and the memory operand `[base + idx * scale + disp]`.
    fn rmem_idx(self, w: int, opc: int, opc2: int, reg: int, base: int, idx: int, scale: int, disp: int, force: bool) => void:
        self.mem(w, opc, opc2, reg, base, idx, scale, disp, force)

    /#/ The bytes of `[base + disp]`: REX, the opcode, ModRM, SIB and the displacement.
    fn enc_mem(self, w: int, opc: int, opc2: int, reg: int, base: int, disp: int, force: bool) => void:
        self.rex(w, reg, base, force)
        self.byte(opc)
        if opc2 >= 0:
            self.byte(opc2)
        if disp == 0 && (base & 7) != 5:
            self.byte(((reg & 7) << 3) | (base & 7))
            self.sib(base)
        elif disp >= 0 - 128 && disp < 128:
            self.byte(64 | ((reg & 7) << 3) | (base & 7))
            self.sib(base)
            self.byte(disp)
        else:
            self.byte(128 | ((reg & 7) << 3) | (base & 7))
            self.sib(base)
            self.le32(disp)

    /#/ The bytes of `[base + idx * scale + disp]`.
    fn enc_mem_idx(self, w: int, opc: int, opc2: int, reg: int, base: int, idx: int, scale: int, disp: int, force: bool) => void:
        let ss = 0
        if scale == 2:
            ss = 1
        elif scale == 4:
            ss = 2
        elif scale == 8:
            ss = 3
        let v = 64 | (w << 3) | ((reg >> 3) << 2) | ((idx >> 3) << 1) | (base >> 3)
        if v != 64 || force:
            self.byte(v)
        self.byte(opc)
        if opc2 >= 0:
            self.byte(opc2)
        let md = 2
        if disp == 0 && (base & 7) != 5:
            md = 0
        elif disp >= 0 - 128 && disp < 128:
            md = 1
        self.byte((md << 6) | ((reg & 7) << 3) | 4)
        self.byte((ss << 6) | ((idx & 7) << 3) | (base & 7))
        if md == 1:
            self.byte(disp)
        elif md == 2:
            self.le32(disp)

    /#/ dst = the `n` bytes at [base + idx * scale + disp], zero-extended.
    fn load_idx(self, dst: int, base: int, idx: int, scale: int, disp: int, n: int) => void:
        if n == 1:
            self.rmem_idx(0, 15, 182, dst, base, idx, scale, disp, false)
        elif n == 2:
            self.rmem_idx(0, 15, 183, dst, base, idx, scale, disp, false)
        elif n == 4:
            self.rmem_idx(0, 139, 0 - 1, dst, base, idx, scale, disp, false)
        else:
            self.rmem_idx(1, 139, 0 - 1, dst, base, idx, scale, disp, false)

    /#/ The low `n` bytes of src to [base + idx * scale + disp].
    fn store_idx(self, base: int, idx: int, scale: int, disp: int, src: int, n: int) => void:
        if n == 1:
            self.rmem_idx(0, 136, 0 - 1, src, base, idx, scale, disp, true)
        elif n == 2:
            self.pfx = 102
            self.rmem_idx(0, 137, 0 - 1, src, base, idx, scale, disp, false)
        elif n == 4:
            self.rmem_idx(0, 137, 0 - 1, src, base, idx, scale, disp, false)
        else:
            self.rmem_idx(1, 137, 0 - 1, src, base, idx, scale, disp, false)

    /#/ rsp and r12 as a base need the byte that says "no index".
    fn sib(self, base: int) => void:
        if (base & 7) == 4:
            self.byte(36)

    /#/ dst = base + idx * scale (scale 1, 2, 4 or 8); idx is not rsp.
    fn lea_idx(self, dst: int, base: int, idx: int, scale: int) => void:
        let ss = 0
        if scale == 2:
            ss = 1
        elif scale == 4:
            ss = 2
        elif scale == 8:
            ss = 3
        self.byte(72 | ((dst >> 3) << 2) | ((idx >> 3) << 1) | (base >> 3))
        self.byte(141)
        if (base & 7) == 5:
            self.byte(68 | ((dst & 7) << 3))
            self.byte((ss << 6) | ((idx & 7) << 3) | (base & 7))
            self.byte(0)
        else:
            self.byte(4 | ((dst & 7) << 3))
            self.byte((ss << 6) | ((idx & 7) << 3) | (base & 7))

    /#/ dst = src * v
    fn imul_rri(self, dst: int, src: int, v: int) => void:
        self.rex(1, dst, src, false)
        if v >= 0 - 128 && v < 128:
            self.byte(107)
            self.byte(192 | ((dst & 7) << 3) | (src & 7))
            self.byte(v)
        else:
            self.byte(105)
            self.byte(192 | ((dst & 7) << 3) | (src & 7))
            self.le32(v)

    /#/ ---- moves -------------------------------------------------------------

    fn mov_rr(self, dst: int, src: int) => void:
        /#/ a move onto itself, or back what the move right before made, is nothing
        if dst == src:
            return
        if self.lm_end == self.c.n && self.lm_d == src && self.lm_s == dst:
            return
        self.rr(1, 139, 0 - 1, dst, src, false)
        self.lm_end = self.c.n
        self.lm_d = dst
        self.lm_s = src

    fn mov_ri(self, dst: int, v: int) => void:
        if v == 0:
            /#/ xor changes the flags: no code loads a constant between a compare and its branch
            if dst >= 8:
                self.byte(69)
            self.byte(49)
            self.byte(192 | ((dst & 7) << 3) | (dst & 7))
        elif v >= 0 && v < 4294967296:
            self.rex(0, 0, dst, false)
            self.byte(184 + (dst & 7))
            self.le32(v)
        elif v >= 0 - 2147483648 && v < 0:
            self.rex(1, 0, dst, false)
            self.byte(199)
            self.byte(192 | (dst & 7))
            self.le32(v)
        else:
            self.rex(1, 0, dst, false)
            self.byte(184 + (dst & 7))
            self.le64(v)

    /#/ dst = the `n` bytes at [base + disp], zero-extended.
    fn load(self, dst: int, base: int, disp: int, n: int) => void:
        if n == 1:
            self.rmem(0, 15, 182, dst, base, disp, false)
        elif n == 2:
            self.rmem(0, 15, 183, dst, base, disp, false)
        elif n == 4:
            self.rmem(0, 139, 0 - 1, dst, base, disp, false)
        else:
            if self.ls_end == self.c.n && self.ls_base == base && self.ls_disp == disp:
                /#/ what was just stored is still in its register
                self.mov_rr(dst, self.ls_reg)
                return
            self.rmem(1, 139, 0 - 1, dst, base, disp, false)

    /#/ The low `n` bytes of src to [base + disp].
    fn store(self, base: int, disp: int, src: int, n: int) => void:
        if n == 1:
            self.rmem(0, 136, 0 - 1, src, base, disp, true)
        elif n == 2:
            self.pfx = 102
            self.rmem(0, 137, 0 - 1, src, base, disp, false)
        elif n == 4:
            self.rmem(0, 137, 0 - 1, src, base, disp, false)
        else:
            self.rmem(1, 137, 0 - 1, src, base, disp, false)
            self.ls_end = self.c.n
            self.ls_base = base
            self.ls_disp = disp
            self.ls_reg = src

    fn lea(self, dst: int, base: int, disp: int) => void:
        self.rmem(1, 141, 0 - 1, dst, base, disp, false)

    /#/ dst = the address of rodata offset `off` (the symbol `rosym` is the section).
    fn lea_rip(self, dst: int, rosym: int, off: int) => void:
        if self.acc.sbx:
            self.rex(0, 0, dst, false)
            self.byte(184 + (dst & 7))
            self.reloc(rosym, r_abs32(), off)
            return
        self.rex(1, dst, 0, false)
        self.byte(141)
        self.byte(5 | ((dst & 7) << 3))
        self.reloc(rosym, r_pc32(), off - 4)

    /#/ dst = src extended from its low `n` bytes.
    fn extend(self, dst: int, src: int, n: int, signed: bool) => void:
        if n == 8:
            if dst != src:
                self.mov_rr(dst, src)
        elif n == 4:
            if signed:
                self.rr(1, 99, 0 - 1, dst, src, false)
            else:
                self.rr(0, 139, 0 - 1, dst, src, false)
        elif n == 2:
            if signed:
                self.rr(1, 15, 191, dst, src, false)
            else:
                self.rr(0, 15, 183, dst, src, false)
        else:
            if signed:
                self.rr(1, 15, 190, dst, src, true)
            else:
                self.rr(0, 15, 182, dst, src, true)

    /#/ ---- integer arithmetic ------------------------------------------------

    fn add_rr(self, dst: int, src: int) => void:
        self.rr(1, 3, 0 - 1, dst, src, false)

    fn sub_rr(self, dst: int, src: int) => void:
        self.rr(1, 43, 0 - 1, dst, src, false)

    fn and_rr(self, dst: int, src: int) => void:
        self.rr(1, 35, 0 - 1, dst, src, false)

    fn or_rr(self, dst: int, src: int) => void:
        self.rr(1, 11, 0 - 1, dst, src, false)

    fn xor_rr(self, dst: int, src: int) => void:
        self.rr(1, 51, 0 - 1, dst, src, false)

    fn cmp_rr(self, a: int, b: int) => void:
        self.rr(1, 59, 0 - 1, a, b, false)

    fn test_rr(self, a: int, b: int) => void:
        self.rr(1, 133, 0 - 1, b, a, false)

    fn imul_rr(self, dst: int, src: int) => void:
        self.rr(1, 15, 175, dst, src, false)

    /#/ `ext` (add 0, sub 5, cmp 7) of a register and an immediate, in the short form when it fits
    fn alu_ri(self, ext: int, r: int, v: int) => void:
        self.rex(1, 0, r, false)
        if v >= 0 - 128 && v < 128:
            self.byte(131)
            self.byte(192 | (ext << 3) | (r & 7))
            self.byte(v)
        else:
            self.byte(129)
            self.byte(192 | (ext << 3) | (r & 7))
            self.le32(v)

    /#/ reg += imm (sub with `sub_ri`)
    fn add_ri(self, r: int, v: int) => void:
        self.alu_ri(0, r, v)

    fn sub_ri(self, r: int, v: int) => void:
        self.alu_ri(5, r, v)

    fn and_ri(self, r: int, v: int) => void:
        self.alu_ri(4, r, v)

    fn or_ri(self, r: int, v: int) => void:
        self.alu_ri(1, r, v)

    fn xor_ri(self, r: int, v: int) => void:
        self.alu_ri(6, r, v)

    fn cmp_ri(self, r: int, v: int) => void:
        if v == 0:
            self.test_rr(r, r)
        else:
            self.alu_ri(7, r, v)

    /#/ the group-3 instructions: not 2, neg 3, div 6, idiv 7
    fn grp3(self, ext: int, r: int) => void:
        self.rex(1, 0, r, false)
        self.byte(247)
        self.byte(192 | (ext << 3) | (r & 7))

    fn neg(self, r: int) => void:
        self.grp3(3, r)

    fn not_(self, r: int) => void:
        self.grp3(2, r)

    fn div(self, r: int) => void:
        self.grp3(6, r)

    fn idiv(self, r: int) => void:
        self.grp3(7, r)

    fn cqo(self) => void:
        self.byte(72)
        self.byte(153)

    /#/ r shifted by cl: shl 4, shr 5, sar 7
    fn shift_cl(self, ext: int, r: int) => void:
        self.rex(1, 0, r, false)
        self.byte(211)
        self.byte(192 | (ext << 3) | (r & 7))

    /#/ r shifted by the immediate (shr 5)
    fn shift_i(self, ext: int, r: int, n: int) => void:
        self.rex(1, 0, r, false)
        self.byte(193)
        self.byte(192 | (ext << 3) | (r & 7))
        self.byte(n)

    /#/ al-style: the byte register `r` = condition `cc`, then zero-extended
    fn setcc(self, cc: int, r: int) => void:
        self.rex(0, 0, r, true)
        self.byte(15)
        self.byte(144 + cc)
        self.byte(192 | (r & 7))
        self.extend(r, r, 1, false)

    /#/ ---- control flow ------------------------------------------------------

    fn jmp(self, l: int) => void:
        self.byte(233)
        self.rel_to(l, 0)

    fn jcc(self, cc: int, l: int) => void:
        self.byte(15)
        self.byte(128 + cc)
        self.rel_to(l, 1)

    fn call_sym(self, sym: int) => void:
        self.byte(232)
        self.reloc(sym, r_plt32(), 0 - 4)

    fn call_reg(self, r: int) => void:
        self.rex(0, 0, r, false)
        self.byte(255)
        self.byte(192 | (2 << 3) | (r & 7))

    fn push(self, r: int) => void:
        self.rex(0, 0, r, false)
        self.byte(80 + (r & 7))

    fn pop(self, r: int) => void:
        self.rex(0, 0, r, false)
        self.byte(88 + (r & 7))

    fn leave(self) => void:
        self.byte(201)

    fn ret(self) => void:
        self.byte(195)

    fn ud2(self) => void:
        self.byte(15)
        self.byte(11)

    /#/ ---- scalar floating point (values travel through the general registers) ----

    /#/ xmm = the bits in r (a double, or a float in the low 32 bits)
    fn movq_x(self, x: int, r: int, single: bool) => void:
        self.byte(102)
        if single:
            self.rr(0, 15, 110, x, r, false)
        else:
            self.rr(1, 15, 110, x, r, false)

    /#/ r = the bits of xmm
    fn movq_r(self, r: int, x: int, single: bool) => void:
        self.byte(102)
        if single:
            self.rr(0, 15, 126, x, r, false)
        else:
            self.rr(1, 15, 126, x, r, false)

    /#/ xmm `x` = the double or float at `sym` + the addend (set later by the caller through the relocation
    /#/ this makes, the last one): for a constant kept after the code of the function
    fn load_x_sym(self, x: int, single: bool, sym: int) => void:
        if single:
            self.byte(243)
        else:
            self.byte(242)
        self.rex(0, x, 0, false)
        self.byte(15)
        self.byte(16)
        self.byte(5 | ((x & 7) << 3))
        self.reloc(sym, r_pc32(), 0)

    /#/ xmm `x` = the 16 bytes at [base + idx * scale + disp] (unaligned)
    fn vload(self, x: int, base: int, idx: int, scale: int, disp: int) => void:
        self.rmem_idx(0, 15, 16, x, base, idx, scale, disp, false)

    /#/ [base + idx * scale + disp] = the 16 bytes of xmm `x`
    fn vstore(self, base: int, idx: int, scale: int, x: int, disp: int) => void:
        self.rmem_idx(0, 15, 17, x, base, idx, scale, disp, false)

    /#/ A packed instruction `0F opc` on two xmm registers, with the prefix 66 when `pfx` is set.
    fn vec_op(self, pfx: bool, opc: int, dst: int, src: int) => void:
        if pfx:
            self.byte(102)
        self.rr(0, 15, opc, dst, src, false)

    /#/ xmm `x` = its low 8 bytes twice
    fn splat_q(self, x: int) => void:
        self.vec_op(true, 108, x, x)

    /#/ [base + disp] = the 16 bytes of xmm `x`, and back (unaligned)
    fn movups_st(self, base: int, disp: int, x: int) => void:
        self.rmem(0, 15, 17, x, base, disp, false)

    fn movups_ld(self, x: int, base: int, disp: int) => void:
        self.rmem(0, 15, 16, x, base, disp, false)

    /#/ xmm dst = xmm src (all 128 bits)
    fn movaps(self, dst: int, src: int) => void:
        self.rr(0, 15, 40, dst, src, false)

    /#/ xmm dst = dst xor xmm src
    fn xorps(self, dst: int, src: int) => void:
        self.rr(0, 15, 87, dst, src, false)

    /#/ xmm = the float or double at [base + disp]
    fn load_x(self, x: int, base: int, disp: int, single: bool) => void:
        if single:
            self.pfx = 243
        else:
            self.pfx = 242
        self.rmem(0, 15, 16, x, base, disp, false)

    /#/ [base + disp] = the float or double in xmm
    fn store_x(self, base: int, disp: int, x: int, single: bool) => void:
        if single:
            self.pfx = 243
        else:
            self.pfx = 242
        self.rmem(0, 15, 17, x, base, disp, false)

    fn load_x_idx(self, x: int, base: int, idx: int, scale: int, disp: int, single: bool) => void:
        if single:
            self.pfx = 243
        else:
            self.pfx = 242
        self.rmem_idx(0, 15, 16, x, base, idx, scale, disp, false)

    fn store_x_idx(self, base: int, idx: int, scale: int, disp: int, x: int, single: bool) => void:
        if single:
            self.pfx = 243
        else:
            self.pfx = 242
        self.rmem_idx(0, 15, 17, x, base, idx, scale, disp, false)

    /#/ the arithmetic ops: add 88, mul 89, sub 92, div 94 on xmm registers
    fn sse(self, op: int, single: bool, dst: int, src: int) => void:
        if single:
            self.byte(243)
        else:
            self.byte(242)
        self.rr(0, 15, op, dst, src, false)

    /#/ ucomisd / ucomiss
    fn ucomi(self, single: bool, a: int, b: int) => void:
        if !single:
            self.byte(102)
        self.rr(0, 15, 46, a, b, false)

    /#/ xmm = (double or float) of the signed 64-bit integer in r
    fn cvt_si2f(self, x: int, r: int, single: bool) => void:
        if single:
            self.byte(243)
        else:
            self.byte(242)
        self.rr(1, 15, 42, x, r, false)

    /#/ r = the 64-bit integer of the double or float in xmm, truncated
    fn cvt_f2si(self, r: int, x: int, single: bool) => void:
        if single:
            self.byte(243)
        else:
            self.byte(242)
        self.rr(1, 15, 44, r, x, false)

    /#/ double <-> float
    fn cvt_ff(self, dst: int, src: int, to_single: bool) => void:
        if to_single:
            self.byte(242)
        else:
            self.byte(243)
        self.rr(0, 15, 90, dst, src, false)

fn new_asm() => Asm:
    return Asm { c: new_txt(), lab: new_buf(int, 64), nlab: 0, fx_at: new_buf(int, 64), fx_lab: new_buf(int, 64), fx_kind: new_buf(int, 64), nfx: 0, fs: 0, rl0: 0, rl_at: new_buf(int, 64), rl_sym: new_buf(int, 64), rl_ty: new_buf(int, 64), rl_add: new_buf(int, 64), nrl: 0, lm_end: -1, lm_d: 0, lm_s: 0, ls_end: -1, ls_base: 0, ls_disp: 0, ls_reg: 0, acc: new_access(), pfx: 0 - 1 }
