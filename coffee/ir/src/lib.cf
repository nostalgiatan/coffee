/#/ The functions of a module, kept side by side as columns so the optimizer can look into one
/#/ while it works on another (inlining) and so each function can be summarized.
/#/
/#/ `save` appends the columns of a function to the store, `restore` puts them back into a `Fun`.
/#/ Indices inside a function are its own (from 0); the store only remembers where the rows are.
use * in opt
use memcpy in libc of c

/#/ `n` ints from address `src` (element `s0` on) to address `dst` (element `d0` on), in one `memcpy`. The
/#/ addresses are those of buffers (`buf_ptr`) whose room the caller has seen to.
fn cp_ints(dst: int, d0: int, src: int, s0: int, n: int) => void:
    if n > 0:
        memcpy((dst + 8 * d0) as object, (src + 8 * s0) as object, 8 * n)

class Lib:
    fx: buf<int>
    fx_n: int
    op: buf<int>
    rep: buf<int>
    ty: buf<int>
    a: buf<int>
    b: buf<int>
    c: buf<int>
    aux: buf<int>
    nx: buf<int>
    pv: buf<int>
    uses: buf<int>
    ln: buf<int>
    fwd: buf<int>
    blk: buf<int>
    ni: int
    bfirst: buf<int>
    blast: buf<int>
    pfirst: buf<int>
    plast: buf<int>
    npar: buf<int>
    nb: int
    efrom: buf<int>
    eto: buf<int>
    eargs: buf<int>
    eargn: buf<int>
    ne: int
    pool: buf<int>
    np: int
    nm: buf<int>
    nmn: int
    /#/ the function table: where each function's rows are
    nf: int
    f_i0: buf<int>
    f_ni: buf<int>
    f_b0: buf<int>
    f_nb: buf<int>
    f_e0: buf<int>
    f_ne: buf<int>
    f_p0: buf<int>
    f_np: buf<int>
    f_n0: buf<int>
    f_nn: buf<int>
    f_ret: buf<int>
    /#/ the name number of the function (the callee number of a call), -1 if unknown
    f_id: buf<int>
    /#/ the effect summary and the order the passes visit it
    f_fx: buf<int>
    f_done: buf<int>
    /#/ the pointer parameters the function does not let escape (bit q), and bit 40: parameter 0 is
    /#/ released by the function and otherwise does not escape (a drop glue)
    f_nc: buf<int>

    fn grow_cols(self, extra_i: int, extra_b: int, extra_e: int, extra_p: int, extra_n: int) => void:
        if self.ni + extra_i > len(self.op):
            let cap = (self.ni + extra_i) * 4
            self.op = buf_resize(self.op, cap)
            self.rep = buf_resize(self.rep, cap)
            self.ty = buf_resize(self.ty, cap)
            self.a = buf_resize(self.a, cap)
            self.b = buf_resize(self.b, cap)
            self.c = buf_resize(self.c, cap)
            self.aux = buf_resize(self.aux, cap)
            self.nx = buf_resize(self.nx, cap)
            self.pv = buf_resize(self.pv, cap)
            self.uses = buf_resize(self.uses, cap)
            self.ln = buf_resize(self.ln, cap)
            self.fwd = buf_resize(self.fwd, cap)
            self.blk = buf_resize(self.blk, cap)
        if self.nb + extra_b > len(self.bfirst):
            let cap = (self.nb + extra_b) * 2
            self.bfirst = buf_resize(self.bfirst, cap)
            self.blast = buf_resize(self.blast, cap)
            self.pfirst = buf_resize(self.pfirst, cap)
            self.plast = buf_resize(self.plast, cap)
            self.npar = buf_resize(self.npar, cap)
        if self.ne + extra_e > len(self.eto):
            let cap = (self.ne + extra_e) * 2
            self.efrom = buf_resize(self.efrom, cap)
            self.eto = buf_resize(self.eto, cap)
            self.eargs = buf_resize(self.eargs, cap)
            self.eargn = buf_resize(self.eargn, cap)
        if self.np + extra_p > len(self.pool):
            self.pool = buf_resize(self.pool, (self.np + extra_p) * 2)
        if self.nmn + extra_n > len(self.nm):
            self.nm = buf_resize(self.nm, (self.nmn + extra_n) * 2)

    fn grow_table(self) => void:
        if self.nf >= len(self.f_i0):
            let cap = (self.nf + 1) * 2
            self.f_i0 = buf_resize(self.f_i0, cap)
            self.f_ni = buf_resize(self.f_ni, cap)
            self.f_b0 = buf_resize(self.f_b0, cap)
            self.f_nb = buf_resize(self.f_nb, cap)
            self.f_e0 = buf_resize(self.f_e0, cap)
            self.f_ne = buf_resize(self.f_ne, cap)
            self.f_p0 = buf_resize(self.f_p0, cap)
            self.f_np = buf_resize(self.f_np, cap)
            self.f_n0 = buf_resize(self.f_n0, cap)
            self.f_nn = buf_resize(self.f_nn, cap)
            self.f_ret = buf_resize(self.f_ret, cap)
            self.f_id = buf_resize(self.f_id, cap)
            self.f_fx = buf_resize(self.f_fx, cap)
            self.f_done = buf_resize(self.f_done, cap)
            self.f_nc = buf_resize(self.f_nc, cap)

    /#/ Stores the columns of `f` as function number `at`, a new one when `at` is the count
    /#/ of functions. `id` is its name number. Returns the number.
    fn save(self, f: &Fun, at: int, id: int) => int:
        let n = at
        /#/ a function saved again that is not bigger than before goes over its old rows (an optimized
        /#/ function is smaller), so the store does not keep both
        let inplace = at < self.nf && f.ni <= self.f_ni[at] && f.nb <= self.f_nb[at] && f.ne <= self.f_ne[at] && f.np <= self.f_np[at] && len(f.nm) <= self.f_nn[at]
        if !inplace:
            self.grow_cols(f.ni, f.nb, f.ne, f.np, len(f.nm))
        if at >= self.nf:
            self.grow_table()
            n = self.nf
            self.nf = self.nf + 1
            self.f_fx[n] = 0
            self.f_done[n] = 0
            self.f_nc[n] = 0
        if !inplace:
            self.f_i0[n] = self.ni
            self.f_b0[n] = self.nb
            self.f_e0[n] = self.ne
            self.f_p0[n] = self.np
            self.f_n0[n] = self.nmn
        self.f_ni[n] = f.ni
        self.f_nb[n] = f.nb
        self.f_ne[n] = f.ne
        self.f_np[n] = f.np
        self.f_nn[n] = len(f.nm)
        self.f_ret[n] = f.ret
        self.f_id[n] = id
        let i0 = self.f_i0[n]
        let b0 = self.f_b0[n]
        let e0 = self.f_e0[n]
        let p0 = self.f_p0[n]
        let n0 = self.f_n0[n]
        cp_ints(int(buf_ptr(self.op)), i0, int(buf_ptr(f.op)), 0, f.ni)
        cp_ints(int(buf_ptr(self.rep)), i0, int(buf_ptr(f.rep)), 0, f.ni)
        cp_ints(int(buf_ptr(self.ty)), i0, int(buf_ptr(f.ty)), 0, f.ni)
        cp_ints(int(buf_ptr(self.a)), i0, int(buf_ptr(f.a)), 0, f.ni)
        cp_ints(int(buf_ptr(self.b)), i0, int(buf_ptr(f.b)), 0, f.ni)
        cp_ints(int(buf_ptr(self.c)), i0, int(buf_ptr(f.c)), 0, f.ni)
        cp_ints(int(buf_ptr(self.aux)), i0, int(buf_ptr(f.aux)), 0, f.ni)
        cp_ints(int(buf_ptr(self.nx)), i0, int(buf_ptr(f.nx)), 0, f.ni)
        cp_ints(int(buf_ptr(self.pv)), i0, int(buf_ptr(f.pv)), 0, f.ni)
        cp_ints(int(buf_ptr(self.uses)), i0, int(buf_ptr(f.uses)), 0, f.ni)
        cp_ints(int(buf_ptr(self.ln)), i0, int(buf_ptr(f.ln)), 0, f.ni)
        cp_ints(int(buf_ptr(self.fwd)), i0, int(buf_ptr(f.fwd)), 0, f.ni)
        cp_ints(int(buf_ptr(self.blk)), i0, int(buf_ptr(f.blk)), 0, f.ni)
        cp_ints(int(buf_ptr(self.bfirst)), b0, int(buf_ptr(f.bfirst)), 0, f.nb)
        cp_ints(int(buf_ptr(self.blast)), b0, int(buf_ptr(f.blast)), 0, f.nb)
        cp_ints(int(buf_ptr(self.pfirst)), b0, int(buf_ptr(f.pfirst)), 0, f.nb)
        cp_ints(int(buf_ptr(self.plast)), b0, int(buf_ptr(f.plast)), 0, f.nb)
        cp_ints(int(buf_ptr(self.npar)), b0, int(buf_ptr(f.npar)), 0, f.nb)
        cp_ints(int(buf_ptr(self.efrom)), e0, int(buf_ptr(f.efrom)), 0, f.ne)
        cp_ints(int(buf_ptr(self.eto)), e0, int(buf_ptr(f.eto)), 0, f.ne)
        cp_ints(int(buf_ptr(self.eargs)), e0, int(buf_ptr(f.eargs)), 0, f.ne)
        cp_ints(int(buf_ptr(self.eargn)), e0, int(buf_ptr(f.eargn)), 0, f.ne)
        cp_ints(int(buf_ptr(self.pool)), p0, int(buf_ptr(f.pool)), 0, f.np)
        cp_ints(int(buf_ptr(self.nm)), n0, int(buf_ptr(f.nm)), 0, len(f.nm))
        if !inplace:
            self.ni = self.ni + f.ni
            self.nb = self.nb + f.nb
            self.ne = self.ne + f.ne
            self.np = self.np + f.np
            self.nmn = self.nmn + len(f.nm)
        return n

    /#/ Puts function `n` into `f`.
    fn restore(self, n: int, f: &Fun) => void:
        let name = new_txt()
        for k in 0..self.f_nn[n]:
            name.put_byte(self.nm[self.f_n0[n] + k])
        f.reset(&name, self.f_ret[n])
        f.ensure(self.f_ni[n], self.f_nb[n], self.f_ne[n], self.f_np[n])
        let i0 = self.f_i0[n]
        let ni = self.f_ni[n]
        cp_ints(int(buf_ptr(f.op)), 0, int(buf_ptr(self.op)), i0, ni)
        cp_ints(int(buf_ptr(f.rep)), 0, int(buf_ptr(self.rep)), i0, ni)
        cp_ints(int(buf_ptr(f.ty)), 0, int(buf_ptr(self.ty)), i0, ni)
        cp_ints(int(buf_ptr(f.a)), 0, int(buf_ptr(self.a)), i0, ni)
        cp_ints(int(buf_ptr(f.b)), 0, int(buf_ptr(self.b)), i0, ni)
        cp_ints(int(buf_ptr(f.c)), 0, int(buf_ptr(self.c)), i0, ni)
        cp_ints(int(buf_ptr(f.aux)), 0, int(buf_ptr(self.aux)), i0, ni)
        cp_ints(int(buf_ptr(f.nx)), 0, int(buf_ptr(self.nx)), i0, ni)
        cp_ints(int(buf_ptr(f.pv)), 0, int(buf_ptr(self.pv)), i0, ni)
        cp_ints(int(buf_ptr(f.uses)), 0, int(buf_ptr(self.uses)), i0, ni)
        cp_ints(int(buf_ptr(f.ln)), 0, int(buf_ptr(self.ln)), i0, ni)
        cp_ints(int(buf_ptr(f.fwd)), 0, int(buf_ptr(self.fwd)), i0, ni)
        cp_ints(int(buf_ptr(f.blk)), 0, int(buf_ptr(self.blk)), i0, ni)
        let b0 = self.f_b0[n]
        let nb = self.f_nb[n]
        cp_ints(int(buf_ptr(f.bfirst)), 0, int(buf_ptr(self.bfirst)), b0, nb)
        cp_ints(int(buf_ptr(f.blast)), 0, int(buf_ptr(self.blast)), b0, nb)
        cp_ints(int(buf_ptr(f.pfirst)), 0, int(buf_ptr(self.pfirst)), b0, nb)
        cp_ints(int(buf_ptr(f.plast)), 0, int(buf_ptr(self.plast)), b0, nb)
        cp_ints(int(buf_ptr(f.npar)), 0, int(buf_ptr(self.npar)), b0, nb)
        let e0 = self.f_e0[n]
        let ne = self.f_ne[n]
        cp_ints(int(buf_ptr(f.efrom)), 0, int(buf_ptr(self.efrom)), e0, ne)
        cp_ints(int(buf_ptr(f.eto)), 0, int(buf_ptr(self.eto)), e0, ne)
        cp_ints(int(buf_ptr(f.eargs)), 0, int(buf_ptr(self.eargs)), e0, ne)
        cp_ints(int(buf_ptr(f.eargn)), 0, int(buf_ptr(self.eargn)), e0, ne)
        cp_ints(int(buf_ptr(f.pool)), 0, int(buf_ptr(self.pool)), self.f_p0[n], self.f_np[n])
        f.set_counts(self.f_ni[n], self.f_nb[n], self.f_ne[n], self.f_np[n])
        f.reset_vn()
        f.set_attrs(0)

    /#/ The function whose name number is `id`, -1 when the module does not define it.
    fn find(self, id: int) => int:
        if id < 0:
            return -1
        /#/ the functions made since the last look are entered in `fx` (name number to function + 1)
        while self.fx_n < self.nf:
            let k = self.f_id[self.fx_n]
            if k >= 0:
                if k >= len(self.fx):
                    self.fx = buf_resize(self.fx, (k + 1) * 2)
                if self.fx[k] == 0:
                    self.fx[k] = self.fx_n + 1
            self.fx_n = self.fx_n + 1
        if id < len(self.fx) && self.fx[id] > 0:
            return self.fx[id] - 1
        return -1

fn new_lib() => Lib:
    return Lib { fx: new_buf(int, 16), fx_n: 0, op: new_buf(int, 65536), rep: new_buf(int, 65536), ty: new_buf(int, 65536), a: new_buf(int, 65536), b: new_buf(int, 65536), c: new_buf(int, 65536), aux: new_buf(int, 65536), nx: new_buf(int, 65536), pv: new_buf(int, 65536), uses: new_buf(int, 65536), ln: new_buf(int, 65536), fwd: new_buf(int, 65536), blk: new_buf(int, 65536), ni: 0, bfirst: new_buf(int, 16), blast: new_buf(int, 16), pfirst: new_buf(int, 16), plast: new_buf(int, 16), npar: new_buf(int, 16), nb: 0, efrom: new_buf(int, 16), eto: new_buf(int, 16), eargs: new_buf(int, 16), eargn: new_buf(int, 16), ne: 0, pool: new_buf(int, 65536), np: 0, nm: new_buf(int, 65536), nmn: 0, nf: 0, f_i0: new_buf(int, 8), f_ni: new_buf(int, 8), f_b0: new_buf(int, 8), f_nb: new_buf(int, 8), f_e0: new_buf(int, 8), f_ne: new_buf(int, 8), f_p0: new_buf(int, 8), f_np: new_buf(int, 8), f_n0: new_buf(int, 8), f_nn: new_buf(int, 8), f_ret: new_buf(int, 8), f_id: new_buf(int, 8), f_fx: new_buf(int, 8), f_done: new_buf(int, 8), f_nc: new_buf(int, 8) }
