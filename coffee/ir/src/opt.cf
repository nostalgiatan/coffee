/#/ The optimizer: a short list of linear passes over one function, run once, in an order
/#/ chosen so that one run reaches the result.
/#/
/#/   cleanup:  branches on a constant become jumps, unreachable blocks go, a block with one
/#/             predecessor that jumps to it is merged into it, instructions and block
/#/             parameters nobody uses go
/#/   own-opt:  `alloc` that is only freed goes with its `free`; `clone x` whose original
/#/             is dropped right after, and used nowhere else, is `x` itself
/#/
/#/ Every pass keeps the use counts of the columns right, so the next one can rely on them.
/#/ Not here yet: effect summaries, inlining and the attributes that come from them.
use * in ssa

/#/ Takes `i` out of its block's list (a parameter is not in that list).
fn unlink(f: &Fun, i: int) => void:
    let b = f.blk[i]
    let p = f.pv[i]
    let n = f.nx[i]
    if p >= 0:
        f.nx[p] = n
    else:
        f.bfirst[b] = n
    if n >= 0:
        f.pv[n] = p
    else:
        f.blast[b] = p
    f.pv[i] = -1
    f.nx[i] = -1

/#/ One use fewer for every operand of `i`.
fn unuse(f: &Fun, i: int) => void:
    for k in 0..f.nval(i):
        let v = f.val_at(i, k)
        if v >= 0:
            let x = f.follow(v)
            f.uses[x] = f.uses[x] - 1

/#/ An edge that goes nowhere any more: its arguments are not used.
fn cut_edge(f: &Fun, e: int) => void:
    if f.eto[e] < 0:
        return
    for k in 0..f.eargn[e]:
        let x = f.follow(f.pool[f.eargs[e] + k])
        f.uses[x] = f.uses[x] - 1
    f.eargn[e] = 0
    f.eto[e] = -1

/#/ Deletes instruction `i`: out of its list, its operands unused, its edges cut.
fn delete_inst(f: &Fun, i: int) => void:
    unuse(f, i)
    let o = f.op[i]
    if o == int(Op.Br) || o == int(Op.CondBr) || o == int(Op.Switch):
        for q in 0..f.nsucc(f.blk[i]):
            cut_edge(f, f.succ_edge(f.blk[i], q))
    unlink(f, i)

/#/ ---- constant branches ---------------------------------------------------

/#/ `condbr` on a constant is a `br` to the edge taken; the other edge is cut.
fn fold_branches(f: &Fun) => bool:
    let changed = false
    for b in 0..f.nb:
        let t = f.blast[b]
        if t >= 0 && f.op[t] == int(Op.CondBr):
            let c = f.follow(f.a[t])
            if f.is_const(c):
                let keep = f.b[t]
                let gone = f.c[t]
                if f.cval(c) == 0:
                    keep = f.c[t]
                    gone = f.b[t]
                cut_edge(f, gone)
                f.uses[c] = f.uses[c] - 1
                f.op[t] = int(Op.Br)
                f.aux[t] = keep
                f.a[t] = -1
                f.b[t] = -1
                f.c[t] = -1
                changed = true
    return changed

/#/ ---- jumps to jumps ----------------------------------------------------

/#/ An edge into a block that only jumps on goes to where that block goes, with what that jump passes.
/#/ The forwarding block loses its predecessors and is dropped as unreachable.
fn thread_jumps(f: &Fun) => bool:
    let changed = false
    for e in 0..f.ne:
        let guard = 0
        while f.eto[e] > 0 && f.eargn[e] == 0 && guard < 8:
            guard = guard + 1
            let b = f.eto[e]
            let t = f.blast[b]
            if f.npar[b] != 0 || t < 0 || f.bfirst[b] != t || f.op[t] != int(Op.Br):
                break
            let e2 = f.aux[t]
            let to = f.eto[e2]
            if to < 0 || to == b || e2 == e:
                break
            let at = f.np
            for k in 0..f.eargn[e2]:
                let v = f.pool[f.eargs[e2] + k]
                f.pool_put(v)
                f.uses[f.follow(v)] = f.uses[f.follow(v)] + 1
            f.eargs[e] = at
            f.eargn[e] = f.eargn[e2]
            f.eto[e] = to
            changed = true
    return changed

/#/ ---- unreachable blocks --------------------------------------------------

/#/ Removes the blocks no path from the entry reaches, and renumbers the rest.
fn drop_unreachable(f: &Fun) => bool:
    let seen: buf<int> = new_buf(int, f.nb + 1)
    let stack: buf<int> = new_buf(int, f.nb + 1)
    let sp = 0
    seen[0] = 1
    stack[0] = 0
    sp = 1
    while sp > 0:
        sp = sp - 1
        let b = stack[sp]
        for q in 0..f.nsucc(b):
            let e = f.succ_edge(b, q)
            let to = f.eto[e]
            if to >= 0 && seen[to] == 0:
                seen[to] = 1
                stack[sp] = to
                sp = sp + 1
    let dead = 0
    for b in 0..f.nb:
        if seen[b] == 0:
            dead = dead + 1
    if dead == 0:
        return false
    for b in 0..f.nb:
        if seen[b] == 0:
            let i = f.blast[b]
            while i >= 0:
                let p = f.pv[i]
                delete_inst(f, i)
                i = p
            f.bfirst[b] = -1
            f.blast[b] = -1
    /#/ renumber
    let map: buf<int> = new_buf(int, f.nb + 1)
    let n = 0
    for b in 0..f.nb:
        map[b] = -1
        if seen[b] == 1:
            map[b] = n
            n = n + 1
    for b in 0..f.nb:
        if seen[b] == 1:
            let nb = map[b]
            f.bfirst[nb] = f.bfirst[b]
            f.blast[nb] = f.blast[b]
            f.pfirst[nb] = f.pfirst[b]
            f.plast[nb] = f.plast[b]
            f.npar[nb] = f.npar[b]
            let i = f.bfirst[nb]
            while i >= 0:
                f.blk[i] = nb
                i = f.nx[i]
            let p = f.pfirst[nb]
            while p >= 0:
                f.blk[p] = nb
                p = f.nx[p]
    f.set_blocks(n)
    for e in 0..f.ne:
        if f.eto[e] >= 0:
            f.eto[e] = map[f.eto[e]]
        if f.efrom[e] >= 0:
            f.efrom[e] = map[f.efrom[e]]
    return true

/#/ ---- merging blocks ------------------------------------------------------

/#/ How many live edges enter block `b`.
fn pred_count(f: &Fun, b: int) => int:
    let n = 0
    for e in 0..f.ne:
        if f.eto[e] == b:
            n = n + 1
    return n

/#/ The first live edge that enters block `b`.
fn pred_first(f: &Fun, b: int) => int:
    for e in 0..f.ne:
        if f.eto[e] == b:
            return e
    return -1

/#/ A block that only one block enters, by a plain jump, joins that block.
fn merge_blocks(f: &Fun) => bool:
    let changed = false
    /#/ how many edges enter each block, and the first: joining blocks changes neither for the others
    let pcn: buf<int> = new_buf(int, f.nb + 1)
    let pfe: buf<int> = new_buf(int, f.nb + 1)
    for e in 0..f.ne:
        let t = f.eto[e]
        if t >= 0:
            if pcn[t] == 0:
                pfe[t] = e
            pcn[t] = pcn[t] + 1
    /#/ the block a joined block went into; the edges that leave it are renamed at the end
    let into: buf<int> = new_buf(int, f.nb + 1)
    for b in 0..f.nb:
        into[b] = b
    for b in 1..f.nb:
        if f.bfirst[b] >= 0 && pcn[b] == 1:
            let e = pfe[b]
            let a = f.efrom[e]
            while a >= 0 && into[a] != a:
                a = into[a]
            let t = -1
            if a >= 0:
                t = f.blast[a]
            if a != b && a >= 0 && t >= 0 && f.op[t] == int(Op.Br) && f.aux[t] == e:
                /#/ the parameters are what the edge passes
                let p = f.pfirst[b]
                let k = 0
                while p >= 0:
                    let x = f.follow(f.pool[f.eargs[e] + k])
                    f.fwd[p] = x
                    f.uses[x] = f.uses[x] + f.uses[p] - 1
                    p = f.nx[p]
                    k = k + 1
                f.pfirst[b] = -1
                f.plast[b] = -1
                f.npar[b] = 0
                /#/ the jump goes, the block's instructions follow the rest of `a`
                f.eargn[e] = 0
                f.eto[e] = -1
                unlink(f, t)
                let i = f.bfirst[b]
                while i >= 0:
                    f.blk[i] = a
                    i = f.nx[i]
                if f.bfirst[b] >= 0:
                    let l = f.blast[a]
                    if l >= 0:
                        f.nx[l] = f.bfirst[b]
                    else:
                        f.bfirst[a] = f.bfirst[b]
                    f.pv[f.bfirst[b]] = l
                    f.blast[a] = f.blast[b]
                f.bfirst[b] = -1
                f.blast[b] = -1
                into[b] = a
                changed = true
    if changed:
        for q in 0..f.ne:
            let x = f.efrom[q]
            while x >= 0 && into[x] != x:
                x = into[x]
            f.efrom[q] = x
    return changed

/#/ ---- dead code -----------------------------------------------------------

/#/ Can nobody tell that `i` was removed, when its value is not used?
fn removable(f: &Fun, i: int) => bool:
    let o = f.op[i]
    if f.tab.has(o, f_term()) || f.tab.has(o, f_writes()) || f.tab.has(o, f_consumes()):
        return false
    if o == int(Op.Param) || o == int(Op.Call) || o == int(Op.CCall) || o == int(Op.CallI) || o == int(Op.Clone):
        return false
    return true

/#/ Removes the instructions whose value nobody uses, from the end of each block backwards.
/#/ The use counts, from the instructions and edges that are there.
fn recount_uses(f: &Fun) => void:
    for i in 0..f.ni:
        f.uses[i] = 0
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            for k in 0..f.nval(i):
                let v = f.val_at(i, k)
                if v >= 0:
                    let x = f.follow(v)
                    f.uses[x] = f.uses[x] + 1
            i = f.nx[i]
    for e in 0..f.ne:
        if f.eto[e] >= 0:
            for k in 0..f.eargn[e]:
                let x = f.follow(f.pool[f.eargs[e] + k])
                f.uses[x] = f.uses[x] + 1

fn dead_code(f: &Fun) => bool:
    let changed = false
    recount_uses(f)
    for b in 0..f.nb:
        let i = f.blast[b]
        while i >= 0:
            let p = f.pv[i]
            if f.uses[i] == 0 && f.fwd[i] < 0 && removable(f, i):
                delete_inst(f, i)
                changed = true
            i = p
    return changed

/#/ Removes the parameters of the blocks (not the entry's) that nobody uses, and the
/#/ arguments the edges pass to them.
fn dead_params(f: &Fun) => bool:
    let changed = false
    for b in 1..f.nb:
        let n = f.npar[b]
        let keep: buf<int> = new_buf(int, n + 1)
        let any = false
        let p = f.pfirst[b]
        let k = 0
        while p >= 0:
            keep[k] = 1
            /#/ nobody uses it, or only the jump around the loop hands it back to itself
            let own = 0
            for e in 0..f.ne:
                if f.eto[e] == b && k < f.eargn[e] && f.follow(f.pool[f.eargs[e] + k]) == p:
                    own = own + 1
            if f.uses[p] == own:
                keep[k] = 0
                any = true
            p = f.nx[p]
            k = k + 1
        if any:
            for e in 0..f.ne:
                if f.eto[e] == b:
                    let m = f.eargn[e]
                    let start = f.np
                    let out = 0
                    for j in 0..m:
                        if j < n && keep[j] == 0:
                            let x = f.follow(f.pool[f.eargs[e] + j])
                            f.uses[x] = f.uses[x] - 1
                        else:
                            f.pool_put(f.pool[f.eargs[e] + j])
                            out = out + 1
                    f.eargs[e] = start
                    f.eargn[e] = out
            let first = -1
            let last = -1
            let q = f.pfirst[b]
            let cnt = 0
            while q >= 0:
                let nxt = f.nx[q]
                if keep[f.aux[q]] == 1:
                    f.pv[q] = last
                    f.nx[q] = -1
                    if last >= 0:
                        f.nx[last] = q
                    else:
                        first = q
                    last = q
                    cnt = cnt + 1
                q = nxt
            /#/ parameter numbers are their position
            let r = first
            let pos = 0
            while r >= 0:
                f.aux[r] = pos
                pos = pos + 1
                r = f.nx[r]
            f.pfirst[b] = first
            f.plast[b] = last
            f.npar[b] = cnt
            changed = true
    return changed

/#/ ---- ownership -----------------------------------------------------------

/#/ An `alloc` whose only use is the `free` that follows is no allocation at all.
/#/ `y = clone x; ...; drop x` with no other use of `x` makes `y` be `x`: the copy is never made.
fn own_opt(f: &Fun) => bool:
    let changed = false
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let nxt = f.nx[i]
            let o = f.op[i]
            if o == int(Op.Alloc) && f.uses[i] == 1:
                let j = nxt
                while j >= 0 && !(f.op[j] == int(Op.Free) && f.follow(f.a[j]) == i):
                    j = f.nx[j]
                if j >= 0:
                    if nxt == j:
                        nxt = f.nx[j]
                    delete_inst(f, j)
                    delete_inst(f, i)
                    changed = true
            elif o == int(Op.Clone) && f.fwd[i] < 0:
                let x = f.follow(f.a[i])
                if f.uses[x] == 2:
                    let j = f.nx[i]
                    while j >= 0 && !(f.op[j] == int(Op.Drop) && f.follow(f.a[j]) == x):
                        j = f.nx[j]
                    if j >= 0:
                        if nxt == j:
                            nxt = f.nx[j]
                        delete_inst(f, j)
                        f.uses[x] = f.uses[x] + f.uses[i]
                        f.fwd[i] = x
                        unlink(f, i)
                        f.uses[x] = f.uses[x] - 1
                        changed = true
            i = nxt
    return changed

/#/ An `alloc` that is freed in its own block and used only by loads and stores through it (and
/#/ field and index addresses of it) in between does not outlive the block: it becomes a `slot`
/#/ and the `free` goes. A pointer that is passed, stored, returned or used elsewhere keeps it on the heap.
fn stack_alloc(f: &Fun) => bool:
    let ipos: buf<int> = new_buf(int, f.ni + 1)
    let free_of: buf<int> = new_buf(int, f.ni + 1)
    let base: buf<int> = new_buf(int, f.ni + 1)
    let bad: buf<int> = new_buf(int, f.ni + 1)
    let blk_of: buf<int> = new_buf(int, f.ni + 1)
    let any = false
    for i in 0..f.ni:
        free_of[i] = -1
        base[i] = -1
    for b in 0..f.nb:
        let i = f.bfirst[b]
        let n = 0
        while i >= 0:
            ipos[i] = n
            blk_of[i] = b
            n = n + 1
            i = f.nx[i]
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            if f.op[i] == int(Op.Alloc) && f.fwd[i] < 0 && f.ty[i] > 0 && f.ty[i] <= 4096:
                let j = f.nx[i]
                while j >= 0 && !(f.op[j] == int(Op.Free) && f.follow(f.a[j]) == i):
                    j = f.nx[j]
                if j >= 0:
                    free_of[i] = j
                    base[i] = i
                    any = true
            i = f.nx[i]
    if !any:
        return false
    /#/ addresses derived from a candidate
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            if (f.op[i] == int(Op.Field) || f.op[i] == int(Op.Index)) && base[f.follow(f.a[i])] >= 0:
                base[i] = base[f.follow(f.a[i])]
            i = f.nx[i]
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let o = f.op[i]
            if !(o == int(Op.Alloc) && free_of[i] >= 0):
                for q in 0..f.nval(i):
                    let v = f.val_at(i, q)
                    if v >= 0:
                        let x = f.follow(v)
                        let c = base[x]
                        if c >= 0:
                            let ok = false
                            if blk_of[i] == blk_of[c] && ipos[i] > ipos[c] && ipos[i] <= ipos[free_of[c]] && q == 0:
                                if o == int(Op.Load) || o == int(Op.Store) || o == int(Op.Field) || o == int(Op.Index):
                                    ok = true
                                if o == int(Op.Free) && i == free_of[c] && x == c:
                                    ok = true
                            if !ok:
                                bad[c] = 1
            i = f.nx[i]
    for e in 0..f.ne:
        if f.eto[e] >= 0:
            for k in 0..f.eargn[e]:
                let c = base[f.follow(f.pool[f.eargs[e] + k])]
                if c >= 0:
                    bad[c] = 1
    let changed = false
    for c in 0..f.ni:
        if free_of[c] >= 0 && bad[c] == 0 && f.op[c] == int(Op.Alloc):
            delete_inst(f, free_of[c])
            f.op[c] = int(Op.Slot)
            changed = true
    return changed

/#/ Runs the passes: cleanup, own-opt, cleanup again for what that exposed.
/#/ Moves every `extract` to just after the aggregate it reads, and keeps one of those that read
/#/ the same element: a field of a value defined before a loop is read once, not each time round.
fn hoist_extracts(f: &Fun) => bool:
    let changed = false
    let seen = 0
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let nxt = f.nx[i]
            if f.op[i] == int(Op.Extract) && f.fwd[i] < 0:
                seen = seen + 1
                let g = f.follow(f.a[i])
                let db = f.blk[g]
                if db >= 0 && db != b:
                    unlink(f, i)
                    f.blk[i] = db
                    if f.op[g] == int(Op.Param):
                        let first = f.bfirst[db]
                        f.pv[i] = -1
                        f.nx[i] = first
                        if first >= 0:
                            f.pv[first] = i
                        else:
                            f.blast[db] = i
                        f.bfirst[db] = i
                    else:
                        let n = f.nx[g]
                        f.pv[i] = g
                        f.nx[i] = n
                        f.nx[g] = i
                        if n >= 0:
                            f.pv[n] = i
                        else:
                            f.blast[db] = i
                    changed = true
            i = nxt
    if seen < 2:
        return changed
    /#/ the same element of the same aggregate: all of them are in one block now, the first dominates
    let cap = 16
    while cap < seen * 2:
        cap = cap * 2
    let tab: buf<int> = new_buf(int, cap)
    for q in 0..cap:
        tab[q] = -1
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let nxt = f.nx[i]
            if f.op[i] == int(Op.Extract) && f.fwd[i] < 0:
                let g = f.follow(f.a[i])
                let h = ((g * 31 + f.aux[i]) * 31 + f.rep[i]) % cap
                if h < 0:
                    h = h + cap
                let found = -1
                while tab[h] >= 0 && found < 0:
                    let e = tab[h]
                    if f.follow(f.a[e]) == g && f.aux[e] == f.aux[i] && f.rep[e] == f.rep[i]:
                        found = e
                    else:
                        h = (h + 1) % cap
                if found >= 0:
                    f.uses[found] = f.uses[found] + f.uses[i]
                    f.fwd[i] = found
                    unuse(f, i)
                    unlink(f, i)
                    changed = true
                else:
                    tab[h] = i
            i = nxt
    return changed

/#/ ---- common subexpressions and known conditions ------------------------------

/#/ Does the value of `i` depend on its operands alone (no memory, no call)?
fn pure_op(o: int) => bool:
    if o >= int(Op.Add) && o <= int(Op.FNeg) && o != int(Op.FRem):
        return true
    if o >= int(Op.Cmp) && o <= int(Op.Insert):
        return true
    return o == int(Op.Field) || o == int(Op.Index)

fn commutes(o: int) => bool:
    return o == int(Op.Add) || o == int(Op.Mul) || o == int(Op.And) || o == int(Op.Or) || o == int(Op.Xor) || o == int(Op.FAdd) || o == int(Op.FMul)

/#/ The operands of pure instruction `i` as values, the first two in a fixed order when the
/#/ operation commutes. Returns them in `k[0..3]`.
fn operands(f: &Fun, i: int, k: &buf<int>) => void:
    let x = -1
    let y = -1
    let z = -1
    if f.a[i] >= 0:
        x = f.follow(f.a[i])
    if f.b[i] >= 0:
        y = f.follow(f.b[i])
    if f.c[i] >= 0:
        z = f.follow(f.c[i])
    if commutes(f.op[i]) && x > y:
        let t = x
        x = y
        y = t
    k[0] = x
    k[1] = y
    k[2] = z

/#/ The blocks reachable from the entry in reverse post-order (`rpo`, the count returned) and their
/#/ immediate dominators (`idom`, -1 for the unreachable).
fn dominators(f: &Fun, rpo: &buf<int>, idom: &buf<int>, pc: &buf<int>, pl: &buf<int>) => int:
    let nb = f.nb
    let visited: buf<int> = new_buf(int, nb + 1)
    let ci: buf<int> = new_buf(int, nb + 1)
    let stack: buf<int> = new_buf(int, nb + 1)
    let post: buf<int> = new_buf(int, nb + 1)
    let sp = 1
    let np = 0
    stack[0] = 0
    visited[0] = 1
    while sp > 0:
        let b = stack[sp - 1]
        if f.terminated(b) && ci[b] < f.nsucc(b):
            /#/ the last successor first, so that the first one comes first in reverse post-order
            let t = f.eto[f.succ_edge(b, f.nsucc(b) - 1 - ci[b])]
            ci[b] = ci[b] + 1
            if t >= 0 && t < nb && visited[t] == 0:
                visited[t] = 1
                stack[sp] = t
                sp = sp + 1
        else:
            post[np] = b
            np = np + 1
            sp = sp - 1
    let num: buf<int> = new_buf(int, nb + 1)
    for k in 0..np:
        rpo[k] = post[np - 1 - k]
        num[rpo[k]] = k
    for b in 0..nb:
        idom[b] = -1
    idom[0] = 0
    /#/ the predecessors: those of block b are pl[pc[b] .. pc[b + 1]]
    for k in 0..np:
        let b = rpo[k]
        for s in 0..f.nsucc(b):
            let t = f.eto[f.succ_edge(b, s)]
            if t >= 0:
                pc[t + 1] = pc[t + 1] + 1
    for b in 0..nb:
        pc[b + 1] = pc[b + 1] + pc[b]
    let fill: buf<int> = new_buf(int, nb + 1)
    for k in 0..np:
        let b = rpo[k]
        for s in 0..f.nsucc(b):
            let t = f.eto[f.succ_edge(b, s)]
            if t >= 0:
                pl[pc[t] + fill[t]] = b
                fill[t] = fill[t] + 1
    let changed = true
    while changed:
        changed = false
        for k in 1..np:
            let b = rpo[k]
            let nd = -1
            for q in pc[b]..pc[b + 1]:
                let pb = pl[q]
                if idom[pb] >= 0:
                    if nd < 0:
                        nd = pb
                    else:
                        let x = pb
                        let y = nd
                        while x != y:
                            while num[x] > num[y]:
                                x = idom[x]
                            while num[y] > num[x]:
                                y = idom[y]
                        nd = x
            if nd != idom[b]:
                idom[b] = nd
                changed = true
    return np

/#/ Replaces instruction `i` by the value `v` everywhere.
fn replace_inst(f: &Fun, i: int, v: int) => void:
    f.uses[v] = f.uses[v] + f.uses[i]
    f.fwd[i] = v
    unuse(f, i)
    unlink(f, i)

/#/ Is the integer `v` never negative? A constant, or a loop counter: a block parameter that starts at a
/#/ small constant and only grows by small constants (it would take more than 2^50 steps to wrap).
fn nonneg(f: &Fun, v0: int) => bool:
    let v = f.follow(v0)
    if f.is_const(v):
        return f.cval(v) >= 0
    if f.op[v] != int(Op.Param) || f.blk[v] == 0 || f.rep[v] != int(Rp.I64):
        return false
    let b = f.blk[v]
    let k = 0
    let q = f.pfirst[b]
    while q >= 0 && q != v:
        q = f.nx[q]
        k = k + 1
    let seen = 0
    for e in 0..f.ne:
        if f.eto[e] == b:
            seen = seen + 1
            if k >= f.eargn[e]:
                return false
            let a = f.follow(f.pool[f.eargs[e] + k])
            if f.is_const(a):
                if f.cval(a) < 0 || f.cval(a) > 4294967296:
                    return false
            elif f.op[a] == int(Op.Add) && f.follow(f.a[a]) == v && f.is_const(f.follow(f.b[a])) && f.cval(f.follow(f.b[a])) >= 0 && f.cval(f.follow(f.b[a])) <= 256:
                seen = seen
            else:
                return false
    return seen > 0

/#/ Does the taken edge of `slt x, K'` settle `ult x, K`? Then x < K' <= K, and x is not negative.
fn implies_ult(f: &Fun, c2: int, c: int) => bool:
    if f.op[c] != int(Op.Cmp) || f.op[c2] != int(Op.Cmp):
        return false
    if f.aux[c] != int(Pr.ULt) || f.aux[c2] != int(Pr.SLt):
        return false
    let x = f.follow(f.a[c])
    let k = f.follow(f.b[c])
    let x2 = f.follow(f.a[c2])
    let k2 = f.follow(f.b[c2])
    if x != x2 || !f.is_const(k) || !f.is_const(k2) || f.rep[x] != int(Rp.I64):
        return false
    return f.cval(k2) <= f.cval(k) && nonneg(f, x)

/#/ A pure instruction that an instruction with the same operation and operands in a dominating
/#/ block already computed is that one. Then a branch on a condition that a dominating branch has
/#/ decided (the block is entered by one edge of it) goes one way only: the second bounds check
/#/ of `a[i]` and the checks the loop condition implies.
fn cse_branches(f: &Fun) => bool:
    if f.nb < 2:
        return false
    let nb = f.nb
    let rpo: buf<int> = new_buf(int, nb + 1)
    let idom: buf<int> = new_buf(int, nb + 1)
    let pc: buf<int> = new_buf(int, nb + 2)
    let pl: buf<int> = new_buf(int, f.ne + 1)
    let np = dominators(f, &rpo, &idom, &pc, &pl)
    let changed = false
    /#/ the dominator tree, and the single predecessor of each block (-1: none or several)
    let head: buf<int> = new_buf(int, nb + 1)
    let sib: buf<int> = new_buf(int, nb + 1)
    let npred: buf<int> = new_buf(int, nb + 1)
    let pred1: buf<int> = new_buf(int, nb + 1)
    for b in 0..nb:
        head[b] = -1
        pred1[b] = -1
    for k in 0..np:
        let b = rpo[k]
        if b != 0:
            sib[b] = head[idom[b]]
            head[idom[b]] = b
        for s in 0..f.nsucc(b):
            let t = f.eto[f.succ_edge(b, s)]
            if t >= 0:
                npred[t] = npred[t] + 1
                pred1[t] = b
    let cap = 64
    while cap < f.ni * 2:
        cap = cap * 2
    let tab: buf<int> = new_buf(int, cap)
    for q in 0..cap:
        tab[q] = -1
    let log: buf<int> = new_buf(int, f.ni + 1)
    let nlog = 0
    let mark: buf<int> = new_buf(int, nb + 1)
    let entered: buf<int> = new_buf(int, nb + 1)
    let stack: buf<int> = new_buf(int, nb + 1)
    let ka: buf<int> = new_buf(int, 4)
    let kb: buf<int> = new_buf(int, 4)
    let sp = 1
    stack[0] = 0
    while sp > 0:
        let b = stack[sp - 1]
        if entered[b] == 1:
            while nlog > mark[b]:
                nlog = nlog - 1
                tab[log[nlog]] = -1
            sp = sp - 1
        else:
            entered[b] = 1
            mark[b] = nlog
            let i = f.bfirst[b]
            while i >= 0:
                let nxt = f.nx[i]
                if pure_op(f.op[i]) && f.fwd[i] < 0:
                    operands(f, i, &ka)
                    let h = hmix(hmix(hmix(hmix(hmix(f.op[i], f.rep[i]), ka[0]), ka[1]), ka[2]), f.aux[i]) % cap
                    if h < 0:
                        h = h + cap
                    let found = -1
                    while tab[h] >= 0 && found < 0:
                        let e = tab[h]
                        if f.op[e] == f.op[i] && f.rep[e] == f.rep[i] && f.aux[e] == f.aux[i]:
                            operands(f, e, &kb)
                            if kb[0] == ka[0] && kb[1] == ka[1] && kb[2] == ka[2]:
                                found = e
                        if found < 0:
                            h = (h + 1) % cap
                    if found >= 0:
                        replace_inst(f, i, found)
                        changed = true
                    else:
                        tab[h] = i
                        log[nlog] = h
                        nlog = nlog + 1
                i = nxt
            /#/ a decided condition: walk up the blocks that are entered by one edge of a branch
            let t = f.blast[b]
            if t >= 0 && f.op[t] == int(Op.CondBr):
                let c = f.follow(f.a[t])
                if !f.is_const(c):
                    let x = b
                    let known = -1
                    while known < 0:
                        if npred[x] == 1:
                            let pb = pred1[x]
                            let pt = f.blast[pb]
                            if pt >= 0 && f.op[pt] == int(Op.CondBr) && f.follow(f.a[pt]) == c:
                                let et = f.eto[f.b[pt]]
                                let ef = f.eto[f.c[pt]]
                                if et == x && ef != x:
                                    known = 1
                                elif ef == x && et != x:
                                    known = 0
                            elif pt >= 0 && f.op[pt] == int(Op.CondBr) && implies_ult(f, f.follow(f.a[pt]), c):
                                if f.eto[f.b[pt]] == x && f.eto[f.c[pt]] != x:
                                    known = 1
                        if known < 0:
                            if x == 0 || idom[x] == x || idom[x] < 0:
                                break
                            x = idom[x]
                    if known >= 0:
                        let kc = f.cint(int(Rp.I8), known)
                        f.uses[c] = f.uses[c] - 1
                        f.uses[kc] = f.uses[kc] + 1
                        f.a[t] = kc
                        changed = true
            let ch = head[b]
            while ch >= 0:
                stack[sp] = ch
                sp = sp + 1
                ch = sib[ch]
    return changed

/#/ ---- loop-invariant code ---------------------------------------------------

/#/ Does instruction `i` write memory or call something?
fn writes_memory(f: &Fun, i: int) => bool:
    let o = f.op[i]
    if o == int(Op.Store) || o == int(Op.Call) || o == int(Op.CCall) || o == int(Op.CallI) || o == int(Op.Alloc) || o == int(Op.Free) || o == int(Op.Drop) || o == int(Op.Clone) || o == int(Op.FRem):
        return true
    return f.tab.has(o, f_writes()) || f.tab.has(o, f_consumes())

/#/ Moves the instructions of a loop that depend only on what is computed before it to just before
/#/ the end of the block that enters the loop (made when the loop has several entries or the entry
/#/ block branches two ways). A load moves when nothing in the loop writes memory and it is in the
/#/ header, which runs whenever the loop is entered.
fn hoist_invariants(f: &Fun) => bool:
    if f.nb < 2:
        return false
    let nb = f.nb
    let rpo: buf<int> = new_buf(int, nb + 1)
    let idom: buf<int> = new_buf(int, nb + 1)
    let pc: buf<int> = new_buf(int, nb + 2)
    let pl: buf<int> = new_buf(int, f.ne + 1)
    let np = dominators(f, &rpo, &idom, &pc, &pl)
    let changed = false
    let inl: buf<int> = new_buf(int, nb + 1)
    let work: buf<int> = new_buf(int, nb + 1)
    let moved: buf<int> = new_buf(int, f.ni + 1)
    let list: buf<int> = new_buf(int, f.ni + 1)
    let k = np - 1
    let prev = 0
    while k >= 1:
        let h = rpo[k]
        k = k - 1
        /#/ what was marked for the loop before is not invariant in this one
        for r in 0..prev:
            moved[list[r]] = 0
        prev = 0
        /#/ the latches: predecessors that the header dominates
        let nw = 0
        for q in 0..nb:
            inl[q] = 0
        inl[h] = 1
        for q in pc[h]..pc[h + 1]:
            let t = pl[q]
            let x = t
            while x != h && x != 0 && idom[x] >= 0 && idom[x] != x:
                x = idom[x]
            if x == h && inl[t] == 0:
                inl[t] = 1
                work[nw] = t
                nw = nw + 1
        if nw == 0:
            continue
        while nw > 0:
            nw = nw - 1
            let b = work[nw]
            for q in pc[b]..pc[b + 1]:
                let t = pl[q]
                if inl[t] == 0 && idom[t] >= 0:
                    inl[t] = 1
                    work[nw] = t
                    nw = nw + 1
        /#/ memory written in the loop?
        let mem = false
        for r in 0..np:
            let b = rpo[r]
            if inl[b] == 1:
                let i = f.bfirst[b]
                while i >= 0:
                    if writes_memory(f, i):
                        mem = true
                    i = f.nx[i]
        /#/ what can move, in order
        let n = 0
        for r in 0..np:
            let b = rpo[r]
            if inl[b] == 1:
                let i = f.bfirst[b]
                while i >= 0:
                    let o = f.op[i]
                    if f.fwd[i] < 0 && (pure_op(o) || (o == int(Op.Load) && !mem && b == h)):
                        let ok = true
                        for u in 0..f.nval(i):
                            let v = f.val_at(i, u)
                            if v >= 0:
                                let x = f.follow(v)
                                if f.blk[x] >= 0 && inl[f.blk[x]] == 1 && moved[x] == 0:
                                    ok = false
                        if ok:
                            moved[i] = 1
                            list[n] = i
                            n = n + 1
                    i = f.nx[i]
        prev = n
        if n == 0:
            continue
        /#/ the block to move them to
        let outs = 0
        let oe = -1
        for e in 0..f.ne:
            let to = f.eto[e]
            if to == h:
                let fb = f.efrom[e]
                if fb >= 0 && fb < nb && inl[fb] == 0 && idom[fb] >= 0:
                    outs = outs + 1
                    oe = e
        if outs == 0:
            continue
        let pre = -1
        if outs == 1 && f.op[f.blast[f.efrom[oe]]] == int(Op.Br):
            pre = f.efrom[oe]
        else:
            let keep = f.cur
            pre = f.new_block()
            f.set_block(pre)
            let p = f.pfirst[h]
            while p >= 0:
                let q = f.param(pre, f.rep[p], f.ty[p])
                f.arg(q)
                p = f.nx[p]
            f.br(h)
            f.set_block(keep)
            for e in 0..f.ne - 1:
                if f.eto[e] == h:
                    let fb = f.efrom[e]
                    if fb >= 0 && fb < nb && inl[fb] == 0 && idom[fb] >= 0:
                        f.eto[e] = pre
            return true
        let t = f.blast[pre]
        for r in 0..n:
            let i = list[r]
            unlink(f, i)
            f.blk[i] = pre
            f.pv[i] = f.pv[t]
            f.nx[i] = t
            if f.pv[t] >= 0:
                f.nx[f.pv[t]] = i
            else:
                f.bfirst[pre] = i
            f.pv[t] = i
        changed = true
    return changed

/#/ ---- block order -------------------------------------------------------------

/#/ An order of the blocks, in `ord` (all `nb` blocks): reverse post-order; with `rotate`, a loop's
/#/ header moved after its last block (the test is at the bottom, entered by one jump); and the blocks
/#/ that end in `unreachable` (the failed checks) at the end so the likely way is the fall-through.
fn block_order(f: &Fun, ord: &buf<int>, rotate: bool) => void:
    let nb = f.nb
    let rpo: buf<int> = new_buf(int, nb + 1)
    let idom: buf<int> = new_buf(int, nb + 1)
    let pc: buf<int> = new_buf(int, nb + 2)
    let pl: buf<int> = new_buf(int, f.ne + 1)
    let np = dominators(f, &rpo, &idom, &pc, &pl)
    let seen: buf<int> = new_buf(int, nb + 1)
    let hot: buf<int> = new_buf(int, nb + 1)
    let nh = 0
    for k in 0..np:
        let b = rpo[k]
        seen[b] = 1
        let t = f.blast[b]
        if k > 0 && t >= 0 && f.op[t] == int(Op.Unreachable):
            continue
        hot[nh] = b
        nh = nh + 1
    /#/ loops, outermost first (a header comes before the blocks it dominates in reverse post-order)
    let inl: buf<int> = new_buf(int, nb + 1)
    let work: buf<int> = new_buf(int, nb + 1)
    let rot: buf<int> = new_buf(int, nb + 1)
    for k in 1..np:
        let h = rpo[k]
        if rot[h] == 1 || !rotate:
            continue
        let t = f.blast[h]
        if t < 0 || f.op[t] != int(Op.CondBr):
            continue
        let nw = 0
        for q in 0..nb:
            inl[q] = 0
        inl[h] = 1
        for q in pc[h]..pc[h + 1]:
            let l = pl[q]
            let x = l
            while x != h && x != 0 && idom[x] >= 0 && idom[x] != x:
                x = idom[x]
            if x == h && inl[l] == 0:
                inl[l] = 1
                work[nw] = l
                nw = nw + 1
        if nw == 0:
            continue
        while nw > 0:
            nw = nw - 1
            let b = work[nw]
            for q in pc[b]..pc[b + 1]:
                let l = pl[q]
                if inl[l] == 0 && idom[l] >= 0:
                    inl[l] = 1
                    work[nw] = l
                    nw = nw + 1
        /#/ the last block of the loop in the order, and where the header is
        let last = -1
        let at = -1
        for q in 0..nh:
            if hot[q] == h:
                at = q
            if inl[hot[q]] == 1:
                last = q
        if at < 0 || last <= at:
            continue
        for q in at..last:
            hot[q] = hot[q + 1]
        hot[last] = h
        rot[h] = 1
    let n = 0
    for q in 0..nh:
        ord[n] = hot[q]
        n = n + 1
    for k in 1..np:
        let b = rpo[k]
        let t = f.blast[b]
        if t >= 0 && f.op[t] == int(Op.Unreachable):
            ord[n] = b
            n = n + 1
    for b in 0..nb:
        if seen[b] == 0:
            ord[n] = b
            n = n + 1

/#/ An `extract` of an aggregate that is now known to be built by `insert`s (a parameter that turned
/#/ out to be one value all along) becomes the value that was inserted.
fn fold_extracts(f: &Fun) => bool:
    let changed = false
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let nxt = f.nx[i]
            if f.op[i] == int(Op.Extract) && f.fwd[i] < 0:
                let g = f.follow(f.a[i])
                while f.op[g] == int(Op.Insert) && f.aux[g] != f.aux[i]:
                    g = f.follow(f.a[g])
                if f.op[g] == int(Op.Insert) && f.rep[f.follow(f.b[g])] == f.rep[i]:
                    let v = f.follow(f.b[g])
                    f.uses[v] = f.uses[v] + f.uses[i]
                    f.fwd[i] = v
                    unuse(f, i)
                    unlink(f, i)
                    changed = true
            i = nxt
    return changed

/#/ ---- aggregate loads -------------------------------------------------------

/#/ Puts the just-made `x` (at the end of its block) right before `i`.
fn link_before(f: &Fun, x: int, i: int) => void:
    unlink(f, x)
    let p = f.pv[i]
    f.blk[x] = f.blk[i]
    f.pv[x] = p
    f.nx[x] = i
    f.pv[i] = x
    if p >= 0:
        f.nx[p] = x
    else:
        f.bfirst[f.blk[i]] = x

/#/ A `load` of an aggregate that is only ever taken apart by `extract`s becomes a `load` of each
/#/ element (at the same place, so memory is read when it was); the copy to the frame goes.
fn split_loads(f: &Fun, rs: &Reps) => bool:
    let bad: buf<int> = new_buf(int, f.ni + 1)
    let base: buf<int> = new_buf(int, f.ni + 1)
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            for k in 0..f.nval(i):
                let v = f.val_at(i, k)
                if v >= 0:
                    let x = f.follow(v)
                    if f.op[x] == int(Op.Load) && f.rep[x] >= rp_first_agg() && !(f.op[i] == int(Op.Extract) && k == 0):
                        bad[x] = 1
            i = f.nx[i]
    for e in 0..f.ne:
        if f.eto[e] >= 0:
            for k in 0..f.eargn[e]:
                bad[f.follow(f.pool[f.eargs[e] + k])] = 1
    let any = false
    let el: buf<int> = new_buf(int, 16)
    let nel = 0
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let r = f.rep[i]
            if f.op[i] == int(Op.Load) && f.fwd[i] < 0 && r >= rp_first_agg() && bad[i] == 0:
                let n = rs.elems(r)
                let ok = n > 0
                for k in 0..n:
                    if rs.elem(r, k) >= rp_first_agg() || rs.elem(r, k) == int(Rp.Void):
                        ok = false
                if ok:
                    if nel + n > len(el):
                        el = buf_resize(el, (nel + n) * 2)
                    base[i] = nel + 1
                    f.cur = b
                    let p = f.follow(f.a[i])
                    for k in 0..n:
                        let a = p
                        let off = elem_off(rs, r, k)
                        if off != 0:
                            a = f.raw(int(Op.Field), int(Rp.Ptr), -1, p, -1, -1, off)
                            link_before(f, a, i)
                        let l = f.raw(int(Op.Load), rs.elem(r, k), -1, a, -1, -1, 0)
                        link_before(f, l, i)
                        el[nel + k] = l
                    nel = nel + n
                    any = true
            i = f.nx[i]
    if !any:
        return false
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let nxt = f.nx[i]
            if f.op[i] == int(Op.Extract) && f.fwd[i] < 0:
                let g = f.follow(f.a[i])
                if base[g] > 0:
                    let l = el[base[g] - 1 + f.aux[i]]
                    f.uses[l] = f.uses[l] + f.uses[i]
                    f.fwd[i] = l
                    unuse(f, i)
                    unlink(f, i)
            i = nxt
    return true

/#/ A `store` of an aggregate built by `insert`s of every element becomes a `store` of each element.
fn split_stores(f: &Fun, rs: &Reps) => bool:
    let any = false
    let vals: buf<int> = new_buf(int, 16)
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let nxt = f.nx[i]
            if f.op[i] == int(Op.Store) && f.fwd[i] < 0:
                let v = f.follow(f.b[i])
                let r = f.rep[v]
                if r >= rp_first_agg() && f.op[v] == int(Op.Insert):
                    let n = rs.elems(r)
                    if n > len(vals):
                        vals = buf_resize(vals, n * 2)
                    for k in 0..n:
                        vals[k] = -1
                    let g = v
                    while f.op[g] == int(Op.Insert):
                        let k = f.aux[g]
                        if k >= 0 && k < n && vals[k] < 0:
                            vals[k] = f.follow(f.b[g])
                        g = f.follow(f.a[g])
                    let ok = n > 0
                    for k in 0..n:
                        if vals[k] < 0 || rs.elem(r, k) >= rp_first_agg() || rs.elem(r, k) == int(Rp.Void) || f.rep[vals[k]] != rs.elem(r, k):
                            ok = false
                    if ok:
                        f.cur = b
                        let p = f.follow(f.a[i])
                        for k in 0..n:
                            let a = p
                            let off = elem_off(rs, r, k)
                            if off != 0:
                                a = f.raw(int(Op.Field), int(Rp.Ptr), -1, p, -1, -1, off)
                                link_before(f, a, i)
                            let st = f.raw(int(Op.Store), int(Rp.Void), -1, a, vals[k], -1, 0)
                            link_before(f, st, i)
                        delete_inst(f, i)
                        any = true
            i = nxt
    return any

/#/ ---- trap blocks ------------------------------------------------------------

/#/ Is block `b` only a call that does not return, ended by `unreachable` (a failed check)?
fn is_trap(f: &Fun, b: int) => bool:
    if b == 0 || f.npar[b] != 0:
        return false
    let c = f.bfirst[b]
    if c < 0 || f.op[c] != int(Op.CCall):
        return false
    let u = f.nx[c]
    return u >= 0 && f.op[u] == int(Op.Unreachable) && f.nx[u] < 0

fn same_trap(f: &Fun, b: int, c: int) => bool:
    let x = f.bfirst[b]
    let y = f.bfirst[c]
    if f.aux[x] != f.aux[y] || f.nval(x) != f.nval(y) || f.rep[x] != f.rep[y]:
        return false
    for k in 0..f.nval(x):
        if f.follow(f.val_at(x, k)) != f.follow(f.val_at(y, k)):
            return false
    return true

/#/ The failed checks of a function that make the same call are one block.
fn merge_traps(f: &Fun) => bool:
    let changed = false
    let canon: buf<int> = new_buf(int, f.nb + 1)
    let nc = 0
    for b in 1..f.nb:
        if is_trap(f, b):
            let into = -1
            for q in 0..nc:
                if into < 0 && same_trap(f, b, canon[q]):
                    into = canon[q]
            if into < 0:
                canon[nc] = b
                nc = nc + 1
            else:
                for e in 0..f.ne:
                    if f.eto[e] == b:
                        f.eto[e] = into
                        changed = true
    return changed

fn optimize(f: &Fun) => void:
    let rs = new_reps()
    optimize_rs(f, &rs, false)

/#/ The passes that only reshape the control flow, run until none of them has more to do: jumps
/#/ threaded, branches decided, traps shared, blocks that nothing reaches dropped, blocks joined.
fn cfg_cleanup(f: &Fun) => bool:
    let any = false
    let again = true
    let n = 0
    while again && n < 8:
        again = false
        if thread_jumps(f):
            again = true
        if fold_branches(f):
            again = true
        if merge_traps(f):
            again = true
        if drop_unreachable(f):
            again = true
            simplify_params(f)
        if merge_blocks(f):
            again = true
        if again:
            any = true
        n = n + 1
    return any

/#/ The passes that look at what the instructions compute.
fn value_passes(f: &Fun, rs: &Reps, split: bool) => bool:
    let changed = false
    if fold_extracts(f):
        changed = true
    if split && split_loads(f, rs):
        changed = true
    if split && split_stores(f, rs):
        changed = true
    if cse_branches(f):
        changed = true
    if hoist_invariants(f):
        changed = true
    if own_opt(f):
        changed = true
    if stack_alloc(f):
        changed = true
    if dead_code(f):
        changed = true
    if dead_params(f):
        changed = true
    return changed

fn optimize_rs(f: &Fun, rs: &Reps, split: bool) => void:
    fold_extracts(f)
    hoist_extracts(f)
    /#/ the control flow is put in order before each look at the values, so the passes that look at
    /#/ them are run again only when one of them changed something
    let round = 0
    let changed = true
    while changed && round < 3:
        cfg_cleanup(f)
        changed = value_passes(f, rs, split)
        round = round + 1
    if changed:
        cfg_cleanup(f)
        dead_code(f)
        dead_params(f)
    recount_uses(f)
