/#/ The optimizer: a short list of linear passes over one function, run once, in an order
/#/ chosen so that one run reaches the result.
/#/
/#/   cleanup:  branches on a constant become jumps, unreachable blocks go, a block with one
/#/             predecessor that jumps to it is merged into it, instructions and block
/#/             parameters nobody uses go
/#/   own-opt:  `alloc` that is only freed goes with its `free`; `clone x` whose original
/#/             is dropped right after, and used nowhere else, is `x` itself
/#/
/#/ Every pass keeps the use counts of the columns right, so the next one can rely on them.
/#/ Not here yet: effect summaries, inlining and the attributes that come from them.
use * in ssa

/#/ Takes `i` out of its block's list (a parameter is not in that list).
fn unlink(f: &Fun, i: int) => void:
    let b = f.blk[i]
    let p = f.pv[i]
    let n = f.nx[i]
    if p >= 0:
        f.nx[p] = n
    else:
        f.bfirst[b] = n
    if n >= 0:
        f.pv[n] = p
    else:
        f.blast[b] = p
    f.pv[i] = -1
    f.nx[i] = -1

/#/ One use fewer for every operand of `i`.
fn unuse(f: &Fun, i: int) => void:
    for k in 0..f.nval(i):
        let v = f.val_at(i, k)
        if v >= 0:
            let x = f.follow(v)
            f.uses[x] = f.uses[x] - 1

/#/ An edge that goes nowhere any more: its arguments are not used.
fn cut_edge(f: &Fun, e: int) => void:
    if f.eto[e] < 0:
        return
    for k in 0..f.eargn[e]:
        let x = f.follow(f.pool[f.eargs[e] + k])
        f.uses[x] = f.uses[x] - 1
    f.eargn[e] = 0
    f.eto[e] = -1

/#/ Deletes instruction `i`: out of its list, its operands unused, its edges cut.
fn delete_inst(f: &Fun, i: int) => void:
    unuse(f, i)
    let o = f.op[i]
    if o == int(Op.Br) || o == int(Op.CondBr) || o == int(Op.Switch):
        for q in 0..f.nsucc(f.blk[i]):
            cut_edge(f, f.succ_edge(f.blk[i], q))
    unlink(f, i)

/#/ ---- constant branches ---------------------------------------------------

/#/ `condbr` on a constant is a `br` to the edge taken; the other edge is cut.
fn fold_branches(f: &Fun) => bool:
    let changed = false
    for b in 0..f.nb:
        let t = f.blast[b]
        if t >= 0 && f.op[t] == int(Op.CondBr):
            let c = f.follow(f.a[t])
            if f.is_const(c):
                let keep = f.b[t]
                let gone = f.c[t]
                if f.cval(c) == 0:
                    keep = f.c[t]
                    gone = f.b[t]
                cut_edge(f, gone)
                f.uses[c] = f.uses[c] - 1
                f.op[t] = int(Op.Br)
                f.aux[t] = keep
                f.a[t] = -1
                f.b[t] = -1
                f.c[t] = -1
                changed = true
    return changed

/#/ ---- jumps to jumps ----------------------------------------------------

/#/ An edge into a block that only jumps on goes to where that block goes, with what that jump passes.
/#/ The forwarding block loses its predecessors and is dropped as unreachable.
fn thread_jumps(f: &Fun) => bool:
    let changed = false
    for e in 0..f.ne:
        let guard = 0
        while f.eto[e] > 0 && f.eargn[e] == 0 && guard < 8:
            guard = guard + 1
            let b = f.eto[e]
            let t = f.blast[b]
            if f.npar[b] != 0 || t < 0 || f.bfirst[b] != t || f.op[t] != int(Op.Br):
                break
            let e2 = f.aux[t]
            let to = f.eto[e2]
            if to < 0 || to == b || e2 == e:
                break
            let at = f.np
            for k in 0..f.eargn[e2]:
                let v = f.pool[f.eargs[e2] + k]
                f.pool_put(v)
                f.uses[f.follow(v)] = f.uses[f.follow(v)] + 1
            f.eargs[e] = at
            f.eargn[e] = f.eargn[e2]
            f.eto[e] = to
            changed = true
    return changed

/#/ ---- unreachable blocks --------------------------------------------------

/#/ Removes the blocks no path from the entry reaches, and renumbers the rest.
fn drop_unreachable(f: &Fun) => bool:
    let seen: buf<int> = new_buf(int, f.nb + 1)
    let stack: buf<int> = new_buf(int, f.nb + 1)
    let sp = 0
    seen[0] = 1
    stack[0] = 0
    sp = 1
    while sp > 0:
        sp = sp - 1
        let b = stack[sp]
        for q in 0..f.nsucc(b):
            let e = f.succ_edge(b, q)
            let to = f.eto[e]
            if to >= 0 && seen[to] == 0:
                seen[to] = 1
                stack[sp] = to
                sp = sp + 1
    let dead = 0
    for b in 0..f.nb:
        if seen[b] == 0:
            dead = dead + 1
    if dead == 0:
        return false
    for b in 0..f.nb:
        if seen[b] == 0:
            let i = f.blast[b]
            while i >= 0:
                let p = f.pv[i]
                delete_inst(f, i)
                i = p
            f.bfirst[b] = -1
            f.blast[b] = -1
    /#/ renumber
    let map: buf<int> = new_buf(int, f.nb + 1)
    let n = 0
    for b in 0..f.nb:
        map[b] = -1
        if seen[b] == 1:
            map[b] = n
            n = n + 1
    for b in 0..f.nb:
        if seen[b] == 1:
            let nb = map[b]
            f.bfirst[nb] = f.bfirst[b]
            f.blast[nb] = f.blast[b]
            f.pfirst[nb] = f.pfirst[b]
            f.plast[nb] = f.plast[b]
            f.npar[nb] = f.npar[b]
            let i = f.bfirst[nb]
            while i >= 0:
                f.blk[i] = nb
                i = f.nx[i]
            let p = f.pfirst[nb]
            while p >= 0:
                f.blk[p] = nb
                p = f.nx[p]
    f.set_blocks(n)
    for e in 0..f.ne:
        if f.eto[e] >= 0:
            f.eto[e] = map[f.eto[e]]
        if f.efrom[e] >= 0:
            f.efrom[e] = map[f.efrom[e]]
    return true

/#/ ---- merging blocks ------------------------------------------------------

/#/ How many live edges enter block `b`.
fn pred_count(f: &Fun, b: int) => int:
    let n = 0
    for e in 0..f.ne:
        if f.eto[e] == b:
            n = n + 1
    return n

/#/ The first live edge that enters block `b`.
fn pred_first(f: &Fun, b: int) => int:
    for e in 0..f.ne:
        if f.eto[e] == b:
            return e
    return -1

/#/ A block that only one block enters, by a plain jump, joins that block.
fn merge_blocks(f: &Fun) => bool:
    let changed = false
    /#/ how many edges enter each block, and the first: joining blocks changes neither for the others
    let pcn: buf<int> = new_buf(int, f.nb + 1)
    let pfe: buf<int> = new_buf(int, f.nb + 1)
    for e in 0..f.ne:
        let t = f.eto[e]
        if t >= 0:
            if pcn[t] == 0:
                pfe[t] = e
            pcn[t] = pcn[t] + 1
    /#/ the block a joined block went into; the edges that leave it are renamed at the end
    let into: buf<int> = new_buf(int, f.nb + 1)
    for b in 0..f.nb:
        into[b] = b
    for b in 1..f.nb:
        if f.bfirst[b] >= 0 && pcn[b] == 1:
            let e = pfe[b]
            let a = f.efrom[e]
            while a >= 0 && into[a] != a:
                a = into[a]
            let t = -1
            if a >= 0:
                t = f.blast[a]
            if a != b && a >= 0 && t >= 0 && f.op[t] == int(Op.Br) && f.aux[t] == e:
                /#/ the parameters are what the edge passes
                let p = f.pfirst[b]
                let k = 0
                while p >= 0:
                    let x = f.follow(f.pool[f.eargs[e] + k])
                    f.fwd[p] = x
                    f.uses[x] = f.uses[x] + f.uses[p] - 1
                    p = f.nx[p]
                    k = k + 1
                f.pfirst[b] = -1
                f.plast[b] = -1
                f.npar[b] = 0
                /#/ the jump goes, the block's instructions follow the rest of `a`
                f.eargn[e] = 0
                f.eto[e] = -1
                unlink(f, t)
                let i = f.bfirst[b]
                while i >= 0:
                    f.blk[i] = a
                    i = f.nx[i]
                if f.bfirst[b] >= 0:
                    let l = f.blast[a]
                    if l >= 0:
                        f.nx[l] = f.bfirst[b]
                    else:
                        f.bfirst[a] = f.bfirst[b]
                    f.pv[f.bfirst[b]] = l
                    f.blast[a] = f.blast[b]
                f.bfirst[b] = -1
                f.blast[b] = -1
                into[b] = a
                changed = true
    if changed:
        for q in 0..f.ne:
            let x = f.efrom[q]
            while x >= 0 && into[x] != x:
                x = into[x]
            f.efrom[q] = x
    return changed

/#/ ---- dead code -----------------------------------------------------------

/#/ Can nobody tell that `i` was removed, when its value is not used?
fn removable(f: &Fun, i: int) => bool:
    let o = f.op[i]
    if f.tab.has(o, f_term()) || f.tab.has(o, f_writes()) || f.tab.has(o, f_consumes()):
        return false
    if o == int(Op.Param) || o == int(Op.Call) || o == int(Op.CCall) || o == int(Op.CallI) || o == int(Op.Clone) || o == int(Op.VLoop):
        return false
    return true

/#/ Removes the instructions whose value nobody uses, from the end of each block backwards.
/#/ The use counts, from the instructions and edges that are there.
fn recount_uses(f: &Fun) => void:
    for i in 0..f.ni:
        f.uses[i] = 0
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            for k in 0..f.nval(i):
                let v = f.val_at(i, k)
                if v >= 0:
                    let x = f.follow(v)
                    f.uses[x] = f.uses[x] + 1
            i = f.nx[i]
    for e in 0..f.ne:
        if f.eto[e] >= 0:
            for k in 0..f.eargn[e]:
                let x = f.follow(f.pool[f.eargs[e] + k])
                f.uses[x] = f.uses[x] + 1

fn dead_code(f: &Fun) => bool:
    let changed = false
    recount_uses(f)
    for b in 0..f.nb:
        let i = f.blast[b]
        while i >= 0:
            let p = f.pv[i]
            if f.uses[i] == 0 && f.fwd[i] < 0 && removable(f, i):
                delete_inst(f, i)
                changed = true
            i = p
    return changed

/#/ Removes the parameters of the blocks (not the entry's) that nobody uses, and the
/#/ arguments the edges pass to them.
fn dead_params(f: &Fun) => bool:
    let changed = false
    for b in 1..f.nb:
        let n = f.npar[b]
        let keep: buf<int> = new_buf(int, n + 1)
        let any = false
        let p = f.pfirst[b]
        let k = 0
        while p >= 0:
            keep[k] = 1
            /#/ nobody uses it, or only the jump around the loop hands it back to itself
            let own = 0
            for e in 0..f.ne:
                if f.eto[e] == b && k < f.eargn[e] && f.follow(f.pool[f.eargs[e] + k]) == p:
                    own = own + 1
            if f.uses[p] == own:
                keep[k] = 0
                any = true
            p = f.nx[p]
            k = k + 1
        if any:
            for e in 0..f.ne:
                if f.eto[e] == b:
                    let m = f.eargn[e]
                    let start = f.np
                    let out = 0
                    for j in 0..m:
                        if j < n && keep[j] == 0:
                            let x = f.follow(f.pool[f.eargs[e] + j])
                            f.uses[x] = f.uses[x] - 1
                        else:
                            f.pool_put(f.pool[f.eargs[e] + j])
                            out = out + 1
                    f.eargs[e] = start
                    f.eargn[e] = out
            let first = -1
            let last = -1
            let q = f.pfirst[b]
            let cnt = 0
            while q >= 0:
                let nxt = f.nx[q]
                if keep[f.aux[q]] == 1:
                    f.pv[q] = last
                    f.nx[q] = -1
                    if last >= 0:
                        f.nx[last] = q
                    else:
                        first = q
                    last = q
                    cnt = cnt + 1
                q = nxt
            /#/ parameter numbers are their position
            let r = first
            let pos = 0
            while r >= 0:
                f.aux[r] = pos
                pos = pos + 1
                r = f.nx[r]
            f.pfirst[b] = first
            f.plast[b] = last
            f.npar[b] = cnt
            changed = true
    return changed

/#/ ---- ownership -----------------------------------------------------------

/#/ An `alloc` whose only use is the `free` that follows is no allocation at all.
/#/ `y = clone x; ...; drop x` with no other use of `x` makes `y` be `x`: the copy is never made.
fn own_opt(f: &Fun) => bool:
    let changed = false
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let nxt = f.nx[i]
            let o = f.op[i]
            if o == int(Op.Alloc) && f.uses[i] == 1:
                let j = nxt
                while j >= 0 && !(f.op[j] == int(Op.Free) && f.follow(f.a[j]) == i):
                    j = f.nx[j]
                if j >= 0:
                    if nxt == j:
                        nxt = f.nx[j]
                    delete_inst(f, j)
                    delete_inst(f, i)
                    changed = true
            elif o == int(Op.Clone) && f.fwd[i] < 0:
                let x = f.follow(f.a[i])
                if f.uses[x] == 2:
                    let j = f.nx[i]
                    while j >= 0 && !(f.op[j] == int(Op.Drop) && f.follow(f.a[j]) == x):
                        j = f.nx[j]
                    if j >= 0:
                        if nxt == j:
                            nxt = f.nx[j]
                        delete_inst(f, j)
                        f.uses[x] = f.uses[x] + f.uses[i]
                        f.fwd[i] = x
                        unlink(f, i)
                        f.uses[x] = f.uses[x] - 1
                        changed = true
            i = nxt
    return changed

/#/ An `alloc` that is freed in its own block and used only by loads and stores through it (and
/#/ field and index addresses of it) in between does not outlive the block: it becomes a `slot`
/#/ and the `free` goes. A pointer that is passed, stored, returned or used elsewhere keeps it on the heap.
fn stack_alloc(f: &Fun) => bool:
    let ipos: buf<int> = new_buf(int, f.ni + 1)
    let free_of: buf<int> = new_buf(int, f.ni + 1)
    let base: buf<int> = new_buf(int, f.ni + 1)
    let bad: buf<int> = new_buf(int, f.ni + 1)
    let blk_of: buf<int> = new_buf(int, f.ni + 1)
    let any = false
    for i in 0..f.ni:
        free_of[i] = -1
        base[i] = -1
    for b in 0..f.nb:
        let i = f.bfirst[b]
        let n = 0
        while i >= 0:
            ipos[i] = n
            blk_of[i] = b
            n = n + 1
            i = f.nx[i]
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            if f.op[i] == int(Op.Alloc) && f.fwd[i] < 0 && f.ty[i] > 0 && f.ty[i] <= 4096:
                let j = f.nx[i]
                while j >= 0 && !(f.op[j] == int(Op.Free) && f.follow(f.a[j]) == i):
                    j = f.nx[j]
                if j >= 0:
                    free_of[i] = j
                    base[i] = i
                    any = true
            i = f.nx[i]
    if !any:
        return false
    /#/ addresses derived from a candidate
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            if (f.op[i] == int(Op.Field) || f.op[i] == int(Op.Index)) && base[f.follow(f.a[i])] >= 0:
                base[i] = base[f.follow(f.a[i])]
            i = f.nx[i]
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let o = f.op[i]
            if !(o == int(Op.Alloc) && free_of[i] >= 0):
                for q in 0..f.nval(i):
                    let v = f.val_at(i, q)
                    if v >= 0:
                        let x = f.follow(v)
                        let c = base[x]
                        if c >= 0:
                            let ok = false
                            if blk_of[i] == blk_of[c] && ipos[i] > ipos[c] && ipos[i] <= ipos[free_of[c]] && q == 0:
                                if o == int(Op.Load) || o == int(Op.Store) || o == int(Op.Field) || o == int(Op.Index):
                                    ok = true
                                if o == int(Op.Free) && i == free_of[c] && x == c:
                                    ok = true
                            if !ok:
                                bad[c] = 1
            i = f.nx[i]
    for e in 0..f.ne:
        if f.eto[e] >= 0:
            for k in 0..f.eargn[e]:
                let c = base[f.follow(f.pool[f.eargs[e] + k])]
                if c >= 0:
                    bad[c] = 1
    let changed = false
    for c in 0..f.ni:
        if free_of[c] >= 0 && bad[c] == 0 && f.op[c] == int(Op.Alloc):
            delete_inst(f, free_of[c])
            f.op[c] = int(Op.Slot)
            changed = true
    return changed

/#/ Runs the passes: cleanup, own-opt, cleanup again for what that exposed.
/#/ Moves every `extract` to just after the aggregate it reads, and keeps one of those that read
/#/ the same element: a field of a value defined before a loop is read once, not each time round.
fn hoist_extracts(f: &Fun) => bool:
    let changed = false
    let seen = 0
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let nxt = f.nx[i]
            if f.op[i] == int(Op.Extract) && f.fwd[i] < 0:
                seen = seen + 1
                let g = f.follow(f.a[i])
                let db = f.blk[g]
                if db >= 0 && db != b:
                    unlink(f, i)
                    f.blk[i] = db
                    if f.op[g] == int(Op.Param):
                        let first = f.bfirst[db]
                        f.pv[i] = -1
                        f.nx[i] = first
                        if first >= 0:
                            f.pv[first] = i
                        else:
                            f.blast[db] = i
                        f.bfirst[db] = i
                    else:
                        let n = f.nx[g]
                        f.pv[i] = g
                        f.nx[i] = n
                        f.nx[g] = i
                        if n >= 0:
                            f.pv[n] = i
                        else:
                            f.blast[db] = i
                    changed = true
            i = nxt
    if seen < 2:
        return changed
    /#/ the same element of the same aggregate: all of them are in one block now, the first dominates
    let cap = 16
    while cap < seen * 2:
        cap = cap * 2
    let tab: buf<int> = new_buf(int, cap)
    for q in 0..cap:
        tab[q] = -1
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let nxt = f.nx[i]
            if f.op[i] == int(Op.Extract) && f.fwd[i] < 0:
                let g = f.follow(f.a[i])
                let h = ((g * 31 + f.aux[i]) * 31 + f.rep[i]) % cap
                if h < 0:
                    h = h + cap
                let found = -1
                while tab[h] >= 0 && found < 0:
                    let e = tab[h]
                    if f.follow(f.a[e]) == g && f.aux[e] == f.aux[i] && f.rep[e] == f.rep[i]:
                        found = e
                    else:
                        h = (h + 1) % cap
                if found >= 0:
                    f.uses[found] = f.uses[found] + f.uses[i]
                    f.fwd[i] = found
                    unuse(f, i)
                    unlink(f, i)
                    changed = true
                else:
                    tab[h] = i
            i = nxt
    return changed

/#/ ---- common subexpressions and known conditions ------------------------------

/#/ Does the value of `i` depend on its operands alone (no memory, no call)?
fn pure_op(o: int) => bool:
    if o >= int(Op.Add) && o <= int(Op.FNeg) && o != int(Op.FRem):
        return true
    if o >= int(Op.Cmp) && o <= int(Op.Insert):
        return true
    return o == int(Op.Field) || o == int(Op.Index)

fn commutes(o: int) => bool:
    return o == int(Op.Add) || o == int(Op.Mul) || o == int(Op.And) || o == int(Op.Or) || o == int(Op.Xor) || o == int(Op.FAdd) || o == int(Op.FMul)

/#/ The operands of pure instruction `i` as values, the first two in a fixed order when the
/#/ operation commutes. Returns them in `k[0..3]`.
fn operands(f: &Fun, i: int, k: &buf<int>) => void:
    let x = -1
    let y = -1
    let z = -1
    if f.a[i] >= 0:
        x = f.follow(f.a[i])
    if f.b[i] >= 0:
        y = f.follow(f.b[i])
    if f.c[i] >= 0:
        z = f.follow(f.c[i])
    if commutes(f.op[i]) && x > y:
        let t = x
        x = y
        y = t
    k[0] = x
    k[1] = y
    k[2] = z

/#/ The blocks reachable from the entry in reverse post-order (`rpo`, the count returned) and their
/#/ immediate dominators (`idom`, -1 for the unreachable).
fn dominators(f: &Fun, rpo: &buf<int>, idom: &buf<int>, pc: &buf<int>, pl: &buf<int>) => int:
    let nb = f.nb
    let visited: buf<int> = new_buf(int, nb + 1)
    let ci: buf<int> = new_buf(int, nb + 1)
    let stack: buf<int> = new_buf(int, nb + 1)
    let post: buf<int> = new_buf(int, nb + 1)
    let sp = 1
    let np = 0
    stack[0] = 0
    visited[0] = 1
    while sp > 0:
        let b = stack[sp - 1]
        if f.terminated(b) && ci[b] < f.nsucc(b):
            /#/ the last successor first, so that the first one comes first in reverse post-order
            let t = f.eto[f.succ_edge(b, f.nsucc(b) - 1 - ci[b])]
            ci[b] = ci[b] + 1
            if t >= 0 && t < nb && visited[t] == 0:
                visited[t] = 1
                stack[sp] = t
                sp = sp + 1
        else:
            post[np] = b
            np = np + 1
            sp = sp - 1
    let num: buf<int> = new_buf(int, nb + 1)
    for k in 0..np:
        rpo[k] = post[np - 1 - k]
        num[rpo[k]] = k
    for b in 0..nb:
        idom[b] = -1
    idom[0] = 0
    /#/ the predecessors: those of block b are pl[pc[b] .. pc[b + 1]]
    for k in 0..np:
        let b = rpo[k]
        for s in 0..f.nsucc(b):
            let t = f.eto[f.succ_edge(b, s)]
            if t >= 0:
                pc[t + 1] = pc[t + 1] + 1
    for b in 0..nb:
        pc[b + 1] = pc[b + 1] + pc[b]
    let fill: buf<int> = new_buf(int, nb + 1)
    for k in 0..np:
        let b = rpo[k]
        for s in 0..f.nsucc(b):
            let t = f.eto[f.succ_edge(b, s)]
            if t >= 0:
                pl[pc[t] + fill[t]] = b
                fill[t] = fill[t] + 1
    let changed = true
    while changed:
        changed = false
        for k in 1..np:
            let b = rpo[k]
            let nd = -1
            for q in pc[b]..pc[b + 1]:
                let pb = pl[q]
                if idom[pb] >= 0:
                    if nd < 0:
                        nd = pb
                    else:
                        let x = pb
                        let y = nd
                        while x != y:
                            while num[x] > num[y]:
                                x = idom[x]
                            while num[y] > num[x]:
                                y = idom[y]
                        nd = x
            if nd != idom[b]:
                idom[b] = nd
                changed = true
    return np

/#/ Replaces instruction `i` by the value `v` everywhere.
fn replace_inst(f: &Fun, i: int, v: int) => void:
    f.uses[v] = f.uses[v] + f.uses[i]
    f.fwd[i] = v
    unuse(f, i)
    unlink(f, i)

/#/ Is the integer `v` never negative? A constant, or a loop counter: a block parameter that starts at a
/#/ small constant and only grows by small constants (it would take more than 2^50 steps to wrap).
fn nonneg(f: &Fun, v0: int) => bool:
    let v = f.follow(v0)
    if f.is_const(v):
        return f.cval(v) >= 0
    if f.op[v] != int(Op.Param) || f.blk[v] == 0 || f.rep[v] != int(Rp.I64):
        return false
    let b = f.blk[v]
    let k = 0
    let q = f.pfirst[b]
    while q >= 0 && q != v:
        q = f.nx[q]
        k = k + 1
    let seen = 0
    for e in 0..f.ne:
        if f.eto[e] == b:
            seen = seen + 1
            if k >= f.eargn[e]:
                return false
            let a = f.follow(f.pool[f.eargs[e] + k])
            if f.is_const(a):
                if f.cval(a) < 0 || f.cval(a) > 4294967296:
                    return false
            elif f.op[a] == int(Op.Add) && f.follow(f.a[a]) == v && f.is_const(f.follow(f.b[a])) && f.cval(f.follow(f.b[a])) >= 0 && f.cval(f.follow(f.b[a])) <= 256:
                seen = seen
            else:
                return false
    return seen > 0

/#/ Does the taken edge of `slt x, K'` settle `ult x, K`? Then x < K' <= K, and x is not negative.
fn implies_ult(f: &Fun, c2: int, c: int) => bool:
    if f.op[c] != int(Op.Cmp) || f.op[c2] != int(Op.Cmp):
        return false
    if f.aux[c] != int(Pr.ULt) || f.aux[c2] != int(Pr.SLt):
        return false
    let x = f.follow(f.a[c])
    let k = f.follow(f.b[c])
    let x2 = f.follow(f.a[c2])
    let k2 = f.follow(f.b[c2])
    if x != x2 || !f.is_const(k) || !f.is_const(k2) || f.rep[x] != int(Rp.I64):
        return false
    return f.cval(k2) <= f.cval(k) && nonneg(f, x)

/#/ A pure instruction that an instruction with the same operation and operands in a dominating
/#/ block already computed is that one. Then a branch on a condition that a dominating branch has
/#/ decided (the block is entered by one edge of it) goes one way only: the second bounds check
/#/ of `a[i]` and the checks the loop condition implies.
fn cse_branches(f: &Fun) => bool:
    if f.nb < 2:
        return false
    let nb = f.nb
    let rpo: buf<int> = new_buf(int, nb + 1)
    let idom: buf<int> = new_buf(int, nb + 1)
    let pc: buf<int> = new_buf(int, nb + 2)
    let pl: buf<int> = new_buf(int, f.ne + 1)
    let np = dominators(f, &rpo, &idom, &pc, &pl)
    let changed = false
    /#/ the dominator tree, and the single predecessor of each block (-1: none or several)
    let head: buf<int> = new_buf(int, nb + 1)
    let sib: buf<int> = new_buf(int, nb + 1)
    let npred: buf<int> = new_buf(int, nb + 1)
    let pred1: buf<int> = new_buf(int, nb + 1)
    for b in 0..nb:
        head[b] = -1
        pred1[b] = -1
    for k in 0..np:
        let b = rpo[k]
        if b != 0:
            sib[b] = head[idom[b]]
            head[idom[b]] = b
        for s in 0..f.nsucc(b):
            let t = f.eto[f.succ_edge(b, s)]
            if t >= 0:
                npred[t] = npred[t] + 1
                pred1[t] = b
    let cap = 64
    while cap < f.ni * 2:
        cap = cap * 2
    let tab: buf<int> = new_buf(int, cap)
    for q in 0..cap:
        tab[q] = -1
    let log: buf<int> = new_buf(int, f.ni + 1)
    let nlog = 0
    let mark: buf<int> = new_buf(int, nb + 1)
    let entered: buf<int> = new_buf(int, nb + 1)
    let stack: buf<int> = new_buf(int, nb + 1)
    let ka: buf<int> = new_buf(int, 4)
    let kb: buf<int> = new_buf(int, 4)
    let sp = 1
    stack[0] = 0
    while sp > 0:
        let b = stack[sp - 1]
        if entered[b] == 1:
            while nlog > mark[b]:
                nlog = nlog - 1
                tab[log[nlog]] = -1
            sp = sp - 1
        else:
            entered[b] = 1
            mark[b] = nlog
            let i = f.bfirst[b]
            while i >= 0:
                let nxt = f.nx[i]
                if pure_op(f.op[i]) && f.fwd[i] < 0:
                    operands(f, i, &ka)
                    let h = hmix(hmix(hmix(hmix(hmix(f.op[i], f.rep[i]), ka[0]), ka[1]), ka[2]), f.aux[i]) % cap
                    if h < 0:
                        h = h + cap
                    let found = -1
                    while tab[h] >= 0 && found < 0:
                        let e = tab[h]
                        if f.op[e] == f.op[i] && f.rep[e] == f.rep[i] && f.aux[e] == f.aux[i]:
                            operands(f, e, &kb)
                            if kb[0] == ka[0] && kb[1] == ka[1] && kb[2] == ka[2]:
                                found = e
                        if found < 0:
                            h = (h + 1) % cap
                    if found >= 0:
                        replace_inst(f, i, found)
                        changed = true
                    else:
                        tab[h] = i
                        log[nlog] = h
                        nlog = nlog + 1
                i = nxt
            /#/ a decided condition: walk up the blocks that are entered by one edge of a branch
            let t = f.blast[b]
            if t >= 0 && f.op[t] == int(Op.CondBr):
                let c = f.follow(f.a[t])
                if !f.is_const(c):
                    let x = b
                    let known = -1
                    while known < 0:
                        if npred[x] == 1:
                            let pb = pred1[x]
                            let pt = f.blast[pb]
                            if pt >= 0 && f.op[pt] == int(Op.CondBr) && f.follow(f.a[pt]) == c:
                                let et = f.eto[f.b[pt]]
                                let ef = f.eto[f.c[pt]]
                                if et == x && ef != x:
                                    known = 1
                                elif ef == x && et != x:
                                    known = 0
                            elif pt >= 0 && f.op[pt] == int(Op.CondBr) && implies_ult(f, f.follow(f.a[pt]), c):
                                if f.eto[f.b[pt]] == x && f.eto[f.c[pt]] != x:
                                    known = 1
                        if known < 0:
                            if x == 0 || idom[x] == x || idom[x] < 0:
                                break
                            x = idom[x]
                    if known >= 0:
                        let kc = f.cint(int(Rp.I8), known)
                        f.uses[c] = f.uses[c] - 1
                        f.uses[kc] = f.uses[kc] + 1
                        f.a[t] = kc
                        changed = true
            let ch = head[b]
            while ch >= 0:
                stack[sp] = ch
                sp = sp + 1
                ch = sib[ch]
    return changed

/#/ ---- value ranges and bounds checks --------------------------------------

/#/ Integer ranges are kept as `[lo, hi]` of 64-bit values; a bound of `rg_inf` or more in size is "no bound",
/#/ and a range with `lo > hi` is empty (not computed yet). Bounds that are kept are below 2^62, so adding two
/#/ cannot wrap.
let rg_inf = 4611686018427387904

class RgCtx:
    lo: buf<int>
    hi: buf<int>
    idom: buf<int>
    fcmp: buf<int>
    fpol: buf<int>
    need: buf<int>
    rl: int
    rh: int

fn rg_clamp(v: int) => int:
    if v >= rg_inf:
        return rg_inf
    if v <= 0 - rg_inf:
        return 0 - rg_inf
    return v

/#/ The predicate `p` seen from the other operand.
fn rg_mirror(p: int) => int:
    if p == int(Pr.SLt):
        return int(Pr.SGt)
    if p == int(Pr.SLe):
        return int(Pr.SGe)
    if p == int(Pr.SGt):
        return int(Pr.SLt)
    if p == int(Pr.SGe):
        return int(Pr.SLe)
    if p == int(Pr.ULt):
        return int(Pr.UGt)
    if p == int(Pr.ULe):
        return int(Pr.UGe)
    if p == int(Pr.UGt):
        return int(Pr.ULt)
    if p == int(Pr.UGe):
        return int(Pr.ULe)
    return p

/#/ The predicate that holds when `p` does not.
fn rg_negate(p: int) => int:
    if p == int(Pr.SLt):
        return int(Pr.SGe)
    if p == int(Pr.SLe):
        return int(Pr.SGt)
    if p == int(Pr.SGt):
        return int(Pr.SLe)
    if p == int(Pr.SGe):
        return int(Pr.SLt)
    if p == int(Pr.Eq):
        return int(Pr.Ne)
    if p == int(Pr.Ne):
        return int(Pr.Eq)
    if p == int(Pr.ULt):
        return int(Pr.UGe)
    if p == int(Pr.UGe):
        return int(Pr.ULt)
    if p == int(Pr.ULe):
        return int(Pr.UGt)
    if p == int(Pr.UGt):
        return int(Pr.ULe)
    return -1

/#/ The range of the whole value `v` (what it is wherever it is defined), without any branch's help.
fn rg_global(c: &RgCtx, f: &Fun, v: int) => void:
    if f.is_const(v):
        let k = rg_clamp(f.cval(v))
        c.rl = k
        c.rh = k
    elif f.rep[v] != int(Rp.I64):
        c.rl = 0 - rg_inf
        c.rh = rg_inf
    else:
        c.rl = c.lo[v]
        c.rh = c.hi[v]

/#/ The range of `v0` in block `b`: its own range, narrowed by the branches that decide the way into `b` or into a
/#/ block that dominates it.
fn rg_at(c: &RgCtx, f: &Fun, v0: int, b: int) => void:
    let v = f.follow(v0)
    rg_global(c, f, v)
    let lo = c.rl
    let hi = c.rh
    if f.is_const(v) || f.rep[v] != int(Rp.I64):
        return
    let x = b
    while x >= 0:
        let fc = c.fcmp[x]
        if fc >= 0:
            let a = f.follow(f.a[fc])
            let bb = f.follow(f.b[fc])
            if (a == v || bb == v) && a != bb:
                let pr = f.aux[fc]
                if c.fpol[x] == 0:
                    pr = rg_negate(pr)
                let other = bb
                if bb == v:
                    other = a
                    pr = rg_mirror(pr)
                if pr >= 0:
                    rg_global(c, f, other)
                    let ol = c.rl
                    let oh = c.rh
                    if pr == int(Pr.SLt) && oh < rg_inf:
                        hi = rg_min(hi, oh - 1)
                    elif pr == int(Pr.SLe) && oh < rg_inf:
                        hi = rg_min(hi, oh)
                    elif pr == int(Pr.SGt) && ol > 0 - rg_inf:
                        lo = rg_max(lo, ol + 1)
                    elif pr == int(Pr.SGe) && ol > 0 - rg_inf:
                        lo = rg_max(lo, ol)
                    elif pr == int(Pr.Eq):
                        lo = rg_max(lo, ol)
                        hi = rg_min(hi, oh)
                    elif (pr == int(Pr.ULt) || pr == int(Pr.ULe)) && ol >= 0 && oh < rg_inf:
                        lo = rg_max(lo, 0)
                        if pr == int(Pr.ULt):
                            hi = rg_min(hi, oh - 1)
                        else:
                            hi = rg_min(hi, oh)
        if x == 0 || c.idom[x] == x || c.idom[x] < 0:
            break
        x = c.idom[x]
    c.rl = lo
    c.rh = hi

fn rg_min(a: int, b: int) => int:
    if a < b:
        return a
    return b

fn rg_max(a: int, b: int) => int:
    if a > b:
        return a
    return b

/#/ The range of instruction `i` from the ranges of its operands in its block, left in `c.rl`, `c.rh`.
fn rg_eval(c: &RgCtx, f: &Fun, i: int) => void:
    let o = f.op[i]
    let b = f.blk[i]
    let top = rg_inf
    c.rl = 0 - top
    c.rh = top
    if f.rep[i] != int(Rp.I64):
        return
    if o == int(Op.Add) || o == int(Op.Sub) || o == int(Op.Mul):
        rg_at(c, f, f.a[i], b)
        let al = c.rl
        let ah = c.rh
        rg_at(c, f, f.b[i], b)
        let bl = c.rl
        let bh = c.rh
        if al > ah || bl > bh:
            c.rl = top
            c.rh = 0 - top
            return
        c.rl = 0 - top
        c.rh = top
        if o == int(Op.Add):
            if al > 0 - top && bl > 0 - top:
                c.rl = rg_clamp(al + bl)
            if ah < top && bh < top:
                c.rh = rg_clamp(ah + bh)
        elif o == int(Op.Sub):
            if al > 0 - top && bh < top:
                c.rl = rg_clamp(al - bh)
            if ah < top && bl > 0 - top:
                c.rh = rg_clamp(ah - bl)
        else:
            let lim = 2147483648
            if al > 0 - lim && ah < lim && bl > 0 - lim && bh < lim:
                let p1 = al * bl
                let p2 = al * bh
                let p3 = ah * bl
                let p4 = ah * bh
                c.rl = rg_min(rg_min(p1, p2), rg_min(p3, p4))
                c.rh = rg_max(rg_max(p1, p2), rg_max(p3, p4))
    elif o == int(Op.SRem) || o == int(Op.SDiv) || o == int(Op.And) || o == int(Op.AShr) || o == int(Op.LShr) || o == int(Op.Shl):
        rg_at(c, f, f.a[i], b)
        let al = c.rl
        let ah = c.rh
        let kb = f.follow(f.b[i])
        c.rl = 0 - top
        c.rh = top
        if al > ah:
            c.rl = top
            c.rh = 0 - top
            return
        if f.is_const(kb):
            let k = f.cval(kb)
            if o == int(Op.SRem) && k > 0:
                c.rl = 1 - k
                c.rh = k - 1
                if al >= 0:
                    c.rl = 0
                    if ah < k - 1:
                        c.rh = ah
            elif o == int(Op.SDiv) && k > 0:
                if al > 0 - top:
                    c.rl = al // k
                if ah < top:
                    c.rh = ah // k
            elif o == int(Op.And) && k >= 0:
                c.rl = 0
                c.rh = k
                if al >= 0 && ah < k:
                    c.rh = ah
            elif o == int(Op.AShr) && k >= 0 && k < 63:
                if al > 0 - top:
                    c.rl = al >> k
                if ah < top:
                    c.rh = ah >> k
            elif o == int(Op.LShr) && k > 0 && k < 63:
                c.rl = 0
                c.rh = 9223372036854775807 >> (k - 1)
                if al >= 0 && ah < top:
                    c.rh = ah >> k
                if c.rh >= top:
                    c.rh = top
            elif o == int(Op.Shl) && k >= 0 && k < 31 && al > 0 - 2147483648 && ah < 2147483648:
                c.rl = al << k
                c.rh = ah << k
    elif o == int(Op.ZExt) || o == int(Op.SExt):
        let r = f.rep[f.follow(f.a[i])]
        let bits = rp_bits(r)
        if bits > 0 && bits < 64:
            if o == int(Op.ZExt):
                c.rl = 0
                c.rh = (1 << bits) - 1
            else:
                c.rl = 0 - (1 << (bits - 1))
                c.rh = (1 << (bits - 1)) - 1

/#/ One round over the values in reverse post-order; `mode` 0 joins the new range into the old one, 1 widens
/#/ (a bound that moved goes to no bound), 2 takes the new range (narrowing, from a state that is already sound).
/#/ Returns whether a range changed.
fn rg_round(c: &RgCtx, f: &Fun, rpo: &buf<int>, np: int, inh: &buf<int>, innext: &buf<int>, mode: int) => bool:
    let changed = false
    for r in 0..np:
        let b = rpo[r]
        let p = f.pfirst[b]
        let k = 0
        while p >= 0:
            if f.rep[p] == int(Rp.I64) && f.fwd[p] < 0 && b != 0 && c.need[p] == 1:
                let nl = rg_inf
                let nh = 0 - rg_inf
                let e = inh[b]
                while e >= 0:
                    if k < f.eargn[e]:
                        rg_at(c, f, f.pool[f.eargs[e] + k], f.efrom[e])
                        nl = rg_min(nl, c.rl)
                        nh = rg_max(nh, c.rh)
                    else:
                        nl = 0 - rg_inf
                        nh = rg_inf
                    e = innext[e]
                if rg_set(c, p, nl, nh, mode):
                    changed = true
            p = f.nx[p]
            k = k + 1
        let i = f.bfirst[b]
        while i >= 0:
            if f.fwd[i] < 0 && f.rep[i] == int(Rp.I64) && c.need[i] == 1 && !f.is_const(i):
                rg_eval(c, f, i)
                if rg_set(c, i, c.rl, c.rh, mode):
                    changed = true
            i = f.nx[i]
    return changed

/#/ Stores a new range for `v` by the rules of `rg_round`; whether it differs from the old one.
fn rg_set(c: &RgCtx, v: int, nl: int, nh: int, mode: int) => bool:
    let ol = c.lo[v]
    let oh = c.hi[v]
    let l = nl
    let h = nh
    if mode == 0:
        if ol <= oh:
            l = rg_min(ol, nl)
            h = rg_max(oh, nh)
    elif mode == 1:
        if ol <= oh:
            if nl < ol:
                l = 0 - rg_inf
            else:
                l = ol
            if nh > oh:
                h = rg_inf
            else:
                h = oh
    if nl > nh:
        l = ol
        h = oh
    if l == ol && h == oh:
        return false
    c.lo[v] = l
    c.hi[v] = h
    return true

/#/ A bounds check `ult x, len` that the ranges (or the loop condition `x < len` on the way in) show to hold is
/#/ not made: its branch goes the one way. Ranges are of the loop counters and what is computed from them with
/#/ sums, products by constants and the like, narrowed by the branches that decide the way into a block.
fn range_checks(f: &Fun) => bool:
    if f.nb < 2 || f.ni > 6000:
        return false
    /#/ a check against a length that is not a constant can only be settled by a loop condition against the
    /#/ same value
    let upper: buf<int> = new_buf(int, f.ni + 1)
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            if f.op[i] == int(Op.Cmp) && (f.aux[i] == int(Pr.SLt) || f.aux[i] == int(Pr.SLe)) && f.fwd[i] < 0:
                upper[f.follow(f.b[i])] = 1
            i = f.nx[i]
    let cands = 0
    for b in 0..f.nb:
        let t = f.blast[b]
        if t >= 0 && f.op[t] == int(Op.CondBr):
            let cm = f.follow(f.a[t])
            if f.op[cm] == int(Op.Cmp) && f.aux[cm] == int(Pr.ULt) && !f.is_const(cm):
                let lv0 = f.follow(f.b[cm])
                if f.is_const(lv0) || upper[lv0] == 1:
                    cands = cands + 1
    if cands == 0:
        return false
    /#/ without a back edge there is no counter whose range could settle a check
    let looped = false
    for e in 0..f.ne:
        if f.efrom[e] >= 0 && f.eto[e] >= 0 && f.eto[e] <= f.efrom[e]:
            looped = true
    if !looped:
        return false
    let nb = f.nb
    let rpo: buf<int> = new_buf(int, nb + 1)
    let idom: buf<int> = new_buf(int, nb + 1)
    let pc: buf<int> = new_buf(int, nb + 2)
    let pl: buf<int> = new_buf(int, f.ne + 1)
    let np = dominators(f, &rpo, &idom, &pc, &pl)
    let inh: buf<int> = new_buf(int, nb + 1)
    let innext: buf<int> = new_buf(int, f.ne + 1)
    let nin: buf<int> = new_buf(int, nb + 1)
    let sedge: buf<int> = new_buf(int, nb + 1)
    for b in 0..nb:
        inh[b] = -1
        sedge[b] = -1
    for e in 0..f.ne:
        let from = f.efrom[e]
        let to = f.eto[e]
        if from >= 0 && to >= 0 && from < nb && to < nb && idom[from] >= 0:
            innext[e] = inh[to]
            inh[to] = e
            /#/ an edge from a block the target dominates (a back edge) does not count: the way in from
            /#/ outside decides what holds in the target and the blocks it dominates (a value does not change)
            let y = from
            let inside = false
            while !inside:
                if y == to:
                    inside = true
                elif y == 0 || idom[y] == y || idom[y] < 0:
                    break
                else:
                    y = idom[y]
            if !inside:
                nin[to] = nin[to] + 1
                sedge[to] = e
    let c = RgCtx { lo: new_buf(int, f.ni + 1), hi: new_buf(int, f.ni + 1), idom: idom, fcmp: new_buf(int, nb + 1), fpol: new_buf(int, nb + 1), need: new_buf(int, f.ni + 1), rl: 0, rh: 0 }
    for v in 0..f.ni:
        c.lo[v] = rg_inf
        c.hi[v] = 0 - rg_inf
    let ep = f.pfirst[0]
    while ep >= 0:
        c.lo[ep] = 0 - rg_inf
        c.hi[ep] = rg_inf
        ep = f.nx[ep]
    for b in 0..nb:
        c.fcmp[b] = -1
        if nin[b] == 1:
            let e = sedge[b]
            let p = f.efrom[e]
            let t = f.blast[p]
            if t >= 0 && f.op[t] == int(Op.CondBr) && f.b[t] != f.c[t]:
                let cm = f.follow(f.a[t])
                if f.op[cm] == int(Op.Cmp) && rp_is_int(f.rep[f.follow(f.a[cm])]) && f.rep[f.follow(f.a[cm])] == int(Rp.I64):
                    if e == f.b[t]:
                        c.fcmp[b] = cm
                        c.fpol[b] = 1
                    elif e == f.c[t]:
                        c.fcmp[b] = cm
                        c.fpol[b] = 0
    /#/ only the values the checks depend on get a range: the operands of the checked pairs, what those are
    /#/ computed from, and the other side of the branches that narrow them
    for b in 0..nb:
        let t = f.blast[b]
        if t >= 0 && f.op[t] == int(Op.CondBr):
            let cm = f.follow(f.a[t])
            if f.op[cm] == int(Op.Cmp) && f.aux[cm] == int(Pr.ULt) && !f.is_const(cm):
                c.need[f.follow(f.a[cm])] = 1
                c.need[f.follow(f.b[cm])] = 1
    let grew = true
    while grew:
        grew = false
        for b in 0..nb:
            let fc = c.fcmp[b]
            if fc >= 0:
                let x1 = f.follow(f.a[fc])
                let x2 = f.follow(f.b[fc])
                if (c.need[x1] == 1) != (c.need[x2] == 1):
                    c.need[x1] = 1
                    c.need[x2] = 1
                    grew = true
            if idom[b] >= 0:
                let p = f.pfirst[b]
                let k = 0
                while p >= 0:
                    if c.need[p] == 1 && b != 0:
                        let e = inh[b]
                        while e >= 0:
                            if k < f.eargn[e]:
                                let av = f.follow(f.pool[f.eargs[e] + k])
                                if c.need[av] == 0:
                                    c.need[av] = 1
                                    grew = true
                            e = innext[e]
                    p = f.nx[p]
                    k = k + 1
                let i = f.bfirst[b]
                while i >= 0:
                    if c.need[i] == 1 && f.fwd[i] < 0:
                        let o = f.op[i]
                        if o == int(Op.Add) || o == int(Op.Sub) || o == int(Op.Mul) || o == int(Op.SRem) || o == int(Op.SDiv) || o == int(Op.And) || o == int(Op.AShr) || o == int(Op.LShr) || o == int(Op.Shl):
                            let o1 = f.follow(f.a[i])
                            let o2 = f.follow(f.b[i])
                            if c.need[o1] == 0:
                                c.need[o1] = 1
                                grew = true
                            if c.need[o2] == 0:
                                c.need[o2] = 1
                                grew = true
                    i = f.nx[i]
    let rounds = 0
    while rg_round(&c, f, &rpo, np, &inh, &innext, 0) && rounds < 4:
        rounds = rounds + 1
    let wide = 0
    while rg_round(&c, f, &rpo, np, &inh, &innext, 1) && wide < 12:
        wide = wide + 1
    if wide >= 12:
        return false
    for q in 0..3:
        rg_round(&c, f, &rpo, np, &inh, &innext, 2)
    let changed = false
    for r in 0..np:
        let b = rpo[r]
        let t = f.blast[b]
        if t >= 0 && f.op[t] == int(Op.CondBr):
            let cm = f.follow(f.a[t])
            if f.op[cm] == int(Op.Cmp) && f.aux[cm] == int(Pr.ULt) && !f.is_const(cm):
                let x = f.follow(f.a[cm])
                let lv = f.follow(f.b[cm])
                if f.rep[x] == int(Rp.I64) && f.rep[lv] == int(Rp.I64):
                    rg_at(&c, f, x, b)
                    let xl = c.rl
                    let xh = c.rh
                    rg_at(&c, f, lv, b)
                    let ll = c.rl
                    let ok = xl >= 0 && xl <= xh && xh < ll
                    /#/ or the loop condition `x < len` on the way in, with x not negative
                    let y = b
                    while !ok && y >= 0:
                        let fc = c.fcmp[y]
                        if fc >= 0 && c.fpol[y] == 1 && f.aux[fc] == int(Pr.SLt) && f.follow(f.a[fc]) == x && f.follow(f.b[fc]) == lv && xl >= 0:
                            ok = true
                        if y == 0 || c.idom[y] == y || c.idom[y] < 0:
                            break
                        y = c.idom[y]
                    if ok:
                        let kc = f.cint(int(Rp.I8), 1)
                        f.uses[cm] = f.uses[cm] - 1
                        f.uses[kc] = f.uses[kc] + 1
                        f.a[t] = kc
                        changed = true
    return changed

/#/ ---- loop-invariant code ---------------------------------------------------

/#/ Does instruction `i` write memory or call something?
/#/ Is `v` the address of (a field of) what a reference parameter of the function points to?
fn deref_ok(f: &Fun, v: int) => bool:
    let x = f.follow(v)
    while x >= 0 && f.op[x] == int(Op.Field) && f.a[x] >= 0:
        x = f.follow(f.a[x])
    return x >= 0 && f.op[x] == int(Op.Param) && f.blk[x] == 0 && f.ty[x] == 0 && f.rep[x] == int(Rp.Ptr)

/#/ What kind of memory the write `i` changes: 1 for a store of a float, 2 for a store of a small integer,
/#/ 3 for a store of a 64-bit integer into a buffer element,
/#/ 0 for anything else. A float or a small integer is never part of the pointer or length of a buffer
/#/ (nor of the other 8-byte things), so such a store leaves those as they were; a load of a float is
/#/ changed by a store of a float only, a load of a small integer by a store of a small integer.
fn store_class(f: &Fun, i: int) => int:
    if f.op[i] != int(Op.Store) || f.b[i] < 0:
        return 0
    let r = f.rep[f.follow(f.b[i])]
    if rp_is_float(r):
        return 1
    if r == int(Rp.I8) || r == int(Rp.I16) || r == int(Rp.I32):
        return 2
    /#/ a wide integer stored into an element of a buffer: the header of a buffer (its pointer and length)
    /#/ is not in the block of elements, so a load through a reference parameter is not changed
    if r == int(Rp.I64) && f.op[f.follow(f.a[i])] == int(Op.Index):
        return 3
    return 0

/#/ May the load `i` read something that the writes of a loop (`mem`: of any kind, `memf`: only floats,
/#/ `memn`: only small integers, `memw`: only elements of buffers, which every load but one through a
/#/ reference parameter may read) change?
fn load_blocked(f: &Fun, i: int, mem: bool, memf: bool, memn: bool, memw: bool) => bool:
    if mem:
        return true
    let r = f.rep[i]
    if memf && rp_is_float(r):
        return true
    if memn && (r == int(Rp.I8) || r == int(Rp.I16) || r == int(Rp.I32)):
        return true
    if !memw:
        return false
    /#/ the pointer of a buffer, or a field (its length, a field of a class): not what a `&int` may point at
    return !(deref_ok(f, f.a[i]) && (r == int(Rp.Ptr) || f.op[f.follow(f.a[i])] == int(Op.Field)))

fn writes_memory(f: &Fun, i: int) => bool:
    let o = f.op[i]
    if o == int(Op.Store) || o == int(Op.Call) || o == int(Op.CCall) || o == int(Op.CallI) || o == int(Op.Alloc) || o == int(Op.Free) || o == int(Op.Drop) || o == int(Op.Clone) || o == int(Op.FRem):
        return true
    return f.tab.has(o, f_writes()) || f.tab.has(o, f_consumes())

/#/ Moves the instructions of a loop that depend only on what is computed before it to just before
/#/ the end of the block that enters the loop (made when the loop has several entries or the entry
/#/ block branches two ways). A load moves when nothing in the loop writes memory and it is in the
/#/ header, which runs whenever the loop is entered.
fn hoist_invariants(f: &Fun) => bool:
    if f.nb < 2:
        return false
    let nb = f.nb
    let rpo: buf<int> = new_buf(int, nb + 1)
    let idom: buf<int> = new_buf(int, nb + 1)
    let pc: buf<int> = new_buf(int, nb + 2)
    let pl: buf<int> = new_buf(int, f.ne + 1)
    let np = dominators(f, &rpo, &idom, &pc, &pl)
    let changed = false
    let inl: buf<int> = new_buf(int, nb + 1)
    let work: buf<int> = new_buf(int, nb + 1)
    let moved: buf<int> = new_buf(int, f.ni + 1)
    let list: buf<int> = new_buf(int, f.ni + 1)
    let k = np - 1
    let prev = 0
    while k >= 1:
        let h = rpo[k]
        k = k - 1
        /#/ what was marked for the loop before is not invariant in this one
        for r in 0..prev:
            moved[list[r]] = 0
        prev = 0
        /#/ the latches: predecessors that the header dominates
        let nw = 0
        for q in 0..nb:
            inl[q] = 0
        inl[h] = 1
        for q in pc[h]..pc[h + 1]:
            let t = pl[q]
            let x = t
            while x != h && x != 0 && idom[x] >= 0 && idom[x] != x:
                x = idom[x]
            if x == h && inl[t] == 0:
                inl[t] = 1
                work[nw] = t
                nw = nw + 1
        if nw == 0:
            continue
        while nw > 0:
            nw = nw - 1
            let b = work[nw]
            for q in pc[b]..pc[b + 1]:
                let t = pl[q]
                if inl[t] == 0 && idom[t] >= 0:
                    inl[t] = 1
                    work[nw] = t
                    nw = nw + 1
        /#/ memory written in the loop?
        /#/ (a store of a float cannot change an integer or pointer in memory, so such a loop leaves the
        /#/ buffer headers it indexes as they were: `memf` blocks only the loads of floats)
        let mem = false
        let memf = false
        let memn = false
        let memw = false
        for r in 0..np:
            let b = rpo[r]
            if inl[b] == 1:
                let i = f.bfirst[b]
                while i >= 0:
                    if writes_memory(f, i):
                        let sc = store_class(f, i)
                        if sc == 1:
                            memf = true
                        elif sc == 2:
                            memn = true
                        elif sc == 3:
                            memw = true
                        else:
                            mem = true
                    i = f.nx[i]
        /#/ the one block outside the loop that jumps to the header
        let pre0 = -1
        let outs0 = 0
        for e in 0..f.ne:
            if f.eto[e] == h:
                let fb = f.efrom[e]
                if fb >= 0 && fb < nb && inl[fb] == 0 && idom[fb] >= 0:
                    outs0 = outs0 + 1
                    pre0 = fb
        if outs0 != 1:
            pre0 = -1
        /#/ what can move, in order
        let n = 0
        for r in 0..np:
            let b = rpo[r]
            if inl[b] == 1:
                let i = f.bfirst[b]
                while i >= 0:
                    let o = f.op[i]
                    let nxt = f.nx[i]
                    /#/ a load of what the header loads, in a loop that writes nothing, is that load
                    if o == int(Op.Load) && !load_blocked(f, i, mem, memf, memn, memw) && b != h && f.fwd[i] < 0:
                        let j = f.bfirst[h]
                        let found = -1
                        while j >= 0 && found < 0:
                            if f.op[j] == int(Op.Load) && f.fwd[j] < 0 && f.rep[j] == f.rep[i] && f.ty[j] == f.ty[i] && f.follow(f.a[j]) == f.follow(f.a[i]):
                                found = j
                            j = f.nx[j]
                        /#/ or the last load of it in the block that enters the loop, if nothing writes after it
                        if found < 0 && pre0 >= 0:
                            let q = f.blast[pre0]
                            while q >= 0 && found < 0 && !writes_memory(f, q):
                                if f.op[q] == int(Op.Load) && f.fwd[q] < 0 && f.rep[q] == f.rep[i] && f.ty[q] == f.ty[i] && f.follow(f.a[q]) == f.follow(f.a[i]):
                                    found = q
                                q = f.pv[q]
                        if found >= 0:
                            replace_inst(f, i, found)
                            changed = true
                            i = nxt
                            continue
                    if o == int(Op.Load) && f.fwd[i] < 0 && !load_blocked(f, i, mem, memf, memn, memw) && b != h && deref_ok(f, f.a[i]):
                        /#/ a read through a reference parameter cannot fault, so it may run before the loop is known to be entered;
                        /#/ one equal to a load already moved is that load
                        let same = -1
                        for rr in 0..n:
                            let j = list[rr]
                            if same < 0 && f.op[j] == int(Op.Load) && f.rep[j] == f.rep[i] && f.ty[j] == f.ty[i] && f.follow(f.a[j]) == f.follow(f.a[i]):
                                same = j
                        if same >= 0:
                            replace_inst(f, i, same)
                            changed = true
                            i = nxt
                            continue
                        if f.blk[f.follow(f.a[i])] < 0 || inl[f.blk[f.follow(f.a[i])]] == 0:
                            moved[i] = 1
                            list[n] = i
                            n = n + 1
                            i = nxt
                            continue
                    if f.fwd[i] < 0 && (pure_op(o) || (o == int(Op.Load) && !load_blocked(f, i, mem, memf, memn, memw) && b == h)):
                        let ok = true
                        for u in 0..f.nval(i):
                            let v = f.val_at(i, u)
                            if v >= 0:
                                let x = f.follow(v)
                                if f.blk[x] >= 0 && inl[f.blk[x]] == 1 && moved[x] == 0:
                                    ok = false
                        if ok:
                            moved[i] = 1
                            list[n] = i
                            n = n + 1
                    i = f.nx[i]
        prev = n
        if n == 0:
            continue
        /#/ the block to move them to
        let outs = 0
        let oe = -1
        for e in 0..f.ne:
            let to = f.eto[e]
            if to == h:
                let fb = f.efrom[e]
                if fb >= 0 && fb < nb && inl[fb] == 0 && idom[fb] >= 0:
                    outs = outs + 1
                    oe = e
        if outs == 0:
            continue
        let pre = -1
        if outs == 1 && f.op[f.blast[f.efrom[oe]]] == int(Op.Br):
            pre = f.efrom[oe]
        else:
            let keep = f.cur
            pre = f.new_block()
            f.set_block(pre)
            let p = f.pfirst[h]
            while p >= 0:
                let q = f.param(pre, f.rep[p], f.ty[p])
                f.arg(q)
                p = f.nx[p]
            f.br(h)
            f.set_block(keep)
            for e in 0..f.ne - 1:
                if f.eto[e] == h:
                    let fb = f.efrom[e]
                    if fb >= 0 && fb < nb && inl[fb] == 0 && idom[fb] >= 0:
                        f.eto[e] = pre
            return true
        let t = f.blast[pre]
        for r in 0..n:
            let i = list[r]
            unlink(f, i)
            f.blk[i] = pre
            f.pv[i] = f.pv[t]
            f.nx[i] = t
            if f.pv[t] >= 0:
                f.nx[f.pv[t]] = i
            else:
                f.bfirst[pre] = i
            f.pv[t] = i
        changed = true
    return changed

/#/ The value of `v` in block `b` when parameter k of `b` is `known[k]` (`isk[k]` = 1): a constant, a known parameter, or a conversion or
/#/ compare of such; `miss[0]` is set when it cannot be told.
fn tc_eval(f: &Fun, b: int, v0: int, known: &buf<int>, isk: &buf<int>, miss: &buf<int>) => int:
    let v = f.follow(v0)
    if f.is_const(v):
        return f.cval(v)
    let o = f.op[v]
    if o == int(Op.Param) && f.blk[v] == b:
        let k = f.aux[v]
        if k < len(known) && isk[k] == 1:
            return known[k]
        miss[0] = 1
        return 0
    if f.blk[v] == b && (o == int(Op.ZExt) || o == int(Op.Trunc) || o == int(Op.SExt)) && f.a[v] >= 0:
        let x = tc_eval(f, b, f.a[v], known, isk, miss)
        let r = f.rep[v]
        if o == int(Op.ZExt):
            return unsigned_of(f.rep[f.follow(f.a[v])], x)
        return wrap(r, x)
    if f.blk[v] == b && o == int(Op.Cmp):
        let p = f.aux[v]
        let x = tc_eval(f, b, f.a[v], known, isk, miss)
        let y = tc_eval(f, b, f.b[v], known, isk, miss)
        if p == int(Pr.Eq):
            if x == y:
                return 1
            return 0
        if p == int(Pr.Ne):
            if x != y:
                return 1
            return 0
    miss[0] = 1
    return 0

/#/ An edge that passes constants to a block which does nothing but test them goes straight to the side the test takes: the flag of
/#/ `while go:` set to false on the way out no longer comes back to the test. The block's values may be used only by its own edges.
fn thread_const_params(f: &Fun) => bool:
    if (strength_mode & 4) == 0:
        return false
    let changed = false
    let ne0 = f.ne
    for e in 0..ne0:
        let b = f.eto[e]
        if b <= 0 || f.eargn[e] == 0 || f.eargn[e] != f.npar[b] || f.efrom[e] == b:
            continue
        let t = f.blast[b]
        if t < 0 || f.op[t] != int(Op.CondBr):
            continue
        /#/ nothing but pure instructions that the test is made of
        let pure = true
        let i = f.bfirst[b]
        while i != t && i >= 0:
            let o = f.op[i]
            if !(o == int(Op.ZExt) || o == int(Op.Trunc) || o == int(Op.SExt) || o == int(Op.Cmp)):
                pure = false
            i = f.nx[i]
        if !pure:
            continue
        let n = f.npar[b]
        let known: buf<int> = new_buf(int, n + 1)
        let isk: buf<int> = new_buf(int, n + 1)
        let any = false
        for k in 0..n:
            let a = f.follow(f.pool[f.eargs[e] + k])
            if f.is_const(a):
                known[k] = f.cval(a)
                isk[k] = 1
                any = true
        if !any:
            continue
        let miss: buf<int> = new_buf(int, 1)
        let c = tc_eval(f, b, f.a[t], &known, &isk, &miss)
        if miss[0] == 1:
            continue
        let e2 = f.b[t]
        if c == 0:
            e2 = f.c[t]
        let to = f.eto[e2]
        if to < 0 || to == b:
            continue
        /#/ the arguments of the edge taken may be parameters of `b` (replaced by what `e` passes) or values from outside
        let ok = true
        for k in 0..f.eargn[e2]:
            let x = f.follow(f.pool[f.eargs[e2] + k])
            if f.blk[x] == b && !(f.op[x] == int(Op.Param)):
                ok = false
        if !ok:
            continue
        /#/ and nothing else reads what `b` defines
        let p = f.pfirst[b]
        let ext = 0
        while p >= 0:
            ext = ext + f.uses[p]
            p = f.nx[p]
        /#/ uses of parameters by instructions of `b`, and by the edges of `b`
        let inb = 0
        i = f.bfirst[b]
        while i >= 0:
            for u in 0..f.nval(i):
                let v = f.val_at(i, u)
                if v >= 0 && f.op[f.follow(v)] == int(Op.Param) && f.blk[f.follow(v)] == b:
                    inb = inb + 1
            i = f.nx[i]
        for q in 0..f.nsucc(b):
            let e3 = f.succ_edge(b, q)
            for u in 0..f.eargn[e3]:
                let v = f.follow(f.pool[f.eargs[e3] + u])
                if f.op[v] == int(Op.Param) && f.blk[v] == b:
                    inb = inb + 1
        if inb != ext:
            continue
        /#/ the instructions of `b` are used by itself only
        let outer = false
        i = f.bfirst[b]
        while i != t && i >= 0:
            let inner = 0
            let j = f.nx[i]
            while j >= 0:
                for u in 0..f.nval(j):
                    if f.val_at(j, u) >= 0 && f.follow(f.val_at(j, u)) == i:
                        inner = inner + 1
                j = f.nx[j]
            if f.uses[i] != inner:
                outer = true
            i = f.nx[i]
        if outer:
            continue
        tc_redirect(f, e, e2, b)
        changed = true
    return changed

/#/ Edge `e` into block `b` is made a copy of edge `e2` out of it: the arguments of `e2` that are parameters of `b` are what `e` passes.
fn tc_redirect(f: &Fun, e: int, e2: int, b: int) => void:
    let to = f.eto[e2]
    let at = f.np
    for k in 0..f.eargn[e2]:
        let x = f.follow(f.pool[f.eargs[e2] + k])
        if f.op[x] == int(Op.Param) && f.blk[x] == b:
            f.pool_put(f.pool[f.eargs[e] + f.aux[x]])
        else:
            f.pool_put(x)
    for k in 0..f.eargn[e]:
        let x = f.follow(f.pool[f.eargs[e] + k])
        f.uses[x] = f.uses[x] - 1
    f.eargs[e] = at
    f.eargn[e] = f.eargn[e2]
    f.eto[e] = to
    for k in 0..f.eargn[e]:
        let x = f.follow(f.pool[f.eargs[e] + k])
        f.uses[x] = f.uses[x] + 1

/#/ An edge into a block that only jumps on, with parameters, goes to where that block jumps, passing what it was passed.
fn thread_forward(f: &Fun) => bool:
    if (strength_mode & 4) == 0:
        return false
    let changed = false
    for e in 0..f.ne:
        let b = f.eto[e]
        if b <= 0 || f.efrom[e] == b || f.npar[b] == 0 || f.eargn[e] != f.npar[b]:
            continue
        let t = f.blast[b]
        if t < 0 || f.bfirst[b] != t || f.op[t] != int(Op.Br):
            continue
        let e2 = f.aux[t]
        let to = f.eto[e2]
        if to < 0 || to == b:
            continue
        let ext = 0
        let p = f.pfirst[b]
        while p >= 0:
            ext = ext + f.uses[p]
            p = f.nx[p]
        let inb = 0
        for u in 0..f.eargn[e2]:
            let v = f.follow(f.pool[f.eargs[e2] + u])
            if f.op[v] == int(Op.Param) && f.blk[v] == b:
                inb = inb + 1
        if inb != ext:
            continue
        tc_redirect(f, e, e2, b)
        changed = true
    return changed

/#/ ---- strength reduction ------------------------------------------------------

/#/ Which of the two reductions run: 1 `iv * c`, 2 `base[iv + k]` (a pointer that steps along). Set by the target: where an address
/#/ has no scaled index (riscv64) the second saves the shift and the add of every access.
let strength_mode = 0

fn set_strength(mode: int) => void:
    strength_mode = mode

/#/ The rewrites wait until the vector loops of the function were looked for (they want the loops as written): `module_opt` sets this.
let strength_on = false

/#/ ... and the pointers that step along addresses wait for them (a vector loop wants `a[i]` as written)
let strength_addr = false

fn set_strength_on(on: bool) => void:
    strength_addr = on

/#/ Do the rewrites wait for the vector loops (and so need a round of their own after them)?
fn strength_late() => bool:
    return !no_vector && (strength_mode & 2) != 0

/#/ At the start of a function: the rewrites may run at once when there are no vector loops to wait for.
fn strength_start() => void:
    strength_on = true
    strength_addr = no_vector

/#/ Is `v` the same in every iteration of the loop `inl`?
fn sr_inv(f: &Fun, inl: &buf<int>, v: int) => bool:
    return f.blk[v] < 0 || inl[f.blk[v]] == 0

/#/ Is `v` an operand of an add or an index in the loop `inl`?
fn sr_feeds_add(f: &Fun, inl: &buf<int>, v: int) => bool:
    for b in 0..f.nb:
        if inl[b] == 1:
            let j = f.bfirst[b]
            while j >= 0:
                let o = f.op[j]
                if (o == int(Op.Add) || o == int(Op.Index)) && f.fwd[j] < 0:
                    if (f.a[j] >= 0 && f.follow(f.a[j]) == v) || (f.b[j] >= 0 && f.follow(f.b[j]) == v):
                        return true
                j = f.nx[j]
    return false

/#/ Gives edge `e` one more argument, `v`.
fn sr_add_arg(f: &Fun, e: int, v: int) => void:
    let start = f.np
    for j in 0..f.eargn[e]:
        f.pool_put(f.pool[f.eargs[e] + j])
    f.pool_put(v)
    f.eargs[e] = start
    f.eargn[e] = f.eargn[e] + 1
    f.uses[v] = f.uses[v] + 1

/#/ A new instruction in block `b`, before its last one.
fn sr_make(f: &Fun, b: int, op: int, rep: int, ty: int, x: int, y: int, aux: int) => int:
    let r = f.mk(op, rep, ty, x, y, -1, aux)
    let t = f.blast[b]
    let p = f.pv[t]
    f.blk[r] = b
    f.pv[r] = p
    f.nx[r] = t
    f.pv[t] = r
    if p >= 0:
        f.nx[p] = r
    else:
        f.bfirst[b] = r
    return r

/#/ A value `x * y` or `x + y` made before the end of block `b` (a constant when both are).
fn sr_arith(f: &Fun, b: int, op: int, x: int, y: int) => int:
    let rep = f.rep[x]
    if f.is_const(x) && f.is_const(y):
        if op == int(Op.Mul):
            return f.cint(rep, f.cval(x) * f.cval(y))
        return f.cint(rep, f.cval(x) + f.cval(y))
    if f.is_const(y) && f.cval(y) == 0 && op == int(Op.Add):
        return x
    return sr_make(f, b, op, rep, f.ty[x], x, y, 0)

/#/ In a loop entered once and stepped by a constant, `iv * c` and `base + iv * size` (for `c`, `base` that do not change in the
/#/ loop) become parameters of the loop header of their own, started before the loop and stepped by an add at each back edge.
fn strength_reduce(f: &Fun) => bool:
    if strength_mode == 0 || !strength_on || f.nb < 2:
        return false
    let nb = f.nb
    let rpo: buf<int> = new_buf(int, nb + 1)
    let idom: buf<int> = new_buf(int, nb + 1)
    let pc: buf<int> = new_buf(int, nb + 2)
    let pl: buf<int> = new_buf(int, f.ne + 1)
    let np = dominators(f, &rpo, &idom, &pc, &pl)
    let inl: buf<int> = new_buf(int, nb + 1)
    let work: buf<int> = new_buf(int, nb + 1)
    let changed = false
    let k = np - 1
    while k >= 1:
        let h = rpo[k]
        k = k - 1
        let nw = 0
        for q in 0..nb:
            inl[q] = 0
        inl[h] = 1
        for q in pc[h]..pc[h + 1]:
            let t = pl[q]
            let x = t
            while x != h && x != 0 && idom[x] >= 0 && idom[x] != x:
                x = idom[x]
            if x == h && inl[t] == 0:
                inl[t] = 1
                work[nw] = t
                nw = nw + 1
        if nw == 0:
            continue
        while nw > 0:
            nw = nw - 1
            let b = work[nw]
            for q in pc[b]..pc[b + 1]:
                let t = pl[q]
                if inl[t] == 0 && idom[t] >= 0:
                    inl[t] = 1
                    work[nw] = t
                    nw = nw + 1
        /#/ the one edge that enters the loop; the others into the header come from inside
        let ep = -1
        let nback = 0
        let ok = true
        for e in 0..f.ne:
            if f.eto[e] == h:
                let fb = f.efrom[e]
                if fb < 0 || fb >= nb || idom[fb] < 0:
                    continue
                if inl[fb] == 1:
                    nback = nback + 1
                elif ep >= 0:
                    ok = false
                else:
                    ep = e
        if !ok || ep < 0 || nback == 0:
            continue
        let pre = f.efrom[ep]
        if f.blast[pre] < 0:
            continue
        let made = 0
        let nparam = f.npar[h]
        for pi in 0..nparam:
            if made >= 4:
                break
            let pv = f.param_at(h, pi)
            if f.rep[pv] != int(Rp.I64):
                continue
            /#/ its step: the same loop invariant added on every edge back
            let step = -1
            let good = true
            for e in 0..f.ne:
                if f.eto[e] == h && e != ep && f.efrom[e] >= 0 && f.efrom[e] < nb && idom[f.efrom[e]] >= 0 && inl[f.efrom[e]] == 1 && good:
                    let a = f.follow(f.pool[f.eargs[e] + pi])
                    let sv = -1
                    if f.op[a] == int(Op.Add) && f.rep[a] == int(Rp.I64):
                        let u = f.follow(f.a[a])
                        let w = f.follow(f.b[a])
                        if u == pv && w != pv && sr_inv(f, &inl, w):
                            sv = w
                        elif w == pv && u != pv && sr_inv(f, &inl, u):
                            sv = u
                    if sv < 0 || (step >= 0 && step != sv) || (f.is_const(sv) && f.cval(sv) == 0):
                        good = false
                    else:
                        step = sv
            if !good || step < 0:
                continue
            let i0 = f.follow(f.pool[f.eargs[ep] + pi])
            /#/ what can be reduced: instruction, kind, the invariant operand and the offset added to the iv
            let cand: buf<int> = new_buf(int, 64)
            let nc = 0
            for r in 0..np:
                let b = rpo[r]
                if inl[b] == 0:
                    continue
                let i = f.bfirst[b]
                while i >= 0:
                    if f.fwd[i] < 0 && nc < 16 && f.uses[i] > 0:
                        let o = f.op[i]
                        if o == int(Op.Mul) && (strength_mode & 1) != 0 && f.rep[i] == int(Rp.I64):
                            let x = f.follow(f.a[i])
                            let y = f.follow(f.b[i])
                            if y == pv && x != pv && sr_inv(f, &inl, x):
                                x = f.follow(f.b[i])
                                y = f.follow(f.a[i])
                            /#/ (a power of two is a shift, as cheap as the add that would replace it, unless the product is added to something:
                            /#/ then the address it makes steps with it)
                            let cheap = x == pv && f.is_const(y) && f.cval(y) > 0 && (f.cval(y) & (f.cval(y) - 1)) == 0 && !sr_feeds_add(f, &inl, i)
                            if x == pv && y != pv && sr_inv(f, &inl, y) && !cheap:
                                cand[nc * 4] = i
                                cand[nc * 4 + 1] = 1
                                cand[nc * 4 + 2] = y
                                cand[nc * 4 + 3] = -1
                                nc = nc + 1
                        elif o == int(Op.Index) && (strength_mode & 2) != 0 && strength_addr && f.is_const(step) && sr_inv(f, &inl, f.follow(f.a[i])):
                            let x = f.follow(f.b[i])
                            let off = -1
                            if x != pv && f.op[x] == int(Op.Add) && f.rep[x] == int(Rp.I64):
                                let u = f.follow(f.a[x])
                                let w = f.follow(f.b[x])
                                if u == pv && sr_inv(f, &inl, w):
                                    off = w
                                    x = pv
                                elif w == pv && sr_inv(f, &inl, u):
                                    off = u
                                    x = pv
                            if x == pv:
                                cand[nc * 4] = i
                                cand[nc * 4 + 1] = 2
                                cand[nc * 4 + 2] = off
                                cand[nc * 4 + 3] = -1
                                nc = nc + 1
                    i = f.nx[i]
            for c in 0..nc:
                if made >= 4:
                    break
                let i = cand[c * 4]
                if f.fwd[i] >= 0:
                    continue
                /#/ the same reduction made already
                let same = -1
                for d in 0..c:
                    if cand[d * 4 + 3] >= 0 && f.op[cand[d * 4]] == f.op[i] && cand[d * 4 + 2] == cand[c * 4 + 2]:
                        if f.op[i] == int(Op.Mul) || (f.aux[cand[d * 4]] == f.aux[i] && f.follow(f.a[cand[d * 4]]) == f.follow(f.a[i])):
                            same = cand[d * 4 + 3]
                if same >= 0:
                    replace_inst(f, i, same)
                    changed = true
                    continue
                let kind = cand[c * 4 + 1]
                let inv = cand[c * 4 + 2]
                let q = f.param(h, f.rep[i], f.ty[i])
                let start = 0
                if kind == 1:
                    start = sr_arith(f, pre, int(Op.Mul), i0, inv)
                else:
                    let idx0 = i0
                    if inv >= 0:
                        idx0 = sr_arith(f, pre, int(Op.Add), i0, inv)
                    start = sr_make(f, pre, int(Op.Index), int(Rp.Ptr), -1, f.follow(f.a[i]), idx0, f.aux[i])
                for e in 0..f.ne:
                    if f.eto[e] == h && f.efrom[e] >= 0 && f.efrom[e] < nb && idom[f.efrom[e]] >= 0:
                        if e == ep:
                            sr_add_arg(f, e, start)
                        elif inl[f.efrom[e]] == 1:
                            let lb = f.efrom[e]
                            let nv = 0
                            if kind == 1:
                                let sc = sr_arith(f, pre, int(Op.Mul), step, inv)
                                nv = sr_make(f, lb, int(Op.Add), f.rep[i], f.ty[i], q, sc, 0)
                            else:
                                nv = sr_make(f, lb, int(Op.Index), int(Rp.Ptr), -1, q, step, f.aux[i])
                            sr_add_arg(f, e, nv)
                cand[c * 4 + 3] = q
                replace_inst(f, i, q)
                made = made + 1
                changed = true
    if changed:
        recount_uses(f)
    return changed

/#/ ---- vectorization ----------------------------------------------------------

/#/ What a loop that can be done a vector at a time was found to be made of.
class VCtx:
    ok: bool
    /#/ the element kind: 0 f32, 1 f64, 2 i8, 3 i16, 4 i32, 5 i64
    lane: int
    /#/ the program: postfix tokens `code | arg << 8` (1 load of buffer arg, 2 invariant arg, 3 operation arg, 4 store to buffer arg)
    prog: buf<int>
    np: int
    ptrs: buf<int>
    nptr: int
    invs: buf<int>
    ninv: int
    depth: int
    stores: int
    /#/ the place of each instruction in the loop's order, and the place of the last store so far: a load before it
    /#/ cannot be done again after it
    seq: buf<int>
    minseq: int

fn new_vctx(lane: int, ni: int) => VCtx:
    return VCtx { ok: true, lane: lane, prog: new_buf(int, 64), np: 0, ptrs: new_buf(int, 8), nptr: 0, invs: new_buf(int, 8), ninv: 0, depth: 0, stores: 0, seq: new_buf(int, ni + 1), minseq: -1 }

/#/ The element kind of a value of representation `r`, -1 for none.
fn v_lane_of(r: int) => int:
    if r == int(Rp.F32):
        return 0
    if r == int(Rp.F64):
        return 1
    if r == int(Rp.I8):
        return 2
    if r == int(Rp.I16):
        return 3
    if r == int(Rp.I32):
        return 4
    if r == int(Rp.I64):
        return 5
    return -1

fn v_elem_rep(lane: int) => int:
    if lane == 0:
        return int(Rp.F32)
    if lane == 1:
        return int(Rp.F64)
    if lane == 2:
        return int(Rp.I8)
    if lane == 3:
        return int(Rp.I16)
    if lane == 4:
        return int(Rp.I32)
    return int(Rp.I64)

fn v_elem_size(lane: int) => int:
    if lane == 0 || lane == 4:
        return 4
    if lane == 1 || lane == 5:
        return 8
    if lane == 2:
        return 1
    return 2

fn v_push(c: &VCtx, code: int, arg: int) => void:
    if c.np >= len(c.prog):
        c.prog = buf_resize(c.prog, c.np * 2)
    c.prog[c.np] = code | (arg << 8)
    c.np = c.np + 1

fn v_outside(f: &Fun, inl: &buf<int>, v: int) => bool:
    return f.blk[v] < 0 || inl[f.blk[v]] == 0

/#/ Adds the program of the value `v0`.
fn v_emit(c: &VCtx, f: &Fun, inl: &buf<int>, iv: int, v0: int) => void:
    if !c.ok:
        return
    let v = f.follow(v0)
    let o = f.op[v]
    if v_outside(f, inl, v):
        let r = f.rep[v]
        let good = false
        if c.lane <= 1:
            good = r == v_elem_rep(c.lane)
        else:
            good = rp_is_int(r)
        if !good:
            c.ok = false
            return
        let j = 0
        while j < c.ninv && c.invs[j] != v:
            j = j + 1
        if j == c.ninv:
            if j >= 8:
                c.ok = false
                return
            c.invs[j] = v
            c.ninv = j + 1
        v_push(c, 2, j)
        c.depth = c.depth + 1
    elif o == int(Op.Load):
        let a = f.follow(f.a[v])
        if f.op[a] != int(Op.Index) || f.follow(f.b[a]) != iv || f.aux[a] != v_elem_size(c.lane) || f.rep[v] != v_elem_rep(c.lane):
            c.ok = false
            return
        let base = f.follow(f.a[a])
        if !v_outside(f, inl, base) || c.seq[v] < c.minseq:
            c.ok = false
            return
        let k = 0
        while k < c.nptr && c.ptrs[k] != base:
            k = k + 1
        if k == c.nptr:
            if k >= 7:
                c.ok = false
                return
            c.ptrs[k] = base
            c.nptr = k + 1
        v_push(c, 1, k)
        c.depth = c.depth + 1
    elif (o == int(Op.ZExt) || o == int(Op.SExt)) && c.lane >= 2 && c.lane <= 4:
        let x = f.follow(f.a[v])
        if f.op[x] != int(Op.Load) || v_outside(f, inl, x):
            c.ok = false
            return
        v_emit(c, f, inl, iv, x)
    else:
        let op = -1
        if c.lane <= 1:
            if f.rep[v] == v_elem_rep(c.lane):
                if o == int(Op.FAdd):
                    op = 0
                elif o == int(Op.FSub):
                    op = 1
                elif o == int(Op.FMul):
                    op = 2
                elif o == int(Op.FDiv):
                    op = 3
        elif f.rep[v] == int(Rp.I64):
            if o == int(Op.Add):
                op = 0
            elif o == int(Op.Sub):
                op = 1
            elif o == int(Op.Mul) && c.lane == 3:
                op = 2
            elif o == int(Op.And):
                op = 4
            elif o == int(Op.Or):
                op = 5
            elif o == int(Op.Xor):
                op = 6
        if op < 0:
            c.ok = false
            return
        v_emit(c, f, inl, iv, f.a[v])
        v_emit(c, f, inl, iv, f.b[v])
        v_push(c, 3, op)
        c.depth = c.depth - 1
    if c.depth > 6:
        c.ok = false

/#/ Set when the target has no code for the vector loops: `vectorize` then does nothing.
let no_vector = false

fn set_vector_loops(on: bool) => void:
    no_vector = !on

/#/ Is the loop headed by `h` one that can be done a vector at a time? A loop `for i in a..n` of one store to
/#/ `buf[i]` whose value is made of loads `buf[i]`, loop invariants and plain arithmetic, entered by a plain
/#/ jump. Then a vector loop goes in front of it: when `n` is within the length of every buffer checked, it
/#/ does as many elements as it can, a vector at a time, and the loop goes on with the rest (and fails the
/#/ check where it would have). Returns whether it changed anything; the loop is looked at once.
fn vectorize(f: &Fun) => bool:
    if no_vector || f.nb < 3:
        return false
    let nb = f.nb
    let rpo: buf<int> = new_buf(int, nb + 1)
    let idom: buf<int> = new_buf(int, nb + 1)
    let pc: buf<int> = new_buf(int, nb + 2)
    let pl: buf<int> = new_buf(int, f.ne + 1)
    let np = dominators(f, &rpo, &idom, &pc, &pl)
    let inl: buf<int> = new_buf(int, nb + 1)
    let work: buf<int> = new_buf(int, nb + 1)
    for k in 1..np:
        let h = rpo[k]
        let hterm = f.blast[h]
        if hterm < 0 || f.op[hterm] != int(Op.CondBr) || (f.npar[h] != 1 && f.npar[h] != 2):
            continue
        /#/ the counter, and with a second parameter the accumulator of a reduction
        let iv = f.pfirst[h]
        let acc = -1
        let ipos = 0
        if f.npar[h] == 2:
            let c0 = f.follow(f.a[hterm])
            if f.op[c0] != int(Op.Cmp):
                continue
            let x0 = f.follow(f.a[c0])
            if x0 == f.nx[f.pfirst[h]]:
                iv = x0
                acc = f.pfirst[h]
                ipos = 1
            elif x0 == f.pfirst[h]:
                acc = f.nx[iv]
            if acc < 0 || f.rep[acc] != int(Rp.I64):
                continue
        if f.rep[iv] != int(Rp.I64):
            continue
        /#/ the loop
        let nw = 0
        for q in 0..nb:
            inl[q] = 0
        inl[h] = 1
        for q in pc[h]..pc[h + 1]:
            let t = pl[q]
            let y = t
            while y != h && y != 0 && idom[y] >= 0 && idom[y] != y:
                y = idom[y]
            if y == h && inl[t] == 0:
                inl[t] = 1
                work[nw] = t
                nw = nw + 1
        if nw == 0:
            continue
        while nw > 0:
            nw = nw - 1
            let b = work[nw]
            for q in pc[b]..pc[b + 1]:
                let t = pl[q]
                if inl[t] == 0 && idom[t] >= 0:
                    inl[t] = 1
                    work[nw] = t
                    nw = nw + 1
        /#/ the test `i < n` with the body on the true side
        let et = f.b[hterm]
        let ef = f.c[hterm]
        if f.eto[et] < 0 || f.eto[ef] < 0 || inl[f.eto[et]] == 0 || inl[f.eto[ef]] == 1:
            continue
        let cmpv = f.follow(f.a[hterm])
        if f.op[cmpv] != int(Op.Cmp) || f.aux[cmpv] != int(Pr.SLt) || f.follow(f.a[cmpv]) != iv:
            continue
        let n = f.follow(f.b[cmpv])
        if !v_outside(f, &inl, n):
            continue
        let ok = true
        let i = f.bfirst[h]
        while i >= 0:
            if i != hterm && i != cmpv:
                ok = false
            i = f.nx[i]
        if !ok:
            continue
        /#/ one entry from outside, a plain jump; one jump back, with i + 1
        let e0 = -1
        let n0 = 0
        let nlatch = 0
        let inext = -1
        let anext = -1
        let acc0 = -1
        let apos = 1 - ipos
        for e in 0..f.ne:
            if f.eto[e] == h && f.efrom[e] >= 0 && f.efrom[e] < nb:
                let fb = f.efrom[e]
                let tt = f.blast[fb]
                if inl[fb] == 1:
                    nlatch = nlatch + 1
                    if tt < 0 || f.op[tt] != int(Op.Br) || f.aux[tt] != e || f.eargn[e] != f.npar[h]:
                        ok = false
                    else:
                        inext = f.follow(f.pool[f.eargs[e] + ipos])
                        if acc >= 0:
                            anext = f.follow(f.pool[f.eargs[e] + apos])
                elif idom[fb] >= 0:
                    n0 = n0 + 1
                    e0 = e
                    if tt < 0 || f.op[tt] != int(Op.Br) || f.aux[tt] != e || f.eargn[e] != f.npar[h]:
                        ok = false
                    elif acc >= 0:
                        acc0 = f.follow(f.pool[f.eargs[e] + apos])
        if !ok || n0 != 1 || nlatch != 1:
            continue
        if f.op[inext] != int(Op.Add) || f.follow(f.a[inext]) != iv || !f.is_const(f.follow(f.b[inext])) || f.cval(f.follow(f.b[inext])) != 1:
            continue
        /#/ a reduction: the accumulator becomes `acc op e1 op e2 ...` (op: + - ^ | &; a chain of one operation, each
        /#/ link used once), and nothing else in the loop reads it
        let rk = 0
        let chain: buf<int> = new_buf(int, 6)
        let nch = 0
        let terms: buf<int> = new_buf(int, 6)
        let nt = 0
        if acc >= 0:
            if v_outside(f, &inl, anext) || f.rep[anext] != int(Rp.I64):
                continue
            let ro = f.op[anext]
            if ro == int(Op.Add):
                rk = 1
            elif ro == int(Op.Sub):
                rk = 2
            elif ro == int(Op.Xor):
                rk = 3
            elif ro == int(Op.Or):
                rk = 4
            elif ro == int(Op.And):
                rk = 5
            if rk == 0:
                continue
            let cur = anext
            let found = false
            let bad = false
            while !found && !bad:
                chain[nch] = cur
                nch = nch + 1
                let ca = f.follow(f.a[cur])
                let cb = f.follow(f.b[cur])
                if ca == acc:
                    terms[nt] = cb
                    nt = nt + 1
                    found = true
                elif cb == acc && rk != 2:
                    terms[nt] = ca
                    nt = nt + 1
                    found = true
                elif rk != 2 && nch < 5 && f.op[ca] == ro && f.uses[ca] == 1 && !v_outside(f, &inl, ca):
                    terms[nt] = cb
                    nt = nt + 1
                    cur = ca
                elif rk != 2 && nch < 5 && f.op[cb] == ro && f.uses[cb] == 1 && !v_outside(f, &inl, cb):
                    terms[nt] = ca
                    nt = nt + 1
                    cur = cb
                else:
                    bad = true
            if bad:
                continue
            for q in 0..nt:
                if terms[q] == acc:
                    ok = false
            for b in 0..nb:
                if inl[b] == 1:
                    let j = f.bfirst[b]
                    while j >= 0:
                        let inchain = false
                        for q in 0..nch:
                            if chain[q] == j:
                                inchain = true
                        if !inchain:
                            for q in 0..f.nval(j):
                                if f.val_at(j, q) >= 0 && f.follow(f.val_at(j, q)) == acc:
                                    ok = false
                        j = f.nx[j]
            if !ok:
                continue
        /#/ the body: plain instructions, checks of i against a length outside, one store
        let sts: buf<int> = new_buf(int, 4)
        let nstore = 0
        let checks: buf<int> = new_buf(int, 8)
        let nchk = 0
        let seq: buf<int> = new_buf(int, f.ni + 1)
        let sn = 0
        for r in 0..np:
            if inl[rpo[r]] == 1:
                let j = f.bfirst[rpo[r]]
                while j >= 0:
                    seq[j] = sn
                    sn = sn + 1
                    j = f.nx[j]
        for b in 0..nb:
            if inl[b] == 1 && b != h && ok:
                let j = f.bfirst[b]
                while j >= 0 && ok:
                    let o = f.op[j]
                    if o == int(Op.Store):
                        if nstore >= 4:
                            ok = false
                        else:
                            sts[nstore] = j
                            nstore = nstore + 1
                    elif o == int(Op.CondBr):
                        let cc = f.follow(f.a[j])
                        if f.op[cc] != int(Op.Cmp) || f.aux[cc] != int(Pr.ULt) || f.follow(f.a[cc]) != iv:
                            ok = false
                        else:
                            let l = f.follow(f.b[cc])
                            if !v_outside(f, &inl, l) || nchk >= 4:
                                ok = false
                            else:
                                let q = 0
                                while q < nchk && checks[q] != l:
                                    q = q + 1
                                if q == nchk:
                                    checks[q] = l
                                    nchk = nchk + 1
                        /#/ the other way is a failed check, which makes nothing the loop could be asked for
                        for s in 0..2:
                            let to = f.eto[f.succ_edge(b, s)]
                            if to >= 0 && inl[to] == 0:
                                let tb = f.blast[to]
                                if tb < 0 || f.op[tb] != int(Op.Unreachable):
                                    ok = false
                                let u = f.bfirst[to]
                                while u >= 0:
                                    for q in 0..f.nval(u):
                                        let x = f.val_at(u, q)
                                        if x >= 0 && !v_outside(f, &inl, f.follow(x)):
                                            ok = false
                                    u = f.nx[u]
                    elif o == int(Op.Br):
                        let nothing = 0
                    elif !(o == int(Op.Cmp) || o == int(Op.Index) || o == int(Op.Load) || o == int(Op.ZExt) || o == int(Op.SExt) || o == int(Op.Trunc) || o == int(Op.Add) || o == int(Op.Sub) || o == int(Op.Mul) || o == int(Op.And) || o == int(Op.Or) || o == int(Op.Xor) || o == int(Op.FAdd) || o == int(Op.FSub) || o == int(Op.FMul) || o == int(Op.FDiv)):
                        ok = false
                    j = f.nx[j]
        if !ok || (nstore < 1 && rk == 0) || (nstore > 0 && rk > 0):
            continue
        /#/ the stores in the order they run
        for x in 1..nstore:
            let y = x
            while y > 0 && seq[sts[y - 1]] > seq[sts[y]]:
                let tmp = sts[y]
                sts[y] = sts[y - 1]
                sts[y - 1] = tmp
                y = y - 1
        /#/ the program of each stored value
        let lane = 5
        if rk == 0:
            lane = v_lane_of(f.rep[f.follow(f.b[sts[0]])])
        if lane < 0:
            continue
        let c = new_vctx(lane, f.ni)
        for q in 0..f.ni:
            c.seq[q] = seq[q]
        for x in 0..nstore:
            let store = sts[x]
            let sa = f.follow(f.a[store])
            let sv = f.follow(f.b[store])
            if v_lane_of(f.rep[sv]) != lane || f.op[sa] != int(Op.Index) || f.follow(f.b[sa]) != iv || f.aux[sa] != v_elem_size(lane):
                c.ok = false
                break
            let sbase = f.follow(f.a[sa])
            if !v_outside(f, &inl, sbase):
                c.ok = false
                break
            c.minseq = -1
            if x > 0:
                c.minseq = seq[sts[x - 1]]
            if lane >= 2 && lane <= 4:
                if f.op[sv] != int(Op.Trunc):
                    c.ok = false
                    break
                v_emit(&c, f, &inl, iv, f.a[sv])
            else:
                v_emit(&c, f, &inl, iv, sv)
            if !c.ok || c.depth != 1:
                c.ok = false
                break
            let ks = 0
            while ks < c.nptr && c.ptrs[ks] != sbase:
                ks = ks + 1
            if ks == c.nptr:
                if ks >= 7:
                    c.ok = false
                    break
                c.ptrs[ks] = sbase
                c.nptr = ks + 1
            v_push(&c, 4, ks)
            c.depth = 0
        if rk > 0:
            c.minseq = -1
            let bop = 0
            if rk == 3:
                bop = 6
            elif rk == 4:
                bop = 5
            elif rk == 5:
                bop = 4
            for q in 0..nt:
                v_emit(&c, f, &inl, iv, terms[q])
                if q > 0:
                    v_push(&c, 3, bop)
                    c.depth = c.depth - 1
            if c.depth != 1:
                c.ok = false
        if !c.ok:
            continue
        /#/ with several stores, a buffer may be seen through a second pointer to it: only the headers of
        /#/ buffers that are reference parameters are known not to be offset views of each other
        if nstore > 1:
            for q in 0..c.nptr:
                let bq = c.ptrs[q]
                if f.op[bq] != int(Op.Load) || !deref_ok(f, f.a[bq]) || f.op[f.follow(f.a[bq])] != int(Op.Param):
                    ok = false
        /#/ nothing the loop makes is used after it (but i)
        for b in 0..nb:
            if inl[b] == 0:
                let j = f.bfirst[b]
                while j >= 0:
                    for q in 0..f.nval(j):
                        let x = f.val_at(j, q)
                        if x >= 0 && !v_outside(f, &inl, f.follow(x)) && f.follow(x) != iv && f.follow(x) != acc:
                            ok = false
                    j = f.nx[j]
        for e in 0..f.ne:
            if f.eto[e] >= 0 && f.efrom[e] >= 0 && f.efrom[e] < nb:
                for q in 0..f.eargn[e]:
                    let x = f.follow(f.pool[f.eargs[e] + q])
                    if inl[f.efrom[e]] == 0 || inl[f.eto[e]] == 0:
                        if !v_outside(f, &inl, x) && x != iv && x != acc && !(inl[f.efrom[e]] == 1 && inl[f.eto[e]] == 1):
                            ok = false
        if !ok:
            continue
        /#/ the entry: the checks, then the vector loop or the scalar one
        let pre = f.efrom[e0]
        let t = f.blast[pre]
        let i0 = f.follow(f.pool[f.eargs[e0] + ipos])
        let okv = -1
        for q in 0..nchk:
            f.set_block(pre)
            let cm = f.raw(int(Op.Cmp), int(Rp.I8), -1, n, checks[q], -1, int(Pr.SLe))
            link_before(f, cm, t)
            if okv < 0:
                okv = cm
            else:
                f.set_block(pre)
                let an = f.raw(int(Op.And), int(Rp.I8), -1, okv, cm, -1, 0)
                link_before(f, an, t)
                okv = an
        let vb = f.new_block()
        f.set_block(vb)
        let sl = -1
        if rk > 0:
            /#/ the accumulator goes through a slot of the frame: the loop reads it and writes the new value
            sl = f.slot(8)
            f.store(sl, acc0)
            f.arg(sl)
        f.arg(i0)
        f.arg(n)
        for q in 0..c.nptr:
            f.arg(c.ptrs[q])
        for q in 0..c.ninv:
            f.arg(c.invs[q])
        for q in 0..c.np:
            f.arg(f.cint(int(Rp.I64), c.prog[q]))
        let vl = f.vloop(lane | (rk << 4), c.nptr | (c.ninv << 8) | (c.np << 16))
        let accv = -1
        if rk > 0:
            accv = f.load(int(Rp.I64), -1, sl)
        if rk > 0 && ipos == 1:
            f.arg(accv)
        f.arg(vl)
        if rk > 0 && ipos == 0:
            f.arg(accv)
        f.br(h)
        unlink(f, t)
        f.set_block(pre)
        if okv < 0:
            cut_edge(f, e0)
            f.br(vb)
        else:
            let e1 = f.mk_edge(vb)
            f.condbr(okv, e1, e0)
        recount_uses(f)
        return true
    return false

/#/ ---- loop inversion ----------------------------------------------------------

/#/ The value `v` as seen from the end of a block that jumps to the loop header along edge `e`: a header
/#/ parameter is the edge's argument, a header instruction already copied is its copy.
fn inv_val(f: &Fun, v0: int, hpv: &buf<int>, nh: int, e: int, ks: &buf<int>, kd: &buf<int>, nk: int) => int:
    if v0 < 0:
        return v0
    let v = f.follow(v0)
    for q in 0..nh:
        if hpv[q] == v:
            return f.follow(f.pool[f.eargs[e] + q])
    for q in 0..nk:
        if ks[q] == v:
            return kd[q]
    return v

/#/ Replaces the jump `t` (along `e`) to a loop header by the header's test: copies of the header's
/#/ instructions, then a branch to the header along `e` when the test holds, else to `x` with `xa` as
/#/ the arguments of the exit (those of the old exit edge, then the header parameters used after the loop).
fn inv_site(f: &Fun, t: int, e: int, hterm: int, hpv: &buf<int>, nh: int, hi: &buf<int>, nhi: int, x: int, xa: &buf<int>, nxa: int, xp: &buf<int>, nxp: int, body_true: bool) => void:
    let blk = f.blk[t]
    let ks: buf<int> = new_buf(int, nhi + 1)
    let kd: buf<int> = new_buf(int, nhi + 1)
    for q in 0..nhi:
        let ins = hi[q]
        let a = inv_val(f, f.a[ins], hpv, nh, e, &ks, &kd, q)
        let b = inv_val(f, f.b[ins], hpv, nh, e, &ks, &kd, q)
        let c = inv_val(f, f.c[ins], hpv, nh, e, &ks, &kd, q)
        f.set_block(blk)
        let nw = f.raw(f.op[ins], f.rep[ins], f.ty[ins], a, b, c, f.aux[ins])
        link_before(f, nw, t)
        ks[q] = ins
        kd[q] = nw
    let cond = inv_val(f, f.a[hterm], hpv, nh, e, &ks, &kd, nhi)
    unlink(f, t)
    f.set_block(blk)
    for q in 0..nxa:
        f.arg(inv_val(f, xa[q], hpv, nh, e, &ks, &kd, nhi))
    for q in 0..nxp:
        f.arg(inv_val(f, hpv[xp[q]], hpv, nh, e, &ks, &kd, nhi))
    let e2 = f.mk_edge(x)
    if body_true:
        f.condbr(cond, e, e2)
    else:
        f.condbr(cond, e2, e)

/#/ A loop whose test is at the top (`while c` / `for`) is entered through the test and its body runs
/#/ only when the test held, so nothing in the body can be moved in front of the loop. Copying the test
/#/ in front of the loop and at each jump back makes the body the loop proper: its loads of what the loop
/#/ does not change can then be hoisted. Done for one loop that has such a load (and whose test is a
/#/ few plain instructions, with a single exit that nothing else enters); returns whether it did.
fn invert_loops(f: &Fun) => bool:
    if f.nb < 3:
        return false
    let nb = f.nb
    let rpo: buf<int> = new_buf(int, nb + 1)
    let idom: buf<int> = new_buf(int, nb + 1)
    let pc: buf<int> = new_buf(int, nb + 2)
    let pl: buf<int> = new_buf(int, f.ne + 1)
    let np = dominators(f, &rpo, &idom, &pc, &pl)
    let inl: buf<int> = new_buf(int, nb + 1)
    let work: buf<int> = new_buf(int, nb + 1)
    for k in 1..np:
        let h = rpo[k]
        let hterm = f.blast[h]
        if hterm < 0 || f.op[hterm] != int(Op.CondBr):
            continue
        /#/ the loop: the header and what reaches a jump back to it
        let nw = 0
        for q in 0..nb:
            inl[q] = 0
        inl[h] = 1
        for q in pc[h]..pc[h + 1]:
            let t = pl[q]
            let y = t
            while y != h && y != 0 && idom[y] >= 0 && idom[y] != y:
                y = idom[y]
            if y == h && inl[t] == 0:
                inl[t] = 1
                work[nw] = t
                nw = nw + 1
        if nw == 0:
            continue
        while nw > 0:
            nw = nw - 1
            let b = work[nw]
            for q in pc[b]..pc[b + 1]:
                let t = pl[q]
                if inl[t] == 0 && idom[t] >= 0:
                    inl[t] = 1
                    work[nw] = t
                    nw = nw + 1
        /#/ one way stays in the loop, the other leaves it to a block nothing else enters
        let et = f.b[hterm]
        let ef = f.c[hterm]
        if f.eto[et] < 0 || f.eto[ef] < 0:
            continue
        let in_t = inl[f.eto[et]] == 1
        let in_f = inl[f.eto[ef]] == 1
        if in_t == in_f:
            continue
        let ex = ef
        if !in_t:
            ex = et
        let x = f.eto[ex]
        if x == h || x == 0 || f.eargn[ex] != f.npar[x]:
            continue
        let nin = 0
        for e in 0..f.ne:
            if f.eto[e] == x:
                nin = nin + 1
        if nin != 1:
            continue
        /#/ the test: plain instructions only, a few
        let hi: buf<int> = new_buf(int, 8)
        let nhi = 0
        let ok = true
        let i = f.bfirst[h]
        while i >= 0 && ok:
            if i != hterm:
                if f.fwd[i] < 0:
                    if !pure_op(f.op[i]) || f.c[i] >= 0 && f.nval(i) > 3 || nhi >= 6:
                        ok = false
                    else:
                        hi[nhi] = i
                        nhi = nhi + 1
            i = f.nx[i]
        if !ok:
            continue
        /#/ the entries: one from outside ending in a plain jump, the jumps back plain too
        let e0 = -1
        let n0 = 0
        let nlatch = 0
        for e in 0..f.ne:
            if f.eto[e] == h && f.efrom[e] >= 0 && f.efrom[e] < nb:
                let fb = f.efrom[e]
                let tt = f.blast[fb]
                if inl[fb] == 1:
                    nlatch = nlatch + 1
                    if tt < 0 || f.op[tt] != int(Op.Br) || f.aux[tt] != e:
                        ok = false
                elif idom[fb] >= 0:
                    n0 = n0 + 1
                    e0 = e
                    if tt < 0 || f.op[tt] != int(Op.Br) || f.aux[tt] != e:
                        ok = false
        if !ok || n0 != 1 || nlatch == 0 || f.eargn[e0] != f.npar[h]:
            continue
        /#/ other ways out of the loop lead to a failed check only, which uses nothing the loop makes
        for b in 0..nb:
            if inl[b] == 1 && b != h && ok:
                for s in 0..f.nsucc(b):
                    let to = f.eto[f.succ_edge(b, s)]
                    if to >= 0 && inl[to] == 0:
                        let tb = f.blast[to]
                        if tb < 0 || f.op[tb] != int(Op.Unreachable):
                            ok = false
                        let j = f.bfirst[to]
                        while j >= 0:
                            for q in 0..f.nval(j):
                                let v = f.val_at(j, q)
                                if v >= 0 && f.blk[f.follow(v)] >= 0 && inl[f.blk[f.follow(v)]] == 1:
                                    ok = false
                            j = f.nx[j]
        if !ok:
            continue
        /#/ worth it: a load of something the loop does not change, in the body, that is not yet hoistable
        let mem = false
        let memf = false
        let memn = false
        let memw = false
        for b in 0..nb:
            if inl[b] == 1:
                let j = f.bfirst[b]
                while j >= 0:
                    if writes_memory(f, j):
                        let sc = store_class(f, j)
                        if sc == 1:
                            memf = true
                        elif sc == 2:
                            memn = true
                        elif sc == 3:
                            memw = true
                        else:
                            mem = true
                    j = f.nx[j]
        let gain = false
        for b in 0..nb:
            if inl[b] == 1 && b != h:
                let j = f.bfirst[b]
                while j >= 0:
                    if f.op[j] == int(Op.Load) && f.fwd[j] < 0 && !load_blocked(f, j, mem, memf, memn, memw) && !deref_ok(f, f.a[j]):
                        let ad = f.follow(f.a[j])
                        if f.blk[ad] < 0 || inl[f.blk[ad]] == 0:
                            gain = true
                    j = f.nx[j]
        if !gain:
            continue
        /#/ what the loop makes that is used after it: header instructions stop the transformation,
        /#/ header parameters get a parameter of the exit block
        let hpv: buf<int> = new_buf(int, f.npar[h] + 1)
        let nh = 0
        let pp = f.pfirst[h]
        while pp >= 0:
            hpv[nh] = pp
            nh = nh + 1
            pp = f.nx[pp]
        let used: buf<int> = new_buf(int, nh + 1)
        for b in 0..nb:
            if inl[b] == 0:
                let j = f.bfirst[b]
                while j >= 0:
                    for q in 0..f.nval(j):
                        let v = f.val_at(j, q)
                        if v >= 0:
                            let y = f.follow(v)
                            for r in 0..nh:
                                if hpv[r] == y:
                                    used[r] = 1
                            for r in 0..nhi:
                                if hi[r] == y:
                                    ok = false
                    j = f.nx[j]
        for e in 0..f.ne:
            if f.eto[e] >= 0 && f.efrom[e] >= 0 && f.efrom[e] < nb && inl[f.efrom[e]] == 0:
                for q in 0..f.eargn[e]:
                    let y = f.follow(f.pool[f.eargs[e] + q])
                    for r in 0..nh:
                        if hpv[r] == y:
                            used[r] = 1
                    for r in 0..nhi:
                        if hi[r] == y:
                            ok = false
        if !ok:
            continue
        let xp: buf<int> = new_buf(int, nh + 1)
        let nxp = 0
        for r in 0..nh:
            if used[r] == 1:
                xp[nxp] = r
                nxp = nxp + 1
        /#/ the exit's own arguments, as the header passed them
        let nxa = f.eargn[ex]
        let xa: buf<int> = new_buf(int, nxa + 1)
        for q in 0..nxa:
            xa[q] = f.follow(f.pool[f.eargs[ex] + q])
        /#/ new parameters of the exit block for the header parameters used after the loop
        let xnew: buf<int> = new_buf(int, nxp + 1)
        for q in 0..nxp:
            xnew[q] = f.param(x, f.rep[hpv[xp[q]]], f.ty[hpv[xp[q]]])
        /#/ the jumps to the header
        let sites: buf<int> = new_buf(int, nlatch + 2)
        let ns = 0
        for e in 0..f.ne:
            if f.eto[e] == h && f.efrom[e] >= 0 && f.efrom[e] < nb && (inl[f.efrom[e]] == 1 || e == e0):
                sites[ns] = e
                ns = ns + 1
        for q in 0..ns:
            let e = sites[q]
            inv_site(f, f.blast[f.efrom[e]], e, hterm, &hpv, nh, &hi, nhi, x, &xa, nxa, &xp, nxp, in_t)
        /#/ the header now falls into the body
        let body = et
        if !in_t:
            body = ef
        unuse(f, hterm)
        cut_edge(f, ex)
        f.op[hterm] = int(Op.Br)
        f.aux[hterm] = body
        f.a[hterm] = -1
        f.b[hterm] = -1
        f.c[hterm] = -1
        /#/ after the loop, the header parameters are the exit block's
        for b in 0..nb:
            if inl[b] == 0:
                let j = f.bfirst[b]
                while j >= 0:
                    for q in 0..f.nval(j):
                        let v = f.val_at(j, q)
                        if v >= 0:
                            let y = f.follow(v)
                            for r in 0..nxp:
                                if hpv[xp[r]] == y:
                                    f.set_val_at(j, q, xnew[r])
                    j = f.nx[j]
        for e in 0..f.ne:
            if f.eto[e] >= 0 && f.efrom[e] >= 0 && f.efrom[e] < nb && inl[f.efrom[e]] == 0 && f.eto[e] != x:
                for q in 0..f.eargn[e]:
                    let y = f.follow(f.pool[f.eargs[e] + q])
                    for r in 0..nxp:
                        if hpv[xp[r]] == y:
                            f.pool[f.eargs[e] + q] = xnew[r]
        recount_uses(f)
        return true
    return false

/#/ ---- block order -------------------------------------------------------------

/#/ An order of the blocks, in `ord` (all `nb` blocks): reverse post-order; with `rotate`, a loop's
/#/ header moved after its last block (the test is at the bottom, entered by one jump); and the blocks
/#/ that end in `unreachable` (the failed checks) at the end so the likely way is the fall-through.
fn block_order(f: &Fun, ord: &buf<int>, rotate: bool) => void:
    let nb = f.nb
    let rpo: buf<int> = new_buf(int, nb + 1)
    let idom: buf<int> = new_buf(int, nb + 1)
    let pc: buf<int> = new_buf(int, nb + 2)
    let pl: buf<int> = new_buf(int, f.ne + 1)
    let np = dominators(f, &rpo, &idom, &pc, &pl)
    let seen: buf<int> = new_buf(int, nb + 1)
    let hot: buf<int> = new_buf(int, nb + 1)
    let nh = 0
    for k in 0..np:
        let b = rpo[k]
        seen[b] = 1
        let t = f.blast[b]
        if k > 0 && t >= 0 && f.op[t] == int(Op.Unreachable):
            continue
        hot[nh] = b
        nh = nh + 1
    /#/ loops, outermost first (a header comes before the blocks it dominates in reverse post-order)
    let inl: buf<int> = new_buf(int, nb + 1)
    let work: buf<int> = new_buf(int, nb + 1)
    let rot: buf<int> = new_buf(int, nb + 1)
    for k in 1..np:
        let h = rpo[k]
        if rot[h] == 1 || !rotate:
            continue
        let t = f.blast[h]
        if t < 0 || f.op[t] != int(Op.CondBr):
            continue
        let nw = 0
        for q in 0..nb:
            inl[q] = 0
        inl[h] = 1
        for q in pc[h]..pc[h + 1]:
            let l = pl[q]
            let x = l
            while x != h && x != 0 && idom[x] >= 0 && idom[x] != x:
                x = idom[x]
            if x == h && inl[l] == 0:
                inl[l] = 1
                work[nw] = l
                nw = nw + 1
        if nw == 0:
            continue
        while nw > 0:
            nw = nw - 1
            let b = work[nw]
            for q in pc[b]..pc[b + 1]:
                let l = pl[q]
                if inl[l] == 0 && idom[l] >= 0:
                    inl[l] = 1
                    work[nw] = l
                    nw = nw + 1
        /#/ the last block of the loop in the order, and where the header is
        let last = -1
        let at = -1
        for q in 0..nh:
            if hot[q] == h:
                at = q
            if inl[hot[q]] == 1:
                last = q
        if at < 0 || last <= at:
            continue
        for q in at..last:
            hot[q] = hot[q + 1]
        hot[last] = h
        rot[h] = 1
    let n = 0
    for q in 0..nh:
        ord[n] = hot[q]
        n = n + 1
    for k in 1..np:
        let b = rpo[k]
        let t = f.blast[b]
        if t >= 0 && f.op[t] == int(Op.Unreachable):
            ord[n] = b
            n = n + 1
    for b in 0..nb:
        if seen[b] == 0:
            ord[n] = b
            n = n + 1

/#/ An `extract` of an aggregate that is now known to be built by `insert`s (a parameter that turned
/#/ out to be one value all along) becomes the value that was inserted.
fn fold_extracts(f: &Fun) => bool:
    let changed = false
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let nxt = f.nx[i]
            if f.op[i] == int(Op.Extract) && f.fwd[i] < 0:
                let g = f.follow(f.a[i])
                while f.op[g] == int(Op.Insert) && f.aux[g] != f.aux[i]:
                    g = f.follow(f.a[g])
                if f.op[g] == int(Op.Insert) && f.rep[f.follow(f.b[g])] == f.rep[i]:
                    let v = f.follow(f.b[g])
                    f.uses[v] = f.uses[v] + f.uses[i]
                    f.fwd[i] = v
                    unuse(f, i)
                    unlink(f, i)
                    changed = true
            i = nxt
    return changed

/#/ ---- aggregate loads -------------------------------------------------------

/#/ Puts the just-made `x` (at the end of its block) right before `i`.
fn link_before(f: &Fun, x: int, i: int) => void:
    unlink(f, x)
    let p = f.pv[i]
    f.blk[x] = f.blk[i]
    f.pv[x] = p
    f.nx[x] = i
    f.pv[i] = x
    if p >= 0:
        f.nx[p] = x
    else:
        f.bfirst[f.blk[i]] = x

/#/ A `load` of an aggregate that is only ever taken apart by `extract`s becomes a `load` of each
/#/ element (at the same place, so memory is read when it was); the copy to the frame goes.
fn split_loads(f: &Fun, rs: &Reps) => bool:
    let bad: buf<int> = new_buf(int, f.ni + 1)
    let base: buf<int> = new_buf(int, f.ni + 1)
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            for k in 0..f.nval(i):
                let v = f.val_at(i, k)
                if v >= 0:
                    let x = f.follow(v)
                    if f.op[x] == int(Op.Load) && f.rep[x] >= rp_first_agg() && !(f.op[i] == int(Op.Extract) && k == 0):
                        bad[x] = 1
            i = f.nx[i]
    for e in 0..f.ne:
        if f.eto[e] >= 0:
            for k in 0..f.eargn[e]:
                bad[f.follow(f.pool[f.eargs[e] + k])] = 1
    let any = false
    let el: buf<int> = new_buf(int, 16)
    let nel = 0
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let r = f.rep[i]
            if f.op[i] == int(Op.Load) && f.fwd[i] < 0 && r >= rp_first_agg() && bad[i] == 0:
                let n = rs.elems(r)
                let ok = n > 0
                for k in 0..n:
                    if rs.elem(r, k) >= rp_first_agg() || rs.elem(r, k) == int(Rp.Void):
                        ok = false
                if ok:
                    if nel + n > len(el):
                        el = buf_resize(el, (nel + n) * 2)
                    base[i] = nel + 1
                    f.cur = b
                    let p = f.follow(f.a[i])
                    for k in 0..n:
                        let a = p
                        let off = elem_off(rs, r, k)
                        if off != 0:
                            a = f.raw(int(Op.Field), int(Rp.Ptr), -1, p, -1, -1, off)
                            link_before(f, a, i)
                        let l = f.raw(int(Op.Load), rs.elem(r, k), -1, a, -1, -1, 0)
                        link_before(f, l, i)
                        el[nel + k] = l
                    nel = nel + n
                    any = true
            i = f.nx[i]
    if !any:
        return false
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let nxt = f.nx[i]
            if f.op[i] == int(Op.Extract) && f.fwd[i] < 0:
                let g = f.follow(f.a[i])
                if base[g] > 0:
                    let l = el[base[g] - 1 + f.aux[i]]
                    f.uses[l] = f.uses[l] + f.uses[i]
                    f.fwd[i] = l
                    unuse(f, i)
                    unlink(f, i)
            i = nxt
    return true

/#/ A `store` of an aggregate built by `insert`s of every element becomes a `store` of each element.
fn split_stores(f: &Fun, rs: &Reps) => bool:
    let any = false
    let vals: buf<int> = new_buf(int, 16)
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let nxt = f.nx[i]
            if f.op[i] == int(Op.Store) && f.fwd[i] < 0:
                let v = f.follow(f.b[i])
                let r = f.rep[v]
                if r >= rp_first_agg() && f.op[v] == int(Op.Insert):
                    let n = rs.elems(r)
                    if n > len(vals):
                        vals = buf_resize(vals, n * 2)
                    for k in 0..n:
                        vals[k] = -1
                    let g = v
                    while f.op[g] == int(Op.Insert):
                        let k = f.aux[g]
                        if k >= 0 && k < n && vals[k] < 0:
                            vals[k] = f.follow(f.b[g])
                        g = f.follow(f.a[g])
                    let ok = n > 0
                    for k in 0..n:
                        if vals[k] < 0 || rs.elem(r, k) >= rp_first_agg() || rs.elem(r, k) == int(Rp.Void) || f.rep[vals[k]] != rs.elem(r, k):
                            ok = false
                    if ok:
                        f.cur = b
                        let p = f.follow(f.a[i])
                        for k in 0..n:
                            let a = p
                            let off = elem_off(rs, r, k)
                            if off != 0:
                                a = f.raw(int(Op.Field), int(Rp.Ptr), -1, p, -1, -1, off)
                                link_before(f, a, i)
                            let st = f.raw(int(Op.Store), int(Rp.Void), -1, a, vals[k], -1, 0)
                            link_before(f, st, i)
                        delete_inst(f, i)
                        any = true
            i = nxt
    return any

/#/ ---- trap blocks ------------------------------------------------------------

/#/ Is block `b` only a call that does not return, ended by `unreachable` (a failed check)?
fn is_trap(f: &Fun, b: int) => bool:
    if b == 0 || f.npar[b] != 0:
        return false
    let c = f.bfirst[b]
    if c < 0 || f.op[c] != int(Op.CCall):
        return false
    let u = f.nx[c]
    return u >= 0 && f.op[u] == int(Op.Unreachable) && f.nx[u] < 0

fn same_trap(f: &Fun, b: int, c: int) => bool:
    let x = f.bfirst[b]
    let y = f.bfirst[c]
    if f.aux[x] != f.aux[y] || f.nval(x) != f.nval(y) || f.rep[x] != f.rep[y]:
        return false
    for k in 0..f.nval(x):
        if f.follow(f.val_at(x, k)) != f.follow(f.val_at(y, k)):
            return false
    return true

/#/ The failed checks of a function that make the same call are one block.
fn merge_traps(f: &Fun) => bool:
    let changed = false
    let canon: buf<int> = new_buf(int, f.nb + 1)
    let nc = 0
    for b in 1..f.nb:
        if is_trap(f, b):
            let into = -1
            for q in 0..nc:
                if into < 0 && same_trap(f, b, canon[q]):
                    into = canon[q]
            if into < 0:
                canon[nc] = b
                nc = nc + 1
            else:
                for e in 0..f.ne:
                    if f.eto[e] == b:
                        f.eto[e] = into
                        changed = true
    return changed

fn optimize(f: &Fun) => void:
    let rs = new_reps()
    optimize_rs(f, &rs, false)

/#/ The passes that only reshape the control flow, run until none of them has more to do: jumps
/#/ threaded, branches decided, traps shared, blocks that nothing reaches dropped, blocks joined.
fn cfg_cleanup(f: &Fun) => bool:
    let any = false
    let again = true
    let n = 0
    while again && n < 8:
        again = false
        if thread_jumps(f):
            again = true
        if fold_branches(f):
            again = true
        if merge_traps(f):
            again = true
        if drop_unreachable(f):
            again = true
            simplify_params(f)
        if merge_blocks(f):
            again = true
        if again:
            any = true
        n = n + 1
    return any

/#/ The passes that look at what the instructions compute.
/#/ The variable part of the integer add `i` whose other operand is a constant (that one in `k[0]`), else -1.
fn add_const_part(f: &Fun, i: int, k: &buf<int>) => int:
    if f.op[i] != int(Op.Add) || f.a[i] < 0 || f.b[i] < 0:
        return -1
    let x = f.follow(f.a[i])
    let y = f.follow(f.b[i])
    if f.is_const(y) && !f.is_const(x):
        k[0] = f.cval(y)
        return x
    if f.is_const(x) && !f.is_const(y):
        k[0] = f.cval(x)
        return y
    return -1

/#/ `(x + c1) + c2` becomes `x + (c1 + c2)`, so that an address computed by chained adds of constants
/#/ is one offset. The inner add stays for its other users, or goes dead.
fn reassoc_adds(f: &Fun) => bool:
    let changed = false
    let k1: buf<int> = new_buf(int, 2)
    let k2: buf<int> = new_buf(int, 2)
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            if f.op[i] == int(Op.Add) && rp_is_int(f.rep[i]) && f.fwd[i] < 0:
                let x = add_const_part(f, i, &k1)
                if x >= 0 && f.op[x] == int(Op.Add) && f.rep[x] == f.rep[i]:
                    let v = add_const_part(f, x, &k2)
                    if v >= 0:
                        let c = f.cint(f.rep[i], wrap(f.rep[i], k1[0] + k2[0]))
                        f.a[i] = v
                        f.b[i] = c
                        changed = true
            i = f.nx[i]
    if changed:
        recount_uses(f)
    return changed

fn value_passes(f: &Fun, rs: &Reps, split: bool) => bool:
    let changed = false
    if reassoc_adds(f):
        changed = true
    if fold_extracts(f):
        changed = true
    if split && split_loads(f, rs):
        changed = true
    if split && split_stores(f, rs):
        changed = true
    if cse_branches(f):
        changed = true
    if thread_forward(f):
        changed = true
    if thread_const_params(f):
        changed = true
    if range_checks(f):
        changed = true
    if hoist_invariants(f):
        changed = true
    if strength_reduce(f):
        changed = true
    if own_opt(f):
        changed = true
    if stack_alloc(f):
        changed = true
    if dead_code(f):
        changed = true
    if dead_params(f):
        changed = true
    return changed

fn optimize_rs(f: &Fun, rs: &Reps, split: bool) => void:
    fold_extracts(f)
    hoist_extracts(f)
    /#/ the control flow is put in order before each look at the values, so the passes that look at
    /#/ them are run again only when one of them changed something
    let round = 0
    let changed = true
    while changed && round < 3:
        cfg_cleanup(f)
        changed = value_passes(f, rs, split)
        round = round + 1
    if changed:
        cfg_cleanup(f)
        dead_code(f)
        dead_params(f)
    recount_uses(f)
