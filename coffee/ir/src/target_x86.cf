/#/ The x86-64 target: the facts the register allocator and the call code need about the machine,
/#/ in one place. Register numbers are the machine's (rax 0, rcx 1, rdx 2, rbx 3, rsi 6, rdi 7, r8..r15).
/#/ The allocator works on pool slots, the index into the pool table; the first `tg_ncaller()` slots
/#/ are the caller-saved ones, the rest are saved by the function that uses them.

/#/ The number of general registers the allocator may hand out.
fn tg_npool() => int:
    return 10

/#/ The register of pool slot `s`, in the order the allocator tries them: the caller-saved registers first
/#/ (r10, then r8 and r9, the registers of the fifth and sixth argument, then r11 and rdi), then the saved
/#/ ones (rbx, r12..r15).
fn tg_pool_reg(s: int) => int:
    let regs = [10, 8, 9, 11, 7, 3, 12, 13, 14, 15]
    return regs[s]

/#/ The pool as a table.
fn tg_pool() => buf<int>:
    let regs: buf<int> = new_buf(int, 10)
    for k in 0..10:
        regs[k] = tg_pool_reg(k)
    return regs

/#/ How many of the first pool slots a call may overwrite.
fn tg_ncaller() => int:
    return 5

/#/ The roles registers have in sandbox code. The code generator, the assembler and the verifier all read these.
/#/ Base-register form (`bm`): `tg_sbx_base` holds the start of the linear memory and nothing writes it. An
/#/ address is made in a register of the instruction's own (the destination of a load, or one of rax, rcx and
/#/ rdx that the access does not use) by a 32-bit `lea` just before the access, so no register is kept for it.
/#/ `tg_sbx_shadow` holds the base of the shadow frame (the bytes of locals whose address is taken).
fn tg_sbx_base() => int:
    return 15

fn tg_sbx_shadow() => int:
    return 14

/#/ Is pool slot `s` kept for something else in sandboxed code (`sbx` without `bm`: the shadow frame register; `bm`, the
/#/ base-register form: the memory base)?
fn tg_reserved(sbx: bool, bm: bool, s: int) => bool:
    let r = tg_pool_reg(s)
    if sbx && !bm && r == tg_sbx_shadow():
        return true
    return bm && r == tg_sbx_base()

/#/ The bit that register `r` has in a call's write mask; the pool register of slot 0 (r10) has bit 0.
fn tg_call_bit(r: int) => int:
    if r == 8:
        return 1
    if r == 9:
        return 2
    if r == 11:
        return 3
    if r == 7:
        return 4
    return 0

/#/ Is `r` one of the registers a call may overwrite, apart from the scratch ones?
fn tg_is_caller_saved(r: int) => bool:
    return r == 7 || r == 8 || r == 9 || r == 10 || r == 11

/#/ The write mask of a call of a function not seen yet: every caller-saved pool register.
fn tg_mask_all() => int:
    return 31

/#/ The mask bits of the registers that carry the integer arguments past the fourth (r8 and r9)
/#/ and the aggregate argument or result (rdi).
fn tg_mask_arg5() => int:
    return 2

fn tg_mask_arg6() => int:
    return 4

fn tg_mask_rdi() => int:
    return 16

/#/ The first float register the allocator hands out (xmm0 and xmm1 are scratch), and the first of
/#/ those that carry the float parameters and arguments (xmm8..xmm15; a value there never lives
/#/ across a call or the entry).
fn tg_xmm_first() => int:
    return 2

fn tg_xmm_arg_first() => int:
    return 8

/#/ The Win64 calling convention instead of System V's (`--target=x86_64-windows`; `x86_64-linux-ms` is the same convention
/#/ in an ELF object, so that it can be tested against gcc's `ms_abi` functions on Linux). The first four arguments of any kind
/#/ go in rcx, rdx, r8, r9 or xmm0..xmm3 by their position, the caller leaves 32 bytes of shadow space below the stack arguments,
/#/ rsi, rdi and xmm6..xmm15 are the callee's to keep (the code does that in the functions C may call: the `c fn`s).
let win64_abi = false

fn set_win64(on: bool) => void:
    win64_abi = on

fn tg_win64() => bool:
    return win64_abi

/#/ The number of arguments that travel in integer registers, and in xmm registers.
fn tg_int_args() => int:
    if win64_abi:
        return 4
    return 6

fn tg_xmm_args() => int:
    if win64_abi:
        return 4
    return 8

/#/ The bytes between the return address and the first stack argument.
fn tg_shadow() => int:
    if win64_abi:
        return 32
    return 0
