/#/ The last rewrite of a function before the machine code is made, on the function itself: what
/#/ every target would otherwise do the same way becomes the ordinary form (see
/#/ docs/explanation/ir-lowering-design.md). `.cir` files hold the function before this runs, so
/#/ one file serves every target.
use * in fun
use * in names
use * in rep
use * in txt

/#/ Turns the instruction `i` into a C call of `name` with the operands `x`, `y` (-1: none).
fn lz_to_ccall(f: &Fun, sy: &Names, i: int, name: &str, x: int, y: int) => void:
    let w = new_txt()
    w.put(name)
    let id = sy.intern(&w)
    f.bump_uses(i, 0 - 1)
    let n = 0
    let start = f.np
    if x >= 0:
        f.pool_put(x)
        n = n + 1
    if y >= 0:
        f.pool_put(y)
        n = n + 1
    f.op[i] = int(Op.CCall)
    f.ty[i] = n
    f.a[i] = start
    f.b[i] = n
    f.c[i] = 0
    f.aux[i] = id
    f.bump_uses(i, 1)

/#/ The multiplier that divides by `d` (not a power of two; `l` is the log2 of `d` rounded up):
/#/ 1 + floor(2^(63 + l) / d), taken as a 64-bit pattern, by long division one bit at a time.
fn magic_mult(d: int, l: int) => int:
    let q = 0
    let r = 0
    let bit = 63 + l
    while bit >= 0:
        r = r * 2
        if bit == 63 + l:
            r = r + 1
        if r >= d:
            r = r - d
            if bit < 64:
                q = q | (1 << bit)
        bit = bit - 1
    return q + 1

/#/ The multiplier of the unsigned division by `d` (not a power of two; `l` is the log2 of `d` rounded
/#/ up) without its 65th bit: floor(2^64 * (2^l - d) / d) + 1, by long division one bit at a time.
fn magic_umult(d: int, l: int) => int:
    let q = 0
    let r = (1 << l) - d
    for bit in 0..64:
        r = r * 2
        q = q * 2
        if r >= d:
            r = r - d
            q = q + 1
    return q + 1

/#/ A new instruction of the integer operation `op` just before `i`, in the block of `i`.
fn lz_before(f: &Fun, i: int, op: int, x: int, y: int) => int:
    let n = f.mk(op, int(Rp.I64), 0 - 1, x, y, 0 - 1, 0)
    let p = f.pv[i]
    f.nx[n] = i
    f.pv[n] = p
    f.pv[i] = n
    if p >= 0:
        f.nx[p] = n
    else:
        f.bfirst[f.blk[i]] = n
    f.blk[n] = f.blk[i]
    return n

/#/ Makes `i` the instruction `op x, y`.
fn lz_become(f: &Fun, i: int, op: int, x: int, y: int) => void:
    f.op[i] = op
    f.a[i] = x
    f.b[i] = y
    f.c[i] = 0 - 1
    f.aux[i] = 0
    f.bump_uses(i, 1)

/#/ A 64-bit division or remainder `i` by the constant `d` >= 2, without a divide instruction.
/#/ Signed: x + (d - 1 when x is negative), shifted, for a power of two; else
/#/ q = (mulhi(m, x) + x >> (l - 1)) - (x >> 63) with m = 1 + floor(2^(63 + l) / d). Unsigned:
/#/ a shift or a mask for a power of two; else q = (t + ((x - t) >> 1)) >> (l - 1) with t = the high
/#/ half of x * m.
fn lz_divconst(f: &Fun, i: int, d: int) => void:
    let o = f.op[i]
    let signed = o == int(Op.SDiv) || o == int(Op.SRem)
    let rem = o == int(Op.SRem) || o == int(Op.URem)
    let pow2 = (d & (d - 1)) == 0
    let k = 0
    while (1 << k) < d:
        k = k + 1
    let x = f.follow(f.a[i])
    let i64 = int(Rp.I64)
    f.bump_uses(i, 0 - 1)
    f.line = f.ln[i]
    if !signed && pow2:
        if rem:
            lz_become(f, i, int(Op.And), x, f.cint(i64, d - 1))
        else:
            lz_become(f, i, int(Op.LShr), x, f.cint(i64, k))
        return
    if !signed && !pow2:
        /#/ q = (t + ((x - t) >> 1)) >> (k - 1) with t = mulhu(x, m) and m = 2^64 * (2^k - d) / d + 1
        let t = lz_before(f, i, int(Op.UMulHi), x, f.cint(i64, magic_umult(d, k)))
        let df = lz_before(f, i, int(Op.Sub), x, t)
        let hf = lz_before(f, i, int(Op.LShr), df, f.cint(i64, 1))
        let sm = lz_before(f, i, int(Op.Add), t, hf)
        if rem:
            let q1 = lz_before(f, i, int(Op.LShr), sm, f.cint(i64, k - 1))
            let p1 = lz_before(f, i, int(Op.Mul), q1, f.cint(i64, d))
            lz_become(f, i, int(Op.Sub), x, p1)
        else:
            lz_become(f, i, int(Op.LShr), sm, f.cint(i64, k - 1))
        return
    let q = 0
    if pow2:
        let s = lz_before(f, i, int(Op.AShr), x, f.cint(i64, 63))
        let u = lz_before(f, i, int(Op.LShr), s, f.cint(i64, 64 - k))
        let t = lz_before(f, i, int(Op.Add), u, x)
        if rem:
            let q2 = lz_before(f, i, int(Op.AShr), t, f.cint(i64, k))
            let sh = lz_before(f, i, int(Op.Shl), q2, f.cint(i64, k))
            lz_become(f, i, int(Op.Sub), x, sh)
        else:
            lz_become(f, i, int(Op.AShr), t, f.cint(i64, k))
        return
    let h = lz_before(f, i, int(Op.SMulHi), x, f.cint(i64, magic_mult(d, k)))
    let t = lz_before(f, i, int(Op.Add), h, x)
    let t2 = lz_before(f, i, int(Op.AShr), t, f.cint(i64, k - 1))
    let s = lz_before(f, i, int(Op.AShr), x, f.cint(i64, 63))
    if rem:
        q = lz_before(f, i, int(Op.Sub), t2, s)
        let p = lz_before(f, i, int(Op.Mul), q, f.cint(i64, d))
        lz_become(f, i, int(Op.Sub), x, p)
    else:
        lz_become(f, i, int(Op.Sub), t2, s)

/#/ The `Switch` that ends block `b` (instruction `i`) becomes a chain of tests: each block compares
/#/ the value with one case and branches to that case's edge or to the next test; the last one
/#/ falls to the default. The edges keep their arguments; they leave from the new blocks now.
fn lz_switch(f: &Fun, b: int, i: int) => void:
    let n = f.b[i]
    let d = f.c[i]
    let start = f.aux[i]
    let v = f.follow(f.a[i])
    f.bump_uses(i, 0 - 1)
    f.line = f.ln[i]
    if n == 0:
        f.op[i] = int(Op.Br)
        f.a[i] = 0 - 1
        f.b[i] = 0 - 1
        f.c[i] = 0 - 1
        f.aux[i] = d
        return
    let rep = f.rep[v]
    let tb = b
    for k in 0..n:
        f.cur = tb
        let cst = f.cint(rep, f.pool[start + k * 2])
        let hit = f.pool[start + k * 2 + 1]
        let cm = f.mk(int(Op.Cmp), int(Rp.I8), 0 - 1, v, cst, 0 - 1, int(Pr.Eq))
        let other = d
        let nxt = 0 - 1
        if k < n - 1:
            nxt = f.new_block()
            f.cur = tb
            other = f.mk_edge(nxt)
        f.efrom[hit] = tb
        f.efrom[other] = tb
        if k == 0:
            /#/ the test goes before the terminator, which is reused as the branch
            let p = f.pv[i]
            f.nx[cm] = i
            f.pv[cm] = p
            f.pv[i] = cm
            if p >= 0:
                f.nx[p] = cm
            else:
                f.bfirst[b] = cm
            f.blk[cm] = b
            f.op[i] = int(Op.CondBr)
            f.a[i] = cm
            f.b[i] = hit
            f.c[i] = other
            f.aux[i] = 0
            f.bump_uses(i, 1)
        else:
            f.link(cm)
            f.raw(int(Op.CondBr), int(Rp.Void), 0 - 1, cm, hit, other, 0)
        tb = nxt

/#/ `Switch` becomes a chain of tests; `Alloc`, `Free` and `FRem` become calls of `malloc`, `free` and `fmod`.
fn legalize(f: &Fun, sy: &Names) => void:
    let nb0 = f.nb
    for b in 0..nb0:
        let t = f.blast[b]
        if t >= 0 && f.op[t] == int(Op.Switch):
            lz_switch(f, b, t)
    for b in 0..f.nb:
        let i = f.bfirst[b]
        while i >= 0:
            let o = f.op[i]
            if o == int(Op.Alloc):
                let sz = f.cint(int(Rp.I64), f.ty[i])
                lz_to_ccall(f, sy, i, "malloc", sz, -1)
            elif o == int(Op.Free):
                lz_to_ccall(f, sy, i, "free", f.a[i], -1)
            elif o == int(Op.SDiv) || o == int(Op.SRem) || o == int(Op.UDiv) || o == int(Op.URem):
                let y = f.follow(f.b[i])
                if f.rep[i] == int(Rp.I64) && f.op[y] == int(Op.Const) && f.rep[y] == int(Rp.I64) && f.aux[y] >= 2 && f.aux[y] <= 2147483647:
                    lz_divconst(f, i, f.aux[y])
            elif o == int(Op.FRem):
                if f.rep[i] == int(Rp.F32):
                    lz_to_ccall(f, sy, i, "fmodf", f.a[i], f.b[i])
                else:
                    lz_to_ccall(f, sy, i, "fmod", f.a[i], f.b[i])
            i = f.nx[i]
