/#/ Functions C calls (c fn) and C functions they call, in the Win64 convention.
use c_sum10, c_mix, c_vsum, c_vsumd, c_id in cmod of c

c fn cf_sum10(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int, i: int, j: int) => int:
    return a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + g * 7 + h * 8 + i * 9 + j * 10

c fn cf_mix(a: int, x: float(8), b: int, y: float(8), c: int, z: float(8), d: float(8), e: int) => float(8):
    return float(a) + x * 2.0 + float(b) * 3.0 + y * 4.0 + float(c) * 5.0 + z * 6.0 + d * 7.0 + float(e) * 8.0

c fn cf_f32(a: float(4), b: int, c: float(4)) => float(4):
    return a * f32(float(b)) + c

/#/ many values alive across calls and floats in registers: whatever the function uses, rsi, rdi, rbx, r12..r15 and xmm6..xmm15 must come back
c fn cf_busy(a: int, b: int, c: int, d: int) => int:
    let s = c_id(a) + c_id(b) * 2
    let t = c_id(c) * 3 + c_id(d) * 4
    let x = float(a) * 1.5 + float(b)
    let y = float(c) * 2.5 + float(d)
    let u = c_id(s + t)
    return s + t + u + int(x * y)

c fn cf_call_c(n: int) => int:
    let a = c_sum10(n, 2, 3, 4, 5, 6, 7, 8, 9, n + 10)
    let m = int(c_mix(n, 1.5, 2, 2.5, 3, 3.5, 4.5, 4))
    let v = c_vsum(4, n, 20, 30, 40)
    let w = int(c_vsumd(3, 1.5, 2.5, float(n)))
    return a + m * 1000 + v * 100000 + w * 10000000

/#/ a frame of two pages: on Windows it is touched page by page
