/#/ Floats of both widths: arithmetic, conversions, comparisons (with NaN), arguments past the register count.
use write in libc of c

fn out(s: str) => void:
    write(1, s, len(s))

fn many(a: float, b: float, c: float, d: float, e: float, f: float, g: float, h: float, i: float, j: float, k: int, l: float(4)) => float:
    return a + b * 2.0 + c * 3.0 + d * 4.0 + e * 5.0 + f * 6.0 + g * 7.0 + h * 8.0 + i * 9.0 + j * 10.0 + float(k) + float(l)

fn mixed(a: int, b: float, c: int, d: float, e: int, f: float, g: int, h: float, i: int, j: float, k: int, l: float, m: int, n: float, o: int, p: float, q: int, r: float, s: int) => float:
    return float(a + c * 2 + e * 3 + g * 4 + i * 5 + k * 6 + m * 7 + o * 8 + q * 9 + s * 10) + b + d * 2.0 + f * 3.0 + h * 4.0 + j * 5.0 + l * 6.0 + n * 7.0 + p * 8.0 + r * 9.0

fn cmps(x: float, y: float) => int:
    let h = 0
    if x < y:
        h = h + 1
    if x <= y:
        h = h + 2
    if x > y:
        h = h + 4
    if x >= y:
        h = h + 8
    if x == y:
        h = h + 16
    if x != y:
        h = h + 32
    let b: bool = x < y
    if b:
        h = h + 64
    let c: bool = x == y
    if c:
        h = h + 128
    let d: bool = x != y
    if d:
        h = h + 256
    return h

fn conv(x: float) => int:
    let i: int = int(x)
    let f: float(4) = f32(x)
    let g: float = float(f)
    return i * 7 + int(g * 100.0)

fn main() => int:
    let r = many(1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5, 8.5, 9.5, 10.5, 11, 0.25)
    out(f"{r}\n")
    let m = mixed(1, 1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5, 5.5, 6, 6.5, 7, 7.5, 8, 8.5, 9, 9.5, 10)
    out(f"{m}\n")
    let nan = 0.0 / 0.0
    let inf = 1.0 / 0.0
    let h = 0
    h = h * 31 + cmps(1.0, 2.0)
    h = h * 31 + cmps(2.0, 1.0)
    h = h * 31 + cmps(2.0, 2.0)
    h = h * 31 + cmps(nan, 1.0)
    h = h * 31 + cmps(1.0, nan)
    h = h * 31 + cmps(nan, nan)
    h = h * 31 + cmps(inf, 1.0)
    h = h * 31 + cmps(-inf, inf)
    h = h * 31 + conv(3.99)
    h = h * 31 + conv(-3.99)
    h = h * 31 + conv(123456.789)
    let s: float = 0.0
    let t: float(4) = 0.0
    for i in 0..100:
        s = s + float(i) * 0.5 - s / 3.0
        t = t + f32(i) * f32(0.25)
    out(f"{s} {float(t)}\n")
    h = h * 31 + int(s * 1000.0) + int(t)
    let neg: float = -s
    out(f"{neg}\n")
    out(f"{h}\n")
    return h % 251
