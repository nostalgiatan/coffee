/#/ Benchmark driver: each program through our front end and IR, with the optimizer off and on,
/#/ written as LLVM text; prints how long that part takes. Run by bench/run.sh.
use * in say
use * in drive
use time, fflush, fopen, fputc, fclose in libc of c

fn prog(k: int) => str:
    if k == 0:
        return "fn fib(n: int) => int:\n    if n < 2:\n        return n\n    return fib(n - 1) + fib(n - 2)\n\nfn main() => int:\n    return fib(38) % 256\n"
    if k == 1:
        return "class Acc:\n    t: int\n\n    fn add(self, x: int) => void:\n        self.t = self.t + x\n\nfn sq(x: int) => int:\n    return x * x % 7\n\nfn main() => int:\n    let a = Acc { t: 0 }\n    for i in 0..400000000:\n        a.add(sq(i))\n    return a.t % 256\n"
    return "fn main() => int:\n    let n = 20000000\n    let s: buf<int> = new_buf(int, n)\n    let c = 0\n    for i in 2..n:\n        if s[i] == 0:\n            c = c + 1\n            let j = i * 2\n            while j < n:\n                s[j] = 1\n                j = j + i\n    return c % 256\n"

fn path_of(k: int, opt: int) => str:
    if k == 0:
        if opt == 0:
            return "/tmp/claude_bench_0_0.ll"
        return "/tmp/claude_bench_0_1.ll"
    if k == 1:
        if opt == 0:
            return "/tmp/claude_bench_1_0.ll"
        return "/tmp/claude_bench_1_1.ll"
    if opt == 0:
        return "/tmp/claude_bench_2_0.ll"
    return "/tmp/claude_bench_2_1.ll"

fn write_ll(path: str, m: &Txt) => void:
    let fp = fopen(path, "w")
    for k in 0..m.n:
        fputc(m.b[k], fp)
    fclose(fp)

/#/ Builds program `k` `reps` times and writes the text of the first build.
fn time_one(k: int, opt: int, reps: int) => int:
    let m = build_src(prog(k), opt)
    let size = m.n
    write_ll(path_of(k, opt), &m)
    let t0 = time(0)
    for r in 0..reps:
        let x = build_src(prog(k), opt)
        size = x.n
    let t1 = time(0)
    say(f"front+ir prog {k} opt {opt}: {reps} runs in {t1 - t0} s, {size} bytes of IR text\n")
    fflush(0)
    return t1 - t0

fn main() => int:
    let reps = 300
    for k in 0..3:
        time_one(k, 0, reps)
        time_one(k, 1, reps)
    return 0
