/#/ Sandbox code for riscv64 (`cfjit --target=riscv64 --sandbox`, an riscv64 `cfjit` run by `qemu-riscv64`): the cases of
/#/ test_sandbox_base.cf on small programs written to a scratch directory, but for the division by zero (riscv64 does
/#/ not trap) and the numbers of the system calls. The test builds that `cfjit` itself (from the sources of the jit directory and the other
/#/ stages; the test runs in target/test/<name>) and passes when `qemu-riscv64` is not installed. `coffee2` is found through PATH. Programs that work give the result they give natively; programs
/#/ that reach outside the sandbox, divide by zero or run out of stack end in a trap (exit 139 and
/#/ the signal on stderr); an address with high bits set is the same address as without them.
use * in say
use * in txt
use * in cstr
use * in files
use system, fflush in libc of c

fn expect(what: int, got: int, want: int) => int:
    if got != want:
        say(f"MISS #{what}: got {got}, want {want}\n")
        fflush(0)
        return 1
    return 0

/#/ Writes `src` as a program and runs it in the sandbox: its exit code. The stderr is left in `sbb.err`.
fn run_sbx_with(src: str, opts: str) => int:
    write_file(&txt_of("sbb.cf"), &txt_of(&src))
    if system("coffee2 sbb.cf --emit-cir --target=riscv64 -o sbb.cir > sbb.log 2>&1") != 0:
        return -1
    let c = txt_of("qemu-riscv64 ./sbb_cfjit sbb.cir --target=riscv64 --sandbox=base ")
    c.put(&opts)
    c.put(" > sbb.out 2>&1")
    let st = system(txt_str(&c))
    return (st >> 8) & 255

fn run_sbx(src: str) => int:
    return run_sbx_with(src, "")

fn out_is(want: str) => int:
    let c = txt_of("test \"$(cat sbb.out)\" = '")
    c.put(&want)
    c.put("'")
    return system(txt_str(&c))

fn trapped(sig: str) => int:
    let c = txt_of("grep -q 'trapped (signal ")
    c.put(&sig)
    c.put(")' sbb.out")
    return system(txt_str(&c))

fn main() => int:
    let m = 0
    if system("which qemu-riscv64 > /dev/null 2>&1") != 0:
        return 0
    let inc = "-I ../../../src -I ../../../../driver/src -I ../../../../ir/src -I ../../../../ld/src -I ../../../../own/src -I ../../../../types/src -I ../../../../sema/src -I ../../../../parser/src -I ../../../../lexer/src"
    let build = txt_of("coffee2 ../../../src/main.cf ")
    build.put(&inc)
    build.put(" --static --target=riscv64 -o sbb_cfjit > sbb.build 2>&1")
    if system(txt_str(&build)) != 0:
        say("MISS: the riscv64 cfjit did not build\n")
        return 1
    m = m + expect(1, run_sbx("fn fib(n: int) => int:\n    if n < 2:\n        return n\n    return fib(n - 1) + fib(n - 2)\n\nfn main() => int:\n    return fib(10)\n"), 55)
    m = m + expect(2, run_sbx("let counter = 0\n\nfn bump() => void:\n    counter = counter + 1\n\nfn main() => int:\n    bump()\n    bump()\n    bump()\n    return counter\n"), 3)
    /#/ the heap: an array
    m = m + expect(3, run_sbx("fn main() => int:\n    let a = [3, 4, 5, 6]\n    let t = 0\n    for i in 0..4:\n        t = t + a[i]\n    return t\n"), 18)
    /#/ a value the code borrows mutably
    m = m + expect(4, run_sbx("fn inc(x: &mut int) => void:\n    *x = *x + 5\n\nfn main() => int:\n    let v = 10\n    inc(&mut v)\n    inc(&mut v)\n    return v\n"), 20)
    /#/ a string literal
    m = m + expect(5, run_sbx("fn pick(s: &str, i: int) => int:\n    return int(s[i])\n\nfn main() => int:\n    return pick(\"hello\", 1)\n"), 101)
    /#/ exit, here from a failed bounds check
    m = m + expect(6, run_sbx("fn main() => int:\n    let a = [1, 2]\n    let i = 5\n    return a[i]\n"), 1)
    /#/ the null page, an address far away, a division by zero, an endless recursion
    m = m + expect(7, run_sbx("fn main() => int:\n    return peek8(16)\n"), 139)
    m = m + expect(8, trapped("11"), 0)
    m = m + expect(9, run_sbx("fn main() => int:\n    return peek8(1048576 * 1024 * 1024 * 8)\n"), 139)
    m = m + expect(12, run_sbx("fn deep(n: int) => int:\n    return deep(n + 1) * 3\n\nfn main() => int:\n    return deep(0)\n"), 139)
    m = m + expect(13, trapped("11"), 0)
    /#/ a recursion that is a loop uses no stack: it ends at the CPU limit like any endless loop
    m = m + expect(61, run_sbx_with("fn deep(n: int) => int:\n    return deep(n + 1) + 1\n\nfn main() => int:\n    return deep(0)\n", "--cpu=100"), 139)
    /#/ the high bits of an address do not matter: 4294967296 + 65600 is 65600
    m = m + expect(14, run_sbx("fn main() => int:\n    poke8(65600, 7)\n    poke8(4294967296 + 65600, 9)\n    return peek8(65600)\n"), 9)
    /#/ a system call other than exit and mmap fails, and the module is not stopped
    m = m + expect(15, run_sbx("fn main() => int:\n    let r = syscall(39, 0, 0, 0, 0, 0, 0)\n    if r < 0:\n        return 4\n    return 5\n"), 4)
    /#/ write: the bytes arrive; a stream that is not allowed, and a buffer outside the memory, fail
    let w = "fn main() => int:\n    let s = \"hi\\n\"\n    return syscall(64, 1, int(s as object), 3)\n"
    m = m + expect(16, run_sbx(clone w), 3)
    m = m + expect(17, out_is("hi"), 0)
    m = m + expect(18, run_sbx_with(clone w, "--allow=stderr"), 247)
    m = m + expect(19, run_sbx_with(clone w, "--allow=stdout,stderr"), 3)
    m = m + expect(20, run_sbx("fn main() => int:\n    return syscall(64, 1, 65600, 4294967296, 0, 0) + 100\n"), 86)
    m = m + expect(21, run_sbx("fn main() => int:\n    return syscall(64, 1, 4294967290, 100, 0, 0) + 100\n"), 86)
    m = m + expect(22, run_sbx("fn main() => int:\n    return syscall(64, 77, 65600, 1, 0, 0) + 100\n"), 91)
    /#/ the quotas: an endless loop ends at the CPU limit (SIGALRM, 14), a big array needs more heap than --mem gives
    m = m + expect(23, run_sbx_with("fn main() => int:\n    let i = 0\n    while true:\n        i = i + 1\n    return i\n", "--cpu=100"), 139)
    m = m + expect(24, trapped("14"), 0)
    let big = "fn main() => int:\n    let a = new_buf(int, 400000)\n    a[399999] = 7\n    return a[399999]\n"
    m = m + expect(25, run_sbx_with(clone big, "--mem=8"), 7)
    m = m + expect(26, run_sbx_with(clone big, "--mem=1"), 139)
    m = m + expect(27, trapped("11"), 0)
    /#/ the image cache: the second run uses the file, a damaged file is not used
    let fib = "fn fib(n: int) => int:\n    if n < 2:\n        return n\n    return fib(n - 1) + fib(n - 2)\n\nfn main() => int:\n    return fib(12)\n"
    system("rm -f sbb.cir.sbxb.rv64.cim")
    m = m + expect(29, run_sbx_with(clone fib, "--cache"), 144)
    m = m + expect(30, system("test -s sbb.cir.sbxb.rv64.cim"), 0)
    m = m + expect(31, run_sbx_with(clone fib, "--cache"), 144)
    system("printf X | dd of=sbb.cir.sbxb.rv64.cim bs=1 seek=200 conv=notrunc 2>/dev/null")
    m = m + expect(32, run_sbx_with(clone fib, "--cache"), 144)
    /#/ a cache made for other code is not used
    /#/ an aggregate parameter is copied while the 3rd and 4th arguments are still in rdx and rcx
    m = m + expect(62, run_sbx("class P:\n    a: int\n    b: int\n\nfn f(p: P, s: int, x: int, y: int) => int:\n    return p.a * 1000 + p.b * 100 + s * 10 + x - y\n\nfn main() => int:\n    return f(P { a: 1, b: 2 }, 3, 7, 5) - 1232\n"), 0)
    m = m + expect(33, run_sbx_with("fn main() => int:\n    return 7\n", "--cache"), 7)
    /#/ host functions: integers through, a buffer changed in place, a pointer returned as an offset, a range outside the memory a trap
    write_file(&txt_of("sbl.cfc"), &txt_of("c fn host_add(a: int, b: int) => int:\nc fn host_upper(p: int, n: int) => int:\nc fn host_echo(p: int) => int:\n"))
    write_file(&txt_of("sbl.cf"), &txt_of("c fn host_add(a: int, b: int) => int:\n    return a + b\n\nc fn host_upper(p: int, n: int) => int:\n    let t = 0\n    for i in 0..n:\n        let c = peek8((p + i) as object)\n        if c >= 97 && c <= 122:\n            poke8((p + i) as object, c - 32)\n        t = t + c\n    return t\n\nc fn host_echo(p: int) => int:\n    return p\n"))
    if system("coffee2 sbl.cf -I . --emit-cir --target=riscv64 -o sbl.cir > sbb.log 2>&1") != 0:
        say("MISS: the host library did not build\n")
        return m + 1
    let hs = "--with=sbl.cir --host=host_add=ii:i --host=host_upper=pl:i --host=host_echo=i:i"
    let hp = "use host_add, host_upper, host_echo in sbl of c\n\nfn main() => int:\n    let b = new_buf(int, 2)\n    let pp = int(buf_ptr(b))\n    poke8(pp as object, 104)\n    poke8((pp + 1) as object, 105)\n    return "
    m = m + expect(63, run_sbx_with(hp + "host_add(20, 22)\n", clone hs), 42)
    m = m + expect(64, run_sbx_with(hp + "host_upper(pp, 2) - 209 + peek8(pp as object) - 72 + peek8((pp + 1) as object) - 73\n", clone hs), 0)
    m = m + expect(65, run_sbx_with(hp + "host_echo(pp + 4294967296) - pp\n", clone hs), 0)
    m = m + expect(66, run_sbx_with(hp + "host_upper(16, 2)\n", clone hs), 139)
    m = m + expect(67, trapped("11"), 0)
    m = m + expect(68, run_sbx_with(hp + "host_upper(pp, 99999999999)\n", clone hs), 139)
    m = m + expect(69, run_sbx_with(hp + "host_add(1, 2) + host_echo(0)\n", "--with=sbl.cir --host=host_add=ii:i"), 2)
    system("rm -f sbl.cf sbl.cfc sbl.cir")
    system("rm -f sbb_cfjit sbb.build sbb.cf sbb.cir sbb.cir.sbxb.rv64.cim sbb.log sbb.out")
    return m
