/#/ The loader: puts a flat image into memory the code can run from and calls into it. There is no
/#/ linker and no dynamic loader in between; the image was made position independent when it was
/#/ generated, so loading is a copy.
use * in image
use * in files

/#/ `mmap` flags: private and anonymous; protections: read, write, execute
fn load_flags() => int:
    return 34

fn load_prot() => int:
    return 7

fn page_round(n: int) => int:
    return (n + 4095) // 4096 * 4096

/#/ Is `r` is an address the kernel gave
fn mapped(r: int) => bool:
    return r > 0 || r < -4095

/#/ The image in memory: its address, or 0 when the system refused.
fn load_image(im: &Image) => int:
    let base = syscall(9, 0, page_round(im.b.n + 1), load_prot(), load_flags(), 0 - 1, 0)
    if !mapped(base):
        return 0
    copy_in(base, &im.b)
    return base

/#/ Like `load_image`, at the address `want` (0 when it is taken); for `--gdb`, so the addresses are known.
fn load_image_at(im: &Image, want: int) => int:
    /#/ MAP_FIXED_NOREPLACE
    let base = syscall(9, want, page_round(im.b.n + 1), load_prot(), load_flags() + 1048576, 0 - 1, 0)
    if !mapped(base) || base != want:
        return 0
    copy_in(base, &im.b)
    return base

/#/ The bytes of `t` to the memory at `base`.
fn copy_in(base: int, t: &Txt) => void:
    let k = 0
    while k + 8 <= t.n:
        let w = 0
        for q in 0..8:
            w = w | (t.b[k + q] << (8 * q))
        poke64(base + k, w)
        k = k + 8
    while k < t.n:
        poke8(base + k, t.b[k])
        k = k + 1

fn sys_mmap(n: int, prot: int, flags: int) => int:
    return syscall(9, 0, n, prot, flags, 0 - 1, 0)

fn sys_mprotect(addr: int, n: int, prot: int) => int:
    return syscall(10, addr, n, prot, 0, 0, 0)
