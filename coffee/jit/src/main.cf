/#/ cfjit: runs a `.cir` module. It reads the file, generates the machine code in memory and calls
/#/ `main`. It needs no front end, no linker and no C library: `cfjit prog.cir`.
use * in cir
use * in image
use * in loader
use * in sandbox
use * in cstr
use * in files

/#/ The second word of the command line.
fn path_arg() => Txt:
    let raw = read_file(&txt_of("/proc/self/cmdline"))
    let p = new_txt()
    let words = 0
    for i in 0..raw.n:
        if raw.b[i] == 0:
            words = words + 1
        elif words == 1:
            p.put_byte(raw.b[i])
    return p

fn image_for(lw: &Lower, sbx: bool) => Image:
    if sbx:
        return image_sbx_of(lw)
    return image_of(lw)

/#/ Is `--sandbox` on the command line?
fn sandbox_arg() => bool:
    let raw = read_file(&txt_of("/proc/self/cmdline"))
    let w = new_txt()
    let on = false
    for i in 0..raw.n:
        if raw.b[i] == 0:
            if w.is("--sandbox"):
                on = true
            w.clear()
        else:
            w.put_byte(raw.b[i])
    return on

fn main() => int:
    let sbx = sandbox_arg()
    let path = path_arg()
    if path.n == 0:
        say("usage: cfjit program.cir\n")
        return 2
    let cir = read_file(&path)
    if cir.n < 0:
        say("cfjit: cannot read the file\n")
        return 2
    let lw = new_lower()
    lw.mc.a.sbx = sbx
    let e = read_cir(&cir, &lw)
    if e != 0:
        say(f"cfjit: not a usable .cir (code {e})\n")
        return 2
    prune_unreached(&lw)
    lw.generate()
    if lw.mc_err > 0:
        say(f"cfjit: {lw.mc_err} functions could not be translated\n")
        return 2
    let im = image_for(&lw, sbx)
    if im.err != 0:
        say("cfjit: a relocation could not be applied\n")
        return 2
    if im.nimp > 0:
        say("cfjit: the module calls functions the loader does not offer\n")
        return 2
    let want = txt_of("main")
    let at = im.find(&want)
    if at < 0:
        say("cfjit: the module has no main\n")
        return 2
    if sbx:
        let rs = sandbox_run(&im, at)
        if rs == 0 - 1:
            say("cfjit: the sandbox could not be made\n")
            return 2
        if rs == 0 - 2:
            return 139
        return rs
    let base = load_image(&im)
    if base == 0:
        say("cfjit: out of memory\n")
        return 2
    return call_addr(base + at)
