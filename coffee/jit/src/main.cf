/#/ cfjit: runs a `.cir` module. It reads the file, generates the machine code in memory and calls
/#/ `main`. It needs no front end, no linker and no C library: `cfjit prog.cir`.
use * in cir
use * in image
use * in loader
use * in sandbox
use * in sandbox_a64
use * in hostcall
use * in sbxcheck_a64
use * in sbxcheck
use * in sbxrules
use * in imgfile
use * in cstr
use * in files
use * in linemap
use * in gdbelf
use * in varmap

/#/ The second word of the command line.
fn path_arg() => Txt:
    let raw = read_file(&txt_of("/proc/self/cmdline"))
    let p = new_txt()
    let words = 0
    for i in 0..raw.n:
        if raw.b[i] == 0:
            words = words + 1
        elif words == 1:
            p.put_byte(raw.b[i])
    return p

fn image_for(lw: &Lower, sbx: bool) => Image:
    if sbx:
        return image_sbx_of(lw)
    return image_of(lw)

/#/ Is the word `flag` on the command line?
fn flag_arg(flag: &str) => bool:
    let raw = read_file(&txt_of("/proc/self/cmdline"))
    let w = new_txt()
    let on = false
    for i in 0..raw.n:
        if raw.b[i] == 0:
            if w.is(flag):
                on = true
            w.clear()
        else:
            w.put_byte(raw.b[i])
    return on

/#/ The streams a sandbox may use: `--allow=stdin,stdout,stderr` (a subset; `--allow=` is none).
/#/ Bits 0, 1, 2 of the result. Without the option all three.
fn allow_arg() => int:
    let raw = read_file(&txt_of("/proc/self/cmdline"))
    let w = new_txt()
    let mask = 7
    for i in 0..raw.n + 1:
        if i == raw.n || raw.b[i] == 0:
            if w.n >= 8 && w.b[0] == 45 && w.b[1] == 45 && w.b[2] == 97 && w.b[6] == 119 && w.b[7] == 61:
                mask = 0
                let item = new_txt()
                for k in 8..w.n + 1:
                    if k == w.n || w.b[k] == 44:
                        if item.is("stdin"):
                            mask = mask | 1
                        if item.is("stdout"):
                            mask = mask | 2
                        if item.is("stderr"):
                            mask = mask | 4
                        item.clear()
                    else:
                        item.put_byte(w.b[k])
            w.clear()
        else:
            w.put_byte(raw.b[i])
    return mask

/#/ The number in `--<key>=N` on the command line, or 0 when absent.
fn num_arg(key: &str) => int:
    let raw = read_file(&txt_of("/proc/self/cmdline"))
    let w = new_txt()
    let want = txt_of("--")
    want.put(key)
    want.put("=")
    let v = 0
    for i in 0..raw.n + 1:
        if i == raw.n || raw.b[i] == 0:
            if w.n > want.n:
                let hit = true
                for k in 0..want.n:
                    if w.b[k] != want.b[k]:
                        hit = false
                if hit:
                    v = 0
                    for k in want.n..w.n:
                        v = v * 10 + (int(w.b[k]) - 48)
            w.clear()
        else:
            w.put_byte(raw.b[i])
    return v

/#/ Microseconds on the monotonic clock.
fn now_us() => int:
    let ts = sys_mmap(4096, 3, 34)
    syscall(sc_clock_gettime(), 1, ts, 0, 0, 0, 0)
    let us = peek64(ts) * 1000000 + peek64(ts + 8) // 1000
    syscall(sc_munmap(), ts, 4096, 0, 0, 0, 0)
    return us

/#/ With `--perf-map`: `/tmp/perf-PID.map`, the functions of the loaded image (`perf` reads it to name
/#/ the addresses of JIT code); the size of a function is the distance to the next symbol of the text.
fn write_perf_map(im: &Image, base: int) => void:
    let out = new_txt()
    for k in 0..im.nsym:
        let a = im.sym_at[k]
        if a < 0 || a >= im.text_n:
            continue
        let end = im.text_n
        for q in 0..im.nsym:
            let b = im.sym_at[q]
            if b > a && b < end:
                end = b
        out.put_hex(base + a)
        out.put_byte(32)
        out.put_hex(end - a)
        out.put_byte(32)
        let p = im.sym_name[k]
        while im.names.b[p] != 0:
            out.put_byte(im.names.b[p])
            p = p + 1
        out.put_byte(10)
    let path = txt_of("/tmp/perf-")
    path.put_int(syscall(sc_getpid(), 0, 0, 0, 0, 0, 0))
    path.put(".map")
    write_file(&path, &out)

/#/ Is a debugger attached (`TracerPid` in `/proc/self/status` is not 0)?
fn traced() => bool:
    let t = read_file(&txt_of("/proc/self/status"))
    let key = "TracerPid:"
    for i in 0..t.n:
        let k = 0
        while k < len(key) && i + k < t.n && t.b[i + k] == int(key[k]):
            k = k + 1
        if k == len(key):
            let q = i + k
            while q < t.n && (t.b[q] == 32 || t.b[q] == 9):
                q = q + 1
            return t.b[q] != 48
    return false

/#/ With `--time`: the phases of a start, in milliseconds, on stderr.
fn lap(on: bool, what: &str, t0: int) => int:
    if !on:
        return 0
    say(f"cfjit: {what} {(now_us() - t0) // 1000} ms\n")
    return 0

/#/ The values of every `--with=PATH` on the command line, one per line.
fn with_args() => Txt:
    let raw = read_file(&txt_of("/proc/self/cmdline"))
    let w = new_txt()
    let out = new_txt()
    for i in 0..raw.n + 1:
        if i == raw.n || raw.b[i] == 0:
            if w.n > 7 && w.b[0] == 45 && w.b[1] == 45 && w.b[2] == 119 && w.b[3] == 105 && w.b[4] == 116 && w.b[5] == 104 && w.b[6] == 61:
                for k in 7..w.n:
                    out.put_byte(w.b[k])
                out.put_byte(10)
            w.clear()
        else:
            w.put_byte(raw.b[i])
    return out

/#/ The value of every `--host=NAME=SIGNATURE` on the command line, one per line (see hostcall.cf).
fn host_args() => Txt:
    let raw = read_file(&txt_of("/proc/self/cmdline"))
    let w = new_txt()
    let out = new_txt()
    for i in 0..raw.n + 1:
        if i == raw.n || raw.b[i] == 0:
            if w.n > 7 && w.b[0] == 45 && w.b[1] == 45 && w.b[2] == 104 && w.b[3] == 111 && w.b[4] == 115 && w.b[5] == 116 && w.b[6] == 61:
                for k in 7..w.n:
                    out.put_byte(w.b[k])
                out.put_byte(10)
            w.clear()
        else:
            w.put_byte(raw.b[i])
    return out

/#/ The module in the file `path` (made with `coffee2 --emit-cir`; it may have no `main`) loaded and linked
/#/ against `syms`, and what it defines added to them. 0 when it worked; else a message was said.
fn load_with(path: &Txt, syms: &Exports) => int:
    let cir = read_file(path)
    if cir.n < 0:
        say(f"cfjit: cannot read {txt_str(path)}\n")
        return 2
    let lw = new_lower()
    let e = read_cir(&cir, &lw)
    if e != 0:
        say(f"cfjit: {txt_str(path)} is not a usable .cir (code {e})\n")
        return 2
    prune_unreached(&lw)
    lw.generate()
    if lw.ver_err > 0 || lw.mc_err > 0:
        say(f"cfjit: {txt_str(path)}: the code could not be made\n")
        return 2
    let im = image_of(&lw)
    if im.err != 0:
        say(f"cfjit: {txt_str(path)}: a relocation could not be applied\n")
        return 2
    let missing = new_txt()
    let base = link_image(&im, syms, 0, &missing)
    if base == 0:
        if missing.n > 0:
            say(f"cfjit: {txt_str(path)} calls '{txt_str(&missing)}', which nothing offers\n")
        else:
            say("cfjit: out of memory\n")
        return 2
    export_image(&im, base, syms)
    return 0

fn main() => int:
    /#/ the IR checker is on (7 ms of a 109 ms start for the compiler's module); `--no-verify` turns it off
    set_verify(!flag_arg("--no-verify"))
    /#/ `--sandbox=base` keeps the start of the linear memory in a register instead of `gs`: the form that other processors can have
    let bm = flag_arg("--sandbox=base")
    /#/ `--target=aarch64`: generate (and load) aarch64 code, for a `cfjit` built for aarch64; the default is x86-64
    let a64 = flag_arg("--target=aarch64") || flag_arg("--target=aarch64-linux")
    if a64:
        set_target(&txt_of("aarch64-linux"))
    let sbx = flag_arg("--sandbox") || bm
    let path = path_arg()
    if path.n == 0:
        say("usage: cfjit program.cir\n")
        return 2
    let cir = read_file(&path)
    if cir.n < 0:
        say("cfjit: cannot read the file\n")
        return 2
    /#/ with --cache the image is kept next to the .cir, and used while the .cir and the mode are the same
    let want_gdb = flag_arg("--gdb")
    /#/ the debug file needs the line marks of a generation, which a cached image does not have
    let use_cache = flag_arg("--cache") && !want_gdb
    let timing = flag_arg("--time")
    let t0 = now_us()
    let mode = 0
    let cache_path = new_txt()
    cache_path.put_all(&path)
    if sbx:
        mode = 1
        cache_path.put(".sbx")
        if bm:
            mode = 2
            cache_path.put("b")
    if a64:
        mode = mode + 16
        cache_path.put(".a64")
    cache_path.put(".cim")
    let key = 0
    if use_cache:
        key = cim_key(&cir, mode)
    let im = blank_image()
    let at = 0 - 2
    if use_cache:
        let ct = read_file(&cache_path)
        if ct.n > 0:
            at = read_cim(&ct, key, &im)
            if at == 0 - 2:
                im = blank_image()
    if at == 0 - 2:
        let lw = new_lower()
        lw.mc.a.acc.sbx = sbx
        lw.mc.a.acc.bm = bm
        let want_lines = flag_arg("--lines")
        let gdb_map = new_txt()
        if want_gdb || want_lines:
            /#/ the line map and the variables, from beside the module
            let mp = copy_txt(&path)
            mp.put(".map")
            let mt = read_file(&mp)
            if mt.n > 0:
                read_line_map(&mt)
                if want_gdb:
                    set_debug_vars()
                    gdb_map = mt
        lap(timing, "read file + key", t0)
        let e = read_cir(&cir, &lw)
        lap(timing, "read_cir (done at)", t0)
        if e != 0:
            say(f"cfjit: not a usable .cir (code {e})\n")
            return 2
        if gdb_map.n > 0:
            read_var_map(&gdb_map, &lw)
        prune_unreached(&lw)
        lap(timing, "prune (done at)", t0)
        lw.generate()
        lap(timing, "generate (done at)", t0)
        if want_lines:
            /#/ `F name` and `L offset line` (a line of the flattened text, `coffee2 --emit-flat`) beside the .cir
            let lp = copy_txt(&path)
            lp.put(".lines")
            let raw = new_txt()
            lines_dump(&lw.mc, &raw)
            write_file(&lp, &raw)
        let dbg_raw = new_txt()
        if want_gdb:
            lines_dump(&lw.mc, &dbg_raw)
            no_lines()
        if lw.ver_err > 0:
            say(f"cfjit: the IR of {lw.ver_err} functions did not pass the check\n")
            return 2
        if lw.mc_err > 0:
            say(f"cfjit: {lw.mc_err} functions could not be translated\n")
            return 2
        im = image_for(&lw, sbx)
        lap(timing, "image (done at)", t0)
        if im.err != 0:
            say("cfjit: a relocation could not be applied\n")
            return 2
        let want = txt_of("main")
        at = im.find(&want)
        if want_gdb:
            /#/ the DWARF of the code beside the module, and a gdb script that loads it where the image will be
            let ge = gdb_elf(&im, &dbg_raw)
            if ge.n == 0:
                say("cfjit: no line table (was the .cir made with -g?)\n")
            else:
                let gp = copy_txt(&path)
                gp.put(".dbg")
                write_file(&gp, &ge)
                let sc = new_txt()
                sc.put("add-symbol-file ")
                sc.put_all(&gp)
                sc.put_byte(32)
                sc.put_int(gdb_base())
                sc.put_byte(10)
                let sp = copy_txt(&path)
                sp.put(".gdb")
                write_file(&sp, &sc)
        lap(timing, "before the drop of the IR", t0)
        if use_cache:
            write_file(&cache_path, &write_cim(&im, at, key))
    lap(timing, "after the drop of the IR", t0)
    if flag_arg("--no-run"):
        return 0
    if at < 0:
        say("cfjit: the module has no main\n")
        return 2
    /#/ what the code may call: the modules of `--with=` (in order, each can call the ones before it)
    let syms = new_exports()
    let libs = with_args()
    let from = 0
    for i in 0..libs.n:
        if libs.b[i] == 10:
            let lp = new_txt()
            for q in from..i:
                lp.put_byte(libs.b[q])
            from = i + 1
            if load_with(&lp, &syms) != 0:
                return 2
    if sbx:
        /#/ the host functions of the sandbox code: the `--host=` ones, found among what the `--with=` modules define
        let hosts = new_hosts()
        let hl = host_args()
        let hfrom = 0
        for i in 0..hl.n:
            if hl.b[i] == 10:
                let nm = new_txt()
                let sg = new_txt()
                let eq = false
                for q in hfrom..i:
                    if !eq && hl.b[q] == 61:
                        eq = true
                    elif eq:
                        sg.put_byte(hl.b[q])
                    else:
                        nm.put_byte(hl.b[q])
                hfrom = i + 1
                let ha = syms.find(&nm)
                if ha == 0 || !sig_ok(&sg):
                    say(f"cfjit: --host={txt_str(&nm)}: not defined by a --with module, or not a signature\n")
                    return 2
                hosts.add(&nm, &sg, ha)
        let imp_lo = 0 - 1
        for k in 0..im.nimp:
            let hn = name_txt(&im.names, im.imp_name[k])
            if hosts.find(&hn) < 0 || im.imp_slot[k] < 0:
                say(f"cfjit: the module calls '{txt_str(&hn)}', which is not a host function of the sandbox\n")
                return 2
            if imp_lo < 0 || im.imp_slot[k] - 8 < imp_lo:
                imp_lo = im.imp_slot[k] - 8
        if imp_lo >= 0:
            sbx_set_imports(imp_lo, imp_lo + 16 * im.nimp)
        if flag_arg("--perf-map"):
            /#/ the code of the sandbox is mapped by `sandbox_run`: the addresses in the map are offsets from its start
            write_perf_map(&im, 0)
        if a64:
            let bad64 = sbx_verify_a64(&im.b, im.text_n, im.sys_at)
            if bad64 >= 0:
                say(f"cfjit: the code is not safe to run in the sandbox (offset {bad64}, rule {sbr_name(sbx_rule)}, reason {sbx_a64_why})\n")
                return 2
            let r64 = sandbox_run_a64(&im, at, allow_arg(), num_arg("mem"), num_arg("cpu"), &hosts)
            if r64 == 0 - 1:
                say("cfjit: the sandbox could not be made\n")
                return 2
            if r64 == 0 - 2:
                return 139
            return r64
        sbx_set_base(bm)
        let bad = sbx_verify(&im.b, im.text_n, im.sys_at)
        if bad >= 0:
            say(f"cfjit: the code is not safe to run in the sandbox (offset {bad}, rule {sbr_name(sbx_rule)}, reason {sbx_why}, bytes {int(im.b.b[bad])} {int(im.b.b[bad + 1])} {int(im.b.b[bad + 2])} {int(im.b.b[bad + 3])} {int(im.b.b[bad + 4])})\n")
            return 2
        let rs = sandbox_run(&im, at, allow_arg(), num_arg("mem"), num_arg("cpu"), bm, &hosts)
        if rs == 0 - 1:
            say("cfjit: the sandbox could not be made\n")
            return 2
        if rs == 0 - 2:
            return 139
        return rs
    let want_at = 0
    if want_gdb:
        want_at = gdb_base()
    let missing = new_txt()
    let base = link_image(&im, &syms, want_at, &missing)
    if base == 0:
        if missing.n > 0:
            say(f"cfjit: the module calls '{txt_str(&missing)}', which nothing offers\n")
        else:
            say("cfjit: out of memory\n")
        return 2
    if flag_arg("--perf-map"):
        write_perf_map(&im, base)
    if want_gdb && traced():
        /#/ stop for the debugger now that the code is in memory: SIGTRAP; `continue` runs the program
        syscall(sc_kill(), syscall(sc_getpid(), 0, 0, 0, 0, 0, 0), 5, 0, 0, 0, 0)
    return call_addr(base + at)
