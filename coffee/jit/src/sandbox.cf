/#/ Runs sandbox code (see docs/explanation/sandbox-design.md). The code only reaches the linear
/#/ memory, a 4 GB reservation of which the part the module needs is readable and writable; every
/#/ access of the code goes through the `gs` segment in 32 bits, so whatever it computes it lands
/#/ inside. Anything else that goes wrong (an access past what is mapped, a division by zero, the
/#/ end of the stack) is a signal, and the handler turns it into a return from `sandbox_run`.
/#/
/#/ The code runs on a stack of its own with a guard below it. The host keeps a control block that
/#/ the sandbox cannot name: [0] the host stack pointer to return to, [8] the top of the sandbox
/#/ stack, [16] the signal of a trap (0 when the run ended by itself).
use * in image
use * in asm
use * in loader

fn page_up(n: int) => int:
    return (n + 4095) // 4096 * 4096

/#/ The code of the three stubs goes to the host; `at` is where each one will be.
fn stub_enter(ss_top: int, entry: int, region: int, bm: bool) => Txt:
    let a = new_asm()
    a.begin_fun()
    a.push(5)
    a.push(3)
    a.push(12)
    a.push(13)
    a.push(14)
    a.push(15)
    a.store(7, 0, 4, 8)
    a.load(4, 7, 8, 8)
    a.push(7)
    a.sub_ri(4, 8)
    a.mov_ri(14, ss_top)
    if bm:
        /#/ the start of the linear memory, and an address register that is a 32-bit number from the start
        a.mov_ri(15, region)
        a.mov_ri(13, 0)
    a.mov_ri(0, entry)
    a.call_reg(0)
    a.add_ri(4, 8)
    a.pop(7)
    a.load(4, 7, 0, 8)
    a.pop(15)
    a.pop(14)
    a.pop(13)
    a.pop(12)
    a.pop(3)
    a.pop(5)
    a.ret()
    a.end_fun()
    return clone a.c

/#/ Reached after the handler moved the faulting instruction here: back to the host with rax 0.
fn stub_trap(ctrl: int) => Txt:
    let a = new_asm()
    a.begin_fun()
    a.mov_ri(7, ctrl)
    a.load(4, 7, 0, 8)
    a.mov_ri(0, 0)
    a.pop(15)
    a.pop(14)
    a.pop(13)
    a.pop(12)
    a.pop(3)
    a.pop(5)
    a.ret()
    a.end_fun()
    return clone a.c

/#/ Where the exit of the sandbox code goes (rax holds the status): back to the host with it.
fn stub_exit(ctrl: int) => Txt:
    let a = new_asm()
    a.begin_fun()
    a.mov_ri(7, ctrl)
    a.load(4, 7, 0, 8)
    a.pop(15)
    a.pop(14)
    a.pop(13)
    a.pop(12)
    a.pop(3)
    a.pop(5)
    a.ret()
    a.end_fun()
    return clone a.c

/#/ The signal handler (rdi the signal, rdx the saved state): when the instruction that faulted is
/#/ in the code of the sandbox, it is replaced by the trap stub and the signal is noted; else exit.
fn stub_handler(code_lo: int, code_hi: int, trap: int, ctrl: int) => Txt:
    let a = new_asm()
    a.begin_fun()
    let out = a.new_label()
    a.load(0, 2, 168, 8)
    a.mov_ri(1, code_lo)
    a.cmp_rr(0, 1)
    a.jcc(cc_b(), out)
    a.mov_ri(1, code_hi)
    a.cmp_rr(0, 1)
    a.jcc(cc_ae(), out)
    a.mov_ri(0, trap)
    a.store(2, 168, 0, 8)
    a.mov_ri(1, ctrl)
    a.store(1, 16, 7, 8)
    a.ret()
    a.bind(out)
    a.mov_ri(7, 134)
    a.mov_ri(0, 231)
    a.byte(15)
    a.byte(5)
    a.end_fun()
    return clone a.c

/#/ The host side of `read` (n 0) and `write` (n 1), reached from the sandbox with rdi the number,
/#/ rsi the descriptor, rdx the offset of the buffer and rcx its length. The descriptor must be
/#/ marked in the table of the control block (ctrl + 512 + 64 * n + fd) and the buffer must lie
/#/ inside the linear memory, else the call fails (EBADF, EFAULT) and nothing reaches the kernel.
/#/ This is the only place with a `syscall` instruction. It runs on the stack of the sandbox.
fn stub_io(n: int, ctrl: int, base: int, limit: int) => Txt:
    let a = new_asm()
    a.begin_fun()
    let badfd = a.new_label()
    let efault = a.new_label()
    a.cmp_ri(6, 63)
    a.jcc(cc_a(), badfd)
    a.mov_ri(0, ctrl + 512 + 64 * n)
    a.add_rr(0, 6)
    a.load(0, 0, 0, 1)
    a.cmp_ri(0, 0)
    a.jcc(cc_e(), badfd)
    a.mov_ri(0, limit)
    a.cmp_rr(1, 0)
    a.jcc(cc_a(), efault)
    a.mov_ri(0, 4294967295)
    a.and_rr(2, 0)
    a.mov_rr(0, 2)
    a.add_rr(0, 1)
    a.mov_ri(11, limit)
    a.cmp_rr(0, 11)
    a.jcc(cc_a(), efault)
    a.mov_rr(7, 6)
    a.mov_ri(6, base)
    a.add_rr(6, 2)
    a.mov_rr(2, 1)
    a.mov_ri(0, n)
    a.byte(15)
    a.byte(5)
    a.ret()
    a.bind(badfd)
    a.mov_ri(0, 0 - 9)
    a.ret()
    a.bind(efault)
    a.mov_ri(0, 0 - 14)
    a.ret()
    a.end_fun()
    return clone a.c

/#/ The handler of the CPU quota (SIGALRM; rdi the signal, rdx the saved state). When the code of the
/#/ sandbox was running, it is stopped like on a fault. When the host stub was (a read that waits, say),
/#/ the timer is armed again for a millisecond: the stub returns to the code, and the next alarm ends it.
fn stub_alarm(code_lo: int, code_hi: int, trap: int, ctrl: int) => Txt:
    let a = new_asm()
    a.begin_fun()
    let out = a.new_label()
    a.load(0, 2, 168, 8)
    a.mov_ri(1, code_lo)
    a.cmp_rr(0, 1)
    a.jcc(cc_b(), out)
    a.mov_ri(1, code_hi)
    a.cmp_rr(0, 1)
    a.jcc(cc_ae(), out)
    a.mov_ri(0, trap)
    a.store(2, 168, 0, 8)
    a.mov_ri(1, ctrl)
    a.store(1, 16, 7, 8)
    a.ret()
    a.bind(out)
    a.mov_ri(7, 0)
    a.mov_ri(6, ctrl + 352)
    a.mov_ri(2, 0)
    a.mov_ri(0, 38)
    a.byte(15)
    a.byte(5)
    a.ret()
    a.end_fun()
    return clone a.c

fn stub_restorer() => Txt:
    let a = new_asm()
    a.begin_fun()
    a.mov_ri(0, 15)
    a.byte(15)
    a.byte(5)
    a.end_fun()
    return clone a.c

/#/ The stack the code runs on in base mode: `total` bytes (the low part a guard) placed so that the low 32 bits of
/#/ its top are `ss_top`. The code finds the shadow frame of a function at the low 32 bits of its frame pointer
/#/ (`Asm.mem`, the shadow base), so the host stack and the shadow stack are two mappings of one layout: a frame
/#/ stands at the same distance from the top in both. -1 when no such place is free.
fn map_mirror_stack(region: int, ss_top: int, total: int) => int:
    let low = ss_top - total
    let hh = region // 4294967296
    for k in 1..4096:
        /#/ the segments above the region, then those below it (the region may be at the top of the address space)
        for sgn in 0..2:
            let seg = hh + k
            if sgn == 1:
                seg = hh - k
            if seg > 0 && seg < 32768:
                let hint = seg * 4294967296 + low
                let r = syscall(sc_mmap(), hint, total, 3, 34 + 1048576, 0 - 1, 0)
                if r == hint:
                    return r
                if mapped(r):
                    syscall(sc_munmap(), r, total, 0, 0, 0, 0)
    return 0 - 1

/#/ Makes the signal `sig` run the handler at `handler`, on the alternate stack.
fn catch_signal(sig: int, handler: int, restorer: int, act: int) => int:
    poke64(act, handler)
    poke64(act + 8, 201326596)
    poke64(act + 16, restorer)
    poke64(act + 24, 0)
    return syscall(13, sig, act, 0, 8, 0, 0)

/#/ Runs `main` (at `main_at` in the code of `im`) in the sandbox. `allow` says which standard streams it may use (see below). Returns its result, or -1 when
/#/ the sandbox could not be made, or -2 when it trapped (the signal is in `trap_signal()`).
fn sandbox_run(im: &Image, main_at: int, allow: int, mem_mb: int, cpu_ms: int, bm: bool) => int:
    let region = sys_mmap(4294967296 + 131072, 0, 16418)
    if !mapped(region):
        return 0 - 1
    /#/ the linear memory it starts with, and the shadow stack
    let lin_len = page_up(im.lin.n)
    if sys_mprotect(region + im.lin_at, lin_len, 3) != 0:
        return 0 - 1
    if sys_mprotect(region + im.ss_base, im.limit - im.ss_base, 3) != 0:
        return 0 - 1
    copy_in(region + im.lin_at, &im.lin)
    poke64(region + im.lin_at, im.ss_top)
    /#/ the heap quota: the heap ends `mem_mb` megabytes after it starts (when that is less than what is mapped)
    let heap_end = im.limit
    if mem_mb > 0 && im.ss_top + mem_mb * 1048576 < heap_end:
        heap_end = im.ss_top + mem_mb * 1048576
    poke64(region + im.lin_at + 8, heap_end)
    if !bm && syscall(158, 4097, region, 0, 0, 0, 0) != 0:
        return 0 - 1
    /#/ the code, the stubs, the control block, the stack the code runs on and the one for signals
    let code = sys_mmap(page_up(im.b.n + 1), 7, 34)
    let stubs = sys_mmap(4096, 7, 34)
    let ctrl = sys_mmap(4096, 3, 34)
    let stack = 0 - 1
    if bm:
        stack = map_mirror_stack(region, im.ss_top, 1048576 + 65536)
    else:
        stack = sys_mmap(1048576 + 65536, 3, 34)
    let alt = sys_mmap(65536, 3, 34)
    if !mapped(code) || !mapped(stubs) || !mapped(ctrl) || !mapped(stack) || !mapped(alt):
        return 0 - 1
    sys_mprotect(stack, 65536, 0)
    copy_in(code, &im.b)
    if im.exit_at > 0:
        copy_in(code + im.exit_at, &stub_exit(ctrl))
    poke64(ctrl + 8, stack + 1048576 + 65536)
    poke64(ctrl + 16, 0)
    copy_in(stubs, &stub_enter(im.ss_top, code + main_at, region, bm))
    copy_in(stubs + 256, &stub_trap(ctrl))
    copy_in(stubs + 512, &stub_handler(code, code + im.b.n, stubs + 256, ctrl))
    copy_in(stubs + 768, &stub_restorer())
    copy_in(stubs + 1024, &stub_io(1, ctrl, region, im.limit))
    copy_in(stubs + 1280, &stub_io(0, ctrl, region, im.limit))
    if im.hc_at > 0:
        poke64(code + im.hc_at, stubs + 1024)
        poke64(code + im.hc_at + 16, stubs + 1280)
    /#/ the descriptors that may be used: bit 0 of `allow` reads 0, bit 1 writes 1, bit 2 writes 2
    if (allow & 1) != 0:
        poke8(ctrl + 512, 1)
    if (allow & 2) != 0:
        poke8(ctrl + 576 + 1, 1)
    if (allow & 4) != 0:
        poke8(ctrl + 576 + 2, 1)
    poke64(ctrl + 320, alt)
    poke64(ctrl + 328, 0)
    poke64(ctrl + 336, 65536)
    if syscall(131, ctrl + 320, 0, 0, 0, 0, 0) != 0:
        return 0 - 1
    if catch_signal(11, stubs + 512, stubs + 768, ctrl + 256) != 0 || catch_signal(7, stubs + 512, stubs + 768, ctrl + 256) != 0:
        return 0 - 1
    if catch_signal(8, stubs + 512, stubs + 768, ctrl + 256) != 0 || catch_signal(4, stubs + 512, stubs + 768, ctrl + 256) != 0:
        return 0 - 1
    /#/ the CPU quota: a timer (wall clock) of `cpu_ms`; the itimerval at ctrl + 352 re-arms it, at ctrl + 384 starts it
    copy_in(stubs + 1536, &stub_alarm(code, code + im.b.n, stubs + 256, ctrl))
    poke64(ctrl + 352, 0)
    poke64(ctrl + 360, 0)
    poke64(ctrl + 368, 0)
    poke64(ctrl + 376, 1000)
    poke64(ctrl + 384, 0)
    poke64(ctrl + 392, 0)
    poke64(ctrl + 400, cpu_ms // 1000)
    poke64(ctrl + 408, cpu_ms % 1000 * 1000)
    if cpu_ms > 0:
        if catch_signal(14, stubs + 1536, stubs + 768, ctrl + 256) != 0:
            return 0 - 1
        if syscall(38, 0, ctrl + 384, 0, 0, 0, 0) != 0:
            return 0 - 1
    let rc = call_addr(stubs, ctrl)
    if cpu_ms > 0:
        /#/ off before the handler could run in the host again
        poke64(ctrl + 400, 0)
        poke64(ctrl + 408, 0)
        syscall(38, 0, ctrl + 384, 0, 0, 0, 0)
    let t = peek64(ctrl + 16)
    if t != 0:
        say(f"cfjit: the sandbox trapped (signal {t})\n")
        return 0 - 2
    return rc
