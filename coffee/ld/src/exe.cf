/#/ The executable: the linked image cut into the pieces of an ELF64 file, plus the headers.
/#/
/#/ `link_exe` is the whole link once the inputs are added; the result is the bytes of the file,
/#/ or an empty text after an error was reported.
use * in link
use * in dynlink
use * in dwarf

/#/ where an executable is loaded
fn exe_base() => int:
    return 4194304

fn put16(t: &Txt, v: int) => void:
    for k in 0..2:
        t.put_byte((v >> (8 * k)) & 255)

fn put32(t: &Txt, v: int) => void:
    for k in 0..4:
        t.put_byte((v >> (8 * k)) & 255)

fn put64(t: &Txt, v: int) => void:
    for k in 0..8:
        t.put_byte((v >> (8 * k)) & 255)

fn phdr(t: &Txt, ty: int, flags: int, off: int, addr: int, fsz: int, msz: int, align: int) => void:
    put32(t, ty)
    put32(t, flags)
    put64(t, off)
    put64(t, addr)
    put64(t, addr)
    put64(t, fsz)
    put64(t, msz)
    put64(t, align)

/#/ The symbol table, its names and the section headers, appended to `out`; returns where the
/#/ section headers start. One section per segment, the symbols point into them.
fn add_symbols(l: &Linker, out: &Txt, base: int) => int:
    let nseg = l.sg_off.n
    let strs = new_txt()
    strs.put_byte(0)
    let tab = new_txt()
    put_zeros(&tab, 24)
    let nlocal = 1
    for pass in 0..2:
        for sid in 0..l.y_sec.n:
            let nm = l.y_nm.b[sid]
            let sec = l.y_sec.b[sid]
            let local = l.y_bind.b[sid] == 0
            if nm >= 0 && sec >= 0 && sec < l.sc_grp.n && l.sc_grp.b[sec] >= 0 && l.final_sym(sid) == sid && local == (pass == 0):
                let ty = l.y_type.b[sid]
                if ty == 0 || ty == 1 || ty == 2:
                    let addr = l.sym_addr(sid, base)
                    let seg = 0
                    for k in 0..nseg:
                        if addr >= base + l.sg_rva.b[k] && addr < base + l.sg_rva.b[k] + l.sg_msz.b[k]:
                            seg = k + 1
                    if seg > 0:
                        let w = l.name_of(nm)
                        put32(&tab, strs.n)
                        strs.put_all(&w)
                        strs.put_byte(0)
                        let bind = 1
                        if local:
                            bind = 0
                        tab.put_byte((bind << 4) | ty)
                        tab.put_byte(0)
                        put16(&tab, seg)
                        put64(&tab, addr)
                        put64(&tab, l.y_size.b[sid])
        if pass == 0:
            nlocal = tab.n // 24
    /#/ names of the sections: .symtab .strtab .shstrtab .seg
    let sh = new_txt()
    sh.put_byte(0)
    let n_sym = sh.n
    sh.put(".symtab")
    sh.put_byte(0)
    let n_str = sh.n
    sh.put(".strtab")
    sh.put_byte(0)
    let n_shs = sh.n
    sh.put(".shstrtab")
    sh.put_byte(0)
    /#/ the pieces are named as the usual sections are, for tools that look for `.text`
    let n_seg = sh.n
    sh.put(".text")
    sh.put_byte(0)
    let n_segro = sh.n
    sh.put(".rodata")
    sh.put_byte(0)
    let n_segrw = sh.n
    sh.put(".data")
    sh.put_byte(0)
    let dab = new_txt()
    let din = new_txt()
    let dli = new_txt()
    let dfr = new_txt()
    let has_dw = build_dwarf(l, base, &dab, &din, &dli, &dfr)
    let n_dab = sh.n
    let n_din = 0
    let n_dli = 0
    let n_dfr = 0
    if has_dw:
        sh.put(".debug_abbrev")
        sh.put_byte(0)
        n_din = sh.n
        sh.put(".debug_info")
        sh.put_byte(0)
        n_dli = sh.n
        sh.put(".debug_line")
        sh.put_byte(0)
        n_dfr = sh.n
        sh.put(".debug_frame")
        sh.put_byte(0)
    put_zeros(out, align_to(out.n, 8) - out.n)
    let off_sym = out.n
    out.put_all(&tab)
    let off_str = out.n
    out.put_all(&strs)
    let off_shs = out.n
    out.put_all(&sh)
    let off_dab = out.n
    out.put_all(&dab)
    let off_din = out.n
    out.put_all(&din)
    let off_dli = out.n
    out.put_all(&dli)
    let off_dfr = out.n
    out.put_all(&dfr)
    put_zeros(out, align_to(out.n, 8) - out.n)
    let shoff = out.n
    put_zeros(out, 64)
    for k in 0..nseg:
        let fl = 2
        if l.sg_flags.b[k] & 1 != 0:
            fl = fl | 4
        if l.sg_flags.b[k] & 2 != 0:
            fl = fl | 1
        let nmo = n_segro
        if l.sg_flags.b[k] & 1 != 0:
            nmo = n_seg
        elif l.sg_flags.b[k] & 2 != 0:
            nmo = n_segrw
        put32(out, nmo)
        put32(out, 1)
        put64(out, fl)
        put64(out, base + l.sg_rva.b[k])
        put64(out, l.sg_off.b[k])
        put64(out, l.sg_fsz.b[k])
        put32(out, 0)
        put32(out, 0)
        put64(out, 16)
        put64(out, 0)
    put32(out, n_sym)
    put32(out, 2)
    put64(out, 0)
    put64(out, 0)
    put64(out, off_sym)
    put64(out, tab.n)
    put32(out, nseg + 2)
    put32(out, nlocal)
    put64(out, 8)
    put64(out, 24)
    put32(out, n_str)
    put32(out, 3)
    put64(out, 0)
    put64(out, 0)
    put64(out, off_str)
    put64(out, strs.n)
    put32(out, 0)
    put32(out, 0)
    put64(out, 1)
    put64(out, 0)
    put32(out, n_shs)
    put32(out, 3)
    put64(out, 0)
    put64(out, 0)
    put64(out, off_shs)
    put64(out, sh.n)
    put32(out, 0)
    put32(out, 0)
    put64(out, 1)
    put64(out, 0)
    l.nshdr = nseg + 4
    if has_dw:
        for q in 0..4:
            let nmo = n_dab
            let off = off_dab
            let sz = dab.n
            if q == 1:
                nmo = n_din
                off = off_din
                sz = din.n
            elif q == 2:
                nmo = n_dli
                off = off_dli
                sz = dli.n
            elif q == 3:
                nmo = n_dfr
                off = off_dfr
                sz = dfr.n
            put32(out, nmo)
            put32(out, 1)
            put64(out, 0)
            put64(out, 0)
            put64(out, off)
            put64(out, sz)
            put32(out, 0)
            put32(out, 0)
            put64(out, 1)
            put64(out, 0)
        l.nshdr = nseg + 8
    return shoff

fn link_exe(l: &Linker) => Txt:
    let none = new_txt()
    l.add_start()
    l.add_syscall()
    if l.dyn_on:
        l.resolve_dynamic()
    l.check_undefined()
    if l.errs > 0:
        return none
    let entry = l.find_def("_start")
    if entry < 0:
        l.msg("no entry point: define _start or main")
        return none
    l.gc(entry)
    l.layout()
    if l.errs > 0:
        return none
    let base = exe_base()
    let mem = l.build_image()
    if l.apply_relocs(&mem, base) > 0:
        return none
    if l.dyn_on:
        dyn_fill(l, &mem, base)
    let nseg = l.sg_off.n
    let out = new_txt()
    for k in 0..nseg:
        let at = l.sg_off.b[k]
        put_zeros(&out, at + l.sg_fsz.b[k] - out.n)
        for q in 0..l.sg_fsz.b[k]:
            out.b[at + q] = mem.b[l.sg_rva.b[k] + q]
    let shoff = 0
    let shnum = 0
    let shstr = 0
    if l.syms && !l.dyn_on:
        shoff = add_symbols(l, &out, base)
        shnum = l.nshdr
        shstr = nseg + 3
    /#/ the headers, over the start of the first piece
    let dn = 0
    if l.dyn_on:
        dn = 2
    let h = new_txt()
    h.put_byte(127)
    h.put("ELF")
    h.put_byte(2)
    h.put_byte(1)
    h.put_byte(1)
    put_zeros(&h, 9)
    put16(&h, 2)
    put16(&h, machine_of(ld_arch))
    put32(&h, 1)
    put64(&h, l.sym_addr(entry, base))
    put64(&h, 64)
    put64(&h, shoff)
    put32(&h, eflags_of(ld_arch))
    put16(&h, 64)
    put16(&h, 56)
    put16(&h, nseg + 1 + dn)
    put16(&h, 64)
    put16(&h, shnum)
    put16(&h, shstr)
    for k in 0..nseg:
        phdr(&h, 1, l.sg_flags.b[k], l.sg_off.b[k], base + l.sg_rva.b[k], l.sg_fsz.b[k], l.sg_msz.b[k], 4096)
    if l.dyn_on:
        let ig = l.gbase[1] + l.d_interp
        phdr(&h, 3, 4, file_off(l, ig), base + ig, 28, 28, 1)
        let dg = l.gbase[2] + l.d_dynamic
        let dsz = 16 * (l.nneed + 11)
        phdr(&h, 2, 6, file_off(l, dg), base + dg, dsz, dsz, 8)
    /#/ PT_GNU_STACK: the stack is not executable
    phdr(&h, 1685382481, 6, 0, 0, 0, 0, 16)
    for k in 0..h.n:
        out.b[k] = h.b[k]
    return out
