/#/ `cfld`: links x86-64 ELF objects and archives into a static executable, without `cc`.
/#/
/#/     cfld [-g] [-o out] [-L dir]... file.o|file.a|-lname ...
/#/
/#/ Inputs are read in the order given (an archive only contributes the members that define
/#/ something still needed). If no input defines `_start`, one that calls `main` is added.
/#/ The executable: the linked image cut into the pieces of an ELF64 file, plus the headers.
/#/
/#/ `link_exe` is the whole link once the inputs are added; the result is the bytes of the file,
/#/ or an empty text after an error was reported.
/#/ The static linker, in two halves.
/#/
/#/ The first reads relocatable objects (`add_object`) and archives (`add_archive`), joins the
/#/ sections into one memory image (`layout`, `build_image`) and resolves symbols. The second,
/#/ `apply_relocs`, patches that image for a load address. It does not know about files, so a JIT
/#/ can use it to relocate the image in memory; `write_exe` (exe.cf) puts the same image in an
/#/ ELF executable.
/#/
/#/ Everything is flat columns: sections and symbols of all inputs are numbered one after the
/#/ other (an input's first number is in `in_sec0` / `in_sym0`), so a symbol or section number
/#/ alone says which input it came from.
/#/
/#/ Image addresses are `rva`s, relative to the load address (`base`); an executable is loaded
/#/ at `0x400000`.
/#/ Small helpers for the linker: a growable column of integers, and little-endian reads and
/#/ writes on the bytes of a `Txt`.
/#/ Text built a byte at a time: the buffer the printer and the emitter write to.
/#/ The operations of the IR and the one table that defines them. The printer, the verifier,
/#/ the folder and the emitter ask this table; none of them lists operations on its own.

enum Op:
    Param
    Const
    StrLit
    FnAddr
    Undef
    Add
    Sub
    Mul
    SDiv
    UDiv
    SRem
    URem
    And
    Or
    Xor
    Shl
    AShr
    LShr
    Neg
    Not
    FAdd
    FSub
    FMul
    FDiv
    FRem
    FNeg
    Cmp
    FCmp
    Trunc
    SExt
    ZExt
    FpToSi
    FpToUi
    SiToFp
    UiToFp
    FpExt
    FpTrunc
    Bitcast
    PtrToInt
    IntToPtr
    Extract
    Insert
    Slot
    Load
    Store
    Field
    Index
    Call
    CCall
    CallI
    Alloc
    Free
    Drop
    Clone
    OwnMove
    Br
    CondBr
    Switch
    Ret
    Unreachable
    VLoop
    SMulHi
    UMulHi

/#/ Comparison predicates; the signedness of an integer compare is in the predicate.
enum Pr:
    Eq
    Ne
    SLt
    SLe
    SGt
    SGe
    ULt
    ULe
    UGt
    UGe
    OEq
    ONe
    OLt
    OLe
    OGt
    OGe

/#/ Properties of an operation, as bits.
fn f_pure() => int:
    return 1

fn f_comm() => int:
    return 2

fn f_reads() => int:
    return 4

fn f_writes() => int:
    return 8

fn f_term() => int:
    return 16

fn f_consumes() => int:
    return 32

fn f_trap() => int:
    return 64

fn f_allocs() => int:
    return 128

/#/ Byte `i` of a string.
fn ch(src: &str, i: int) => int:
    if i < 0 || i >= len(src):
        return 0
    return int(src[i])

/#/ Operand count of an operation whose number of operands varies (calls).
fn var_args() => int:
    return -1

class OpTab:
    pool: buf<int>
    pool_n: int
    off: buf<int>
    size: buf<int>
    nargs: buf<int>
    flags: buf<int>
    n: int

    fn def(self, name: &str, nargs: int, flags: int) => void:
        if self.n >= len(self.off):
            let cap = (self.n + 1) * 2
            self.off = buf_resize(self.off, cap)
            self.size = buf_resize(self.size, cap)
            self.nargs = buf_resize(self.nargs, cap)
            self.flags = buf_resize(self.flags, cap)
        self.off[self.n] = self.pool_n
        self.size[self.n] = len(name)
        self.nargs[self.n] = nargs
        self.flags[self.n] = flags
        for i in 0..len(name):
            if self.pool_n >= len(self.pool):
                self.pool = buf_resize(self.pool, (self.pool_n + 1) * 2)
            self.pool[self.pool_n] = ch(name, i)
            self.pool_n = self.pool_n + 1
        self.n = self.n + 1

    fn has(self, op: int, flag: int) => bool:
        return (self.flags[op] & flag) != 0

/#/ The table, one row per `Op` in the order of the enum.
fn new_optab() => OpTab:
    let t = OpTab { pool: new_buf(int, 256), pool_n: 0, off: new_buf(int, 64), size: new_buf(int, 64), nargs: new_buf(int, 64), flags: new_buf(int, 64), n: 0 }
    let p = f_pure()
    let c = f_pure() | f_comm()
    let pt = f_pure() | f_trap()
    t.def("param", 0, p)
    t.def("const", 0, p)
    t.def("str.lit", 0, p)
    t.def("fn.addr", 0, p)
    t.def("undef", 0, p)
    t.def("add", 2, c)
    t.def("sub", 2, p)
    t.def("mul", 2, c)
    t.def("sdiv", 2, pt)
    t.def("udiv", 2, pt)
    t.def("srem", 2, pt)
    t.def("urem", 2, pt)
    t.def("and", 2, c)
    t.def("or", 2, c)
    t.def("xor", 2, c)
    t.def("shl", 2, p)
    t.def("ashr", 2, p)
    t.def("lshr", 2, p)
    t.def("neg", 1, p)
    t.def("not", 1, p)
    t.def("fadd", 2, c)
    t.def("fsub", 2, p)
    t.def("fmul", 2, c)
    t.def("fdiv", 2, p)
    t.def("frem", 2, p)
    t.def("fneg", 1, p)
    t.def("cmp", 2, p)
    t.def("fcmp", 2, p)
    t.def("trunc", 1, p)
    t.def("sext", 1, p)
    t.def("zext", 1, p)
    t.def("fptosi", 1, p)
    t.def("fptoui", 1, p)
    t.def("sitofp", 1, p)
    t.def("uitofp", 1, p)
    t.def("fpext", 1, p)
    t.def("fptrunc", 1, p)
    t.def("bitcast", 1, p)
    t.def("ptrtoint", 1, p)
    t.def("inttoptr", 1, p)
    t.def("extract", 1, p)
    t.def("insert", 2, p)
    t.def("slot", 0, f_allocs())
    t.def("load", 1, f_reads())
    t.def("store", 2, f_writes())
    t.def("field", 1, p)
    t.def("index", 2, p)
    t.def("call", var_args(), f_reads() | f_writes() | f_allocs())
    t.def("ccall", var_args(), f_reads() | f_writes() | f_allocs())
    t.def("calli", var_args(), f_reads() | f_writes() | f_allocs())
    t.def("alloc", 0, f_allocs())
    t.def("free", 1, f_writes() | f_consumes())
    t.def("drop", 1, f_writes() | f_consumes())
    t.def("clone", 1, f_reads() | f_allocs())
    t.def("own.move", 1, f_consumes())
    t.def("br", 0, f_term())
    t.def("condbr", 1, f_term())
    t.def("switch", 1, f_term())
    t.def("ret", 1, f_term())
    t.def("unreachable", 0, f_term())
    /#/ The vector loop of `vectorize`: arguments as for a call; see `gen_vloop`.
    t.def("vloop", var_args(), f_reads() | f_writes())
    /#/ The high 64 bits of the signed 128-bit product; made by `legalize` for a division by a constant.
    t.def("smulhi", 2, p)
    return t

/#/ Output that needs no C library beyond `write`: every stage prints with these.
use write in libc of c

/#/ Writes `s` to standard output, at once (no buffering).
fn say(s: str) => void:
    write(1, s as object, len(s))

/#/ Writes the byte `c` to standard output.
fn say_byte(c: int) => void:
    let b: buf<i8> = new_buf(i8, 1)
    b[0] = i8(c)
    write(1, buf_ptr(b), 1)

use write, open, close in libc of c

class Txt:
    b: buf<int>
    n: int

    fn put_byte(self, c: int) => void:
        if self.n >= len(self.b):
            self.b = buf_resize(self.b, (self.n + 1) * 2)
        self.b[self.n] = c
        self.n = self.n + 1

    fn put(self, s: &str) => void:
        for i in 0..len(s):
            self.put_byte(ch(s, i))

    fn clear(self) => void:
        self.n = 0

    fn put_all(self, w: &Txt) => void:
        if self.n + w.n > len(self.b):
            self.b = buf_resize(self.b, (self.n + w.n) * 2)
        for i in 0..w.n:
            self.b[self.n + i] = w.b[i]
        self.n = self.n + w.n

    fn put_int(self, v: int) => void:
        if v < 0 - 9223372036854775807:
            /#/ the smallest int has no negation
            self.put_byte('-')
            self.put_int(922337203685477580)
            self.put_byte('8')
        elif v < 0:
            self.put_byte('-')
            self.put_int(0 - v)
        elif v < 10:
            self.put_byte('0' + v)
        else:
            self.put_int(v // 10)
            self.put_byte('0' + v % 10)

    /#/ `v` (not negative) in lower-case hexadecimal.
    fn put_hex(self, v: int) => void:
        if v >= 16:
            self.put_hex(v >> 4)
        let d = v & 15
        if d < 10:
            self.put_byte('0' + d)
        else:
            self.put_byte('a' + d - 10)

    /#/ Is the text the same as `o`?
    fn same(self, o: &Txt) => bool:
        if self.n != o.n:
            return false
        for i in 0..self.n:
            if self.b[i] != o.b[i]:
                return false
        return true

    /#/ Does the text equal `want`?
    fn is(self, want: &str) => bool:
        if self.n != len(want):
            return false
        for i in 0..self.n:
            if self.b[i] != ch(want, i):
                return false
        return true

fn new_txt() => Txt:
    return Txt { b: new_buf(int, 256), n: 0 }


/#/ Writes the bytes of `t` to the file `path`.
fn save_bytes(path: str, t: &Txt) => void:
    let fd = open(path, 577, 420 as object)
    if fd < 0:
        return
    let chunk: buf<i8> = new_buf(i8, t.n + 1)
    for k in 0..t.n:
        chunk[k] = i8(t.b[k])
    let done = 0
    while done < t.n:
        let w = write(fd, (int(buf_ptr(chunk)) + done) as object, t.n - done)
        if w <= 0:
            break
        done = done + w
    close(fd)


class Col:
    b: buf<int>
    n: int

    fn push(self, v: int) => void:
        if self.n >= len(self.b):
            self.b = buf_resize(self.b, (self.n + 1) * 2)
        self.b[self.n] = v
        self.n = self.n + 1

fn new_col() => Col:
    return Col { b: new_buf(int, 16), n: 0 }

fn align_to(v: int, a: int) => int:
    if a <= 1:
        return v
    return (v + a - 1) // a * a

fn rd16(t: &Txt, at: int) => int:
    return t.b[at] | (t.b[at + 1] << 8)

fn rd32(t: &Txt, at: int) => int:
    return t.b[at] | (t.b[at + 1] << 8) | (t.b[at + 2] << 16) | (t.b[at + 3] << 24)

/#/ Eight bytes as a two's complement integer.
fn rd64(t: &Txt, at: int) => int:
    return rd32(t, at) | (rd32(t, at + 4) << 32)

/#/ Four bytes, big endian (the numbers inside an `ar` archive).
fn rd32be(t: &Txt, at: int) => int:
    return (t.b[at] << 24) | (t.b[at + 1] << 16) | (t.b[at + 2] << 8) | t.b[at + 3]

fn wr32(t: &Txt, at: int, v: int) => void:
    for k in 0..4:
        t.b[at + k] = (v >> (8 * k)) & 255

fn wr64(t: &Txt, at: int, v: int) => void:
    for k in 0..8:
        t.b[at + k] = (v >> (8 * k)) & 255

/#/ `n` zero bytes at the end of `t`.
fn put_zeros(t: &Txt, n: int) => void:
    for k in 0..n:
        t.put_byte(0)

/#/ The NUL-ended string at `at`.
fn cstr_at(t: &Txt, at: int) => Txt:
    let r = new_txt()
    let k = at
    while k < t.n && t.b[k] != 0:
        r.put_byte(t.b[k])
        k = k + 1
    return r

/#/ Strings built at run time from bytes. There is no way to make a `str` from a buffer, so a byte
/#/ becomes a one-character literal and the pieces are joined pairwise (O(n log n), not O(n^2)).

/#/ The one-character string of byte `c` (anything outside printable ASCII, tab and newline is `?`).
fn ch_str(c: int) => str:
    if c == 32:
        return " "
    if c == 33:
        return "!"
    if c == 34:
        return "\""
    if c == 35:
        return "#"
    if c == 36:
        return "$"
    if c == 37:
        return "%"
    if c == 38:
        return "&"
    if c == 39:
        return "'"
    if c == 40:
        return "("
    if c == 41:
        return ")"
    if c == 42:
        return "*"
    if c == 43:
