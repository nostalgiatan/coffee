    if c == 75:
        return "K"
    if c == 76:
        return "L"
    if c == 77:
        return "M"
    if c == 78:
        return "N"
    if c == 79:
        return "O"
    if c == 80:
        return "P"
    if c == 81:
        return "Q"
    if c == 82:
        return "R"
    if c == 83:
        return "S"
    if c == 84:
        return "T"
    if c == 85:
        return "U"
    if c == 86:
        return "V"
    if c == 87:
        return "W"
    if c == 88:
        return "X"
    if c == 89:
        return "Y"
    if c == 90:
        return "Z"
    if c == 91:
        return "["
    if c == 92:
        return "\\"
    if c == 93:
        return "]"
    if c == 94:
        return "^"
    if c == 95:
        return "_"
    if c == 96:
        return "`"
    if c == 97:
        return "a"
    if c == 98:
        return "b"
    if c == 99:
        return "c"
    if c == 100:
        return "d"
    if c == 101:
        return "e"
    if c == 102:
        return "f"
    if c == 103:
        return "g"
    if c == 104:
        return "h"
    if c == 105:
        return "i"
