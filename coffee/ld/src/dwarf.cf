/#/ DWARF for a linked executable: the function addresses the link gave, for `dwcore.cf`.
use * in link
use * in dwcore

/#/ Makes the four sections; false when no function has lines.
fn build_dwarf(l: &Linker, base: int, abbrev: &Txt, info: &Txt, line: &Txt, frame: &Txt) => bool:
    let t = &l.dbg
    let ta = new_dw_list()
    let ts = new_dw_list()
    let start = 0
    for i in 0..t.n + 1:
        if i < t.n && t.b[i] != 10:
            continue
        if i > start + 2 && t.b[start] == int('F') && t.b[start + 1] == 32:
            let w = new_txt()
            for k in start + 2..i:
                w.put_byte(t.b[k])
            let addr = 0 - 1
            let size = 0
            let id = l.find(&w)
            if id >= 0 && l.g_def.b[id] >= 0:
                let sid = l.g_def.b[id]
                let f = l.final_sym(sid)
                let sec = l.y_sec.b[f]
                if sec >= 0 && sec < l.sc_grp.n && l.sc_grp.b[sec] >= 0:
                    addr = l.sym_addr(sid, base)
                    size = l.y_size.b[f]
            dw_push(&ta, addr)
            dw_push(&ts, size)
        start = i + 1
    return build_dwarf_core(t, &ta, &ts, abbrev, info, line, frame)
