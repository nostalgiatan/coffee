/#/ Ported from tests/class_tests.rs; the self-hosted compiler does not pass these yet.
use * in harness

fn part0() => int:
    let bad = 0
    bad = bad + compiles("class::test_class_defined_inside_function_compiles", "\nfn main() => int:\n    class Point:\n        x: int\n        y: int\n    let p: Point = Point { x: 1, y: 2 }\n    printf(\"Point: %d,%d\\n\", p.x, p.y)\n    rm p\n    return 0\n\n")
    return bad

fn main() => int:
    let bad = 0
    bad = bad + part0()
    return bad
