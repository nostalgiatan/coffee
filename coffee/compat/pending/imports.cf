/#/ Ported from tests/imports_tests.rs; the self-hosted compiler does not pass these yet.
use * in harness

fn part0() => int:
    let bad = 0
    bad = bad + compiles("imports::test_import_coffee_module", "\nuse mymodule\n\nfn main() => int:\n    return 0\n\n")
    bad = bad + compiles("imports::test_import_coffee_module_with_alias", "\nuse mymodule as mymod\n\nfn main() => int:\n    return 0\n\n")
    bad = bad + compiles("imports::test_import_specific_function", "\nuse myfunction in mymodule\n\nfn main() => int:\n    return 0\n\n")
    bad = bad + compiles("imports::test_import_specific_function_with_alias", "\nuse myfunction as myfunc in mymodule\n\nfn main() => int:\n    return 0\n\n")
    bad = bad + rejected("imports::test_unknown_c_lib_without_cfc_does_not_guess_signature", "\nuse hello_world in fakelib of c\n\nfn main() => int:\n    hello_world()\n    return 0\n\n", 0)
    return bad

fn main() => int:
    let bad = 0
    bad = bad + part0()
    return bad
