/#/ Ported from tests/pattern_matching_tests.rs; the self-hosted compiler does not pass these yet.
use * in harness

fn part0() => int:
    let bad = 0
    bad = bad + compiles("pattern_matching::test_match_float_literal", "\nfn main() => int:\n    let x: float = 3.14\n    match x:\n        0.0 => 0\n        1.0 => 1\n        3.14 => 100\n        _ => -1\n    rm x\n    return 0\n\n")
    bad = bad + compiles("pattern_matching::test_match_string_literal", "\nfn main() => int:\n    let x: str = \"hello\"\n    match x:\n        \"hello\" => 1\n        \"world\" => 2\n        _ => 0\n    rm x\n    return 0\n\n")
    bad = bad + compiles("pattern_matching::test_match_str_equality_and_inequality", "\nfn main() => int:\n    let s: str = \"a\"\n    match s:\n        \"a\" => 1\n        \"b\" => 2\n        _ => 0\n    rm s\n    return 0\n\n")
    bad = bad + compiles("pattern_matching::test_match_tuple", "\nfn main() => int:\n    let t: (int, int) = (10, 20)\n    match t:\n        (1, 2) => 100\n        (10, 20) => 200\n        _ => 0\n    rm t\n    return 0\n\n")
    bad = bad + compiles("pattern_matching::test_match_tuple_with_variables", "\nfn main() => int:\n    let t: (int, int) = (10, 20)\n    match t:\n        (x, y) => x + y\n    rm t\n    return 0\n\n")
    bad = bad + compiles("pattern_matching::test_match_tuple_with_wildcard", "\nfn main() => int:\n    let t: (int, int, int) = (10, 20, 30)\n    match t:\n        (x, _, _) => x\n        (_, y, _) => y\n        (_, _, z) => z\n    rm t\n    return 0\n\n")
    bad = bad + compiles("pattern_matching::test_match_nested_tuple", "\nfn main() => int:\n    let t: ((int, int), int) = ((10, 20), 30)\n    match t:\n        ((x, y), z) => x + y + z\n    rm t\n    return 0\n\n")
    bad = bad + compiles("pattern_matching::test_match_triple_tuple", "\nfn main() => int:\n    let t: (int, int, int) = (1, 2, 3)\n    match t:\n        (1, 2, 3) => 100\n        (4, 5, 6) => 200\n        _ => 0\n    rm t\n    return 0\n\n")
    bad = bad + compiles("pattern_matching::test_match_nested_enum", "\nenum Option:\n    Some(int)\n    None\n\nenum Result:\n    Success(Option)\n    Failure(str)\n\nfn main() => int:\n    let res: Result = Result.Success(Option.Some(42))\n    match res:\n        Result.Success(Option.Some(x)) => x\n        Result.Success(Option.None) => 0\n        Result.Failure(msg) => -1\n    rm res\n    return 0\n\n")
    bad = bad + compiles("pattern_matching::test_match_complex_nested", "\nenum Option:\n    Some(int)\n    None\n\nenum Result:\n    Ok(Option)\n    Error(str)\n\nfn main() => int:\n    let res: Result = Result.Ok(Option.Some(42))\n    match res:\n        Result.Ok(Option.Some(x)) => x * 2\n        Result.Ok(Option.None) => 0\n        Result.Error(msg) => -1\n    rm res\n    return 0\n\n")
    bad = bad + compiles("pattern_matching::test_match_negative_value", "\nfn main() => int:\n    let x: int = -42\n    match x:\n        -42 => 100\n        _ => 0\n    rm x\n    return 0\n\n")
    bad = bad + compiles("pattern_matching::test_match_with_tuple_patterns", "\nfn main() => int:\n    let point: (int, int) = (10, 20)\n    match point:\n        (0, 0) => 1\n        (x, 0) => 2\n        (0, y) => 3\n        (x, y) => x + y\n    rm point\n    return 0\n\n")
    bad = bad + compiles("pattern_matching::test_match_with_wildcard_in_tuple", "\nfn main() => int:\n    let point: (int, int, int) = (10, 20, 30)\n    match point:\n        (x, _, z) => x + z\n        _ => 0\n    rm point\n    return 0\n\n")
    bad = bad + compiles("pattern_matching::test_match_with_or_patterns", "\nfn main() => int:\n    let x: int = 5\n    match x:\n        1 | 2 | 3 => 1\n        4 | 5 | 6 => 2\n        _ => 0\n    rm x\n    return 0\n\n")
    bad = bad + compiles("pattern_matching::test_match_with_class_field_patterns", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let p: Point = Point { x: 10, y: 20 }\n    match p:\n        Point { x: 0, y: 0 } => 1\n        Point { x: _, y: 0 } => 2\n        Point { x: 0, y: _ } => 3\n        Point { x: a, y: b } => a + b\n    rm p\n    return 0\n\n")
    bad = bad + compiles("pattern_matching::test_match_with_nested_class", "\nclass Point:\n    x: int\n    y: int\n\nclass Rectangle:\n    top_left: Point\n    bottom_right: Point\n\nfn main() => int:\n    let r: Rectangle = Rectangle {\n        top_left: Point { x: 0, y: 10 },\n        bottom_right: Point { x: 10, y: 0 }\n    }\n    match r:\n        Rectangle { top_left: Point { x: 0, y: _ }, bottom_right: _ } => 1\n        _ => 0\n    rm r\n    return 0\n\n")
    return bad

fn main() => int:
    let bad = 0
    bad = bad + part0()
    return bad
