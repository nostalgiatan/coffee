/#/ Ported from tests/pattern_matching_tests.rs; the self-hosted compiler does not pass these yet.
use * in harness

fn part0() => int:
    let bad = 0
    bad = bad + compiles("pattern_matching::test_match_with_or_patterns", "\nfn main() => int:\n    let x: int = 5\n    match x:\n        1 | 2 | 3 => 1\n        4 | 5 | 6 => 2\n        _ => 0\n    rm x\n    return 0\n\n")
    bad = bad + compiles("pattern_matching::test_match_with_class_field_patterns", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let p: Point = Point { x: 10, y: 20 }\n    match p:\n        Point { x: 0, y: 0 } => 1\n        Point { x: _, y: 0 } => 2\n        Point { x: 0, y: _ } => 3\n        Point { x: a, y: b } => a + b\n    rm p\n    return 0\n\n")
    bad = bad + compiles("pattern_matching::test_match_with_nested_class", "\nclass Point:\n    x: int\n    y: int\n\nclass Rectangle:\n    top_left: Point\n    bottom_right: Point\n\nfn main() => int:\n    let r: Rectangle = Rectangle {\n        top_left: Point { x: 0, y: 10 },\n        bottom_right: Point { x: 10, y: 0 }\n    }\n    match r:\n        Rectangle { top_left: Point { x: 0, y: _ }, bottom_right: _ } => 1\n        _ => 0\n    rm r\n    return 0\n\n")
    return bad

fn main() => int:
    let bad = 0
    bad = bad + part0()
    return bad
