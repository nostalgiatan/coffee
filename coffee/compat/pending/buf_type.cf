/#/ Ported from tests/buf_type_tests.rs; the self-hosted compiler does not pass these yet.
use * in harness

fn part0() => int:
    let bad = 0
    bad = bad + rejected("buf_type::test_clone_buf_is_type_error", "\nuse malloc in libc of c\n\nfn main() => int:\n    let p: buf = malloc(8)\n    clone p q\n    return 0\n", 0)
    bad = bad + rejected("buf_type::test_unary_clone_buf_is_type_error", "\nuse malloc in libc of c\n\nfn main() => int:\n    let p: buf = malloc(8)\n    let q: buf = clone p\n    return 0\n", 0)
    return bad

fn main() => int:
    let bad = 0
    bad = bad + part0()
    return bad
