/#/ Ported from tests/memory_tests.rs; the self-hosted compiler does not pass these yet.
use * in harness

fn part0() => int:
    let bad = 0
    bad = bad + compiles("memory::test_rm_in_fallthrough_branch_then_rm_again_is_error", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let p: Point = Point { x: 10, y: 20 }\n    let flag: int = 0\n    if flag > 0:\n        rm p\n    rm p\n    return 0\n\n")
    return bad

fn main() => int:
    let bad = 0
    bad = bad + part0()
    return bad
