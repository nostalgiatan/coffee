/#/ Ported from tests/expressions_tests.rs; the self-hosted compiler does not pass these yet.
use * in harness

fn part0() => int:
    let bad = 0
    bad = bad + compiles("expressions::test_fstring_compiles", "\nfn main() => int:\n    let name: str = \"world\"\n    let s: str = f\"Hello {name}\"\n    rm s\n    rm name\n    return 0\n\n")
    return bad

fn main() => int:
    let bad = 0
    bad = bad + part0()
    return bad
