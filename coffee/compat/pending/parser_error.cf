/#/ Ported from tests/parser_error_tests.rs; the self-hosted compiler does not pass these yet.
use * in harness

fn part0() => int:
    let bad = 0
    bad = bad + rejected("parser_error::slash_slash_comment_is_syntax_error_2", "\n// not a coffee comment\nfn main() => int:\n    return 0\n", 1)
    bad = bad + rejected("parser_error::missing_fn_colon_2", "\nfn main() => int\n    return 0\n", 3)
    bad = bad + rejected("parser_error::python_def_is_unexpected_token_2", "\ndef foo() => int:\n    return 0\n", 2)
    return bad

fn main() => int:
    let bad = 0
    bad = bad + part0()
    return bad
