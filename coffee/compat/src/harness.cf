/#/ Cases ported from the integration tests of the Rust compiler: a program and what is expected of it.
/#/ Each returns 0 for a pass and 1 for a failure, and names the case on a failure.
use * in say
use * in drive
use fflush in libc of c

/#/ The program compiles to an object.
fn compiles(name: str, src: str) => int:
    let dup = clone src
    let o = build_src(src, 1)
    if o.n == 0:
        say(f"FAIL {name}: does not compile\n{dup}\n")
        fflush(0)
        return 1
    return 0

/#/ The front end rejects the program; `code` is the number of the finding expected, 0 for any.
fn rejected(name: str, src: str, code: int) => int:
    let dup = clone src
    let got = first_error(src)
    if got < 0:
        say(f"FAIL {name}: accepted, want an error\n{dup}\n")
        fflush(0)
        return 1
    if code > 0 && got != code:
        say(f"FAIL {name}: error {got}, want {code}\n{dup}\n")
        fflush(0)
        return 1
    return 0

/#/ The program runs and ends with `want`.
fn exits(name: str, src: str, want: int) => int:
    let dup = clone src
    let r = run_src(src, false)
    if r != want:
        say(f"FAIL {name}: exit {r}, want {want}\n{dup}\n")
        fflush(0)
        return 1
    return 0

/#/ The program parses; whether its imports resolve is the driver's business.
fn parses(name: str, src: str) => int:
    let dup = clone src
    let a = parse(src)
    if a.err_count > 0:
        say(f"FAIL {name}: does not parse\n{dup}\n")
        fflush(0)
        return 1
    return 0

/#/ The program runs without leaking, double freeing or corrupting memory, whatever it returns
/#/ (the Rust test counted malloc and free; here the address sanitizer says so).
fn balanced(name: str, src: str) => int:
    let dup = clone src
    let r = run_src(src, true)
    if r < 0 || r == 99:
        say(f"FAIL {name}: exit {r} (memory error or leak)\n{dup}\n")
        fflush(0)
        return 1
    return 0
