fn part2() => int:
    let bad = 0
    bad = bad + exits("language_holes::test_str_borrow_reads_bytes_and_length#1", "fn at(s: &str, i: int) => int:\n    return int(s[i]) + len(s)\n\nfn main() => int:\n    let s: str = \"hel\" + \"lo\"\n    let a = at(&s, 1)\n    let b = at(&s, 0)\n    return b - a\n", 3)
    bad = bad + balanced("language_holes::test_str_borrow_reads_bytes_and_length#2", "fn at(s: &str, i: int) => int:\n    return int(s[i]) + len(s)\n\nfn main() => int:\n    let s: str = \"hel\" + \"lo\"\n    let a = at(&s, 1)\n    let b = at(&s, 0)\n    return b - a\n")
    bad = bad + exits("language_holes::test_string_literal_can_be_lent_to_a_str_borrow", "fn n(s: &str) => int:\n    return len(s)\n\nfn main() => int:\n    return n(\"hello\")\n", 5)
    bad = bad + exits("language_holes::test_subtracting_a_negative_is_not_an_overflow", "fn n(x: int) => int:\n    return 0 - x\n\nfn main() => int:\n    let a = 3 - n(5)\n    let b = n(5) - n(3)\n    return a + b - 6\n", 0)
    bad = bad + exits("language_holes::test_else_belongs_to_the_if_nested_in_the_body", "fn h(c: int) => int:\n    let j = 0\n    if c == 2:\n        let l = 2\n        if l == 0:\n            j = 1\n        else:\n            j = 5\n    else:\n        j = 9\n    return j\n\nfn main() => int:\n    return h(2) * 10 + h(3) - 59\n", 0)
    bad = bad + exits("language_holes::test_buf_resize_argument_declared_in_a_branch#1", "fn f(b: buf<int>) => int:\n    if 1 > len(b):\n        let cap = 4\n        b = buf_resize(b, cap)\n    return len(b)\n\nfn main() => int:\n    return f(new_buf(int, 0)) - 4\n", 0)
    bad = bad + balanced("language_holes::test_buf_resize_argument_declared_in_a_branch#2", "fn f(b: buf<int>) => int:\n    if 1 > len(b):\n        let cap = 4\n        b = buf_resize(b, cap)\n    return len(b)\n\nfn main() => int:\n    return f(new_buf(int, 0)) - 4\n")
    bad = bad + balanced("language_holes::test_buf_parameter_is_freed_by_the_callee#1", "fn f(b: buf<int>) => int:\n    return len(b)\n\nfn main() => int:\n    return f(new_buf(int, 1)) - 1\n")
    bad = bad + balanced("language_holes::test_buf_parameter_is_freed_by_the_callee#2", "fn f(b: buf<int>) => int:\n    if 1 > len(b):\n        b = buf_resize(b, 4)\n    return len(b)\n\nfn main() => int:\n    return f(new_buf(int, 0)) - 4\n")
