    bad = bad + exits("language_holes::test_subslice_ranges#2", "fn sum(xs: [int]) => int:\n    let t = 0\n    for x in xs:\n        t = t + x\n    return t\n\nfn main() => int:\n    let b: buf<int> = new_buf(int, 4)\n    b[0] = 1\n    b[1] = 2\n    b[2] = 3\n    b[3] = 4\n    return sum(b[2..])\n", 7)
    bad = bad + exits("language_holes::test_subslice_ranges#3", "fn sum(xs: [int]) => int:\n    let t = 0\n    for x in xs:\n        t = t + x\n    return t\n\nfn main() => int:\n    let b: buf<int> = new_buf(int, 4)\n    b[0] = 1\n    b[1] = 2\n    b[2] = 3\n    b[3] = 4\n    return sum(b[..2])\n", 3)
    bad = bad + exits("language_holes::test_subslice_ranges#4", "fn sum(xs: [int]) => int:\n    let t = 0\n    for x in xs:\n        t = t + x\n    return t\n\nfn main() => int:\n    let b: buf<int> = new_buf(int, 4)\n    b[0] = 1\n    b[1] = 2\n    b[2] = 3\n    b[3] = 4\n    return len(b[1..3])\n", 2)
    bad = bad + balanced("language_holes::test_subslice_ranges#5", "fn sum(xs: [int]) => int:\n    let t = 0\n    for x in xs:\n        t = t + x\n    return t\n\nfn main() => int:\n    let b: buf<int> = new_buf(int, 4)\n    b[0] = 1\n    b[1] = 2\n    b[2] = 3\n    b[3] = 4\n    return sum(b[1..3])\n")
    bad = bad + rejected("language_holes::test_subslice_cannot_be_stored", "fn main() => int:\n    let b: buf<int> = new_buf(int, 4)\n    let s = b[1..3]\n    return 0\n", 0)
    bad = bad + balanced("language_holes::test_reassigning_a_moved_variable_rearms_its_drop#1", "fn id(s: str) => str:\n    return s\n\nfn main() => int:\n    let s: str = \"a\" + \"b\"\n    s = id(s)\n    return 0\n")
    bad = bad + exits("language_holes::test_reassigning_a_moved_variable_rearms_its_drop#2", "fn grow(toks: buf<int>, need: int) => buf<int>:\n    let t = toks\n    if need > len(t):\n        t = buf_resize(t, need * 2)\n    return t\n\nfn main() => int:\n    let b: buf<int> = new_buf(int, 2)\n    b = grow(b, 5)\n    b = grow(b, 1)\n    return len(b)\n", 10)
    bad = bad + balanced("language_holes::test_reassigning_a_moved_variable_rearms_its_drop#3", "fn grow(toks: buf<int>, need: int) => buf<int>:\n    let t = toks\n    if need > len(t):\n        t = buf_resize(t, need * 2)\n    return t\n\nfn main() => int:\n    let b: buf<int> = new_buf(int, 2)\n    b = grow(b, 5)\n    b = grow(b, 1)\n    return len(b)\n")
    bad = bad + exits("language_holes::test_lexer_written_in_coffee#1", "use printf in libc of c\n\nclass Lexer:\n    src: str\n    pos: int\n    toks: buf<int>\n    count: int\n\nfn is_digit(c: int) => bool:\n    return c >= 48 && c <= 57\n\nfn is_alpha(c: int) => bool:\n    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95\n\nfn is_space(c: int) => bool:\n    return c == 32 || c == 9\n\nfn push_tok(toks: buf<int>, count: int, kind: int, start: int, end: int) => buf<int>:\n    let need = (count + 1) * 3\n    let t = toks\n    if need > len(t):\n        t = buf_resize(t, need * 2)\n    t[count * 3] = kind\n    t[count * 3 + 1] = start\n    t[count * 3 + 2] = end\n    return t\n\nfn lex(src: str) => int:\n    let n = len(src)\n    let toks: buf<int> = new_buf(int, 6)\n    let count = 0\n    let i = 0\n    while i < n:\n        let c = int(src[i])\n        if is_space(c):\n            i = i + 1\n        elif is_digit(c):\n            let s = i\n            while i < n && is_digit(int(src[i])):\n                i = i + 1\n            toks = push_tok(toks, count, 1, s, i)\n            count = count + 1\n        elif is_alpha(c):\n            let s = i\n            while i < n && (is_alpha(int(src[i])) || is_digit(int(src[i]))):\n                i = i + 1\n            toks = push_tok(toks, count, 2, s, i)\n            count = count + 1\n        else:\n            toks = push_tok(toks, count, 3, i, i + 1)\n            count = count + 1\n            i = i + 1\n    let sum = 0\n    for k in 0..count:\n        sum = sum + toks[k * 3]\n    return sum\n\nfn main() => int:\n    return lex(\"let x1 = 42 + y\")\n", 13)
    bad = bad + balanced("language_holes::test_lexer_written_in_coffee#2", "use printf in libc of c\n\nclass Lexer:\n    src: str\n    pos: int\n    toks: buf<int>\n    count: int\n\nfn is_digit(c: int) => bool:\n    return c >= 48 && c <= 57\n\nfn is_alpha(c: int) => bool:\n    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95\n\nfn is_space(c: int) => bool:\n    return c == 32 || c == 9\n\nfn push_tok(toks: buf<int>, count: int, kind: int, start: int, end: int) => buf<int>:\n    let need = (count + 1) * 3\n    let t = toks\n    if need > len(t):\n        t = buf_resize(t, need * 2)\n    t[count * 3] = kind\n    t[count * 3 + 1] = start\n    t[count * 3 + 2] = end\n    return t\n\nfn lex(src: str) => int:\n    let n = len(src)\n    let toks: buf<int> = new_buf(int, 6)\n    let count = 0\n    let i = 0\n    while i < n:\n        let c = int(src[i])\n        if is_space(c):\n            i = i + 1\n        elif is_digit(c):\n            let s = i\n            while i < n && is_digit(int(src[i])):\n                i = i + 1\n            toks = push_tok(toks, count, 1, s, i)\n            count = count + 1\n        elif is_alpha(c):\n            let s = i\n            while i < n && (is_alpha(int(src[i])) || is_digit(int(src[i]))):\n                i = i + 1\n            toks = push_tok(toks, count, 2, s, i)\n            count = count + 1\n        else:\n            toks = push_tok(toks, count, 3, i, i + 1)\n            count = count + 1\n            i = i + 1\n    let sum = 0\n    for k in 0..count:\n        sum = sum + toks[k * 3]\n    return sum\n\nfn main() => int:\n    return lex(\"let x1 = 42 + y\")\n")
    bad = bad + exits("language_holes::test_token_lexer_written_in_coffee#1", "class Tokens:\n    data: buf<int>\n    count: int\n\n    fn push(self, kind: int, start: int, end: int) => void:\n        let need = (self.count + 1) * 3\n        if need > len(self.data):\n            self.data = buf_resize(self.data, need * 2)\n        self.data[self.count * 3] = kind\n        self.data[self.count * 3 + 1] = start\n        self.data[self.count * 3 + 2] = end\n        self.count = self.count + 1\n\nfn is_digit(c: int) => bool:\n    return c >= 48 && c <= 57\n\nfn is_alpha(c: int) => bool:\n    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95\n\nfn matches_at(src: &str, at: int, word: &str) => bool:\n    let n = len(word)\n    if at + n > len(src):\n        return false\n    for k in 0..n:\n        if src[at + k] != word[k]:\n            return false\n    return true\n\nfn keyword_kind(src: &str, s: int, e: int) => int:\n    let n = e - s\n    if n == 2 && matches_at(src, s, \"fn\"):\n        return 10\n    if n == 3 && matches_at(src, s, \"let\"):\n        return 11\n    if n == 6 && matches_at(src, s, \"return\"):\n        return 12\n    return 2\n\nfn lex(src: &str) => Tokens:\n    let n = len(src)\n    let t = Tokens { data: new_buf(int, 6), count: 0 }\n    let i = 0\n    while i < n:\n        let c = int(src[i])\n        if c == 32 || c == 9 || c == 10:\n            i = i + 1\n        elif c == 35:\n            while i < n && int(src[i]) != 10:\n                i = i + 1\n        elif is_digit(c):\n            let s = i\n            while i < n && is_digit(int(src[i])):\n                i = i + 1\n            t.push(1, s, i)\n        elif is_alpha(c):\n            let s = i\n            while i < n && (is_alpha(int(src[i])) || is_digit(int(src[i]))):\n                i = i + 1\n            t.push(keyword_kind(src, s, i), s, i)\n        elif c == 61 && i + 1 < n && int(src[i + 1]) == 61:\n            t.push(20, i, i + 2)\n            i = i + 2\n        