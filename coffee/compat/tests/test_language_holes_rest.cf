    bad = bad + exits("language_holes::test_non_ascii_text_in_a_let_does_not_panic_the_parser", "fn main() => int:\n    let s = \"x /#/ 单\"\n    return len(&s) - 9\n", 0)
    bad = bad + exits("language_holes::test_comment_marker_after_an_escaped_quote_in_a_string_is_text", "fn show(s: &str) => int:\n    return len(s)\n\nfn main() => int:\n    let n = show(\"{ \\\" /#/\")\n    return n - 7\n", 0)
    bad = bad + exits("language_holes::test_int_cast_widens_u8_without_sign_extension", "fn main() => int:\n    let s = \"\\xffA\"\n    return int(s[0]) - 255 + int(s[1]) - 65\n", 0)
    bad = bad + exits("language_holes::test_bool_assigned_from_comparison_negates_correctly", "fn pick(n: int, k: int) => int:\n    let has = n >= 0\n    if k == 1:\n        has = true\n    if !has:\n        return 0\n    return 1\n\nfn main() => int:\n    return pick(2, 5) + pick(2, 1) * 10 + pick(-2, 5) * 100\n", 11)
    bad = bad + exits("language_holes::test_index_store_evaluates_the_value_before_the_buffer_address", "class H:\n    a: buf<int>\n\n    fn grow(self) => int:\n        self.a = buf_resize(self.a, 100)\n        return 7\n\n    fn put(self) => void:\n        self.a[0] = self.grow()\n\nfn main() => int:\n    let h = H { a: new_buf(int, 2) }\n    h.put()\n    return h.a[0]\n", 7)
