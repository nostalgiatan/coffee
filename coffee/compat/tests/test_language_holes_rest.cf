/#/ Ported from tests/language_holes_tests.rs: the cases the first port left out.
use * in harness

fn part0() => int:
    let bad = 0
    bad = bad + rejected("language_holes::test_let_from_field_is_rejected", "class C:\n    name: str\n\nfn main() => int:\n    let c: C = C { name: \"n\" }\n    let s: str = c.name\n    return 0\n", 302)
    bad = bad + rejected("language_holes::test_return_field_is_rejected", "class C:\n    name: str\n\nfn get(c: C) => str:\n    return c.name\n\nfn main() => int:\n    return 0\n", 302)
    bad = bad + rejected("language_holes::test_call_arg_from_field_is_rejected", "class C:\n    name: str\n\nfn eat(s: str) => int:\n    return 1\n\nfn main() => int:\n    let c: C = C { name: \"n\" }\n    return eat(c.name)\n", 302)
    bad = bad + rejected("language_holes::test_let_from_array_element_is_rejected", "fn main() => int:\n    let a: [str; 1] = [\"x\" + \"y\"]\n    let s: str = a[0]\n    return 0\n", 302)
    bad = bad + rejected("language_holes::test_struct_field_from_field_is_rejected", "class C:\n    name: str\n\nclass D:\n    n: str\n\nfn main() => int:\n    let c: C = C { name: \"n\" }\n    let d: D = D { n: c.name }\n    return 0\n", 302)
    bad = bad + balanced("language_holes::test_clone_of_field_is_balanced", "class C:\n    name: str\n\nfn main() => int:\n    let c: C = C { name: \"a\" + \"b\" }\n    let s: str = clone c.name\n    return 0\n")
    bad = bad + exits("language_holes::test_value_field_read_is_allowed", "class C:\n    n: int\n\nfn main() => int:\n    let c: C = C { n: 3 }\n    let a: int = c.n\n    return a\n", 3)
    bad = bad + balanced("language_holes::test_str_array_of_literals_is_balanced", "fn main() => int:\n    let a: [str; 2] = [\"a\", \"b\"]\n    return 0\n")
    bad = bad + balanced("language_holes::test_str_tuple_of_literals_is_balanced", "fn main() => int:\n    let t: (str, int) = (\"a\", 1)\n    return 0\n")
    bad = bad + rejected("language_holes::test_duplicate_function_is_an_error", "fn f() => int:\n    return 1\n\nfn f() => int:\n    return 2\n\nfn main() => int:\n    return f()\n", 201)
    bad = bad + rejected("language_holes::test_dedent_to_unknown_level_is_an_error", "fn main() => int:\n    if true:\n        return 1\n      return 2\n", 0)
    bad = bad + rejected("language_holes::test_mixed_int_float_arithmetic_is_a_type_error", "fn main() => int:\n    let a: int = 1\n    let b: float = 2.0\n    let c: float = a + b\n    return 0\n", 104)
    bad = bad + exits("language_holes::test_float_cast_makes_mixed_arithmetic_explicit", "fn main() => int:\n    let a: int = 1\n    let b: float = 2.0\n    let c: float = float(a) + b\n    return int(c)\n", 3)
    bad = bad + exits("language_holes::test_payload_free_enum_equality", "enum E:\n    A\n    B\n\nfn main() => int:\n    let a: E = E.A\n    if a == E.A:\n        return 1\n    return 0\n", 1)
    bad = bad + exits("language_holes::test_method_chain_on_call_result", "class C:\n    n: int\n    fn me(self) => C:\n        return C { n: self.n }\n    fn get(self) => int:\n        return self.n\n\nfn main() => int:\n    let c: C = C { n: 4 }\n    return c.me().get()\n", 4)
