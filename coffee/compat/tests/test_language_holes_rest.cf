    bad = bad + exits("language_holes::test_method_may_take_its_own_class_by_reference", "class A:\n    n: int\n\n    fn same(self, o: &A) => bool:\n        return self.n == o.n\n\nfn main() => int:\n    let a = A { n: 1 }\n    let b = A { n: 1 }\n    if a.same(&b):\n        return 0\n    return 1\n", 0)
    bad = bad + exits("language_holes::test_function_declared_after_use_may_take_a_class", "fn main() => int:\n    let b = B { n: 3 }\n    return get(&b)\n\nfn get(b: &B) => int:\n    return b.n\n\nclass B:\n    n: int\n", 3)
    bad = bad + exits("language_holes::test_method_called_through_a_class_reference_with_a_loop_variable", "class S:\n    t: str\n\n    fn at(self, i: int) => int:\n        return byte(&self.t, i)\n\nfn byte(s: &str, i: int) => int:\n    return int(s[i])\n\nfn same(a: &S, w: &str) => bool:\n    for k in 0..len(w):\n        if a.at(k) != byte(w, k):\n            return false\n    return true\n\nfn main() => int:\n    let a = S { t: \"ab\" + \"c\" }\n    if same(&a, \"abc\"):\n        return 0\n    return 1\n", 0)
    bad = bad + exits("language_holes::test_comparison_passed_as_a_bool_argument_to_a_method", "fn f(x: int, b: bool) => int:\n    if b:\n        return x\n    return 0\n\nclass C:\n    n: int\n\n    fn g(self, b: bool) => int:\n        if b:\n            return 1\n        return 0\n\nfn mk() => buf<int>:\n    let b: buf<int> = new_buf(int, 2)\n    b[0] = 1\n    return b\n\nfn main() => int:\n    let v = mk()\n    let c = C { n: 1 }\n    return f(5, v[0] == 1) + c.g(v[0] == 1) * 10\n", 15)
    bad = bad + exits("language_holes::test_class_may_define_a_method_named_assign", "class A:\n    n: int\n\n    fn assign(self, a: int, b: int, c: int, d: int, e: int) => int:\n        return a + b + c + d + e + self.n\n\n    fn go(self) => int:\n        return self.assign(1, 2, 3, 4, 5)\n\nfn main() => int:\n    let a = A { n: 1 }\n    return a.go()\n", 16)
    bad = bad + exits("language_holes::test_early_return_of_a_class_does_not_move_it_for_later_code", "class D:\n    n: int\n\nfn make(nb: int) => D:\n    let d = D { n: 1 }\n    if nb == 0:\n        return d\n    d.n = 4\n    return d\n\nfn main() => int:\n    let a = make(0)\n    let b = make(3)\n    return a.n * 10 + b.n\n", 14)
    bad = bad + balanced("language_holes::test_early_return_of_a_string_is_balanced", "fn pick(n: int) => str:\n    let s = \"a\" + \"b\"\n    if n == 0:\n        return s\n    let t = s + \"c\"\n    return t\n\nfn main() => int:\n    let x = pick(0)\n    let y = pick(1)\n    return len(&x) + len(&y) - 5\n")
    bad = bad + balanced("language_holes::test_buf_stored_into_a_field_is_moved_not_freed_twice", "class H:\n    nm: buf<int>\n\n    fn set(self, k: int) => void:\n        let b: buf<int> = new_buf(int, k)\n        for i in 0..k:\n            b[i] = i\n        self.nm = b\n\nfn main() => int:\n    let h = H { nm: new_buf(int, 2) }\n    h.set(5)\n    return len(h.nm) - 5\n")
    bad = bad + balanced("language_holes::test_buf_declared_in_a_branch_is_not_freed_when_the_branch_is_skipped", "fn f(k: int, v: int) => int:\n    if k == 2:\n        if v < 0:\n            return 1\n        let offs: buf<int> = new_buf(int, 4)\n        offs[0] = 3\n        return offs[0]\n    return 0\n\nfn main() => int:\n    return f(1, 1) + f(2, -1) + f(2, 1) - 4\n")
    bad = bad + balanced("language_holes::test_same_name_declared_with_another_type_in_a_disjoint_scope_gets_its_own_slot", "class T:\n    n: int\n    b: buf<int>\n\nfn mk(k: int) => T:\n    return T { n: k, b: new_buf(int, 2) }\n\nfn f(k: int) => int:\n    if k == 1:\n        let x = 5\n        return x\n    if k == 2:\n        let x = mk(3)\n        return x.n\n    let x = \"ab\" + \"cd\"\n    return len(x)\n\nfn main() => int:\n    return f(1) + f(2) + f(3) - 12\n")
    return bad

fn main() => int:
    let bad = 0
    bad = bad + part0()
    bad = bad + part1()
    bad = bad + part2()
    return bad
