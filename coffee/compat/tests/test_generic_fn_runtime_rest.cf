/#/ Ported from tests/generic_fn_runtime_tests.rs: the cases the first port left out.
use * in harness

fn part0() => int:
    let bad = 0
    bad = bad + exits("generic_fn_runtime::test_inferred_generic_fn_runs", "fn id<T>(x: T) => T:\n    return x\n\nfn main() => int:\n    let y: int = id(5)\n    return y\n", 5)
    bad = bad + exits("generic_fn_runtime::test_inferred_generic_fn_with_let_inference", "fn id<T>(x: T) => T:\n    return x\n\nfn main() => int:\n    let y = id(6)\n    return y\n", 6)
    bad = bad + exits("generic_fn_runtime::test_generic_fn_instantiated_at_two_types", "fn id<T>(x: T) => T:\n    return x\n\nfn main() => int:\n    let a: int = id(3)\n    let b: float = id(1.5)\n    if b > 1.0:\n        return a\n    return 0\n", 3)
    return bad

fn main() => int:
    let bad = 0
    bad = bad + part0()
    return bad
