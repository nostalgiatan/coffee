/#/ Ported from tests/memory_tests.rs.
use * in harness

fn part0() => int:
    let bad = 0
    bad = bad + compiles("memory::test_simple_class_cleanup", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let p: Point = Point { x: 10, y: 20 }\n    rm p\n    return 0\n\n")
    bad = bad + compiles("memory::test_full_class_cleanup", "\nclass Point:\n    x: int\n    y: int\n    \n    fn new(x: int, y: int) => Point:\n        Point { x: x, y: y }\n\nfn main() => int:\n    let p: Point = Point::new(10, 20)\n    rm p\n    return 0\n\n")
    bad = bad + compiles("memory::test_multiple_class_cleanup", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let p1: Point = Point { x: 0, y: 0 }\n    let p2: Point = Point { x: 10, y: 10 }\n    let p3: Point = Point { x: 20, y: 20 }\n    rm p3\n    rm p2\n    rm p1\n    return 0\n\n")
    bad = bad + compiles("memory::test_nested_class_cleanup", "\nclass Point:\n    x: int\n    y: int\n\nclass Line:\n    start: Point\n    end: Point\n\nfn main() => int:\n    let p1: Point = Point { x: 0, y: 0 }\n    let p2: Point = Point { x: 100, y: 100 }\n    let line: Line = Line { start: p1, end: p2 }\n    rm line\n    rm p2\n    rm p1\n    return 0\n\n")
    bad = bad + compiles("memory::test_deeply_nested_cleanup", "\nclass Point:\n    x: int\n    y: int\n\nclass Rectangle:\n    top_left: Point\n    bottom_right: Point\n\nclass Shape:\n    rect: Rectangle\n    name: int\n\nfn main() => int:\n    let p1: Point = Point { x: 0, y: 0 }\n    let p2: Point = Point { x: 100, y: 100 }\n    let rect: Rectangle = Rectangle { top_left: p1, bottom_right: p2 }\n    let shape: Shape = Shape { rect: rect, name: 1 }\n    rm shape\n    rm rect\n    rm p2\n    rm p1\n    return 0\n\n")
    bad = bad + compiles("memory::test_class_as_parameter_cleanup", "\nclass Point:\n    x: int\n    y: int\n\nfn process(p: Point) => int:\n    let result: int = p.x\n    return result\n\nfn main() => int:\n    let p: Point = Point { x: 42, y: 100 }\n    let x_val: int = process(p)\n    rm x_val\n    return 0\n\n")
    bad = bad + compiles("memory::test_class_as_return_value_cleanup", "\nclass Point:\n    x: int\n    y: int\n\nfn create_point(x: int, y: int) => Point:\n    let p: Point = Point { x: x, y: y }\n    rm y\n    rm x\n    return p\n\nfn main() => int:\n    let p: Point = create_point(10, 20)\n    rm p\n    return 0\n\n")
    bad = bad + compiles("memory::test_class_in_function_scope", "\nclass Point:\n    x: int\n    y: int\n\nfn create_and_process() => int:\n    let p: Point = Point { x: 10, y: 20 }\n    let result: int = p.x\n    rm p\n    rm result\n    return 0\n\nfn main() => int:\n    create_and_process()\n    return 0\n\n")
    bad = bad + compiles("memory::test_class_in_if_branch", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let flag: int = 1\n    if flag > 0:\n        let p: Point = Point { x: 10, y: 20 }\n        rm p\n    rm flag\n    return 0\n\n")
    bad = bad + compiles("memory::test_class_in_if_else", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let flag: int = 0\n    if flag > 0:\n        let p1: Point = Point { x: 10, y: 20 }\n        rm p1\n    else:\n        let p2: Point = Point { x: 30, y: 40 }\n        rm p2\n    rm flag\n    return 0\n\n")
    bad = bad + compiles("memory::test_class_in_while_loop", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let i: int = 0\n    while i < 3:\n        let p: Point = Point { x: i, y: i }\n        rm p\n        i = i + 1\n    rm i\n    return 0\n\n")
    bad = bad + compiles("memory::test_class_in_for_loop", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let result: int = 0\n    for i in 0..3:\n        let p: Point = Point { x: i, y: i }\n        let x_val: int = p.x\n        result = result + x_val\n        rm x_val\n        rm p\n    rm result\n    return 0\n\n")
    bad = bad + compiles("memory::test_cleanup_after_method_call", "\nclass Point:\n    x: int\n    y: int\n    \n    fn new(x: int, y: int) => Point:\n        Point { x: x, y: y }\n    \n    fn move(self, dx: int, dy: int) => Point:\n        self.x = self.x + dx\n        self.y = self.y + dy\n        return self\n\nfn main() => int:\n    let p: Point = Point::new(10, 20)\n    p.move(5, 5)\n    rm p\n    return 0\n\n")
    bad = bad + compiles("memory::test_cleanup_after_multiple_method_calls", "\nclass Counter:\n    value: int\n    \n    fn new() => Counter:\n        Counter { value: 0 }\n    \n    fn increment(self) => Counter:\n        self.value = self.value + 1\n        return self\n\nfn main() => int:\n    let c: Counter = Counter::new()\n    c.increment()\n    c.increment()\n    c.increment()\n    rm c\n    return 0\n\n")
    bad = bad + compiles("memory::test_batch_rm", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let p1: Point = Point { x: 0, y: 0 }\n    let p2: Point = Point { x: 10, y: 10 }\n    let p3: Point = Point { x: 20, y: 20 }\n    rm p1, p2, p3\n    return 0\n\n")
    bad = bad + compiles("memory::test_mixed_batch_rm", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let a: int = 10\n    let p1: Point = Point { x: 0, y: 0 }\n    let b: int = 20\n    let p2: Point = Point { x: 10, y: 10 }\n    rm a, p1, b, p2\n    return 0\n\n")
    bad = bad + compiles("memory::test_clean_out", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let p1: Point = Point { x: 0, y: 0 }\n    let p2: Point = Point { x: 10, y: 10 }\n    let a: int = 100\n    rm p1\n    rm p2\n    rm a\n    return 0\n\n")
    bad = bad + compiles("memory::test_clean_out_except", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let p1: Point = Point { x: 0, y: 0 }\n    let p2: Point = Point { x: 10, y: 10 }\n    let a: int = 100\n    rm p2\n    rm a\n    rm p1\n    return 0\n\n")
    bad = bad + compiles("memory::test_clean_out_specific", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let p1: Point = Point { x: 0, y: 0 }\n    let p2: Point = Point { x: 10, y: 10 }\n    let a: int = 100\n    rm p1\n    rm p2\n    rm a\n    return 0\n\n")
    bad = bad + compiles("memory::test_empty_class_cleanup", "\nclass Empty:\n\nfn main() => int:\n    let e: Empty = Empty {}\n    rm e\n    return 0\n\n")
    bad = bad + compiles("memory::test_large_class_cleanup", "\nclass Large:\n    f1: int\n    f2: int\n    f3: int\n    f4: int\n    f5: int\n    f6: int\n    f7: int\n    f8: int\n    f9: int\n    f10: int\n\nfn main() => int:\n    let l: Large = Large {\n        f1: 1, f2: 2, f3: 3, f4: 4, f5: 5,\n        f6: 6, f7: 7, f8: 8, f9: 9, f10: 10\n    }\n    rm l\n    return 0\n\n")
    bad = bad + compiles("memory::test_class_cleanup_with_field_access", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let p: Point = Point { x: 10, y: 20 }\n    let x_val: int = p.x\n    let y_val: int = p.y\n    rm p\n    rm y_val\n    rm x_val\n    return 0\n\n")
    bad = bad + compiles("memory::test_class_cleanup_after_field_modification", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let p: Point = Point { x: 10, y: 20 }\n    p.x = 30\n    p.y = 40\n    rm p\n    return 0\n\n")
    bad = bad + compiles("memory::test_class_cleanup_in_nested_scopes", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let p1: Point = Point { x: 0, y: 0 }\n    let x1: int = p1.x\n    if true:\n        let p2: Point = Point { x: 10, y: 10 }\n        let x2: int = p2.x\n        if true:\n            let p3: Point = Point { x: 20, y: 20 }\n            let x3: int = p3.x\n            rm p3\n            return x3\n        rm p2\n        return x2\n    rm p1\n    return x1\n\n")
    bad = bad + compiles("memory::test_no_leak_in_function", "\nclass Point:\n    x: int\n    y: int\n\nfn create_point() => Point:\n    let p: Point = Point { x: 10, y: 20 }\n    return p\n\nfn main() => int:\n    let p: Point = create_point()\n    rm p\n    return 0\n\n")
    return bad

fn part1() => int:
    let bad = 0
    bad = bad + compiles("memory::test_no_leak_in_loop", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let i: int = 0\n    while i < 5:\n        let p: Point = Point { x: i, y: i }\n        rm p\n        i = i + 1\n    rm i\n    return 0\n\n")
    bad = bad + compiles("memory::test_no_leak_in_error_path", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let p: Point = Point { x: 10, y: 20 }\n    let flag: int = 0\n    if flag > 0:\n        rm p\n        return 1\n    rm p\n    rm flag\n    return 0\n\n")
    bad = bad + rejected("memory::test_rm_in_fallthrough_branch_then_rm_again_is_error", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let p: Point = Point { x: 10, y: 20 }\n    let flag: int = 0\n    if flag > 0:\n        rm p\n    rm p\n    return 0\n\n", 0)
    bad = bad + compiles("memory::test_multiple_variables_cleanup", "\nfn main() => int:\n    let a: int = 1\n    let b: int = 2\n    let c: int = 3\n    let d: int = 4\n    let e: int = 5\n    rm a, b, c, d, e\n    return 0\n\n")
    bad = bad + compiles("memory::test_nested_scope_cleanup", "\nfn main() => int:\n    let a: int = 1\n    if true:\n        let b: int = 2\n        if true:\n            let c: int = 3\n            rm c\n        rm b\n    rm a\n    return 0\n\n")
    bad = bad + compiles("memory::test_loop_variable_cleanup", "\nfn main() => int:\n    let sum: int = 0\n    for i in 0..10:\n        let temp: int = i * 2\n        sum = sum + temp\n        rm temp\n    rm sum\n    return 0\n\n")
    bad = bad + compiles("memory::test_function_parameter_cleanup", "\nfn process(a: int, b: int, c: int) => int:\n    let result: int = a + b + c\n    rm a, b, c\n    return result\n\nfn main() => int:\n    let result: int = process(1, 2, 3)\n    rm result\n    return 0\n\n")
    bad = bad + compiles("memory::test_class_instance_cleanup", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let p1: Point = Point { x: 1, y: 2 }\n    let p2: Point = Point { x: 3, y: 4 }\n    let p3: Point = Point { x: 5, y: 6 }\n    rm p1, p2, p3\n    return 0\n\n")
    bad = bad + compiles("memory::test_tuple_cleanup", "\nfn main() => int:\n    let t1: (int, int) = (1, 2)\n    let t2: (int, int, int) = (1, 2, 3)\n    let t3: ((int, int), int) = ((1, 2), 3)\n    rm t1, t2, t3\n    return 0\n\n")
    bad = bad + compiles("memory::test_array_cleanup", "\nfn main() => int:\n    let arr1: [int; 3] = [1, 2, 3]\n    let arr2: [float; 2] = [1.5, 2.5]\n    rm arr1, arr2\n    return 0\n\n")
    bad = bad + compiles("memory::test_cleanup_with_exceptions", "\nuse fprintf in libc of c\n\nclass MyError of Error:\n    message: str\n\nfn might_fail(x: int) => int:\n    if x < 0:\n        raise MyError { code: -1, message: \"negative value\", note: \"n\", e: 0 }\n    return x\n\nfn main() => int:\n    let result: int = might_fail(10)\n    rm result\n    return 0\n\n")
    return bad

fn main() => int:
    let bad = 0
    bad = bad + part0()
    bad = bad + part1()
    return bad
