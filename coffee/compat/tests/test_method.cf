/#/ Ported from tests/method_tests.rs.
use * in harness

fn part0() => int:
    let bad = 0
    bad = bad + compiles("method::test_simple_method_call", "\nclass Point:\n    x: int\n    y: int\n    \n    fn new(x: int, y: int) => Point:\n        Point { x: x, y: y }\n    \n    fn move(self, dx: int, dy: int) => Point:\n        self.x = self.x + dx\n        self.y = self.y + dy\n        return self\n\nfn main() => int:\n    let p: Point = Point::new(10, 20)\n    p.move(5, 5)\n    rm p\n    return 0\n\n")
    bad = bad + compiles("method::test_method_no_args", "\nclass Counter:\n    value: int\n    \n    fn new() => Counter:\n        Counter { value: 0 }\n    \n    fn increment(self) => Counter:\n        self.value = self.value + 1\n        return self\n\nfn main() => int:\n    let c: Counter = Counter::new()\n    c.increment()\n    rm c\n    return 0\n\n")
    bad = bad + compiles("method::test_method_single_arg", "\nclass Accumulator:\n    total: int\n    \n    fn new() => Accumulator:\n        Accumulator { total: 0 }\n    \n    fn add(self, value: int) => Accumulator:\n        self.total = self.total + value\n        return self\n\nfn main() => int:\n    let acc: Accumulator = Accumulator::new()\n    acc.add(10)\n    rm acc\n    return 0\n\n")
    bad = bad + compiles("method::test_method_multiple_args", "\nclass Rectangle:\n    x: int\n    y: int\n    width: int\n    height: int\n    \n    fn new(x: int, y: int, w: int, h: int) => Rectangle:\n        Rectangle { x: x, y: y, width: w, height: h }\n    \n    fn resize(self, w: int, h: int) => Rectangle:\n        self.width = w\n        self.height = h\n        return self\n\nfn main() => int:\n    let r: Rectangle = Rectangle::new(0, 0, 100, 50)\n    r.resize(200, 100)\n    rm r\n    return 0\n\n")
    bad = bad + compiles("method::test_chained_method_calls", "\nclass Counter:\n    value: int\n    \n    fn new() => Counter:\n        Counter { value: 0 }\n    \n    fn increment(self) => Counter:\n        self.value = self.value + 1\n        return self\n    \n    fn add(self, n: int) => Counter:\n        self.value = self.value + n\n        return self\n\nfn main() => int:\n    let c: Counter = Counter::new()\n    c.increment()\n    c.increment()\n    c.add(10)\n    rm c\n    return 0\n\n")
    bad = bad + compiles("method::test_multiple_methods_on_same_object", "\nclass Point:\n    x: int\n    y: int\n    \n    fn move_x(self, dx: int) => Point:\n        self.x = self.x + dx\n        return self\n    \n    fn move_y(self, dy: int) => Point:\n        self.y = self.y + dy\n        return self\n\nfn main() => int:\n    let p: Point = Point { x: 0, y: 0 }\n    p.move_x(3)\n    p.move_y(7)\n    rm p\n    return 0\n\n")
    bad = bad + compiles("method::test_method_with_computation", "\nclass Calculator:\n    result: int\n    \n    fn new() => Calculator:\n        Calculator { result: 0 }\n    \n    fn multiply(self, a: int, b: int) => Calculator:\n        self.result = a * b\n        return self\n\nfn main() => int:\n    let calc: Calculator = Calculator::new()\n    calc.multiply(5, 6)\n    rm calc\n    return 0\n\n")
    bad = bad + compiles("method::test_method_with_condition", "\nclass State:\n    active: int\n    \n    fn new() => State:\n        State { active: 0 }\n    \n    fn set_active(self, flag: int) => State:\n        if flag > 0:\n            self.active = 1\n        else:\n            self.active = 0\n        return self\n\nfn main() => int:\n    let s: State = State::new()\n    s.set_active(1)\n    rm s\n    return 0\n\n")
    bad = bad + compiles("method::test_method_with_loop", "\nclass Counter:\n    value: int\n    \n    fn new() => Counter:\n        Counter { value: 0 }\n    \n    fn add_multiple(self, n: int, times: int) => Counter:\n        let i: int = 0\n        while i < times:\n            self.value = self.value + n\n            i = i + 1\n        rm i\n        return self\n\nfn main() => int:\n    let c: Counter = Counter::new()\n    c.add_multiple(5, 3)\n    rm c\n    return 0\n\n")
    bad = bad + compiles("method::test_method_with_local_vars", "\nclass Point:\n    x: int\n    y: int\n    \n    fn new(x: int, y: int) => Point:\n        Point { x: x, y: y }\n    \n    fn translate(self, dx: int, dy: int) => Point:\n        let new_x: int = self.x + dx\n        let new_y: int = self.y + dy\n        self.x = new_x\n        self.y = new_y\n        rm new_y\n        rm new_x\n        return self\n\nfn main() => int:\n    let p: Point = Point::new(10, 20)\n    p.translate(5, 10)\n    rm p\n    return 0\n\n")
    bad = bad + compiles("method::test_multiple_objects_methods", "\nclass Counter:\n    value: int\n    \n    fn new() => Counter:\n        Counter { value: 0 }\n    \n    fn increment(self) => Counter:\n        self.value = self.value + 1\n        return self\n\nfn main() => int:\n    let c1: Counter = Counter::new()\n    let c2: Counter = Counter::new()\n    let c3: Counter = Counter::new()\n    c1.increment()\n    c2.increment()\n    c2.increment()\n    c3.increment()\n    c3.increment()\n    c3.increment()\n    rm c3\n    rm c2\n    rm c1\n    return 0\n\n")
    bad = bad + compiles("method::test_method_in_loop", "\nclass Counter:\n    value: int\n    \n    fn new() => Counter:\n        Counter { value: 0 }\n    \n    fn increment(self) => Counter:\n        self.value = self.value + 1\n        return self\n\nfn main() => int:\n    let c: Counter = Counter::new()\n    let i: int = 0\n    while i < 5:\n        c.increment()\n        i = i + 1\n    rm i\n    rm c\n    return 0\n\n")
    bad = bad + compiles("method::test_method_in_if_statement", "\nclass Counter:\n    value: int\n    \n    fn new() => Counter:\n        Counter { value: 0 }\n    \n    fn increment(self) => Counter:\n        self.value = self.value + 1\n        return self\n\nfn main() => int:\n    let c: Counter = Counter::new()\n    let flag: int = 1\n    if flag > 0:\n        c.increment()\n        c.increment()\n    rm flag\n    rm c\n    return 0\n\n")
    bad = bad + compiles("method::test_method_read_field", "\nclass Point:\n    x: int\n    y: int\n    \n    fn new(x: int, y: int) => Point:\n        Point { x: x, y: y }\n    \n    fn get_x(self) => int:\n        let result: int = self.x\n        return result\n\nfn main() => int:\n    let p: Point = Point::new(42, 100)\n    let x_val: int = p.get_x()\n    rm x_val\n    rm p\n    return 0\n\n")
    bad = bad + compiles("method::test_method_write_field", "\nclass Point:\n    x: int\n    y: int\n    \n    fn new(x: int, y: int) => Point:\n        Point { x: x, y: y }\n    \n    fn set_x(self, value: int) => Point:\n        self.x = value\n        return self\n\nfn main() => int:\n    let p: Point = Point::new(10, 20)\n    p.set_x(100)\n    rm p\n    return 0\n\n")
    bad = bad + compiles("method::test_method_modify_field", "\nclass Counter:\n    value: int\n    \n    fn new() => Counter:\n        Counter { value: 0 }\n    \n    fn double(self) => Counter:\n        self.value = self.value * 2\n        return self\n\nfn main() => int:\n    let c: Counter = Counter::new()\n    c.double()\n    c.double()\n    rm c\n    return 0\n\n")
    bad = bad + compiles("method::test_method_return_int", "\nclass Counter:\n    value: int\n    \n    fn new() => Counter:\n        Counter { value: 0 }\n    \n    fn get_value(self) => int:\n        let result: int = self.value\n        return result\n\nfn main() => int:\n    let c: Counter = Counter::new()\n    let val: int = c.get_value()\n    rm val\n    rm c\n    return 0\n\n")
    bad = bad + compiles("method::test_method_return_bool", "\nclass State:\n    active: int\n    \n    fn new() => State:\n        State { active: 0 }\n    \n    fn is_active(self) => int:\n        if self.active > 0:\n            return 1\n        else:\n            return 0\n\nfn main() => int:\n    let s: State = State::new()\n    let active: int = s.is_active()\n    rm active\n    rm s\n    return 0\n\n")
    bad = bad + compiles("method::test_multiple_methods", "\nclass Point:\n    x: int\n    y: int\n    \n    fn new(x: int, y: int) => Point:\n        Point { x: x, y: y }\n    \n    fn move_x(self, dx: int) => Point:\n        self.x = self.x + dx\n        return self\n    \n    fn move_y(self, dy: int) => Point:\n        self.y = self.y + dy\n        return self\n    \n    fn reset(self) => Point:\n        self.x = 0\n        self.y = 0\n        return self\n\nfn main() => int:\n    let p: Point = Point::new(10, 20)\n    p.move_x(5)\n    p.move_y(10)\n    p.reset()\n    rm p\n    return 0\n\n")
    bad = bad + compiles("method::test_method_interactions", "\nclass Counter:\n    value: int\n    \n    fn new() => Counter:\n        Counter { value: 0 }\n    \n    fn increment(self) => Counter:\n        self.value = self.value + 1\n        return self\n    \n    fn get_value(self) => int:\n        let result: int = self.value\n        return result\n    \n    fn reset(self) => Counter:\n        self.value = 0\n        return self\n\nfn main() => int:\n    let c: Counter = Counter::new()\n    c.increment()\n    c.increment()\n    let val: int = c.get_value()\n    c.reset()\n    rm val\n    rm c\n    return 0\n\n")
    bad = bad + compiles("method::test_method_with_zero_args", "\nclass Flag:\n    value: int\n    \n    fn new() => Flag:\n        Flag { value: 0 }\n    \n    fn toggle(self) => Flag:\n        if self.value == 0:\n            self.value = 1\n        else:\n            self.value = 0\n        return self\n\nfn main() => int:\n    let f: Flag = Flag::new()\n    f.toggle()\n    rm f\n    return 0\n\n")
    bad = bad + compiles("method::test_method_with_many_args", "\nclass Config:\n    a: int\n    b: int\n    c: int\n    d: int\n    e: int\n    \n    fn new() => Config:\n        Config { a: 0, b: 0, c: 0, d: 0, e: 0 }\n    \n    fn set_all(self, a: int, b: int, c: int, d: int, e: int) => Config:\n        self.a = a\n        self.b = b\n        self.c = c\n        self.d = d\n        self.e = e\n        return self\n\nfn main() => int:\n    let cfg: Config = Config::new()\n    cfg.set_all(1, 2, 3, 4, 5)\n    rm cfg\n    return 0\n\n")
    bad = bad + compiles("method::test_method_call_after_field_access", "\nclass Point:\n    x: int\n    y: int\n    \n    fn new(x: int, y: int) => Point:\n        Point { x: x, y: y }\n    \n    fn move(self, dx: int, dy: int) => Point:\n        self.x = self.x + dx\n        self.y = self.y + dy\n        return self\n\nfn main() => int:\n    let p: Point = Point::new(10, 20)\n    let x_val: int = p.x\n    let y_val: int = p.y\n    p.move(5, 5)\n    rm y_val\n    rm x_val\n    rm p\n    return 0\n\n")
    bad = bad + compiles("method::test_grandchild_calls_grandparent_method", "\nclass A:\n    x: int\n\n    fn foo(self) => int:\n        return self.x\n\nclass B of A:\n    y: int\n\nclass C of B:\n    z: int\n\nfn main() => int:\n    let c: C = C { x: 7, y: 8, z: 9 }\n    let n: int = c.foo()\n    rm c\n    return n\n")
    return bad

fn main() => int:
    let bad = 0
    bad = bad + part0()
    return bad
