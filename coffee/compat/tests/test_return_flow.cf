/#/ Ported from tests/return_flow_tests.rs.
use * in harness

fn part0() => int:
    let bad = 0
    bad = bad + rejected("return_flow::test_missing_return_is_error", "\nfn f(x: int) => int:\n    let y: int = x + 1\n\nfn main() => int:\n    return f(1)\n", 0)
    bad = bad + rejected("return_flow::test_missing_return_on_one_branch_is_error", "\nfn f(x: int) => int:\n    if x > 0:\n        return 1\n\nfn main() => int:\n    return f(1)\n", 0)
    bad = bad + exits("return_flow::test_return_on_every_branch_is_ok", "\nfn f(x: int) => int:\n    if x > 0:\n        return 3\n    elif x < 0:\n        return 4\n    else:\n        return 5\n\nfn main() => int:\n    return f(1)\n", 3)
    bad = bad + exits("return_flow::test_void_function_needs_no_return", "\nfn f() => void:\n    let y: int = 1\n    return\n\nfn g() => void:\n    let z: int = 2\n\nfn main() => int:\n    g()\n    return 7\n", 7)
    bad = bad + exits("return_flow::test_raise_ends_a_path", "\nuse fprintf, exit in libc of c\n\nfn f(x: int) => int:\n    if x > 0:\n        return 6\n    raise Error(\"bad\")\n\nfn main() => int:\n    return f(1)\n", 6)
    bad = bad + exits("return_flow::test_tail_match_int_returns_arm_value", "\nfn f(x: int) => int:\n    match x:\n        0 => 10\n        _ => 20\n\nfn main() => int:\n    return f(0) + f(5)\n", 30)
    bad = bad + exits("return_flow::test_tail_match_selects_the_right_arm", "\nfn f(x: int) => int:\n    match x:\n        0 => 10\n        _ => 20\n\nfn main() => int:\n    return f(5)\n", 20)
    bad = bad + exits("return_flow::test_tail_match_enum_unit_variants", "\nenum Color:\n    Red\n    Green\n    Blue\n\nfn name(c: Color) => int:\n    match c:\n        Color.Red => 1\n        Color.Green => 2\n        Color.Blue => 3\n\nfn main() => int:\n    return name(Color.Green)\n", 2)
    bad = bad + rejected("return_flow::test_tail_match_wrong_arm_type_is_error", "\nfn f(x: int) => int:\n    match x:\n        0 => \"zero\"\n        _ => 1\n\nfn main() => int:\n    return f(0)\n", 0)
    bad = bad + rejected("return_flow::test_method_missing_return_is_error", "\nclass A:\n    v: int\n\n    fn get(self) => int:\n        let y: int = self.v\n\nfn main() => int:\n    let a: A = A { v: 1 }\n    return a.get()\n", 0)
    bad = bad + exits("return_flow::test_method_tail_match_returns_arm_value", "\nclass A:\n    v: int\n\n    fn pick(self) => int:\n        match self.v:\n            1 => 40\n            _ => 50\n\nfn main() => int:\n    let a: A = A { v: 1 }\n    return a.pick()\n", 40)
    bad = bad + exits("return_flow::test_method_trailing_expression_still_returns", "\nclass A:\n    v: int\n\n    fn plus(self, n: int) => int:\n        self.v + n\n\nfn main() => int:\n    let a: A = A { v: 1 }\n    return a.plus(4)\n", 5)
    return bad

fn main() => int:
    let bad = 0
    bad = bad + part0()
    return bad
