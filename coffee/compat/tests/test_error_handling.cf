/#/ Ported from tests/error_handling_tests.rs.
use * in harness

fn part0() => int:
    let bad = 0
    bad = bad + compiles("error_handling::test_simple_raise", "\nuse fprintf, exit in libc of c\n\nclass TestError of Error:\n    message: str\n\nfn main() => int:\n    raise TestError(\"An error occurred\")\n\n")
    bad = bad + compiles("error_handling::test_raise_with_string_literal", "\nuse fprintf, exit in libc of c\n\nclass TestError of Error:\n\nfn main() => int:\n    raise TestError(404)\n\n")
    bad = bad + compiles("error_handling::test_raise_with_expression", "\nuse fprintf, exit in libc of c\n\nclass TestError of Error:\n    value: int\n\nfn main() => int:\n    let x: int = 42\n    raise TestError(x)\n\n")
    bad = bad + compiles("error_handling::test_raise_in_function", "\nuse fprintf, exit in libc of c\n\nclass TestError of Error:\n    message: str\n\nfn risky_operation() => int:\n    raise TestError(\"Something went wrong\")\n\nfn main() => int:\n    return risky_operation()\n\n")
    bad = bad + compiles("error_handling::test_raise_in_conditional", "\nuse fprintf, exit in libc of c\n\nclass TestError of Error:\n    message: str\n\nfn main() => int:\n    let flag: bool = true\n    if flag:\n        raise TestError(\"Flag is true\")\n    return 0\n\n")
    bad = bad + compiles("error_handling::test_raise_in_loop", "\nuse fprintf, exit in libc of c\n\nclass TestError of Error:\n    message: str\n\nfn main() => int:\n    let i: int = 0\n    while i < 10:\n        if i == 5:\n            raise TestError(\"Found 5\")\n        i = i + 1\n    return 0\n\n")
    bad = bad + compiles("error_handling::test_error_class_with_single_field", "\nuse fprintf, exit in libc of c\n\nclass TestError of Error:\n\nfn main() => int:\n    raise TestError(500)\n\n")
    bad = bad + compiles("error_handling::test_error_class_with_multiple_fields", "\nuse fprintf, exit in libc of c\n\nclass TestError of Error:\n    message: str\n    details: str\n\nfn main() => int:\n    raise TestError(404, \"Not Found\", \"Resource unavailable\")\n\n")
    bad = bad + compiles("error_handling::test_error_class_with_nested_struct", "\nuse fprintf, exit in libc of c\n\nclass Location:\n    file: str\n    line: int\n\nclass TestError of Error:\n    message: str\n    location: Location\n\nfn main() => int:\n    let loc: Location = Location { file: \"test.cf\", line: 10 }\n    raise TestError(\"Error occurred\", loc)\n\n")
    bad = bad + compiles("error_handling::test_multiple_error_types", "\nuse fprintf, exit in libc of c\n\nclass NetworkError of Error:\n    message: str\n\nclass FileError:\n    path: str\n    reason: str\n\nfn main() => int:\n    raise NetworkError(500, \"Server error\")\n\n")
    bad = bad + compiles("error_handling::test_error_handler_function", "\nclass TestError of Error:\n    message: str\n\nfn on_err(err: Error) => int:\n    return -1\n\nfn risky_operation() #on_err => int:\n    raise TestError(\"Something went wrong\")\n\nfn main() => int:\n    return risky_operation()\n\n")
    bad = bad + compiles("error_handling::test_error_handler_with_parameters", "\nclass TestError of Error:\n\nfn on_err(err: Error) => int:\n    return -1\n\nfn divide(a: int, b: int) #on_err => int:\n    if b == 0:\n        raise TestError(400)\n    return a // b\n\nfn main() => int:\n    let result: int = divide(10, 2)\n    rm result\n    return 0\n\n")
    bad = bad + compiles("error_handling::test_error_handler_in_recursive_function", "\nclass TestError of Error:\n    message: str\n\nfn on_err(err: Error) => int:\n    return -1\n\nfn factorial(n: int) #on_err => int:\n    if n < 0:\n        raise TestError(\"Negative factorial\")\n    if n <= 1:\n        return 1\n    return n * factorial(n - 1)\n\nfn main() => int:\n    let result: int = factorial(5)\n    rm result\n    return 0\n\n")
    bad = bad + compiles("error_handling::test_listener_raise_in_handler_still_needs_fprintf", "\nuse fprintf, exit in libc of c\n\nclass TestError of Error:\n    message: str\n\nfn on_err(err: Error) => int:\n    raise TestError(\"from listener\")\n\nfn risky_operation() #on_err => int:\n    raise TestError(\"in marked function\")\n\nfn main() => int:\n    return risky_operation()\n\n")
    bad = bad + compiles("error_handling::test_raise_with_computation", "\nuse fprintf, exit in libc of c\n\nclass TestError of Error:\n    value: int\n\nfn main() => int:\n    let a: int = 10\n    let b: int = 20\n    raise TestError(a + b)\n\n")
    bad = bad + compiles("error_handling::test_raise_in_nested_function", "\nuse fprintf, exit in libc of c\n\nclass TestError of Error:\n    message: str\n\nfn inner_function() => int:\n    raise TestError(\"Inner error\")\n\nfn outer_function() => int:\n    return inner_function()\n\nfn main() => int:\n    return outer_function()\n\n")
    bad = bad + compiles("error_handling::test_multiple_raises_in_function", "\nuse fprintf, exit in libc of c\n\nclass TestError of Error:\n    message: str\n\nfn check_value(x: int) => int:\n    if x < 0:\n        raise TestError(\"Negative value\")\n    return x\n\nfn main() => int:\n    return check_value(50)\n\n")
    bad = bad + compiles("error_handling::test_raise_with_class_instance", "\nuse fprintf, exit in libc of c\n\nclass Point:\n    x: int\n    y: int\n\nclass TestError of Error:\n    location: Point\n\nfn main() => int:\n    let p: Point = Point { x: 10, y: 20 }\n    raise TestError(p)\n\n")
    bad = bad + compiles("error_handling::test_raise_in_class_method", "\nuse fprintf, exit in libc of c\n\nclass TestError of Error:\n    message: str\n\nclass Container:\n    value: int\n    \n    fn validate(self) => int:\n        if self.value < 0:\n            raise TestError(\"Invalid value\")\n        return 0\n\nfn main() => int:\n    let c: Container = Container { value: 10 }\n    return c.validate()\n\n")
    bad = bad + compiles("error_handling::test_raise_empty_class", "\nuse fprintf, exit in libc of c\n\nclass TestError of Error:\n\nfn main() => int:\n    raise TestError()\n\n")
    bad = bad + compiles("error_handling::test_raise_with_large_fields", "\nuse fprintf, exit in libc of c\n\nclass TestError of Error:\n    field1: int\n    field2: int\n    field3: int\n    field4: int\n    field5: int\n\nfn main() => int:\n    raise TestError(1, 2, 3, 4, 5)\n\n")
    bad = bad + compiles("error_handling::test_raise_in_constructor", "\nuse fprintf, exit in libc of c\n\nclass TestError of Error:\n    message: str\n\nclass Container:\n    value: int\n    \n    fn new(v: int) => Container:\n        Container { value: v }\n\nfn main() => int:\n    let c: Container = Container::new(10)\n    rm c\n    return 0\n\n")
    bad = bad + compiles("error_handling::test_raise_after_operations", "\nuse fprintf, exit in libc of c\n\nclass TestError of Error:\n    message: str\n\nfn main() => int:\n    let a: int = 10\n    let b: int = 20\n    let c: int = a + b\n    raise TestError(\"Error after computation\")\n\n")
    bad = bad + compiles("error_handling::test_raise_with_string_field", "\nuse fprintf, exit in libc of c\n\nclass TestError of Error:\n    message: str\n\nfn main() => int:\n    raise TestError(\"This is a long error message with details\")\n\n")
    bad = bad + compiles("error_handling::test_raise_in_multiple_functions", "\nuse fprintf, exit in libc of c\n\nclass TestError of Error:\n    message: str\n\nfn function1() => int:\n    raise TestError(\"Error in function1\")\n\nfn function2() => int:\n    raise TestError(\"Error in function2\")\n\nfn main() => int:\n    return function1()\n\n")
    return bad

fn part1() => int:
    let bad = 0
    bad = bad + compiles("error_handling::test_raise_with_error_code", "\nuse fprintf, exit in libc of c\n\nclass TestError of Error:\n    message: str\n\nfn main() => int:\n    raise TestError(404, \"Not Found\")\n\n")
    bad = bad + compiles("error_handling::test_raise_in_loop_with_break", "\nuse fprintf, exit in libc of c\n\nclass TestError of Error:\n    message: str\n\nfn main() => int:\n    let i: int = 0\n    while i < 10:\n        if i == 5:\n            raise TestError(\"Found 5\")\n        i = i + 1\n    return 0\n\n")
    bad = bad + compiles("error_handling::test_raise_in_nested_conditionals", "\nuse fprintf, exit in libc of c\n\nclass TestError of Error:\n    message: str\n\nfn main() => int:\n    let a: int = 10\n    let b: int = 20\n    if a > 5:\n        if b > 15:\n            raise TestError(\"Both conditions true\")\n    return 0\n\n")
    bad = bad + compiles("error_handling::test_multiple_error_types_validation", "\nuse fprintf, exit in libc of c\n\nclass ValueError of Error:\n    message: str\n\nclass TypeError of Error:\n    message: str\n\nfn main() => int:\n    let x: int = 5\n    if x < 0:\n        raise ValueError(\"Negative value\")\n    elif x > 10:\n        raise TypeError(\"Value too large\")\n    return 0\n\n")
    bad = bad + compiles("error_handling::test_error_with_fields", "\nuse fprintf, exit in libc of c\n\nclass CustomError of Error:\n    message: str\n    details: str\n\nfn main() => int:\n    raise CustomError {\n        code: 404,\n        note: \"n\",\n        e: 0,\n        message: \"Not found\",\n        details: \"Resource does not exist\"\n    }\n\n")
    bad = bad + compiles("error_handling::test_raise_in_function_with_validation", "\nuse fprintf, exit in libc of c\n\nclass ValidationError of Error:\n    field: str\n    message: str\n\nfn validate_age(age: int) => int:\n    if age < 0:\n        raise ValidationError { field: \"age\", message: \"Age cannot be negative\", code: 1, note: \"n\", e: 0 }\n    if age > 150:\n        raise ValidationError { field: \"age\", message: \"Age cannot exceed 150\", code: 1, note: \"n\", e: 0 }\n    return age\n\nfn main() => int:\n    let age: int = validate_age(25)\n    rm age\n    return 0\n\n")
    bad = bad + compiles("error_handling::test_error_in_loop", "\nuse fprintf, exit in libc of c\n\nclass ProcessError of Error:\n    step: int\n    message: str\n\nfn main() => int:\n    let i: int = 0\n    while i < 10:\n        if i == 7:\n            raise ProcessError { step: i, message: \"Failed at step 7\", code: 1, note: \"n\", e: 0 }\n        i = i + 1\n    return 0\n\n")
    bad = bad + compiles("error_handling::test_nested_error_handling", "\nuse fprintf, exit in libc of c\n\nclass InnerError:\n    message: str\n\nclass OuterError of Error:\n    message: str\n    inner: InnerError\n\nfn main() => int:\n    let inner: InnerError = InnerError { message: \"Inner failure\" }\n    raise OuterError {\n        message: \"Outer failure\",\n        inner: inner,\n        code: 1,\n        note: \"n\",\n        e: 0\n    }\n\n")
    bad = bad + compiles("error_handling::test_error_recovery", "\nuse fprintf, exit in libc of c\n\nclass RecoverableError:\n    message: str\n    can_retry: bool\n\nfn main() => int:\n    let error: RecoverableError = RecoverableError {\n        message: \"Temporary failure\",\n        can_retry: true\n    }\n    rm error\n    return 0\n\n")
    bad = bad + compiles("error_handling::test_error_with_complex_fields", "\nuse fprintf, exit in libc of c\n\nclass Point:\n    x: int\n    y: int\n\nclass LocationError of Error:\n    point: Point\n    message: str\n    timestamp: int\n\nfn main() => int:\n    let p: Point = Point { x: 100, y: 200 }\n    raise LocationError {\n        point: p,\n        message: \"Invalid location\",\n        timestamp: 1234567890,\n        code: 1,\n        note: \"n\",\n        e: 0\n    }\n\n")
    bad = bad + compiles("error_handling::test_error_subclass_extra_field_and_method", "\nuse fprintf, exit in libc of c\n\nclass AppError of Error:\n    kind: int\n\n    fn kind_code(self) => int:\n        return self.kind\n\nfn main() => int:\n    let err: AppError = AppError { kind: 7, code: 1, note: \"n\", e: 0 }\n    let k: int = err.kind\n    let c: int = err.kind_code()\n    rm err\n    raise AppError { kind: k, code: c, note: \"n\", e: 0 }\n\n")
    bad = bad + compiles("error_handling::test_listen_app_error_extra_field_struct_literal", "\nclass AppError of Error:\n    kind: int\n\nfn on_err(err: Error) => int:\n    return -1\n\nfn risky() #on_err => int:\n    raise AppError { kind: 7, code: 1, note: \"n\", e: 0 }\n\nfn main() => int:\n    return risky()\n\n")
    return bad

fn main() => int:
    let bad = 0
    bad = bad + part0()
    bad = bad + part1()
    return bad
