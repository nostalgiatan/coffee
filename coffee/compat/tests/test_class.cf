/#/ Ported from tests/class_tests.rs.
use * in harness

fn part0() => int:
    let bad = 0
    bad = bad + compiles("class::test_simple_class_declaration", "\nclass Point:\n    x: int\n    y: int\n\n")
    bad = bad + compiles("class::test_empty_class", "\nclass Empty:\n\n")
    bad = bad + compiles("class::test_class_with_single_field", "\nclass Counter:\n    count: int\n\n")
    bad = bad + compiles("class::test_class_with_multiple_fields", "\nclass Person:\n    name: string\n    age: int\n    height: float\n\n")
    bad = bad + compiles("class::test_class_with_different_type_fields", "\nclass Mixed:\n    a: int\n    b: float\n    c: string\n    d: bool\n\n")
    bad = bad + compiles("class::test_struct_literal_basic", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let p: Point = Point { x: 10, y: 20 }\n    rm p\n    return 0\n\n")
    bad = bad + compiles("class::test_struct_literal_with_expressions", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let a: int = 5\n    let b: int = 10\n    let p: Point = Point { x: a + 3, y: b * 2 }\n    printf(\"Point: %d, %d\\n\", p.x, p.y)\n    rm p, a, b\n    return 0\n\n")
    bad = bad + compiles("class::test_struct_literal_nested", "\nclass Point:\n    x: int\n    y: int\n\nclass Rectangle:\n    top_left: Point\n    bottom_right: Point\n\nfn main() => int:\n    let r: Rectangle = Rectangle {\n        top_left: Point { x: 0, y: 10 },\n        bottom_right: Point { x: 20, y: 0 }\n    }\n    rm r\n    return 0\n\n")
    bad = bad + compiles("class::test_field_access", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let p: Point = Point { x: 10, y: 20 }\n    let x_val: int = p.x\n    let y_val: int = p.y\n    printf(\"Point: %d, %d\\n\", x_val, y_val)\n    rm p, x_val, y_val\n    return 0\n\n")
    bad = bad + compiles("class::test_nested_field_access", "\nclass Point:\n    x: int\n    y: int\n\nclass Rectangle:\n    top_left: Point\n    bottom_right: Point\n\nfn main() => int:\n    let r: Rectangle = Rectangle {\n        top_left: Point { x: 0, y: 10 },\n        bottom_right: Point { x: 20, y: 0 }\n    }\n    let x: int = r.top_left.x\n    let y: int = r.bottom_right.y\n    printf(\"Rectangle: %d, %d\\n\", x, y)\n    rm r, x, y\n    return 0\n\n")
    bad = bad + compiles("class::test_nested_field_assign", "\nclass Point:\n    x: int\n    y: int\n\nclass Wrapper:\n    p: Point\n\nfn main() => int:\n    let w: Wrapper = Wrapper { p: Point { x: 1, y: 2 } }\n    w.p.x = 42\n    printf(\"%d\\n\", w.p.x)\n    rm w\n    return 0\n\n")
    bad = bad + compiles("class::test_class_as_function_parameter", "\nclass Point:\n    x: int\n    y: int\n\nfn print_point(p: Point) => ():\n    printf(\"Point: %d, %d\\n\", p.x, p.y)\n\nfn main() => int:\n    let p: Point = Point { x: 10, y: 20 }\n    print_point(p)\n    return 0\n\n")
    bad = bad + compiles("class::test_class_as_return_value", "\nclass Point:\n    x: int\n    y: int\n\nfn make_point(x: int, y: int) => Point:\n    return Point { x: x, y: y }\n\nfn main() => int:\n    let p: Point = make_point(10, 20)\n    printf(\"Point: %d, %d\\n\", p.x, p.y)\n    rm p\n    return 0\n\n")
    bad = bad + compiles("class::test_class_reuse", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let p1: Point = Point { x: 10, y: 20 }\n    let p2: Point = Point { x: 30, y: 40 }\n    printf(\"Points: %d,%d and %d,%d\\n\", p1.x, p1.y, p2.x, p2.y)\n    rm p1, p2\n    return 0\n\n")
    bad = bad + compiles("class::test_class_in_if_statement", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let p: Point = Point { x: 10, y: 20 }\n    if p.x > 5:\n        printf(\"x is greater than 5\\n\")\n    rm p\n    return 0\n\n")
    bad = bad + compiles("class::test_class_in_loop", "\nclass Counter:\n    count: int\n\nfn main() => int:\n    let c: Counter = Counter { count: 0 }\n    let i: int = 0\n    while i < 5:\n        printf(\"Count: %d\\n\", c.count)\n        i = i + 1\n    printf(\"Final count: %d\\n\", c.count)\n    rm c, i\n    return 0\n\n")
    bad = bad + compiles("class::test_class_in_expression", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let p1: Point = Point { x: 10, y: 20 }\n    let p2: Point = Point { x: 5, y: 5 }\n    let sum: int = p1.x + p2.x\n    printf(\"Sum: %d\\n\", sum)\n    rm p1, p2, sum\n    return 0\n\n")
    bad = bad + compiles("class::test_multiple_classes", "\nclass Point:\n    x: int\n    y: int\n\nclass Rectangle:\n    top_left: Point\n    bottom_right: Point\n\nclass Circle:\n    center: Point\n    radius: int\n\nfn main() => int:\n    let p: Point = Point { x: 10, y: 20 }\n    let r: Rectangle = Rectangle {\n        top_left: Point { x: 0, y: 10 },\n        bottom_right: Point { x: 20, y: 0 }\n    }\n    let c: Circle = Circle {\n        center: Point { x: 5, y: 5 },\n        radius: 10\n    }\n    printf(\"Point: %d,%d\\n\", p.x, p.y)\n    printf(\"Circle radius: %d\\n\", c.radius)\n    rm p, r, c\n    return 0\n\n")
    bad = bad + compiles("class::test_nested_class_definition", "\nclass Outer:\n    value: int\n\nclass Inner:\n    data: int\n\nfn main() => int:\n    let o: Outer = Outer { value: 42 }\n    let i: Inner = Inner { data: 123 }\n    printf(\"Outer: %d, Inner: %d\\n\", o.value, i.data)\n    rm o, i\n    return 0\n\n")
    bad = bad + compiles("class::test_class_defined_inside_function_compiles", "\nfn main() => int:\n    class Point:\n        x: int\n        y: int\n    let p: Point = Point { x: 1, y: 2 }\n    printf(\"Point: %d,%d\\n\", p.x, p.y)\n    rm p\n    return 0\n\n")
    bad = bad + compiles("class::test_large_class", "\nclass Large:\n    f1: int\n    f2: int\n    f3: int\n    f4: int\n    f5: int\n    f6: int\n    f7: int\n    f8: int\n    f9: int\n    f10: int\n\nfn main() => int:\n    let l: Large = Large {\n        f1: 1, f2: 2, f3: 3, f4: 4, f5: 5,\n        f6: 6, f7: 7, f8: 8, f9: 9, f10: 10\n    }\n    rm l\n    return 0\n\n")
    bad = bad + compiles("class::test_class_with_nested_class", "\nclass Point:\n    x: int\n    y: int\n\nclass Rectangle:\n    top_left: Point\n    bottom_right: Point\n\nfn main() => int:\n    let p1: Point = Point { x: 0, y: 10 }\n    let p2: Point = Point { x: 10, y: 0 }\n    let r: Rectangle = Rectangle {\n        top_left: p1,\n        bottom_right: p2\n    }\n    rm p1, p2, r\n    return 0\n\n")
    bad = bad + compiles("class::test_class_with_array_field", "\nclass Matrix:\n    data: [int; 9]\n    rows: int\n    cols: int\n\nfn main() => int:\n    let m: Matrix = Matrix {\n        data: [1, 2, 3, 4, 5, 6, 7, 8, 9],\n        rows: 3,\n        cols: 3\n    }\n    rm m\n    return 0\n\n")
    bad = bad + compiles("class::test_class_with_tuple_field", "\nclass Pair:\n    values: (int, int)\n    sum: int\n\nfn main() => int:\n    let p: Pair = Pair {\n        values: (10, 20),\n        sum: 30\n    }\n    rm p\n    return 0\n\n")
    bad = bad + compiles("class::test_class_with_mixed_types", "\nclass Mixed:\n    id: int\n    name: str\n    active: bool\n    score: float\n    tags: [int; 3]\n\nfn main() => int:\n    let m: Mixed = Mixed {\n        id: 1,\n        name: \"test\",\n        active: true,\n        score: 95.5,\n        tags: [1, 2, 3]\n    }\n    rm m\n    return 0\n\n")
    return bad

fn part1() => int:
    let bad = 0
    bad = bad + compiles("class::test_class_assignment", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let p1: Point = Point { x: 10, y: 20 }\n    let p2: Point = clone p1\n    p2.x = 30\n    rm p1, p2\n    return 0\n\n")
    bad = bad + compiles("class::test_class_field_access", "\nclass Person:\n    name: str\n    age: int\n\nfn main() => int:\n    let p: Person = Person {\n        name: \"Alice\",\n        age: 30\n    }\n    let name: str = clone p.name\n    let age: int = p.age\n    rm p, name, age\n    return 0\n\n")
    bad = bad + compiles("class::test_class_in_array", "\nclass Point:\n    x: int\n    y: int\n\nfn main() => int:\n    let p1: Point = Point { x: 1, y: 2 }\n    let p2: Point = Point { x: 3, y: 4 }\n    let p3: Point = Point { x: 5, y: 6 }\n    let points: [Point; 3] = [p1, p2, p3]\n    rm p1, p2, p3, points\n    return 0\n\n")
    return bad

fn main() => int:
    let bad = 0
    bad = bad + part0()
    bad = bad + part1()
    return bad
