/#/ Ported from tests/mutation_frontend_tests.rs.
use * in harness

fn part0() => int:
    let bad = 0
    bad = bad + rejected("mutation_frontend::mutate_int_let_float_literal_is_e100", "\nfn main() => int:\n    let x: int = 1.0\n    return 0\n\n", 100)
    bad = bad + rejected("mutation_frontend::mutate_int_let_string_literal_is_e100", "\nfn main() => int:\n    let x: int = \"nope\"\n    return 0\n\n", 100)
    bad = bad + rejected("mutation_frontend::mutate_int_assign_float_is_e100", "\nfn main() => int:\n    let x: int = 1\n    x = 2.5\n    return 0\n\n", 100)
    bad = bad + rejected("mutation_frontend::mutate_return_true_in_int_fn_is_e100", "\nfn main() => int:\n    return true\n\n", 100)
    bad = bad + rejected("mutation_frontend::mutate_unary_not_on_int_is_e104", "\nfn main() => int:\n    if !0:\n        return 1\n    return 0\n\n", 104)
    bad = bad + rejected("mutation_frontend::mutate_unary_neg_on_false_is_e104", "\nfn main() => int:\n    let x: int = -false\n    return 0\n\n", 104)
    bad = bad + rejected("mutation_frontend::mutate_undefined_ident_ghost_is_e200", "\nfn main() => int:\n    let x: int = ghost\n    return 0\n\n", 200)
    bad = bad + rejected("mutation_frontend::mutate_undefined_in_return_is_e200", "\nfn main() => int:\n    return nowhere\n\n", 200)
    bad = bad + rejected("mutation_frontend::mutate_unknown_type_annotation_is_e101", "\nfn main() => int:\n    let x: NoSuchType = 1\n    return 0\n\n", 101)
    bad = bad + rejected("mutation_frontend::mutate_call_arity_is_e103", "\nfn id(n: int) => int:\n    return n\n\nfn main() => int:\n    return id(1, 2)\n\n", 103)
    bad = bad + rejected("mutation_frontend::mutate_missing_class_field_is_e106", "\nclass Box:\n    n: int\n\nfn main() => int:\n    let b: Box = Box { n: 1 }\n    let x: int = b.nope\n    return 0\n\n", 106)
    bad = bad + rejected("mutation_frontend::mutate_continue_outside_loop_is_e111", "\nfn main() => int:\n    continue\n    return 0\n\n", 111)
    bad = bad + rejected("mutation_frontend::mutate_duplicate_let_is_e201", "\nfn main() => int:\n    let x: int = 1\n    let x: int = 2\n    return 0\n\n", 201)
    bad = bad + rejected("mutation_frontend::mutate_extra_main_is_e001", "\nfn main() => int:\n    return 0\n\nfn main() => int:\n    return 1\n\n", 1)
    bad = bad + rejected("mutation_frontend::mutate_python_def_colon_is_e002", "\ndef foo():\n    return 0\n\nfn main() => int:\n    return 0\n\n", 2)
    bad = bad + rejected("mutation_frontend::mutate_hash_comment_is_e001", "\n# not a coffee comment\nfn main() => int:\n    return 0\n\n", 1)
    bad = bad + rejected("mutation_frontend::mutate_slash_slash_inside_fn_is_e001", "\nfn main() => int:\n    // trailing style comment\n    return 0\n\n", 1)
    bad = bad + rejected("mutation_frontend::mutate_unclosed_if_indent_is_e003", "\nfn main() => int:\n    if true:\n", 3)
    bad = bad + rejected("mutation_frontend::mutate_fn_missing_body_indent_is_e003", "\nfn main() => int:\n", 3)
    bad = bad + rejected("mutation_frontend::mutate_copy_keyword_is_e110", "\nfn main() => int:\n    let a: int = 1\n    copy a b\n    return 0\n\n", 110)
    bad = bad + rejected("mutation_frontend::mutate_clean_out_keyword_is_e110", "\nfn main() => int:\n    let a: int = 1\n    clean out\n    return 0\n\n", 110)
    return bad

fn main() => int:
    let bad = 0
    bad = bad + part0()
    return bad
