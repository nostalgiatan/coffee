/#/ Ported from tests/let_inference_tests.rs: the cases the first port left out.
use * in harness

fn part0() => int:
    let bad = 0
    bad = bad + exits("let_inference::test_infer_int_literal", "fn main() => int:\n    let x = 42\n    return x\n", 42)
    bad = bad + exits("let_inference::test_infer_float_literal", "fn main() => int:\n    let x = 1.5\n    let y = x * 2.0\n    if y > 2.5:\n        return 1\n    else:\n        return 0\n", 1)
    bad = bad + exits("let_inference::test_infer_bool_literal", "fn main() => int:\n    let b = true\n    if b:\n        return 3\n    else:\n        return 4\n", 3)
    bad = bad + balanced("let_inference::test_infer_str_literal_is_balanced", "fn main() => int:\n    let s = \"hi\"\n    return 0\n")
    bad = bad + exits("let_inference::test_infer_from_binary_expression", "fn main() => int:\n    let a: int = 3\n    let b = a + 4\n    return b\n", 7)
    bad = bad + exits("let_inference::test_infer_from_call", "fn f() => int:\n    return 5\n\nfn main() => int:\n    let v = f()\n    return v\n", 5)
    bad = bad + exits("let_inference::test_infer_chain_of_inferred_lets", "fn main() => int:\n    let a = 2\n    let b = a * 3\n    let c = b + a\n    return c\n", 8)
    bad = bad + exits("let_inference::test_infer_inferred_value_passed_to_function", "fn double(n: int) => int:\n    return n * 2\n\nfn main() => int:\n    let n = 5\n    return double(n)\n", 10)
    bad = bad + exits("let_inference::test_infer_inside_loop_body", "fn main() => int:\n    let i = 0\n    let acc = 0\n    while i < 4:\n        let j = i * 2\n        acc = acc + j\n        i = i + 1\n    return acc\n", 12)
    bad = bad + exits("let_inference::test_infer_struct_literal", "\nclass P:\n    x: int\n\n    fn new(x: int) => P:\n        return P { x: x }\n\nfn get(p: P) => int:\n    return p.x\n\nfn mk() => P:\n    return P { x: 9 }\n\nfn main() => int:\n    let p = P { x: 3 }\n    return p.x\n", 3)
    bad = bad + exits("let_inference::test_infer_constructor_call", "\nclass P:\n    x: int\n\n    fn new(x: int) => P:\n        return P { x: x }\n\nfn get(p: P) => int:\n    return p.x\n\nfn mk() => P:\n    return P { x: 9 }\n\nfn main() => int:\n    let p = P::new(4)\n    return p.x\n", 4)
    bad = bad + exits("let_inference::test_infer_class_from_call_then_pass_to_function", "\nclass P:\n    x: int\n\n    fn new(x: int) => P:\n        return P { x: x }\n\nfn get(p: P) => int:\n    return p.x\n\nfn mk() => P:\n    return P { x: 9 }\n\nfn main() => int:\n    let p = mk()\n    return get(p)\n", 9)
    bad = bad + balanced("let_inference::test_infer_class_is_balanced", "\nclass P:\n    x: int\n\n    fn new(x: int) => P:\n        return P { x: x }\n\nfn get(p: P) => int:\n    return p.x\n\nfn mk() => P:\n    return P { x: 9 }\n\nfn main() => int:\n    let p = mk()\n    return 0\n")
    bad = bad + exits("let_inference::test_infer_field_read", "\nclass P:\n    x: int\n\n    fn new(x: int) => P:\n        return P { x: x }\n\nfn get(p: P) => int:\n    return p.x\n\nfn mk() => P:\n    return P { x: 9 }\n\nfn main() => int:\n    let p: P = P { x: 6 }\n    let q = p.x\n    return q\n", 6)
    bad = bad + exits("let_inference::test_infer_enum_variant_and_match", "\nenum E:\n    A\n    B(n: int)\n\nfn main() => int:\n    let e = E.B(2)\n    match e:\n        E.A => 0\n        E.B(n) => n\n", 2)
    bad = bad + exits("let_inference::test_infer_array_literal", "fn main() => int:\n    let a = [1, 2, 3]\n    return a[1]\n", 2)
    bad = bad + exits("let_inference::test_infer_from_parameter_reached_through_match_binding", "\nenum E:\n    A\n    B(n: int)\n\nfn inc(n: int) => int:\n    let m = n + 1\n    return m\n\nfn main() => int:\n    let e: E = E.B(5)\n    match e:\n        E.A => 0\n        E.B(n) => inc(n)\n", 6)
    bad = bad + exits("let_inference::test_annotated_let_still_works", "fn main() => int:\n    let x: int = 8\n    return x\n", 8)
    bad = bad + rejected("let_inference::test_infer_empty_array_is_an_error", "fn main() => int:\n    let a = []\n    return 0\n", 0)
    bad = bad + rejected("let_inference::test_infer_from_void_call_is_an_error", "fn nothing() => void:\n    return\n\nfn main() => int:\n    let x = nothing()\n    return 0\n", 0)
    bad = bad + rejected("let_inference::test_infer_type_is_enforced_on_later_use", "fn main() => int:\n    let x = 1\n    let y: str = x\n    return 0\n", 0)
    return bad

fn main() => int:
    let bad = 0
    bad = bad + part0()
    return bad
