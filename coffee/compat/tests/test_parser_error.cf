/#/ Ported from tests/parser_error_tests.rs.
use * in harness

fn part0() => int:
    let bad = 0
    bad = bad + compiles("parser_error::assignment_without_spaces", "\nfn main() => int:\n    let x: int = 0\n    x=1\n    rm x\n    return 0\n")
    bad = bad + rejected("parser_error::broken_if_does_not_parse_body_as_top_level", "\nif\n    let x: int = 1\n", 0)
    bad = bad + rejected("parser_error::slash_slash_comment_is_syntax_error", "\n// not a coffee comment\nfn main() => int:\n    return 0\n", 0)
    bad = bad + rejected("parser_error::slash_slash_comment_is_syntax_error_3", "\n// not a coffee comment\nfn main() => int:\n    return 0\n", 0)
    bad = bad + rejected("parser_error::missing_fn_colon", "\nfn main() => int\n    return 0\n", 0)
    bad = bad + rejected("parser_error::python_def_is_unexpected_token", "\ndef foo() => int:\n    return 0\n", 0)
    bad = bad + rejected("parser_error::python_def_is_unexpected_token_3", "\ndef foo() => int:\n    return 0\n", 0)
    bad = bad + rejected("parser_error::python_import_suggests_use", "\nimport math\nfn main() => int:\n    return 0\n", 0)
    bad = bad + rejected("parser_error::try_keyword_suggests_raise", "\nfn main() => int:\n    try:\n        return 0\n", 0)
    bad = bad + rejected("parser_error::c_style_if_brace_is_rejected_with_indent_help", "\nfn main() => int:\n    if true {\n        return 1\n    return 0\n", 0)
    return bad

fn main() => int:
    let bad = 0
    bad = bad + part0()
    return bad
