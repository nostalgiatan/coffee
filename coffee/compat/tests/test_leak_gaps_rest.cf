/#/ Ported from tests/leak_gaps_tests.rs: the cases the first port left out.
use * in harness

fn part0() => int:
    let bad = 0
    bad = bad + balanced("leak_gaps::test_enum_str_payload_is_balanced", "\nclass Box:\n    n: int\n\nenum E:\n    A\n    S(s: str)\n    B(b: Box)\n\nfn main() => int:\n    let e: E = E.S(\"hi\")\n    return 0\n")
    bad = bad + balanced("leak_gaps::test_enum_class_payload_is_balanced", "\nclass Box:\n    n: int\n\nenum E:\n    A\n    S(s: str)\n    B(b: Box)\n\nfn main() => int:\n    let b: Box = Box { n: 1 }\n    let e: E = E.B(b)\n    return 0\n")
    bad = bad + balanced("leak_gaps::test_enum_unit_variant_is_balanced", "\nclass Box:\n    n: int\n\nenum E:\n    A\n    S(s: str)\n    B(b: Box)\n\nfn main() => int:\n    let e: E = E.A\n    return 0\n")
    bad = bad + balanced("leak_gaps::test_enum_payload_matched_and_read_is_balanced", "\nclass Box:\n    n: int\n\nenum E:\n    A\n    S(s: str)\n    B(b: Box)\n\nfn len_of(e: E) => int:\n    match e:\n        E.A => 0\n        E.S(s) => 1\n        E.B(b) => b.n\n\nfn main() => int:\n    let e: E = E.S(\"hi\")\n    return len_of(e)\n")
    bad = bad + balanced("leak_gaps::test_reassign_str_local_frees_old_value", "fn main() => int:\n    let s: str = \"a\"\n    s = \"b\"\n    return 0\n")
    bad = bad + balanced("leak_gaps::test_reassign_str_in_loop_frees_each_old_value", "fn main() => int:\n    let s: str = \"a\"\n    let i: int = 0\n    while i < 3:\n        s = \"b\" + \"c\"\n        i = i + 1\n    return 0\n")
    bad = bad + balanced("leak_gaps::test_reassign_class_local_frees_old_value", "class Box:\n    n: int\n\nfn main() => int:\n    let b: Box = Box { n: 1 }\n    b = Box { n: 2 }\n    return b.n\n")
    bad = bad + balanced("leak_gaps::test_reassign_class_field_frees_old_value", "class In:\n    s: str\n\nclass Out:\n    i: In\n\nfn main() => int:\n    let o: Out = Out { i: In { s: \"a\" } }\n    o.i = In { s: \"b\" }\n    return 0\n")
    bad = bad + balanced("leak_gaps::test_reassign_str_field_frees_old_value", "class N:\n    s: str\n\nfn main() => int:\n    let n: N = N { s: \"a\" }\n    n.s = \"b\"\n    return 0\n")
    bad = bad + balanced("leak_gaps::test_enum_payload_dropped_when_arm_does_not_bind_it", "\nclass Box:\n    n: int\n\nenum E:\n    A\n    S(s: str)\n    B(b: Box)\n\nfn f(e: E) => int:\n    match e:\n        E.S(s) => 1\n        _ => 0\n\nfn main() => int:\n    let a: E = E.S(\"x\")\n    let n: int = f(a)\n    let b: Box = Box { n: 2 }\n    let c: E = E.B(b)\n    return f(c) + n\n")
    bad = bad + balanced("leak_gaps::test_enum_payload_moved_out_by_binding_into_callee", "\nclass Box:\n    n: int\n\nenum E:\n    A\n    S(s: str)\n    B(b: Box)\n\nfn eat(s: str) => int:\n    return 1\n\nfn f(e: E) => int:\n    match e:\n        E.S(s) => eat(s)\n        _ => 0\n\nfn main() => int:\n    let a: E = E.S(\"x\")\n    return f(a)\n")
    bad = bad + balanced("leak_gaps::test_guard_failure_keeps_payload_for_next_arm", "\nclass Box:\n    n: int\n\nenum E:\n    A\n    S(s: str)\n    B(b: Box)\n\nfn f(e: E, k: int) => int:\n    match e:\n        E.S(s) if k == 1 => 1\n        E.S(t) => 2\n        _ => 0\n\nfn main() => int:\n    let a: E = E.S(\"x\")\n    return f(a, 5)\n")
    bad = bad + balanced("leak_gaps::test_temp_scrutinee_is_freed", "\nclass Box:\n    n: int\n\nenum E:\n    A\n    S(s: str)\n    B(b: Box)\n\nfn mk() => E:\n    return E.S(\"hi\")\n\nfn main() => int:\n    match mk():\n        E.S(s) => 1\n        _ => 0\n    return 0\n")
    bad = bad + exits("leak_gaps::test_guard_failure_next_arm_reads_payload#1", "\nclass Box:\n    n: int\n\nenum E:\n    A\n    S(s: str)\n    B(b: Box)\n\nfn f(e: E, k: int) => int:\n    match e:\n        E.B(b) if k == 1 => 100\n        E.B(c) => c.n\n        _ => 0\n\nfn main() => int:\n    let x: Box = Box { n: 7 }\n    let a: E = E.B(x)\n    return f(a, 5)\n", 7)
    bad = bad + balanced("leak_gaps::test_guard_failure_next_arm_reads_payload#2", "\nclass Box:\n    n: int\n\nenum E:\n    A\n    S(s: str)\n    B(b: Box)\n\nfn f(e: E, k: int) => int:\n    match e:\n        E.B(b) if k == 1 => 100\n        E.B(c) => c.n\n        _ => 0\n\nfn main() => int:\n    let x: Box = Box { n: 7 }\n    let a: E = E.B(x)\n    return f(a, 5)\n")
    return bad

fn main() => int:
    let bad = 0
    bad = bad + part0()
    return bad
