/#/ Ported from tests/aggregate_storage_tests.rs: the cases the first port left out.
use * in harness

fn part0() => int:
    let bad = 0
    bad = bad + exits("aggregate_storage::test_return_class_literal_without_constructor#1", "\nclass P:\n    x: int\n    y: int\n\nfn mk() => P:\n    return P { x: 1, y: 2 }\n\nfn sum(p: P) => int:\n    return p.x + p.y\n\nfn main() => int:\n    let a: P = mk()\n    return sum(a)\n", 3)
    bad = bad + exits("aggregate_storage::test_return_class_literal_without_constructor#2", "\nclass P:\n    x: int\n    y: int\n\nfn mk() => P:\n    return P { x: 1, y: 2 }\n\nfn sum(p: P) => int:\n    return p.x + p.y\n\nfn main() => int:\n    let a: P = mk()\n    return sum(a)\n", 3)
    bad = bad + exits("aggregate_storage::test_return_class_literal_without_constructor#3", "\nclass P:\n    x: int\n    y: int\n\nfn mk() => P:\n    return P { x: 1, y: 2 }\n\nfn sum(p: P) => int:\n    return p.x + p.y\n\nfn main() => int:\n    let a: P = mk()\n    return sum(a)\n", 3)
    bad = bad + exits("aggregate_storage::test_return_class_literal_without_constructor#4", "\nclass P:\n    x: int\n    y: int\n\nfn mk() => P:\n    return P { x: 1, y: 2 }\n\nfn sum(p: P) => int:\n    return p.x + p.y\n\nfn main() => int:\n    let a: P = mk()\n    return sum(a)\n", 3)
    bad = bad + exits("aggregate_storage::test_return_class_through_two_calls#1", "\nclass P:\n    x: int\n    y: int\n\nfn inner() => P:\n    return P { x: 10, y: 20 }\n\nfn outer() => P:\n    return inner()\n\nfn main() => int:\n    let a: P = outer()\n    return a.x + a.y\n", 30)
    bad = bad + exits("aggregate_storage::test_return_class_through_two_calls#2", "\nclass P:\n    x: int\n    y: int\n\nfn inner() => P:\n    return P { x: 10, y: 20 }\n\nfn outer() => P:\n    return inner()\n\nfn main() => int:\n    let a: P = outer()\n    return a.x + a.y\n", 30)
    bad = bad + exits("aggregate_storage::test_return_class_through_two_calls#3", "\nclass P:\n    x: int\n    y: int\n\nfn inner() => P:\n    return P { x: 10, y: 20 }\n\nfn outer() => P:\n    return inner()\n\nfn main() => int:\n    let a: P = outer()\n    return a.x + a.y\n", 30)
    bad = bad + exits("aggregate_storage::test_return_class_through_two_calls#4", "\nclass P:\n    x: int\n    y: int\n\nfn inner() => P:\n    return P { x: 10, y: 20 }\n\nfn outer() => P:\n    return inner()\n\nfn main() => int:\n    let a: P = outer()\n    return a.x + a.y\n", 30)
    bad = bad + exits("aggregate_storage::test_return_class_with_class_field#1", "\nclass In:\n    v: int\n\nclass Out:\n    i: In\n    n: int\n\nfn mk() => Out:\n    let i: In = In { v: 7 }\n    return Out { i: i, n: 5 }\n\nfn main() => int:\n    let o: Out = mk()\n    return o.i.v + o.n\n", 12)
    bad = bad + exits("aggregate_storage::test_return_class_with_class_field#2", "\nclass In:\n    v: int\n\nclass Out:\n    i: In\n    n: int\n\nfn mk() => Out:\n    let i: In = In { v: 7 }\n    return Out { i: i, n: 5 }\n\nfn main() => int:\n    let o: Out = mk()\n    return o.i.v + o.n\n", 12)
    bad = bad + exits("aggregate_storage::test_return_class_with_class_field#3", "\nclass In:\n    v: int\n\nclass Out:\n    i: In\n    n: int\n\nfn mk() => Out:\n    let i: In = In { v: 7 }\n    return Out { i: i, n: 5 }\n\nfn main() => int:\n    let o: Out = mk()\n    return o.i.v + o.n\n", 12)
    bad = bad + exits("aggregate_storage::test_return_class_with_class_field#4", "\nclass In:\n    v: int\n\nclass Out:\n    i: In\n    n: int\n\nfn mk() => Out:\n    let i: In = In { v: 7 }\n    return Out { i: i, n: 5 }\n\nfn main() => int:\n    let o: Out = mk()\n    return o.i.v + o.n\n", 12)
    bad = bad + exits("aggregate_storage::test_return_class_with_constructor_still_works#1", "\nclass P:\n    x: int\n    y: int\n\n    fn new(x: int, y: int) => P:\n        return P { x: x, y: y }\n\nfn mk() => P:\n    return P::new(1, 2)\n\nfn main() => int:\n    let a: P = mk()\n    return a.x + a.y\n", 3)
    bad = bad + exits("aggregate_storage::test_return_class_with_constructor_still_works#2", "\nclass P:\n    x: int\n    y: int\n\n    fn new(x: int, y: int) => P:\n        return P { x: x, y: y }\n\nfn mk() => P:\n    return P::new(1, 2)\n\nfn main() => int:\n    let a: P = mk()\n    return a.x + a.y\n", 3)
    bad = bad + exits("aggregate_storage::test_return_class_with_constructor_still_works#3", "\nclass P:\n    x: int\n    y: int\n\n    fn new(x: int, y: int) => P:\n        return P { x: x, y: y }\n\nfn mk() => P:\n    return P::new(1, 2)\n\nfn main() => int:\n    let a: P = mk()\n    return a.x + a.y\n", 3)
    bad = bad + exits("aggregate_storage::test_return_class_with_constructor_still_works#4", "\nclass P:\n    x: int\n    y: int\n\n    fn new(x: int, y: int) => P:\n        return P { x: x, y: y }\n\nfn mk() => P:\n    return P::new(1, 2)\n\nfn main() => int:\n    let a: P = mk()\n    return a.x + a.y\n", 3)
    bad = bad + exits("aggregate_storage::test_return_payload_enum_from_function#1", "\nenum Shape:\n    Circle(r: int)\n    Rect(w: int, h: int)\n    Dot\n\nfn area(s: Shape) => int:\n    match s:\n        Shape.Circle(r) => r * 3\n        Shape.Rect(w, h) => w * h\n        Shape.Dot => 0\n\nfn make_rect() => Shape:\n    return Shape.Rect(3, 5)\n\nfn make_dot() => Shape:\n    return Shape.Dot\n\nfn main() => int:\n    return area(make_rect()) + area(make_dot())\n", 15)
    bad = bad + exits("aggregate_storage::test_return_payload_enum_from_function#2", "\nenum Shape:\n    Circle(r: int)\n    Rect(w: int, h: int)\n    Dot\n\nfn area(s: Shape) => int:\n    match s:\n        Shape.Circle(r) => r * 3\n        Shape.Rect(w, h) => w * h\n        Shape.Dot => 0\n\nfn make_rect() => Shape:\n    return Shape.Rect(3, 5)\n\nfn make_dot() => Shape:\n    return Shape.Dot\n\nfn main() => int:\n    return area(make_rect()) + area(make_dot())\n", 15)
    bad = bad + exits("aggregate_storage::test_return_payload_enum_from_function#3", "\nenum Shape:\n    Circle(r: int)\n    Rect(w: int, h: int)\n    Dot\n\nfn area(s: Shape) => int:\n    match s:\n        Shape.Circle(r) => r * 3\n        Shape.Rect(w, h) => w * h\n        Shape.Dot => 0\n\nfn make_rect() => Shape:\n    return Shape.Rect(3, 5)\n\nfn make_dot() => Shape:\n    return Shape.Dot\n\nfn main() => int:\n    return area(make_rect()) + area(make_dot())\n", 15)
    bad = bad + exits("aggregate_storage::test_return_payload_enum_from_function#4", "\nenum Shape:\n    Circle(r: int)\n    Rect(w: int, h: int)\n    Dot\n\nfn area(s: Shape) => int:\n    match s:\n        Shape.Circle(r) => r * 3\n        Shape.Rect(w, h) => w * h\n        Shape.Dot => 0\n\nfn make_rect() => Shape:\n    return Shape.Rect(3, 5)\n\nfn make_dot() => Shape:\n    return Shape.Dot\n\nfn main() => int:\n    return area(make_rect()) + area(make_dot())\n", 15)
    bad = bad + balanced("aggregate_storage::test_balanced_local_class", "class P:\n    x: int\n\nfn main() => int:\n    let a: P = P { x: 1 }\n    return 0\n")
    bad = bad + balanced("aggregate_storage::test_balanced_explicit_rm", "class P:\n    x: int\n\nfn main() => int:\n    let a: P = P { x: 1 }\n    rm a\n    return 0\n")
    bad = bad + balanced("aggregate_storage::test_balanced_class_with_constructor", "class P:\n    x: int\n\n    fn new(x: int) => P:\n        return P { x: x }\n\nfn main() => int:\n    let a: P = P::new(1)\n    return 0\n")
    bad = bad + balanced("aggregate_storage::test_balanced_returned_class", "class P:\n    x: int\n\nfn mk() => P:\n    return P { x: 1 }\n\nfn main() => int:\n    let a: P = mk()\n    return a.x\n")
    bad = bad + balanced("aggregate_storage::test_balanced_class_moved_into_field", "class In:\n    v: int\n\nclass Out:\n    i: In\n    n: int\n\nfn main() => int:\n    let i: In = In { v: 7 }\n    let o: Out = Out { i: i, n: 5 }\n    return 0\n")
    bad = bad + balanced("aggregate_storage::test_balanced_clone", "class P:\n    x: int\n\nfn main() => int:\n    let a: P = P { x: 1 }\n    let b: P = clone a\n    return b.x\n")
    bad = bad + balanced("aggregate_storage::test_balanced_class_built_in_a_loop", "class P:\n    x: int\n\nfn main() => int:\n    let i: int = 0\n    while i < 3:\n        let a: P = P { x: i }\n        i = i + 1\n    return 0\n")
    bad = bad + balanced("aggregate_storage::test_balanced_payload_enum_locals", "enum S:\n    A(r: int)\n    B\n\nfn main() => int:\n    let s: S = S.A(1)\n    let t: S = S.B\n    return 0\n")
    bad = bad + balanced("aggregate_storage::test_balanced_class_consumed_by_callee", "class P:\n    x: int\n\nfn eat(p: P) => int:\n    return 1\n\nfn main() => int:\n    let a: P = P { x: 1 }\n    return eat(a)\n")
    bad = bad + balanced("aggregate_storage::test_balanced_class_passed_through_callee", "class P:\n    x: int\n\nfn id(p: P) => P:\n    return p\n\nfn main() => int:\n    let a: P = P { x: 1 }\n    let b: P = id(a)\n    return b.x\n")
    bad = bad + balanced("aggregate_storage::test_balanced_method_does_not_consume_receiver", "class P:\n    x: int\n\n    fn get(self) => int:\n        return self.x\n\nfn main() => int:\n    let a: P = P { x: 4 }\n    let n: int = a.get()\n    return n + a.get()\n")
    bad = bad + balanced("aggregate_storage::test_balanced_method_consumes_own_class_parameter", "class P:\n    x: int\n\n    fn add(self, o: P) => int:\n        return self.x + o.x\n\nfn main() => int:\n    let a: P = P { x: 1 }\n    let b: P = P { x: 2 }\n    return a.add(b)\n")
    bad = bad + balanced("aggregate_storage::test_balanced_two_class_parameters", "class P:\n    x: int\n\nfn two(a: P, b: P) => int:\n    return a.x + b.x\n\nfn main() => int:\n    let a: P = P { x: 1 }\n    let b: P = P { x: 2 }\n    return two(a, b)\n")
    bad = bad + balanced("aggregate_storage::test_balanced_recursion_with_class_parameter", "class N:\n    v: int\n\nfn depth(n: N, k: int) => int:\n    if k == 0:\n        return n.v\n    let m: N = N { v: n.v + 1 }\n    return depth(m, k - 1)\n\nfn main() => int:\n    let s: N = N { v: 0 }\n    return depth(s, 5)\n")
    bad = bad + balanced("aggregate_storage::test_balanced_payload_enum_parameter", "enum E:\n    A(r: int)\n    B\n\nfn val(e: E) => int:\n    match e:\n        E.A(r) => r\n        E.B => 0\n\nfn main() => int:\n    return val(E.A(5)) + val(E.B)\n")
    return bad

fn main() => int:
    let bad = 0
    bad = bad + part0()
    return bad
