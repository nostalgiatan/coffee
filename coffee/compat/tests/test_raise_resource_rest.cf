/#/ Ported from tests/raise_resource_tests.rs: the cases the first port left out.
use * in harness

fn part0() => int:
    let bad = 0
    bad = bad + exits("raise_resource::test_raise_calls_listener_and_returns_its_value", "\nclass Box:\n    n: int\n\nfn on_err(err: Error) => int:\n    return 7\n\nfn f() #on_err => int:\n    raise Error(1)\n\nfn main() => int:\n    return f()\n", 7)
    bad = bad + balanced("raise_resource::test_raise_frees_str_and_class_locals", "\nclass Box:\n    n: int\n\nfn on_err(err: Error) => int:\n    return 7\n\nfn f() #on_err => int:\n    let s: str = \"ab\"\n    let b: Box = Box { n: 1 }\n    raise Error(1)\n\nfn main() => int:\n    return f()\n")
    bad = bad + balanced("raise_resource::test_raise_after_local_was_moved_does_not_double_free", "\nclass Box:\n    n: int\n\nfn on_err(err: Error) => int:\n    return 7\n\nfn eat(b: Box) => int:\n    return b.n\n\nfn f() #on_err => int:\n    let b: Box = Box { n: 1 }\n    let k: int = eat(b)\n    raise Error(k)\n\nfn main() => int:\n    return f()\n")
    bad = bad + balanced("raise_resource::test_raise_in_a_branch_frees_only_what_exists_there", "\nclass Box:\n    n: int\n\nfn on_err(err: Error) => int:\n    return 7\n\nfn f(x: int) #on_err => int:\n    let b: Box = Box { n: x }\n    if x > 0:\n        raise Error(x)\n    return b.n\n\nfn main() => int:\n    let a: int = f(1)\n    let c: int = f(0)\n    return a + c\n")
    bad = bad + balanced("raise_resource::test_raise_with_heap_note_is_balanced", "\nclass Box:\n    n: int\n\nfn on_err(err: Error) => int:\n    return 7\n\nfn f() #on_err => int:\n    let note: str = \"a\" + \"b\"\n    raise Error { code: 1, note: note, e: 0 }\n\nfn main() => int:\n    return f()\n")
    bad = bad + exits("raise_resource::test_raise_without_listener_aborts_with_status_one", "use fprintf, exit in libc of c\n\nfn main() => int:\n    raise Error(1)\n", 1)
    bad = bad + exits("raise_resource::test_raise_without_listener_needs_no_libc_import", "fn main() => int:\n    raise Error(1)\n", 1)
    bad = bad + exits("raise_resource::test_listener_sees_runtime_error_code", "\nfn on_code(err: Error) => int:\n    return err.code\n\nfn f(k: int) #on_code => int:\n    raise Error(k)\n\nfn main() => int:\n    return f(9)\n", 9)
    bad = bad + exits("raise_resource::test_listener_sees_literal_error_code", "\nfn on_code(err: Error) => int:\n    return err.code\n\nfn f() #on_code => int:\n    raise Error(4)\n\nfn main() => int:\n    return f()\n", 4)
    bad = bad + exits("raise_resource::test_listener_can_read_heap_note", "fn on_note(err: Error) => int:\n    if err.note == \"ab\":\n        return 1\n    return 0\n\nfn f() #on_note => int:\n    let note: str = \"a\" + \"b\"\n    raise Error { code: 1, note: note, e: 0 }\n\nfn main() => int:\n    return f()\n", 1)
    bad = bad + balanced("raise_resource::test_raise_with_temporary_note_is_balanced", "\nclass Box:\n    n: int\n\nfn on_err(err: Error) => int:\n    return 7\n\nfn f() #on_err => int:\n    raise Error { code: 1, note: \"x\" + \"y\", e: 0 }\n\nfn main() => int:\n    return f()\n")
    return bad

fn main() => int:
    let bad = 0
    bad = bad + part0()
    return bad
