use * in sema_probe

fn main() => int:
    let m = 0
    let und = int(Sc.UndefinedName)
    let dup = int(Sc.DuplicateName)
    m = m + miss_diag("fn main() => int:\n    return zz\n", und, 1)
    m = m + miss_diag("fn main() => int:\n    return nope(1)\n", und, 1)
    m = m + miss_diag("fn main() => int:\n    let a = 1\n    return a\n", und, 0)
    m = m + miss_diag("fn f(x: int) => int:\n    return x\n", und, 0)
    m = m + miss_diag("fn main() => int:\n    return f(1)\n\nfn f(x: int) => int:\n    return x\n", und, 0)
    /#/ the initialiser is checked before the name exists
    m = m + miss_diag("fn main() => int:\n    let a = a + 1\n    return a\n", und, 1)
    /#/ a name declared in a block is gone after it
    m = m + miss_diag("fn main() => int:\n    if true:\n        let a = 1\n        a = 2\n    return a\n", und, 1)
    /#/ siblings may reuse a name, a live outer name may not be redeclared
    m = m + miss_diag("fn main() => int:\n    let n = 1\n    if n == 1:\n        let a = 2\n        n = a\n    else:\n        let a = 3\n        n = a\n    return n\n", dup, 0)
    m = m + miss_diag("fn main() => int:\n    let a = 1\n    let a = 2\n    return a\n", dup, 1)
    m = m + miss_diag("fn main() => int:\n    let a = 1\n    if a == 1:\n        let a = 2\n    return a\n", dup, 1)
    m = m + miss_diag("fn f(x: int) => int:\n    let x = 2\n    return x\n", dup, 1)
    m = m + miss_diag("fn f(x: int, x: int) => int:\n    return x\n", dup, 1)
    /#/ two functions may each have their own `a`; a local may shadow a function
    m = m + miss_diag("fn f() => int:\n    let a = 1\n    return a\n\nfn g() => int:\n    let a = 1\n    return a\n", dup, 0)
    m = m + miss_diag("fn f() => int:\n    return 1\n\nfn main() => int:\n    let f = 2\n    return f\n", dup, 0)
    /#/ loop variable, two loops with one name, and the variable ends with the loop
    m = m + miss_diag("fn main() => int:\n    let t = 0\n    for i in 0..3:\n        t = t + i\n    for i in 0..3:\n        t = t + i\n    return t\n", dup, 0)
    m = m + miss_diag("fn main() => int:\n    for i in 0..3:\n        i = 1\n    return i\n", und, 1)
    /#/ match arms bind variant payloads
    m = m + miss_diag("enum E:\n    A(int)\n    B\n\nfn f(e: E) => int:\n    match e:\n        E.A(v) => return v\n        _ => return 0\n", und, 0)
    /#/ methods see self, not the fields bare
    m = m + miss_diag("class A:\n    x: int\n\n    fn g(self) => int:\n        return self.x\n", und, 0)
    m = m + miss_diag("class A:\n    x: int\n\n    fn g(self) => int:\n        return x\n", und, 1)
    /#/ top-level lets are visible inside functions
    m = m + miss_diag("let K = 5\n\nfn main() => int:\n    return K\n", und, 0)
    /#/ a nested fn cannot read the enclosing locals, but may be called
    /#/ and may use its own
    m = m + miss_diag("fn main() => int:\n    let a = 1\n    fn inner(x: int) => int:\n        return x + a\n    return inner(2)\n", und, 1)
    m = m + miss_diag("fn main() => int:\n    let a = 1\n    fn inner(x: int) => int:\n        let b = x\n        return b\n    return inner(a)\n", und, 0)
    /#/ listeners must name a function
    m = m + miss_diag("fn h(err: Error) => void:\n    return\n\nfn f(#h) => int:\n    return 0\n", und, 0)
    m = m + miss_diag("fn f(#nope) => int:\n    return 0\n", und, 1)
    /#/ builtins and the casts are always in scope
    m = m + miss_diag("fn main() => int:\n    let b = new_buf(int, 2)\n    return len(b) + int(1.5)\n", und, 0)
    return m
