use * in sema_probe

fn main() => int:
    let m = 0
    let w = int(Sc.UnusedVariable)
    m = m + miss_diag("fn main() => int:\n    let a = 1\n    return 0\n", w, 1)
    m = m + miss_diag("fn main() => int:\n    let a = 1\n    return a\n", w, 0)
    m = m + miss_diag("fn main() => int:\n    let _a = 1\n    return 0\n", w, 0)
    /#/ only assigned is still unused
    m = m + miss_diag("fn main() => int:\n    let a = 1\n    a = 2\n    return 0\n", w, 1)
    /#/ read in an f-string counts
    m = m + miss_diag("fn main() => int:\n    let a = 1\n    let s = f\"v={a}\"\n    return len(s)\n", w, 0)
    /#/ parameters and loop variables are not reported
    m = m + miss_diag("fn f(x: int) => int:\n    return 0\n", w, 0)
    m = m + miss_diag("fn main() => int:\n    for i in 0..3:\n        let t = 1\n    return 0\n", w, 1)
    /#/ a warning is not an error
    m = m + miss_clean("fn main() => int:\n    let a = 1\n    return 0\n")
    m = m + miss_silent("fn main() => int:\n    let a = 1\n    return a\n")
    return m
