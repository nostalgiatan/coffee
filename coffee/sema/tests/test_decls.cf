use * in sema_probe

fn main() => int:
    let m = 0
    let dup = int(Sc.DuplicateName)
    let ty = int(Sc.UndefinedType)
    m = m + miss_diag("fn f() => int:\n    return 1\n\nfn f() => int:\n    return 2\n", dup, 1)
    m = m + miss_diag("class A:\n    x: int\n\nenum A:\n    B\n", dup, 1)
    m = m + miss_diag("class A:\n    x: int\n    x: int\n", dup, 1)
    m = m + miss_diag("class A:\n    fn g(self) => int:\n        return 1\n\n    fn g(self) => int:\n        return 2\n", dup, 1)
    m = m + miss_diag("enum E:\n    A\n    A\n", dup, 1)
    /#/ types must exist
    m = m + miss_diag("fn f(x: Foo) => int:\n    return 1\n", ty, 1)
    m = m + miss_diag("fn f() => Foo:\n    return 1\n", ty, 1)
    m = m + miss_diag("class A:\n    b: Missing\n", ty, 1)
    m = m + miss_diag("class A:\n    x: int\n\nfn f(a: A, b: &A, c: &mut A, d: buf<int>, e: [A; 2]) => int:\n    return 1\n", ty, 0)
    m = m + miss_diag("class B<T>:\n    v: T\n\nfn f(b: B<int>) => int:\n    return 1\n", ty, 0)
    m = m + miss_diag("fn id<T>(x: T) => T:\n    return x\n", ty, 0)
    m = m + miss_diag("fn f(x: T) => int:\n    return 1\n", ty, 1)
    m = m + miss_diag("enum E:\n    A(Nope)\n", ty, 1)
    /#/ a parent class must exist
    m = m + miss_diag("class A of Nope:\n    x: int\n", int(Sc.UnknownParent), 1)
    m = m + miss_diag("class P:\n    x: int\n\nclass A of P:\n    y: int\n", int(Sc.UnknownParent), 0)
    /#/ struct literals: the class, its fields, all of them
    m = m + miss_diag("class A:\n    x: int\n    y: int\n\nfn f() => int:\n    let a = A { x: 1, y: 2 }\n    return a.x\n", int(Sc.UnknownField), 0)
    m = m + miss_diag("class A:\n    x: int\n\nfn f() => int:\n    let a = A { z: 1 }\n    return 0\n", int(Sc.UnknownField), 1)
    m = m + miss_diag("class A:\n    x: int\n    y: int\n\nfn f() => int:\n    let a = A { x: 1 }\n    return a.x\n", int(Sc.MissingField), 1)
    m = m + miss_diag("fn f() => int:\n    let a = Nope { x: 1 }\n    return 0\n", int(Sc.UndefinedName), 1)
    m = m + miss_diag("fn g() => int:\n    return 1\n\nfn f() => int:\n    let a = g { x: 1 }\n    return 0\n", int(Sc.NotAClass), 1)
    /#/ call arity of known functions
    m = m + miss_diag("fn f(x: int) => int:\n    return x\n\nfn main() => int:\n    return f(1, 2)\n", int(Sc.ArityMismatch), 1)
    m = m + miss_diag("fn f(x: int) => int:\n    return x\n\nfn main() => int:\n    return f()\n", int(Sc.ArityMismatch), 1)
    m = m + miss_diag("fn f(x: int) => int:\n    return x\n\nfn main() => int:\n    return f(1)\n", int(Sc.ArityMismatch), 0)
    return m
