/#/ Helpers for tests and the corpus tool: analyze a source and count what was found.
use * in sema

/#/ Analyzes `src` as a module of its own.
fn run(src: str) => Checker:
    let g = new_globals()
    let a = parse(src)
    let m = declare_module(&g, &a, "t")
    return check(&a, &g, m)

/#/ 1 when `src` does not yield exactly `want` diagnostics with `code`, else 0.
fn miss_diag(src: str, code: int, want: int) => int:
    let r = run(src)
    if r.diags.count(code) != want:
        return 1
    return 0

/#/ 1 when `src` yields any error, else 0 (warnings are allowed).
fn miss_clean(src: str) => int:
    let r = run(src)
    if r.diags.errors() != 0:
        return 1
    return 0

/#/ 1 when `src` yields anything, warnings included, else 0.
fn miss_silent(src: str) => int:
    let r = run(src)
    return r.diags.n

/#/ Analyzes `src` as a module that can import from module `lib_name` written as `lib`.
fn run_with(lib: str, lib_name: &str, src: str) => Checker:
    let g = new_globals()
    let l = parse(lib)
    declare_module(&g, &l, lib_name)
    let a = parse(src)
    let m = declare_module(&g, &a, "t")
    return check(&a, &g, m)

fn miss_diag_with(lib: str, lib_name: &str, src: str, code: int, want: int) => int:
    let r = run_with(lib, lib_name, src)
    if r.diags.count(code) != want:
        return 1
    return 0
