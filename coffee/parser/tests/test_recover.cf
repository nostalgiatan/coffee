use * in tree_shape

/#/ Error recovery: bad input reports errors but still ends, and good statements around
/#/ the bad one are kept.
fn main() => int:
    let m = 0
    m = m + miss_error("let = 3\nlet y = 2\n", int(Ec.ExpectedName), 1)
    m = m + miss_error("fn (\n", int(Ec.ExpectedName), 5)
    m = m + miss_error("1 +\n", int(Ec.ExpectedExpr), 1)
    /#/ stray indent and dedent tokens never loop
    m = m + miss_error("    x\n", int(Ec.UnexpectedToken), 2)
    m = m + miss_error("(((\n", int(Ec.ExpectedExpr), 5)
    m = m + miss_error("", 0, 0)
    m = m + miss_error("\n\n", 0, 0)
    return m
