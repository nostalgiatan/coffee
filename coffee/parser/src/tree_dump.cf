/#/ Debug printers for a parse tree.
use * in say
use * in tree_shape
use fflush in libc of c

fn dump_shape(a: &Ast) => void:
    let s = shape(a)
    for i in 0..s.n:
        say_byte(s.out[i])
    say_byte(10)
    fflush(0)

fn dump_errors(a: &Ast) => void:
    for i in 0..a.err_count:
        say(f"error code={a.err_code[i]} at token {a.err_tok[i]} (line {a.toks.line[a.err_tok[i]]})\n")
    fflush(0)
