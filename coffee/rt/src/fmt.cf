/#/ Number text for f-strings, in Coffee, with no C library: `__cf_fmt_int` prints an int in
/#/ decimal, `__cf_fmt_float` prints the shortest decimal text that reads back as the same double
/#/ (Burger and Dybvig, "Printing Floating-Point Numbers Quickly and Accurately", on a small
/#/ bignum). The names are reserved: the compiler adds this text to a program that needs it.
/#/
/#/ Float text: `5.0`, `0.1`, `-2.5`, `1e+16`, `1.5e-07`, `inf`, `-inf`, `nan`. The decimal point
/#/ shows for exponents -4 to 16, otherwise the text is scientific with at least two exponent digits.
/#/ Negative zero prints as `0.0`.

/#/ The one-character string of ASCII byte `c` (digits, `.`, `-`, `+`, `e` and the letters of inf and nan).
fn __cf_ch(c: int) => str:
    if c == 48:
        return "0"
    if c == 49:
        return "1"
    if c == 50:
        return "2"
    if c == 51:
        return "3"
    if c == 52:
        return "4"
    if c == 53:
        return "5"
    if c == 54:
        return "6"
    if c == 55:
        return "7"
    if c == 56:
        return "8"
    if c == 57:
        return "9"
    if c == 46:
        return "."
    if c == 45:
        return "-"
    if c == 43:
        return "+"
    if c == 101:
        return "e"
    return "?"

/#/ The decimal text of `v`, written straight into a new string of the right length.
fn __cf_fmt_int(v: int) => str:
    if v == 0:
        return "0"
    if v < 0 - 9223372036854775807:
        return "-9223372036854775808"
    let w = v
    let neg = 0
    if w < 0:
        w = 0 - w
        neg = 1
    let n = 1
    let p = 10
    while n < 19 && w >= p:
        n += 1
        p = p * 10
    let s = str_alloc(n + neg)
    let q = n + neg - 1
    while w > 0:
        str_put(s, q, 48 + w % 10)
        w = w // 10
        q -= 1
    if neg == 1:
        str_put(s, 0, 45)
    return s

/#/ ---- a bignum: 48 limbs of 28 bits, least significant first ------------------

fn __cf_bn_zero(a: &buf<int>, nl: int) => void:
    for i in 0..nl:
        a[i] = 0

fn __cf_bn_set(a: &buf<int>, v: int, nl: int) => void:
    __cf_bn_zero(a, nl)
    let w = v
    let i = 0
    while w > 0:
        a[i] = w % 268435456
        w = w // 268435456
        i += 1

fn __cf_bn_copy(d: &buf<int>, s: &buf<int>, nl: int) => void:
    for i in 0..nl:
        d[i] = s[i]

/#/ a = a * m, for 0 <= m <= 2^28
fn __cf_bn_mul(a: &buf<int>, m: int, nl: int) => void:
    let carry = 0
    for i in 0..nl:
        let t = a[i] * m + carry
        a[i] = t % 268435456
        carry = t // 268435456

/#/ a = a * 2^bits
fn __cf_bn_shl(a: &buf<int>, bits: int, nl: int) => void:
    let left = bits
    while left > 0:
        let step = left
        if step > 28:
            step = 28
        let p = 1
        for z in 0..step:
            p = p * 2
        __cf_bn_mul(a, p, nl)
        left -= step

/#/ -1, 0 or 1 as a is below, equal to or above b
fn __cf_bn_cmp(a: &buf<int>, b: &buf<int>, nl: int) => int:
    let i = nl - 1
    while i >= 0:
        if a[i] < b[i]:
            return -1
        if a[i] > b[i]:
            return 1
        i -= 1
    return 0

fn __cf_bn_add(a: &buf<int>, b: &buf<int>, nl: int) => void:
    let carry = 0
    for i in 0..nl:
        let t = a[i] + b[i] + carry
        a[i] = t % 268435456
        carry = t // 268435456

/#/ a = a - b, for a >= b
fn __cf_bn_sub(a: &buf<int>, b: &buf<int>, nl: int) => void:
    let borrow = 0
    for i in 0..nl:
        let t = a[i] - b[i] - borrow
        borrow = 0
        if t < 0:
            t += 268435456
            borrow = 1
        a[i] = t

/#/ Is (r + mp) * times >= s (> s when `even` is false)? `t` is scratch.
fn __cf_bn_high(r: &buf<int>, mp: &buf<int>, s: &buf<int>, t: &buf<int>, even: bool, times: int, nl: int) => bool:
    __cf_bn_copy(t, r, nl)
    __cf_bn_add(t, mp, nl)
    if times != 1:
        __cf_bn_mul(t, times, nl)
    let c = __cf_bn_cmp(t, s, nl)
    if even:
        return c >= 0
    return c > 0

/#/ ---- shortest digits ------------------------------------------------------

/#/ The digits of f * 2^e (f below 2^53, e at least -1074) that read back as the same double: they
/#/ go to `dg`, and the result is the decimal exponent k, the value being 0.d1d2... * 10^k. The
/#/ number of digits is in dg[40].
fn __cf_digits(f: int, e: int, dg: &buf<int>) => int:
    let ae = e
    if ae < 0:
        ae = 0 - ae
    let nl = (117 + ae) // 28 + 2
    if nl > 48:
        nl = 48
    let even = f % 2 == 0
    let r: buf<int> = new_buf(int, 48)
    let s: buf<int> = new_buf(int, 48)
    let mp: buf<int> = new_buf(int, 48)
    let mm: buf<int> = new_buf(int, 48)
    let t: buf<int> = new_buf(int, 48)
    __cf_bn_set(&r, f, nl)
    if e >= 0:
        if f != 4503599627370496:
            __cf_bn_shl(&r, e + 1, nl)
            __cf_bn_set(&s, 2, nl)
            __cf_bn_set(&mp, 1, nl)
            __cf_bn_shl(&mp, e, nl)
            __cf_bn_copy(&mm, &mp, nl)
        else:
            __cf_bn_shl(&r, e + 2, nl)
            __cf_bn_set(&s, 4, nl)
            __cf_bn_set(&mp, 1, nl)
            __cf_bn_shl(&mp, e + 1, nl)
            __cf_bn_set(&mm, 1, nl)
            __cf_bn_shl(&mm, e, nl)
    elif e == 0 - 1074 || f != 4503599627370496:
        __cf_bn_mul(&r, 2, nl)
        __cf_bn_set(&s, 2, nl)
        __cf_bn_shl(&s, 0 - e, nl)
        __cf_bn_set(&mp, 1, nl)
        __cf_bn_set(&mm, 1, nl)
    else:
        __cf_bn_mul(&r, 4, nl)
        __cf_bn_set(&s, 2, nl)
        __cf_bn_shl(&s, 1 - e, nl)
        __cf_bn_set(&mp, 2, nl)
        __cf_bn_set(&mm, 1, nl)
    /#/ scale so that (r + mp) < s and (r + mp) * 10 >= s; k counts the powers of ten
    let k = 0
    while __cf_bn_high(&r, &mp, &s, &t, even, 1, nl):
        __cf_bn_mul(&s, 10, nl)
        k += 1
    while !__cf_bn_high(&r, &mp, &s, &t, even, 10, nl):
        __cf_bn_mul(&r, 10, nl)
        __cf_bn_mul(&mp, 10, nl)
        __cf_bn_mul(&mm, 10, nl)
        k -= 1
    let n = 0
    let more = true
    while more:
        __cf_bn_mul(&r, 10, nl)
        __cf_bn_mul(&mp, 10, nl)
        __cf_bn_mul(&mm, 10, nl)
        let d = 0
        while __cf_bn_cmp(&r, &s, nl) >= 0:
            __cf_bn_sub(&r, &s, nl)
            d += 1
        let c1 = __cf_bn_cmp(&r, &mm, nl)
        let low = c1 < 0
        if even:
            low = c1 <= 0
        let high = __cf_bn_high(&r, &mp, &s, &t, even, 1, nl)
        if !low && !high:
            dg[n] = d
            n += 1
        else:
            more = false
            if low && high:
                /#/ both ends are possible: the nearer one, the upper on a tie
                __cf_bn_mul(&r, 2, nl)
                if __cf_bn_cmp(&r, &s, nl) >= 0:
                    d += 1
            elif high:
                d += 1
            dg[n] = d
            n += 1
    dg[40] = n
    return k

/#/ The text of the digits dg[0..n) with the decimal exponent k (value 0.d1d2... * 10^k), after a
/#/ minus sign when `neg` is 1; written straight into the result.
fn __cf_layout(dg: &buf<int>, k: int, neg: int) => str:
    let n = dg[40]
    if k > 0 && k <= 16:
        let frac = n - k
        if frac < 1:
            frac = 1
        let s = str_alloc(neg + k + 1 + frac)
        let p = 0
        if neg == 1:
            str_put(s, 0, 45)
            p = 1
        for i in 0..k:
            if i < n:
                str_put(s, p, 48 + dg[i])
            else:
                str_put(s, p, 48)
            p += 1
        str_put(s, p, 46)
        p += 1
        if n > k:
            for i in k..n:
                str_put(s, p, 48 + dg[i])
                p += 1
        else:
            str_put(s, p, 48)
        return s
    if k <= 0 && k > 0 - 4:
        let s = str_alloc(neg + 2 - k + n)
        let p = 0
        if neg == 1:
            str_put(s, 0, 45)
            p = 1
        str_put(s, p, 48)
        str_put(s, p + 1, 46)
        p += 2
        for i in 0..0 - k:
            str_put(s, p, 48)
            p += 1
        for i in 0..n:
            str_put(s, p, 48 + dg[i])
            p += 1
        return s
    let x = k - 1
    let ax = x
    if x < 0:
        ax = 0 - x
    let xd = 2
    if ax >= 100:
        xd = 3
    let len = neg + 1 + 2 + xd
    if n > 1:
        len += n
    let s = str_alloc(len)
    let p = 0
    if neg == 1:
        str_put(s, 0, 45)
        p = 1
    str_put(s, p, 48 + dg[0])
    p += 1
    if n > 1:
        str_put(s, p, 46)
        p += 1
        for i in 1..n:
            str_put(s, p, 48 + dg[i])
            p += 1
    str_put(s, p, 101)
    if x < 0:
        str_put(s, p + 1, 45)
    else:
        str_put(s, p + 1, 43)
    p += 2
    if xd == 3:
        str_put(s, p, 48 + ax // 100)
        p += 1
    str_put(s, p, 48 + ax // 10 % 10)
    str_put(s, p + 1, 48 + ax % 10)
    return s

/#/ ---- the fast path: Grisu3 (Loitsch, "Printing Floating-Point Numbers Quickly and Accurately with
/#/ Integers") on 64-bit significands. When it cannot be sure of the shortest digits it gives up and
/#/ the bignum above decides, so the text is the same either way.

/#/ The 64-bit significand of 10^(-348 + 8 * i), normalized (kept as hex text).
fn __cf_g_cached(i: int) => int(8)-:
    let s = ""
    let v: int(8)- = 0
    for j in 0..16:
        let c = s[i * 16 + j] as int
        let d = c - 48
        if c >= 97:
            d = c - 87
        v = (v << 4) | (d as int(8)-)
    return v

/#/ The high 64 bits of a * b, rounded.
fn __cf_g_mul(a: int(8)-, b: int(8)-) => int(8)-:
    let m32: int(8)- = 4294967295
    let a0 = a & m32
    let a1 = a >> 32
    let b0 = b & m32
    let b1 = b >> 32
    let ac = a1 * b1
    let bc = a0 * b1
    let ad = a1 * b0
    let bd = a0 * b0
    let tmp = (bd >> 32) + (ad & m32) + (bc & m32) + 2147483648
    return ac + (ad >> 32) + (bc >> 32) + (tmp >> 32)

/#/ Moves the last digit down while that gets closer to w; false if the digits are not certain.
fn __cf_g_weed(dg: &buf<int>, n: int, dist: int(8)-, unsafe: int(8)-, rest0: int(8)-, tenk: int(8)-, unit: int(8)-) => bool:
    let rest = rest0
    let small = dist - unit
    let big = dist + unit
    while rest < small && unsafe - rest >= tenk && (rest + tenk < small || small - rest >= rest + tenk - small):
        if dg[n - 1] == 0:
            return false
        dg[n - 1] = dg[n - 1] - 1
        rest = rest + tenk
    if rest < big && unsafe - rest >= tenk && (rest + tenk < big || big - rest > rest + tenk - big):
        return false
    return unit * 2 <= rest && rest <= unsafe - unit * 4

/#/ The digits of f * 2^e (see __cf_digits) by Grisu3: the decimal exponent, or 1000000 when it is
/#/ not sure.
fn __cf_grisu(f: int, e: int, dg: &buf<int>) => int:
    let fail = 1000000
    let wf = f as int(8)-
    let we = e
    while (wf >> 63) == 0:
        wf = wf << 1
        we -= 1
    let pf = (f as int(8)-) * 2 + 1
    let pe = e - 1
    while (pf >> 63) == 0:
        pf = pf << 1
        pe -= 1
    let mf = (f as int(8)-) * 2 - 1
    let me = e - 1
    if f == 4503599627370496 && e != 0 - 1074:
        mf = (f as int(8)-) * 4 - 1
        me = e - 2
    mf = mf << (me - pe)
    let t = float(0 - 60 - (we + 64) + 63) * 0.30102999566398114
    let kk = int(t)
    if float(kk) < t:
        kk += 1
    let idx = (348 + kk - 1) // 8 + 1
    let mk = 0 - 348 + 8 * idx
    let t2 = float(mk) * 3.321928094887362
    let ce = int(t2)
    if float(ce) > t2:
        ce -= 1
    ce -= 63
    let cf = __cf_g_cached(idx)
    let sw = __cf_g_mul(wf, cf)
    let slo = __cf_g_mul(mf, cf)
    let shi = __cf_g_mul(pf, cf)
    let te = we + ce + 64
    if te < 0 - 60 || te > 0 - 32:
        return fail
    let sh = 0 - te
    let unit: int(8)- = 1
    let thf = shi + 1
    let unsafe = thf - (slo - 1)
    let onef = (1 as int(8)-) << sh
    let integrals = (thf >> sh) as int
    let fractionals = thf & (onef - 1)
    let divisor = 1
    let kappa = 1
    while divisor * 10 <= integrals:
        divisor = divisor * 10
        kappa += 1
    let n = 0
    while kappa > 0:
        dg[n] = integrals // divisor
        n += 1
        integrals = integrals % divisor
        kappa -= 1
        let rest = ((integrals as int(8)-) << sh) + fractionals
        if rest < unsafe:
            if !__cf_g_weed(dg, n, thf - sw, unsafe, rest, (divisor as int(8)-) << sh, unit):
                return fail
            dg[40] = n
            return n - mk + kappa
        divisor = divisor // 10
    while n < 30:
        fractionals = fractionals * 10
        unit = unit * 10
        unsafe = unsafe * 10
        dg[n] = (fractionals >> sh) as int
        n += 1
        fractionals = fractionals & (onef - 1)
        kappa -= 1
        if fractionals < unsafe:
            if !__cf_g_weed(dg, n, (thf - sw) * unit, unsafe, fractionals, onef, unit):
                return fail
            dg[40] = n
            return n - mk + kappa
    return fail

/#/ The shortest decimal text of `x` that reads back as `x`.
fn __cf_fmt_float(x: float) => str:
    if !(x == x):
        return "nan"
    let sign = ""
    let neg = 0
    let m = x
    if x < 0.0:
        sign = "-"
        neg = 1
        m = 0.0 - x
    if !((m - m) == (m - m)):
        return sign + "inf"
    if m == 0.0:
        return "0.0"
    /#/ m = f * 2^e with f an integer in [2^52, 2^53): every step is exact
    let e = 0
    while m >= 9007199254740992.0:
        m = m / 2.0
        e += 1
    while m < 1048576.0:
        m = m * 4294967296.0
        e -= 32
    while m < 4503599627370496.0:
        m = m * 2.0
        e -= 1
    let f = int(m)
    /#/ below the smallest normal number there are fewer bits: the spacing stays 2^-1074
    while e < 0 - 1074:
        f = f // 2
        e += 1
    let dg: buf<int> = new_buf(int, 48)
    let k = __cf_grisu(f, e, &dg)
    if k == 1000000:
        k = __cf_digits(f, e, &dg)
    return __cf_layout(&dg, k, neg)

/#/ ---- format specs: `{x:>8}`, `{n:08x}`, `{x:.3}` -------------------------------

/#/ The one-character string of a fill byte (the fills the parser accepts).
fn __cf_fillc(c: int) => str:
    if c == 48:
        return "0"
    if c == 45:
        return "-"
    if c == 42:
        return "*"
    if c == 95:
        return "_"
    if c == 46:
        return "."
    if c == 35:
        return "#"
    if c == 61:
        return "="
    if c == 43:
        return "+"
    if c == 124:
        return "|"
    if c == 126:
        return "~"
    if c == 120:
        return "x"
    return " "

/#/ `s` with `fill` added to reach `width` bytes: align 1 puts it after, 2 before, 3 on both sides
/#/ (the extra byte goes to the right). The result is always a new string.
fn __cf_pad(s: &str, width: int, align: int, fill: int) => str:
    let n = len(s)
    let total = width - n
    if total < 0:
        total = 0
    let left = 0
    if align == 2:
        left = total
    elif align == 3:
        left = total // 2
    let f = __cf_fillc(fill)
    let out = ""
    for i in 0..left:
        out = out + f
    out = out + s
    for i in 0..total - left:
        out = out + f
    return out

/#/ `s` with zeros between its sign and its digits to reach `width` bytes.
fn __cf_pad_zero(s: &str, width: int) => str:
    let n = len(s)
    let out = ""
    let start = 0
    if n > 0 && (s[0] == 45 || s[0] == 43):
        out = __cf_ch(s[0])
        start = 1
    for i in 0..width - n:
        out = out + "0"
    for i in start..n:
        out = out + __cf_ch(s[i])
    return out

/#/ The digit `d` (0 to 15) in lower or upper case.
fn __cf_dig(d: int, upper: bool) => str:
    if d < 10:
        return __cf_ch(48 + d)
    if d == 10:
        if upper:
            return "A"
        return "a"
    if d == 11:
        if upper:
            return "B"
        return "b"
    if d == 12:
        if upper:
            return "C"
        return "c"
    if d == 13:
        if upper:
            return "D"
        return "d"
    if d == 14:
        if upper:
            return "E"
        return "e"
    if upper:
        return "F"
    return "f"

/#/ `v` in base 2, 8 or 16 (sign and magnitude: -255 is `-ff`).
fn __cf_fmt_radix(v: int, radix: int, upper: int) => str:
    if v == 0:
        return "0"
    let out = ""
    if v < 0 - 9223372036854775807:
        /#/ 2^63 does not negate: its digits are a one and zeros
        out = "-"
        let zeros = 63
        if radix == 8:
            zeros = 21
        if radix == 16:
            out = "-8"
            zeros = 15
        else:
            out = out + "1"
        for i in 0..zeros:
            out = out + "0"
        return out
    let digits: buf<int> = new_buf(int, 72)
    let n = 0
    let w = v
    if w < 0:
        w = 0 - w
        out = "-"
    while w > 0:
        digits[n] = w % radix
        w = w // radix
        n += 1
    let i = n - 1
    while i >= 0:
        out = out + __cf_dig(digits[i], upper != 0)
        i -= 1
    return out

/#/ a = a / d, for 0 < d <= 2^28; the result is the remainder
fn __cf_bn_divsmall(a: &buf<int>, d: int) => int:
    let rem = 0
    let i = 47
    while i >= 0:
        let t = rem * 268435456 + a[i]
        a[i] = t // d
        rem = t % d
        i -= 1
    return rem

fn __cf_bn_is_zero(a: &buf<int>) => bool:
    for i in 0..48:
        if a[i] != 0:
            return false
    return true

/#/ `x` with exactly `prec` digits after the point, correctly rounded (ties to even): `2.50`, `0.125`.
fn __cf_fmt_fixed(x: float, prec: int) => str:
    if !(x == x):
        return "nan"
    let sign = ""
    let m = x
    if x < 0.0:
        sign = "-"
        m = 0.0 - x
    if !((m - m) == (m - m)):
        return sign + "inf"
    let n: buf<int> = new_buf(int, 48)
    if m != 0.0:
        let e = 0
        while m >= 9007199254740992.0:
            m = m / 2.0
            e += 1
        while m < 1048576.0:
            m = m * 4294967296.0
            e -= 32
        while m < 4503599627370496.0:
            m = m * 2.0
            e -= 1
        let f = int(m)
        while e < 0 - 1074:
            f = f // 2
            e += 1
        /#/ n = x * 10^prec, rounded to an integer
        __cf_bn_set(&n, f, 48)
        for i in 0..prec:
            __cf_bn_mul(&n, 10, 48)
        if e >= 0:
            __cf_bn_shl(&n, e, 48)
        else:
            let left = 0 - e
            let sticky = false
            let last = 0
            let half = 0
            while left > 0:
                let step = left
                if step > 28:
                    step = 28
                let p = 1
                for z in 0..step:
                    p = p * 2
                if last > 0:
                    sticky = true
                last = __cf_bn_divsmall(&n, p)
                half = p // 2
                left -= step
            /#/ `last` holds the top discarded bits, `sticky` says whether any lower ones were set
            let up = false
            if last > half:
                up = true
            elif last == half:
                up = sticky || n[0] % 2 == 1
            if up:
                let one: buf<int> = new_buf(int, 48)
                __cf_bn_set(&one, 1, 48)
                __cf_bn_add(&n, &one, 48)
    let digits: buf<int> = new_buf(int, 400)
    let cnt = 0
    while !__cf_bn_is_zero(&n):
        digits[cnt] = __cf_bn_divsmall(&n, 10)
        cnt += 1
    while cnt < prec + 1:
        digits[cnt] = 0
        cnt += 1
    let out = sign
    let i = cnt - 1
    while i >= 0:
        out = out + __cf_ch(48 + digits[i])
        if i == prec && prec > 0:
            out = out + "."
        i -= 1
    return out
