/#/ Number text for f-strings, in Coffee, with no C library: `__cf_fmt_int` prints an int in
/#/ decimal, `__cf_fmt_float` prints the shortest decimal text that reads back as the same double
/#/ (Burger and Dybvig, "Printing Floating-Point Numbers Quickly and Accurately", on a small
/#/ bignum). The names are reserved: the compiler adds this text to a program that needs it.
/#/
/#/ Float text: `5.0`, `0.1`, `-2.5`, `1e+16`, `1.5e-07`, `inf`, `-inf`, `nan`. The decimal point
/#/ shows for exponents -4 to 16, otherwise the text is scientific with at least two exponent digits.
/#/ Negative zero prints as `0.0`.

/#/ The one-character string of ASCII byte `c` (digits, `.`, `-`, `+`, `e` and the letters of inf and nan).
fn __cf_ch(c: int) => str:
    if c == 48:
        return "0"
    if c == 49:
        return "1"
    if c == 50:
        return "2"
    if c == 51:
        return "3"
    if c == 52:
        return "4"
    if c == 53:
        return "5"
    if c == 54:
        return "6"
    if c == 55:
        return "7"
    if c == 56:
        return "8"
    if c == 57:
        return "9"
    if c == 46:
        return "."
    if c == 45:
        return "-"
    if c == 43:
        return "+"
    if c == 101:
        return "e"
    return "?"

/#/ The decimal text of `v`. The characters are packed into words (8 per word, the first in the
/#/ low byte) and the string is made once from that NUL-ended text.
fn __cf_fmt_int(v: int) => str:
    if v == 0:
        return "0"
    if v < 0 - 9223372036854775807:
        return "-9223372036854775808"
    let w = v
    let neg = 0
    if w < 0:
        w = 0 - w
        neg = 1
    let n = 0
    let t = w
    while t > 0:
        n += 1
        t = t // 10
    let words: buf<int> = new_buf(int, 4)
    for k in 0..4:
        words[k] = 0
    let q = n + neg - 1
    while w > 0:
        words[q >> 3] = words[q >> 3] | ((48 + w % 10) << ((q & 7) * 8))
        w = w // 10
        q -= 1
    if neg == 1:
        words[0] = words[0] | 45
    return buf_ptr(words) as str

/#/ ---- a bignum: 48 limbs of 28 bits, least significant first ------------------

fn __cf_bn_zero(a: &buf<int>) => void:
    for i in 0..48:
        a[i] = 0

fn __cf_bn_set(a: &buf<int>, v: int) => void:
    __cf_bn_zero(a)
    let w = v
    let i = 0
    while w > 0:
        a[i] = w % 268435456
        w = w // 268435456
        i += 1

fn __cf_bn_copy(d: &buf<int>, s: &buf<int>) => void:
    for i in 0..48:
        d[i] = s[i]

/#/ a = a * m, for 0 <= m <= 2^28
fn __cf_bn_mul(a: &buf<int>, m: int) => void:
    let carry = 0
    for i in 0..48:
        let t = a[i] * m + carry
        a[i] = t % 268435456
        carry = t // 268435456

/#/ a = a * 2^bits
fn __cf_bn_shl(a: &buf<int>, bits: int) => void:
    let left = bits
    while left > 0:
        let step = left
        if step > 28:
            step = 28
        let p = 1
        for z in 0..step:
            p = p * 2
        __cf_bn_mul(a, p)
        left -= step

/#/ -1, 0 or 1 as a is below, equal to or above b
fn __cf_bn_cmp(a: &buf<int>, b: &buf<int>) => int:
    let i = 47
    while i >= 0:
        if a[i] < b[i]:
            return -1
        if a[i] > b[i]:
            return 1
        i -= 1
    return 0

fn __cf_bn_add(a: &buf<int>, b: &buf<int>) => void:
    let carry = 0
    for i in 0..48:
        let t = a[i] + b[i] + carry
        a[i] = t % 268435456
        carry = t // 268435456

/#/ a = a - b, for a >= b
fn __cf_bn_sub(a: &buf<int>, b: &buf<int>) => void:
    let borrow = 0
    for i in 0..48:
        let t = a[i] - b[i] - borrow
        borrow = 0
        if t < 0:
            t += 268435456
            borrow = 1
        a[i] = t

/#/ Is (r + mp) * times >= s (> s when `even` is false)? `t` is scratch.
fn __cf_bn_high(r: &buf<int>, mp: &buf<int>, s: &buf<int>, t: &buf<int>, even: bool, times: int) => bool:
    __cf_bn_copy(t, r)
    __cf_bn_add(t, mp)
    if times != 1:
        __cf_bn_mul(t, times)
    let c = __cf_bn_cmp(t, s)
    if even:
        return c >= 0
    return c > 0

/#/ ---- shortest digits ------------------------------------------------------

/#/ The digits of f * 2^e (f below 2^53, e at least -1074) that read back as the same double: they
/#/ go to `dg`, and the result is the decimal exponent k, the value being 0.d1d2... * 10^k. The
/#/ number of digits is in dg[40].
fn __cf_digits(f: int, e: int, dg: &buf<int>) => int:
    let even = f % 2 == 0
    let r: buf<int> = new_buf(int, 48)
    let s: buf<int> = new_buf(int, 48)
    let mp: buf<int> = new_buf(int, 48)
    let mm: buf<int> = new_buf(int, 48)
    let t: buf<int> = new_buf(int, 48)
    __cf_bn_set(&r, f)
    if e >= 0:
        if f != 4503599627370496:
            __cf_bn_shl(&r, e + 1)
            __cf_bn_set(&s, 2)
            __cf_bn_set(&mp, 1)
            __cf_bn_shl(&mp, e)
            __cf_bn_copy(&mm, &mp)
        else:
            __cf_bn_shl(&r, e + 2)
            __cf_bn_set(&s, 4)
            __cf_bn_set(&mp, 1)
            __cf_bn_shl(&mp, e + 1)
            __cf_bn_set(&mm, 1)
            __cf_bn_shl(&mm, e)
    elif e == 0 - 1074 || f != 4503599627370496:
        __cf_bn_mul(&r, 2)
        __cf_bn_set(&s, 2)
        __cf_bn_shl(&s, 0 - e)
        __cf_bn_set(&mp, 1)
        __cf_bn_set(&mm, 1)
    else:
        __cf_bn_mul(&r, 4)
        __cf_bn_set(&s, 2)
        __cf_bn_shl(&s, 1 - e)
        __cf_bn_set(&mp, 2)
        __cf_bn_set(&mm, 1)
    /#/ scale so that (r + mp) < s and (r + mp) * 10 >= s; k counts the powers of ten
    let k = 0
    while __cf_bn_high(&r, &mp, &s, &t, even, 1):
        __cf_bn_mul(&s, 10)
        k += 1
    while !__cf_bn_high(&r, &mp, &s, &t, even, 10):
        __cf_bn_mul(&r, 10)
        __cf_bn_mul(&mp, 10)
        __cf_bn_mul(&mm, 10)
        k -= 1
    let n = 0
    let more = true
    while more:
        __cf_bn_mul(&r, 10)
        __cf_bn_mul(&mp, 10)
        __cf_bn_mul(&mm, 10)
        let d = 0
        while __cf_bn_cmp(&r, &s) >= 0:
            __cf_bn_sub(&r, &s)
            d += 1
        let c1 = __cf_bn_cmp(&r, &mm)
        let low = c1 < 0
        if even:
            low = c1 <= 0
        let high = __cf_bn_high(&r, &mp, &s, &t, even, 1)
        if !low && !high:
            dg[n] = d
            n += 1
        else:
            more = false
            if low && high:
                /#/ both ends are possible: the nearer one, the upper on a tie
                __cf_bn_mul(&r, 2)
                if __cf_bn_cmp(&r, &s) >= 0:
                    d += 1
            elif high:
                d += 1
            dg[n] = d
            n += 1
    dg[40] = n
    return k

/#/ The text of the digits dg[0..n) with the decimal exponent k (value 0.d1d2... * 10^k).
fn __cf_layout(dg: &buf<int>, k: int) => str:
    let n = dg[40]
    let out = ""
    if k > 0 && k <= 16:
        for i in 0..k:
            if i < n:
                out = out + __cf_ch(48 + dg[i])
            else:
                out = out + "0"
        out = out + "."
        if n > k:
            for i in k..n:
                out = out + __cf_ch(48 + dg[i])
        else:
            out = out + "0"
        return out
    if k <= 0 && k > 0 - 4:
        out = "0."
        for i in 0..0 - k:
            out = out + "0"
        for i in 0..n:
            out = out + __cf_ch(48 + dg[i])
        return out
    out = __cf_ch(48 + dg[0])
    if n > 1:
        out = out + "."
        for i in 1..n:
            out = out + __cf_ch(48 + dg[i])
    let x = k - 1
    out = out + "e"
    if x < 0:
        out = out + "-"
        x = 0 - x
    else:
        out = out + "+"
    if x < 10:
        out = out + "0"
    return out + __cf_fmt_int(x)

/#/ The shortest decimal text of `x` that reads back as `x`.
fn __cf_fmt_float(x: float) => str:
    if !(x == x):
        return "nan"
    let sign = ""
    let m = x
    if x < 0.0:
        sign = "-"
        m = 0.0 - x
    if !((m - m) == (m - m)):
        return sign + "inf"
    if m == 0.0:
        return "0.0"
    /#/ m = f * 2^e with f an integer in [2^52, 2^53): every step is exact
    let e = 0
    while m >= 9007199254740992.0:
        m = m / 2.0
        e += 1
    while m < 1048576.0:
        m = m * 4294967296.0
        e -= 32
    while m < 4503599627370496.0:
        m = m * 2.0
        e -= 1
    let f = int(m)
    /#/ below the smallest normal number there are fewer bits: the spacing stays 2^-1074
    while e < 0 - 1074:
        f = f // 2
        e += 1
    let dg: buf<int> = new_buf(int, 48)
    let k = __cf_digits(f, e, &dg)
    return sign + __cf_layout(&dg, k)

/#/ ---- format specs: `{x:>8}`, `{n:08x}`, `{x:.3}` -------------------------------

/#/ The one-character string of a fill byte (the fills the parser accepts).
fn __cf_fillc(c: int) => str:
    if c == 48:
        return "0"
    if c == 45:
        return "-"
    if c == 42:
        return "*"
    if c == 95:
        return "_"
    if c == 46:
        return "."
    if c == 35:
        return "#"
    if c == 61:
        return "="
    if c == 43:
        return "+"
    if c == 124:
        return "|"
    if c == 126:
        return "~"
    if c == 120:
        return "x"
    return " "

/#/ `s` with `fill` added to reach `width` bytes: align 1 puts it after, 2 before, 3 on both sides
/#/ (the extra byte goes to the right). The result is always a new string.
fn __cf_pad(s: &str, width: int, align: int, fill: int) => str:
    let n = len(s)
    let total = width - n
    if total < 0:
        total = 0
    let left = 0
    if align == 2:
        left = total
    elif align == 3:
        left = total // 2
    let f = __cf_fillc(fill)
    let out = ""
    for i in 0..left:
        out = out + f
    out = out + s
    for i in 0..total - left:
        out = out + f
    return out

/#/ `s` with zeros between its sign and its digits to reach `width` bytes.
fn __cf_pad_zero(s: &str, width: int) => str:
    let n = len(s)
    let out = ""
    let start = 0
    if n > 0 && (s[0] == 45 || s[0] == 43):
        out = __cf_ch(s[0])
        start = 1
    for i in 0..width - n:
        out = out + "0"
    for i in start..n:
        out = out + __cf_ch(s[i])
    return out

/#/ The digit `d` (0 to 15) in lower or upper case.
fn __cf_dig(d: int, upper: bool) => str:
    if d < 10:
        return __cf_ch(48 + d)
    if d == 10:
        if upper:
            return "A"
        return "a"
    if d == 11:
        if upper:
            return "B"
        return "b"
    if d == 12:
        if upper:
            return "C"
        return "c"
    if d == 13:
        if upper:
            return "D"
        return "d"
    if d == 14:
        if upper:
            return "E"
        return "e"
    if upper:
        return "F"
    return "f"

/#/ `v` in base 2, 8 or 16 (sign and magnitude: -255 is `-ff`).
fn __cf_fmt_radix(v: int, radix: int, upper: int) => str:
    if v == 0:
        return "0"
    let out = ""
    if v < 0 - 9223372036854775807:
        /#/ 2^63 does not negate: its digits are a one and zeros
        out = "-"
        let zeros = 63
        if radix == 8:
            zeros = 21
        if radix == 16:
            out = "-8"
            zeros = 15
        else:
            out = out + "1"
        for i in 0..zeros:
            out = out + "0"
        return out
    let digits: buf<int> = new_buf(int, 72)
    let n = 0
    let w = v
    if w < 0:
        w = 0 - w
        out = "-"
    while w > 0:
        digits[n] = w % radix
        w = w // radix
        n += 1
    let i = n - 1
    while i >= 0:
        out = out + __cf_dig(digits[i], upper != 0)
        i -= 1
    return out

/#/ a = a / d, for 0 < d <= 2^28; the result is the remainder
fn __cf_bn_divsmall(a: &buf<int>, d: int) => int:
    let rem = 0
    let i = 47
    while i >= 0:
        let t = rem * 268435456 + a[i]
        a[i] = t // d
        rem = t % d
        i -= 1
    return rem

fn __cf_bn_is_zero(a: &buf<int>) => bool:
    for i in 0..48:
        if a[i] != 0:
            return false
    return true

/#/ `x` with exactly `prec` digits after the point, correctly rounded (ties to even): `2.50`, `0.125`.
fn __cf_fmt_fixed(x: float, prec: int) => str:
    if !(x == x):
        return "nan"
    let sign = ""
    let m = x
    if x < 0.0:
        sign = "-"
        m = 0.0 - x
    if !((m - m) == (m - m)):
        return sign + "inf"
    let n: buf<int> = new_buf(int, 48)
    if m != 0.0:
        let e = 0
        while m >= 9007199254740992.0:
            m = m / 2.0
            e += 1
        while m < 1048576.0:
            m = m * 4294967296.0
            e -= 32
        while m < 4503599627370496.0:
            m = m * 2.0
            e -= 1
        let f = int(m)
        while e < 0 - 1074:
            f = f // 2
            e += 1
        /#/ n = x * 10^prec, rounded to an integer
        __cf_bn_set(&n, f)
        for i in 0..prec:
            __cf_bn_mul(&n, 10)
        if e >= 0:
            __cf_bn_shl(&n, e)
        else:
            let left = 0 - e
            let sticky = false
            let last = 0
            let half = 0
            while left > 0:
                let step = left
                if step > 28:
                    step = 28
                let p = 1
                for z in 0..step:
                    p = p * 2
                if last > 0:
                    sticky = true
                last = __cf_bn_divsmall(&n, p)
                half = p // 2
                left -= step
            /#/ `last` holds the top discarded bits, `sticky` says whether any lower ones were set
            let up = false
            if last > half:
                up = true
            elif last == half:
                up = sticky || n[0] % 2 == 1
            if up:
                let one: buf<int> = new_buf(int, 48)
                __cf_bn_set(&one, 1)
                __cf_bn_add(&n, &one)
    let digits: buf<int> = new_buf(int, 400)
    let cnt = 0
    while !__cf_bn_is_zero(&n):
        digits[cnt] = __cf_bn_divsmall(&n, 10)
        cnt += 1
    while cnt < prec + 1:
        digits[cnt] = 0
        cnt += 1
    let out = sign
    let i = cnt - 1
    while i >= 0:
        out = out + __cf_ch(48 + digits[i])
        if i == prec && prec > 0:
            out = out + "."
        i -= 1
    return out
