use * in own_probe

fn prog(body: str) => str:
    return "class P:\n    name: str\n    n: int\n\nenum E:\n    A(int)\n    B\n\nfn take(s: str) => void:\n    return\n\nfn main() => int:\n" + body + "    return 0\n"

fn main() => int:
    let m = 0
    let copy = int(Oe.CopyResource)
    let moved = int(Oe.UseAfterMove)
    let viol = int(Oe.BorrowViolation)
    let conf = int(Oe.BorrowConflict)
    let ret = int(Oe.ReturnsLocalRef)
    /#/ a resource cannot be taken out of a field, a copy can
    m = m + miss_o(prog("    let p = P { name: \"a\" + \"b\", n: 1 }\n    take(p.name)\n"), copy, 1)
    m = m + miss_clean(prog("    let p = P { name: \"a\" + \"b\", n: 1 }\n    let k = p.n\n    take(clone p.name)\n"))
    /#/ match looks at its subject
    m = m + miss_clean(prog("    let e = E.A(1)\n    match e:\n        E.A(x) => x\n        E.B => 0\n    rm e\n"))
    /#/ a field borrowed mutably cannot be read, another field can
    m = m + miss_o(prog("    let p = P { name: \"a\" + \"b\", n: 1 }\n    let r = &mut p.n\n    let k = p.n\n    let z = *r\n"), viol, 1)
    m = m + miss_clean(prog("    let p = P { name: \"a\" + \"b\", n: 1 }\n    let r = &mut p.n\n    let k = len(&p.name)\n    let z = *r\n"))
    /#/ two mutable borrows of one place
    m = m + miss_o(prog("    let a = 1\n    let r = &mut a\n    let q = &mut a\n    let z = *r\n"), conf, 1)
    /#/ references that escape
    m = m + miss_o("fn f() => &int:\n    let a = 1\n    return &a\n\nfn main() => int:\n    return 0\n", ret, 1)
    m = m + miss_clean("fn f(a: &int) => &int:\n    return a\n\nfn main() => int:\n    return 0\n")
    /#/ break and continue leave the loop with the state they have
    m = m + miss_o(prog("    let s = \"a\" + \"b\"\n    while 1 < 2:\n        mv s t\n        break\n    take(s)\n"), moved, 1)
    m = m + miss_clean(prog("    let i = 0\n    while i < 3:\n        let s = \"a\" + \"b\"\n        i = i + 1\n        if i == 2:\n            continue\n        take(s)\n"))
    return m
